  "lines": [
    {
      "index": 0,
      "id": "msg_t003gym01_gym_01",
      "hash": "cfeec5c10668e430",
      "flags": 0,
      "text": "ジムリーダーに　挑む　おまえに\\nおれが　アドバイス　してやろうか？"
    },
    {
      "index": 1,
      "id": "msg_t003gym01_gym_02",
      "hash": "cfeec8c10668e949",
      "flags": 0,
      "text": "よっしゃーッ！\\nじゃ　さっそく……！"
    },
    {
      "index": 2,
      "id": "msg_t003gym01_gym_03",
      "hash": "cfeec7c10668e796",
      "flags": 0,
      "text": "勝負の　最初に　飛び出す\\nポケモンは……\\r\\nてもちポケモン　リストの\\r\\n左上の　やつだ！\\c\\nポケモンの　順番を　変えれば\\n戦いが　有利に　なるぜ！\\r\\n試して　みなよ！"
    },
    {
      "index": 3,
      "id": "msg_t003gym01_gym_04",
      "hash": "cfeecac10668ecaf",
      "flags": 0,
      "text": "遠慮は　いらんぜ！\\nじゃ　さっそく……！"
    },
    {
      "index": 4,
      "id": "msg_t003gym01_gym_05",
      "hash": "cfeec9c10668eafc",
      "flags": 0,
      "text": "さすがだな！\\nこの　調子で　目指せ！\\r\\nポケモン　チャンピオン！"
    },
    {
      "index": 5,
      "id": "msg_t003gym01_statue_01",
      "hash": "0af8263e63820107",
      "flags": 0,
      "text": "ニビ　ポケモンジム\\nタケシ　認定　トレーナー！\\r\\n[VAR TRNAME(0001)]"
    },
    {
      "index": 6,
      "id": "msg_t003gym01_statue_02",
      "hash": "0af8273e638202ba",
      "flags": 0,
      "text": "ニビ　ポケモンジム\\nタケシ　認定　トレーナー！\\r\\n[VAR TRNAME(0001)]　[VAR TRNAME(0000)]"
    }
