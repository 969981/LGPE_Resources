{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main1210_doctor_01",
      "hash": "1e444fd644369518",
      "flags": 0,
      "text": "オーキド『おお\\n[VAR TRNAME(0000)]に　[VAR TRNAME(0001)]！"
    },
    {
      "index": 1,
      "id": "msg_main1210_doctor_08",
      "hash": "1e4448d644368933",
      "flags": 0,
      "text": "二人とも　なんとなく\\nたくましく　なった　ようじゃな"
    },
    {
      "index": 2,
      "id": "msg_main1210_doctor_09",
      "hash": "1e4447d644368780",
      "flags": 0,
      "text": "ちょーど　よい！\\n二人に　紹介しよう"
    },
    {
      "index": 3,
      "id": "msg_main1210_doctor_02",
      "hash": "1e4452d644369a31",
      "flags": 0,
      "text": "こいつは　わしの　孫\\c\\n……えーと？\\n名前は　なんて　いったかな？"
    },
    {
      "index": 4,
      "id": "msg_main1210_green_01",
      "hash": "730cd52049366e82",
      "flags": 0,
      "text": "グリーン『じいさん\\nそういう　冗談は　いーって！\\c\\nそれに　おれたち\\nもう　知り合い　だからな"
    },
    {
      "index": 5,
      "id": "msg_main1210_doctor_03",
      "hash": "1e4451d64436987e",
      "flags": 0,
      "text": "オーキド『なんじゃ　つまらん……"
    },
    {
      "index": 6,
      "id": "msg_main1210_green_02",
      "hash": "730cd42049366ccf",
      "flags": 0,
      "text": "グリーン『やれやれ……\\nま　それは　そうと"
    },
    {
      "index": 7,
      "id": "msg_main1210_green_03",
      "hash": "730cd32049366b1c",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]！　[VAR TRNAME(0001)]！\\nすごいじゃ　ねーか！"
    },
    {
      "index": 8,
      "id": "msg_main1210_rival_01",
      "hash": "c376b6a23bef83a3",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『えッ？"
    },
    {
      "index": 9,
      "id": "msg_main1210_green_04",
      "hash": "730cd22049366969",
      "flags": 0,
      "text": "グリーン『ロケット団　だよ！\\c\\nまさか　あの時\\nシルフカンパニーに　ボスが\\r\\nいた　なんてなー！"
    },
    {
      "index": 10,
      "id": "msg_main1210_green_11",
      "hash": "730951204933585f",
      "flags": 0,
      "text": "それを　二人で\\nやっつけたん　だろ！"
    },
    {
      "index": 11,
      "id": "msg_main1210_rival_02",
      "hash": "c376b7a23bef8556",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『ボスの　サカキは\\n[VAR TRNAME(0000)]が　ひとりで……！\\c\\nオレは　ちょっと\\n手伝った　だけで……"
    },
    {
      "index": 12,
      "id": "msg_main1210_select_01",
      "hash": "565fe7f2f2508995",
      "flags": 0,
      "text": "[~ 12]"
    },
    {
      "index": 13,
      "id": "msg_main1210_select_02",
      "hash": "565fe4f2f250847c",
      "flags": 0,
      "text": "[~ 13]"
    },
    {
      "index": 14,
      "id": "msg_main1210_rival_03",
      "hash": "c376b8a23bef8709",
      "flags": 0,
      "text": "[~ 14]"
    },
    {
      "index": 15,
      "id": "msg_main1210_green_05",
      "hash": "730cd120493667b6",
      "flags": 0,
      "text": "グリーン『いいじゃ　ねーか！\\n[VAR TRNAME(0001)]　だって　頑張ったろ！"
    },
    {
      "index": 16,
      "id": "msg_main1210_green_06",
      "hash": "730cd02049366603",
      "flags": 0,
      "text": "よし　よし！\\nじゃあ　二人に　ごほうびな"
    },
    {
      "index": 17,
      "id": "msg_main1210_red_01",
      "hash": "3728b40d3f0093c2",
      "flags": 0,
      "text": "[~ 17]"
    },
    {
      "index": 18,
      "id": "msg_main1210_green_07",
      "hash": "730ccf2049366450",
      "flags": 0,
      "text": "[~ 18]"
    },
    {
      "index": 19,
      "id": "msg_main1210_red_02",
      "hash": "3728b30d3f00920f",
      "flags": 0,
      "text": "[~ 19]"
    },
    {
      "index": 20,
      "id": "msg_main1210_sys_01",
      "hash": "a381c93f1818b354",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　グリーン　から\\n[VAR COLOR(0006)]キーストーン[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 21,
      "id": "msg_main1210_doctor_04",
      "hash": "1e4454d644369d97",
      "flags": 0,
      "text": "オーキド『おおッ！\\nキーストーン　では　ないか！\\c\\n進化を　超える　進化……\\n[VAR COLOR(0006)]メガシンカ[VAR COLOR(0000)]を　もたらす　石！"
    },
    {
      "index": 22,
      "id": "msg_main1210_rival_04",
      "hash": "c376b9a23bef88bc",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『メガシンカ！？\\nなにソレ……？"
    },
    {
      "index": 23,
      "id": "msg_main1210_doctor_05",
      "hash": "1e4453d644369be4",
      "flags": 0,
      "text": "キーストーンと　[VAR COLOR(0006)]メガストーン[VAR COLOR(0000)]\\nふたつの　石が　あれば……\\c\\n勝負の　ときに　一度だけ\\nポケモンが　[VAR COLOR(0006)]メガシンカ[VAR COLOR(0000)]　できる！"
    },
    {
      "index": 24,
      "id": "msg_main1210_doctor_10",
      "hash": "1e414ad6443456c2",
      "flags": 0,
      "text": "トレーナーの　ために\\nパワーアップ　して　くれるのじゃ！\\c\\n言わば　ポケモンと　トレーナーの\\n固い　[VAR COLOR(0006)]キズナ[VAR COLOR(0000)]の　証じゃ！"
    },
    {
      "index": 25,
      "id": "msg_main1210_doctor_06",
      "hash": "1e4456d64436a0fd",
      "flags": 0,
      "text": "ここで　一句\\c\\nいし　ふたつ\\nこころ　ひとつで\\r\\nメガシンカ……"
    },
    {
      "index": 26,
      "id": "msg_main1210_green_08",
      "hash": "730cde2049367dcd",
      "flags": 0,
      "text": "グリーン『二人なら\\n使い　こなせる　はずだぜ\\c\\nメガストーンは　これだ！"
    },
    {
      "index": 27,
      "id": "msg_main1210_sys_02",
      "hash": "a381cc3f1818b86d",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　[VAR COLOR(0006)]フシギバナイト[VAR COLOR(0000)]\\n[VAR COLOR(0006)]リザードナイトX　リザードナイトY[VAR COLOR(0000)]\\r\\n[VAR COLOR(0006)]カメックスナイト[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 28,
      "id": "msg_main1210_green_09",
      "hash": "730cdd2049367c1a",
      "flags": 0,
      "text": "ポケモンリーグ　いくだろ！\\n使って　みろよ！"
    },
    {
      "index": 29,
      "id": "msg_main1210_green_10",
      "hash": "73095020493356ac",
      "flags": 0,
      "text": "グリーン『ところで　なんで\\nここに　来たわけ？\\c\\n……え　トキワの　ジムリーダーが\\nずっと　留守？\\c\\nへんだな……\\nおれも　あとで　見にいくか"
    },
    {
      "index": 30,
      "id": "msg_main1210_doctor_07",
      "hash": "1e4455d644369f4a",
      "flags": 0,
      "text": "オーキド『二人とも\\nポケモンリーグ　まで\\r\\nあと　一息じゃぞ！"
    },
    {
      "index": 31,
      "id": "msg_main1210_sys_03",
      "hash": "a381cb3f1818b6ba",
      "flags": 0,
      "text": "[~ 31]"
    },
    {
      "index": 32,
      "id": "msg_main1210_rival_05",
      "hash": "c376baa23bef8a6f",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『メガシンカ……\\nロケット団の　やつらが\\r\\n使ってたら　やばかったな"
    },
    {
      "index": 33,
      "id": "msg_main1210_assistant_01",
      "hash": "11a18db531ef6a17",
      "flags": 0,
      "text": "メガストーンは　他にも\\nいくつかの　種類が　あります"
    },
    {
      "index": 34,
      "id": "msg_main1210_assistant_02",
      "hash": "11a18eb531ef6bca",
      "flags": 0,
      "text": "メガシンカは　カントーでは\\nかなり　珍しい　ものですよ！"
    },
    {
      "index": 35,
      "id": "msg_main1210_adultf_01",
      "hash": "7131c42ffb65a163",
      "flags": 0,
      "text": "マサラタウンは　狭いけど\\n強い　トレーナーが　いっぱいで\\r\\n博士も　嬉しいんじゃ　ないかしら"
    }
  ],
