{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0715_rocketm_01",
      "hash": "67d1602d93933ee5",
      "flags": 0,
      "text": "はははーッ！\\nエレベータが　使えないって？\\c\\nオレが　ずっと　カギを\\n見守って　いるからだー！"
    },
    {
      "index": 1,
      "id": "msg_member_18_02",
      "hash": "8d869275c4523f16",
      "flags": 0,
      "text": "[~ 1]"
    },
    {
      "index": 2,
      "id": "msg_main0715_rocketm_02",
      "hash": "67d15d2d939339cc",
      "flags": 0,
      "text": "クッ！　このまま　では\\nエレベータのカギを　とられちまう\\c\\n……こうなったら　わるあがき　だ！"
    },
    {
      "index": 3,
      "id": "msg_main0715_rocketm_03",
      "hash": "67d15e2d93933b7f",
      "flags": 0,
      "text": "……そいや！"
    },
    {
      "index": 4,
      "id": "msg_main0715_rocketm_04",
      "hash": "67d15b2d93933666",
      "flags": 0,
      "text": "はぁ……　はぁ……\\c\\nあの　カギが　なければ\\nボスの部屋には　行けないぜ！\\r\\n取れるものなら　取ってみろー！"
    },
    {
      "index": 5,
      "id": "msg_main0715_rocketm_05",
      "hash": "67d15c2d93933819",
      "flags": 0,
      "text": "もはや　エレベータのカギは\\n取れっこ　ないぜ！\\c\\nカベの上を　歩いたり\\nしない　かぎりな……！"
    },
    {
      "index": 6,
      "id": "msg_main0715_rocketm_06",
      "hash": "67d1592d93933300",
      "flags": 0,
      "text": "おまえの　ポケモン\\n身軽そうだな……"
    },
    {
      "index": 7,
      "id": "msg_main0715_sys_01",
      "hash": "89fde2f8d3fefde7",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は\\n[VAR COLOR(0006)]エレベータのカギ[VAR COLOR(0000)]を　手にいれた！"
    }
  ],
