{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0055_doctor_01",
      "hash": "fb78b3614c0b64b8",
      "flags": 0,
      "text": "オーキド『おーい！\\nちょっと　待ってくれい！"
    },
    {
      "index": 1,
      "id": "msg_main0055_doctor_02",
      "hash": "fb78b6614c0b69d1",
      "flags": 0,
      "text": "トレーナーに　なった　おまえたちに\\nひとつ　頼みが　あるんじゃ！\\c\\nこいつを　持って　いってくれ！"
    },
    {
      "index": 2,
      "id": "msg_main0055_rival_01",
      "hash": "aa237b074d6e99c3",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『博士！\\nなんですか　ソレ？"
    },
    {
      "index": 3,
      "id": "msg_main0055_doctor_03",
      "hash": "fb78b5614c0b681e",
      "flags": 0,
      "text": "わしが　設計した\\nポケモン図鑑　じゃ！\\c\\n見つけた　ポケモンの　データが\\n自動的に　書き込まれて\\r\\nページが　増えていく　という\\r\\n大変　ハイテクな　道具なのじゃ！"
    },
    {
      "index": 4,
      "id": "msg_main0055_doctor_04",
      "hash": "fb78b8614c0b6d37",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]　[VAR TRNAME(0001)]！\\nこれを　おまえたちに　預ける！"
    },
    {
      "index": 5,
      "id": "msg_main0055_sys_01",
      "hash": "c36468d85d2c4674",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　オーキドから\\n[VAR COLOR(0006)]ポケモン図鑑[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 6,
      "id": "msg_main0055_doctor_05",
      "hash": "fb78b7614c0b6b84",
      "flags": 0,
      "text": "オーキド『ポケモンを\\nただ　見つけただけ　では\\r\\n詳しい　データを\\r\\n手に入れる　ことは　できん！\\c\\n必ず　捕まえなければ\\nならんのだ！"
    },
    {
      "index": 7,
      "id": "msg_main0055_doctor_06",
      "hash": "fb78ba614c0b709d",
      "flags": 0,
      "text": "この　世界　全ての\\nポケモンを　記録した\\r\\n完璧な　図鑑を　作ること！\\c\\nそれが　わしの　夢　だった！"
    },
    {
      "index": 8,
      "id": "msg_main0055_doctor_09",
      "hash": "fb78ab614c0b5720",
      "flags": 0,
      "text": "しかし　わしも　もう　ジジイ！\\nそこまで　ムリは　できん！"
    },
    {
      "index": 9,
      "id": "msg_main0055_doctor_10",
      "hash": "fb752e614c084ce2",
      "flags": 0,
      "text": "そこで　おまえたちには\\nわしの　代わりに\\r\\n夢を　果たして　ほしいのじゃ！"
    },
    {
      "index": 10,
      "id": "msg_main0055_doctor_07",
      "hash": "fb78b9614c0b6eea",
      "flags": 0,
      "text": "さあ　ふたりとも\\nさっそく　出発　してくれい！\\c\\nこれは　ポケモンの　歴史に残る\\n偉大な　仕事じゃー！"
    },
    {
      "index": 11,
      "id": "msg_main0055_rival_02",
      "hash": "aa237c074d6e9b76",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『ポケモン図鑑　かあ！\\c\\nこれから　たくさんの\\nポケモンと　出会えるんだ……\\r\\n楽しみ　だなあ！"
    },
    {
      "index": 12,
      "id": "msg_main0055_rival_03",
      "hash": "aa237d074d6e9d29",
      "flags": 0,
      "text": "オレ　すぐ　行きます！\\n[VAR TRNAME(0000)]も　自分の　ペースで\\r\\nあせらず　来いよ！"
    },
    {
      "index": 13,
      "id": "msg_main0055_doctor_08",
      "hash": "fb78ac614c0b58d3",
      "flags": 0,
      "text": "世界中に　住んでいる\\nポケモンたちが\\r\\n[VAR TRNAME(0000)]を　待って　おるぞー！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0055_max",
      "hash": "b54f894b19c7c6c1"
    }
  ]
}
