  "lines": [
    {
      "index": 0,
      "id": "msg_t007r0501_stafff_01",
      "hash": "6271286d67cc858d",
      "flags": 0,
      "text": "いらっしゃいませ！\\nタマムシ　デパートに　ようこそ！\\c\\n各フロアの　案内は\\n奥の　ボードを　ご覧ください"
    },
    {
      "index": 1,
      "id": "msg_t007r0501_kanban_01",
      "hash": "45ae0e4cd6dbedb4",
      "flags": 0,
      "text": "１階……　サービス・カウンター\\n２階……　トレーナーズ・マーケット\\c\\n３階……　テレビ　ゲーム　ショップ\\n４階……　ワイズマン・ギフト\\c\\n５階……　アクセサリー　マーケット\\n屋上……　自動販売機"
    },
    {
      "index": 2,
      "id": "msg_t007r0501_kanban_02",
      "hash": "45ae114cd6dbf2cd",
      "flags": 0,
      "text": "[~ 2]"
    },
    {
      "index": 3,
      "id": "msg_t007r0501_poster_01",
      "hash": "2ab24a8c016ec932",
      "flags": 0,
      "text": "タマムシジムの\\nジムリーダーの　インタビュー！\\c\\n『挑戦者と\\n　果報は　寝て　待て　ですの』"
    },
    {
      "index": 4,
      "id": "msg_t007r0501_adultm_01",
      "hash": "a283866ac6a35e84",
      "flags": 0,
      "text": "ふぃー！　デパートの\\nイスの　ありがたさ！\\c\\n……きみも\\n大人に　なれば　わかるよ"
    },
    {
      "index": 5,
      "id": "msg_t007r0501_oldf_01",
      "hash": "bba12a981d93f1de",
      "flags": 0,
      "text": "用は　ないんだけどねぇ\\c\\nここに　来れば\\nお友達に　会えるのよ"
    },
    {
      "index": 6,
      "id": "msg_t007r0501_youngf_01",
      "hash": "7c2ac910457384d7",
      "flags": 0,
      "text": "ポケモンの　アクセサリー\\n買って　ほしいなー！"
    },
    {
      "index": 7,
      "id": "msg_t007r0501_youngm_01",
      "hash": "084041586d0bf1f8",
      "flags": 0,
      "text": "……５階まで　行くの\\n大変だし　帰らない？"
    }
  ],
