{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub024_researcher_01",
      "hash": "d427d40043ea8c98",
      "flags": 0,
      "text": "はいー！\\c\\nわたしは　エラーイ　博士\\c\\nいつも　珍しい　カセキ\\n研究　してる　アルよ！\\c\\nあなた！\\nいい　カセキ　持ってるか？"
    },
    {
      "index": 1,
      "id": "msg_sub024_select_01",
      "hash": "9c5bbb480ccf64a2",
      "flags": 0,
      "text": "かいのカセキ"
    },
    {
      "index": 2,
      "id": "msg_sub024_select_02",
      "hash": "9c5bba480ccf62ef",
      "flags": 0,
      "text": "こうらのカセキ"
    },
    {
      "index": 3,
      "id": "msg_sub024_select_03",
      "hash": "9c5bb9480ccf613c",
      "flags": 0,
      "text": "ひみつのコハク"
    },
    {
      "index": 4,
      "id": "msg_sub024_select_04",
      "hash": "9c5bb8480ccf5f89",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 5,
      "id": "msg_sub024_researcher_02",
      "hash": "d427d70043ea91b1",
      "flags": 0,
      "text": "持ってない　アルね……"
    },
    {
      "index": 6,
      "id": "msg_sub024_researcher_03",
      "hash": "d427d60043ea8ffe",
      "flags": 0,
      "text": "成功　した　アルよ！\\c\\nやっぱり　カセキは\\n[VAR POKNAME(0004)]　だった　アルね！"
    },
    {
      "index": 7,
      "id": "msg_sub024_sys_01",
      "hash": "0fa5772ce07503fd",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　博士から\\n[VAR POKNAME(0004)]を　受け取った！"
    },
    {
      "index": 8,
      "id": "msg_sub024_researcher_04",
      "hash": "d427d90043ea9517",
      "flags": 0,
      "text": "おお！\\nそれは　[VAR ITEM2(0002)]！\\c\\n大昔の　ポケモン\\n[VAR POKNAME(0001)]　いう　カセキね！\\c\\nわたしの　作った\\nカセキ　再生マシンで\\c\\nこれ！\\n生き返らせて　みせるね！"
    },
    {
      "index": 9,
      "id": "msg_sub024_researcher_05",
      "hash": "d427d80043ea9364",
      "flags": 0,
      "text": "はいー！　じゃ　それ\\nはやく　こっちに　よこす　よろし！"
    },
    {
      "index": 10,
      "id": "msg_sub024_sys_02",
      "hash": "0fa5742ce074fee4",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　変な　博士に\\n[VAR ITEM2(0002)]を　預けた！"
    },
    {
      "index": 11,
      "id": "msg_sub024_researcher_06",
      "hash": "d427db0043ea987d",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_sub024_researcher_07",
      "hash": "d427da0043ea96ca",
      "flags": 0,
      "text": "じゃー！　また　来る　よろし！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_024_max",
      "hash": "93371b7482b7e5d0"
    }
  ]
}
