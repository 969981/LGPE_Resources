  "lines": [
    {
      "index": 0,
      "id": "msg_main0810_musashi_01",
      "hash": "503cbb213de286ca",
      "flags": 0,
      "text": "ムサシ『お待ち！！\\nあたしたちが　先よ！"
    },
    {
      "index": 1,
      "id": "msg_main0810_kojiro_01",
      "hash": "b171b62c1b5e2776",
      "flags": 0,
      "text": "コジロウ『ゆうれいが　消えて\\nやっと　てっぺんまで　来れたぜ"
    },
    {
      "index": 2,
      "id": "msg_main0810_musashi_02",
      "hash": "503cba213de28517",
      "flags": 0,
      "text": "ムサシ『あんたが\\nフジって　じいさんね！"
    },
    {
      "index": 3,
      "id": "msg_main0810_musashi_03",
      "hash": "503cb9213de28364",
      "flags": 0,
      "text": "ロケット団の　ために　もう一度\\nポケモンの　研究を　しなさい！"
    },
    {
      "index": 4,
      "id": "msg_main0810_fuji_01",
      "hash": "34de481b1fa6fa16",
      "flags": 0,
      "text": "フジ『……　……"
    },
    {
      "index": 5,
      "id": "msg_main0810_kojiro_02",
      "hash": "b171b52c1b5e25c3",
      "flags": 0,
      "text": "コジロウ『ムシして　くれちゃって！\\c\\nボスの　ために　絶対\\n協力して　もらうぞ！"
    },
    {
      "index": 6,
      "id": "msg_main0810_musashi_04",
      "hash": "503cb8213de281b1",
      "flags": 0,
      "text": "ムサシ『今　この　じいさん\\n説得　してんのよ！"
    },
    {
      "index": 7,
      "id": "msg_main0810_kojiro_03",
      "hash": "b171b42c1b5e2410",
      "flags": 0,
      "text": "コジロウ『ジャマする　つもりなら\\n容赦　しないぞ！"
    },
    {
      "index": 8,
      "id": "msg_main0810_dummy_01",
      "hash": "c7d59007f9b0b106",
      "flags": 0,
      "text": "[~ 8]"
    },
    {
      "index": 9,
      "id": "msg_main0810_dummy_02",
      "hash": "c7d58f07f9b0af53",
      "flags": 0,
      "text": "[~ 9]"
    },
    {
      "index": 10,
      "id": "msg_main0810_musashi_05",
      "hash": "503cb7213de27ffe",
      "flags": 0,
      "text": "ムサシ『あぁん！　またぁー！？"
    },
    {
      "index": 11,
      "id": "msg_main0810_kojiro_05",
      "hash": "b171ba2c1b5e2e42",
      "flags": 0,
      "text": "コジロウ『フジ博士　連れ去って\\nこっそり　手柄を　立てる\\r\\n計画は　失敗かぁ"
    },
    {
      "index": 12,
      "id": "msg_main0810_musashi_06",
      "hash": "503cb6213de27e4b",
      "flags": 0,
      "text": "ムサシ『わかったわよ！\\nおとなしく　[VAR COLOR(0006)]ヤマブキシティ[VAR COLOR(0000)]で\\r\\n[VAR COLOR(0006)]シルフカンパニーを　乗っ取る[VAR COLOR(0000)]の\\r\\n手伝えば　いいんでしょ！"
    },
    {
      "index": 13,
      "id": "msg_main0810_kojiro_04",
      "hash": "b171bb2c1b5e2ff5",
      "flags": 0,
      "text": "ロケット団『やなかんじィー！"
    },
    {
      "index": 14,
      "id": "msg_main0810_musashi_back",
      "hash": "2197fb7b1a55a912",
      "flags": 0,
      "text": "ムサシ『って　ポケモン　１匹じゃ\\n戦えない　じゃない！\\c\\nもう１匹　連れて　出直しなさいよ！"
    }
  ],
