{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub069_doctor_01",
      "hash": "1e93a31dc54be178",
      "flags": 0,
      "text": "オーキド『よく　きた！\\nポケモン図鑑の\\r\\n調子は　どうかな？\\nどれ……　ちょっと\\n見て　あげようか！"
    },
    {
      "index": 1,
      "id": "msg_sub069_doctor_02",
      "hash": "1e93a61dc54be691",
      "flags": 0,
      "text": "…………ポケモン図鑑の\\n現在の　完成度　は……\\c\\n見つけた　ポケモン　[VAR NUM3(0004)]！\\n捕まえた　ポケモン　[VAR NUM3(0005)]！\\c\\nオーキド博士の　評価……"
    },
    {
      "index": 2,
      "id": "msg_sub069_doctor_03",
      "hash": "1e93a51dc54be4de",
      "flags": 0,
      "text": "まだまだ……　これからだ\\nあちこちの　草むらに　入って\\r\\nポケモンを　捕まえるのじゃ！"
    },
    {
      "index": 3,
      "id": "msg_sub069_doctor_04",
      "hash": "1e93a81dc54be9f7",
      "flags": 0,
      "text": "どうにか　調子が　でてきたな！\\nボールを　投げる　姿も\\r\\nイタに　ついて　きた　じゃろう！"
    },
    {
      "index": 4,
      "id": "msg_sub069_doctor_05",
      "hash": "1e93a71dc54be844",
      "flags": 0,
      "text": "ポケモン図鑑と　言う　には\\nもっと　内容が　欲しい　のう！\\r\\n色んな　場所を　歩き回れい！"
    },
    {
      "index": 5,
      "id": "msg_sub069_doctor_06",
      "hash": "1e93aa1dc54bed5d",
      "flags": 0,
      "text": "ふむ……　頑張ってるな！\\n１１番道路　ゲートに　いる\\c\\n助手に　ジャッジ機能を\\n持たせたぞ！　もらって　くれい！"
    },
    {
      "index": 6,
      "id": "msg_sub069_doctor_07",
      "hash": "1e93a91dc54bebaa",
      "flags": 0,
      "text": "いい　出来栄え　じゃないか！\\n１６番道路　ゲートに　いる\\c\\n助手に　ボールセットを\\n持たせたぞ！　もらって　くれい！"
    },
    {
      "index": 7,
      "id": "msg_sub069_doctor_08",
      "hash": "1e939c1dc54bd593",
      "flags": 0,
      "text": "ついに　５０種類を　超えたか！\\n１５番道路　ゲートに　いる\\c\\n助手に　すんばらしい　道具を\\n持たせたぞ！　もらって　くれい！"
    },
    {
      "index": 8,
      "id": "msg_sub069_doctor_09",
      "hash": "1e939b1dc54bd3e0",
      "flags": 0,
      "text": "ほっほう！　……こりゃ　いい\\nポケモン図鑑に　なって　きとる！"
    },
    {
      "index": 9,
      "id": "msg_sub069_doctor_10",
      "hash": "1e901e1dc548c9a2",
      "flags": 0,
      "text": "絶好調！　海や　川には\\nみずポケモンが　おるからな！\\r\\nつかまえるには　ミズバシリ　じゃ！"
    },
    {
      "index": 10,
      "id": "msg_sub069_doctor_11",
      "hash": "1e901f1dc548cb55",
      "flags": 0,
      "text": "ワンダフル！　もしかして　きみは\\n何かを　集めるの　好きなのか！？"
    },
    {
      "index": 11,
      "id": "msg_sub069_doctor_12",
      "hash": "1e901c1dc548c63c",
      "flags": 0,
      "text": "いやはや……　こりゃ　すごい！\\n集めるのは　大変　だったろ！"
    },
    {
      "index": 12,
      "id": "msg_sub069_doctor_13",
      "hash": "1e901d1dc548c7ef",
      "flags": 0,
      "text": "とうとう　１００種類　超えたか！\\n……信じられない　腕前じゃ！"
    },
    {
      "index": 13,
      "id": "msg_sub069_doctor_14",
      "hash": "1e901a1dc548c2d6",
      "flags": 0,
      "text": "ポケモンの　進化形態も\\n入って　きとる……　素晴らしい！"
    },
    {
      "index": 14,
      "id": "msg_sub069_doctor_15",
      "hash": "1e901b1dc548c489",
      "flags": 0,
      "text": "エクセレント！　友達と　交換\\nすると　もっと　集まる　かもしれん"
    },
    {
      "index": 15,
      "id": "msg_sub069_doctor_16",
      "hash": "1e90181dc548bf70",
      "flags": 0,
      "text": "ここまで　図鑑が　できたら\\nもはや　プロフェッショナル　じゃ！"
    },
    {
      "index": 16,
      "id": "msg_sub069_doctor_17",
      "hash": "1e90191dc548c123",
      "flags": 0,
      "text": "わしゃ　もう　言うことは　ない！\\nきみが　ポケモン博士　じゃ！"
    },
    {
      "index": 17,
      "id": "msg_sub069_doctor_18",
      "hash": "1e90261dc548d73a",
      "flags": 0,
      "text": "ついに　パーフェクトな　図鑑の\\n完成じゃ！　……おめでとう！"
    },
    {
      "index": 18,
      "id": "msg_ookido_01_p18_zukan",
      "hash": "f8903db79b5f3656",
      "flags": 0,
      "text": "[~ 18]"
    },
    {
      "index": 19,
      "id": "msg_ookido_01_p19_zukan",
      "hash": "0197460e650a9831",
      "flags": 0,
      "text": "[~ 19]"
    },
    {
      "index": 20,
      "id": "msg_sub069_doctor_19",
      "hash": "1e90271dc548d8ed",
      "flags": 0,
      "text": "ついに……\\n本当に　本当に\\r\\nものすごくて　素敵で\\n完璧な　ポケモン図鑑を\\n完成　させたの　じゃな……！"
    },
    {
      "index": 21,
      "id": "msg_sub069_doctor_20",
      "hash": "1e8c981dc545b019",
      "flags": 0,
      "text": "おおおおおーッ！"
    },
    {
      "index": 22,
      "id": "msg_sub069_doctor_21",
      "hash": "1e8c971dc545ae66",
      "flags": 0,
      "text": "ありがとう　[VAR TRNAME(0000)]\\n本当に　ありがとう！\\r\\nわしの　夢が　叶った！"
    },
    {
      "index": 23,
      "id": "msg_sub069_doctor_22",
      "hash": "1e8c961dc545acb3",
      "flags": 0,
      "text": "オーキド『よく　来た！\\nポケモン図鑑の\\r\\n調子は　どうかな？\\c\\nわはは……！　本当は\\nもう　わかって　おるのじゃが\\r\\n何度でも　たしかめたいんじゃ！\\c\\nどれどれ……"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_069_max",
      "hash": "1b68903bb2b7813f"
    }
  ]
}
