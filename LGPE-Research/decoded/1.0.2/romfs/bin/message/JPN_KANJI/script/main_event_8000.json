{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8000_rock_01",
      "hash": "cdc216030adc7af4",
      "flags": 0,
      "text": "来たな！\\nおれは　ニビ　ポケモンジム\\r\\nリーダーの　タケシ！"
    },
    {
      "index": 1,
      "id": "msg_main8000_rock_06",
      "hash": "cdc215030adc7941",
      "flags": 0,
      "text": "おれの　かたい　意志は\\nおれの　ポケモンにも　あらわれる！\\r\\nかたくて　我慢強い！"
    },
    {
      "index": 2,
      "id": "msg_main8000_rock_07",
      "hash": "cdc214030adc778e",
      "flags": 0,
      "text": "そう！　使うのは\\nいわタイプ　ばっかりだ！"
    },
    {
      "index": 3,
      "id": "msg_main8000_rock_08",
      "hash": "cdc20f030adc6f0f",
      "flags": 0,
      "text": "ふはは！\\n負けると　分かってて　戦うか！\\r\\nポケモン　トレーナーの　さがだな"
    },
    {
      "index": 4,
      "id": "msg_main8000_rock_09",
      "hash": "cdc20e030adc6d5c",
      "flags": 0,
      "text": "いいだろう！\\nかかって　来い！"
    },
    {
      "index": 5,
      "id": "msg_main8000_rock_02",
      "hash": "cdc219030adc800d",
      "flags": 0,
      "text": "おれに　勝った　証に\\nポケモンリーグ　公認\\r\\nグレーバッジ　を　授けよう！"
    },
    {
      "index": 6,
      "id": "msg_main8000_sys_01",
      "hash": "6a98f2c3653ad72a",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　タケシから\\n[VAR COLOR(0006)]グレーバッジ[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 7,
      "id": "msg_main8000_rock_03",
      "hash": "cdc218030adc7e5a",
      "flags": 0,
      "text": "グレーバッジが　あれば\\n人から　もらった　ポケモンでも\\r\\nレベル２０まで　なら\\r\\n言うことを　聞いて　くれるぞ！\\c\\nあと……　そうだ！\\nこれを　きみに　あげよう！"
    },
    {
      "index": 8,
      "id": "msg_main8000_sys_02",
      "hash": "6a98f1c3653ad577",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　タケシから\\n[VAR ITEM2(0001)]\\r\\n「[VAR COLOR(0006)][VAR MOVE(0002)][VAR COLOR(0000)]」を　もらった！"
    },
    {
      "index": 9,
      "id": "msg_main8000_rock_04",
      "hash": "cdc213030adc75db",
      "flags": 0,
      "text": "わざマシンを　使うと　ポケモンは\\nすぐ　その　わざを　おぼえる！\\r\\nそれに　使っても　なくならないぞ！\\c\\nところで……\\nわざマシン０１には\\r\\nずつき　が　入っている！\\c\\nいわのように　かたい　頭で\\n相手に　ダメージを　与える　わざだ！"
    },
    {
      "index": 10,
      "id": "msg_main8000_rock_05",
      "hash": "cdc212030adc7428",
      "flags": 0,
      "text": "この　広い　世界には\\nいろんな　やつが　いる！\\r\\nポケモンを\\r\\n戦わせたり　育てたり……\\c\\nおれは　ここで\\nポケモンを　育てる　ブリーダーの\\r\\n修行を　しているんだ！\\c\\nきみは　強さを　目指すのか？\\nなら　他のジムにも　行くといい！"
    },
    {
      "index": 11,
      "id": "msg_main8000_shortpants_01",
      "hash": "f371c7fe6a94e317",
      "flags": 0,
      "text": "おまえ…！\\nポケモン　トレーナー　だろ？\\r\\nタケシが　相手を　探してる\\c\\n……こっちに　来い！"
    },
    {
      "index": 12,
      "id": "msg_main8000_shortpants_02",
      "hash": "f371c8fe6a94e4ca",
      "flags": 0,
      "text": "勝てる　自信が　あるなら\\nタケシと　戦ってみなよ！"
    },
    {
      "index": 13,
      "id": "msg_main8000_shortpants_03",
      "hash": "f371c9fe6a94e67d",
      "flags": 0,
      "text": "お　それは　グレーバッジ！\\nタケシに　もらったんだな\\c\\n持ってる　バッジの　数が　増えると\\nショップで　買えるもの　増えるぜ！"
    },
    {
      "index": 14,
      "id": "msg_main8000_shortpants_04",
      "hash": "f371c2fe6a94da98",
      "flags": 0,
      "text": "ちなみに　ショップは\\nあの　あお～い　建物！"
    },
    {
      "index": 15,
      "id": "msg_main8000_shortpants_05",
      "hash": "f371c3fe6a94dc4b",
      "flags": 0,
      "text": "いろんな　町に　あるから\\nもう　知ってる　よな！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_8000_max",
      "hash": "830692b4aa69baa7"
    }
  ]
}
