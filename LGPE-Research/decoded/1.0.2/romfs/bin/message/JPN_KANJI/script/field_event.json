{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_fld_hiden_01",
      "hash": "c3075734bbf2e150",
      "flags": 0,
      "text": "……この木は　なんだか　切れそうだ！\\nヒジュツ・ケサギリで　切りますか？"
    },
    {
      "index": 1,
      "id": "msg_fld_hiden_02",
      "hash": "c3075a34bbf2e669",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]は\\nケサギリで　切りまくった！"
    },
    {
      "index": 2,
      "id": "msg_fld_hiden_03",
      "hash": "c3075934bbf2e4b6",
      "flags": 0,
      "text": "この木は　なんだか　切れそうだ！"
    },
    {
      "index": 3,
      "id": "msg_fld_hiden_04",
      "hash": "c3075c34bbf2e9cf",
      "flags": 0,
      "text": "ケサギリで\\n切れそうな　ものが　ありません！"
    },
    {
      "index": 4,
      "id": "msg_fld_hiden_05",
      "hash": "c3075b34bbf2e81c",
      "flags": 0,
      "text": "重そうな　ブロックだ！\\nヒジュツ・オシダシを　使いますか？"
    },
    {
      "index": 5,
      "id": "msg_fld_hiden_06",
      "hash": "c3075e34bbf2ed35",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]は　オシダシで\\nブロックを　押せるように　なった！"
    },
    {
      "index": 6,
      "id": "msg_fld_hiden_07",
      "hash": "c3075d34bbf2eb82",
      "flags": 0,
      "text": "重そうな　ブロック　だけど……\\n強く　押せば　動かせそう"
    },
    {
      "index": 7,
      "id": "msg_fld_hiden_08",
      "hash": "c3076034bbf2f09b",
      "flags": 0,
      "text": "オシダシの　おかげで\\nブロックを　押して　動かせる！"
    },
    {
      "index": 8,
      "id": "msg_fld_hiden_19",
      "hash": "c303eb34bbeff3f5",
      "flags": 0,
      "text": "壁が　なくなって\\n通れる　ように　なった！"
    },
    {
      "index": 9,
      "id": "msg_fld_hiden_20",
      "hash": "c3006c34bbece651",
      "flags": 0,
      "text": "カチッ！"
    },
    {
      "index": 10,
      "id": "msg_fld_hiden_09",
      "hash": "c3075f34bbf2eee8",
      "flags": 0,
      "text": "水面は　静かに　ゆれている……\\nヒジュツ・ミズバシリを　つかいますか？"
    },
    {
      "index": 11,
      "id": "msg_fld_hiden_10",
      "hash": "c303f234bbefffda",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]は\\nミズバシリを　使った！"
    },
    {
      "index": 12,
      "id": "msg_fld_hiden_11",
      "hash": "c303f334bbf0018d",
      "flags": 0,
      "text": "ここ　では\\nミズバシリ　できない　みたい"
    },
    {
      "index": 13,
      "id": "msg_fld_hiden_12",
      "hash": "c303f034bbeffc74",
      "flags": 0,
      "text": "水面は　静かに　ゆれている……"
    },
    {
      "index": 14,
      "id": "msg_fld_hiden_13",
      "hash": "c303f134bbeffe27",
      "flags": 0,
      "text": "あたりは　一面　真っ暗だ……\\nヒジュツ・カガヤキを　使いますか？"
    },
    {
      "index": 15,
      "id": "msg_fld_hiden_14",
      "hash": "c303ee34bbeff90e",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]の　カガヤキで\\nまわりが　あかるく　みえはじめた！"
    },
    {
      "index": 16,
      "id": "msg_fld_hiden_17",
      "hash": "c303ed34bbeff75b",
      "flags": 0,
      "text": "あたりは　一面　真っ暗だ……\\nこのまま　進むのは　難しそう"
    },
    {
      "index": 17,
      "id": "msg_fld_hiden_18",
      "hash": "c303ea34bbeff242",
      "flags": 0,
      "text": "使っても　効果が　ないよ"
    },
    {
      "index": 18,
      "id": "msg_fld_hiden_15",
      "hash": "c303ef34bbeffac1",
      "flags": 0,
      "text": "ヒジュツ・ソラワタリで\\n[VAR LOCATION(0000)]に　行きますか？"
    },
    {
      "index": 19,
      "id": "msg_fld_hiden_16",
      "hash": "c303ec34bbeff5a8",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]は\\nソラワタリを　つかって　とびあがった！"
    },
    {
      "index": 20,
      "id": "msg_fld_select_01",
      "hash": "4eb6529034653db6",
      "flags": 0,
      "text": "はい"
    },
    {
      "index": 21,
      "id": "msg_fld_select_02",
      "hash": "4eb6519034653c03",
      "flags": 0,
      "text": "いいえ"
    },
    {
      "index": 22,
      "id": "msg_fld_ev_spray_01",
      "hash": "5c28fa0044bd5c69",
      "flags": 0,
      "text": "スプレーの　効果が　切れた！"
    },
    {
      "index": 23,
      "id": "msg_fld_ev_spray_02",
      "hash": "5c28f70044bd5750",
      "flags": 0,
      "text": "スプレーの　効果が　切れた！\\n続けて　使いますか？"
    },
    {
      "index": 24,
      "id": "msg_fld_ev_spray_03",
      "hash": "5c28f80044bd5903",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は\\n[VAR ITEM2(0001)]を　使った！"
    },
    {
      "index": 25,
      "id": "msg_fld_ev_bookshelf_01",
      "hash": "d2e186b675233e1f",
      "flags": 0,
      "text": "ポケモンの　本や　写真集が\\nズラリと　並んでいる！"
    },
    {
      "index": 26,
      "id": "msg_fld_ev_kowaserurock_01",
      "hash": "82155501d67638d0",
      "flags": 0,
      "text": "頑丈そうな　岩だ……！\\nポケモンの　パワーなら　壊せるかも？"
    },
    {
      "index": 27,
      "id": "msg_fld_ev_tv_common_01",
      "hash": "5f755c2798a62f24",
      "flags": 0,
      "text": "おねえさんと　ポケモンが\\n今日の　ニュースを　伝えてる！"
    },
    {
      "index": 28,
      "id": "msg_fld_ev_oserurock_01",
      "hash": "2d2b876ebccb41e5",
      "flags": 0,
      "text": "大きくて　重そうな　岩だ……！\\nポケモンの　パワーなら　押せるかも？"
    },
    {
      "index": 29,
      "id": "msg_egg_event_01",
      "hash": "cc883b93ea002f97",
      "flags": 0,
      "text": "……おや？"
    },
    {
      "index": 30,
      "id": "msg_ride_check_01",
      "hash": "6dc3493c009990b8",
      "flags": 0,
      "text": "ケンタロスを　呼びだしますか？"
    },
    {
      "index": 31,
      "id": "msg_ride_check_02",
      "hash": "6dc34c3c009995d1",
      "flags": 0,
      "text": "カイリキーを　呼びだしますか？"
    },
    {
      "index": 32,
      "id": "msg_ride_check_03",
      "hash": "6dc34b3c0099941e",
      "flags": 0,
      "text": "サメハダーを　呼びだしますか？"
    },
    {
      "index": 33,
      "id": "msg_ride_check_ng_01",
      "hash": "6d36fe6fcfb55062",
      "flags": 0,
      "text": "ここでは　場所が　せまくて\\nライドポケモンを　呼びだせない"
    },
    {
      "index": 34,
      "id": "msg_fld_ev_colon_01",
      "hash": "205807eddd52f34f",
      "flags": 0,
      "text": "コロンの　効果が　切れた！"
    },
    {
      "index": 35,
      "id": "msg_fld_ev_colon_02",
      "hash": "205808eddd52f502",
      "flags": 0,
      "text": "コロンの　効果が　切れた！\\n続けて　使いますか？"
    },
    {
      "index": 36,
      "id": "msg_fld_ev_boxfull_01",
      "hash": "9442742ebe9d881a",
      "flags": 0,
      "text": "ポケモンボックスが　いっぱいで\\n話しかけ　られない！！\\r\\n……また　あとで　こよう"
    },
    {
      "index": 37,
      "id": "msg_fld_ev_no_push_01",
      "hash": "55f78515b56260be",
      "flags": 0,
      "text": "これ　以上\\n奥に　押せない！"
    },
    {
      "index": 38,
      "id": "msg_fld_ev_no_push_02",
      "hash": "55f78415b5625f0b",
      "flags": 0,
      "text": "この　方向　からは\\n押せない！"
    }
  ],
  "unpaired_labels": [
