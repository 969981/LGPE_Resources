    {
      "index": 0,
      "id": "msg_t009r0204_diary_01",
      "hash": "195895652cba1f2a",
      "flags": 0,
      "text": "日記　９月１日\\nポケモン　ミュウツーは　強すぎる\\c\\nダメだ……\\nわたしの　手には　負えない！"
    },
    {
      "index": 1,
      "id": "msg_t009r0204_bed_01",
      "hash": "92031dac46130782",
      "flags": 0,
      "text": "ベッドが　ある……\\n休んでいこう"
    },
    {
      "index": 2,
      "id": "msg_t009r0204_pod_01",
      "hash": "727f2fb532261b32",
      "flags": 0,
      "text": "丈夫な　ガラスで　できた\\n大型の　入れ物だ\\c\\nガラスには　内側から　何度も\\n叩いた　ような　跡がある"
    },
    {
      "index": 3,
      "id": "msg_t009r0204_pod_02",
      "hash": "727f2eb53226197f",
      "flags": 0,
      "text": "丈夫な　ガラスで　できた\\n入れ物だ\\c\\nところ　どころに\\n液体が　乾いた　跡がある"
    },
    {
      "index": 4,
      "id": "msg_t009r0204_pod_03",
      "hash": "727f2db5322617cc",
      "flags": 0,
      "text": "スイッチと　メーターが\\nたくさん　ついた　機械だ\\c\\n長い間　使われて　なさそう"
    },
    {
      "index": 5,
      "id": "msg_t009r0204_switch_01",
