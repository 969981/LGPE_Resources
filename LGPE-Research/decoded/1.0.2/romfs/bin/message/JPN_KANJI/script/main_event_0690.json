{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0690_musashi_01",
      "hash": "d74771d1dcdd62f4",
      "flags": 0,
      "text": "ムサシ『サカキ様の　ために\\nシオンタウンまで　来たけど……"
    },
    {
      "index": 1,
      "id": "msg_main0690_musashi_02",
      "hash": "d74774d1dcdd680d",
      "flags": 0,
      "text": "フジって　じいさん\\nどこにも　いないじゃない！"
    },
    {
      "index": 2,
      "id": "msg_main0690_kojiro_01",
      "hash": "c6bc31c54cc29f90",
      "flags": 0,
      "text": "コジロウ『あと　探して　ないのは\\nポケモンタワーの　てっぺん　とか？"
    },
    {
      "index": 3,
      "id": "msg_main0690_musashi_03",
      "hash": "d74773d1dcdd665a",
      "flags": 0,
      "text": "ムサシ『変な　[VAR COLOR(0006)]ゆうれい[VAR COLOR(0000)]が　ジャマで\\n[VAR COLOR(0006)]上まで　行けない[VAR COLOR(0000)]の　よねー"
    },
    {
      "index": 4,
      "id": "msg_main0690_kojiro_02",
      "hash": "c6bc34c54cc2a4a9",
      "flags": 0,
      "text": "コジロウ『じいさんは\\n見つけられ　なかったが\\c\\nこの　カラカラ　だけでも\\nアジトまで　さらっていこうぜ！"
    },
    {
      "index": 5,
      "id": "msg_main0690_musashi_04",
      "hash": "d7476ed1dcdd5ddb",
      "flags": 0,
      "text": "ムサシ『そうね！　[VAR COLOR(0006)]タマムシシティ[VAR COLOR(0000)]の\\n[VAR COLOR(0006)]ロケットゲームコーナー[VAR COLOR(0000)]に　行きましょ"
    },
    {
      "index": 6,
      "id": "msg_main0690_karakara_01",
      "hash": "8ac4c1eac38e8eb8",
      "flags": 0,
      "text": "カラカラ『マァー？"
    },
    {
      "index": 7,
      "id": "msg_main0690_musashi_08",
      "hash": "d7476ad1dcdd570f",
      "flags": 0,
      "text": "ムサシ『ハイハイ　あんたの　ママは\\nタマムシシティに　いまちゅよー\\r\\n一緒に　行きましょねー"
    },
    {
      "index": 8,
      "id": "msg_main0690_karakara_02",
      "hash": "8ac4c4eac38e93d1",
      "flags": 0,
      "text": "カラカラ『マァ　マァ！"
    },
    {
      "index": 9,
      "id": "msg_main0690_all_01",
      "hash": "afaa9eb286d542b1",
      "flags": 0,
      "text": "そうと　決まれば\\nそれ　急げー！"
    },
    {
      "index": 10,
      "id": "msg_main0690_young_m_01",
      "hash": "9bacda0fa316a5ac",
      "flags": 0,
      "text": "た　たいへんな　ものを\\n見てしまった……"
    },
    {
      "index": 11,
      "id": "msg_main0690_young_m_02",
      "hash": "9bacdd0fa316aac5",
      "flags": 0,
      "text": "きみ　見た！？\\nロケット団が　カラカラを\\r\\n連れてっちゃった！"
    },
    {
      "index": 12,
      "id": "msg_main0690_young_m_03",
      "hash": "9bacdc0fa316a912",
      "flags": 0,
      "text": "[VAR COLOR(0006)]タマムシシティ[VAR COLOR(0000)]に\\n向かった　らしいけど……"
    },
    {
      "index": 13,
      "id": "msg_main0690_young_m_04",
      "hash": "9bacd70fa316a093",
      "flags": 0,
      "text": "ホネを　取って　高く\\n売るつもり　なのかも……！"
    },
    {
      "index": 14,
      "id": "msg_main0690_young_m_05",
      "hash": "9bacd60fa3169ee0",
      "flags": 0,
      "text": "ロケット団　から\\nカラカラを　助けたの！？\\r\\nきみ　すごいな！"
    },
    {
      "index": 15,
      "id": "msg_main0690_young_m_06",
      "hash": "9bacd90fa316a3f9",
      "flags": 0,
      "text": "これ　ありがとうの\\n気持ち　だよ！"
    },
    {
      "index": 16,
      "id": "msg_main0690_system_01",
      "hash": "097ca861ce11115b",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は\\nスーパーボールを　２０個　もらった！"
    },
    {
      "index": 17,
      "id": "msg_main0690_young_m_07",
      "hash": "9bacd80fa316a246",
      "flags": 0,
      "text": "きみ　みたいに\\n勇気が　あれば\\c\\nポケモンタワーも　平気で\\nのぼれるん　だろうね"
    },
    {
      "index": 18,
      "id": "msg_main0690_musashi_05",
      "hash": "d7476dd1dcdd5c28",
      "flags": 0,
      "text": "ムサシ『いけ！　そこよ！\\nあーん！　もう　ちょっと　なのに！"
    },
    {
      "index": 19,
      "id": "msg_main0690_kojiro_03",
      "hash": "c6bc33c54cc2a2f6",
      "flags": 0,
      "text": "コジロウ『なぁ　ムサシー\\c\\nそろそろ　アジトに　戻らないか？"
    },
    {
      "index": 20,
      "id": "msg_main0690_musashi_06",
      "hash": "d74770d1dcdd6141",
      "flags": 0,
      "text": "ムサシ『えー　いいじゃなーい！\\c\\n[VAR COLOR(0006)]カラカラ[VAR COLOR(0000)]は　見張りに　届けたし\\n休憩よ　休憩！\\c\\nってか　[VAR COLOR(0006)]アジトの　隠し扉[VAR COLOR(0000)]\\nどうやって　開けるん　だっけ？"
    },
    {
      "index": 21,
      "id": "msg_main0690_kojiro_04",
      "hash": "c6bc36c54cc2a80f",
      "flags": 0,
      "text": "コジロウ『[VAR COLOR(0006)]乗り物[VAR COLOR(0000)]の　[VAR COLOR(0006)]ポスター[VAR COLOR(0000)]\\n調べるん　だよ！\\c\\n[VAR COLOR(0006)]オレたち　らしい　[VAR COLOR(0000)]サイコーな\\n[VAR COLOR(0006)]乗り物[VAR COLOR(0000)]の　ポスターをさ！"
    },
    {
      "index": 22,
      "id": "msg_main0690_musashi_07",
      "hash": "d7476fd1dcdd5f8e",
      "flags": 0,
      "text": "ムサシ『あたしたち　らしい\\n乗り物って　なによ？"
    },
    {
      "index": 23,
      "id": "msg_main0690_kojiro_05",
      "hash": "c6bc35c54cc2a65c",
      "flags": 0,
      "text": "コジロウ『あれに　決まってるだろ？\\n[VAR COLOR(0006)]宇宙を　かける……[VAR COLOR(0000)]　さ！"
    },
    {
      "index": 24,
      "id": "msg_main0690_nyasu_01",
      "hash": "299ff18c5c968898",
      "flags": 0,
      "text": "ニャース『ふにーん"
    }
  ],
