{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8060_gym_01",
      "hash": "28fceded578acd02",
      "flags": 0,
      "text": "おーす！\\n未来の　チャンピオン！\\c\\nこの　ジムでは……"
    },
    {
      "index": 1,
      "id": "msg_main8060_fire_01",
      "hash": "5d983f69274032b5",
      "flags": 0,
      "text": "？？？『うおーす！\\n第１問！"
    },
    {
      "index": 2,
      "id": "msg_main8060_gym_02",
      "hash": "28fceced578acb4f",
      "flags": 0,
      "text": "ちょっとッ　カツラさん！\\nまだ　だよ！"
    },
    {
      "index": 3,
      "id": "msg_main8060_fire_02",
      "hash": "5d983c6927402d9c",
      "flags": 0,
      "text": "カツラ『そうか！"
    },
    {
      "index": 4,
      "id": "msg_main8060_gym_03",
      "hash": "28fcebed578ac99c",
      "flags": 0,
      "text": "……えー　今の　おやじが\\nグレンジム　リーダーの　カツラ！\\r\\nほのおの　プロフェッショナルだ！\\c\\nそれは　ともかく\\nよく　[VAR COLOR(0006)]ひみつのカギ[VAR COLOR(0000)]を　見つけたな！\\r\\nジムへの　挑戦を　認めよう！\\c\\nこの　ジムでは　クイズにも\\n挑戦　して　もらう！\\r\\nまー　楽しんで　くれ！"
    },
    {
      "index": 5,
      "id": "msg_main8060_gym_04",
      "hash": "28fceaed578ac7e9",
      "flags": 0,
      "text": "さあさあ！　奥に　進んで\\nクイズと　勝負を　楽しめ！"
    },
    {
      "index": 6,
      "id": "msg_main8060_gym_05",
      "hash": "28fce9ed578ac636",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]！　勝ったか！\\n暑苦しい　おやじ　だったな！"
    },
    {
      "index": 7,
      "id": "msg_main8060_fire_03",
      "hash": "5d983d6927402f4f",
      "flags": 0,
      "text": "カツラ『どうだ！\\n始めて　いいかな？"
    },
    {
      "index": 8,
      "id": "msg_main8060_fire_04",
      "hash": "5d983a6927402a36",
      "flags": 0,
      "text": "そうか！"
    },
    {
      "index": 9,
      "id": "msg_main8060_fire_05",
      "hash": "5d983b6927402be9",
      "flags": 0,
      "text": "よし　そこに　立ってくれ！"
    },
    {
      "index": 10,
      "id": "msg_main8060_fire_06",
      "hash": "5d983869274026d0",
      "flags": 0,
      "text": "カツラ『うおーす！\\nグレンジムが　お届け　する\\r\\nポケモン　クイズー！"
    },
    {
      "index": 11,
      "id": "msg_main8060_fire_07",
      "hash": "5d98396927402883",
      "flags": 0,
      "text": "チャレンジャー　には\\n５つの　問題に\\r\\n答えて　いただく　わけだ！\\c\\n正解　したら\\nカツラさん人形が　もらえる！"
    },
    {
      "index": 12,
      "id": "msg_main8060_fire_08",
      "hash": "5d98466927403e9a",
      "flags": 0,
      "text": "クイズを　間違えたら\\n弟子の　トレーナーと\\r\\n戦って　もらうことに　なってるぞ！\\c\\n弟子に　勝てたら　やっぱり\\nカツラさん人形を　あげよう！\\c\\nカツラさん人形を　５個\\n集められる　かな！？"
    },
    {
      "index": 13,
      "id": "msg_main8060_fire_09",
      "hash": "5d9847692740404d",
      "flags": 0,
      "text": "カツラ『それでは　さっそく　第１問！"
    },
    {
      "index": 14,
      "id": "msg_main8060_sys_01",
      "hash": "ff3cc2b88ab47450",
      "flags": 0,
      "text": "問題！\\c\\nひふきポケモンと　いえば？"
    },
    {
      "index": 15,
      "id": "msg_main8060_select_01",
      "hash": "427ed350510c0079",
      "flags": 0,
      "text": "ブーバー"
    },
    {
      "index": 16,
      "id": "msg_main8060_select_02",
      "hash": "427ed050510bfb60",
      "flags": 0,
      "text": "ガーディ"
    },
    {
      "index": 17,
      "id": "msg_main8060_fire_10",
      "hash": "5d9b44692742710b",
      "flags": 0,
      "text": "カツラ『さて！\\n第２問　いくぞー！"
    },
    {
      "index": 18,
      "id": "msg_main8060_sys_02",
      "hash": "ff3cc5b88ab47969",
      "flags": 0,
      "text": "問題！\\c\\nポケモンリーグ　認定\\nジムバッジは　全部で　いくつ？"
    },
    {
      "index": 19,
      "id": "msg_main8060_select_03",
      "hash": "427ed150510bfd13",
      "flags": 0,
      "text": "７こ"
    },
    {
      "index": 20,
      "id": "msg_main8060_select_04",
      "hash": "427ed650510c0592",
      "flags": 0,
      "text": "８こ"
    },
    {
      "index": 21,
      "id": "msg_main8060_fire_11",
      "hash": "5d9b436927426f58",
      "flags": 0,
      "text": "カツラ『まだまだ　いくぞー！\\n第２問！"
    },
    {
      "index": 22,
      "id": "msg_main8060_gym_06",
      "hash": "28fce8ed578ac483",
      "flags": 0,
      "text": "おじさん『ちょっとッ　カツラさん！\\n３問め　だよ！"
    },
    {
      "index": 23,
      "id": "msg_main8060_fire_12",
      "hash": "5d9b466927427471",
      "flags": 0,
      "text": "カツラ『第３問！"
    },
    {
      "index": 24,
      "id": "msg_main8060_sys_03",
      "hash": "ff3cc4b88ab477b6",
      "flags": 0,
      "text": "問題！\\c\\nはがねタイプの　わざは\\nほのおタイプの　ポケモンに……？"
    },
    {
      "index": 25,
      "id": "msg_main8060_select_05",
      "hash": "427ed750510c0745",
      "flags": 0,
      "text": "効果　ばつぐん！"
    },
    {
      "index": 26,
      "id": "msg_main8060_select_06",
      "hash": "427ed450510c022c",
      "flags": 0,
      "text": "効果は　いまひとつ"
    },
    {
      "index": 27,
      "id": "msg_quiz_01_p04_t009_r0101",
      "hash": "03ef5b9403184a86",
      "flags": 0,
      "text": "[~ 27]"
    },
    {
      "index": 28,
      "id": "msg_quiz_01_p06_t009_r0101",
      "hash": "a2bea715e3569344",
      "flags": 0,
      "text": "[~ 28]"
    },
    {
      "index": 29,
      "id": "msg_main8060_fire_13",
      "hash": "5d9b4569274272be",
      "flags": 0,
      "text": "カツラ『さあ！\\c\\nチャレンジャーは　これまでに\\n見事　カツラさん人形を\\r\\n３個とも　集めて　いるぞッ！"
    },
    {
      "index": 30,
      "id": "msg_main8060_fire_29",
      "hash": "5d913b69273a0d3b",
      "flags": 0,
      "text": "続けて　第４問！"
    },
    {
      "index": 31,
      "id": "msg_main8060_sys_04",
      "hash": "ff3cc7b88ab47ccf",
      "flags": 0,
      "text": "問題！\\c\\n「わざマシン２８」　とは\\n「しねしねこうせん」　である？"
    },
    {
      "index": 32,
      "id": "msg_main8060_select_07",
      "hash": "427ed550510c03df",
      "flags": 0,
      "text": "はい"
    },
    {
      "index": 33,
      "id": "msg_main8060_select_08",
      "hash": "427eda50510c0c5e",
      "flags": 0,
      "text": "いいえ"
    },
    {
      "index": 34,
      "id": "msg_main8060_select_09",
      "hash": "427edb50510c0e11",
      "flags": 0,
      "text": "なんやそれ！？"
    },
    {
      "index": 35,
      "id": "msg_main8060_fire_14",
      "hash": "5d9b4869274277d7",
      "flags": 0,
      "text": "カツラ『チャレンジャーが　集めた\\nカツラさん人形は　４個！\\c\\nいよいよ　ラスト　問題だー！\\nはりきって　答えてくれ！"
    },
    {
      "index": 36,
      "id": "msg_main8060_sys_05",
      "hash": "ff3cc6b88ab47b1c",
      "flags": 0,
      "text": "ラスト　問題！\\c\\nチャレンジャー　[VAR TRNAME(0000)]が\\n今から　戦う　相手は！？"
    },
    {
      "index": 37,
      "id": "msg_main8060_select_10",
      "hash": "42825850510f184f",
      "flags": 0,
      "text": "カツラ"
    },
    {
      "index": 38,
      "id": "msg_main8060_select_11",
      "hash": "42825750510f169c",
      "flags": 0,
      "text": "グレンの　ジムリーダー"
    },
    {
      "index": 39,
      "id": "msg_main8060_select_12",
      "hash": "42825a50510f1bb5",
      "flags": 0,
      "text": "ほのおの　プロフェッショナル"
    },
    {
      "index": 40,
      "id": "msg_main8060_select_13",
      "hash": "42825950510f1a02",
      "flags": 0,
      "text": "熱血　クイズおやじ"
    },
    {
      "index": 41,
      "id": "msg_main8060_select_14",
      "hash": "42825450510f1183",
      "flags": 0,
      "text": "カツラさん　かなー？"
    },
    {
      "index": 42,
      "id": "msg_main8060_select_15",
      "hash": "42825350510f0fd0",
      "flags": 0,
      "text": "あなた　です！"
    },
    {
      "index": 43,
      "id": "msg_main8060_select_16",
      "hash": "42825650510f14e9",
      "flags": 0,
      "text": "[~ 43]"
    },
    {
      "index": 44,
      "id": "msg_main8060_select_17",
      "hash": "42825550510f1336",
      "flags": 0,
      "text": "[~ 44]"
    },
    {
      "index": 45,
      "id": "msg_main8060_fire_15",
      "hash": "5d9b476927427624",
      "flags": 0,
      "text": "カツラ『チャレンジャーが　答えたぞ！\\n気になる　判定はッ……！？"
    },
    {
      "index": 46,
      "id": "msg_main8060_sys_06",
      "hash": "ff3cc9b88ab48035",
      "flags": 0,
      "text": "だ・い・せ・い・かーい！\\nあたり　です！"
    },
    {
      "index": 47,
      "id": "msg_main8060_sys_07",
      "hash": "ff3cc8b88ab47e82",
      "flags": 0,
      "text": "ばか　はずれです……"
    },
    {
      "index": 48,
      "id": "msg_main8060_fire_16",
      "hash": "5d9b4a6927427b3d",
      "flags": 0,
      "text": "カツラ『おめでとーッ！\\nカツラさん人形　獲得だー！"
    },
    {
      "index": 49,
      "id": "msg_main8060_fire_17",
      "hash": "5d9b49692742798a",
      "flags": 0,
      "text": "カツラ『ざんねん　むねん！\\n惜しくも　はずれ！\\c\\nチャレンジャーに　戦って　もらう\\n弟子の　トレーナー！　いでよ！"
    },
    {
      "index": 50,
      "id": "msg_main8060_fire_18",
      "hash": "5d9b3c6927426373",
      "flags": 0,
      "text": "カツラ『見事な　勝利！\\nカツラさん人形　獲得だー！"
    },
    {
      "index": 51,
      "id": "msg_main8060_fire_19",
      "hash": "5d9b3b69274261c0",
      "flags": 0,
      "text": "カツラ『うおおーす！"
    },
    {
      "index": 52,
      "id": "msg_main8060_fire_24",
      "hash": "5d913669273a04bc",
      "flags": 0,
      "text": "みごと　５個の\\nカツラさん人形を　集めた\\r\\nチャレンジャーよ！"
    },
    {
      "index": 53,
      "id": "msg_main8060_fire_25",
      "hash": "5d913769273a066f",
      "flags": 0,
      "text": "いよいよ\\n勝負の時が　来たぞー！"
    },
    {
      "index": 54,
      "id": "msg_main8060_fire_26",
      "hash": "5d913869273a0822",
      "flags": 0,
      "text": "わしは　燃える男！\\nグレン島　ポケモンジムの　カツラ"
    },
    {
      "index": 55,
      "id": "msg_main8060_fire_27",
      "hash": "5d913969273a09d5",
      "flags": 0,
      "text": "わしの　ポケモンは　全てを\\nほのおで　焼いて　こがしまくる\\r\\nつわもの　ばかり　なのだー！"
    },
    {
      "index": 56,
      "id": "msg_main8060_fire_28",
      "hash": "5d913a69273a0b88",
      "flags": 0,
      "text": "うおおーす！\\nやけどなおしの　用意は　いいか！"
    },
    {
      "index": 57,
      "id": "msg_gymleader_07_02",
      "hash": "a4212e53d369a560",
      "flags": 0,
      "text": "[~ 57]"
    },
    {
      "index": 58,
      "id": "msg_main8060_fire_23",
      "hash": "5d913569273a0309",
      "flags": 0,
      "text": "おまえに　こそ！\\nクリムゾンバッジは　ふさわしい！"
    },
    {
      "index": 59,
      "id": "msg_main8060_sys_08",
      "hash": "ff3ccbb88ab4839b",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　カツラから\\n[VAR COLOR(0006)]クリムゾンバッジ[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 60,
      "id": "msg_main8060_fire_20",
      "hash": "5d9132692739fdf0",
      "flags": 0,
      "text": "それから！\\nこの　わざマシンを　受けとれい！"
    },
    {
      "index": 61,
      "id": "msg_main8060_sys_09",
      "hash": "ff3ccab88ab481e8",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　カツラから\\n[VAR ITEM2(0001)]\\r\\n「[VAR COLOR(0006)][VAR MOVE(0002)][VAR COLOR(0000)]」を　もらった！"
    },
    {
      "index": 62,
      "id": "msg_main8060_fire_21",
      "hash": "5d9133692739ffa3",
      "flags": 0,
      "text": "わざマシン４６は\\n燃える　大技！　だいもんじ！\\c\\nだいもんじは\\nほのお　タイプの　ポケモン！\\c\\nロコンや　リザードに\\n覚えさせると　よいぞ！"
    },
    {
      "index": 63,
      "id": "msg_main8060_fire_22",
      "hash": "5d913469273a0156",
      "flags": 0,
      "text": "この　わざを　みんなは\\nだいもんじやき　と　呼んでるが\\r\\nそりゃ　間違いだ！\\c\\n本場では　だいもんじ　とか\\nおくりび　と　呼んで　いるのだ！"
    },
    {
      "index": 64,
      "id": "msg_gymleader_07_13",
      "hash": "a424b753d36cc402",
      "flags": 0,
      "text": "[~ 64]"
    },
    {
      "index": 65,
      "id": "msg_main8060_oldm_01_01",
      "hash": "e734b77852176f89",
      "flags": 0,
      "text": "今日も　あっつい　勝負と\\nクイズが　楽しみ　じゃのう！"
    },
    {
      "index": 66,
      "id": "msg_main8060_oldm_01_02",
      "hash": "e734b47852176a70",
      "flags": 0,
      "text": "いい　勝負　だったのう！\\nわしまで　熱く　なった！"
    },
    {
      "index": 67,
      "id": "msg_main8060_oldm_02_01",
      "hash": "b85eb76044c5f3d6",
      "flags": 0,
      "text": "ほのおタイプの　ジムリーダー\\nってのは　他にも　いるのかい？"
    },
    {
      "index": 68,
      "id": "msg_main8060_oldm_02_02",
      "hash": "b85eb66044c5f223",
      "flags": 0,
      "text": "あんたも　強いねえ\\nジムリーダーに　なるのかい？"
    },
    {
      "index": 69,
      "id": "msg_main8060_oldw_01",
      "hash": "b9fb0fcd6a945377",
      "flags": 0,
      "text": "カツラは\\n司会者の　腕は　アレだが\\r\\n勝負は　滅法　強いぞ！"
    },
    {
      "index": 70,
      "id": "msg_main8060_oldw_02",
      "hash": "b9fb10cd6a94552a",
      "flags": 0,
      "text": "カツラも　おぬしも\\nよー　やった！"
    },
    {
      "index": 71,
      "id": "msg_main8060_nresearcher_01",
      "hash": "c8aa82fb5a887513",
      "flags": 0,
      "text": "グレンタウンに　住む\\n研究員の　家族が\\r\\n退屈　しない　ように\\c\\nカツラさん　いろいろ\\n考えて　くれてんですよ"
    },
    {
      "index": 72,
      "id": "msg_main8060_childm_01",
      "hash": "b995ef96c9f32a92",
      "flags": 0,
      "text": "あはは！\\nカツラさん　おもしろーい"
    },
    {
      "index": 73,
      "id": "msg_main8060_childm_02",
      "hash": "b995ee96c9f328df",
      "flags": 0,
      "text": "カツラさん人形　ほしー"
    },
    {
      "index": 74,
      "id": "msg_main8060_middlew_01",
      "hash": "9ce1049e473a73e9",
      "flags": 0,
      "text": "なんにも　ない　グレンタウン\\n唯一の　楽しみよ"
    },
    {
      "index": 75,
      "id": "msg_main8060_middlew_02",
      "hash": "9ce1019e473a6ed0",
      "flags": 0,
      "text": "さいきん　強い　チャレンジャーが\\n沢山で　退屈しないわ"
    },
    {
      "index": 76,
      "id": "msg_main8060_childf_01",
      "hash": "4879fff09d725dfd",
      "flags": 0,
      "text": "トレーナーさん　がんばってー"
    },
    {
      "index": 77,
      "id": "msg_main8060_childf_02",
      "hash": "4879fcf09d7258e4",
      "flags": 0,
      "text": "クイズ　してる　ときねー\\nトレーナー　さんの\\r\\n[VAR POKNAME(0002)]　かわいかった！"
    },
    {
      "index": 78,
      "id": "msg_main8060_boy_01",
      "hash": "e75cfb1b89c05ad1",
      "flags": 0,
      "text": "ボク　トレーナーじゃ　ないけど\\nカツラさんが　見てても　いいって！"
    },
    {
      "index": 79,
      "id": "msg_main8060_boy_02",
      "hash": "e75cf81b89c055b8",
      "flags": 0,
      "text": "クイズの　答え\\nいっこだけ　ボクも　わかったよ！"
    },
    {
      "index": 80,
      "id": "TRID_SCIENCE_07_TRMSG_FIGHT_START",
      "hash": "8abc15877b5e3e17",
      "flags": 0,
      "text": "ポケモンが　吐く　炎の　温度\\nどの　くらいか　知ってる？"
    },
    {
      "index": 81,
      "id": "TRID_SCIENCE_07_TRMSG_FIGHT_LOSE",
      "hash": "f3e884c4b24e3400",
      "flags": 0,
      "text": "[~ 81]"
    },
    {
      "index": 82,
      "id": "TRID_SCIENCE_07_TRMSG_FIGHT_AFTER",
      "hash": "98b31de0b287c8e1",
      "flags": 0,
      "text": "燃える　っていう　のは\\n空気中の　酸素が……\\c\\nむにゃむにゃ……　ブツブツ"
    },
    {
      "index": 83,
      "id": "TRID_THIEF_04_TRMSG_FIGHT_START",
      "hash": "51c090c3a274e934",
      "flags": 0,
      "text": "どろぼうと　名乗って　おりやすが\\n足を　洗って\\r\\nここで　修行　してまっせえ！"
    },
    {
      "index": 84,
      "id": "TRID_THIEF_04_TRMSG_FIGHT_LOSE",
      "hash": "68bceb3de49b2b21",
      "flags": 0,
      "text": "[~ 84]"
    },
    {
      "index": 85,
      "id": "TRID_THIEF_04_TRMSG_FIGHT_AFTER",
      "hash": "8823de5b821025d2",
      "flags": 0,
      "text": "ひとの　ポケモン　見ると\\nつい　盗みたく　なっちゃうんでさ！"
    },
    {
      "index": 86,
