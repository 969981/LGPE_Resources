  "lines": [
    {
      "index": 0,
      "id": "msg_main0110_doctor_01",
      "hash": "484df45b107f77ec",
      "flags": 0,
      "text": "オーキド『おお！　[VAR TRNAME(0000)]\\nどーだい？　[VAR POKNAME(0002)]の　様子は"
    },
    {
      "index": 1,
      "id": "msg_main0110_doctor_14",
      "hash": "484a735b107c66e2",
      "flags": 0,
      "text": "……んっ？　んんっ！？"
    },
    {
      "index": 2,
      "id": "msg_main0110_doctor_02",
      "hash": "484df75b107f7d05",
      "flags": 0,
      "text": "オーキド『ほう！\\n[VAR POKNAME(0002)]は　すっかり\\r\\n[VAR TRNAME(0000)]の　相棒　気分じゃ！\\c\\nおまえ　ポケモントレーナーの\\n才能が　あるな！"
    },
    {
      "index": 3,
      "id": "msg_main0110_doctor_03",
      "hash": "484df65b107f7b52",
      "flags": 0,
      "text": "……え　わしに　渡す物が？"
    },
    {
      "index": 4,
      "id": "msg_main0110_sys_01",
      "hash": "4167fe4e820569e0",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　オーキド博士に\\nおとどけものを　渡した！"
    },
    {
      "index": 5,
      "id": "msg_main0110_doctor_04",
      "hash": "484df15b107f72d3",
      "flags": 0,
      "text": "オーキド『おお　届いたか！\\n注文の　品！\\r\\nどうも　ありがとよ！"
    },
    {
      "index": 6,
      "id": "msg_rival_01_p12_t001_r0301",
      "hash": "83d2cff374bc37f6",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_rival_01_p13_t001_r0301",
      "hash": "aaddc4c56bc5382b",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "msg_main0110_rival_01",
      "hash": "0af935fdb5aacddf",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『オーキド博士ー！\\nオレの　[VAR POKNAME(0004)]　わざを……"
    },
    {
      "index": 9,
      "id": "msg_main0110_rival_02",
      "hash": "0af936fdb5aacf92",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『わッ\\n[VAR TRNAME(0000)]　なにソレ　すげー！\\r\\n[VAR POKNAME(0002)]　乗っかってる　じゃん！"
    },
    {
      "index": 10,
      "id": "msg_main0110_doctor_05",
      "hash": "484df05b107f7120",
      "flags": 0,
      "text": "オーキド『[VAR TRNAME(0001)]か！\\nグッド　タイミング！\\c\\nいい物が　届いたんじゃ！\\nふたりに　やろう！"
    },
    {
      "index": 11,
      "id": "msg_main0110_sys_02",
      "hash": "4168014e82056ef9",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　オーキド博士に\\n[VAR COLOR(0006)]ズリのみ[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 12,
      "id": "msg_main0110_rival_03",
      "hash": "0af937fdb5aad145",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『おいしそう！"
    },
    {
      "index": 13,
      "id": "msg_main0110_doctor_06",
      "hash": "484df35b107f7639",
      "flags": 0,
      "text": "オーキド『こらこら！　それは\\nポケモンが　食べる　もんじゃ！\\c\\nポケモンを　捕まえる　とき……\\c\\nボールを　かまえる　前に\\nズリのみを　ポイっと　投げれば\\r\\nポケモンが　喜んで\\r\\nぐっと　捕まえやすく　なる！"
    },
    {
      "index": 14,
      "id": "msg_main0110_rival_04",
      "hash": "0af930fdb5aac560",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『……あぶねー\\nオレ　食べちゃう　とこだった"
    },
    {
      "index": 15,
      "id": "msg_main0110_doctor_07",
      "hash": "484df25b107f7486",
      "flags": 0,
      "text": "オーキド『ふたりとも！\\nポケモンを　たくさん　集めるも\\r\\n気に入りを　育てるも\\r\\nふたりの　自由じゃ！\\c\\n楽しく　やって　くれい！"
    },
    {
      "index": 16,
      "id": "msg_main0110_rival_05",
      "hash": "0af931fdb5aac713",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『オレ\\nポケモン　たくさん　欲しい！\\c\\nでも　それだけじゃ　なくて\\n強く　育てたいんだ"
    },
    {
      "index": 17,
      "id": "msg_main0110_doctor_08",
      "hash": "484dfd5b107f8737",
      "flags": 0,
      "text": "オーキド『たくさんの　ポケモンと\\n出会うと　いいぞ！"
    }
  ],
