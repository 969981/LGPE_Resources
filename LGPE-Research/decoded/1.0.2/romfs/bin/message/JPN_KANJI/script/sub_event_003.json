  "lines": [
    {
      "index": 0,
      "id": "msg_sub003_childf_01",
      "hash": "c1626e54b51bb525",
      "flags": 0,
      "text": "えーん！　自動販売機の\\n飲み物が　飲みたいよー！"
    },
    {
      "index": 1,
      "id": "msg_sub003_sys_00",
      "hash": "18b71d43373e409b",
      "flags": 0,
      "text": "飲み物を　あげますか？"
    },
    {
      "index": 2,
      "id": "msg_sub003_childf_02",
      "hash": "c1626b54b51bb00c",
      "flags": 0,
      "text": "えーん！　自動販売機の\\n飲み物が　飲みたいよー！"
    },
    {
      "index": 3,
      "id": "msg_sub003_sys_01",
      "hash": "18b71c43373e3ee8",
      "flags": 0,
      "text": "どれを　あげますか？"
    },
    {
      "index": 4,
      "id": "msg_sub003_select_01",
      "hash": "4e165798afa8e5c1",
      "flags": 0,
      "text": "おいしいみず"
    },
    {
      "index": 5,
      "id": "msg_sub003_select_02",
      "hash": "4e165498afa8e0a8",
      "flags": 0,
      "text": "サイコソーダ"
    },
    {
      "index": 6,
      "id": "msg_sub003_select_03",
      "hash": "4e165598afa8e25b",
      "flags": 0,
      "text": "ミックスオレ"
    },
    {
      "index": 7,
      "id": "msg_sub003_select_04",
      "hash": "4e165a98afa8eada",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 8,
      "id": "msg_sub003_childf_03",
      "hash": "c1626c54b51bb1bf",
      "flags": 0,
      "text": "わーい！\\c\\nおいしいみず　くれるの？\\c\\nごちそう　さま！\\c\\nお礼に　わたしの　宝物\\nこれ　あげるね！"
    },
    {
      "index": 9,
      "id": "msg_sub003_sys_02",
      "hash": "18b71f43373e4401",
      "flags": 0,
      "text": "[~ 9]"
    },
    {
      "index": 10,
      "id": "msg_sub003_childf_04",
      "hash": "c1626954b51baca6",
      "flags": 0,
      "text": "わざマシン０６の　中は\\nひかりのかべ　なの！\\c\\nとくしゅこうげきの　ダメージを\\n弱く　して　くれるの"
    },
    {
      "index": 11,
      "id": "msg_present_01_p05_t007_fs07",
      "hash": "8afe75b5dd6b6943",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_sub003_childf_05",
      "hash": "c1626a54b51bae59",
      "flags": 0,
      "text": "わーい！\\c\\nサイコソーダ　くれるの？\\c\\nごちそうさま！\\c\\nお礼に　わたしの　宝物\\nこれ　あげるね！"
    },
    {
      "index": 13,
      "id": "msg_sub003_childf_06",
      "hash": "c1626754b51ba940",
      "flags": 0,
      "text": "わざマシン０９の　中は\\nリフレクター　なの！\\c\\nぶつりこうげきの　ダメージを\\n弱く　して　くれるの"
    },
    {
      "index": 14,
      "id": "msg_present_01_p07_t007_fs07",
      "hash": "4832b3661df744e1",
      "flags": 0,
      "text": "[~ 14]"
    },
    {
      "index": 15,
      "id": "msg_sub003_childf_07",
      "hash": "c1626854b51baaf3",
      "flags": 0,
      "text": "わーい！\\c\\nミックスオレ　くれるの？\\c\\nごちそうさま！\\c\\nお礼に　わたしの　宝物\\nこれ　あげるね！"
    },
    {
      "index": 16,
      "id": "msg_sub003_childf_08",
      "hash": "c1627554b51bc10a",
      "flags": 0,
      "text": "わざマシン０７の　中は\\nまもる　なの！\\c\\n相手の　技を\\n防いで　くれるの"
    },
    {
      "index": 17,
      "id": "msg_present_01_p09_t007_fs07",
      "hash": "92871b329adafcd7",
      "flags": 0,
      "text": "[~ 17]"
    },
    {
      "index": 18,
      "id": "msg_present_01_p10_t007_fs06",
      "hash": "3b08dc2eeb488f1e",
      "flags": 0,
      "text": "[~ 18]"
    },
    {
      "index": 19,
      "id": "msg_sub003_childf_09",
      "hash": "c1627654b51bc2bd",
      "flags": 0,
      "text": "うーん！\\nやっぱり　我慢　する！"
    }
  ],
