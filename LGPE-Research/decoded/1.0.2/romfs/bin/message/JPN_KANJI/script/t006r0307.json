{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t006r0307_cook_01",
      "hash": "c97ffa1a1adc76f0",
      "flags": 0,
      "text": "ほら！\\nそこの　きみ　邪魔だよ！\\r\\nどいた　どいた！"
    },
    {
      "index": 1,
      "id": "msg_t006r0307_cook_02",
      "hash": "c97ffd1a1adc7c09",
      "flags": 0,
      "text": "料理に　かぶせる\\n銀の　ドーム……！\\c\\nクロッシュ　という　もの　で\\n料理を　冷めにくく　するよ"
    },
    {
      "index": 2,
      "id": "msg_t006r0307_cook_03",
      "hash": "c97ffc1a1adc7a56",
      "flags": 0,
      "text": "忙しくって　目が　回る！\\n頼む　から　あっち　行ってくれ！"
    },
    {
      "index": 3,
      "id": "msg_t006r0307_cook_04",
      "hash": "c97fff1a1adc7f6f",
      "flags": 0,
      "text": "せっせ　せっせ…\\c\\nおれは　毎日\\nイモの　皮むきだ！\\r\\nせっせ　せっせ…"
    },
    {
      "index": 4,
      "id": "msg_t006r0307_cook_05",
      "hash": "c97ffe1a1adc7dbc",
      "flags": 0,
      "text": "そういえば　食いしん坊の\\nカビゴン　知ってる？\\c\\nあんなに　よく　食べて　よく　ねる\\nポケモンは　他に　いないよ！"
    },
    {
      "index": 5,
      "id": "msg_t006r0307_cook_06",
      "hash": "c980011a1adc82d5",
      "flags": 0,
      "text": "しくしく　しくしく…\\c\\nおれは　毎日\\nタマネギの　皮むきだー\\r\\nしくしく　しくしく…"
    },
    {
      "index": 6,
      "id": "msg_t006r0307_cook_07_01",
      "hash": "6e19651585616b6c",
      "flags": 0,
      "text": "おっほん！\\nわたしが　ここの　シェフです！\\c\\n今日の　メイン　ディッシュは"
    },
    {
      "index": 7,
      "id": "msg_t006r0307_cook_07_02",
      "hash": "6e19681585617085",
      "flags": 0,
      "text": "とれたて　ピチピチ　うずしおスシ！\\c\\nしかし　お客さんに\\nまた　魚？　と　言われそうだ"
    },
    {
      "index": 8,
      "id": "msg_t006r0307_cook_07_03",
      "hash": "6e19671585616ed2",
      "flags": 0,
      "text": "カントーの　味！　ニビあられ！\\c\\n……じゃ　お客さんに\\n怒られるか？"
    },
    {
      "index": 9,
      "id": "msg_t006r0307_cook_07_04",
      "hash": "6e19621585616653",
      "flags": 0,
      "text": "ジューシーな　とっしんステーキ！\\c\\nでも　材料\\n人数分　あったかな？"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t006r0307_max",
      "hash": "d197397409d6cf5c"
    }
  ]
}
