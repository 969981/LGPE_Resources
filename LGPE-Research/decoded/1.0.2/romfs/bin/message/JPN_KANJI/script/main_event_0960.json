{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0960_rival_01",
      "hash": "d7ba3467a6083236",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『[VAR TRNAME(0000)]　やったな！\\nサカキに　勝ったんだろ？"
    },
    {
      "index": 1,
      "id": "msg_main0960_rival_02",
      "hash": "d7ba3367a6083083",
      "flags": 0,
      "text": "アポロって　やつを　追いかけて\\n外に　出てみたら……\\c\\nヤマブキシティの　ロケット団\\nどんどん　逃げてった　からな！"
    },
    {
      "index": 2,
      "id": "msg_main0960_rival_03",
      "hash": "d7ba3267a6082ed0",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]が　強くて　良かったよ"
    },
    {
      "index": 3,
      "id": "msg_main0960_rival_07",
      "hash": "d7ba3667a608359c",
      "flags": 0,
      "text": "オレ　ほんとは\\nちょっと　怖かったんだ\\c\\n悪い　ヤツが\\n一番　強かったら\\r\\nどう　なっちゃうのかな　って……"
    },
    {
      "index": 4,
      "id": "msg_main0960_rival_08",
      "hash": "d7ba3d67a6084181",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]と　一緒に\\nシルフを　助けられて　良かった\\c\\nもう　カラカラ　みたいな\\n目には　だれも　合わないよな"
    },
    {
      "index": 5,
      "id": "msg_main0960_rival_04",
      "hash": "d7ba3967a6083ab5",
      "flags": 0,
      "text": "よし！　平和に　なったし\\nまた　ポケモンジム　巡りだな！\\c\\n[VAR TRNAME(0000)]は\\n[VAR COLOR(0006)]ヤマブキ　ジム[VAR COLOR(0000)]　行ったか？\\r\\nいま　ジムバッジ　いくつ？\\r\\n……へー　そっか"
    },
    {
      "index": 6,
      "id": "msg_main0960_rival_05",
      "hash": "d7ba3867a6083902",
      "flags": 0,
      "text": "オレたち　もしかして\\nポケモンリーグ　いけちゃう　かな？"
    },
    {
      "index": 7,
      "id": "msg_main0960_rival_06",
      "hash": "d7ba3767a608374f",
      "flags": 0,
      "text": "おたがい　頑張ろうぜ！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0960_max",
      "hash": "21d11016938bba32"
    }
  ]
}
