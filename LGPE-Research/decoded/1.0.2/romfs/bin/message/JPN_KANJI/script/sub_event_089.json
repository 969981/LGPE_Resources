  "lines": [
    {
      "index": 0,
      "id": "msg_sub089_jeveniles_no",
      "hash": "a0daaf066ccf7654",
      "flags": 0,
      "text": "うーん……　その\\nてもち　だと　難しいな\\c\\n違う　ポケモン　つれて\\nまた　来てね！"
    },
    {
      "index": 1,
      "id": "msg_sub089_jeveniles_01",
      "hash": "a219e9066dde7cd4",
      "flags": 0,
      "text": "わっ　ポケモン\\n乗っけてるの　かわいーねー！"
    },
    {
      "index": 2,
      "id": "msg_sub089_jeveniles_02",
      "hash": "a219ec066dde81ed",
      "flags": 0,
      "text": "けど　わたしには　重い　かも！\\nだから　いっしょに　歩くの！"
    },
    {
      "index": 3,
      "id": "msg_sub089_poke_01",
      "hash": "c5112ae0eeabb71c",
      "flags": 0,
      "text": "ナゾノクサ『ラリィ！"
    },
    {
      "index": 4,
      "id": "msg_sub089_sys_01",
      "hash": "a5d2d2d2dfdd9d82",
      "flags": 0,
      "text": "[VAR COLOR(0006)]Ｘメニュー[VAR COLOR(0000)]の　てもちポケモン　から\\nポケモンを　えらんで\\c\\n「[VAR COLOR(0006)]ボールからだす[VAR COLOR(0000)]」　と\\nいっしょに　歩くことが　できるよ！"
    },
    {
      "index": 5,
      "id": "msg_sub089_jeveniles_03",
      "hash": "a219eb066dde803a",
      "flags": 0,
      "text": "ぜったい　かわいー　から！\\nやったげるー！"
    },
    {
      "index": 6,
      "id": "msg_sub089_jeveniles_04",
      "hash": "a219e6066dde77bb",
      "flags": 0,
      "text": "ポケモンと　いっしょ　だと\\n歩いてる　だけで　楽しー！\\r\\n……って　もう　知ってるよね！"
    }
  ],
