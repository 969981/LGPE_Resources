{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8100_ice_01",
      "hash": "9bd64f786c7760b5",
      "flags": 0,
      "text": "カンナ『ポケモンリーグへ　ようこそ！"
    },
    {
      "index": 1,
      "id": "msg_main8100_ice_09",
      "hash": "9bd657786c776e4d",
      "flags": 0,
      "text": "あら！　やっと　来たのね\\n遅い　じゃない！"
    },
    {
      "index": 2,
      "id": "msg_main8100_ice_10",
      "hash": "9bd954786c799f0b",
      "flags": 0,
      "text": "……あらためて　名乗るわ\\nわたしが　四天王の　カンナ！"
    },
    {
      "index": 3,
      "id": "msg_main8100_ice_05",
      "hash": "9bd64b786c7759e9",
      "flags": 0,
      "text": "こおり　ポケモン　使わせたら\\n右に　出る　者は　いないわ"
    },
    {
      "index": 4,
      "id": "msg_main8100_ice_06",
      "hash": "9bd648786c7754d0",
      "flags": 0,
      "text": "相手を　こおらせるって\\nとっても　強力よ！"
    },
    {
      "index": 5,
      "id": "msg_main8100_ice_07",
      "hash": "9bd649786c775683",
      "flags": 0,
      "text": "だって　こおっちゃったら\\nあなたの　ポケモン\\r\\n全然　動け　ないんだから"
    },
    {
      "index": 6,
      "id": "msg_main8100_ice_08",
      "hash": "9bd656786c776c9a",
      "flags": 0,
      "text": "……あははッ！\\nじゃ　覚悟は　いいかしら！"
    },
    {
      "index": 7,
      "id": "msg_kanna_01_p02_cave_d1401",
      "hash": "c7b6a229dc0321ce",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "msg_main8100_ice_02",
      "hash": "9bd64c786c775b9c",
      "flags": 0,
      "text": "カンナ『ここまで　強く　なったのね\\nわかった……！\\r\\n次の　部屋に　進むと　いいわ！\\c\\nだけど\\nポケモンリーグ　真の　パワーは\\r\\nまだまだ……！\\r\\nこんな　ものじゃ　ないわよ！"
    },
    {
      "index": 9,
      "id": "msg_main8100_ice_03",
      "hash": "9bd64d786c775d4f",
      "flags": 0,
      "text": "カンナ『ポケモンリーグへ　ようこそ！\\c\\nちょうど　良かったわ\\nあなたと　戦いたいと\\r\\n思って　いた　ところよ！\\c\\nさあ　覚悟は　いいわね！"
    },
    {
      "index": 10,
      "id": "msg_main8100_ice_04",
      "hash": "9bd64a786c775836",
      "flags": 0,
      "text": "カンナ『あなたには　負けた　けど\\nわたしは　こおりポケモンを\\r\\n使う　ことは　やめないわ！\\c\\nあなたも　好きな　ポケモンと\\n勝ち進みなさい！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_8100_max",
      "hash": "c31c6096ed266540"
    }
  ]
}
