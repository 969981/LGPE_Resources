{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8030_grass_01",
      "hash": "1e8b06f7cbd8b52e",
      "flags": 0,
      "text": "はあーい……\\nよい　お天気ね"
    },
    {
      "index": 1,
      "id": "msg_main8030_grass_06",
      "hash": "1e8b09f7cbd8ba47",
      "flags": 0,
      "text": "気持ち　いい……\\n……　すー……　すー"
    },
    {
      "index": 2,
      "id": "msg_main8030_grass_07",
      "hash": "1e8b08f7cbd8b894",
      "flags": 0,
      "text": "……あら　いけない\\n寝て　しまったわ……"
    },
    {
      "index": 3,
      "id": "msg_main8030_grass_08",
      "hash": "1e8afff7cbd8a949",
      "flags": 0,
      "text": "ようこそ\\c\\nわたくし　タマムシジムの\\nエリカと　申します"
    },
    {
      "index": 4,
      "id": "msg_main8030_grass_09",
      "hash": "1e8afef7cbd8a796",
      "flags": 0,
      "text": "お花を　生けるのが　趣味で\\nポケモンは　くさタイプ　ばかり"
    },
    {
      "index": 5,
      "id": "msg_main8030_grass_10",
      "hash": "1e8781f7cbd59d58",
      "flags": 0,
      "text": "……あら　やだ\\n試合の　申し込み　ですの？"
    },
    {
      "index": 6,
      "id": "msg_main8030_grass_11",
      "hash": "1e8782f7cbd59f0b",
      "flags": 0,
      "text": "そんな……\\nわたくし　負けませんわよ"
    },
    {
      "index": 7,
      "id": "msg_gymleader_04_02",
      "hash": "9fa9f03d0017d7d3",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "msg_main8030_grass_02",
      "hash": "1e8b05f7cbd8b37b",
      "flags": 0,
      "text": "この　レインボーバッジ\\n差し上げ　なくては　なりませんね"
    },
    {
      "index": 9,
      "id": "msg_main8030_sys_01",
      "hash": "f9a1db8ce14fe26f",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　エリカ　から\\n[VAR COLOR(0006)]レインボーバッジ[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 10,
      "id": "msg_main8030_grass_03",
      "hash": "1e8b04f7cbd8b1c8",
      "flags": 0,
      "text": "レインボーバッジで\\n親の　違う　ポケモンでも\\r\\nレベル[VAR NUM2(0004)]　までは\\r\\nおとなしく　言うこと　きき　ます\\c\\nそれから……\\nよろしかったら\\r\\nこれも　お使いに　なって！"
    },
    {
      "index": 11,
      "id": "msg_main8030_sys_02",
      "hash": "f9a1dc8ce14fe422",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　エリカから\\n[VAR ITEM2(0001)]\\r\\n「[VAR COLOR(0006)][VAR MOVE(0002)][VAR COLOR(0000)]」を　もらった！"
    },
    {
      "index": 12,
      "id": "msg_main8030_grass_04",
      "hash": "1e8b0bf7cbd8bdad",
      "flags": 0,
      "text": "わざマシン５３の　中は\\nメガドレイン　です\\c\\n与えた　ダメージの　半分が\\nポケモンの　栄養に　なる\\r\\n素晴らしい　わざ　です"
    },
    {
      "index": 13,
      "id": "msg_main8030_grass_05",
      "hash": "1e8b0af7cbd8bbfa",
      "flags": 0,
      "text": "あら　まあ……\\n図鑑を　作って　ますのね\\r\\nほんとに　偉いわ\\c\\nわたくし　でしたら\\n綺麗な　ポケモンしか\\r\\n欲しく　なりません　もの"
    }
  ],
