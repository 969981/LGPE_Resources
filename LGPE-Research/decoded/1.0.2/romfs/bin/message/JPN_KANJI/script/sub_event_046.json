{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub046_adult_M_01",
      "hash": "55b114efac6d35c6",
      "flags": 0,
      "text": "ぼくは　ゲーム　ディレクター\\c\\nこのゲームを　遊んで　もらえて\\nとっても　嬉しいです！\\c\\nポケモン図鑑　がんばってね！\\c\\nもし　全部　集めたら\\n教えてね！"
    },
    {
      "index": 1,
      "id": "msg_sub046_adult_M_02",
      "hash": "55b113efac6d3413",
      "flags": 0,
      "text": "おー！　すごい！\\nついに　ポケモン図鑑が\\r\\n完成　したんだね！\\c\\nいやー　素晴らしい！\\c\\n図鑑完成　おめでとう！\\n表彰　させて　ください！"
    },
    {
      "index": 2,
      "id": "msg_sub046_adult_M_06",
      "hash": "55b117efac6d3adf",
      "flags": 0,
      "text": "お祝いに　ぼくから\\n取っておきの　プレゼントです！"
    },
    {
      "index": 3,
      "id": "msg_sub046_adult_M_07",
      "hash": "55b116efac6d392c",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　ディレクター　から\\n[VAR COLOR(0006)]ひかるおまもり[VAR COLOR(0000)]　を　もらった！"
    },
    {
      "index": 4,
      "id": "msg_sub046_adult_M_03",
      "hash": "55b112efac6d3260",
      "flags": 0,
      "text": "開発の　みんなにも\\n図鑑　見せて　あげてよ！"
    },
    {
      "index": 5,
      "id": "msg_sub046_adult_M_04",
      "hash": "55b119efac6d3e45",
      "flags": 0,
      "text": "ぼくは　ゲーム　ディレクター\\c\\nポケモン図鑑　また\\n見せに　来てくれたの？\\c\\nじゃあ　もう一度\\n表彰　しちゃいましょう！\\r\\n図鑑完成　おめでとう！"
    },
    {
      "index": 6,
      "id": "msg_sub046_adult_M_05",
      "hash": "55b118efac6d3c92",
      "flags": 0,
      "text": "きみが　ポケモンの　世界で\\nたくさん　遊んで　くれて\\r\\nほんとうに　嬉しいです！"
    }
  ],
