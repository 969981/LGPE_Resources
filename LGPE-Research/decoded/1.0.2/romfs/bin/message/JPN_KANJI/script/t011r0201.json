{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t011r0201_youngf_01",
      "hash": "e3dcd10b256e6917",
      "flags": 0,
      "text": "私　クチバジムの\\nマチスさんの　ファンなの\\c\\nえ！？　サイン　もらったって！？\\nうらやまし　すぎる！！！！"
    },
    {
      "index": 1,
      "id": "msg_t011r0201_youngf_02",
      "hash": "e3dcd20b256e6aca",
      "flags": 0,
      "text": "え！？　チャンピオンの\\n[VAR TRNAME(0000)]さん　ですよね！？\\c\\nサ……　サ……\\nサイン　下さい！！！！"
    },
    {
      "index": 2,
      "id": "msg_t011r0201_adultm_01",
      "hash": "5ccc196c33feadc4",
      "flags": 0,
      "text": "四天王の　カンナさん\\nかっこいいよなー！\\c\\nクールな　視線で\\nこおりづけに　されたーい！"
    },
    {
      "index": 3,
      "id": "msg_t011r0201_adultm_02",
      "hash": "5ccc1c6c33feb2dd",
      "flags": 0,
      "text": "おー！　チャンピオン！\\c\\nカンナさんに\\n勝つ　なんて　すごすぎるよ！"
    },
    {
      "index": 4,
      "id": "msg_t011r0201_muscle_01",
      "hash": "711f1d9ed4ccdd88",
      "flags": 0,
      "text": "四天王の　シバ\\nあこがれ　ちゃうよな\\c\\nかくとうセンス　や\\nモリモリ　筋肉に　シビれるぜ"
    },
    {
      "index": 5,
      "id": "msg_t011r0201_muscle_02",
      "hash": "711f209ed4cce2a1",
      "flags": 0,
      "text": "チャンピオン　おめでとう！\\c\\nところで　質問　なんだが\\n四天王　シバの　筋肉\\r\\n間近で　見て　どうだった！？"
    },
    {
      "index": 6,
      "id": "msg_t011r0201_juvenilesf_01",
      "hash": "c8f91758c0d45ca0",
      "flags": 0,
      "text": "トキワジムの　ジムリーダーは\\n正体不明　なんだって\\c\\nあぁ　ミステリアス！\\n気になっちゃう……"
    },
    {
      "index": 7,
      "id": "msg_t011r0201_juvenilesf_02",
      "hash": "c8f91a58c0d461b9",
      "flags": 0,
      "text": "トキワジムの　ジムリーダー\\nロケット団　だったのね……\\c\\nそんな　怖い人　にも\\n勝てちゃう　[VAR TRNAME(0000)]さん！\\r\\nわたし……　ファンに　なっちゃった！"
    },
    {
      "index": 8,
      "id": "test_00",
      "hash": "a806796e1aa98a3e",
      "flags": 0,
      "text": "[~ 8]"
    }
  ],
