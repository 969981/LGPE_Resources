{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_town011_kanban_01",
      "hash": "0a0eef8abea44e5f",
      "flags": 0,
      "text": "ここは　ヤマブキシティ\\nヤマブキ　金色　輝きの色"
    },
    {
      "index": 1,
      "id": "msg_town011_kanban_02",
      "hash": "0a0ef08abea45012",
      "flags": 0,
      "text": "格闘道場！"
    },
    {
      "index": 2,
      "id": "msg_town011_kanban_03",
      "hash": "0a0ef18abea451c5",
      "flags": 0,
      "text": "ヤマブキシティ　ポケモンジム\\nリーダー　ナツメ\\r\\nエスパー少女！"
    },
    {
      "index": 3,
      "id": "msg_town011_kanban_04",
      "hash": "0a0eea8abea445e0",
      "flags": 0,
      "text": "……お得な　掲示板！\\c\\nなんでもなおしは\\nねむり　どく　やけど　こおり……\\r\\nなんでも　治します！\\c\\n少し　高い　けど\\nねむけざまし　どくけし　などを\\r\\nバラバラに　買うより　楽ちん！"
    },
    {
      "index": 4,
      "id": "msg_town011_kanban_05",
      "hash": "0a0eeb8abea44793",
      "flags": 0,
      "text": "……お得な　掲示板！\\c\\n新製品　ハイパーボールは\\nスーパーボール　より　確実に\\r\\nポケモンを　捕まえます！\\c\\nなかなか　捕まえ　られない\\nポケモンには　こちらを　試そう！"
    },
    {
      "index": 5,
      "id": "msg_town011_kanban_06",
      "hash": "0a0eec8abea44946",
      "flags": 0,
      "text": "シルフカンパニー　本社ビル"
    },
    {
      "index": 6,
      "id": "msg_town011_kanban_07",
      "hash": "0a0eed8abea44af9",
      "flags": 0,
      "text": "エスパーおやじの　いえ"
    },
    {
      "index": 7,
      "id": "msg_town011_kanban_08",
      "hash": "0a0ef68abea45a44",
      "flags": 0,
      "text": "シルフ　噂の　新製品！\\n……発売日　未定"
    },
    {
      "index": 8,
      "id": "msg_town011_kanban_09",
      "hash": "0a0ef78abea45bf7",
      "flags": 0,
      "text": "ポケモン　トレーナー　ファンクラブ\\c\\n憧れの　トレーナーへの　愛！\\n語り合い　する　場！"
    },
    {
      "index": 9,
      "id": "msg_town011_rocketm_01_01",
      "hash": "039e151f6358b6f3",
      "flags": 0,
      "text": "なんだァ！\\nてめえ！　あっち　いけ！"
    },
    {
      "index": 10,
      "id": "msg_town011_rocketm_02_01",
      "hash": "d9201d2aacc1743c",
      "flags": 0,
      "text": "ボスは　この　街を\\nロケット団の　ものに　するってよォ"
    },
    {
      "index": 11,
      "id": "msg_town011_rocketf_01_01",
      "hash": "d42d24afcbfd6b32",
      "flags": 0,
      "text": "こらァ　あたしらに　逆らうと\\n痛い目に　あうよ！"
    },
    {
      "index": 12,
      "id": "msg_town011_rocketm_03_01",
      "hash": "06da29310f9d21d1",
      "flags": 0,
      "text": "ヤマブキシティ　ごと\\nロケット団が　乗っ取ったぜ！"
    },
    {
      "index": 13,
      "id": "msg_town011_rocketm_04_01",
      "hash": "518260f9587baac2",
      "flags": 0,
      "text": "悪い　こと　やりまくると\\nスカッと　するぜ！"
    },
    {
      "index": 14,
      "id": "msg_town011_rocketm_05_01",
      "hash": "a92e2d00f4fa3137",
      "flags": 0,
      "text": "いてッ！　この　やろ！\\nどこ　見て　歩いてんだよ！"
    },
    {
      "index": 15,
      "id": "msg_town011_rocketf_02_01",
      "hash": "81b2e4cb86f1eec5",
      "flags": 0,
      "text": "シルフカンパニー　乗っ取ったら\\n世界中に　ポケモン　売って\\r\\nガバガバ　大儲けよ！"
    },
    {
      "index": 16,
      "id": "msg_town011_scientist_01_01",
      "hash": "972d71bb496a81fe",
      "flags": 0,
      "text": "ロケット団　やっつけたの\\n子供達　だって……　すごいな"
    },
    {
      "index": 17,
      "id": "msg_town011_staffm_01_01",
      "hash": "9e5b059e9d5ddf7d",
      "flags": 0,
      "text": "ばんざーい！\\nロケット団が　いなくなった！\\r\\nビビらないで　外　歩けるんだ！"
    },
    {
      "index": 18,
      "id": "msg_town011_stafff_01_01",
      "hash": "9e694c86e17b9ba0",
      "flags": 0,
      "text": "ヤマブキシティも　一時は\\n人が　逃げて　減っちゃった　けど\\r\\n賑やかな　街に　戻るわ！"
    },
    {
      "index": 19,
      "id": "msg_town011_gentleman_01_01",
      "hash": "48154c76ccb533db",
      "flags": 0,
      "text": "ロケット団が　シルフ　襲って\\n大事件って　聞いて！\\r\\nピジョットで　飛んで　来たッス\\c\\n解決　した……？\\nすんません！\\r\\n根っからの　ヤジウマ　で！"
    },
    {
      "index": 20,
      "id": "msg_town011_poke_01_01",
      "hash": "445e4eb43713ff89",
      "flags": 0,
      "text": "ピジョット『ビビーッ！"
    },
    {
      "index": 21,
      "id": "msg_town011_skinhead_01_01",
      "hash": "d58f4c202158a283",
      "flags": 0,
      "text": "おれ　見たぜ！　シルフの　ビル　から\\nロケットの　ボスが　逃げて　いくの！"
    },
    {
      "index": 22,
      "id": "msg_town011_rocketm_06_01",
      "hash": "d535150756640d20",
      "flags": 0,
      "text": "わたしは　警備員だが\\n怪しい　子供は\\c\\n通せんぼ　することに　してるのだ"
    },
    {
      "index": 23,
      "id": "msg_town011_rocketm_06_02",
      "hash": "d535180756641239",
      "flags": 0,
      "text": "……　……　……\\n……こっくり　こっくり\\c\\nしめしめ！　居眠り　しているぞ"
    },
    {
      "index": 24,
      "id": "msg_town011_engineer_01",
      "hash": "c47580ca1d31dd4d",
      "flags": 0,
      "text": "ヤマブキは　電力の　消費量も\\nケタちがい　だねぇ！\\r\\nしっかり　メンテ　しないとねぇ！"
    },
    {
      "index": 25,
      "id": "msg_town011_youngf_01",
      "hash": "4f1171bad02d37c8",
      "flags": 0,
      "text": "大きく　なったら\\n憧れの　シルフカンパニーで\\r\\n働きたいなー！"
    },
    {
      "index": 26,
      "id": "msg_town011_elitem_01",
      "hash": "2d90dc28103cfaa0",
      "flags": 0,
      "text": "きみ　どこから？\\c\\n……へえ　マサラタウンかあ\\nのどかで　いいよね！"
    },
    {
      "index": 27,
      "id": "msg_town011_scientist_01",
      "hash": "cfe4e50cdbb0e32c",
      "flags": 0,
      "text": "はがねタイプの　ジムは　ないけど\\n好きです！　はがねタイプ！\\r\\nフェアリーにも　強いヨ！"
    },
    {
      "index": 28,
      "id": "msg_town011_poke_02",
      "hash": "dbdd9d3d5601e584",
      "flags": 0,
      "text": "コイル『キイィン！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_town011_max",
      "hash": "45f17187568e21ca"
    }
  ]
}
