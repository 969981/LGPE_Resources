{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_forest001_bugcatcher_01",
      "hash": "42b8c530b5989886",
      "flags": 0,
      "text": "友達と　虫ポケモン\\n捕りに　来てるんだ！\\c\\nポケモン　勝負　したくて\\nみんな　ウズウズ　してるよ！"
    },
    {
      "index": 1,
      "id": "msg_forest001_shortpants_01",
      "hash": "896a584b4d86cbe4",
      "flags": 0,
      "text": "ポケモン　捕ろうとして\\nモンスターボール　投げてたら\\r\\nすぐ　なくなっちゃった\\c\\nきみも　多めに\\n買って　おくと　いいよ"
    },
    {
      "index": 2,
      "id": "msg_forest001_kanban_01",
      "hash": "a573a2375b89557d",
      "flags": 0,
      "text": "……お得な　掲示板！\\c\\n取り外した　Joy-Conを　振れば\\n相棒　ポケモンと　遊べる！"
    },
    {
      "index": 3,
      "id": "msg_forest001_kanban_02",
      "hash": "a5739f375b895064",
      "flags": 0,
      "text": "どくを　くらったら　どくけし！\\nまひに　されたら　まひなおし！\\c\\nフレンドリィショップで！"
    },
    {
      "index": 4,
      "id": "msg_forest001_kanban_03",
      "hash": "a573a0375b895217",
      "flags": 0,
      "text": "……お得な　掲示板！\\c\\nポケモン図鑑は　研究所で\\nオーキド博士に　見てもらえる！"
    },
    {
      "index": 5,
      "id": "msg_forest001_kanban_04",
      "hash": "a5739d375b894cfe",
      "flags": 0,
      "text": "……お得な　掲示板！\\c\\nポケモンを　つかまえると\\nてもちの　ポケモンは\\r\\n経験値を　もらえます！\\c\\n大きい　ポケモンを　つかまえれば\\n経験値も　たくさん！\\c\\n……小さくても　たくさん！"
    },
    {
      "index": 6,
      "id": "msg_forest001_kanban_05",
      "hash": "a5739e375b894eb1",
      "flags": 0,
      "text": "……お得な　掲示板！\\c\\nポケモンの　つかまえかたは\\nコントローラーに　よって　違う！\\c\\nコントローラーを　変えたら\\nポケモンを　つかまえる　画面で\\r\\nヘルプを　見てみよう！"
    },
    {
      "index": 7,
      "id": "msg_forest001_kanban_06",
      "hash": "a5739b375b894998",
      "flags": 0,
      "text": "トキワの森　……　出口\\nこの先　ニビシティ"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_forest001_max",
      "hash": "ef0de44a4bec1284"
    }
  ]
}
