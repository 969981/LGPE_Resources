{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0900_stafff_01",
      "hash": "eaf7003cf3e9b4e4",
      "flags": 0,
      "text": "受付『キミ！"
    },
    {
      "index": 1,
      "id": "msg_main0900_stafff_04",
      "hash": "eaf6fd3cf3e9afcb",
      "flags": 0,
      "text": "いま　この　会社は\\nちょっと　大変なの\\c\\n……危ない　から\\n子供は　入っちゃ　ダメよ！"
    },
    {
      "index": 2,
      "id": "msg_main0900_green_01",
      "hash": "26e576e0f08c51d1",
      "flags": 0,
      "text": "グリーン『そう　言わずに\\n見学　させて　くれませんか？"
    },
    {
      "index": 3,
      "id": "msg_main0900_stafff_02",
      "hash": "eaf7033cf3e9b9fd",
      "flags": 0,
      "text": "受付『あら　グリーンくん！"
    },
    {
      "index": 4,
      "id": "msg_main0900_rival_01",
      "hash": "4c13e9c3c6b311d4",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『[VAR TRNAME(0000)]！\\n探したん　だぞ！"
    },
    {
      "index": 5,
      "id": "msg_main0900_rival_07",
      "hash": "4c13e7c3c6b30e6e",
      "flags": 0,
      "text": "なんで　この　ビルに？"
    },
    {
      "index": 6,
      "id": "msg_main0900_select_01",
      "hash": "994bb0148a000904",
      "flags": 0,
      "text": "ロケット団が……"
    },
    {
      "index": 7,
      "id": "msg_main0900_select_02",
      "hash": "994bb3148a000e1d",
      "flags": 0,
      "text": "乗っ取り　だって……"
    },
    {
      "index": 8,
      "id": "msg_main0900_rival_02",
      "hash": "4c13ecc3c6b316ed",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『やっぱり！\\nロケット団の　やつら\\r\\nあちこちで　悪さ　してるんだ"
    },
    {
      "index": 9,
      "id": "msg_main0900_green_02",
      "hash": "26e573e0f08c4cb8",
      "flags": 0,
      "text": "グリーン『[VAR TRNAME(0001)]の\\n言うとおり　だな！\\c\\nもう　これ以上\\nロケット団の　すること\\r\\nほって　おけねー！"
    },
    {
      "index": 10,
      "id": "msg_main0900_select_03",
      "hash": "994bb2148a000c6a",
      "flags": 0,
      "text": "自分も　です！"
    },
    {
      "index": 11,
      "id": "msg_main0900_select_04",
      "hash": "994bad148a0003eb",
      "flags": 0,
      "text": "どうすれば？"
    },
    {
      "index": 12,
      "id": "msg_main0900_green_03",
      "hash": "26e574e0f08c4e6b",
      "flags": 0,
      "text": "グリーン『よし\\nさっそく　作戦会議だ！"
    },
    {
      "index": 13,
      "id": "msg_main0900_green_04",
      "hash": "26e579e0f08c56ea",
      "flags": 0,
      "text": "グリーン『おれたちに\\n出来る　ことを　するんだ！"
    },
    {
      "index": 14,
      "id": "msg_main0900_green_05",
      "hash": "26e57ae0f08c589d",
      "flags": 0,
      "text": "……て　ことで\\c\\n[VAR TRNAME(0000)]は　予定どおり\\nシルフカンパニーに　いる\\r\\nロケット団を　追い払う\\c\\nひとりは　危ねー　から\\n[VAR TRNAME(0001)]も　一緒な！"
    },
    {
      "index": 15,
      "id": "msg_main0900_rival_03",
      "hash": "4c13ebc3c6b3153a",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『はい！"
    },
    {
      "index": 16,
      "id": "msg_main0900_green_06",
      "hash": "26e577e0f08c5384",
      "flags": 0,
      "text": "グリーン『おれは\\nカントー　じゅうを　まわる！\\c\\nロケット団の　やつらを\\n片っ端　から　つぶして\\r\\nなんとか　ボスの　居場所を\\r\\n探ってみる"
    },
    {
      "index": 17,
      "id": "msg_main0900_green_11",
      "hash": "26e8fae0f08f67f4",
      "flags": 0,
      "text": "それから　ポケモンリーグ　にも\\n行って　事件を　知らせる"
    },
    {
      "index": 18,
      "id": "msg_main0900_rival_04",
      "hash": "4c13e6c3c6b30cbb",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『すげー！\\nもしかして　四天王が\\r\\n味方に　なって　くれるかも……！？"
    },
    {
      "index": 19,
      "id": "msg_main0900_green_07",
      "hash": "26e578e0f08c5537",
      "flags": 0,
      "text": "グリーン『それじゃ　二手に\\n分かれて　作戦開始だ！"
    },
    {
      "index": 20,
      "id": "msg_main0900_green_08",
      "hash": "26e56de0f08c4286",
      "flags": 0,
      "text": "……と　言いたい　けど\\nその前に"
    },
    {
      "index": 21,
      "id": "msg_main0900_green_12",
      "hash": "26e8fde0f08f6d0d",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]　[VAR TRNAME(0001)]！\\c\\n２人が　どれくらい　強いか\\nおれは　知らない\\c\\n安心して　任せて　いーのか\\n実力を　見せて　もらうぜ！"
    },
    {
      "index": 22,
      "id": "msg_main0900_rival_05",
      "hash": "4c13e5c3c6b30b08",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『えッ！"
    },
    {
      "index": 23,
      "id": "msg_main0900_green_09",
      "hash": "26e56ee0f08c4439",
      "flags": 0,
      "text": "グリーン『どっち　からでも　いいぜ\\nかかって　来いよ！"
    },
    {
      "index": 24,
      "id": "msg_main0900_green_10",
      "hash": "26e8fbe0f08f69a7",
      "flags": 0,
      "text": "グリーン『おい　おい！\\nおれは　ここ　だぜ？"
    },
    {
      "index": 25,
      "id": "msg_main0900_stafff_03",
      "hash": "eaf7023cf3e9b84a",
      "flags": 0,
      "text": "受付『シルフカンパニーを\\n助けに　来てくれたの？\\c\\nグリーンくんの　知り合い　なら\\n頼りに　できそう！"
    },
    {
      "index": 26,
      "id": "msg_main0900_rival_06",
      "hash": "4c13e8c3c6b31021",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『もし　勝てたら\\nガラガラの　かたきを　討つ\\r\\n自信が　もてるかも……！\\c\\n[VAR TRNAME(0000)]　先に　いくか？"
    }
  ],
