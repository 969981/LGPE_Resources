{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "fe_amai_msg00",
      "hash": "7a6591e7fa5270a7",
      "flags": 0,
      "text": "ここには\\n何も　いないようだ……"
    },
    {
      "index": 1,
      "id": "msg_kagu1_bg",
      "hash": "cdf3b18078b3f908",
      "flags": 0,
      "text": "色んな　食器が\\n綺麗に　並んでいる！"
    },
    {
      "index": 2,
      "id": "msg_kagu2_bg",
      "hash": "a0b3a17a163fa0e3",
      "flags": 0,
      "text": "いい　匂いがする！　何か\\n料理を　作ったあと　みたい！"
    },
    {
      "index": 3,
      "id": "msg_kagu3_bg",
      "hash": "c9eb816ecbc1f832",
      "flags": 0,
      "text": "綺麗な　タンスだ！\\n色んな　ものが　入りそう！"
    },
    {
      "index": 4,
      "id": "msg_kagu4_bg",
      "hash": "730c41672ff1c605",
      "flags": 0,
      "text": "色々な　食べ物　が\\nお供え　してある"
    },
    {
      "index": 5,
      "id": "msg_kagu5_bg",
      "hash": "49245160d0548fe4",
      "flags": 0,
      "text": "綺麗な　ポケモンの　絵だ！\\nなんだか　気持ち　よさそう！"
    },
    {
      "index": 6,
      "id": "msg_kagu6_bg",
      "hash": "9b158156be707c7f",
      "flags": 0,
      "text": "何の　機械　だろう！？\\n触るのは　やめて　おこう！"
    },
    {
      "index": 7,
      "id": "msg_kagu7_bg",
      "hash": "712e91505ed4f95e",
      "flags": 0,
      "text": "電話だ！\\nかけるのは　やめておこう！"
    },
    {
      "index": 8,
      "id": "msg_kagu8_bg",
      "hash": "03f0b1cd88a71721",
      "flags": 0,
      "text": "色んな　商品　の\\n宣伝が　書かれている！"
    },
    {
      "index": 9,
      "id": "msg_kagu9_bg",
      "hash": "2d2881c23e295340",
      "flags": 0,
      "text": "いい匂い！\\nお腹が　鳴りそう！"
    },
    {
      "index": 10,
      "id": "msg_kagu10_bg",
      "hash": "2900f7fa1e970ca4",
      "flags": 0,
      "text": "中には\\n……\\c\\n何も　はいってない！"
    },
    {
      "index": 11,
      "id": "msg_kagu11_bg",
      "hash": "ffc8e805691463c5",
      "flags": 0,
      "text": "ポケモンの　マークが\\nはいった　コップだ！"
    },
    {
      "index": 12,
      "id": "msg_kagu12_bg",
      "hash": "510b37e9ad17761e",
      "flags": 0,
      "text": "とても　綺麗に\\nみがかれた　窓　だ！"
    },
    {
      "index": 13,
      "id": "msg_kagu13_bg",
      "hash": "27d327f4f794cd3f",
      "flags": 0,
      "text": "窓の\\n向こうには……\\c\\nとても綺麗な　空が　見える！"
    },
    {
      "index": 14,
      "id": "msg_kagu14_bg",
      "hash": "574a581eaef36dc8",
      "flags": 0,
      "text": "色んな　色の　ランプが\\nチカチカ　光っている！"
    },
    {
      "index": 15,
      "id": "msg_kagu15_bg",
      "hash": "59600823d6bb57e9",
      "flags": 0,
      "text": "色んな　道具が\\n並んでいる！"
    },
    {
      "index": 16,
      "id": "msg_bouenkyou_01_p01_r011_r0102",
      "hash": "11249d7b557c7c93",
      "flags": 0,
      "text": "望遠鏡を　覗いた！\\c\\n道路に　ポケモンが　寝てる！"
    },
    {
      "index": 17,
      "id": "msg_bouenkyou_01_p02_r011_r0102",
      "hash": "d0e85fd19bb0169c",
      "flags": 0,
      "text": "望遠鏡を　覗いた！\\c\\n素晴らしい　景色だ！"
    },
    {
      "index": 18,
      "id": "msg_bouenkyou_02_p01_r011_r0102",
      "hash": "33193af75a560fb0",
      "flags": 0,
      "text": "望遠鏡を　覗いた！\\c\\nシオンタウンに　行く　には……\\nハナダシティ　から\\r\\nイワヤマを　抜ければ　よさそう……"
    },
    {
      "index": 19,
      "id": "msg_bouenkyou_01_p01_r012_r0102",
      "hash": "2a2fd25bba926a22",
      "flags": 0,
      "text": "望遠鏡を　覗いた！\\c\\n釣りを　してる　おじさんだ！"
    },
    {
      "index": 20,
      "id": "msg_bouenkyou_02_p01_r012_r0102",
      "hash": "1447c575cf496bf5",
      "flags": 0,
      "text": "望遠鏡を　覗いた！\\c\\nポケモンタワーが　見える！"
    },
    {
      "index": 21,
      "id": "msg_bouenkyou_01_p01_r015_r0102",
      "hash": "d7f7e45d55f7429f",
      "flags": 0,
      "text": "望遠鏡を　覗いた……\\c\\n大きな　鳥が\\nキラキラ　光りながら\\r\\n海の　ほうへ　飛んでいく……"
    },
    {
      "index": 22,
      "id": "msg_bouenkyou_02_p01_r015_r0102",
      "hash": "98836cfee336ff7c",
      "flags": 0,
      "text": "望遠鏡を　覗いた！\\c\\n海の　向こうに……\\n小さな　島が　見える！"
    },
    {
      "index": 23,
      "id": "msg_bouenkyou_01_p01_r016_r0202",
      "hash": "cea1afb32e7dc323",
      "flags": 0,
      "text": "望遠鏡を　覗いた！\\c\\nタマムシデパートが　見える！"
    },
    {
      "index": 24,
      "id": "msg_bouenkyou_02_p01_r016_r0202",
      "hash": "e85828a3f4702cc0",
      "flags": 0,
      "text": "望遠鏡を　覗いた！\\c\\n向こうに　海の　上を　通る\\n長ーい　道が　見える！"
    },
    {
      "index": 25,
      "id": "msg_bouenkyou_01_p01_r018_r0102",
      "hash": "f4dd8c32d544ae70",
      "flags": 0,
      "text": "望遠鏡を　覗いた！\\c\\n西に　マサラタウンが　見える"
    },
    {
      "index": 26,
      "id": "msg_bouenkyou_02_p01_r018_r0102",
      "hash": "4f604c3fda8dddd3",
      "flags": 0,
      "text": "望遠鏡を　覗いた！\\c\\n泳いでる　人が　見える！"
    },
    {
      "index": 27,
      "id": "msg_sylph_door_01",
      "hash": "c36b343ea1a7c0f8",
      "flags": 0,
      "text": "……ピンポーン！\\nカードキーで　ロック　を外した！"
    },
    {
      "index": 28,
      "id": "msg_sylph_door_02",
      "hash": "c36b373ea1a7c611",
      "flags": 0,
      "text": "……だめだ！\\nカードキーが　ないと　開かない！"
    },
    {
      "index": 29,
      "id": "msg_book_01_bg",
      "hash": "7bb6486bae7c5172",
      "flags": 0,
      "text": "ポケモンの　本が　いっぱい！"
    },
    {
      "index": 30,
      "id": "msg_townmap_01_bg",
      "hash": "0de10cb9a0a3d80b",
      "flags": 0,
      "text": "タウンマップだ！"
    },
    {
      "index": 31,
      "id": "msg_fsrack_01_bg",
      "hash": "6c92a1bfb5eb3e83",
      "flags": 0,
      "text": "わあ！　ポケモングッズが\\nたくさん　そろってる！"
    },
    {
      "index": 32,
      "id": "msg_fs_01_bg",
      "hash": "1df07aa8257f8e68",
      "flags": 0,
      "text": "ポケモン　グッズが　いっぱい！\\nフレンドリィショップ"
    },
    {
      "index": 33,
      "id": "msg_pc_01_bg",
      "hash": "dfee76fbce4be542",
      "flags": 0,
      "text": "ポケモンの　体力　回復！\\nポケモンセンター"
    },
    {
      "index": 34,
      "id": "msg_freeze_01_bg",
      "hash": "8e164c7fbea26a00",
      "flags": 0,
      "text": "おいしそうな　食べ物が\\nいっぱい　入ってそう！"
    },
    {
      "index": 35,
      "id": "msg_sekkeizu_01_bg",
      "hash": "fa393e9b9200f706",
      "flags": 0,
      "text": "何かの　設計図　だ！\\n色んな　文字や　絵が　描いてある"
    },
    {
      "index": 36,
      "id": "msg_pc_02_bg",
      "hash": "37629715141fdcf9",
      "flags": 0,
      "text": "難しそうな　文字や　数字\\nばかりで　ちんぷんかんぷん！？"
    },
    {
      "index": 37,
      "id": "msg_masaki_01_bg",
      "hash": "93d2d7a15f3e81dd",
      "flags": 0,
      "text": "なんだか\\nすごそうな　機械だ！"
    },
    {
      "index": 38,
      "id": "msg_game_01_bg",
      "hash": "5cb767c46e41f135",
      "flags": 0,
      "text": "最新の　ゲームだ！\\nなんだか　おもしろそう！"
    },
    {
      "index": 39,
      "id": "msg_dorobou_01_bg",
      "hash": "a07f7a27a1a4b8e9",
      "flags": 0,
      "text": "どろぼうに　荒らされた　跡が\\n残っている……"
    },
    {
      "index": 40,
      "id": "msg_tv_01_bg",
      "hash": "bb6a7c7d0b1fc1b5",
      "flags": 0,
      "text": "テレビに　ポケモンが\\n映っている！\\r\\nなんだか　楽しそう！"
    },
    {
      "index": 41,
      "id": "msg_tv_02_bg",
      "hash": "8ca18c64fdd8eb8e",
      "flags": 0,
      "text": "テレビの　モニターには\\n自分の　顔が　うつっている！"
    },
    {
      "index": 42,
      "id": "msg_t007r0805_elevator_01",
      "hash": "6b7cd65aaddff314",
      "flags": 0,
      "text": "動かすには\\nカギが　必要　みたい"
    },
    {
      "index": 43,
      "id": "msg_main_event_1100_switch_01",
      "hash": "ccd6e3039bca99fd",
      "flags": 0,
      "text": "秘密の　スイッチを　押した！\\n……ポチっとな"
    },
    {
      "index": 44,
      "id": "msg_main_event_1100_switch_04",
      "hash": "ccd6de039bca917e",
      "flags": 0,
      "text": "……どこかで　何か\\n動く　音が　した！"
    },
    {
      "index": 45,
      "id": "msg_main_event_1100_switch_02",
      "hash": "ccd6e0039bca94e4",
      "flags": 0,
      "text": "[~ 45]"
    },
    {
      "index": 46,
      "id": "msg_main_event_1100_switch_03",
      "hash": "ccd6e1039bca9697",
      "flags": 0,
      "text": "[~ 46]"
    },
    {
      "index": 47,
      "id": "msg_shop_bg_01",
      "hash": "3682ef731ccc848b",
      "flags": 0,
      "text": "キズぐすりや\\nむしよけスプレーが　並んでる！"
    },
    {
      "index": 48,
      "id": "msg_shop_bg_02",
      "hash": "3682f0731ccc863e",
      "flags": 0,
      "text": "たくさん　商品が　並んでる！\\n店員さんに　話して　買おう！"
    },
    {
      "index": 49,
      "id": "msg_kanban_bg_01",
      "hash": "ff617b40a90b04f0",
      "flags": 0,
      "text": "裏側　から\\n看板は　読めないぞ！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_bg_event_max",
      "hash": "f825892cbb5f8bbe"
    }
  ]
}
