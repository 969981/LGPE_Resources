{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main_0450_water_01",
      "hash": "7439386f7b29a278",
      "flags": 0,
      "text": "カスミ『あら　きみ！"
    },
    {
      "index": 1,
      "id": "msg_main_0450_water_02",
      "hash": "74393b6f7b29a791",
      "flags": 0,
      "text": "へー！　マチスさんに\\n勝っちゃう　なんて　すごいね！\\c\\n順調　順調！\\nはーい　おつかれ！"
    },
    {
      "index": 2,
      "id": "msg_main_0450_sys_01",
      "hash": "b2b280679438be5e",
      "flags": 0,
      "text": "カスミが　ポケモンを\\n元気に　してくれた！"
    },
    {
      "index": 3,
      "id": "msg_main_0450_sys_02",
      "hash": "b2b27f679438bcab",
      "flags": 0,
      "text": "カスミが　ポケモンたちを\\n元気に　してくれた！"
    },
    {
      "index": 4,
      "id": "msg_main_0450_water_03",
      "hash": "74393a6f7b29a5de",
      "flags": 0,
      "text": "カスミ『……え　わたし？\\n海水浴よ\\c\\n狭い　プールから　飛びだして\\nひろーい　海で\\r\\n泳ぎたい　ときも　あるの！"
    },
    {
      "index": 5,
      "id": "msg_main_0450_water_04",
      "hash": "74393d6f7b29aaf7",
      "flags": 0,
      "text": "カスミ『これから　どこ　いくの？\\c\\nこの　近くの\\nディグダのあな　って　行った？\\c\\nまだ　だったら\\n連れてって　あげようか？"
    },
    {
      "index": 6,
      "id": "msg_main_0450_water_05",
      "hash": "74393c6f7b29a944",
      "flags": 0,
      "text": "あら　せっかくの\\n誘いを　断る　なんて"
    },
    {
      "index": 7,
      "id": "msg_main_0450_water_06",
      "hash": "74393f6f7b29ae5d",
      "flags": 0,
      "text": "いいわよ　行きましょ！"
    },
    {
      "index": 8,
      "id": "msg_main_0450_water_07",
      "hash": "74393e6f7b29acaa",
      "flags": 0,
      "text": "カスミ『ここが\\nディグダのあな　よ！\\c\\nディグダが　掘り進んで\\nできた　穴なの！\\c\\nじゃあね！\\n色んな　ポケモンと　出会ってね"
    },
    {
      "index": 9,
      "id": "msg_main_0450_water_08",
      "hash": "7439316f7b299693",
      "flags": 0,
      "text": "[~ 9]"
    }
  ],
  "unpaired_labels": [
