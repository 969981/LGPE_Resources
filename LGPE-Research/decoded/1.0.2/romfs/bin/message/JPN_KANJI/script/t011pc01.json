{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t011pc01_woman_01",
      "hash": "52c0f0cdc20ee38c",
      "flags": 0,
      "text": "ポケモンは　種類に　よって\\n成長する　テンポが\\r\\n違う　らしいわ"
    },
    {
      "index": 1,
      "id": "msg_t011pc01_gentleman_01",
      "hash": "a8510610e35a4373",
      "flags": 0,
      "text": "誰もが　みんな　知ってる\\nシルフカンパニー　だが\\c\\n有名　だと　それだけ\\n狙われる　危険も　あるのだ"
    },
    {
      "index": 2,
      "id": "msg_t011pc01_chilem_01_01",
      "hash": "ea1d64be063f2a88",
      "flags": 0,
      "text": "あーあ……\\nポケモン四天王が　来て\\r\\nロケット団を　やっつけて\\r\\nくれると　いいな"
    },
    {
      "index": 3,
      "id": "msg_t011pc01_chilem_01_02",
      "hash": "ea1d67be063f2fa1",
      "flags": 0,
      "text": "ロケット団　逃げてったね！\\nこれからは　外　歩いても\\r\\nちっとも　怖くない！\\r\\nよかったね！"
    },
    {
      "index": 4,
      "id": "msg_t011pc01_book_01",
      "hash": "18e82d1f9496b7c1",
      "flags": 0,
      "text": "『ポケモンジャーナル　インタビュー』\\nと　かかれた　本が　ある……"
    },
    {
      "index": 5,
      "id": "msg_t011pc01_select_01",
      "hash": "a278475c44657e9a",
      "flags": 0,
      "text": "読みますか？"
    },
    {
      "index": 6,
      "id": "msg_t011pc01_book_02",
      "hash": "18e82a1f9496b2a8",
      "flags": 0,
      "text": "ヤマブキシティの　顔！\\nからてだいおう　に　密着！\\r\\nズバリ　強さの　秘訣は？\\c\\n『オスッ！　格闘道場を\\n設立してから　と　いうもの\\c\\n毎日　欠かさず\\nポケモンと　筋肉トレーニング！\\c\\n見よ！　鍛え　抜かれた\\nこの　肉体！　この　ポケモン！\\c\\n来月　ヤマブキジムの\\n統一試合が　開かれる　が\\c\\nどんな　奴らが　相手でも\\nわしの　拳で　ひとひねり　よ！』"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t011pc01_max",
      "hash": "83c0174e9945a1be"
    }
  ]
}
