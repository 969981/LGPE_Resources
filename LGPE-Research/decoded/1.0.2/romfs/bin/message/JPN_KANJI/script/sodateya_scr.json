    },
    {
      "index": 67,
      "id": "msg_sodateya_girl_16",
      "hash": "59d4c7704e5ea094",
      "flags": 0,
      "text": "[~ 67]"
    },
    {
      "index": 68,
      "id": "msg_sodateya_girl_17",
      "hash": "59d4c8704e5ea247",
      "flags": 0,
      "text": "[~ 68]"
    },
    {
      "index": 69,
      "id": "msg_sodateya_girl_18",
      "hash": "59d4bd704e5e8f96",
      "flags": 0,
      "text": "[~ 69]"
    },
    {
      "index": 70,
      "id": "msg_sodateya001",
      "hash": "81b5057d801b3fa2",
      "flags": 0,
      "text": "わたしは　育て屋さん\\nさて　どうするかね？"
    },
    {
      "index": 71,
      "id": "msg_sodateya002",
      "hash": "81b5047d801b3def",
      "flags": 0,
      "text": "わたしは　育て屋さん\\c\\nみんなの　ポケモンを　預かって\\n育てているよ\\c\\nさて　どうするかね？"
    },
    {
      "index": 72,
      "id": "msg_sodateya003",
      "hash": "81b5037d801b3c3c",
      "flags": 0,
      "text": "そうかい\\nまた　来なさいよ"
    },
    {
      "index": 73,
      "id": "msg_sodateya004",
      "hash": "81b5027d801b3a89",
      "flags": 0,
      "text": "その　ポケモンを　預けて\\nしまうと　戦えなく　なるぞい！\\c\\nもっと　ポケモンを　捕まえて\\n仲間を　増やしてから　いらっしゃい"
    },
    {
      "index": 74,
      "id": "msg_sodateya005",
      "hash": "81b5017d801b38d6",
      "flags": 0,
      "text": "てもちと　ポケモンボックスに\\n３匹　いないと　預けられんぞい\\c\\nもっと　ポケモンを　捕まえて\\n仲間を　増やしてから　いらっしゃい"
    },
    {
      "index": 75,
      "id": "msg_sodateya006",
      "hash": "81b5007d801b3723",
      "flags": 0,
      "text": "育てたい　ポケモンを\\n選んで　おくれ"
    },
    {
      "index": 76,
      "id": "msg_sodateya007",
      "hash": "81b4ff7d801b3570",
      "flags": 0,
      "text": "その子は　お前さんの　そばを\\n離れたく　ないようだね\\r\\nきずなを　感じて　ほほえましいのぉ"
    },
    {
      "index": 77,
      "id": "msg_sodateya008",
      "hash": "81b50e7d801b4eed",
      "flags": 0,
      "text": "では　[VAR PKNICK(0000)]を\\nしばらく　預かるぞい"
    },
    {
      "index": 78,
      "id": "msg_sodateya009",
      "hash": "81b50d7d801b4d3a",
      "flags": 0,
      "text": "適当に　時間が　たったら\\nまた　おいで"
    },
    {
      "index": 79,
      "id": "msg_sodateya010",
      "hash": "81b1807d801827cc",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]は　レベルで　いうと\\n[VAR NUM2(0001)]くらい　育って　おるぞい"
    },
    {
      "index": 80,
      "id": "msg_sodateya011",
      "hash": "81b1817d8018297f",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]を　引き取る　なら\\n[VAR NUM5(0001,0000)]円　だよ"
    },
    {
      "index": 81,
      "id": "msg_sodateya012",
      "hash": "81b1827d80182b32",
      "flags": 0,
      "text": "おや　お金が　足りない\\nみたいだね"
    },
    {
      "index": 82,
      "id": "msg_sodateya013",
      "hash": "81b1837d80182ce5",
      "flags": 0,
      "text": "おや？　てもちも　ポケモンボックスも\\nいっぱいの　ようだね\\c\\nポケモンを　整理　してから\\nまた　いらっしゃい"
    },
    {
      "index": 83,
      "id": "msg_sodateya014",
      "hash": "81b17c7d80182100",
      "flags": 0,
      "text": "そういえば　お前さんの　ポケモン\\nこんなものを　拾って　いたぞい"
    },
    {
      "index": 84,
      "id": "msg_sodateya015",
      "hash": "81b17d7d801822b3",
      "flags": 0,
      "text": "ポケモンを　育てたくなったら\\nいつでも　おいで"
    },
    {
      "index": 85,
      "id": "msg_sodateya016",
      "hash": "81b17e7d80182466",
      "flags": 0,
      "text": "その　ポケモンを　預けて\\nしまうと　戦えなく　なるぞい！"
    },
    {
      "index": 86,
      "id": "msg_tokkun001",
      "hash": "264f9dc66325087e",
      "flags": 0,
      "text": "わしは　すごいとっくん　ジジイ\\c\\n……もし　きみが　チャンピオンに\\nなったら　また　来るが　よい"
    },
    {
      "index": 87,
      "id": "msg_tokkun002",
      "hash": "264f9cc6632506cb",
      "flags": 0,
      "text": "ほほーッ！　なるほど！\\nチャンピオンに　なった　か！\\c\\nわしは　すごいとっくん　ジジイ！\\nレベルが　１００の　ポケモンに\\r\\nすごいとっくんを　して　やれるぞ！\\c\\nぎんのおうかん　を　くれれば\\nひとつの　能力を！\\c\\nきんのおうかん　なら\\nぜんぶの　能力を\\r\\n最高に　鍛えて　あげるぞい！"
    },
    {
      "index": 88,
      "id": "msg_tokkun003",
      "hash": "264f9bc663250518",
      "flags": 0,
      "text": "わしは　すごいとっくん　ジジイ\\nとっくん　するかい？"
    },
    {
      "index": 89,
      "id": "msg_tokkun004",
      "hash": "264fa2c6632510fd",
      "flags": 0,
      "text": "とっくんを　受けたければ\\nおうかんを　持ってきてくれい！"
    },
    {
      "index": 90,
      "id": "msg_tokkun005",
      "hash": "264fa1c663250f4a",
      "flags": 0,
      "text": "どの　ポケモンを\\nとっくん　するんじゃ？"
    },
    {
      "index": 91,
      "id": "msg_tokkun006",
      "hash": "264fa0c663250d97",
      "flags": 0,
      "text": "その　ポケモンの　レベルでは\\nとっくんに　耐えられない　ぞい！"
    },
    {
      "index": 92,
      "id": "msg_tokkun007",
      "hash": "264f9fc663250be4",
      "flags": 0,
      "text": "その　ポケモンは　とっくんの\\n必要が　なさそう　じゃ！"
    },
    {
      "index": 93,
      "id": "msg_tokkun008",
      "hash": "264f96c66324fc99",
      "flags": 0,
      "text": "どの　能力を\\nとっくん　するんじゃ？"
    },
    {
      "index": 94,
      "id": "msg_tokkun009",
      "hash": "264f95c66324fae6",
      "flags": 0,
      "text": "ぎんのおうかん　ひとつで\\n[VAR PKNICK(0000)]の　[VAR EVSTAT(0001)]を\\r\\nとっくん　するぞい？"
    },
    {
      "index": 95,
      "id": "msg_tokkun010",
      "hash": "264c98c66322ca28",
      "flags": 0,
      "text": "きんのおうかん　ひとつで\\n[VAR PKNICK(0000)]の　ぜんぶの\\r\\n能力を　とっくん　するぞい？"
    },
    {
      "index": 96,
      "id": "msg_tokkun011",
      "hash": "264c99c66322cbdb",
      "flags": 0,
      "text": "では　さっそく　[VAR PKNICK(0000)]を\\nとっくん　してくると　しよう"
    },
    {
      "index": 97,
      "id": "msg_tokkun012",
      "hash": "264c9ac66322cd8e",
      "flags": 0,
      "text": "ホァァァアアアア……！！\\nンホァァァアアアアアア……！！！！"
    },
    {
      "index": 98,
      "id": "msg_tokkun013",
      "hash": "264c9bc66322cf41",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]は　すごいとっくんで\\nすごく　強くなった　ぞい！"
    },
    {
      "index": 99,
      "id": "msg_tokkun014",
      "hash": "264c9cc66322d0f4",
      "flags": 0,
      "text": "続けて　するかい？"
    },
    {
      "index": 100,
      "id": "msg_tokkun015",
      "hash": "264c9dc66322d2a7",
      "flags": 0,
      "text": "それじゃあ　また　来てくれい！"
    },
    {
      "index": 101,
      "id": "msg_tokkun016",
      "hash": "264c9ec66322d45a",
      "flags": 0,
      "text": "すごいとっくん　とは！\\c\\nレベル１００に　なった　ポケモンの\\n能力を　さらに　さらに！\\r\\n高める　とっくん　なのじゃ！\\c\\nとっくんを　受けたければ\\nわしが　集めている　おうかんを\\r\\n持ってきてくれい！\\c\\nぎんのおうかん　なら\\nひとつの　能力を\\c\\nきんのおうかん　なら\\nぜんぶの　能力を\\r\\n最高に　鍛えて　あげるぞい！\\c\\nと　いうことで……"
    },
