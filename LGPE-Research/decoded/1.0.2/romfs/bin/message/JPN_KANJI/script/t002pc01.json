{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t002pc01_gentleman_01",
      "hash": "850a0b093207abf7",
      "flags": 0,
      "text": "隅に　ある　マガジンラックの\\n本は　ご自由に　お読みください！\\c\\n……と　受け付けの　ねーちゃんが\\n言っとった　親切やのう"
    },
    {
      "index": 1,
      "id": "msg_t002pc01_youngm_01",
      "hash": "311a5fc73c27a637",
      "flags": 0,
      "text": "ポケモンセンターは　この先\\nどこの　街に　行っても　ある！\\c\\n何匹　預けても　ただ　だし\\nこまめに　使うと　いいよ！"
    },
    {
      "index": 2,
      "id": "msg_t002pc01_childm_01",
      "hash": "b0660545b66d4ef1",
      "flags": 0,
      "text": "たくさん　つかまえた　ポケモンは\\nボックスに　送られるよ！\\c\\nきみの　バッグの　中にも\\nボックスが　あるでしょ？"
    },
    {
      "index": 3,
      "id": "msg_t002pc01_childf_01",
      "hash": "e19e756f6f4a2e16",
      "flags": 0,
      "text": "トレーナーと　戦った\\nこと　ある？\\c\\nすばやさが　高ければ\\n相手の　ポケモン　より\\r\\n先に　こうげき　できるよ！"
    },
    {
      "index": 4,
      "id": "msg_t002pc01_book_01",
      "hash": "468b8c6d5dbaeead",
      "flags": 0,
      "text": "『ポケモンジャーナル』\\nと　書かれた　本が　ある……"
    },
    {
      "index": 5,
      "id": "msg_t002pc01_select_01",
      "hash": "5d497dde6c88ca56",
      "flags": 0,
      "text": "裏表紙に　派手な\\n広告が　ある！　読みますか？"
    },
    {
      "index": 6,
      "id": "msg_t002pc01_book_02",
      "hash": "468b896d5dbae994",
      "flags": 0,
      "text": "ヒジュツと　呼ばれる\\n技を　使えば\\c\\n木を　切って　道を　作ったり\\n暗い　場所も　明るく　見えたり\\r\\n便利なこと　だらけ！\\c\\nあなたも　ヒジュツ\\nまなんで　みませんか？\\c\\n\\n……カントー　ヒジュツ　協会"
    },
    {
      "index": 7,
      "id": "msg_t002pc01_pc_01",
      "hash": "120b53a3d4e3dc71",
      "flags": 0,
      "text": "ただいま　マシンの\\nメンテナンス中　です\\c\\nすみませんが　また\\nのちほど　おこしください"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t002pc01_max",
      "hash": "110581e27b58f9da"
    }
  ]
}
