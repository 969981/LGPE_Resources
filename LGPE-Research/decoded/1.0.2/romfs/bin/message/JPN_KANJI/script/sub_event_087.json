{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub087_middle_f_01",
      "hash": "69183b2fbfcbb2c9",
      "flags": 0,
      "text": "もう　ヤドンちゃん　ったら\\n困った　わねぇ……"
    },
    {
      "index": 1,
      "id": "msg_sub087_middle_f_02",
      "hash": "6918382fbfcbadb0",
      "flags": 0,
      "text": "あら　あなた\\nもし　よければ\\r\\nお願い　聞いてくれない？"
    },
    {
      "index": 2,
      "id": "msg_sub087_middle_f_03",
      "hash": "6918392fbfcbaf63",
      "flags": 0,
      "text": "忙しい　わよね\\nごめんなさいね……"
    },
    {
      "index": 3,
      "id": "msg_sub087_middle_f_04",
      "hash": "69183e2fbfcbb7e2",
      "flags": 0,
      "text": "これから　ニビ博物館に\\n行きたいん　だけど\\c\\nヤドンちゃん　ったら　てこ　でも\\n動いて　くれないのよ"
    },
    {
      "index": 4,
      "id": "msg_sub087_yadon_01",
      "hash": "f0f118be8033672a",
      "flags": 0,
      "text": "ヤドン『むっふぁーん"
    },
    {
      "index": 5,
      "id": "msg_sub087_middle_f_05",
      "hash": "69183f2fbfcbb995",
      "flags": 0,
      "text": "よかったら　ちょっとの　間\\nヤドンちゃん　見ててくれない？"
    },
    {
      "index": 6,
      "id": "msg_sub087_middle_f_09",
      "hash": "6918432fbfcbc061",
      "flags": 0,
      "text": "あら　あなた！　よかったら\\nまた　ヤドンちゃんの　こと\\r\\n見ててくれない　かしら？"
    },
    {
      "index": 7,
      "id": "msg_sub087_select_01",
      "hash": "087a940740025655",
      "flags": 0,
      "text": "いいですよ"
    },
    {
      "index": 8,
      "id": "msg_sub087_select_02",
      "hash": "087a91074002513c",
      "flags": 0,
      "text": "ごめんなさい"
    },
    {
      "index": 9,
      "id": "msg_sub087_middle_f_06",
      "hash": "69183c2fbfcbb47c",
      "flags": 0,
      "text": "助かるわぁ\\nじゃあ　ちょっとの　間\\r\\nヤドンちゃんの　こと　お願いね"
    },
    {
      "index": 10,
      "id": "msg_sub087_yadon_02",
      "hash": "f0f117be80336577",
      "flags": 0,
      "text": "……　……　……\\n……　……　……"
    },
    {
      "index": 11,
      "id": "msg_sub087_system_01",
      "hash": "a2604769f3459b22",
      "flags": 0,
      "text": "ヤドンは　ぼんやりと\\n正面を　見つめてる……"
    },
    {
      "index": 12,
      "id": "msg_sub087_system_02",
      "hash": "a2604669f345996f",
      "flags": 0,
      "text": "ヤドンは　ずっと\\nなにもしない　を　している……"
    },
    {
      "index": 13,
      "id": "msg_sub087_system_03",
      "hash": "a2604569f34597bc",
      "flags": 0,
      "text": "ヤドンは　気持ちよさそうに\\n佇んでいる……"
    },
    {
      "index": 14,
      "id": "msg_sub087_system_04",
      "hash": "a2604469f3459609",
      "flags": 0,
      "text": "ヤドンは　何かを\\n考えて　いるように　見える……"
    },
    {
      "index": 15,
      "id": "msg_sub087_system_05",
      "hash": "a2604369f3459456",
      "flags": 0,
      "text": "ヤドンは　[VAR TRNAME(0000)]が　いることに\\n初めて　気づいた　みたい……"
    },
    {
      "index": 16,
      "id": "msg_sub087_system_06",
      "hash": "a2604269f34592a3",
      "flags": 0,
      "text": "ヤドンは　[VAR TRNAME(0000)]を\\n横目で　ちょっと　見てる……"
    },
    {
      "index": 17,
      "id": "msg_sub087_system_07",
      "hash": "a2604169f34590f0",
      "flags": 0,
      "text": "ヤドンは　[VAR TRNAME(0000)]の　ことが\\nちょっとだけ　気になっている……"
    },
    {
      "index": 18,
      "id": "msg_sub087_system_08",
      "hash": "a2605069f345aa6d",
      "flags": 0,
      "text": "ヤドンは　[VAR TRNAME(0000)]に\\n慣れて　きた　みたい……"
    },
    {
      "index": 19,
      "id": "msg_sub087_system_09",
      "hash": "a2604f69f345a8ba",
      "flags": 0,
      "text": "なんとなく　ヤドンが\\n嬉しそうに　みえる……"
    },
    {
      "index": 20,
      "id": "msg_sub087_system_10",
      "hash": "a25cc269f342834c",
      "flags": 0,
      "text": "ヤドンは　[VAR TRNAME(0000)]と　一緒に\\nいられて　ちょっと　嬉しそう！"
    },
    {
      "index": 21,
      "id": "msg_sub087_system_11",
      "hash": "a25cc369f34284ff",
      "flags": 0,
      "text": "……ヤドンちゃんと\\nのんびり　した\\r\\n時間を　過ごした！"
    },
    {
      "index": 22,
      "id": "msg_sub087_middle_f_07",
      "hash": "69183d2fbfcbb62f",
      "flags": 0,
      "text": "ヤドンちゃんの　こと\\n見ててくれて　ありがとう\\c\\nこれ　お駄賃よ\\n受けとって　くださる？"
    },
    {
      "index": 23,
      "id": "msg_sub087_system_12",
      "hash": "a25cc469f34286b2",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　おばさんから\\n[VAR ITEM2(0001)]を　もらった！"
    },
    {
      "index": 24,
      "id": "msg_sub087_middle_f_08",
      "hash": "6918422fbfcbbeae",
      "flags": 0,
      "text": "よければ\\nまた　よろしくね"
    }
  ],
  "unpaired_labels": [
