    {
      "index": 5,
      "id": "msg_main0720_musashi_05",
      "hash": "716865af2e386040",
      "flags": 0,
      "text": "ムサシ『え！？　カラカラ！？\\c\\nそんなの　もう\\nボスに　あげちゃった　わよ！"
    },
    {
      "index": 6,
      "id": "msg_main0720_musashi_06",
      "hash": "716868af2e386559",
      "flags": 0,
      "text": "ムサシ『え！？　そうなの！？\\nあんた　見込み　あるじゃない！\\c\\n……って　だまされないん　だから！"
    },
    {
      "index": 7,
      "id": "msg_main0720_musashi_07",
      "hash": "716867af2e3863a6",
      "flags": 0,
      "text": "ムサシ『なんにせよ！\\nボスの　ところ　には\\r\\nぜーったい　行かせないわ！"
    },
    {
      "index": 8,
      "id": "msg_main0720_kojiro_01",
      "hash": "fea20c2f34fd4158",
      "flags": 0,
      "text": "コジロウ『おう！　お月見山の\\nカセキの　借りを　返すぜ！"
