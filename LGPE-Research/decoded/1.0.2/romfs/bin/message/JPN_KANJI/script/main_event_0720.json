    },
    {
      "index": 11,
      "id": "msg_main0720_musashi_02",
      "hash": "71686caf2e386c25",
      "flags": 0,
      "text": "ムサシ『フーンだ！　ちょーっと\\nポケモン　強いからって　さあ！"
