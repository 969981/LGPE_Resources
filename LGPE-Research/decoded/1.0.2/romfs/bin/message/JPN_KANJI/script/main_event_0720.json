      "flags": 0,
      "text": "ムサシ『あんたは……\\nお月見山の　ジャリンコ！"
    },
    {
      "index": 2,
      "id": "msg_main0720_musashi_04",
      "hash": "716866af2e3861f3",
      "flags": 0,
      "text": "一体　こんなとこ　まで\\n何しに　来たのよ！"
    },
    {
      "index": 3,
      "id": "msg_main0720_select_01",
      "hash": "6d0c15488af76bc0",
      "flags": 0,
      "text": "カラカラを　助けに"
