{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0950_president_01",
      "hash": "43e9080775e6fb2f",
      "flags": 0,
      "text": "社長『おお　少年よ！\\nきみの　おかげで　助かった！"
    },
    {
      "index": 1,
      "id": "msg_main0950_president_02",
      "hash": "43e9090775e6fce2",
      "flags": 0,
      "text": "社長『おお　少女よ！\\nきみの　おかげで　助かった！"
    },
    {
      "index": 2,
      "id": "msg_main0950_partner_a_01",
      "hash": "c9f6ab0c5f166b39",
      "flags": 0,
      "text": "ピカピカ！"
    },
    {
      "index": 3,
      "id": "msg_main0950_partner_b_01",
      "hash": "1c046af0a3c5ef46",
      "flags": 0,
      "text": "ブイブイ！"
    },
    {
      "index": 4,
      "id": "msg_main0950_president_08",
      "hash": "43e90f0775e70714",
      "flags": 0,
      "text": "……ワッハッハ！　きみ　でなく\\nきみたち　じゃったな！"
    },
    {
      "index": 5,
      "id": "msg_main0950_president_05",
      "hash": "43e9040775e6f463",
      "flags": 0,
      "text": "ピンチを　救って　くれた\\nきみたちの　ことを　この先\\r\\nわたしは　けして　忘れんとも！"
    },
    {
      "index": 6,
      "id": "msg_main0950_president_06",
      "hash": "43e9050775e6f616",
      "flags": 0,
      "text": "おお！　そうだ\\nお礼を　さしあげなくては！\\c\\nわたしは\\n太っ腹で　ある　からして\\c\\nほれ\\nこーんな　ものでは　いかがかな？"
    },
    {
      "index": 7,
      "id": "msg_main0950_sys_01",
      "hash": "f506055ea4260db4",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　社長　から\\n[VAR COLOR(0006)]マスターボール[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 8,
      "id": "msg_main0950_president_03",
      "hash": "43e90a0775e6fe95",
      "flags": 0,
      "text": "社長『どこにも　売ってない\\n秘密の　試作品　マスターボール！"
    },
    {
      "index": 9,
      "id": "msg_main0950_president_07",
      "hash": "43e9060775e6f7c9",
      "flags": 0,
      "text": "投げれば　かならず\\nポケモンを　捕まえられる！\\c\\n……実は　ひとつ　だけ\\n完成して　いたのだよ"
    },
    {
      "index": 10,
      "id": "msg_main0950_president_09",
      "hash": "43e9100775e708c7",
      "flags": 0,
      "text": "こっそりと……\\n使って　みて　くれたまえ"
    },
    {
      "index": 11,
      "id": "msg_main0950_president_04",
      "hash": "43e9030775e6f2b0",
      "flags": 0,
      "text": "社長『おお！\\nピンチの　恩人！\\r\\nあの時は　ありがとう！"
    },
    {
      "index": 12,
      "id": "msg_main0950_president_10",
      "hash": "43ec8d0775ea1305",
      "flags": 0,
      "text": "社長『おお！\\n君　待ってくれ！\\r\\nお礼を　させてくれ！"
    },
    {
      "index": 13,
      "id": "msg_workerm1_01_p04_cave_d1011",
      "hash": "d2eb872ba95fcdcc",
      "flags": 0,
      "text": "[~ 13]"
    },
    {
      "index": 14,
      "id": "msg_main0950_stafff_01",
      "hash": "079f21ac444df12d",
      "flags": 0,
      "text": "秘書『このたびは　助けて\\nいただいて　ありがとう　ございます\\c\\n社長　ともども\\n感謝の　気持ちで　いっぱいです"
    },
    {
      "index": 15,
      "id": "msg_main0950_stafff_02",
      "hash": "079f1eac444dec14",
      "flags": 0,
      "text": "秘書『かならず　捕まえられる\\nボール　なんて……\\c\\nよほどの　トレーナー　でないと\\n持つべきでは　ありませんわ\\c\\n社長は　あなたに　だから\\nマスターボールを　あげたのですわ"
    }
  ],
