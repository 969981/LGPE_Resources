    },
    {
      "index": 7,
      "id": "msg_main0040_new_rival_01",
      "hash": "300dda520826e5ae",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『オーキド博士！\\c\\nそこの　モンスターボール\\nさっきは　２個　だったのに\\r\\nなぜか　３個に　増えたんです！"
    },
    {
      "index": 8,
      "id": "msg_main0040_new_doctor_01",
      "hash": "4e6eefdd0a5feaff",
      "flags": 0,
      "text": "オーキド『いやいや！\\nひとつは　さっき　[VAR TRNAME(0000)]が\\r\\n捕まえた　[VAR POKNAME(0002)]　なんじゃ"
    },
    {
      "index": 9,
      "id": "msg_main0040_new_rival_02",
      "hash": "300dd9520826e3fb",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『[VAR TRNAME(0000)]\\n自分で　捕まえた　のか？"
    },
    {
      "index": 10,
      "id": "msg_main0040_new_rival_03",
      "hash": "300dd8520826e248",
      "flags": 0,
      "text": "わッ！　びっくりした"
    },
    {
      "index": 11,
      "id": "msg_main0040_new_doctor_02",
      "hash": "4e6ef0dd0a5fecb2",
      "flags": 0,
      "text": "オーキド『うわっはは！\\nなんだか　おもしろい　のう！"
    },
    {
      "index": 12,
      "id": "msg_main0040_new_doctor_04",
      "hash": "4e6eeadd0a5fe280",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]よ！\\nこんどこそ　ボールを\\r\\nしっかりと　手にとって　やりなさい！"
    },
    {
      "index": 13,
      "id": "msg_main0040_new_doctor_03",
      "hash": "4e6ef1dd0a5fee65",
      "flags": 0,
      "text": "さあ　[VAR POKNAME(0002)]を\\n今度こそ　手に　いれるんじゃ！"
    },
    {
      "index": 14,
      "id": "msg_main0040_new_rival_04",
      "hash": "300ddf520826ee2d",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]が　捕まえたの\\n真ん中の　ボールに\\r\\n入ってる　みたいだな"
    },
    {
      "index": 15,
      "id": "msg_main0040_new_rival_05",
      "hash": "300dde520826ec7a",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『そっちじゃ　ないよって\\n言ってる　みたいだぞ！"
    }
