    {
      "index": 1,
      "id": "msg_sub018_rocketm_02",
      "hash": "c2e70a864051acf7",
      "flags": 0,
      "text": "……わかった！\\n盗んだ　もの　返すよ"
    },
    {
      "index": 2,
      "id": "msg_sub018_sys_01",
      "hash": "60db5616f88016d0",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　[VAR ITEM2(0001)]\\n「[VAR COLOR(0006)][VAR MOVE(0002)][VAR COLOR(0000)]」を　取り返した！"
    },
    {
      "index": 3,
      "id": "msg_sub018_rocketm_03",
      "hash": "c2e709864051ab44",
      "flags": 0,
      "text": "そ　それじゃ……！\\nおれは　退散　するから！\\r\\n…………ばいばーい！"
    },
