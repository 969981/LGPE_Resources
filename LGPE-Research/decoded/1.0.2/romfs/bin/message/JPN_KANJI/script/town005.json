{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_town005_kanban_01",
      "hash": "e9b56ce052d8e502",
      "flags": 0,
      "text": "ここは　シオンタウン\\nシオンは　紫　尊い色"
    },
    {
      "index": 1,
      "id": "msg_town005_kanban_02",
      "hash": "e9b56be052d8e34f",
      "flags": 0,
      "text": "見えない　ポケモンも　よく見える？\\n新製品！　シルフスコープ！\\c\\n……シルフカンパニー"
    },
    {
      "index": 2,
      "id": "msg_town005_kanban_03",
      "hash": "e9b56ae052d8e19c",
      "flags": 0,
      "text": "ここは　愛の　ボランティア\\nポケモンハウス"
    },
    {
      "index": 3,
      "id": "msg_town005_kanban_04",
      "hash": "e9b569e052d8dfe9",
      "flags": 0,
      "text": "ここは　ポケモンの　礼拝塔\\nポケモンタワー"
    },
    {
      "index": 4,
      "id": "msg_town005_juveniles_01_01",
      "hash": "dd108a5f7ce63432",
      "flags": 0,
      "text": "あなた\\n幽霊は　いると　思う？"
    },
    {
      "index": 5,
      "id": "msg_town005_juveniles_01_02",
      "hash": "dd10895f7ce6327f",
      "flags": 0,
      "text": "……ふーん\\n信じてる　人って　いるんだ"
    },
    {
      "index": 6,
      "id": "msg_town005_juveniles_01_03",
      "hash": "dd10885f7ce630cc",
      "flags": 0,
      "text": "あはは　そうよね！\\c\\nあなたの　右肩に\\n白い　手が　置かれてる　なんて\\r\\n……あたしの　見間違いよね"
    },
    {
      "index": 7,
      "id": "msg_town005_adultm_01",
      "hash": "85160d0b0641adba",
      "flags": 0,
      "text": "ここは　ポケモンの　お墓で\\n有名な　タウンだ……\\c\\n飼っていた　ポケモンが　死んだ時\\nポケモンタワーに　持って行って\\r\\n冥福を　祈るのさ……"
    },
    {
      "index": 8,
      "id": "msg_town005_youngm_01",
      "hash": "992c8d4ceabdd3c2",
      "flags": 0,
      "text": "最近　ポケモンタワーに\\n幽霊が　出る　らしいんだ……\\c\\nどうも　ロケット団に　さらわれて\\n行方が　分からなかった\\r\\nポケモンの　幽霊　らしい……"
    },
    {
      "index": 9,
      "id": "msg_town005_oldf_01",
      "hash": "2d0312137a06f17c",
      "flags": 0,
      "text": "はあ～……\\nお香の　かおりに　癒される"
    },
    {
      "index": 10,
      "id": "msg_town005_poke_01",
      "hash": "575f74472b704770",
      "flags": 0,
      "text": "ニドラン♀『ポテ"
    },
    {
      "index": 11,
      "id": "msg_town005_childf_01",
      "hash": "e3b08901e734d73f",
      "flags": 0,
      "text": "ポケモンタワー　では\\n騒いじゃ　ダメなんだって！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_town005_max",
