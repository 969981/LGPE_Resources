  "lines": [
    {
      "index": 0,
      "id": "msg_main0182_system_01",
      "hash": "1ff41051aba24839",
      "flags": 0,
      "text": "ポケモンが　寝てる！\\c\\nけど　モンスターボールは\\n届かなさそう……"
    },
    {
      "index": 1,
      "id": "msg_main0182_musashi_01",
      "hash": "c76cda6867f9118e",
      "flags": 0,
      "text": "？？？『この　あたりには\\nない　みたいね……"
    },
    {
      "index": 2,
      "id": "msg_main0182_kojiro_01",
      "hash": "d11dc9207a414f92",
      "flags": 0,
      "text": "？？？『もう　少し\\n奥に　あるんじゃ　ないか！？"
    },
    {
      "index": 3,
      "id": "msg_main0182_musashi_02",
      "hash": "c76cd96867f90fdb",
      "flags": 0,
      "text": "？？？『あんた！　今の\\nぬすみ聞き　してた　でしょ！"
    },
    {
      "index": 4,
      "id": "msg_main0182_kojiro_02",
      "hash": "d11dc8207a414ddf",
      "flags": 0,
      "text": "？？？『なんだって！　見張りの\\nニャースは　なに　してんだよ"
    },
    {
      "index": 5,
      "id": "msg_main0182_nyasu_01",
      "hash": "b13408a97285ce1a",
      "flags": 0,
      "text": "ニャース『にゃー！"
    },
    {
      "index": 6,
      "id": "msg_main0182_musashi_03",
      "hash": "c76cd86867f90e28",
      "flags": 0,
      "text": "？？？『ここに　珍しい　カセキ\\nあるって　突きとめたのに\\c\\nあんた　なんかに\\n渡さないん　だからー！"
    },
    {
      "index": 7,
      "id": "msg_main0182_kojiro_03",
      "hash": "d11dc7207a414c2c",
      "flags": 0,
      "text": "？？？『そうだぞ！　カセキ　見つけて\\n金儲け　するのは　おれたちだ！"
    },
    {
      "index": 8,
      "id": "msg_main0182_musashi_04",
      "hash": "c76cdf6867f91a0d",
      "flags": 0,
      "text": "？？？『ワーッハッハッハー！"
    }
  ],
