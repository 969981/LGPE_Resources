  "lines": [
    {
      "index": 0,
      "id": "msg_main8110_combat_01",
      "hash": "2862f3f0a8471eb5",
      "flags": 0,
      "text": "シバ『おれは　四天王の　シバ！"
    },
    {
      "index": 1,
      "id": "msg_main8110_combat_05",
      "hash": "2862eff0a84717e9",
      "flags": 0,
      "text": "人も　ポケモンも\\n戦い　鍛えれば\\r\\nどこまでも　強くなる！"
    },
    {
      "index": 2,
      "id": "msg_main8110_combat_06",
      "hash": "2862ecf0a84712d0",
      "flags": 0,
      "text": "おれは　そんな　鍛え　ぬかれた\\nかくとうポケモン　たちと\\r\\n共に　生きてきた！\\r\\nそして　これからもな！"
    },
    {
      "index": 3,
      "id": "msg_main8110_combat_07",
      "hash": "2862edf0a8471483",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]と　言ったな！"
    },
    {
      "index": 4,
      "id": "msg_main8110_combat_08",
      "hash": "2862faf0a8472a9a",
      "flags": 0,
      "text": "おれ達の　スーパー　パワーを\\n受けて　みるが　いい！"
    },
    {
      "index": 5,
      "id": "msg_main8110_combat_09",
      "hash": "2862fbf0a8472c4d",
      "flags": 0,
      "text": "ウー！　ハーッ！"
    },
    {
      "index": 6,
      "id": "msg_shiba_01_p02_cave_d1402",
      "hash": "72418348ba117edb",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main8110_combat_02",
      "hash": "2862f0f0a847199c",
      "flags": 0,
      "text": "シバ『負けちまったら\\nおれたちの　出番は　終わりだ！\\r\\nさぁ！　次に　行って　くれ！"
    },
    {
      "index": 8,
      "id": "msg_main8110_combat_03",
      "hash": "2862f1f0a8471b4f",
      "flags": 0,
      "text": "シバ『カンナと　戦う\\nおまえの　気迫が\\r\\nここまで　伝わって　きた！"
    },
    {
      "index": 9,
      "id": "msg_main8110_combat_10",
      "hash": "2865f8f0a8495d0b",
      "flags": 0,
      "text": "おれも　負けずに　鍛えぬいた\\nかくとうポケモン　たちの\\r\\n力を　おまえに　示そう！"
    },
    {
      "index": 10,
      "id": "msg_main8110_combat_11",
      "hash": "2865f7f0a8495b58",
      "flags": 0,
      "text": "ウー！　ハーッ！\\nウー！！　ハーッ！！！"
    },
    {
      "index": 11,
      "id": "msg_main8110_combat_04",
      "hash": "2862eef0a8471636",
      "flags": 0,
      "text": "くそッ！　まだまだ　修行が\\n足りんと　いうことか\\c\\n……気づかいは　無用だ\\n先へ　進め！"
    }
  ],
