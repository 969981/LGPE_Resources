  "lines": [
    {
      "index": 0,
      "id": "msg_t008r0101_muscle_01",
      "hash": "d5e42d2ee3c00e3f",
      "flags": 0,
      "text": "ウチの　園長\\nあだ名　ヤドンって　言うんです\\c\\nほら！　ポケモンの　ヤドンって\\nとぼけた　かんじ　でしょ！"
    },
    {
      "index": 1,
      "id": "msg_t008r0101_engineer_01",
      "hash": "a74a52337d0c8eb5",
      "flags": 0,
      "text": "ヤドンさんって\\nすごい　ポケモン　詳しいんだ！\\c\\n見た　ことも　ない\\nポケモンの　カセキとか　もってるし"
    },
    {
      "index": 2,
      "id": "msg_t008r0101_muscle_02",
      "hash": "d5e42e2ee3c00ff2",
      "flags": 0,
      "text": "ヤドン　園長……\\c\\nこないだ　釣りに\\n出かけて　からと　いうもの\\r\\nなにやら　ずっと\\r\\nふにゃふにゃ　言ってんだ\\c\\nボケた　のか？"
    },
    {
      "index": 3,
      "id": "msg_t008r0101_engineer_02",
      "hash": "a74a4f337d0c899c",
      "flags": 0,
      "text": "１９番水道　方面で\\n金色に　ひかる\\r\\nなにかを　見たぞ\\c\\nすごい　お宝　かも！"
    },
    {
      "index": 4,
      "id": "msg_t008r0101_poster_01",
      "hash": "4dc32babf18f14b5",
      "flags": 0,
      "text": "サファリゾーン\\n今週の　目標！\\c\\n頑張って　ポケモンより　早起き！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t008r0101_max",
