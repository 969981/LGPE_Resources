{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0330_pc_02",
      "hash": "09a33de112d0efab",
      "flags": 0,
      "text": "パソコンの　画面に\\n転送マシンと　出てます！"
    },
    {
      "index": 1,
      "id": "msg_main0330_masaki_10",
      "hash": "f7d8f6e3f59b634d",
      "flags": 0,
      "text": "おっと！　いそがな！\\nたのんだでー"
    },
    {
      "index": 2,
      "id": "msg_main0330_pc_01",
      "hash": "09a33ee112d0f15e",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　転送マシンの\\n分離プログラムを　起動した！"
    },
    {
      "index": 3,
      "id": "msg_main0330_masaki_01",
      "hash": "f7d571e3f5984b77",
      "flags": 0,
      "text": "マサキ『やあー！\\nおおきに　おおきに　助かったわ！\\c\\n……おッ　あんさん　さすが！\\nバッグに　[VAR COLOR(0006)]ボックス　[VAR COLOR(0000)]機能\\r\\nちゃーんと　入っとる　やん！"
    },
    {
      "index": 4,
      "id": "msg_main0330_masaki_02",
      "hash": "f7d572e3f5984d2a",
      "flags": 0,
      "text": "マサキ『やあー！\\nおおきに　おおきに　助かったわ！\\c\\n……おッ　ねえさん　さすが！\\nバッグに　[VAR COLOR(0006)]ボックス　[VAR COLOR(0000)]機能\\r\\nちゃーんと　入っとる　やん！"
    },
    {
      "index": 5,
      "id": "msg_main0330_masaki_06",
      "hash": "f7d56ee3f598465e",
      "flags": 0,
      "text": "ポケモン　捕まえすぎて\\nボックス　いっぱい　やったら\\r\\n[VAR COLOR(0006)]オーキド博士に　送って[VAR COLOR(0000)]\\r\\nあげたら　ええよ！"
    },
    {
      "index": 6,
      "id": "msg_main0330_masaki_07",
      "hash": "f7d56fe3f5984811",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main0330_sys_03",
      "hash": "6149ed9ac41a89fe",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "msg_main0330_masaki_05",
      "hash": "f7d56de3f59844ab",
      "flags": 0,
      "text": "……ああ　そや！\\nさっき　助けてくれた\\r\\nお礼　っちゅー　のも\\r\\nなんやけど……　これ　やるわ！"
    },
    {
      "index": 9,
      "id": "msg_main0330_sys_01",
      "hash": "6149eb9ac41a8698",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　マサキから\\n[VAR COLOR(0006)]ふねのチケット[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 10,
      "id": "msg_masaki_01_p06_r025_r0101",
      "hash": "4907e3945140cfdf",
      "flags": 0,
      "text": "[~ 10]"
    },
    {
      "index": 11,
      "id": "msg_main0330_masaki_03",
      "hash": "f7d573e3f5984edd",
      "flags": 0,
      "text": "いま　クチバの　港に\\nサント・アンヌ号が　来とんのや\\c\\nチケット　もろたのは　ええんやけど\\nパーティとか　好きや　ないからな\\c\\n２枚くらい　入っとる　から\\n誰かと　行って　遊んでえな"
    },
    {
      "index": 12,
      "id": "msg_main0330_masaki_04",
      "hash": "f7d56ce3f59842f8",
      "flags": 0,
      "text": "マサキ『ポケモン　捕まえすぎて\\nボックス　いっぱい　やったら\\r\\nまとめて　オーキド博士に\\r\\n送って　あげたら　ええよ！"
    }
  ],
