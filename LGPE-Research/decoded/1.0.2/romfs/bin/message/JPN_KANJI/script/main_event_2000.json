{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main2000_rival_01",
      "hash": "4568f4f74cfce003",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『おじゃましまーす！"
    },
    {
      "index": 1,
      "id": "msg_main2000_rival_02",
      "hash": "4568f5f74cfce1b6",
      "flags": 0,
      "text": "おーい　[VAR TRNAME(0000)]！\\nあがるぞー！"
    },
    {
      "index": 2,
      "id": "msg_main2000_rival_03",
      "hash": "4568f6f74cfce369",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『おはよ！\\nカントー　チャンピオン！"
    },
    {
      "index": 3,
      "id": "msg_main2000_rival_09",
      "hash": "4568fcf74cfced9b",
      "flags": 0,
      "text": "って　言っても　今度は　オレが\\nその座を　奪いに　行くけどさ！"
    },
    {
      "index": 4,
      "id": "msg_main2000_rival_04",
      "hash": "4568f7f74cfce51c",
      "flags": 0,
      "text": "それより！\\n[VAR TRNAME(0000)]　聞いた？\\c\\nなんか　すっげー　強そうな\\nポケモンが　いる　らしいって！"
    },
    {
      "index": 5,
      "id": "msg_main2000_sel_01",
      "hash": "8b65dee0045ddfb3",
      "flags": 0,
      "text": "どんな　ポケモン？"
    },
    {
      "index": 6,
      "id": "msg_main2000_sel_02",
      "hash": "8b65dfe0045de166",
      "flags": 0,
      "text": "捕まえたい！"
    },
    {
      "index": 7,
      "id": "msg_main2000_rival_05",
      "hash": "4568f8f74cfce6cf",
      "flags": 0,
      "text": "めちゃめちゃ　強くて\\nかっこいい　ポケモン　らしいぞ！"
    },
    {
      "index": 8,
      "id": "msg_main2000_rival_06",
      "hash": "4568f9f74cfce882",
      "flags": 0,
      "text": "あはは！\\n気が　はやいなあ"
    },
    {
      "index": 9,
      "id": "msg_main2000_rival_07",
      "hash": "4568faf74cfcea35",
      "flags": 0,
      "text": "その　ポケモンが　いたのは\\n[VAR COLOR(0006)]ハナダシティ[VAR COLOR(0000)]の　近く！"
    },
    {
      "index": 10,
      "id": "msg_main2000_rival_10",
      "hash": "456bf9f74cff1e59",
      "flags": 0,
      "text": "で　どっかの　洞窟に\\n逃げちゃった　らしい……"
    },
    {
      "index": 11,
      "id": "msg_main2000_rival_08",
      "hash": "4568fbf74cfcebe8",
      "flags": 0,
      "text": "なあ！　オレたちも　その　ポケモン\\n探して　みないか！"
    },
    {
      "index": 12,
      "id": "msg_main2000_rival_11",
      "hash": "456bf8f74cff1ca6",
      "flags": 0,
      "text": "どっちが　先に\\nみつけるか　競争　だ！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_2000_max",
      "hash": "9104968fcbd7dad1"
    }
  ]
}
