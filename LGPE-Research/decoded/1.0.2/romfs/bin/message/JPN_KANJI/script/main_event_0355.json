{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0355_rival_01",
      "hash": "4922a821543180a8",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『あッ\\nなあなあ　[VAR TRNAME(0000)]！"
    },
    {
      "index": 1,
      "id": "msg_main0355_rival_02",
      "hash": "4922ab21543185c1",
      "flags": 0,
      "text": "あっちの　ゲート\\n通れない　みたいだぞ"
    },
    {
      "index": 2,
      "id": "msg_main0355_rival_03",
      "hash": "4922aa215431840e",
      "flags": 0,
      "text": "でも　[VAR COLOR(0006)]地下通路[VAR COLOR(0000)]を　通れば\\n[VAR COLOR(0006)]クチバシティ[VAR COLOR(0000)]に　行けるぞ！\\c\\n……ちょっと　暗くて\\nアレだけどな"
    },
    {
      "index": 3,
      "id": "msg_main0355_rival_04",
      "hash": "4922ad2154318927",
      "flags": 0,
      "text": "ん？"
    },
    {
      "index": 4,
      "id": "msg_main0355_rival_05",
      "hash": "4922ac2154318774",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]　ちょっと\\nじっと　して……"
    },
    {
      "index": 5,
      "id": "msg_main0355_rival_06",
      "hash": "4922af2154318c8d",
      "flags": 0,
      "text": "なんか　キラキラ　してると\\n思ったら\\c\\nこんなのが　髪に\\n引っかかってたぞ！"
    },
    {
      "index": 6,
      "id": "msg_main0355_sys_01",
      "hash": "c60b529203635a3f",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　[VAR TRNAME(0001)]から\\nげんきのかけらを　受け取った！"
    },
    {
      "index": 7,
      "id": "msg_main0355_rival_07",
      "hash": "4922ae2154318ada",
      "flags": 0,
      "text": "げんきのかけら　って　いうのは\\nひんしに　なった　ポケモンを\\r\\n元気に　する　道具だぞ\\c\\nオレも　少し　もってる……\\nオレのも　わけて　やるよ！"
    },
    {
      "index": 8,
      "id": "msg_main0355_sys_02",
      "hash": "c60b539203635bf2",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　[VAR TRNAME(0001)]から\\nげんきのかけらを　２個　もらった！"
    },
    {
      "index": 9,
      "id": "msg_main0355_rival_08",
      "hash": "4922a121543174c3",
      "flags": 0,
      "text": "次の　ジムで\\n役に立つ　かもな！"
    },
    {
      "index": 10,
      "id": "msg_main0355_rival_09",
      "hash": "4922a02154317310",
      "flags": 0,
      "text": "……あれ？　もしかして\\nそれって　ふねのチケット？"
    },
    {
      "index": 11,
      "id": "msg_main0355_select_01",
      "hash": "2fd0a1f98fff99a0",
      "flags": 0,
      "text": "１枚　あげる！"
    },
    {
      "index": 12,
      "id": "msg_main0355_select_02",
      "hash": "2fd0a4f98fff9eb9",
      "flags": 0,
      "text": "１枚　あまってて"
    },
    {
      "index": 13,
      "id": "msg_main0355_rival_14",
      "hash": "491f1f21542e6206",
      "flags": 0,
      "text": "えッ　いいなー！　しかも\\nサント・アンヌ号　だって！？\\c\\n世界を　またに　かける\\n豪華客船　だぞ！\\c\\nほんと　１度で　いいから\\n乗って　みたいん　だよなあ"
    },
    {
      "index": 14,
      "id": "msg_main0355_player_01",
      "hash": "63a16bd38951be9b",
      "flags": 0,
      "text": "……　……"
    },
    {
      "index": 15,
      "id": "msg_main0355_sys_03",
      "hash": "c60b549203635da5",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　[VAR TRNAME(0001)]に\\nふねのチケットを　１枚　あげた！"
    },
    {
      "index": 16,
      "id": "msg_main0355_rival_10",
      "hash": "491f2321542e68d2",
      "flags": 0,
      "text": "えー　いいのか？\\nぜったい　行くよー！\\r\\nどうしたの　コレ？"
    },
    {
      "index": 17,
      "id": "msg_main0355_rival_11",
      "hash": "491f2421542e6a85",
      "flags": 0,
      "text": "……ひえッ！　あの　しゃべる\\nポケモンに　もらった　って！？"
    },
    {
      "index": 18,
      "id": "msg_main0355_rival_12",
      "hash": "491f2121542e656c",
      "flags": 0,
      "text": "あ　いや　そうか\\nちゃんと　人間だったのか"
    },
    {
      "index": 19,
      "id": "msg_main0355_rival_13",
      "hash": "491f2221542e671f",
      "flags": 0,
      "text": "……あのときの　ことは\\nもう　忘れて　くれよ"
    },
    {
      "index": 20,
      "id": "msg_main0355_rival_15",
      "hash": "491f2021542e63b9",
      "flags": 0,
      "text": "じゃ　オレは\\n先に　行こうかな！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0355_max",
