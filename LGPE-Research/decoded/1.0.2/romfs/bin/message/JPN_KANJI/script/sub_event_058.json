{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub058_fat_01",
      "hash": "28b90d9a860da042",
      "flags": 0,
      "text": "ぼくの　じてんしゃ　コレクション\\nすごいでしょー！\\c\\n乗せたり　売ったり　しない　けど\\n好きな　だけ　見てって　いいよ！"
    },
    {
      "index": 1,
      "id": "msg_sub058_bike_01",
      "hash": "ff6f7e16f6c5ba06",
      "flags": 0,
      "text": "ピッカピカの　じてんしゃ！\\nとても　高そう！"
    },
    {
      "index": 2,
      "id": "msg_sub058_fat_03",
      "hash": "28b90b9a860d9cdc",
      "flags": 0,
      "text": "その　じてんしゃ　気になる！？"
    },
    {
      "index": 3,
      "id": "msg_sub058_fat_02",
      "hash": "28b90c9a860d9e8f",
      "flags": 0,
      "text": "シンプルな　じてんしゃ　って\\nいいよねー！　ちょっと　前に\\r\\n流行った　限定　モデルさ"
    },
    {
      "index": 4,
      "id": "msg_sub0658_fat_03",
      "hash": "4d9896799193ed70",
      "flags": 0,
      "text": "フレームの　サワヤカな　色合いが\\n大自然と　サイコーに　マッチ！"
    },
    {
      "index": 5,
      "id": "msg_sub058_fat_04",
      "hash": "28b90a9a860d9b29",
      "flags": 0,
      "text": "なんと　お値段　１００００００円！\\nマニア泣かせの　スーパー　レアもの！"
    },
    {
      "index": 6,
      "id": "msg_sub058_fat_05",
      "hash": "28b9099a860d9976",
      "flags": 0,
      "text": "性能は　平均的　だけど\\n乗りやすさは　ダントツ　で"
    },
    {
      "index": 7,
      "id": "msg_sub058_fat_06",
      "hash": "28b9089a860d97c3",
      "flags": 0,
      "text": "じてんしゃ　初心者　でも\\nカンタンに　乗りこなせちゃう　のだ！"
    },
    {
      "index": 8,
      "id": "msg_sub058_bike_04",
      "hash": "ff6f8316f6c5c285",
      "flags": 0,
      "text": "そっかー……"
    },
    {
      "index": 9,
      "id": "msg_sub058_bike_02",
      "hash": "ff6f7d16f6c5b853",
      "flags": 0,
      "text": "ピッカピカの　じてんしゃだ！\\nとても　速そう！"
    },
    {
      "index": 10,
      "id": "msg_sub058_fat_20",
      "hash": "28bf9a9a8612fb87",
      "flags": 0,
      "text": "マッハじてんしゃ　気に　なる！？"
    },
    {
      "index": 11,
      "id": "msg_sub058_fat_07",
      "hash": "28b9079a860d9610",
      "flags": 0,
      "text": "マッハじてんしゃ　は\\nその　名　の　とおり　マッハな\\r\\n速さが　特徴な　じてんしゃさ"
    },
    {
      "index": 12,
      "id": "msg_sub058_fat_08",
      "hash": "28b9169a860daf8d",
      "flags": 0,
      "text": "軽さを　追求　した　フレーム！\\n究極の　空気抵抗！"
    },
    {
      "index": 13,
      "id": "msg_sub058_fat_09",
      "hash": "28b9159a860dadda",
      "flags": 0,
      "text": "カーボン製の　ハンドルへ　体重を\\nかければ　すぐさま　トップスピード！"
    },
    {
      "index": 14,
      "id": "msg_sub058_fat_10",
      "hash": "28b5889a860a886c",
      "flags": 0,
      "text": "その　勢いで　どんな　坂でも\\nラクラク　越えて　いけるんだ！"
    },
    {
      "index": 15,
      "id": "msg_sub058_fat_11",
      "hash": "28b5899a860a8a1f",
      "flags": 0,
      "text": "操縦の　難しさ　も\\nご愛嬌な　一品　さ！"
    },
    {
      "index": 16,
      "id": "msg_sub058_bike_03",
      "hash": "ff6f7c16f6c5b6a0",
      "flags": 0,
      "text": "ピッカピカの　じてんしゃだ！\\nとても　凄そう！"
    },
    {
      "index": 17,
      "id": "msg_sub058_fat_21",
      "hash": "28bf999a8612f9d4",
      "flags": 0,
      "text": "ダートじてんしゃ　気に　なる！？"
    },
    {
      "index": 18,
      "id": "msg_sub058_fat_12",
      "hash": "28b58a9a860a8bd2",
      "flags": 0,
      "text": "じてんしゃ　界隈の　中でも\\n飛びぬけて　ワイルドな　異端児！\\r\\nそれが　ダートじてんしゃ　さ！"
    },
    {
      "index": 19,
      "id": "msg_sub058_fat_13",
      "hash": "28b58b9a860a8d85",
      "flags": 0,
      "text": "ジャンプや　ウィリーなど　多彩な\\nアクションが　可能な　しろもの！"
    },
    {
      "index": 20,
      "id": "msg_sub058_fat_14",
      "hash": "28b5849a860a81a0",
      "flags": 0,
      "text": "一本橋　も　なんのその！\\n道　なき　道も　突き進むぞ！"
    },
    {
      "index": 21,
      "id": "msg_sub058_fat_15",
      "hash": "28b5859a860a8353",
      "flags": 0,
      "text": "だーっと　走る　から　ダート……\\nって　いうのは　冗談　だけど！"
    },
    {
      "index": 22,
      "id": "msg_sub058_fat_16",
      "hash": "28b5869a860a8506",
      "flags": 0,
      "text": "テクニック　重視な　キミに\\nオススメ　したい　じてんしゃ　さ！"
    },
    {
      "index": 23,
      "id": "msg_sub058_fat_17",
      "hash": "28b5879a860a86b9",
      "flags": 0,
      "text": "ぼくの　ウンチク　全部\\n聞いて　くれたの　キミが　初めて"
    },
    {
      "index": 24,
      "id": "msg_sub058_fat_18",
      "hash": "28b5909a860a9604",
      "flags": 0,
      "text": "キミも　相当な　マニアだね\\nお近づきの　印を　どうぞ！"
    },
    {
      "index": 25,
      "id": "msg_sub058_fat_19",
      "hash": "28b5919a860a97b7",
      "flags": 0,
      "text": "ぼくの　じてんしゃ　コレクション\\n……って　なんだ　キミ　か！\\c\\nキミ　なら　いつまでも\\n好きな　だけ　見てって　いいよ！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_058_max",
      "hash": "955df17cb3de289b"
    }
  ]
}
