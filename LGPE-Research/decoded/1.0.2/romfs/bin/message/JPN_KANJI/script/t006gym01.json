{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t006gym01_gym_01",
      "hash": "2e794eb10bfeff6b",
      "flags": 0,
      "text": "まってたぜ\\n未来の　チャンピオン！\\c\\nジムリーダー　マチス少佐は\\nでんきタイプの　ポケモンを\\r\\n使いこなす　タフガイだ！\\c\\nひこうタイプ　みずタイプは\\n相性が　悪いぜ！\\c\\nマヒ　させられないよう\\n気を　つけな！\\c\\nそれと　マチスは　用心深い！\\n簡単には　近づけないぜ！"
    },
    {
      "index": 1,
      "id": "msg_t006gym01_gym_02",
      "hash": "2e794fb10bff011e",
      "flags": 0,
      "text": "ふー！\\c\\n目も　くらむ　ような\\nマブシイ　戦い　だったぜ！"
    },
    {
      "index": 2,
      "id": "msg_t006gym01_statue_01",
      "hash": "dd9408e725ee8ef6",
      "flags": 0,
      "text": "クチバ　ポケモンジム\\nマチス　認定　トレーナー！\\r\\n[VAR TRNAME(0001)]"
    },
    {
      "index": 3,
      "id": "msg_t006gym01_statue_02",
      "hash": "dd9407e725ee8d43",
      "flags": 0,
      "text": "クチバ　ポケモンジム\\nマチス　認定　トレーナー！\\r\\n[VAR TRNAME(0001)]　[VAR TRNAME(0000)]"
    },
    {
      "index": 4,
      "id": "msg_t006gym01_gomi_01",
      "hash": "c6622a2b2c72f4ce",
      "flags": 0,
      "text": "ガサゴソ……！\\n中は　ゴミ　ばっかり！"
    },
    {
      "index": 5,
      "id": "msg_t006gym01_gomi_02",
      "hash": "c662292b2c72f31b",
      "flags": 0,
      "text": "ガサゴソ……！\\nおっと！　ゴミ箱の　底に\\r\\nスイッチが　あった！\\c\\n押して　みよう！　……ポチッとな"
    },
    {
      "index": 6,
      "id": "msg_t006gym01_gomi_05",
      "hash": "c6622e2b2c72fb9a",
      "flags": 0,
      "text": "電撃バリアの\\n第１ロックが　外れた！"
    },
    {
      "index": 7,
      "id": "msg_t006gym01_gomi_03",
      "hash": "c662282b2c72f168",
      "flags": 0,
      "text": "電撃バリアの\\n第２ロックが　外れた！\\c\\n電撃バリアが\\n完全に　解除　された！"
    },
    {
      "index": 8,
      "id": "msg_t006gym01_gomi_04",
      "hash": "c6622f2b2c72fd4d",
      "flags": 0,
      "text": "あッ！　電撃バリアの\\nロックが　戻って　しまった！"
    },
    {
      "index": 9,
      "id": "msg_t006gym01_gomi_06",
      "hash": "c6622d2b2c72f9e7",
      "flags": 0,
      "text": "赤い　ゴミ箱　だ！"
    },
    {
      "index": 10,
      "id": "msg_t006gym01_gomi_07",
      "hash": "c6622c2b2c72f834",
      "flags": 0,
      "text": "青い　ゴミ箱　だ！"
    },
    {
      "index": 11,
      "id": "msg_t006gym01_gomi_08",
      "hash": "c662232b2c72e8e9",
      "flags": 0,
      "text": "この　ゴミ箱の　スイッチは\\nすでに　押してある"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t006gym01_max",
