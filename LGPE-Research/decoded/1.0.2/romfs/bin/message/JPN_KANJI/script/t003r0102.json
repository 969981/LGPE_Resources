{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t003r0102_scientist_01_01",
      "hash": "514b6d4ef4dcd574",
      "flags": 0,
      "text": "今月は\\n宇宙博覧会を　やってます"
    },
    {
      "index": 1,
      "id": "msg_t003r0102_juvenilem_01_01",
      "hash": "10f7633cdae62c4f",
      "flags": 0,
      "text": "つきのいし　ね……\\c\\nそこら辺の　石ころと\\nどこが　違うんだろう？"
    },
    {
      "index": 2,
      "id": "msg_t003r0102_oldm_01_01",
      "hash": "b1922d572e9219a6",
      "flags": 0,
      "text": "人類が\\nはじめて　月に　立ち！\\c\\nそれから　数十年……\\c\\nこんどは　さらに　遠くの\\n赤い星を　目指して　いる！\\c\\n宇宙の　ニュースは\\nいつ　だって　わしを\\r\\nわくわく　させて　くれる！"
    },
    {
      "index": 3,
      "id": "msg_t003r0102_juveniles_01_01",
      "hash": "5cb2366d0b013951",
      "flags": 0,
      "text": "わたしね　わたしね\\nかわいいから　[VAR POKNAME(0002)]　欲しい！\\c\\nお父さんに　とってきてね　って\\nお願い　してるの"
    },
    {
      "index": 4,
      "id": "msg_t003r0102_fat_01_01",
      "hash": "66105d63106ee55d",
      "flags": 0,
      "text": "はい　はい！\\n[VAR POKNAME(0002)]だな！　今度な！"
    },
    {
      "index": 5,
      "id": "msg_t003r0102_fat_01_02",
      "hash": "66105a63106ee044",
      "flags": 0,
      "text": "きみと　[VAR POKNAME(0002)]\\nこれから　仲良くなって　いきそうだ\\r\\nそれじゃ　もらえないよなぁ……"
    },
    {
      "index": 6,
      "id": "msg_t003r0102_fat_01_03",
      "hash": "66105b63106ee1f7",
      "flags": 0,
      "text": "きみの　[VAR POKNAME(0002)]……\\nいや　そんなに　懐いてちゃ\\r\\nもらうわけには　いかないなぁ……"
    },
    {
      "index": 7,
      "id": "msg_t003r0102_tenji_01",
      "hash": "921e27ae1e5adf7e",
      "flags": 0,
      "text": "スペースシャトル"
    },
    {
      "index": 8,
      "id": "msg_t003r0102_tenji_02",
      "hash": "921e26ae1e5addcb",
      "flags": 0,
      "text": "お月見山に　落下した　物体\\n多分……　つきのいし"
    },
    {
      "index": 9,
      "id": "msg_t003r0102_tenji_03",
      "hash": "921e25ae1e5adc18",
      "flags": 0,
      "text": "『宇宙の　地図』　と\\n書かれた　３Ｄホログラム　だ！"
    },
    {
      "index": 10,
      "id": "msg_t003r0102_tenji_04",
      "hash": "921e2cae1e5ae7fd",
      "flags": 0,
      "text": "いんせきの　かけら"
    },
    {
      "index": 11,
      "id": "msg_t003r0102_tenji_05",
      "hash": "921e2bae1e5ae64a",
      "flags": 0,
      "text": "宇宙の　なりたち"
    },
    {
      "index": 12,
      "id": "msg_t003r0102_bg_01",
      "hash": "1bd115a03a3feafd",
      "flags": 0,
      "text": "順路"
    },
    {
      "index": 13,
      "id": "msg_t003r0102_bg_02",
      "hash": "1bd112a03a3fe5e4",
      "flags": 0,
      "text": "顕微鏡を　のぞいたら\\nきれいな　結晶が　見えた！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t003r0102_max",
      "hash": "593271a4df38e148"
    }
  ]
}
