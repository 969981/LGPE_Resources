{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub055_rocket_F_01",
      "hash": "5498d5667fefd771",
      "flags": 0,
      "text": "シッ！　わたしは\\n潜入中の\\r\\n美人スパイよ……"
    },
    {
      "index": 1,
      "id": "msg_sub055_rocket_F_02",
      "hash": "5498d2667fefd258",
      "flags": 0,
      "text": "……あなた　みたいな　子　が\\nどうして　こんな　ところに？"
    },
    {
      "index": 2,
      "id": "msg_sub055_select_01",
      "hash": "4a4a607772b44436",
      "flags": 0,
      "text": "ロケット団を　倒しに"
    },
    {
      "index": 3,
      "id": "msg_sub055_select_02",
      "hash": "4a4a5f7772b44283",
      "flags": 0,
      "text": "なんとなく"
    },
    {
      "index": 4,
      "id": "msg_sub055_rocket_F_03",
      "hash": "5498d3667fefd40b",
      "flags": 0,
      "text": "……ふふっ！　言うわね！\\nあなた　気にいったわ！"
    },
    {
      "index": 5,
      "id": "msg_sub055_rocket_F_04",
      "hash": "5498d8667fefdc8a",
      "flags": 0,
      "text": "……ふふっ！　あなた\\nおもしろい　子　ね！"
    },
    {
      "index": 6,
      "id": "msg_sub055_rocket_F_05",
      "hash": "5498d9667fefde3d",
      "flags": 0,
      "text": "知り合えた　記念に\\nプレゼント　あげちゃうわ"
    },
    {
      "index": 7,
      "id": "msg_sub055_system_01",
      "hash": "6f29e6463da93961",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　美人スパイ　から\\n[VAR COLOR(0006)]ロケットだんセット[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 8,
      "id": "msg_sub055_system_02",
      "hash": "6f29e3463da93448",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　[VAR COLOR(0006)]ロケットだんセット[VAR COLOR(0000)]を\\nおきがえトランクに　しまった！"
    },
    {
      "index": 9,
      "id": "msg_sub055_rocket_F_06",
      "hash": "5498d6667fefd924",
      "flags": 0,
      "text": "それ　さえ　着れば\\n気分は　まるで　ロケット団よ！"
    },
    {
      "index": 10,
      "id": "msg_sub055_rocket_F_07",
      "hash": "5498d7667fefdad7",
      "flags": 0,
      "text": "……まぁ　あなたの　背丈　じゃ\\nコスプレ　だって\\r\\nすぐ　バレちゃう　だろうけど"
    },
    {
      "index": 11,
      "id": "msg_sub055_rocket_F_08",
      "hash": "5498cc667fefc826",
      "flags": 0,
      "text": "わたしが　スパイな　こと\\nもし　バラしたら……\\r\\nメッ！！　よ"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_055_max",
      "hash": "eed5f39da5c02f50"
    }
  ]
}
