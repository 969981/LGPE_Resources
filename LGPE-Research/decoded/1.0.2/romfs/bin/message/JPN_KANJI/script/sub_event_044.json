{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub044_rocketchief_01",
      "hash": "97d6c0218d7a5e3f",
      "flags": 0,
      "text": "アポロ『おまえは……"
    },
    {
      "index": 1,
      "id": "msg_sub044_rocketchief_02",
      "hash": "97d6c1218d7a5ff2",
      "flags": 0,
      "text": "いまさら\\nこんな　ところ　まで\\r\\n何を　しに　来たのですか\\c\\nおまえの　せいで\\nロケット団は……\\r\\n解散　したのですよ"
    },
    {
      "index": 2,
      "id": "msg_sub044_rocketchief_03",
      "hash": "97d6c2218d7a61a5",
      "flags": 0,
      "text": "感情的な　ふるまいは\\n私に　ふさわしく　ないが\\c\\nすこしは　気持ちを\\n受けとめて　いただき　ましょうか！"
    },
    {
      "index": 3,
      "id": "msg_sub044_rocketchief_04",
      "hash": "97d6bb218d7a55c0",
      "flags": 0,
      "text": "……　……　……\\c\\nまあ　いい"
    },
    {
      "index": 4,
      "id": "msg_sub044_rocketchief_05",
      "hash": "97d6bc218d7a5773",
      "flags": 0,
      "text": "ほんとうは……\\c\\nなんとなく　おまえが　ここに\\n来るのでは　ないかと　思い……\\c\\nちょうど　置き手紙を\\n書いて　いたのです"
    },
    {
      "index": 5,
      "id": "msg_sub044_rocketchief_09",
      "hash": "97d6c8218d7a6bd7",
      "flags": 0,
      "text": "読みましょう"
    },
    {
      "index": 6,
      "id": "msg_sub044_rocketchief_06",
      "hash": "97d6bd218d7a5926",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]　さん\\c\\nこのたびは　ポケモンリーグ\\n制覇　おめでとう　ございます\\c\\nロケット団への　仕打ちを\\n恨んでは　おりません\\c\\nむしろ　これを　ばねに\\n私は　さらに　強い\\r\\nロケット団を　作り\\r\\nいつか　全国に　むけて\\r\\n復活宣言を　します\\c\\n私は　カントー地方を\\n離れますが\\r\\nあなたは　いつまでも\\r\\nここで　ご活躍　ください\\c\\nさらばです\\n　　　　　　　　　　アポロ"
    },
    {
      "index": 7,
      "id": "msg_sub044_rocketchief_07",
      "hash": "97d6be218d7a5ad9",
      "flags": 0,
      "text": "アポロ『こんな物を　書いて\\nおまえに　どう　思って\\r\\nもらいたかった　のか……\\r\\nフフ……"
    },
    {
      "index": 8,
      "id": "msg_sub044_system_01",
      "hash": "9119a07e78e55947",
      "flags": 0,
      "text": "アポロは　置き手紙を\\n破いて　しまった"
    },
    {
      "index": 9,
      "id": "msg_sub044_rocketchief_08",
      "hash": "97d6c7218d7a6a24",
      "flags": 0,
      "text": "……お元気で"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_044_max",
      "hash": "cc9ba4ed5e08b8e2"
    }
  ]
}
