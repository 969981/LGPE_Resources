{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "BTR_STATE_00_01",
      "hash": "4fb031d3b2084edc",
      "flags": 0,
      "text": "[~ 0]"
    },
    {
      "index": 1,
      "id": "BTR_STATE_00_02",
      "hash": "4fb034d3b20853f5",
      "flags": 0,
      "text": "[~ 1]"
    },
    {
      "index": 2,
      "id": "BTR_STATE_01_01",
      "hash": "7bb6bdda13718e71",
      "flags": 0,
      "text": "にほんばれ"
    },
    {
      "index": 3,
      "id": "BTR_STATE_01_02",
      "hash": "7bb6bada13718958",
      "flags": 0,
      "text": "天気が　はれ状態。\\nほのおタイプの　威力が　上がる。\\nみずタイプの　威力が　下がる。"
    },
    {
      "index": 4,
      "id": "BTR_STATE_02_01",
      "hash": "773f7dc3401fbd7e",
      "flags": 0,
      "text": "あめ"
    },
    {
      "index": 5,
      "id": "BTR_STATE_02_02",
      "hash": "773f7cc3401fbbcb",
      "flags": 0,
      "text": "天気が　あめ状態。\\nみずタイプの　威力が　上がる。\\nほのおタイプの　威力が　下がる。"
    },
    {
      "index": 6,
      "id": "BTR_STATE_03_01",
      "hash": "7a2e29c8689f9193",
      "flags": 0,
      "text": "すなあらし"
    },
    {
      "index": 7,
      "id": "BTR_STATE_03_02",
      "hash": "7a2e2ac8689f9346",
      "flags": 0,
      "text": "天気が　すなあらし状態。\\nいわ　じめん　はがねタイプ以外は\\n毎ターン　ダメージを　受ける。\\nいわタイプの　とくぼうが　強くなる。"
    },
    {
      "index": 8,
      "id": "BTR_STATE_04_01",
      "hash": "4a11a9b05a3879c0",
      "flags": 0,
      "text": "あられ"
    },
    {
      "index": 9,
      "id": "BTR_STATE_04_02",
      "hash": "4a11acb05a387ed9",
      "flags": 0,
      "text": "天気が　あられ状態。\\nこおりタイプ以外は\\n毎ターン　ダメージを　受ける。"
    },
    {
      "index": 10,
      "id": "BTR_STATE_05_01",
      "hash": "a1bdf5b7f6b7d9b5",
      "flags": 0,
      "text": "エレキフィールド"
    },
    {
      "index": 11,
      "id": "BTR_STATE_05_02",
      "hash": "a1bdf2b7f6b7d49c",
      "flags": 0,
      "text": "５ターンの間　地面に　いる\\nポケモンは　ねむり状態に\\nならない。\\nでんきタイプの　威力が　上がる。"
    },
    {
      "index": 12,
      "id": "BTR_STATE_06_01",
      "hash": "7354759fe9c25662",
      "flags": 0,
      "text": "グラスフィールド"
    },
    {
      "index": 13,
      "id": "BTR_STATE_06_02",
      "hash": "7354749fe9c254af",
      "flags": 0,
      "text": "５ターンの間　地面に　いる\\nポケモンは　少しずつ　ＨＰが\\n回復する。\\nくさタイプの　威力が　上がる。"
    },
    {
      "index": 14,
      "id": "BTR_STATE_07_01",
      "hash": "1e0ac1a9f8ce9dd7",
      "flags": 0,
      "text": "ミストフィールド"
    },
    {
      "index": 15,
      "id": "BTR_STATE_07_02",
      "hash": "1e0ac2a9f8ce9f8a",
      "flags": 0,
      "text": "５ターンの間　地面に　いる\\nポケモンは　状態異常に　ならない。\\nドラゴンタイプの　技の　ダメージも\\n半分になる。"
    },
    {
      "index": 16,
      "id": "BTR_STATE_08_01",
      "hash": "da8a0216b2928334",
      "flags": 0,
      "text": "トリックルーム"
    },
    {
      "index": 17,
      "id": "BTR_STATE_08_02",
      "hash": "da8a0516b292884d",
      "flags": 0,
      "text": "５ターンの間　すばやさの\\n遅い　ポケモンから\\n行動　できる。"
    },
    {
      "index": 18,
      "id": "BTR_STATE_09_01",
      "hash": "dbc52e1bd99fe949",
      "flags": 0,
      "text": "マジックルーム"
    },
    {
      "index": 19,
      "id": "BTR_STATE_09_02",
      "hash": "dbc52b1bd99fe430",
      "flags": 0,
      "text": "５ターンの間　持ち物が\\n使えなくなる。"
    },
    {
      "index": 20,
      "id": "BTR_STATE_10_01",
      "hash": "c03652089e1b28bf",
      "flags": 0,
      "text": "ワンダールーム"
    },
    {
      "index": 21,
      "id": "BTR_STATE_10_02",
      "hash": "c03653089e1b2a72",
      "flags": 0,
      "text": "５ターンの間　ポケモンの\\nぼうぎょと　とくぼうが　入れ替わる。"
    },
    {
      "index": 22,
      "id": "BTR_STATE_11_01",
      "hash": "136025fe8d40b14a",
      "flags": 0,
      "text": "きゅうしょアップ"
    },
    {
      "index": 23,
      "id": "BTR_STATE_11_02",
      "hash": "136024fe8d40af97",
      "flags": 0,
      "text": "相手の　急所に\\n当たる　率が　高くなる。"
    },
    {
      "index": 24,
      "id": "BTR_STATE_12_01",
      "hash": "c152661a48912d3d",
      "flags": 0,
      "text": "こんらん"
    },
    {
      "index": 25,
      "id": "BTR_STATE_12_02",
      "hash": "c152631a48912824",
      "flags": 0,
      "text": "１－４ターンの間　自分を\\n攻撃　することが　ある。"
    },
    {
      "index": 26,
      "id": "BTR_STATE_13_01",
      "hash": "ebd0da0eff2942a8",
      "flags": 0,
      "text": "メロメロ"
    },
    {
      "index": 27,
      "id": "BTR_STATE_13_02",
      "hash": "ebd0dd0eff2947c1",
      "flags": 0,
      "text": "♂なら♀に　♀なら♂に\\n攻撃が　しにくくなる。"
    },
    {
      "index": 28,
      "id": "BTR_STATE_14_01",
      "hash": "45059a28467a691b",
      "flags": 0,
      "text": "あくむ"
    },
    {
      "index": 29,
      "id": "BTR_STATE_14_02",
      "hash": "45059b28467a6ace",
      "flags": 0,
      "text": "寝ている間　毎ターン\\nＨＰが　へる。"
    },
    {
      "index": 30,
      "id": "BTR_STATE_15_01",
      "hash": "18fe8e21e5105006",
      "flags": 0,
      "text": "ねむけ"
    },
    {
      "index": 31,
      "id": "BTR_STATE_15_02",
      "hash": "18fe8d21e5104e53",
      "flags": 0,
      "text": "技を　受けた　次の　ターン\\nねむり状態に　なる。"
    },
    {
      "index": 32,
      "id": "BTR_STATE_16_01",
      "hash": "1d75ce38b86220f9",
      "flags": 0,
      "text": "アンコール"
    },
    {
      "index": 33,
      "id": "BTR_STATE_16_02",
      "hash": "1d75cb38b8621be0",
      "flags": 0,
      "text": "アンコールを　受けると\\n３回　[VAR MOVE(0000)]しか\\n使えなくなる。"
    },
    {
      "index": 34,
      "id": "BTR_STATE_17_01",
      "hash": "f028623255e2a224",
      "flags": 0,
      "text": "とくせいなし"
    },
    {
      "index": 35,
      "id": "BTR_STATE_17_02",
      "hash": "f028653255e2a73d",
      "flags": 0,
      "text": "とくせいが　消えて\\n効果が　なくなる。"
    },
    {
      "index": 36,
      "id": "BTR_STATE_18_01",
      "hash": "5fbb61c6d790d587",
      "flags": 0,
      "text": "いちゃもん"
    },
    {
      "index": 37,
      "id": "BTR_STATE_18_02",
      "hash": "5fbb62c6d790d73a",
      "flags": 0,
      "text": "同じ技が　続けて　出せない。"
    },
    {
      "index": 38,
      "id": "BTR_STATE_19_01",
      "hash": "88f355bb8d134ed2",
      "flags": 0,
      "text": "おいかぜ"
    },
    {
      "index": 39,
      "id": "BTR_STATE_19_02",
      "hash": "88f354bb8d134d1f",
      "flags": 0,
      "text": "４ターンの間　戦闘に　出ている\\nポケモンのすばやさが　２倍になる。"
    },
    {
      "index": 40,
      "id": "BTR_STATE_20_01",
      "hash": "6f0ff569da3dc0c2",
      "flags": 0,
      "text": "おまじない"
    },
    {
      "index": 41,
      "id": "BTR_STATE_20_02",
      "hash": "6f0ff469da3dbf0f",
      "flags": 0,
      "text": "相手の　技が\\n急所に　当たらなくなる。"
    },
    {
      "index": 42,
      "id": "BTR_STATE_21_01",
      "hash": "c6bbc17176bc4737",
      "flags": 0,
      "text": "おんねん"
    },
    {
      "index": 43,
      "id": "BTR_STATE_21_02",
      "hash": "c6bbc27176bc48ea",
      "flags": 0,
      "text": "相手の　技で　ひんしに　されたとき\\nその技の　ＰＰを　０に　する。"
    },
    {
      "index": 44,
      "id": "BTR_STATE_22_01",
      "hash": "f2c2a977d8262320",
      "flags": 0,
      "text": "かいふくふうじ"
    },
    {
      "index": 45,
      "id": "BTR_STATE_22_02",
      "hash": "f2c2ac77d8262839",
      "flags": 0,
      "text": "５ターンの間　技や　特性や\\n持っている　道具に　よって\\nＨＰを　回復できない。\\n"
    },
    {
      "index": 46,
      "id": "BTR_STATE_23_01",
      "hash": "9d78f581e7326a95",
      "flags": 0,
      "text": "みやぶられている"
    },
    {
      "index": 47,
      "id": "BTR_STATE_23_02",
      "hash": "9d78f281e732657c",
      "flags": 0,
      "text": "特定の　効果が　なかった\\n技が　当たる　ようになる。\\n回避率アップの　効果は\\n無視されて　攻撃を　受ける。"
    },
    {
      "index": 48,
      "id": "BTR_STATE_24_01",
      "hash": "cb32fd884a0e115e",
      "flags": 0,
      "text": "かなしばり"
    },
    {
      "index": 49,
      "id": "BTR_STATE_24_02",
      "hash": "cb32fc884a0e0fab",
      "flags": 0,
      "text": "４ターンの間\\n[VAR MOVE(0000)]が\\n使えなくなる。"
    },
    {
      "index": 50,
      "id": "BTR_STATE_25_01",
      "hash": "212ba98fe51accf3",
      "flags": 0,
      "text": "にげられない"
    },
    {
      "index": 51,
      "id": "BTR_STATE_25_02",
      "hash": "212baa8fe51acea6",
      "flags": 0,
      "text": "逃げたり　交代することが\\nできない。"
    },
    {
      "index": 52,
      "id": "BTR_STATE_26_01",
      "hash": "f6adb19b2e838a3c",
      "flags": 0,
      "text": "ロックオン"
    },
    {
      "index": 53,
      "id": "BTR_STATE_26_02",
      "hash": "f6adb49b2e838f55",
      "flags": 0,
      "text": "ロックオンした　次の　ターン\\n技が　必ず　当たる。"
    },
    {
      "index": 54,
      "id": "BTR_STATE_27_01",
      "hash": "2467bda1915f37d1",
      "flags": 0,
      "text": "さしおさえ"
    },
    {
      "index": 55,
      "id": "BTR_STATE_27_02",
      "hash": "2467baa1915f32b8",
      "flags": 0,
      "text": "５ターンの間　持ち物や\\nどうぐが　使えなくなる。"
    },
    {
      "index": 56,
      "id": "BTR_STATE_28_01",
      "hash": "cf1e05aba06b787a",
      "flags": 0,
      "text": "じゅうでん"
    },
    {
      "index": 57,
      "id": "BTR_STATE_28_02",
      "hash": "cf1e04aba06b76c7",
      "flags": 0,
      "text": "じゅうでんした　次の　ターンは\\nでんきタイプの　威力が　２倍になる。"
    },
    {
      "index": 58,
      "id": "BTR_STATE_29_01",
      "hash": "fb24f1b201d55b2f",
      "flags": 0,
      "text": "じゅうりょく"
    },
    {
      "index": 59,
      "id": "BTR_STATE_29_02",
      "hash": "fb24f2b201d55ce2",
      "flags": 0,
      "text": "５ターンの間　技が\\n当たりやすくなる。\\nふゆうや　ひこうタイプに\\nじめん技が　当たる。\\n空中に　飛ぶ技が　使えない。"
    },
    {
      "index": 60,
      "id": "BTR_STATE_30_01",
      "hash": "df29959ec5f4a245",
      "flags": 0,
      "text": "しろいきり"
    },
    {
      "index": 61,
      "id": "BTR_STATE_30_02",
      "hash": "df29929ec5f49d2c",
      "flags": 0,
      "text": "５ターンの間　能力を\\n下げられない。"
    },
    {
      "index": 62,
      "id": "BTR_STATE_31_01",
      "hash": "0a1489937ce8b010",
      "flags": 0,
      "text": "しんぴのまもり"
    },
    {
      "index": 63,
      "id": "BTR_STATE_31_02",
      "hash": "0a148c937ce8b529",
      "flags": 0,
      "text": "５ターンの間\\n状態異常に　ならない。"
    },
    {
      "index": 64,
      "id": "BTR_STATE_32_01",
      "hash": "06b9618e540cea67",
      "flags": 0,
      "text": "ステルスロック"
    },
    {
      "index": 65,
      "id": "BTR_STATE_32_02",
      "hash": "06b9628e540cec1a",
      "flags": 0,
      "text": "入れ替わった　ポケモンに\\nダメージを　与える。"
    },
    {
      "index": 66,
      "id": "BTR_STATE_33_01",
      "hash": "31a3d5830b001eb2",
      "flags": 0,
      "text": "たくわえる"
    },
    {
      "index": 67,
      "id": "BTR_STATE_33_02",
      "hash": "31a3d4830b001cff",
      "flags": 0,
      "text": "たくわえている間\\nぼうぎょと　とくぼうが　上がる。"
    },
    {
      "index": 68,
      "id": "BTR_STATE_34_01",
      "hash": "3a069dbd34b03041",
      "flags": 0,
      "text": "ちょうはつ"
    },
    {
      "index": 69,
      "id": "BTR_STATE_34_02",
      "hash": "3a069abd34b02b28",
      "flags": 0,
      "text": "ダメージを　与える　技しか\\n出せなくなる。"
    },
    {
      "index": 70,
      "id": "BTR_STATE_35_01",
      "hash": "385e51b80d45c1ec",
      "flags": 0,
      "text": "テレキネシス"
    },
    {
      "index": 71,
      "id": "BTR_STATE_35_02",
      "hash": "385e54b80d45c705",
      "flags": 0,
      "text": "３ターンの間\\n一撃必殺　以外の　技が\\n必ず　当たる。\\nじめんタイプの　技が\\n当たらなくなる。"
    },
    {
      "index": 72,
      "id": "BTR_STATE_36_01",
      "hash": "62dc49acc3dd04a3",
      "flags": 0,
      "text": "でんじふゆう"
    },
    {
      "index": 73,
      "id": "BTR_STATE_36_02",
      "hash": "62dc4aacc3dd0656",
      "flags": 0,
      "text": "５ターンの間　じめんタイプの\\n技が　当たらなくなる。"
    },
    {
      "index": 74,
      "id": "BTR_STATE_37_01",
      "hash": "358f5da6615e5f4e",
      "flags": 0,
      "text": "どくびし"
    },
    {
      "index": 75,
      "id": "BTR_STATE_37_02",
      "hash": "358f5ca6615e5d9b",
      "flags": 0,
      "text": "入れ替わった　ポケモンを\\nどく状態にする。\\nひこうタイプや　とくせいふゆう　の\\nポケモンには　当たらない。"
    },
    {
      "index": 76,
      "id": "BTR_STATE_38_01",
      "hash": "6a0365e1c67ed69d",
      "flags": 0,
      "text": "どろあそび"
    },
    {
      "index": 77,
      "id": "BTR_STATE_38_02",
      "hash": "6a0362e1c67ed184",
      "flags": 0,
      "text": "５ターンの間\\nでんきタイプの　技の　威力が\\n半減する。"
    },
    {
      "index": 78,
      "id": "BTR_STATE_39_01",
      "hash": "948159d67d161288",
      "flags": 0,
      "text": "ねがいごと"
    },
    {
      "index": 79,
      "id": "BTR_STATE_39_02",
      "hash": "94815cd67d1617a1",
      "flags": 0,
      "text": "ねがいごとを　使った　次の\\nターンに　ＨＰが　回復する。"
    },
    {
      "index": 80,
      "id": "BTR_STATE_40_01",
      "hash": "e979a57045ab8090",
      "flags": 0,
      "text": "ねばねばネット"
    },
    {
      "index": 81,
      "id": "BTR_STATE_40_02",
      "hash": "e979a87045ab85a9",
      "flags": 0,
      "text": "交代して　出てくる　ポケモンの\\nすばやさを　下げる。"
    },
    {
      "index": 82,
      "id": "BTR_STATE_41_01",
      "hash": "be8eb17b8eb772c5",
      "flags": 0,
      "text": "ねをはる"
    },
    {
      "index": 83,
      "id": "BTR_STATE_41_02",
      "hash": "be8eae7b8eb76dac",
      "flags": 0,
      "text": "ターンの　最後に　ＨＰを\\n回復する。\\n根を　張った　ポケモンは\\n交代　できない。"
    },
    {
      "index": 84,
      "id": "BTR_STATE_42_01",
      "hash": "1108f15fd3c2ef32",
      "flags": 0,
      "text": "のろい"
    },
    {
      "index": 85,
      "id": "BTR_STATE_42_02",
      "hash": "1108f05fd3c2ed7f",
      "flags": 0,
      "text": "ターンの　最後に　ＨＰを　へらす。"
    },
    {
      "index": 86,
      "id": "BTR_STATE_43_01",
      "hash": "e61e7d6b1ccfbae7",
      "flags": 0,
      "text": "ハロウィン"
    },
    {
      "index": 87,
      "id": "BTR_STATE_43_02",
      "hash": "e61e7e6b1ccfbc9a",
      "flags": 0,
      "text": "ゴーストタイプが　追加　される。"
    },
    {
      "index": 88,
      "id": "BTR_STATE_44_01",
      "hash": "17c36d94d608926c",
      "flags": 0,
      "text": "ひかりのかべ"
    },
    {
      "index": 89,
      "id": "BTR_STATE_44_02",
      "hash": "17c37094d6089785",
      "flags": 0,
      "text": "５ターンの間\\nとくしゅこうげきで　受ける\\n威力を　半減する。"
    },
    {
      "index": 90,
      "id": "BTR_STATE_45_01",
      "hash": "196bb999fd7300c1",
      "flags": 0,
      "text": "リフレクター"
    },
    {
      "index": 91,
      "id": "BTR_STATE_45_02",
      "hash": "196bb699fd72fba8",
      "flags": 0,
      "text": "５ターンの間\\nぶつりこうげきで　受ける\\n威力を　半減する。"
    },
    {
      "index": 92,
      "id": "BTR_STATE_46_01",
      "hash": "14f479832a212fce",
      "flags": 0,
      "text": "ふういん"
    },
    {
      "index": 93,
      "id": "BTR_STATE_46_02",
      "hash": "14f478832a212e1b",
      "flags": 0,
      "text": "ふういんした　ポケモンが\\n覚えている　技を　対戦相手の\\nポケモンは　出せなくなる。"
    },
    {
      "index": 94,
      "id": "BTR_STATE_47_01",
      "hash": "424165898c9fd523",
      "flags": 0,
      "text": "ほろびのうた"
    },
    {
      "index": 95,
      "id": "BTR_STATE_47_02",
      "hash": "424166898c9fd6d6",
      "flags": 0,
      "text": "ほろびのうたを　聴いた\\nすべての　ポケモンが\\n３ターン後に　ひんしに　なる。"
    },
    {
      "index": 96,
      "id": "BTR_STATE_48_01",
      "hash": "73e675b345d8e308",
      "flags": 0,
      "text": "まきびし"
    },
    {
      "index": 97,
      "id": "BTR_STATE_48_02",
      "hash": "73e678b345d8e821",
      "flags": 0,
      "text": "入れ替わった　ポケモンに\\nダメージを　与える。\\nひこうタイプや　とくせいふゆう　の\\nポケモンには　当たらない。"
    },
    {
      "index": 98,
      "id": "BTR_STATE_49_01",
      "hash": "496881be8f41a71d",
      "flags": 0,
      "text": "みずあそび"
    },
    {
      "index": 99,
      "id": "BTR_STATE_49_02",
      "hash": "49687ebe8f41a204",
      "flags": 0,
      "text": "５ターンの間\\nほのおタイプの技の　威力が\\n半減する。"
    },
    {
      "index": 100,
      "id": "BTR_STATE_50_01",
      "hash": "599345a531626213",
      "flags": 0,
      "text": "みちづれ"
    },
    {
      "index": 101,
      "id": "BTR_STATE_50_02",
      "hash": "599346a5316263c6",
      "flags": 0,
      "text": "自分を　ひんしにさせた　相手を\\nみちづれにして　ひんしにする。"
    },
    {
      "index": 102,
      "id": "BTR_STATE_51_01",
      "hash": "56a499a008e28dfe",
      "flags": 0,
      "text": "もりののろい"
    },
    {
      "index": 103,
      "id": "BTR_STATE_51_02",
      "hash": "56a498a008e28c4b",
      "flags": 0,
      "text": "くさタイプが　追加　される。"
    },
    {
      "index": 104,
      "id": "BTR_STATE_52_01",
      "hash": "5b1bd9b6dc345ef1",
      "flags": 0,
      "text": "やどりぎのタネ"
    },
    {
      "index": 105,
      "id": "BTR_STATE_52_02",
      "hash": "5b1bd6b6dc3459d8",
      "flags": 0,
      "text": "ターンの　最後に\\nやどりぎによって　ＨＰを　奪い取られ\\n相手を　回復する。"
    },
    {
      "index": 106,
      "id": "BTR_STATE_53_01",
      "hash": "2f154db07acb1f5c",
      "flags": 0,
      "text": "ロックオン"
    },
    {
      "index": 107,
      "id": "BTR_STATE_53_02",
      "hash": "2f1550b07acb2475",
      "flags": 0,
      "text": "ロックオンした　相手に\\n技が　必ず　命中する。"
    },
    {
      "index": 108,
      "id": "BTR_STATE_54_01",
      "hash": "fd6fdd86c1916e57",
      "flags": 0,
      "text": "バインド"
    },
    {
      "index": 109,
      "id": "BTR_STATE_54_02",
      "hash": "fd6fde86c191700a",
      "flags": 0,
      "text": "しめつけられて　毎ターン\\nダメージを　受ける。"
    },
    {
      "index": 110,
      "id": "BTR_STATE_55_01",
      "hash": "52b9917cb28526e2",
      "flags": 0,
      "text": "がまん"
    },
    {
      "index": 111,
      "id": "BTR_STATE_55_02",
      "hash": "52b9907cb285252f",
      "flags": 0,
      "text": "２ターンの間\\n攻撃に　耐えて\\n受けた　ダメージを　２倍に　して\\n相手に　返す。"
    },
    {
      "index": 112,
      "id": "BTR_STATE_56_01",
      "hash": "81231194bf7aaa35",
      "flags": 0,
      "text": "げきりん"
    },
    {
      "index": 113,
      "id": "BTR_STATE_56_02",
      "hash": "81230e94bf7aa51c",
      "flags": 0,
      "text": "２ー３ターンの間\\n暴れまくって　攻撃する。\\n暴れた　後は　こんらん　する。"
    },
    {
      "index": 114,
      "id": "BTR_STATE_57_01",
      "hash": "2976c58d22fb4a40",
      "flags": 0,
      "text": "あばれる"
    },
    {
      "index": 115,
      "id": "BTR_STATE_57_02",
      "hash": "2976c88d22fb4f59",
      "flags": 0,
      "text": "２ー３ターンの間\\n暴れまくって　攻撃する。\\n暴れた　後は　こんらん　する。"
    },
    {
      "index": 116,
      "id": "BTR_STATE_58_01",
      "hash": "e2ba15e8307b01eb",
      "flags": 0,
      "text": "はなびらのまい"
    },
    {
      "index": 117,
      "id": "BTR_STATE_58_02",
      "hash": "e2ba16e8307b039e",
      "flags": 0,
      "text": "２ー３ターンの間\\n暴れまくって　攻撃する。\\n暴れた　後は　こんらん　する。"
    },
    {
      "index": 118,
      "id": "BTR_STATE_59_01",
      "hash": "8c5449e095113e16",
      "flags": 0,
      "text": "もうどく"
    },
    {
      "index": 119,
      "id": "BTR_STATE_59_02",
      "hash": "8c5448e095113c63",
      "flags": 0,
      "text": "もうどく状態。\\nターンが　進むほど\\nどくの　ダメージが　増えていく。"
    },
    {
      "index": 120,
      "id": "BTR_STATE_60_01",
      "hash": "5d592a13a8f43f36",
      "flags": 0,
      "text": "みらいにこうげき"
    },
    {
      "index": 121,
      "id": "BTR_STATE_60_02",
      "hash": "5d592913a8f43d83",
      "flags": 0,
      "text": "技を　使われた　２ターン\\n後に　ダメージを　受ける。"
    },
    {
      "index": 122,
      "id": "BTR_STATE_61_01",
      "hash": "5f00f618d05dd40b",
      "flags": 0,
      "text": "さわぐ"
    },
    {
      "index": 123,
      "id": "BTR_STATE_61_02",
      "hash": "5f00f718d05dd5be",
      "flags": 0,
      "text": "３ターンの間　騒いで\\n相手を　攻撃する。\\nその間は\\n誰も　眠れなくなる。"
    },
    {
      "index": 124,
      "id": "BTR_STATE_62_01",
      "hash": "3482fe2419c69154",
      "flags": 0,
      "text": "アクアリング"
    },
    {
      "index": 125,
      "id": "BTR_STATE_62_02",
      "hash": "3483012419c6966d",
      "flags": 0,
      "text": "自分の　からだの　周りを\\n水で　作った　ベールで　覆う。\\n毎ターン　ＨＰを　回復する。"
    },
    {
      "index": 126,
      "id": "BTR_STATE_63_01",
      "hash": "8c2f2a2bb645bae9",
      "flags": 0,
      "text": "ボディパージ"
    },
    {
      "index": 127,
      "id": "BTR_STATE_63_02",
      "hash": "8c2f272bb645b5d0",
      "flags": 0,
      "text": "すばやさが　ぐーんと　上がり\\n体重も　軽くなる。"
    },
    {
      "index": 128,
      "id": "BTR_STATE_64_01",
      "hash": "2d5c01ef1724f5ba",
      "flags": 0,
      "text": "うちおとす"
    },
    {
      "index": 129,
      "id": "BTR_STATE_64_02",
      "hash": "2d5c00ef1724f407",
      "flags": 0,
      "text": "打ち落とされて　地面に\\n落ちた　状態。"
    },
    {
      "index": 130,
      "id": "BTR_STATE_65_01",
      "hash": "02ddedfa608d836f",
      "flags": 0,
      "text": "フェアリーロック"
    },
    {
      "index": 131,
      "id": "BTR_STATE_65_02",
      "hash": "02ddeefa608d8522",
      "flags": 0,
      "text": "技を　使った　次の　ターンは\\nすべての　ポケモンが　逃げられない。"
    },
    {
      "index": 132,
      "id": "BTR_STATE_66_01",
      "hash": "5a89b601fd0c0318",
      "flags": 0,
      "text": "にじ"
    },
    {
      "index": 133,
      "id": "BTR_STATE_66_02",
      "hash": "5a89b901fd0c0831",
      "flags": 0,
      "text": "技の　追加効果が\\nでやすくなる。"
    },
    {
      "index": 134,
      "id": "BTR_STATE_67_01",
      "hash": "8690c2085e761c2d",
      "flags": 0,
      "text": "しつげん"
    },
    {
      "index": 135,
      "id": "BTR_STATE_67_02",
      "hash": "8690bf085e761714",
      "flags": 0,
      "text": "すばやさが　１／４　になってしまう。"
    },
    {
      "index": 136,
      "id": "BTR_STATE_68_01",
      "hash": "d2ebf9d0a8c6399e",
      "flags": 0,
      "text": "ひのうみ"
    },
    {
      "index": 137,
      "id": "BTR_STATE_68_02",
      "hash": "d2ebf8d0a8c637eb",
      "flags": 0,
      "text": "ほのおタイプの　ポケモン　以外は\\n毎ターン　ダメージを　受ける。"
    },
    {
      "index": 138,
      "id": "BTR_STATE_69_01",
      "hash": "28e4a5d843d2f533",
      "flags": 0,
      "text": "おおひでり"
    },
    {
      "index": 139,
      "id": "BTR_STATE_69_02",
      "hash": "28e4a6d843d2f6e6",
      "flags": 0,
      "text": "天気が　おおひでり状態。\\nほのおタイプの　威力が　上がる。\\nみずタイプの　技を　受けない。"
    },
    {
      "index": 140,
      "id": "BTR_STATE_70_01",
      "hash": "cc2c4a4893958499",
      "flags": 0,
      "text": "おおあめ"
    },
    {
      "index": 141,
      "id": "BTR_STATE_70_02",
      "hash": "cc2c474893957f80",
      "flags": 0,
      "text": "天気が　おおあめ状態。\\nみずタイプの　威力が　上がる。\\nほのおタイプの　技を　受けない。"
    },
    {
      "index": 142,
      "id": "BTR_STATE_71_01",
      "hash": "f7175e3d4a89c8c4",
      "flags": 0,
      "text": "らんきりゅう"
    },
    {
      "index": 143,
      "id": "BTR_STATE_71_02",
      "hash": "f717613d4a89cddd",
      "flags": 0,
      "text": "天気が　らんきりゅう状態。\\nひこうに　対して　バツグンの\\nタイプの　威力が　弱まる。"
    },
    {
      "index": 144,
      "id": "BTR_STATE_72_01",
      "hash": "a0b19635af200bbb",
      "flags": 0,
      "text": "サイコフィールド"
    },
    {
      "index": 145,
      "id": "BTR_STATE_72_02",
      "hash": "a0b19735af200d6e",
      "flags": 0,
      "text": "５ターンの間　地面に　いる\\nポケモンは　先制技を　受けない。\\nエスパータイプの　威力が　上がる。"
    },
    {
      "index": 146,
      "id": "BTR_STATE_73_01",
      "hash": "72f78a2f4c445e26",
      "flags": 0,
      "text": "じごくづき"
    },
    {
      "index": 147,
      "id": "BTR_STATE_73_02",
      "hash": "72f7892f4c445c73",
      "flags": 0,
      "text": "２ターンの間\\n音を　出す　技が　出せない。"
    },
    {
      "index": 148,
      "id": "BTR_STATE_74_01",
      "hash": "c84162253d3853dd",
      "flags": 0,
      "text": "オーロラベール"
    },
    {
      "index": 149,
      "id": "BTR_STATE_74_02",
      "hash": "c8415f253d384ec4",
      "flags": 0,
      "text": "５ターンの間\\nぶつりと　とくしゅの　威力を\\n半減する。"
    },
    {
      "index": 150,
      "id": "BTR_STATE_75_01",
      "hash": "9c3a561edbce3ac8",
      "flags": 0,
      "text": "とぎすます"
    },
    {
      "index": 151,
      "id": "BTR_STATE_75_02",
      "hash": "9c3a591edbce3fe1",
      "flags": 0,
      "text": "とぎすますを　使った　次の\\nターンは　技が　必ず\\n急所に　当たる。"
    },
    {
      "index": 152,
      "id": "BTR_STATE_76_01",
      "hash": "c5724e139150badf",
      "flags": 0,
      "text": "[~ 152]"
    },
    {
      "index": 153,
      "id": "BTR_STATE_76_02",
      "hash": "c5724f139150bc92",
      "flags": 0,
      "text": "[~ 153]"
    },
    {
      "index": 154,
      "id": "BTR_STATE_77_01",
      "hash": "6f0ca20bf5e72d6a",
      "flags": 0,
      "text": "[~ 154]"
    },
    {
      "index": 155,
      "id": "BTR_STATE_77_02",
      "hash": "6f0ca10bf5e72bb7",
      "flags": 0,
      "text": "[~ 155]"
    },
    {
      "index": 156,
