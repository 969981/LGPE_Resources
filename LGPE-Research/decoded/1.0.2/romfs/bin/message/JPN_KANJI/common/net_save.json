  "lines": [
    {
      "index": 0,
      "id": "net_save_win_01",
      "hash": "eeefe4d96acc1c25",
      "flags": 0,
      "text": "レポートを　書いています\\nしばらく　お待ちください"
    },
    {
      "index": 1,
      "id": "net_save_win_02",
      "hash": "eeefe1d96acc170c",
      "flags": 0,
      "text": "ご注意！\\n\\nポケモン交換を　している途中で\\n通信エラーや　本体の\\n電源が　切れると\\nしばらく　ポケモン交換が\\nできなくなります"
    },
    {
      "index": 2,
      "id": "net_save_win_03",
      "hash": "eeefe2d96acc18bf",
      "flags": 0,
      "text": "通信待機中です\\nしばらく　お待ちください"
    },
    {
      "index": 3,
      "id": "net_save_win_04",
      "hash": "eeefdfd96acc13a6",
      "flags": 0,
      "text": "交換を\\n終了しますか？"
    },
    {
      "index": 4,
      "id": "net_save_sel_01",
      "hash": "0bb15cc36812039f",
      "flags": 0,
      "text": "はい"
    },
    {
      "index": 5,
      "id": "net_save_sel_02",
      "hash": "0bb15dc368120552",
      "flags": 0,
      "text": "いいえ"
    },
    {
      "index": 6,
      "id": "net_save_sel_03",
      "hash": "0bb15ec368120705",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 7,
      "id": "net_save_win_05",
      "hash": "eeefe0d96acc1559",
      "flags": 0,
      "text": "終了が　選ばれました\\n交換を　終りにします"
    }
  ],
