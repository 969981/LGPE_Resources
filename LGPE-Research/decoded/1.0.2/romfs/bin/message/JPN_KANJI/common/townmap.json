    },
    {
      "index": 2,
      "id": "TOWNMAP_01_01",
      "hash": "adebed59f5f814d9",
      "flags": 0,
      "text": "ソラワタリ"
    },
    {
      "index": 3,
      "id": "TOWNMAP_01_02",
      "hash": "adebea59f5f80fc0",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 4,
      "id": "TOWNMAP_01_03",
      "hash": "adebeb59f5f81173",
      "flags": 0,
      "text": "ポケモンきりかえ"
    },
    {
      "index": 5,
      "id": "TOWNMAP_02_01",
      "hash": "54b72d40aea6ee66",
      "flags": 0,
      "text": "← → ポケモンきりかえ"
    },
    {
      "index": 6,
      "id": "TOWNMAP_05_01",
      "hash": "537c053b87998f1d",
      "flags": 0,
      "text": "ヒジュツ・ソラワタリで\\n[VAR LOCATION(0000)]へ　飛びますか？"
    },
    {
      "index": 7,
      "id": "TOWNMAP_05_02",
      "hash": "537c023b87998a04",
      "flags": 0,
      "text": "はい"
    },
    {
      "index": 8,
      "id": "TOWNMAP_05_03",
      "hash": "537c033b87998bb7",
      "flags": 0,
      "text": "いいえ"
    },
    {
      "index": 9,
      "id": "TOWNMAP_10_01",
      "hash": "c7de207c7f324b27",
      "flags": 0,
      "text": "[VAR LOCATION(0000)]"
    },
    {
      "index": 10,
      "id": "TOWNMAP_20_01",
      "hash": "9e9ac914d7a1ec8a",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]の　すみか"
    },
    {
      "index": 11,
      "id": "TOWNMAP_20_02",
      "hash": "9e9ac814d7a1ead7",
      "flags": 0,
      "text": "生息地　不明"
    },
    {
      "index": 12,
      "id": "TM_GUIDE_01",
      "hash": "de793f7747865099",
      "flags": 0,
      "text": "草木が　豊かに　生い茂る\\nのんびり　ムードの　いなか道。"
    },
    {
      "index": 13,
      "id": "TM_GUIDE_02",
      "hash": "de793c7747864b80",
      "flags": 0,
      "text": "トキワの森　から　つながる\\n段差の　多い　道。"
    },
    {
      "index": 14,
      "id": "TM_GUIDE_03",
      "hash": "de793d7747864d33",
      "flags": 0,
      "text": "山が　近く　ところどころ\\n大岩が　落ちている　草道。"
    },
    {
      "index": 15,
      "id": "TM_GUIDE_04",
      "hash": "de794277478655b2",
      "flags": 0,
      "text": "お月見山へと　続く　坂道。\\nハナダ側に　おりると　戻れない。"
    },
    {
      "index": 16,
      "id": "TM_GUIDE_05",
      "hash": "de79437747865765",
      "flags": 0,
      "text": "ゆるやかな　坂道。\\n地下通路の　入り口が　ある。"
    },
    {
      "index": 17,
      "id": "TM_GUIDE_06",
      "hash": "de7940774786524c",
      "flags": 0,
      "text": "クチバと　ヤマブキを　つなぐ道。\\n地下通路の　入り口が　ある。"
    },
    {
      "index": 18,
      "id": "TM_GUIDE_07",
      "hash": "de794177478653ff",
      "flags": 0,
      "text": "８番道路　への　地下通路の\\n入り口が　ある　短い道。"
    },
    {
      "index": 19,
      "id": "TM_GUIDE_08",
      "hash": "de79467747865c7e",
      "flags": 0,
      "text": "７番道路　への　地下通路の\\n入り口が　ある　短い道。"
    },
    {
      "index": 20,
      "id": "TM_GUIDE_09",
      "hash": "de79477747865e31",
      "flags": 0,
      "text": "段差が　多く　子供の\\n遊び場にも　なっている　道。"
    },
    {
      "index": 21,
      "id": "TM_GUIDE_10",
      "hash": "de7cc4774789686f",
      "flags": 0,
      "text": "イワヤマトンネルの　入り口が\\nある　運河沿いの　道。"
    },
    {
      "index": 22,
      "id": "TM_GUIDE_11",
      "hash": "de7cc377478966bc",
      "flags": 0,
      "text": "トレーナーで　にぎわう　草地。\\nディグダの穴の　入り口が　ある。"
    },
    {
      "index": 23,
      "id": "TM_GUIDE_12",
      "hash": "de7cc67747896bd5",
      "flags": 0,
      "text": "釣り人が　集まる　桟橋。\\nサイレンズブリッジと　呼ばれる。"
    },
    {
      "index": 24,
      "id": "TM_GUIDE_13",
      "hash": "de7cc57747896a22",
      "flags": 0,
      "text": "海沿いの　爽やかな　道。\\n一部　迷路に　なっている。"
    },
    {
      "index": 25,
      "id": "TM_GUIDE_14",
      "hash": "de7cc077478961a3",
      "flags": 0,
      "text": "潮風の　香りが　心地よい\\n海辺の　広い　並木道。"
    },
    {
      "index": 26,
      "id": "TM_GUIDE_15",
      "hash": "de7cbf7747895ff0",
      "flags": 0,
      "text": "セキチクの　東に　のびる\\n長く　まっすぐな　草道。"
    },
    {
      "index": 27,
      "id": "TM_GUIDE_16",
      "hash": "de7cc27747896509",
      "flags": 0,
      "text": "ポケモンロードの　北側。\\nいつも　にぎやかな　道。"
    },
    {
      "index": 28,
      "id": "TM_GUIDE_17",
      "hash": "de7cc17747896356",
      "flags": 0,
      "text": "ポケモンと　トレーナーが　散歩を\\n楽しめる　ポケモンロード。"
    },
    {
      "index": 29,
      "id": "TM_GUIDE_18",
      "hash": "de7ccc7747897607",
      "flags": 0,
      "text": "ポケモンロードの　南側。\\n勝負を　楽しむ　トレーナーも。"
    },
    {
      "index": 30,
      "id": "TM_GUIDE_19",
      "hash": "de7ccb7747897454",
      "flags": 0,
      "text": "人気の　水泳スポット。\\nビーチで　日光浴も　できる。"
    },
    {
      "index": 31,
      "id": "TM_GUIDE_20",
      "hash": "de72d27747812bb4",
      "flags": 0,
      "text": "中央に　浮かぶ　双子島で\\n東西に　分けられた　海。"
    },
    {
      "index": 32,
      "id": "TM_GUIDE_21",
      "hash": "de72d37747812d67",
      "flags": 0,
      "text": "火山の　影響で　比較的\\n水温の　高い　海の道。"
    },
    {
      "index": 33,
      "id": "TM_GUIDE_22",
      "hash": "de72d47747812f1a",
      "flags": 0,
      "text": "ポケモンリーグに　続く\\nまっすぐに　舗装された　道。"
    },
    {
      "index": 34,
      "id": "TM_GUIDE_23",
      "hash": "de72d577478130cd",
      "flags": 0,
      "text": "強い　トレーナーのみ\\n通ることを　許された　山道。"
    },
    {
      "index": 35,
      "id": "TM_GUIDE_24",
      "hash": "de72ce77478124e8",
      "flags": 0,
      "text": "ハナダの　北。　水路に　かかる\\n金ぴかの　橋が　有名。"
    },
    {
      "index": 36,
      "id": "TM_GUIDE_25",
      "hash": "de72cf774781269b",
      "flags": 0,
      "text": "植木で　作られた　迷路が\\n岬へと　続く　道。"
    },
    {
      "index": 37,
      "id": "TM_GUIDE_26",
      "hash": "de72d0774781284e",
      "flags": 0,
      "text": "小さな　いなか町。\\nポケモン研究所が　ある。"
    },
    {
      "index": 38,
      "id": "TM_GUIDE_27",
      "hash": "de72d17747812a01",
      "flags": 0,
      "text": "一年中　花が　咲く\\n自然を　愛する　町。"
    },
    {
      "index": 39,
      "id": "TM_GUIDE_28",
      "hash": "de72ca7747811e1c",
      "flags": 0,
      "text": "大きな岩で　できた　山の\\nふもとに　広がる　石の街。"
    },
    {
      "index": 40,
      "id": "TM_GUIDE_29",
      "hash": "de72cb7747811fcf",
      "flags": 0,
      "text": "水路に　囲まれ　みずタイプの\\nジムもある　水が　豊富な　街。"
    },
    {
      "index": 41,
      "id": "TM_GUIDE_30",
      "hash": "de75d87747836bbd",
      "flags": 0,
      "text": "ポケモンの　お墓が　ある\\n静かで　荘厳な　町。"
    },
    {
      "index": 42,
      "id": "TM_GUIDE_31",
      "hash": "de75d77747836a0a",
      "flags": 0,
      "text": "豪華客船も　やってくる\\n国際的な　港町。"
    },
    {
      "index": 43,
      "id": "TM_GUIDE_32",
      "hash": "de75d67747836857",
      "flags": 0,
      "text": "さまざまな　年代の　人が\\n暮らす　街。　デパートが　ある。"
    },
    {
      "index": 44,
      "id": "TM_GUIDE_33",
      "hash": "de75d577478366a4",
      "flags": 0,
      "text": "サファリゾーンが　あり　沢山の\\nポケモンと　人が　集う町。"
    },
    {
      "index": 45,
      "id": "TM_GUIDE_34",
      "hash": "de75d477478364f1",
      "flags": 0,
      "text": "火山島に　出来た　町。\\n廃墟と　なった　屋敷がある。"
    },
    {
      "index": 46,
      "id": "TM_GUIDE_35",
      "hash": "de75d3774783633e",
      "flags": 0,
      "text": "最高機関　ポケモンリーグ本部が\\nそびえ立つ　高原。"
    },
    {
      "index": 47,
      "id": "TM_GUIDE_36",
      "hash": "de75d2774783618b",
      "flags": 0,
      "text": "高層ビルが　そびえ立つ\\nカントー地方　いちの　都会。"
    },
    {
      "index": 48,
      "id": "TM_GUIDE_37",
      "hash": "de75d17747835fd8",
      "flags": 0,
      "text": "むしポケモンが　沢山　見つかる\\n深くて　大きい　森。"
    },
    {
      "index": 49,
      "id": "TM_GUIDE_38",
      "hash": "de75d07747835e25",
      "flags": 0,
      "text": "流れ星が　落ちる　山。\\nカセキが　見つかることが　ある。"
    },
    {
      "index": 50,
      "id": "TM_GUIDE_39",
      "hash": "de75cf7747835c72",
      "flags": 0,
      "text": "天然の　大きい　トンネル。\\n真っ暗で　明かりが　必需品。"
    },
    {
      "index": 51,
      "id": "TM_GUIDE_40",
      "hash": "de6bc677477af8a2",
      "flags": 0,
      "text": "でんきタイプの　ポケモンが　生息\\nする　機械が　いっぱいの　施設。"
    },
    {
      "index": 52,
      "id": "TM_GUIDE_41",
      "hash": "de6bc777477afa55",
      "flags": 0,
      "text": "ディグダが　掘り進んだ　トンネル。\\nニビから　クチバへの　近道。"
    },
    {
      "index": 53,
      "id": "TM_GUIDE_42",
      "hash": "de6bc477477af53c",
      "flags": 0,
      "text": "ふたつ　並んだ　小島。\\n内部は　おどろくほど　寒い。"
    },
    {
      "index": 54,
      "id": "TM_GUIDE_43",
      "hash": "de6bc577477af6ef",
      "flags": 0,
      "text": "頂点を　目指す　トレーナーが\\n集う　険しい　洞窟。"
    },
    {
      "index": 55,
      "id": "TM_PLACE_COMMON_01",
      "hash": "8435be3e473a535c",
      "flags": 0,
      "text": "ポケモンセンター"
    },
    {
      "index": 56,
      "id": "TM_PLACE_COMMON_02",
      "hash": "8435c13e473a5875",
      "flags": 0,
      "text": "フレンドリィショップ"
    },
    {
      "index": 57,
      "id": "TM_PLACE_COMMON_05",
      "hash": "8435ba3e473a4c90",
      "flags": 0,
      "text": "ポケモン研究所"
    },
    {
      "index": 58,
      "id": "TM_PLACE_COMMON_06",
      "hash": "8435bd3e473a51a9",
      "flags": 0,
      "text": "トレーナーズスクール"
    },
    {
      "index": 59,
      "id": "TM_PLACE_COMMON_07",
      "hash": "8435bc3e473a4ff6",
      "flags": 0,
      "text": "ポケモンジム"
    },
    {
      "index": 60,
      "id": "TM_PLACE_COMMON_09",
      "hash": "8435c63e473a60f4",
      "flags": 0,
      "text": "ニビ科学博物館"
    },
    {
      "index": 61,
      "id": "TM_PLACE_COMMON_12",
      "hash": "8432373e47373820",
      "flags": 0,
      "text": "ポケモンタワー"
    },
    {
      "index": 62,
      "id": "TM_PLACE_COMMON_13",
      "hash": "8432383e473739d3",
      "flags": 0,
      "text": "ポケモンハウス"
    },
    {
      "index": 63,
      "id": "TM_PLACE_COMMON_14",
      "hash": "84323d3e47374252",
      "flags": 0,
      "text": "姓名判断士"
    },
    {
      "index": 64,
      "id": "TM_PLACE_COMMON_16",
      "hash": "84323b3e47373eec",
      "flags": 0,
      "text": "クチバ港"
    },
    {
      "index": 65,
      "id": "TM_PLACE_COMMON_17",
      "hash": "84323c3e4737409f",
      "flags": 0,
      "text": "ポケモンだいすきクラブ"
    },
    {
      "index": 66,
      "id": "TM_PLACE_COMMON_19",
      "hash": "8432423e47374ad1",
      "flags": 0,
      "text": "タマムシデパート"
    },
    {
      "index": 67,
      "id": "TM_PLACE_COMMON_20",
      "hash": "842ed33e4734585d",
      "flags": 0,
      "text": "タマムシマンション"
    },
    {
      "index": 68,
      "id": "TM_PLACE_COMMON_21",
      "hash": "842ed23e473456aa",
      "flags": 0,
      "text": "ロケットゲームコーナー"
    },
    {
      "index": 69,
      "id": "TM_PLACE_COMMON_22",
      "hash": "842ed13e473454f7",
      "flags": 0,
      "text": "占い師"
    },
    {
      "index": 70,
      "id": "TM_PLACE_COMMON_24",
      "hash": "842ecf3e47345191",
      "flags": 0,
      "text": "ＧＯパーク"
    },
    {
      "index": 71,
      "id": "TM_PLACE_COMMON_26",
      "hash": "842ecd3e47344e2b",
      "flags": 0,
      "text": "ポケモン屋敷"
    },
    {
      "index": 72,
      "id": "TM_PLACE_COMMON_27",
      "hash": "842ecc3e47344c78",
      "flags": 0,
      "text": "グレン　ラボラトリー"
    },
    {
      "index": 73,
      "id": "TM_PLACE_COMMON_29",
      "hash": "842eca3e47344912",
      "flags": 0,
      "text": "シルフカンパニー"
    },
    {
      "index": 74,
      "id": "TM_PLACE_COMMON_30",
      "hash": "842b4d3e47313ed4",
      "flags": 0,
      "text": "格闘道場"
    },
    {
      "index": 75,
      "id": "TM_PLACE_COMMON_31",
      "hash": "842b4e3e47314087",
      "flags": 0,
      "text": "相棒技教え"
    },
    {
