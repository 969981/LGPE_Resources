{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "TOKUSEIINFO_000",
      "hash": "7ba40506d12f4b74",
      "flags": 0,
      "text": "―\\n―"
    },
    {
      "index": 1,
      "id": "TOKUSEIINFO_001",
      "hash": "7ba40606d12f4d27",
      "flags": 0,
      "text": "臭い　においを　放つことによって\\n攻撃した　ときに　相手を\\nひるませることが　ある。"
    },
    {
      "index": 2,
      "id": "TOKUSEIINFO_002",
      "hash": "7ba40706d12f4eda",
      "flags": 0,
      "text": "登場　したときに\\n天気を　雨に　する。"
    },
    {
      "index": 3,
      "id": "TOKUSEIINFO_003",
      "hash": "7ba40806d12f508d",
      "flags": 0,
      "text": "毎ターン　素早さが　上がる。"
    },
    {
      "index": 4,
      "id": "TOKUSEIINFO_004",
      "hash": "7ba40106d12f44a8",
      "flags": 0,
      "text": "硬い　甲羅に　守られて\\n相手の　攻撃が\\n急所に　当たらない。"
    },
    {
      "index": 5,
      "id": "TOKUSEIINFO_005",
      "hash": "7ba40206d12f465b",
      "flags": 0,
      "text": "相手の　技を　受けても\\n一撃で　倒されることが　ない。\\n一撃必殺技も　効かない。"
    },
    {
      "index": 6,
      "id": "TOKUSEIINFO_006",
      "hash": "7ba40306d12f480e",
      "flags": 0,
      "text": "あたりを　湿らせることに　よって\\nじばく　などの　爆発する　技を\\nだれも　使えなくなる。"
    },
    {
      "index": 7,
      "id": "TOKUSEIINFO_007",
      "hash": "7ba40406d12f49c1",
      "flags": 0,
      "text": "柔軟な　体によって\\nまひ状態に　ならない。"
    },
    {
      "index": 8,
      "id": "TOKUSEIINFO_008",
      "hash": "7ba3fd06d12f3ddc",
      "flags": 0,
      "text": "砂あらしの　とき\\n回避率が　上がる。"
    },
    {
      "index": 9,
      "id": "TOKUSEIINFO_009",
      "hash": "7ba3fe06d12f3f8f",
      "flags": 0,
      "text": "静電気を　体に　まとい\\n触った　相手を\\nまひさせる　ことがある。"
    },
    {
      "index": 10,
      "id": "TOKUSEIINFO_010",
      "hash": "7ba70b06d1318b7d",
      "flags": 0,
      "text": "でんきタイプの　技を　受けると\\nダメージを　受けずに　回復する。"
    },
    {
      "index": 11,
      "id": "TOKUSEIINFO_011",
      "hash": "7ba70a06d13189ca",
      "flags": 0,
      "text": "みずタイプの　技を　受けると\\nダメージを　受けずに　回復する。"
    },
    {
      "index": 12,
      "id": "TOKUSEIINFO_012",
      "hash": "7ba70906d1318817",
      "flags": 0,
      "text": "鈍感なので\\nメロメロや　ちょうはつ状態に\\nならない。"
    },
    {
      "index": 13,
      "id": "TOKUSEIINFO_013",
      "hash": "7ba70806d1318664",
      "flags": 0,
      "text": "あらゆる　天気の　影響が\\nなくなって　しまう。"
    },
    {
      "index": 14,
      "id": "TOKUSEIINFO_014",
      "hash": "7ba70706d13184b1",
      "flags": 0,
      "text": "複眼を　持っているため\\n技の　命中率が　上がる。"
    },
    {
      "index": 15,
      "id": "TOKUSEIINFO_015",
      "hash": "7ba70606d13182fe",
      "flags": 0,
      "text": "眠れない　体質　なので\\nねむり状態に　ならない。"
    },
    {
      "index": 16,
      "id": "TOKUSEIINFO_016",
      "hash": "7ba70506d131814b",
      "flags": 0,
      "text": "相手から　受けた　技の　タイプに\\n自分の　タイプが　変化　する。"
    },
    {
      "index": 17,
      "id": "TOKUSEIINFO_017",
      "hash": "7ba70406d1317f98",
      "flags": 0,
      "text": "体内に　免疫を　持っているため\\nどく状態に　ならない。"
    },
    {
      "index": 18,
      "id": "TOKUSEIINFO_018",
      "hash": "7ba70306d1317de5",
      "flags": 0,
      "text": "ほのおタイプの　技を　受けると\\n炎を　もらい　自分が　出す\\nほのおタイプの　技が　強くなる。"
    },
    {
      "index": 19,
      "id": "TOKUSEIINFO_019",
      "hash": "7ba70206d1317c32",
      "flags": 0,
      "text": "りんぷんに　守られて\\n技の　追加効果を　受けなくなる。"
    },
    {
      "index": 20,
      "id": "TOKUSEIINFO_020",
      "hash": "7baa7106d1346ea6",
      "flags": 0,
      "text": "マイペースなので\\nこんらん状態に　ならない。"
    },
    {
      "index": 21,
      "id": "TOKUSEIINFO_021",
      "hash": "7baa7206d1347059",
      "flags": 0,
      "text": "吸盤で　地面に　張り付き\\nポケモンを　入れ替えさせる\\n技や　道具が　効かなくなる。"
    },
    {
      "index": 22,
      "id": "TOKUSEIINFO_022",
      "hash": "7baa6f06d1346b40",
      "flags": 0,
      "text": "登場　したとき　威嚇して\\n相手を　萎縮させ\\n相手の　攻撃を　下げて　しまう。"
    },
    {
      "index": 23,
      "id": "TOKUSEIINFO_023",
      "hash": "7baa7006d1346cf3",
      "flags": 0,
      "text": "相手の　影を　踏み\\n逃げたり　交代　できなくする。"
    },
    {
      "index": 24,
      "id": "TOKUSEIINFO_024",
      "hash": "7baa7506d1347572",
      "flags": 0,
      "text": "攻撃を　受けたとき\\n自分に　触れた　相手を\\nざらざらの　肌で　キズつける。"
    },
    {
      "index": 25,
      "id": "TOKUSEIINFO_025",
      "hash": "7baa7606d1347725",
      "flags": 0,
      "text": "効果バツグンの　技しか\\n当たらない　不思議な　力。"
    },
    {
      "index": 26,
      "id": "TOKUSEIINFO_026",
      "hash": "7baa7306d134720c",
      "flags": 0,
      "text": "地面から　浮くことによって\\nじめんタイプの　技を　受けない。"
    },
    {
      "index": 27,
      "id": "TOKUSEIINFO_027",
      "hash": "7baa7406d13473bf",
      "flags": 0,
      "text": "攻撃で　自分に　触れた　相手を\\nどくや　まひや　ねむり状態に\\nする　ことがある。"
    },
    {
      "index": 28,
      "id": "TOKUSEIINFO_028",
      "hash": "7baa7906d1347c3e",
      "flags": 0,
      "text": "自分が　なってしまった\\nどくや　まひや　やけどを\\n相手に　うつす。"
    },
    {
      "index": 29,
      "id": "TOKUSEIINFO_029",
      "hash": "7baa7a06d1347df1",
      "flags": 0,
      "text": "相手の　技や　特性で\\n能力を　下げられない。"
    },
    {
      "index": 30,
      "id": "TOKUSEIINFO_030",
      "hash": "7badf706d137882f",
      "flags": 0,
      "text": "手持ちに　ひっこむと\\n状態異常が　治る。"
    },
    {
      "index": 31,
      "id": "TOKUSEIINFO_031",
      "hash": "7badf606d137867c",
      "flags": 0,
      "text": "でんきタイプの　技を　自分に\\n寄せつけ　ダメージを　受けずに\\n特攻が　上がる。"
    },
    {
      "index": 32,
      "id": "TOKUSEIINFO_032",
      "hash": "7badf906d1378b95",
      "flags": 0,
      "text": "天の恵みの　おかげで\\n技の　追加効果が　でやすい。"
    },
    {
      "index": 33,
      "id": "TOKUSEIINFO_033",
      "hash": "7badf806d13789e2",
      "flags": 0,
      "text": "天気が　雨のとき\\n素早さが　上がる。"
    },
    {
      "index": 34,
      "id": "TOKUSEIINFO_034",
      "hash": "7badf306d1378163",
      "flags": 0,
      "text": "天気が　晴れのとき\\n素早さが　上がる。"
    },
    {
      "index": 35,
      "id": "TOKUSEIINFO_035",
      "hash": "7badf206d1377fb0",
      "flags": 0,
      "text": "あたりを　明るくする　ことで\\n野生の　ポケモンに\\n遭遇　しやすくなる。"
    },
    {
      "index": 36,
      "id": "TOKUSEIINFO_036",
      "hash": "7badf506d13784c9",
      "flags": 0,
      "text": "登場　したとき\\n相手の　特性を　トレースして\\n同じ　特性に　なる。"
    },
    {
      "index": 37,
      "id": "TOKUSEIINFO_037",
      "hash": "7badf406d1378316",
      "flags": 0,
      "text": "物理攻撃の\\n威力が　２倍になる。"
    },
    {
      "index": 38,
      "id": "TOKUSEIINFO_038",
      "hash": "7badff06d13795c7",
      "flags": 0,
      "text": "自分に　触った　相手を\\nどく状態に　することがある。"
    },
    {
      "index": 39,
      "id": "TOKUSEIINFO_039",
      "hash": "7badfe06d1379414",
      "flags": 0,
      "text": "鍛えられた　精神に　よって\\n相手の　攻撃に　ひるまない。"
    },
    {
      "index": 40,
      "id": "TOKUSEIINFO_040",
      "hash": "7b966d06d123bed0",
      "flags": 0,
      "text": "熱い　マグマを　身にまとい\\nこおり状態に　ならない。"
    },
    {
      "index": 41,
      "id": "TOKUSEIINFO_041",
      "hash": "7b966e06d123c083",
      "flags": 0,
      "text": "水のベールを　身にまとい\\nやけど状態に　ならない。"
    },
    {
      "index": 42,
      "id": "TOKUSEIINFO_042",
      "hash": "7b966f06d123c236",
      "flags": 0,
      "text": "はがねタイプの　ポケモンを\\n磁力で　引きつけて\\n逃げられなくする。"
    },
    {
      "index": 43,
      "id": "TOKUSEIINFO_043",
      "hash": "7b967006d123c3e9",
      "flags": 0,
      "text": "音を　遮断　することに　よって\\n音の　攻撃を　受けない。"
    },
    {
      "index": 44,
      "id": "TOKUSEIINFO_044",
      "hash": "7b967106d123c59c",
      "flags": 0,
      "text": "天気が　雨のとき\\n少しずつ　ＨＰを　回復する。"
    },
    {
      "index": 45,
      "id": "TOKUSEIINFO_045",
      "hash": "7b967206d123c74f",
      "flags": 0,
      "text": "登場　したとき\\n天気を　砂あらしにする。"
    },
    {
      "index": 46,
      "id": "TOKUSEIINFO_046",
      "hash": "7b967306d123c902",
      "flags": 0,
      "text": "プレッシャーを　あたえて\\n相手の　使う　技の　ＰＰを\\n多く　減らす。"
    },
    {
      "index": 47,
      "id": "TOKUSEIINFO_047",
      "hash": "7b967406d123cab5",
      "flags": 0,
      "text": "厚い　脂肪で　守られているので\\nほのおタイプと　こおりタイプの\\n技の　ダメージを　半減させる。"
    },
    {
      "index": 48,
      "id": "TOKUSEIINFO_048",
      "hash": "7b967506d123cc68",
      "flags": 0,
      "text": "ねむり状態に　なっても\\n２倍の　早さで\\n目覚める　ことが　できる。"
    },
    {
      "index": 49,
      "id": "TOKUSEIINFO_049",
      "hash": "7b967606d123ce1b",
      "flags": 0,
      "text": "自分に　触った　相手を\\nやけど状態に　する　ことがある。"
    },
    {
      "index": 50,
      "id": "TOKUSEIINFO_050",
      "hash": "7b997306d125fed9",
      "flags": 0,
      "text": "野生の　ポケモンから\\n必ず　逃げられる。"
    },
    {
      "index": 51,
      "id": "TOKUSEIINFO_051",
      "hash": "7b997206d125fd26",
      "flags": 0,
      "text": "鋭い　目の　おかげで\\n命中率を　下げられない。"
    },
    {
      "index": 52,
      "id": "TOKUSEIINFO_052",
      "hash": "7b997106d125fb73",
      "flags": 0,
      "text": "力自慢の　ハサミを　持っているので\\n相手に　攻撃を　下げられない。"
    },
    {
      "index": 53,
      "id": "TOKUSEIINFO_053",
      "hash": "7b997006d125f9c0",
      "flags": 0,
      "text": "相手の　使った　道具を\\n拾ってくることが　ある。\\n冒険中も　拾ってくる。"
    },
    {
      "index": 54,
      "id": "TOKUSEIINFO_054",
      "hash": "7b997706d12605a5",
      "flags": 0,
      "text": "技を　出すと\\nつぎの　ターンは　休んでしまう。"
    },
    {
      "index": 55,
      "id": "TOKUSEIINFO_055",
      "hash": "7b997606d12603f2",
      "flags": 0,
      "text": "自分の　攻撃が　高くなるが\\n命中率が　下がる。　"
    },
    {
      "index": 56,
      "id": "TOKUSEIINFO_056",
      "hash": "7b997506d126023f",
      "flags": 0,
      "text": "自分に　触った　相手を\\nメロメロに　することが　ある。"
    },
    {
      "index": 57,
      "id": "TOKUSEIINFO_057",
      "hash": "7b997406d126008c",
      "flags": 0,
      "text": "プラスか　マイナスの　特性を　持つ\\nポケモンが　仲間に　いると\\n自分の　特攻が　上がる。"
    },
    {
      "index": 58,
      "id": "TOKUSEIINFO_058",
      "hash": "7b997b06d1260c71",
      "flags": 0,
      "text": "プラスか　マイナスの　特性を　持つ\\nポケモンが　仲間に　いると\\n自分の　特攻が　上がる。"
    },
    {
      "index": 59,
      "id": "TOKUSEIINFO_059",
      "hash": "7b997a06d1260abe",
      "flags": 0,
      "text": "天気の　影響を　受けて\\nみずタイプ　ほのおタイプ　こおりタイプの\\nどれかに　変化する。"
    },
    {
      "index": 60,
      "id": "TOKUSEIINFO_060",
      "hash": "7b9cf906d1291862",
      "flags": 0,
      "text": "粘着質の　体に\\n道具が　くっついているため\\n相手に　道具を　奪われない。"
    },
    {
      "index": 61,
      "id": "TOKUSEIINFO_061",
      "hash": "7b9cfa06d1291a15",
      "flags": 0,
      "text": "体の　皮を　脱ぎ捨てることで\\n状態異常を\\n治すことが　ある。"
    },
    {
      "index": 62,
      "id": "TOKUSEIINFO_062",
      "hash": "7b9cf706d12914fc",
      "flags": 0,
      "text": "状態異常に　なると\\n根性を　だして\\n攻撃が　上がる。"
    },
    {
      "index": 63,
      "id": "TOKUSEIINFO_063",
      "hash": "7b9cf806d12916af",
      "flags": 0,
      "text": "状態異常に　なると\\n不思議なウロコが　反応して\\n防御が　上がる。"
    },
    {
      "index": 64,
      "id": "TOKUSEIINFO_064",
      "hash": "7b9cf506d1291196",
      "flags": 0,
      "text": "ヘドロ液を　吸い取った　相手は\\n強烈な　悪臭で\\nダメージを　受けて　ＨＰを　減らす。"
    },
    {
      "index": 65,
      "id": "TOKUSEIINFO_065",
      "hash": "7b9cf606d1291349",
      "flags": 0,
      "text": "ＨＰが　減ったとき\\nくさタイプの　技の\\n威力が　上がる。"
    },
    {
      "index": 66,
      "id": "TOKUSEIINFO_066",
      "hash": "7b9cf306d1290e30",
      "flags": 0,
      "text": "ＨＰが　減ったとき\\nほのおタイプの　技の\\n威力が　上がる。"
    },
    {
      "index": 67,
      "id": "TOKUSEIINFO_067",
      "hash": "7b9cf406d1290fe3",
      "flags": 0,
      "text": "ＨＰが　減ったとき\\nみずタイプの　技の\\n威力が　上がる。"
    },
    {
      "index": 68,
      "id": "TOKUSEIINFO_068",
      "hash": "7b9d0106d12925fa",
      "flags": 0,
      "text": "ＨＰが　減ったとき\\nむしタイプの　技の\\n威力が　上がる。"
    },
    {
      "index": 69,
      "id": "TOKUSEIINFO_069",
      "hash": "7b9d0206d12927ad",
      "flags": 0,
      "text": "反動を　受ける　技を　出しても\\nＨＰが　減らない。"
    },
    {
      "index": 70,
      "id": "TOKUSEIINFO_070",
      "hash": "7ba07f06d12c31eb",
      "flags": 0,
      "text": "登場　したときに\\n天気を　晴れに　する。"
    },
    {
      "index": 71,
      "id": "TOKUSEIINFO_071",
      "hash": "7ba07e06d12c3038",
      "flags": 0,
      "text": "戦闘で　相手を\\n逃げられなくする。"
    },
    {
      "index": 72,
      "id": "TOKUSEIINFO_072",
      "hash": "7ba08106d12c3551",
      "flags": 0,
      "text": "やる気を　だすことに　よって\\nねむり状態に　ならない。"
    },
    {
      "index": 73,
      "id": "TOKUSEIINFO_073",
      "hash": "7ba08006d12c339e",
      "flags": 0,
      "text": "白い煙に　守られて\\n相手に　能力を　下げられない。"
    },
    {
      "index": 74,
      "id": "TOKUSEIINFO_074",
      "hash": "7ba08306d12c38b7",
      "flags": 0,
      "text": "ヨガの　力で\\n物理攻撃の　威力が\\n２倍に　なる。"
    },
    {
      "index": 75,
      "id": "TOKUSEIINFO_075",
      "hash": "7ba08206d12c3704",
      "flags": 0,
      "text": "硬い　殻に　守られ\\n相手の　攻撃が\\n急所に　当たらない。"
    },
    {
      "index": 76,
      "id": "TOKUSEIINFO_076",
      "hash": "7ba08506d12c3c1d",
      "flags": 0,
      "text": "あらゆる　天気の　影響が\\n消えて　しまう。"
    },
    {
      "index": 77,
      "id": "TOKUSEIINFO_077",
      "hash": "7ba08406d12c3a6a",
      "flags": 0,
      "text": "こんらん状態の　ときは\\n回避率が　アップする。　"
    },
    {
      "index": 78,
      "id": "TOKUSEIINFO_078",
      "hash": "7ba07706d12c2453",
      "flags": 0,
      "text": "でんきタイプの　技を　受けると\\nダメージを　受けずに　\\n素早さが　上がる。"
    },
    {
      "index": 79,
      "id": "TOKUSEIINFO_079",
      "hash": "7ba07606d12c22a0",
      "flags": 0,
      "text": "性別が　同じだと\\n闘争心を　燃やして　強くなる。\\n性別が　違うと　弱くなる。"
    },
    {
      "index": 80,
      "id": "TOKUSEIINFO_080",
      "hash": "7bbef506d145f7fc",
      "flags": 0,
      "text": "ひるむ　たびに\\n不屈の心を　燃やして\\n素早さが　上がる。"
    },
    {
      "index": 81,
      "id": "TOKUSEIINFO_081",
      "hash": "7bbef606d145f9af",
      "flags": 0,
      "text": "天気が　あられのとき\\n回避率が　上がる。"
    },
    {
      "index": 82,
      "id": "TOKUSEIINFO_082",
      "hash": "7bbef706d145fb62",
      "flags": 0,
      "text": "ＨＰが　少なくなったら　食べる\\nきのみを　ＨＰ　半分の\\n時に　食べてしまう。"
    },
    {
      "index": 83,
      "id": "TOKUSEIINFO_083",
      "hash": "7bbef806d145fd15",
      "flags": 0,
      "text": "急所に　攻撃が　当たると\\n怒りくるって　攻撃力が\\n最大に　なる。"
    },
    {
      "index": 84,
      "id": "TOKUSEIINFO_084",
      "hash": "7bbef106d145f130",
      "flags": 0,
      "text": "持っていた　道具が　なくなると\\n素早さが　上がる。"
    },
    {
      "index": 85,
      "id": "TOKUSEIINFO_085",
      "hash": "7bbef206d145f2e3",
      "flags": 0,
      "text": "耐熱の　体に　よって\\nほのおタイプの　技の\\n威力を　半減させる。"
    },
    {
      "index": 86,
      "id": "TOKUSEIINFO_086",
      "hash": "7bbef306d145f496",
      "flags": 0,
      "text": "能力　変化が\\nいつもの　２倍に　なる。"
    },
    {
      "index": 87,
      "id": "TOKUSEIINFO_087",
      "hash": "7bbef406d145f649",
      "flags": 0,
      "text": "天気が　雨の時や　みずタイプの\\n技で　ＨＰが　回復し　はれの時や\\nほのおタイプの　技で　減ってしまう。"
    },
    {
      "index": 88,
      "id": "TOKUSEIINFO_088",
      "hash": "7bbefd06d1460594",
      "flags": 0,
      "text": "相手の　防御と　特防を　くらべて\\n低い　ほうの　能力に　あわせて\\n自分の　攻撃か　特攻を　上げる。"
    },
    {
      "index": 89,
      "id": "TOKUSEIINFO_089",
      "hash": "7bbefe06d1460747",
      "flags": 0,
      "text": "パンチを　使う　技の\\n威力が　上がる。"
    },
    {
      "index": 90,
      "id": "TOKUSEIINFO_090",
      "hash": "7bc27b06d1491185",
      "flags": 0,
      "text": "どく状態に　なると\\nＨＰが　減らずに　増えていく。"
    },
    {
      "index": 91,
      "id": "TOKUSEIINFO_091",
      "hash": "7bc27a06d1490fd2",
      "flags": 0,
      "text": "自分と　おなじ　タイプの\\n技の　威力が　上がる。"
    },
    {
      "index": 92,
      "id": "TOKUSEIINFO_092",
      "hash": "7bc27906d1490e1f",
      "flags": 0,
      "text": "連続技を　使うと　いつも\\n最高回数　出すことが　できる。"
    },
    {
      "index": 93,
      "id": "TOKUSEIINFO_093",
      "hash": "7bc27806d1490c6c",
      "flags": 0,
      "text": "天気が　雨のとき\\n状態異常が　治る。"
    },
    {
      "index": 94,
      "id": "TOKUSEIINFO_094",
      "hash": "7bc27706d1490ab9",
      "flags": 0,
      "text": "天気が　晴れると\\n特攻が　上がるが\\n毎ターン　ＨＰが　減る。"
    },
    {
      "index": 95,
      "id": "TOKUSEIINFO_095",
      "hash": "7bc27606d1490906",
      "flags": 0,
      "text": "状態異常に　なると\\n素早さが　上がる。"
    },
    {
      "index": 96,
      "id": "TOKUSEIINFO_096",
      "hash": "7bc27506d1490753",
      "flags": 0,
      "text": "どんな　タイプの　技でも\\nすべて　ノーマルタイプに　なる。\\n威力が　少し　上がる。"
    },
    {
      "index": 97,
      "id": "TOKUSEIINFO_097",
      "hash": "7bc27406d14905a0",
      "flags": 0,
      "text": "攻撃を　急所に　当てると\\n威力が　さらに　上がる。"
    },
    {
      "index": 98,
      "id": "TOKUSEIINFO_098",
      "hash": "7bc28306d1491f1d",
      "flags": 0,
      "text": "攻撃　以外では\\nダメージを　受けない。"
    },
    {
      "index": 99,
      "id": "TOKUSEIINFO_099",
      "hash": "7bc28206d1491d6a",
      "flags": 0,
      "text": "ノーガード戦法に　よって\\nお互いの　出す　技が\\nかならず　当たる　ようになる。"
    },
    {
      "index": 100,
      "id": "TOKUSEIINFO_100",
      "hash": "84ba2006d67378df",
      "flags": 0,
      "text": "技を　出す　順番が\\nかならず　最後に　なる。"
    },
    {
      "index": 101,
      "id": "TOKUSEIINFO_101",
      "hash": "84ba1f06d673772c",
      "flags": 0,
      "text": "威力が　低い　技の\\n威力を　高くして　攻撃できる。"
    },
    {
      "index": 102,
      "id": "TOKUSEIINFO_102",
      "hash": "84ba2206d6737c45",
      "flags": 0,
      "text": "天気が　晴れのときは\\n状態異常に　ならない。"
    },
    {
      "index": 103,
      "id": "TOKUSEIINFO_103",
      "hash": "84ba2106d6737a92",
      "flags": 0,
      "text": "持っている　道具を\\n使うことが　できない。"
    },
    {
      "index": 104,
      "id": "TOKUSEIINFO_104",
      "hash": "84ba1c06d6737213",
      "flags": 0,
      "text": "相手の　特性に\\nジャマされる　ことなく　相手に\\n技を　出すことが　できる。"
    },
    {
      "index": 105,
      "id": "TOKUSEIINFO_105",
      "hash": "84ba1b06d6737060",
      "flags": 0,
      "text": "強運を　持っているため\\n相手の　急所に\\n攻撃が　当たりやすい。"
    },
    {
      "index": 106,
      "id": "TOKUSEIINFO_106",
      "hash": "84ba1e06d6737579",
      "flags": 0,
      "text": "ひんしに　なったとき\\n触った　相手に\\nダメージを　あたえる。"
    },
    {
      "index": 107,
      "id": "TOKUSEIINFO_107",
      "hash": "84ba1d06d67373c6",
      "flags": 0,
      "text": "相手の　持つ　危険な　技を\\n察知する　ことができる。"
    },
    {
      "index": 108,
      "id": "TOKUSEIINFO_108",
      "hash": "84ba2806d6738677",
      "flags": 0,
      "text": "登場　したとき\\n相手の　持つ　技を\\nひとつだけ　読み取る。"
    },
    {
      "index": 109,
      "id": "TOKUSEIINFO_109",
      "hash": "84ba2706d67384c4",
      "flags": 0,
      "text": "相手の　能力の　変化を\\n無視して　攻撃が　できる。"
    },
    {
      "index": 110,
      "id": "TOKUSEIINFO_110",
      "hash": "84b69a06d6705f56",
      "flags": 0,
      "text": "効果が　いまひとつの　技を\\n通常の　威力で\\n出すことが　できる。"
    },
    {
      "index": 111,
      "id": "TOKUSEIINFO_111",
      "hash": "84b69b06d6706109",
      "flags": 0,
      "text": "効果バツグンに　なってしまう\\n攻撃の　威力を\\n弱める　ことが　できる。"
    },
    {
      "index": 112,
      "id": "TOKUSEIINFO_112",
      "hash": "84b69806d6705bf0",
      "flags": 0,
      "text": "５ターンの　あいだ\\n攻撃と　素早さが\\n半分に　なる。"
    },
    {
      "index": 113,
      "id": "TOKUSEIINFO_113",
      "hash": "84b69906d6705da3",
      "flags": 0,
      "text": "ゴーストタイプの　ポケモンに\\nノーマルタイプと　かくとうタイプの\\n技を　当てることが　できる。"
    },
    {
      "index": 114,
      "id": "TOKUSEIINFO_114",
      "hash": "84b69e06d6706622",
      "flags": 0,
      "text": "みずタイプの　技を　自分に　よせつけ\\nダメージは　受けずに　特攻が　上がる。"
    },
    {
      "index": 115,
      "id": "TOKUSEIINFO_115",
      "hash": "84b69f06d67067d5",
      "flags": 0,
      "text": "天気が　あられのとき　ＨＰを\\n少しずつ　回復　する。"
    },
    {
      "index": 116,
      "id": "TOKUSEIINFO_116",
      "hash": "84b69c06d67062bc",
      "flags": 0,
      "text": "効果バツグンに　なってしまう\\n攻撃の　威力を\\n弱める　ことが　できる。"
    },
    {
      "index": 117,
      "id": "TOKUSEIINFO_117",
      "hash": "84b69d06d670646f",
      "flags": 0,
      "text": "登場　したときに\\n天気を　あられに　する。"
    },
    {
      "index": 118,
      "id": "TOKUSEIINFO_118",
      "hash": "84b6a206d6706cee",
      "flags": 0,
      "text": "戦闘が　終わったとき\\nあまいミツを　拾うことが　ある。"
    },
    {
      "index": 119,
      "id": "TOKUSEIINFO_119",
      "hash": "84b6a306d6706ea1",
      "flags": 0,
      "text": "登場　したとき\\n相手の　持ち物を\\n見通すことが　できる。"
    },
    {
      "index": 120,
      "id": "TOKUSEIINFO_120",
      "hash": "84b33406d66d7c2d",
      "flags": 0,
      "text": "反動で　ダメージを\\n受ける　技の　威力が　上がる。"
    },
    {
      "index": 121,
      "id": "TOKUSEIINFO_121",
      "hash": "84b33306d66d7a7a",
      "flags": 0,
      "text": "持っている　プレートや\\nＺクリスタルの　タイプによって\\n自分の　タイプが　変わる。"
    },
    {
      "index": 122,
      "id": "TOKUSEIINFO_122",
      "hash": "84b33206d66d78c7",
      "flags": 0,
      "text": "天気が　晴れのとき\\n自分と　味方の　攻撃と\\n特防の　能力が　上がる。"
    },
    {
      "index": 123,
      "id": "TOKUSEIINFO_123",
      "hash": "84b33106d66d7714",
      "flags": 0,
      "text": "ねむり状態の　相手に\\nダメージを　あたえる。"
    },
    {
      "index": 124,
      "id": "TOKUSEIINFO_124",
      "hash": "84b33006d66d7561",
      "flags": 0,
      "text": "触られた　相手の　道具を\\n盗んで　しまう。"
    },
    {
      "index": 125,
      "id": "TOKUSEIINFO_125",
      "hash": "84b32f06d66d73ae",
      "flags": 0,
      "text": "技の　追加効果は　なくなるが\\nそのぶん　高い　威力で\\n技を　出すことが　できる。"
    },
    {
      "index": 126,
      "id": "TOKUSEIINFO_126",
      "hash": "84b32e06d66d71fb",
      "flags": 0,
      "text": "能力の　変化が　逆転して\\n上がるときに　下がり\\n下がるときに　上がる。"
    },
    {
      "index": 127,
      "id": "TOKUSEIINFO_127",
      "hash": "84b32d06d66d7048",
      "flags": 0,
      "text": "相手を　緊張させて\\nきのみを　食べられなく　させる。"
    },
    {
      "index": 128,
      "id": "TOKUSEIINFO_128",
      "hash": "84b32c06d66d6e95",
      "flags": 0,
      "text": "能力を　下げられると\\n攻撃が　ぐーんと　上がる。"
    },
    {
      "index": 129,
      "id": "TOKUSEIINFO_129",
      "hash": "84b32b06d66d6ce2",
      "flags": 0,
      "text": "ＨＰが　半分に　なると\\n弱気に　なって　攻撃と\\n特攻が　半減する。"
    },
    {
      "index": 130,
      "id": "TOKUSEIINFO_130",
      "hash": "84afae06d66a62a4",
      "flags": 0,
      "text": "攻撃を　受けると　相手の　技を\\nかなしばり状態に\\nすることが　ある。"
    },
    {
      "index": 131,
      "id": "TOKUSEIINFO_131",
      "hash": "84afaf06d66a6457",
      "flags": 0,
      "text": "状態異常の　味方を\\nたまに　治してあげる。"
    },
    {
      "index": 132,
      "id": "TOKUSEIINFO_132",
      "hash": "84afb006d66a660a",
      "flags": 0,
      "text": "味方の　ダメージを\\n減らすことが　できる。"
    },
    {
      "index": 133,
      "id": "TOKUSEIINFO_133",
      "hash": "84afb106d66a67bd",
      "flags": 0,
      "text": "物理技で　ダメージを　受けると\\n防御が　下がり\\n素早さが　ぐーんと　上がる。"
    },
    {
      "index": 134,
      "id": "TOKUSEIINFO_134",
      "hash": "84afaa06d66a5bd8",
      "flags": 0,
      "text": "自分の　重さが\\n２倍に　なる。"
    },
    {
      "index": 135,
      "id": "TOKUSEIINFO_135",
      "hash": "84afab06d66a5d8b",
      "flags": 0,
      "text": "自分の　重さが\\n半分に　なる。"
    },
    {
      "index": 136,
      "id": "TOKUSEIINFO_136",
      "hash": "84afac06d66a5f3e",
      "flags": 0,
      "text": "ＨＰが　満タンの　ときに\\n受ける　ダメージが　少なくなる。"
    },
    {
      "index": 137,
      "id": "TOKUSEIINFO_137",
      "hash": "84afad06d66a60f1",
      "flags": 0,
      "text": "どく状態に　なったとき\\n物理技の　威力が　上がる。"
    },
    {
      "index": 138,
      "id": "TOKUSEIINFO_138",
      "hash": "84afa606d66a550c",
      "flags": 0,
      "text": "やけど状態に　なったとき\\n特殊技の　威力が　上がる。"
    },
    {
      "index": 139,
      "id": "TOKUSEIINFO_139",
      "hash": "84afa706d66a56bf",
      "flags": 0,
      "text": "使った　きのみを\\n何回も　作りだす。"
    },
    {
      "index": 140,
      "id": "TOKUSEIINFO_140",
      "hash": "84aca806d668229b",
      "flags": 0,
      "text": "味方の　攻撃を　読み取って\\n技を　回避する。"
    },
    {
      "index": 141,
      "id": "TOKUSEIINFO_141",
      "hash": "84aca706d66820e8",
      "flags": 0,
      "text": "毎ターン　能力の　どれかが\\nぐーんと　上がって　どれかが　下がる。"
    },
    {
      "index": 142,
      "id": "TOKUSEIINFO_142",
      "hash": "84acaa06d6682601",
      "flags": 0,
      "text": "すなあらしや　あられなどの\\nダメージを　受けない。\\n粉の　技を　受けない。"
    },
    {
      "index": 143,
      "id": "TOKUSEIINFO_143",
      "hash": "84aca906d668244e",
      "flags": 0,
      "text": "触る　だけで　相手を\\nどく　状態に　することがある。"
    },
    {
      "index": 144,
      "id": "TOKUSEIINFO_144",
      "hash": "84acac06d6682967",
      "flags": 0,
      "text": "手持ちに　引っ込むと\\nＨＰが　少し　回復する。"
    },
    {
      "index": 145,
      "id": "TOKUSEIINFO_145",
      "hash": "84acab06d66827b4",
      "flags": 0,
      "text": "防御を　下げる\\n効果を　受けない。"
    },
    {
      "index": 146,
      "id": "TOKUSEIINFO_146",
      "hash": "84acae06d6682ccd",
      "flags": 0,
      "text": "天気が　すなあらし　のとき\\n素早さが　上がる。"
    },
    {
      "index": 147,
      "id": "TOKUSEIINFO_147",
      "hash": "84acad06d6682b1a",
      "flags": 0,
      "text": "変化技を　受けにくい\\n体に　なっている。"
    },
    {
      "index": 148,
      "id": "TOKUSEIINFO_148",
      "hash": "84aca006d6681503",
      "flags": 0,
      "text": "いちばん　最後に　技を　出すと\\n技の　威力が　上がる。"
    },
    {
      "index": 149,
      "id": "TOKUSEIINFO_149",
      "hash": "84ac9f06d6681350",
      "flags": 0,
      "text": "手持ちの　いちばん　うしろに　いる\\nポケモンに　なりきって　登場して\\n相手を　化かす。"
    },
    {
      "index": 150,
      "id": "TOKUSEIINFO_150",
      "hash": "84a92206d6650912",
      "flags": 0,
      "text": "目の前の　ポケモンに\\n変身　してしまう。"
    },
    {
      "index": 151,
      "id": "TOKUSEIINFO_151",
      "hash": "84a92306d6650ac5",
      "flags": 0,
      "text": "相手の　壁や　身代わりを\\nすりぬけて　攻撃　できる"
    },
    {
      "index": 152,
      "id": "TOKUSEIINFO_152",
      "hash": "84a92006d66505ac",
      "flags": 0,
      "text": "相手に　触られると\\n相手を　ミイラに　してしまう。"
    },
    {
      "index": 153,
      "id": "TOKUSEIINFO_153",
      "hash": "84a92106d665075f",
      "flags": 0,
      "text": "相手を　倒すと\\n自信が　ついて\\n攻撃が　上がる。"
    },
    {
      "index": 154,
      "id": "TOKUSEIINFO_154",
      "hash": "84a91e06d6650246",
      "flags": 0,
      "text": "あくタイプの　攻撃を　受けると\\n正義感で　攻撃が　上がる。"
    },
    {
      "index": 155,
      "id": "TOKUSEIINFO_155",
      "hash": "84a91f06d66503f9",
      "flags": 0,
      "text": "あくタイプと　ゴーストタイプと\\nむしタイプの　技を　受けると\\nびびって　素早さが　上がる。"
    },
    {
      "index": 156,
      "id": "TOKUSEIINFO_156",
      "hash": "84a91c06d664fee0",
      "flags": 0,
      "text": "相手に　だされた　変化技を　受けずに\\nそのまま　返す　ことが　できる。"
    },
    {
      "index": 157,
      "id": "TOKUSEIINFO_157",
      "hash": "84a91d06d6650093",
      "flags": 0,
      "text": "くさタイプの　技を　受けると\\nダメージを　受けずに　\\n攻撃が　上がる。"
    },
    {
      "index": 158,
      "id": "TOKUSEIINFO_158",
      "hash": "84a92a06d66516aa",
      "flags": 0,
      "text": "変化技を　先制で\\n出すことが　できる。"
    },
    {
      "index": 159,
      "id": "TOKUSEIINFO_159",
      "hash": "84a92b06d665185d",
      "flags": 0,
      "text": "天気が　すなあらしの　とき\\nいわタイプと　じめんタイプと\\nはがねタイプの　威力が　上がる。"
    },
    {
      "index": 160,
      "id": "TOKUSEIINFO_160",
      "hash": "84a59c06d661ef89",
      "flags": 0,
      "text": "自分に　触った　相手に\\n鉄のトゲで　ダメージを　あたえる。"
    },
    {
      "index": 161,
      "id": "TOKUSEIINFO_161",
      "hash": "84a59b06d661edd6",
      "flags": 0,
      "text": "ＨＰが　半分　以下に　なると\\n姿が　変化する。"
    },
    {
      "index": 162,
      "id": "TOKUSEIINFO_162",
      "hash": "84a59a06d661ec23",
      "flags": 0,
      "text": "自分や　味方の\\n命中率が　上がる。"
    },
    {
      "index": 163,
      "id": "TOKUSEIINFO_163",
      "hash": "84a59906d661ea70",
      "flags": 0,
      "text": "相手の　特性に　ジャマされず\\n相手に　技を　出すことが　できる。"
    },
    {
      "index": 164,
      "id": "TOKUSEIINFO_164",
      "hash": "84a5a006d661f655",
      "flags": 0,
      "text": "相手の　特性に　ジャマされず\\n相手に　技を　出すことが　できる。"
    },
    {
      "index": 165,
      "id": "TOKUSEIINFO_165",
      "hash": "84a59f06d661f4a2",
      "flags": 0,
      "text": "自分と　味方への　メンタル\\n攻撃を　防ぐことが　できる。"
    },
    {
      "index": 166,
      "id": "TOKUSEIINFO_166",
      "hash": "84a59e06d661f2ef",
      "flags": 0,
      "text": "味方の　草ポケモンは\\n能力が　下がらず\\n状態異常にも　ならない。"
    },
    {
      "index": 167,
      "id": "TOKUSEIINFO_167",
      "hash": "84a59d06d661f13c",
      "flags": 0,
      "text": "どんな　きのみでも\\n食べると　ＨＰも　回復する。"
    },
    {
      "index": 168,
      "id": "TOKUSEIINFO_168",
      "hash": "84a5a406d661fd21",
      "flags": 0,
      "text": "自分が　出す　技と\\n同じ　タイプに　変化する。"
    },
    {
      "index": 169,
      "id": "TOKUSEIINFO_169",
      "hash": "84a5a306d661fb6e",
      "flags": 0,
      "text": "相手から　受ける　物理技の\\nダメージが　半分に　なる。"
    },
    {
      "index": 170,
      "id": "TOKUSEIINFO_170",
      "hash": "84a21606d65ed600",
      "flags": 0,
      "text": "技を　当てた　相手の\\n道具を　奪ってしまう。"
    },
    {
      "index": 171,
      "id": "TOKUSEIINFO_171",
      "hash": "84a21706d65ed7b3",
      "flags": 0,
      "text": "相手の　弾や　爆弾などの\\n技を　防ぐことが　できる。"
    },
    {
      "index": 172,
      "id": "TOKUSEIINFO_172",
      "hash": "84a21806d65ed966",
      "flags": 0,
      "text": "能力を　下げられると\\n特攻が　ぐーんと　上がる。"
    },
    {
      "index": 173,
      "id": "TOKUSEIINFO_173",
      "hash": "84a21906d65edb19",
      "flags": 0,
      "text": "あごが　頑丈で\\n噛む　技の　威力が\\n高くなる。"
    },
    {
      "index": 174,
      "id": "TOKUSEIINFO_174",
      "hash": "84a21a06d65edccc",
      "flags": 0,
      "text": "ノーマルタイプの　技が\\nこおりタイプに　なる。\\n威力が　少し　上がる。"
    },
    {
      "index": 175,
      "id": "TOKUSEIINFO_175",
      "hash": "84a21b06d65ede7f",
      "flags": 0,
      "text": "味方の　ポケモンは\\n眠らなくなる。"
    },
    {
      "index": 176,
      "id": "TOKUSEIINFO_176",
      "hash": "84a21c06d65ee032",
      "flags": 0,
      "text": "攻撃技を　出すと　ブレードフォルムに\\n技　キングシールドを　出すと\\nシールドフォルムに　変化する。"
    },
    {
      "index": 177,
      "id": "TOKUSEIINFO_177",
      "hash": "84a21d06d65ee1e5",
      "flags": 0,
      "text": "ＨＰが　満タン　だと\\nひこうタイプの　技を\\n先制で　出すことが　できる。"
    },
    {
      "index": 178,
      "id": "TOKUSEIINFO_178",
      "hash": "84a21e06d65ee398",
      "flags": 0,
      "text": "波動の　技の\\n威力が　高くなる。"
    },
    {
      "index": 179,
      "id": "TOKUSEIINFO_179",
      "hash": "84a21f06d65ee54b",
      "flags": 0,
      "text": "グラスフィールドのとき\\n防御が　上がる。"
    },
    {
      "index": 180,
      "id": "TOKUSEIINFO_180",
      "hash": "84d53006d68a5bc7",
      "flags": 0,
      "text": "味方が　道具を　使うと\\n自分の　持っている　道具を\\n味方に　渡す。"
    },
    {
      "index": 181,
      "id": "TOKUSEIINFO_181",
      "hash": "84d52f06d68a5a14",
      "flags": 0,
      "text": "相手に　接触する　技の\\n威力が　高くなる。"
    },
    {
      "index": 182,
      "id": "TOKUSEIINFO_182",
      "hash": "84d53206d68a5f2d",
      "flags": 0,
      "text": "ノーマルタイプの　技が\\nフェアリータイプになる。\\n威力が　少し　上がる。"
    },
    {
      "index": 183,
      "id": "TOKUSEIINFO_183",
      "hash": "84d53106d68a5d7a",
      "flags": 0,
      "text": "攻撃で　自分に　触れた　相手の\\n素早さを　下げる。"
    },
    {
      "index": 184,
      "id": "TOKUSEIINFO_184",
      "hash": "84d52c06d68a54fb",
      "flags": 0,
      "text": "ノーマルタイプの　技が\\nひこうタイプになる。\\n威力が　少し　上がる。"
    },
    {
      "index": 185,
      "id": "TOKUSEIINFO_185",
      "hash": "84d52b06d68a5348",
      "flags": 0,
      "text": "親子　２匹で　２回\\n攻撃することが　できる。"
    },
    {
      "index": 186,
      "id": "TOKUSEIINFO_186",
      "hash": "84d52e06d68a5861",
      "flags": 0,
      "text": "全員の　あくタイプの\\n技が　強くなる。"
    },
    {
      "index": 187,
      "id": "TOKUSEIINFO_187",
      "hash": "84d52d06d68a56ae",
      "flags": 0,
      "text": "全員の　フェアリータイプの\\n技が　強くなる。"
    },
    {
      "index": 188,
      "id": "TOKUSEIINFO_188",
      "hash": "84d52806d68a4e2f",
      "flags": 0,
      "text": "オーラの　効果を　逆転させて\\n威力を　下げる。"
    },
    {
      "index": 189,
      "id": "TOKUSEIINFO_189",
      "hash": "84d52706d68a4c7c",
      "flags": 0,
      "text": "ほのおタイプの　攻撃を\\n受けない　天気にする。"
    },
    {
      "index": 190,
      "id": "TOKUSEIINFO_190",
      "hash": "84d1aa06d687423e",
      "flags": 0,
      "text": "みずタイプの　攻撃を\\n受けない　天気にする。"
    },
    {
      "index": 191,
      "id": "TOKUSEIINFO_191",
      "hash": "84d1ab06d68743f1",
      "flags": 0,
      "text": "ひこうタイプの　弱点が\\nなくなる　天気にする。"
    },
    {
      "index": 192,
      "id": "TOKUSEIINFO_192",
      "hash": "84d1a806d6873ed8",
      "flags": 0,
      "text": "攻撃を　受けると\\n防御が　上がる。"
    },
    {
      "index": 193,
      "id": "TOKUSEIINFO_193",
      "hash": "84d1a906d687408b",
      "flags": 0,
      "text": "ＨＰが　半分に　なると\\nあわてて　逃げ出して\\n手持ちに　引っ込んで　しまう。"
    },
    {
      "index": 194,
      "id": "TOKUSEIINFO_194",
      "hash": "84d1ae06d687490a",
      "flags": 0,
      "text": "ＨＰが　半分に　なると\\n危険を　回避するため\\n手持ちに　引っ込んで　しまう。"
    },
    {
      "index": 195,
      "id": "TOKUSEIINFO_195",
      "hash": "84d1af06d6874abd",
      "flags": 0,
      "text": "みずタイプの　技を　受けると\\n防御が　ぐーんと　上がる。"
    },
    {
      "index": 196,
      "id": "TOKUSEIINFO_196",
      "hash": "84d1ac06d68745a4",
      "flags": 0,
      "text": "どく状態の\\n相手を　攻撃すると\\nかならず　急所に　当たる。"
    },
    {
      "index": 197,
      "id": "TOKUSEIINFO_197",
      "hash": "84d1ad06d6874757",
      "flags": 0,
      "text": "ＨＰが　半分に　なると\\n殻が　壊れて\\n攻撃的に　なる。"
    },
    {
      "index": 198,
      "id": "TOKUSEIINFO_198",
      "hash": "84d1a206d68734a6",
      "flags": 0,
      "text": "交代で　出てきた　相手に\\n２倍の　ダメージで　攻撃　できる。"
    },
    {
      "index": 199,
      "id": "TOKUSEIINFO_199",
      "hash": "84d1a306d6873659",
      "flags": 0,
      "text": "自分に　対する　ほのおタイプの\\n技の　威力を　下げる。\\nやけど　しない。"
    },
    {
      "index": 200,
      "id": "TOKUSEIINFO_200",
      "hash": "8dd05b06dbb7dcaa",
      "flags": 0,
      "text": "はがねタイプの　技の\\n威力が　上がる。"
    },
    {
      "index": 201,
      "id": "TOKUSEIINFO_201",
      "hash": "8dd05c06dbb7de5d",
      "flags": 0,
      "text": "相手の　攻撃で\\nＨＰが　半分に　なると\\n特攻が　上がる。"
    },
    {
      "index": 202,
      "id": "TOKUSEIINFO_202",
      "hash": "8dd05906dbb7d944",
      "flags": 0,
      "text": "天気が　あられ　のとき\\n素早さが　上がる。"
    },
    {
      "index": 203,
      "id": "TOKUSEIINFO_203",
      "hash": "8dd05a06dbb7daf7",
      "flags": 0,
      "text": "すべての　技を\\n相手に　接触　しないで\\n出すことが　できる。"
    },
    {
      "index": 204,
      "id": "TOKUSEIINFO_204",
      "hash": "8dd05706dbb7d5de",
      "flags": 0,
      "text": "すべての　音技が\\nみずタイプに　なる。"
    },
    {
      "index": 205,
      "id": "TOKUSEIINFO_205",
      "hash": "8dd05806dbb7d791",
      "flags": 0,
      "text": "回復技を　先制で\\n出すことが　できる。"
    },
    {
      "index": 206,
      "id": "TOKUSEIINFO_206",
      "hash": "8dd05506dbb7d278",
      "flags": 0,
      "text": "ノーマルタイプの　技が\\nでんきタイプになる。\\n威力が　少し　上がる。"
    },
    {
      "index": 207,
      "id": "TOKUSEIINFO_207",
      "hash": "8dd05606dbb7d42b",
      "flags": 0,
      "text": "エレキフィールド　のとき\\n素早さが　２倍に　なる。"
    },
    {
      "index": 208,
      "id": "TOKUSEIINFO_208",
      "hash": "8dd05306dbb7cf12",
      "flags": 0,
      "text": "ＨＰが　多いときは　群れて　強くなる。\\nＨＰの　残りが　少なくなると\\n群れは　散り散りに　なってしまう。"
    },
    {
      "index": 209,
      "id": "TOKUSEIINFO_209",
      "hash": "8dd05406dbb7d0c5",
      "flags": 0,
      "text": "体を　被う　化けの皮で　\\n１回　攻撃を　防ぐことが　できる。"
    },
    {
      "index": 210,
      "id": "TOKUSEIINFO_210",
      "hash": "8dd3c106dbbabfd3",
      "flags": 0,
      "text": "相手を　倒すと　トレーナーとの\\nキズナが　深まり　サトシゲッコウガに\\n変化する。みずしゅりけんが　強くなる。"
    },
    {
      "index": 211,
      "id": "TOKUSEIINFO_211",
      "hash": "8dd3c006dbbabe20",
      "flags": 0,
      "text": "ＨＰが　半分に　なると\\nセルたちが　応援に　駆けつけ\\nパーフェクトフォルムに　姿を　変える。"
    },
    {
      "index": 212,
      "id": "TOKUSEIINFO_212",
      "hash": "8dd3c306dbbac339",
      "flags": 0,
      "text": "はがねタイプや　どくタイプも\\nどく状態に　することが　できる。"
    },
    {
      "index": 213,
      "id": "TOKUSEIINFO_213",
      "hash": "8dd3c206dbbac186",
      "flags": 0,
      "text": "つねに　夢うつつの　状態で\\n絶対に　目覚めない。\\n眠ったまま　攻撃が　できる。"
    },
    {
      "index": 214,
      "id": "TOKUSEIINFO_214",
      "hash": "8dd3c506dbbac69f",
      "flags": 0,
      "text": "相手に　威圧感を　あたえ\\nこちらに　むかって　先制技を\\n出せない　ようにする。"
    },
    {
      "index": 215,
      "id": "TOKUSEIINFO_215",
      "hash": "8dd3c406dbbac4ec",
      "flags": 0,
      "text": "相手に　倒されたとき\\nＨＰの　残りの　ぶんだけ\\n相手に　ダメージを　あたえる。"
    },
    {
      "index": 216,
      "id": "TOKUSEIINFO_216",
      "hash": "8dd3c706dbbaca05",
      "flags": 0,
      "text": "だれかが　踊り技を　使うと\\n自分も　それに　続いて\\n踊り技を　出すことが　できる。"
    },
    {
      "index": 217,
      "id": "TOKUSEIINFO_217",
      "hash": "8dd3c606dbbac852",
      "flags": 0,
      "text": "味方の　特殊技の\\n威力を　上げる。"
    },
    {
      "index": 218,
      "id": "TOKUSEIINFO_218",
      "hash": "8dd3c906dbbacd6b",
      "flags": 0,
      "text": "相手から　受けた　接触する　技の\\nダメージを　半減するが　ほのおタイプの\\n技の　ダメージは　２倍になる。"
    },
    {
      "index": 219,
      "id": "TOKUSEIINFO_219",
      "hash": "8dd3c806dbbacbb8",
      "flags": 0,
      "text": "相手を　びっくり　させて\\nこちらに　むかって　先制技を\\n出せない　ようにする。"
    },
    {
      "index": 220,
      "id": "TOKUSEIINFO_220",
      "hash": "8dc94f06dbb1a998",
      "flags": 0,
      "text": "ポケモンが　ひんしに　なるたびに\\n特攻が　上がる。"
    },
    {
      "index": 221,
      "id": "TOKUSEIINFO_221",
      "hash": "8dc95006dbb1ab4b",
      "flags": 0,
      "text": "攻撃で　自分に　触れた　相手の\\n素早さを　下げる。"
    },
    {
      "index": 222,
      "id": "TOKUSEIINFO_222",
      "hash": "8dc95106dbb1acfe",
      "flags": 0,
      "text": "倒された　味方の　特性を\\n受け継いで　同じ　特性に　なる。"
    },
    {
      "index": 223,
      "id": "TOKUSEIINFO_223",
      "hash": "8dc95206dbb1aeb1",
      "flags": 0,
      "text": "倒された　味方の　特性を　受け継ぎ\\n同じ　特性に　変わる。"
    },
    {
      "index": 224,
      "id": "TOKUSEIINFO_224",
      "hash": "8dc95306dbb1b064",
      "flags": 0,
      "text": "相手を　倒したとき\\n自分の　いちばん　高い\\n能力が　上がる。　"
    },
    {
      "index": 225,
      "id": "TOKUSEIINFO_225",
      "hash": "8dc95406dbb1b217",
      "flags": 0,
      "text": "持っている　メモリで\\n自分の　タイプが　変わる。"
    },
    {
      "index": 226,
      "id": "TOKUSEIINFO_226",
      "hash": "8dc95506dbb1b3ca",
      "flags": 0,
      "text": "登場　したときに\\nエレキフィールドを　はりめぐらせる。"
    },
    {
      "index": 227,
      "id": "TOKUSEIINFO_227",
      "hash": "8dc95606dbb1b57d",
      "flags": 0,
      "text": "登場　したときに\\nサイコフィールドを　はりめぐらせる。"
    },
    {
      "index": 228,
      "id": "TOKUSEIINFO_228",
      "hash": "8dc94706dbb19c00",
      "flags": 0,
      "text": "登場　したときに\\nミストフィールドを　はりめぐらせる。"
    },
    {
      "index": 229,
      "id": "TOKUSEIINFO_229",
      "hash": "8dc94806dbb19db3",
      "flags": 0,
      "text": "登場　したときに\\nグラスフィールドを　はりめぐらせる。"
    },
    {
      "index": 230,
      "id": "TOKUSEIINFO_230",
      "hash": "8dccd506dbb4c321",
      "flags": 0,
      "text": "相手の　技や　特性で\\n能力を　下げられない。"
    },
    {
      "index": 231,
      "id": "TOKUSEIINFO_231",
      "hash": "8dccd406dbb4c16e",
      "flags": 0,
      "text": "ＨＰが　満タンの　ときに\\n受ける　ダメージが　少なくなる。"
    },
    {
      "index": 232,
      "id": "TOKUSEIINFO_232",
      "hash": "8dccd306dbb4bfbb",
      "flags": 0,
      "text": "効果バツグンに　なってしまう\\n攻撃の　威力を\\n弱める　ことが　できる。"
    },
    {
      "index": 233,
      "id": "TOKUSEIINFO_233",
      "hash": "8dccd206dbb4be08",
      "flags": 0,
      "text": "効果バツグンの　攻撃で\\n威力が　さらに　上がる。"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_tokuseiinfo_max",
      "hash": "7c55fa6c8ed2c7fc"
    }
  ]
}
