  "lines": [
    {
      "index": 0,
      "id": "error_b_serial_0031",
      "hash": "9fffc5c9d544e636",
      "flags": 0,
      "text": "シリアルコード認証のサーバーで\\nエラーが発生しました。\\nしばらく時間をおいてから\\nもう一度お試しください。\\n"
    },
    {
      "index": 1,
      "id": "error_b_serial_0031_p",
      "hash": "1ef4d5f90d2979e1",
      "flags": 0,
      "text": "認証サーバーでエラーが発生しました。\\nしばらく時間をおいてから\\nもう一度お試しください。"
    },
    {
      "index": 2,
      "id": "error_b_serial_0091",
      "hash": "a021c1c9d561c5d0",
      "flags": 0,
      "text": "シリアルコード認証のサーバーは\\nメンテナンス中のため通信できません。\\nしばらく時間をおいてから\\nもう一度お試しください。"
    },
    {
      "index": 3,
      "id": "error_b_serial_0091_p",
      "hash": "5d35364c69f3b297",
      "flags": 0,
      "text": "認証サーバーがメンテナンス中のため\\n通信できません。\\nしばらく時間をおいてから\\nもう一度お試しください。"
    },
    {
      "index": 4,
      "id": "error_b_serial_0092",
      "hash": "a021c4c9d561cae9",
      "flags": 0,
      "text": "ご利用のサービスは終了いたしました。"
    },
    {
      "index": 5,
      "id": "error_b_serial_0092_p",
      "hash": "77619b4c78d4bdf6",
      "flags": 0,
      "text": "ご利用のサービスは終了いたしました。"
    },
    {
      "index": 6,
