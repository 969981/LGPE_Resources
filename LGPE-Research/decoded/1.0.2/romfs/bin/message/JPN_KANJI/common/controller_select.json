{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "cnt_select_win_01",
      "hash": "209514ec56c75baa",
      "flags": 0,
      "text": "使う　コントローラーの　ボタンを\\n押してください"
    },
    {
      "index": 1,
      "id": "cnt_select_win_02",
      "hash": "209513ec56c759f7",
      "flags": 0,
      "text": "こちらの　コントローラーで\\nよろしいですか？"
    },
    {
      "index": 2,
      "id": "cnt_select_win_03",
      "hash": "209512ec56c75844",
      "flags": 0,
      "text": "ボタンの　割り当てを\\n変更　しました"
    },
    {
      "index": 3,
      "id": "cnt_select_win_04",
      "hash": "209511ec56c75691",
      "flags": 0,
      "text": "完了していません\\n準備を　中止　しますか？"
    },
    {
      "index": 4,
      "id": "cnt_select_win_05",
      "hash": "209510ec56c754de",
      "flags": 0,
      "text": "準備が\\n完了　しました！"
    },
    {
      "index": 5,
      "id": "cnt_select_win_06",
      "hash": "20950fec56c7532b",
      "flags": 0,
      "text": "準備　しています……\\n電源を　切らないでください"
    },
    {
      "index": 6,
      "id": "cnt_select_win_07",
      "hash": "20950eec56c75178",
      "flags": 0,
      "text": "エラーが　発生しました\\n\\nもう一度　はじめから\\nやりなおしてください"
    },
    {
      "index": 7,
      "id": "cnt_select_win_08",
      "hash": "20950dec56c74fc5",
      "flags": 0,
      "text": "モンスターボール Plusに　プレゼントの\\nポケモンが　入って　います！\\n\\n「メニュー」から　「通信」を　選び\\n「ふしぎなおくりもの」に　いってみましょう！"
    },
    {
      "index": 8,
      "id": "cnt_select_win_09",
      "hash": "20950cec56c74e12",
      "flags": 0,
      "text": "ふたりめが　使う　コントローラーを\\n選んでください"
    },
    {
      "index": 9,
      "id": "cnt_select_win_10",
      "hash": "20918fec56c443d4",
      "flags": 0,
      "text": "モンスターボール Plusの　ボタンを\\n入れかえますか？"
    },
    {
      "index": 10,
      "id": "cnt_select_win_11",
      "hash": "209190ec56c44587",
      "flags": 0,
      "text": "ひとりめが　使う　コントローラーを\\n選んでください"
    },
    {
      "index": 11,
      "id": "cnt_select_win_12",
      "hash": "209191ec56c4473a",
      "flags": 0,
      "text": "通信　しています"
    },
    {
      "index": 12,
      "id": "cnt_select_info_01",
      "hash": "b671815c01514bc8",
      "flags": 0,
      "text": "モンスターボール Plusを　使って\\n遊んで　いるときは\\nトップボタンを　押すと\\nメニュー画面が　ひらきます"
    },
    {
      "index": 13,
      "id": "cnt_select_info_02",
      "hash": "b671845c015150e1",
      "flags": 0,
      "text": "メニュー画面で\\nモンスターボール Plusを　２回　振ると\\n設定画面が　ひらきます"
    },
    {
      "index": 14,
      "id": "cnt_select_info_03",
      "hash": "b671835c01514f2e",
      "flags": 0,
      "text": "Joy-Con(R)を　使って\\n遊んで　いるときは\\nＸボタンを　押すと\\nメニュー画面を　ひらきます"
    },
    {
      "index": 15,
      "id": "cnt_select_info_04",
      "hash": "b671865c01515447",
      "flags": 0,
      "text": "Joy-Con(R)を　使っているとき\\n\\n・Ｒスティックボタン\\n・Ｒボタン\\n・ＺＲボタン\\n\\nは　「決定」に　なります"
    },
    {
      "index": 16,
      "id": "cnt_select_info_05",
      "hash": "b671855c01515294",
      "flags": 0,
      "text": "Joy-Con(L)を　使って\\n遊んで　いるときは\\n上ボタンを　押すと\\nメニュー画面を　ひらきます"
    },
    {
      "index": 17,
      "id": "cnt_select_info_06",
      "hash": "b671885c015157ad",
      "flags": 0,
      "text": "Joy-Con(L)を　使っているとき\\n\\n・Ｌスティックボタン\\n・Ｌボタン\\n・ＺＬボタン\\n\\nは　「決定」に　なります"
    },
    {
      "index": 18,
      "id": "cnt_select_info_07",
      "hash": "b671875c015155fa",
      "flags": 0,
      "text": "携帯モードで\\n遊んで　いるときは\\nＸボタンを　押すと\\nメニュー画面を　ひらきます"
    },
    {
      "index": 19,
      "id": "cnt_select_info_08",
      "hash": "b6717a5c01513fe3",
      "flags": 0,
      "text": "携帯モードで\\nＲスティックボタンは\\n「決定」に　なります\\n\\nタッチスクリーンは\\n一部の　画面でのみ　使います"
    },
    {
      "index": 20,
      "id": "cnt_select_sel_01",
      "hash": "b34042664de9fcd8",
      "flags": 0,
      "text": "決定"
    },
    {
      "index": 21,
      "id": "cnt_select_sel_02",
      "hash": "b34045664dea01f1",
      "flags": 0,
      "text": "詳しく見る"
    },
    {
      "index": 22,
      "id": "cnt_select_sel_03",
      "hash": "b34044664dea003e",
      "flags": 0,
      "text": "ボタンを変える"
    },
    {
      "index": 23,
      "id": "cnt_select_sel_04",
      "hash": "b34047664dea0557",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 24,
      "id": "cnt_select_sel_05",
      "hash": "b34046664dea03a4",
      "flags": 0,
      "text": "はい"
    },
    {
      "index": 25,
      "id": "cnt_select_sel_06",
      "hash": "b34049664dea08bd",
      "flags": 0,
      "text": "いいえ"
    },
    {
      "index": 26,
      "id": "cnt_select_capl_01",
      "hash": "310f5ccf5db00de8",
      "flags": 0,
      "text": "Ｒスティック"
    },
