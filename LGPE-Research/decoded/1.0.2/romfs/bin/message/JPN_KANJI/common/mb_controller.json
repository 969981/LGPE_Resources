{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "mb_ctr_win_01",
      "hash": "554d391f561df61b",
      "flags": 0,
      "text": "モンスターボール Plusで\\nお出かけちゅうの　ポケモンが\\nそだてやさんに　預けられているため\\n戻ることが　できません\\n\\n預けた　ポケモンを　引き取ってから\\nもう一度　おためしください"
    },
    {
      "index": 1,
      "id": "mb_ctr_win_02",
      "hash": "554d3a1f561df7ce",
      "flags": 0,
      "text": "通信　しています……\\n電源を　切らないでください"
    },
    {
      "index": 2,
      "id": "mb_ctr_win_03",
      "hash": "554d3b1f561df981",
      "flags": 0,
      "text": "モンスターボール Plusに\\nポケモンを　入れて　お出かけしましょう！\\n\\n一緒に　歩いて　遊んで　あげると\\nポケモンが　すくすく　育ちます\\n\\nたくさん　歩いて　遊んでいると\\nすてきな　ごほうびも　手に　入ります"
    },
    {
      "index": 3,
      "id": "mb_ctr_win_04",
      "hash": "554d3c1f561dfb34",
      "flags": 0,
      "text": "モンスターボール Plusに　プレゼントの\\nポケモンが　入って　います！\\n\\nコントローラーとして　つなげて\\n「ふしぎなおくりもの」に　いってみましょう！\\n\\nプレゼントの　ポケモンを　受け取るまで\\nお出かけは　できません"
    },
    {
      "index": 4,
      "id": "mb_ctr_win_05",
      "hash": "554d3d1f561dfce7",
      "flags": 0,
      "text": "[~ 4]"
    },
    {
      "index": 5,
      "id": "mb_ctr_win_06",
      "hash": "554d3e1f561dfe9a",
      "flags": 0,
      "text": "準備　しています……\\n電源を　切らないで　ください"
    },
    {
      "index": 6,
      "id": "mb_ctr_win_07",
      "hash": "554d3f1f561e004d",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]　と　お出かけしましょう！\\n\\nゲームを　遊んでいないとき\\nモンスターボール Plusの\\n[VAR COLOR(0006)]スティックボタンを　長押し[VAR COLOR(0000)]　すると\\n[VAR PKNICK(0000)]　と　遊べます\\n\\nお出かけから　戻りたい　ときは\\n「ポケモンと　お出かけ　する」を\\nもう一度　選んでください"
    },
    {
      "index": 7,
      "id": "mb_ctr_win_08",
      "hash": "554d301f561de6d0",
      "flags": 0,
      "text": "モンスターボール Plusの　ボタンを　押して\\n繋げてください\\n\\nモンスターボール Plusが　繋がったら\\nスティックボタンを　押してください"
    },
    {
      "index": 8,
      "id": "mb_ctr_win_09",
      "hash": "554d311f561de883",
      "flags": 0,
      "text": "お出かけちゅうの　ポケモンが　います\\n戻しますか？"
    },
    {
      "index": 9,
      "id": "mb_ctr_win_10",
      "hash": "55503e1f56203471",
      "flags": 0,
      "text": "お出かけする　ポケモンを\\n選んでください"
    },
    {
      "index": 10,
      "id": "mb_ctr_win_11",
      "hash": "55503d1f562032be",
      "flags": 0,
      "text": "他の　プレイヤーの\\nお出かけちゅうの　記録が　あります\\c\\nこのまま　お出かけすると\\n消えてしまいますが　よろしいですか？"
    },
    {
      "index": 11,
      "id": "mb_ctr_win_12",
      "hash": "55503c1f5620310b",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "mb_ctr_win_13",
      "hash": "55503b1f56202f58",
      "flags": 0,
      "text": "お出かけちゅうの　ポケモンが　います\\n戻しますか？"
    },
    {
      "index": 13,
      "id": "mb_ctr_win_14",
      "hash": "5550421f56203b3d",
      "flags": 0,
      "text": "お出かけを　やめますか？"
    },
    {
      "index": 14,
      "id": "mb_ctr_win_15",
      "hash": "5550411f5620398a",
      "flags": 0,
      "text": "通信　しています……"
    },
    {
      "index": 15,
      "id": "mb_ctr_win_16",
      "hash": "5550401f562037d7",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]と\\n最高に　楽しく　お出かけした！"
    },
    {
      "index": 16,
      "id": "mb_ctr_win_17",
      "hash": "55503f1f56203624",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]と\\nとっても　楽しく　お出かけした！"
    },
    {
      "index": 17,
      "id": "mb_ctr_win_18",
      "hash": "5550361f562026d9",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]と\\n楽しく　お出かけした！"
    },
    {
      "index": 18,
      "id": "mb_ctr_win_19",
      "hash": "5550351f56202526",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]と\\nお出かけした！"
    },
    {
      "index": 19,
      "id": "mb_ctr_win_20",
      "hash": "5553c41f56234dfa",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は\\nお出かけの　ごほうびを　手に入れた！"
    },
    {
      "index": 20,
      "id": "mb_ctr_win_20_s",
      "hash": "736f69acb4ca67c4",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は\\nお出かけの　ごほうびを　手に入れた！"
    },
    {
      "index": 21,
      "id": "mb_ctr_win_21",
      "hash": "5553c51f56234fad",
      "flags": 0,
      "text": "完了していません\\n準備を　中止　しますか？"
    },
    {
      "index": 22,
      "id": "mb_ctr_win_22",
      "hash": "5553c21f56234a94",
      "flags": 0,
      "text": "これまでの　お出かけ記録　を\\n更新　した！"
    },
    {
      "index": 23,
      "id": "mb_ctr_win_23",
      "hash": "5553c31f56234c47",
      "flags": 0,
      "text": "モンスターボール Plusでは　ない\\nコントローラーが　繋がりました\\c\\nお出かけを　やめますか？"
    },
    {
      "index": 24,
      "id": "mb_ctr_win_24",
      "hash": "5553c01f5623472e",
      "flags": 0,
      "text": "準備が\\n完了　しました！"
    },
    {
      "index": 25,
      "id": "mb_ctr_win_25",
      "hash": "5553c11f562348e1",
      "flags": 0,
      "text": "選んだ　ポケモンは\\n別の　モンスターボール Plusで\\r\\nすでに　お出かけ　しています\\c\\nこのまま　お出かけすると\\n別の　モンスターボール Plusの　記録は\\r\\n反映　されなく　なりますが\\r\\nよろしいですか？"
    },
    {
      "index": 26,
      "id": "mb_ctr_win_26",
      "hash": "5553be1f562343c8",
      "flags": 0,
      "text": "[VAR COLOR(0002)]一緒に　歩いた[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　達成した！"
    },
    {
      "index": 27,
      "id": "mb_ctr_win_27",
      "hash": "5553bf1f5623457b",
      "flags": 0,
      "text": "[VAR COLOR(0002)]遊んだ[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　達成した！"
    },
    {
      "index": 28,
      "id": "mb_ctr_win_28",
      "hash": "5553bc1f56234062",
      "flags": 0,
      "text": "[VAR COLOR(0002)]楽しく　遊んだ[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　達成した！"
    },
    {
      "index": 29,
      "id": "mb_ctr_win_29",
      "hash": "5553bd1f56234215",
      "flags": 0,
      "text": "[VAR COLOR(0002)]とっても　楽しく　遊んだ[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　達成した！"
    },
    {
      "index": 30,
      "id": "mb_ctr_win_30",
      "hash": "55572a1f56263123",
      "flags": 0,
      "text": "[VAR COLOR(0002)][VAR TRNAME(0001)]に　呼びかけた　[VAR COLOR(0000)]を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　達成した！"
    },
    {
      "index": 31,
      "id": "mb_ctr_win_31",
      "hash": "5557291f56262f70",
      "flags": 0,
      "text": "[VAR COLOR(0002)]呼びかけに　こたえた[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　達成した！"
    },
    {
      "index": 32,
      "id": "mb_ctr_win_32",
      "hash": "55572c1f56263489",
      "flags": 0,
      "text": "[VAR COLOR(0002)]Pokémon GO　頑張った[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　達成した！"
    },
    {
      "index": 33,
      "id": "mb_ctr_win_33",
      "hash": "55572b1f562632d6",
      "flags": 0,
      "text": "[VAR COLOR(0002)]Pokémon GO　助けた[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　達成した！"
    },
    {
      "index": 34,
      "id": "mb_ctr_win_34",
      "hash": "55572e1f562637ef",
      "flags": 0,
      "text": "レポートを　書いています\\n電源を　切らないでください"
    },
    {
      "index": 35,
      "id": "mb_ctr_cap_01",
      "hash": "8040b256847fd729",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 36,
      "id": "mb_ctr_cap_02",
      "hash": "8040af56847fd210",
      "flags": 0,
      "text": "【今回の　お出かけ記録】"
    },
    {
      "index": 37,
      "id": "mb_ctr_cap_03",
      "hash": "8040b056847fd3c3",
      "flags": 0,
      "text": "・一緒に　歩いた"
    },
    {
      "index": 38,
      "id": "mb_ctr_cap_04",
      "hash": "8040b556847fdc42",
      "flags": 0,
      "text": "・遊んだ"
    },
    {
      "index": 39,
      "id": "mb_ctr_cap_05",
      "hash": "8040b656847fddf5",
      "flags": 0,
      "text": "・楽しく　遊んだ"
    },
    {
      "index": 40,
      "id": "mb_ctr_cap_06",
      "hash": "8040b356847fd8dc",
      "flags": 0,
      "text": "・とっても　楽しく　遊んだ"
    },
    {
      "index": 41,
      "id": "mb_ctr_cap_07",
      "hash": "8040b456847fda8f",
      "flags": 0,
      "text": "・[VAR TRNAME(0000)]に　呼びかけた"
    },
    {
      "index": 42,
      "id": "mb_ctr_cap_08",
      "hash": "8040b956847fe30e",
      "flags": 0,
      "text": "・呼びかけに　こたえた"
    },
    {
      "index": 43,
      "id": "mb_ctr_cap_09",
      "hash": "8040ba56847fe4c1",
      "flags": 0,
      "text": "・Pokémon GOを　頑張った"
    },
    {
      "index": 44,
