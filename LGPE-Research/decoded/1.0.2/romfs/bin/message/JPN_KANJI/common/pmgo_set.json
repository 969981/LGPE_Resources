{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "pmgo_set_win_01",
      "hash": "50aeeea835eb51b0",
      "flags": 0,
      "text": "Pokémon GOと　通信　できるように\\nペアリングを　おこないますか？"
    },
    {
      "index": 1,
      "id": "pmgo_set_win_02",
      "hash": "50aef1a835eb56c9",
      "flags": 0,
      "text": "Pokémon GOを　探しています"
    },
    {
      "index": 2,
      "id": "pmgo_set_win_03",
      "hash": "50aef0a835eb5516",
      "flags": 0,
      "text": "[VAR PGOTRAINER(0000)]さんを　見つけました\\nペアリング　しますか？"
    },
    {
      "index": 3,
      "id": "pmgo_set_win_04",
      "hash": "50aef3a835eb5a2f",
      "flags": 0,
      "text": "通信　しています\\n電源を　切らないでください"
    },
    {
      "index": 4,
      "id": "pmgo_set_win_05",
      "hash": "50aef2a835eb587c",
      "flags": 0,
      "text": "[VAR PGOTRAINER(0000)]さんの\\nPokémon GOと　ペアリング　しました！\\n\\nセキチクシティに　ある\\nＧＯパークで\\nポケモンの　転送が　できます"
    },
    {
      "index": 5,
      "id": "pmgo_set_win_06",
      "hash": "50aef5a835eb5d95",
      "flags": 0,
      "text": "[VAR GOPARKLOCAL(0001)]には\\nあと　[VAR NUM3(0000)]匹　連れていけます"
    },
    {
      "index": 6,
      "id": "pmgo_set_win_07",
      "hash": "50aef4a835eb5be2",
      "flags": 0,
      "text": "[VAR GOPARKLOCAL(0000)]への\\n転送は　ポケモンの数が\\n５０匹を　こえるため　できません\\n\\n[VAR GOPARKLOCAL(0000)]の\\nポケモンを　整理するか\\n他の　ＧＯパークを　選んでください"
    },
    {
      "index": 7,
      "id": "pmgo_set_win_08",
      "hash": "50aef7a835eb60fb",
      "flags": 0,
      "text": "Pokémon GOと　ペアリング\\nされていません\\n\\nＸメニューの　「設定」から\\n「Pokémon GOと　接続」を　選び\\nペアリング　してください"
    },
    {
      "index": 8,
      "id": "pmgo_set_win_09",
      "hash": "50aef6a835eb5f48",
      "flags": 0,
      "text": "復旧　するため\\nPokémon GOと　通信　しています\\n電源を　切らずに\\nそのまま　お待ちください"
    },
    {
      "index": 9,
      "id": "pmgo_set_win_10",
      "hash": "50ab89a835e8703a",
      "flags": 0,
      "text": "転送しようとした　ポケモンが\\n消えてしまう　可能性が　あります\\n本当に　やめても　よろしいですか？"
    },
    {
      "index": 10,
      "id": "pmgo_set_win_11",
      "hash": "50ab8aa835e871ed",
      "flags": 0,
      "text": "Pokémon GOに　ポケモンが\\n残っています\\n\\nもう一度　はじめから\\nやりおなして　ください"
    },
    {
      "index": 11,
      "id": "pmgo_set_win_12",
      "hash": "50ab87a835e86cd4",
      "flags": 0,
      "text": "終了　しています\\nしばらく　お待ちください"
    },
    {
      "index": 12,
      "id": "pmgo_set_win_13",
      "hash": "50ab88a835e86e87",
      "flags": 0,
      "text": "[VAR PGOTRAINER(0000)]さんの\\nPokémon GOから\\nポケモンが　[VAR NUM4(0001,0000)]匹\\n転送　されました\\n\\n[VAR GOPARKLOCAL(0002)]を\\nのぞいてみましょう！"
    },
    {
      "index": 13,
      "id": "pmgo_set_win_14",
      "hash": "50ab85a835e8696e",
      "flags": 0,
      "text": "[VAR PGOTRAINER(0000)]さんが　転送する\\nポケモンは　[VAR NUM4(0001,0000)]匹　ですが\\n[VAR GOPARKLOCAL(0003)]には\\nあと　[VAR NUM3(0002)]匹しか　入りません"
    },
    {
      "index": 14,
      "id": "pmgo_set_win_15",
      "hash": "50ab86a835e86b21",
      "flags": 0,
      "text": "[VAR PGOTRAINER(0000)]さんを　見つけました\\nポケモンを　受けとりますか？"
    },
    {
      "index": 15,
      "id": "pmgo_set_win_16",
      "hash": "50ab83a835e86608",
      "flags": 0,
      "text": "『ポケットモンスター Let's Go! ピカチュウ・\\nLet's Go! イーブイ』を\\n『Pokémon GO』に　接続する際に\\nゲーム識別ユーザーID\\nゲームの技術情報が\\n『Pokémon GO』に　送信されます"
    },
    {
      "index": 16,
      "id": "pmgo_set_sel_01",
      "hash": "4950366029620392",
      "flags": 0,
      "text": "はい"
    },
    {
      "index": 17,
      "id": "pmgo_set_sel_02",
      "hash": "49503560296201df",
      "flags": 0,
      "text": "いいえ"
    },
    {
      "index": 18,
      "id": "pmgo_set_sel_03",
      "hash": "495034602962002c",
      "flags": 0,
      "text": "続ける"
    },
    {
      "index": 19,
      "id": "pmgo_set_sel_04",
      "hash": "495033602961fe79",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 20,
      "id": "pmgo_set_sel_05",
      "hash": "495032602961fcc6",
      "flags": 0,
      "text": "通信を　開始する"
    },
    {
      "index": 21,
      "id": "pmgo_set_cap_01",
      "hash": "619e152042febb32",
      "flags": 0,
      "text": "はじめる"
    },
    {
      "index": 22,
      "id": "pmgo_set_cap_02",
      "hash": "619e142042feb97f",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 23,
      "id": "pmgo_set_cap_03",
      "hash": "619e132042feb7cc",
      "flags": 0,
      "text": "おわる"
    },
    {
      "index": 24,
      "id": "pmgo_set_cap_04",
      "hash": "619e122042feb619",
      "flags": 0,
      "text": "[VAR NUM3(0000)]％"
    }
  ],
