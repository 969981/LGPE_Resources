    },
    {
      "index": 87,
      "id": "go_park_60_11",
      "hash": "24879ef567576046",
      "flags": 0,
      "text": "移動する"
    },
    {
      "index": 88,
      "id": "go_park_70_01",
      "hash": "b46a7ac07b9d68a0",
      "flags": 0,
      "text": "[VAR NUM2(0000)]:[VAR NUM2(0001)].[VAR NUM2(0002)]"
    },
    {
      "index": 89,
      "id": "go_park_80_01",
      "hash": "82fa3762ec0872bd",
      "flags": 0,
      "text": "ＧＯパークの　ポケモンを\\n捕まえると　ポケモンの　情報が\\nPokémon GOに　いた　ときと\\n変わりますが　よろしい　ですか？"
    },
    {
      "index": 90,
      "id": "go_park_90_01",
      "hash": "950ad72a53682d1a",
      "flags": 0,
      "text": "[VAR NUM3(0000)]"
    },
    {
      "index": 91,
      "id": "go_park_100_01",
      "hash": "3b2093cb115b62e2",
      "flags": 0,
      "text": "ポケモンを　ゴールへ　導こう！\\nＸ：メニュー　Ｙ：ズーム"
    }
