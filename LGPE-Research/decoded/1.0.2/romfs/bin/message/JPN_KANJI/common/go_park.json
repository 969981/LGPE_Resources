    },
    {
      "index": 64,
      "id": "go_park_50_03",
      "hash": "fb41418dbfc4c1a0",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]の　最高記録"
    },
    {
      "index": 65,
      "id": "go_park_55_01",
      "hash": "a279077478cf9dbf",
      "flags": 0,
      "text": "何を　しますか？\\n[VAR COLOR(0006)]Ｙ：ズーム[VAR COLOR(0000)]"
    },
    {
      "index": 66,
      "id": "go_park_55_02",
      "hash": "a279087478cf9f72",
      "flags": 0,
      "text": "レポートを　書く"
    },
    {
      "index": 67,
      "id": "go_park_55_03",
      "hash": "a279097478cfa125",
      "flags": 0,
      "text": "受付に　もどる"
    },
    {
      "index": 68,
      "id": "go_park_55_05",
      "hash": "a279037478cf96f3",
      "flags": 0,
      "text": "ようすを　みる"
    },
    {
      "index": 69,
      "id": "go_park_55_04",
      "hash": "a279027478cf9540",
      "flags": 0,
      "text": "なにも　しない"
    },
    {
      "index": 70,
      "id": "go_park_55_06",
      "hash": "a279047478cf98a6",
      "flags": 0,
      "text": "[VAR ITEM2(0000)]を\\n[VAR NUM3(0001)]コ　プレゼント！"
    },
    {
      "index": 71,
      "id": "go_park_55_07",
      "hash": "a279057478cf9a59",
      "flags": 0,
      "text": "[VAR COLOR(0006)][VAR BAG(0001)][VAR COLOR(0000)]に　しまった"
    },
    {
      "index": 72,
      "id": "go_park_55_10",
      "hash": "a27c8c7478d2b595",
      "flags": 0,
      "text": "レポートを　書きますか？"
    },
    {
      "index": 73,
      "id": "go_park_55_11",
      "hash": "a27c8b7478d2b3e2",
      "flags": 0,
      "text": "ポケモンレポートに　書き込んでいます\\n電源を　切らないで　ください"
    },
    {
      "index": 74,
      "id": "go_park_55_12",
      "hash": "a27c8a7478d2b22f",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は\\nレポートに　しっかり　書き残した！"
    },
    {
      "index": 75,
      "id": "go_park_55_13",
      "hash": "a27c897478d2b07c",
      "flags": 0,
      "text": "レポートの　記録に　失敗しました"
    },
    {
      "index": 76,
      "id": "go_park_60_00",
      "hash": "248419f567544870",
      "flags": 0,
