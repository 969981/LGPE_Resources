  "lines": [
    {
      "index": 0,
      "id": "go_park_00_01",
      "hash": "7fbbaaedc1e6df95",
      "flags": 0,
      "text": "ＧＯパークへ　ようこそ！"
    },
    {
      "index": 1,
      "id": "go_park_00_02",
      "hash": "7fbba7edc1e6da7c",
      "flags": 0,
      "text": "どの　説明を　ききますか？"
    },
    {
      "index": 2,
      "id": "go_park_00_03",
      "hash": "7fbba8edc1e6dc2f",
      "flags": 0,
      "text": "何を　しますか？"
    },
    {
      "index": 3,
      "id": "go_park_00_10",
      "hash": "7fbf2fedc1e9f76b",
      "flags": 0,
      "text": "ポケモンを　連れてくる"
    },
    {
      "index": 4,
      "id": "go_park_00_11",
      "hash": "7fbf2eedc1e9f5b8",
      "flags": 0,
      "text": "ＧＯパーク"
    },
    {
      "index": 5,
      "id": "go_park_00_12",
      "hash": "7fbf31edc1e9fad1",
      "flags": 0,
      "text": "プレイエリア"
    },
    {
      "index": 6,
      "id": "go_park_00_13",
      "hash": "7fbf30edc1e9f91e",
      "flags": 0,
      "text": "説明を　きく"
    },
    {
      "index": 7,
      "id": "go_park_00_14",
      "hash": "7fbf33edc1e9fe37",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 8,
      "id": "go_park_00_15",
      "hash": "7fbf32edc1e9fc84",
      "flags": 0,
      "text": "連れてくるに　ついて"
    },
    {
      "index": 9,
      "id": "go_park_00_16",
      "hash": "7fbf35edc1ea019d",
      "flags": 0,
      "text": "ＧＯパークに　ついて"
    },
    {
      "index": 10,
      "id": "go_park_00_17",
      "hash": "7fbf34edc1e9ffea",
      "flags": 0,
      "text": "プレイエリアに　ついて"
    },
    {
      "index": 11,
      "id": "go_park_00_20",
      "hash": "7fb51dedc1e18450",
      "flags": 0,
      "text": "Pokémon GOの　ポケモンを\\nＧＯパークに　連れて　こられます\\c\\nまず　Ｘメニューの　「設定」で\\n「Pokémon GOと　接続」を　選び\\r\\nPokémon GOと　ペアリング　します\\c\\nつぎに　Pokémon GOで\\n送りたい　ポケモンを\\r\\n選んで　ください\\c\\n連れてきた　ポケモンは\\nPokémon GOには　戻せないので\\r\\nご注意　ください"
    },
    {
      "index": 12,
      "id": "go_park_00_21",
      "hash": "7fb51eedc1e18603",
      "flags": 0,
      "text": "ＧＯパークでは　Pokémon GOから\\n連れてきた　ポケモン　たちが\\r\\n遊んで　います\\c\\nポケモンに　話しかけると\\n捕まえたり　他の\\r\\nＧＯパークに　移動できます\\c\\n捕まえた　ポケモンは\\nＧＯパークには　もどせません\\c\\nＧＯパークから　帰るときは\\nＸボタンを　押してください"
    },
    {
      "index": 13,
      "id": "go_park_00_22",
      "hash": "7fb51fedc1e187b6",
      "flags": 0,
      "text": "同じ　種類の　ポケモンが\\nＧＯパークに　２５匹　いれば\\r\\nプレイエリアで　遊べます\\c\\nポケモン　たちを　導いて\\nうえの　ゴールまで\\r\\n連れていって　あげましょう！\\c\\n制限時間内に　ポケモンを　全部\\n連れて　いければ　クリアです！\\c\\n地面　から　出てくる\\nお邪魔ポケモンに　気をつけて！\\c\\n途中で　やめる　ときは\\nＸボタンを　押してください"
    },
    {
      "index": 14,
      "id": "go_park_01_01",
      "hash": "d5055ee3b2da9820",
      "flags": 0,
      "text": "ＧＯパーク１"
    },
    {
      "index": 15,
      "id": "go_park_01_02",
      "hash": "d50561e3b2da9d39",
      "flags": 0,
