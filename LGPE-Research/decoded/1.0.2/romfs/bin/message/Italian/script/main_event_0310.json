{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0310_rocketm_01",
      "hash": "d0bf455f5b512f68",
      "flags": 0,
      "text": "Congratulazioni!\\nHai battuto i nostri cinque Allenatori!\\c\\nMeriti un premio favoloso!"
    },
    {
      "index": 1,
      "id": "msg_main0310_sys_01",
      "hash": "fda0b6542407ea06",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve una Pepita\\ndal misterioso Allenatore!"
    },
    {
      "index": 2,
      "id": "msg_main0310_rocketm_02",
      "hash": "d0bf485f5b513481",
      "flags": 0,
      "text": "Devo farti una proposta, ma che rimanga\\ntra noi... Ti va di unirti al Team Rocket?"
    },
    {
      "index": 3,
      "id": "msg_main0310_rocketm_04",
      "hash": "d0bf4a5f5b5137e7",
      "flags": 0,
      "text": "Voilà!"
    },
    {
      "index": 4,
      "id": "msg_main0310_rocketm_05",
      "hash": "d0bf495f5b513634",
      "flags": 0,
      "text": "Siamo una banda che sfrutta i Pokémon\\nper scopi malvagi!"
    },
    {
      "index": 5,
      "id": "msg_main0310_rocketm_06",
      "hash": "d0bf4c5f5b513b4d",
      "flags": 4,
      "text": "Allora, che ne dici? Vuoi diventare dei nostri?"
    },
    {
      "index": 6,
      "id": "msg_main0310_rocketm_07",
      "hash": "d0bf4b5f5b51399a",
      "flags": 0,
      "text": "Davvero non ti va?"
    },
    {
      "index": 7,
      "id": "msg_main0310_rocketm_08",
      "hash": "d0bf3e5f5b512383",
      "flags": 0,
      "text": "Dai, entra a far parte del nostro gruppo!"
    },
    {
      "index": 8,
      "id": "msg_main0310_rocketm_09",
      "hash": "d0bf3d5f5b5121d0",
      "flags": 0,
      "text": "Ti ho detto di unirti a noi!"
    },
    {
      "index": 9,
      "id": "msg_main0310_rocketm_10",
      "hash": "d0bbc05f5b4e1792",
      "flags": 4,
      "text": "E va bene, se non ti ho convinto con le buone...\\nPassiamo alle cattive!"
    },
    {
      "index": 10,
      "id": "msg_main0310_rocketm_11",
      "hash": "d0bbc15f5b4e1945",
      "flags": 4,
      "text": "Uaaaaaargh!"
    },
    {
      "index": 11,
      "id": "msg_main0150_dummy_01",
      "hash": "ff67b6d57bb9318b",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_main0310_rocketm_03",
      "hash": "d0bf475f5b5132ce",
      "flags": 0,
      "text": "Con le capacità che hai potresti fare strada\\nnel Team Rocket!"
    },
    {
      "index": 13,
      "id": "msg_main0310_rocketm_12",
      "hash": "d0bbbe5f5b4e142c",
      "flags": 0,
      "text": "Congratulazioni!\\nHai battuto i nostri cinque Allenatori!"
    }
  ],
