{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub006_oldm_01",
      "hash": "6b7f95cf983378ea",
      "flags": 4,
      "text": "Ehm... Io... Io sono...\\nMa... chi sarei io, scusa...?\\c\\nUff... Non mi ricordo niente..."
    },
    {
      "index": 1,
      "id": "msg_sub006_oldm_02",
      "hash": "6b7f94cf98337737",
      "flags": 4,
      "text": "Uhm? Non è che per caso sai chi sono?"
    },
    {
      "index": 2,
      "id": "msg_sub006_select_01",
      "hash": "e6cb1b343fe19c5a",
      "flags": 4,
      "text": "Il Cancellamosse"
    },
    {
      "index": 3,
      "id": "msg_sub006_select_02",
      "hash": "e6cb1a343fe19aa7",
      "flags": 4,
      "text": "Il Mago Brillio"
    },
    {
      "index": 4,
      "id": "msg_sub006_select_03",
      "hash": "e6cb19343fe198f4",
      "flags": 0,
      "text": "Non saprei..."
    },
    {
      "index": 5,
      "id": "msg_sub006_oldm_03",
      "hash": "6b7f93cf98337584",
      "flags": 0,
      "text": "Cosa?! Sono... il Cancellamosse?\\c\\nDavvero? Ma sei sicur[VAR GENDBR(00FF,0101)]oa?\\nSecondo me ti sbagli."
    },
    {
      "index": 6,
      "id": "msg_sub006_oldm_04",
      "hash": "6b7f92cf983373d1",
      "flags": 8,
      "text": "Scusa se ti ho fatto una domanda così strana!\\nNon farci caso."
    },
    {
      "index": 7,
      "id": "msg_sub006_oldm_05",
      "hash": "6b7f91cf9833721e",
      "flags": 0,
      "text": "Cosa?! Sono... il Mago Brillio?\\c\\nMmh... Mago Brillio... Però... suona proprio bene!\\c\\nDev’essere così... Ma sì, hai ragione!\\nSono il Mago Brillio!"
    },
    {
      "index": 8,
      "id": "msg_sub006_oldm_06",
      "hash": "6b7f90cf9833706b",
      "flags": 0,
      "text": "Meriti un ringraziamento per avermi aiutato a\\nricordare chi sono. Ecco, prendi questa!"
    },
    {
      "index": 9,
      "id": "msg_sub006_oldm_07",
      "hash": "6b7f8fcf98336eb8",
      "flags": 0,
      "text": "La MT32 contiene Magibrillio!\\c\\nSi tratta di una mossa di tipo Folletto.\\nA Kanto è sicuramente una rarità!"
    },
    {
      "index": 10,
      "id": "msg_sub006_oldm_08_nouse",
      "hash": "e921fd87e71bdb7c",
      "flags": 0,
      "text": "[~ 10]"
    },
