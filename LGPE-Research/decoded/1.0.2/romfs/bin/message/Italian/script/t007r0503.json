    {
      "index": 1,
      "id": "msg_t007r0503_jevenilem_01",
      "hash": "e4384f0ab442ee86",
      "flags": 0,
      "text": "Benissimo!\\c\\nIl mio amico mi dà un Kangaskhan in cambio\\ndi un Haunter!"
    },
    {
      "index": 2,
      "id": "msg_t007r0503_jevenilem_02",
      "hash": "e4384e0ab442ecd3",
      "flags": 0,
      "text": "Forza Haunter!\\nVieni!\\c\\nGli Haunter mi piacciono un sacco!\\nEh...?! Cosa succede?!\\c\\nHaunter si è evoluto in un altro Pokémon...!"
    },
    {
      "index": 3,
      "id": "msg_t007r0503_chilef_01",
      "hash": "97b8808b2d55e818",
      "flags": 0,
      "text": "Puoi riconoscere i Pokémon che hai ottenuto\\ntramite scambio dal loro ID!"
    },
    {
      "index": 4,
      "id": "msg_t007r0503_game_01",
      "hash": "92d1753fbd58e1f1",
      "flags": 4,
      "text": "È un Nintendo Switch."
    },
    {
      "index": 5,
      "id": "msg_t007r0503_game_02",
      "hash": "92d1723fbd58dcd8",
      "flags": 4,
      "text": "Un gioco di ruolo.\\nMa non c’è tempo per giocare!"
    },
    {
      "index": 6,
      "id": "msg_t007r0503_game_03",
      "hash": "92d1733fbd58de8b",
      "flags": 4,
      "text": "Un gioco sportivo.\\nCome quelli che piacciono a papà!"
    },
    {
      "index": 7,
      "id": "msg_t007r0503_game_04",
      "hash": "92d1783fbd58e70a",
      "flags": 4,
      "text": "Un gioco di rompicapi.\\nSembra irresistibile!"
    },
    {
      "index": 8,
      "id": "msg_t007r0503_game_05",
      "hash": "92d1793fbd58e8bd",
      "flags": 4,
      "text": "Un gioco di lotta.\\nSembra difficile!"
    },
    {
      "index": 9,
      "id": "msg_t007r0503_kanban_01",
