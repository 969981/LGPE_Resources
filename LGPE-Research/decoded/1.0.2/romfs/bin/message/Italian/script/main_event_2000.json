{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main2000_rival_01",
      "hash": "4568f4f74cfce003",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] C’è nessuno?"
    },
    {
      "index": 1,
      "id": "msg_main2000_rival_02",
      "hash": "4568f5f74cfce1b6",
      "flags": 0,
      "text": "So che mi senti, [VAR TRNAME(0000)]! Sto salendo\\nle scale!"
    },
    {
      "index": 2,
      "id": "msg_main2000_rival_03",
      "hash": "4568f6f74cfce369",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Sveglia, Campione[VAR GENDBR(00FF,0300)]ssa\\ndi Kanto! Il mattino ha l’oro in bocca!"
    },
    {
      "index": 3,
      "id": "msg_main2000_rival_09",
      "hash": "4568fcf74cfced9b",
      "flags": 8,
      "text": "Spero che tu non ti sia affezionat[VAR GENDBR(00FF,0101)]oa troppo\\na quel titolo... Perché prima o poi arriverà\\r\\nil sottoscritto a soffiartelo!"
    },
    {
      "index": 4,
      "id": "msg_main2000_rival_04",
      "hash": "4568f7f74cfce51c",
      "flags": 0,
      "text": "Piuttosto... Hai sentito cosa si dice in giro,\\n[VAR TRNAME(0000)]?\\c\\nPare che sia stato avvistato un Pokémon\\nincredibilmente potente!"
    },
    {
      "index": 5,
      "id": "msg_main2000_sel_01",
      "hash": "8b65dee0045ddfb3",
      "flags": 0,
      "text": "Che Pokémon è?"
    },
    {
      "index": 6,
      "id": "msg_main2000_sel_02",
      "hash": "8b65dfe0045de166",
      "flags": 0,
      "text": "Lo voglio catturare!"
    },
    {
      "index": 7,
      "id": "msg_main2000_rival_05",
      "hash": "4568f8f74cfce6cf",
      "flags": 0,
      "text": "Dicono che sia fortissimo e che abbia un aspetto\\nmolto particolare!"
    },
    {
      "index": 8,
      "id": "msg_main2000_rival_06",
      "hash": "4568f9f74cfce882",
      "flags": 4,
      "text": "Ah ah ah! Lo sapevo che non avresti saputo\\nresistere!"
    },
    {
      "index": 9,
      "id": "msg_main2000_rival_07",
      "hash": "4568faf74cfcea35",
      "flags": 4,
      "text": "È stato visto nei pressi di [VAR COLOR(0006)]Celestopoli[VAR COLOR(0000)]."
    },
    {
      "index": 10,
      "id": "msg_main2000_rival_10",
      "hash": "456bf9f74cff1e59",
      "flags": 0,
      "text": "Pare che sia scappato in una grotta\\nche si trova da quelle parti..."
    },
    {
      "index": 11,
      "id": "msg_main2000_rival_08",
      "hash": "4568fbf74cfcebe8",
      "flags": 0,
      "text": "La cosa ti incuriosisce, vero?\\nAllora facciamo a gara!"
    },
    {
      "index": 12,
      "id": "msg_main2000_rival_11",
      "hash": "456bf8f74cff1ca6",
      "flags": 0,
      "text": "Vediamo chi di noi due riuscirà a catturarlo\\nper primo!"
    }
  ],
  "unpaired_labels": [
