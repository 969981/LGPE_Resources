{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8010_water_01",
      "hash": "eb0270625db7e4cb",
      "flags": 4,
      "text": "Ehi, tu!"
    },
    {
      "index": 1,
      "id": "msg_main8010_water_05",
      "hash": "eb0274625db7eb97",
      "flags": 0,
      "text": "Qual è la tua strategia di lotta?"
    },
    {
      "index": 2,
      "id": "msg_main8010_water_06",
      "hash": "eb0275625db7ed4a",
      "flags": 4,
      "text": "Io, con i miei Pokémon di tipo Acqua,\\nadotto una strategia molto semplice...\\r\\nAttacco, attacco e di nuovo attacco!"
    },
    {
      "index": 3,
      "id": "msg_main8010_water_07",
      "hash": "eb0276625db7eefd",
      "flags": 0,
      "text": "Forza, allora! Misty, la Capopalestra più bella\\ndel mondo, è pronta a lottare contro di te!"
    },
    {
      "index": 4,
      "id": "msg_main8010_water_08",
      "hash": "eb0267625db7d580",
      "flags": 0,
      "text": "Sei pront[VAR GENDBR(00FF,0101)]oa? Cominciamo!"
    },
    {
      "index": 5,
      "id": "msg_gymleader_02_01",
      "hash": "727c3d2a1a30cc28",
      "flags": 0,
      "text": "[~ 5]"
    },
    {
      "index": 6,
      "id": "msg_gymleader_02_06",
      "hash": "727c442a1a30d80d",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main8010_water_02",
      "hash": "eb0271625db7e67e",
      "flags": 4,
      "text": "E va bene...\\c\\nTi darò la Medaglia Cascata, che dimostrerà\\nche mi hai sconfitto!"
    },
    {
      "index": 8,
      "id": "msg_main8010_sys_01",
      "hash": "fa93f3e6a1687f4d",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve la [VAR COLOR(0006)]Medaglia Cascata[VAR COLOR(0000)]\\nda Misty!"
    },
    {
      "index": 9,
      "id": "msg_main8010_water_03",
      "hash": "eb0272625db7e831",
      "flags": 0,
      "text": "Con la Medaglia Cascata tutti i Pokémon\\nfino al livello 30 ottenuti negli scambi\\r\\nseguiranno le tue indicazioni!\\c\\nInoltre... tieni! Ti do la mia MT preferita!"
    },
    {
      "index": 10,
      "id": "msg_main8010_sys_02",
      "hash": "fa93f0e6a1687a34",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve la [VAR ITEM2(0001)]\\nche contiene [VAR COLOR(0006)][VAR MOVE(0002)][VAR COLOR(0000)] da Misty!"
    },
    {
      "index": 11,
      "id": "msg_main8010_water_04",
      "hash": "eb0273625db7e9e4",
      "flags": 0,
      "text": "La MT29 contiene Idrovampata!\\nInsegnala ai Pokémon di tipo Acqua!"
    },
    {
      "index": 12,
      "id": "msg_gymleader_02_05",
      "hash": "727c412a1a30d2f4",
      "flags": 0,
      "text": "[~ 12]"
    },
