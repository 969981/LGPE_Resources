{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0716_system_01",
      "hash": "9a38104f995eae02",
      "flags": 4,
      "text": "È troppo in alto... Non ci arrivi!"
    },
    {
      "index": 1,
      "id": "msg_main0716_partner_a_01",
      "hash": "de5283e3612bc8f9",
      "flags": 0,
      "text": "Pika?"
    },
    {
      "index": 2,
      "id": "msg_main0716_partner_b_01",
      "hash": "d9db43cc8dd9f806",
      "flags": 4,
      "text": "Eevee... Vee?"
    },
    {
      "index": 3,
      "id": "msg_main0716_system_02",
      "hash": "9a380f4f995eac4f",
      "flags": 0,
      "text": "Forse [VAR PKNICK(0003)] potrebbe arrivarci\\npassando da qualche altra parte..."
    },
    {
      "index": 4,
      "id": "msg_main0716_system_03",
      "hash": "9a380e4f995eaa9c",
      "flags": 0,
      "text": "Se trovassi qualcosa su cui salire, forse\\nriusciresti ad arrivarci!"
    },
    {
      "index": 5,
      "id": "msg_main0716_system_14",
      "hash": "9a34874f995b8f60",
      "flags": 0,
      "text": "Prova a dare un’occhiata in giro!"
    },
    {
      "index": 6,
      "id": "msg_main0716_system_04",
      "hash": "9a380d4f995ea8e9",
      "flags": 0,
      "text": "Questa sedia potrebbe fare al caso tuo!"
    },
    {
      "index": 7,
      "id": "msg_main0716_system_05",
      "hash": "9a380c4f995ea736",
      "flags": 4,
      "text": "Uno, due... Oplà!"
    },
    {
      "index": 8,
      "id": "msg_main0716_partner_a_02",
      "hash": "de5280e3612bc3e0",
      "flags": 0,
      "text": "Pika, pikachuu!"
    },
    {
      "index": 9,
      "id": "msg_main0716_partner_b_02",
      "hash": "d9db42cc8dd9f653",
      "flags": 0,
      "text": "Vevee!"
    },
    {
      "index": 10,
      "id": "msg_main0716_system_06",
      "hash": "9a380b4f995ea583",
      "flags": 0,
      "text": "Recupera la chiave lanciata dalla Recluta\\ncon l’aiuto del tuo compagno!"
    },
    {
      "index": 11,
      "id": "msg_main0716_system_07",
      "hash": "9a380a4f995ea3d0",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] guarda [VAR PKNICK(0003)]\\ncon occhi pieni di fiducia!"
    },
    {
      "index": 12,
      "id": "msg_main0716_system_08",
      "hash": "9a38194f995ebd4d",
      "flags": 0,
      "text": "Passa all’interno dei muri per raggiungere\\ni tubi dall’altra parte!"
    },
    {
      "index": 13,
      "id": "msg_main0716_aporo_03",
      "hash": "70ecc882cf30c026",
      "flags": 0,
      "text": "[VAR COLOR(0009)]???:[VAR COLOR(0000)] Capo, che ci fa qui quel Cubone?"
    },
    {
      "index": 14,
      "id": "msg_main0716_karakara_01",
      "hash": "afa68ce57bd40ba5",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Cubone:[VAR COLOR(0000)] Cuuub..."
    },
    {
      "index": 15,
      "id": "msg_main0716_sakaki_01",
      "hash": "8705e2c44b7a8fc1",
      "flags": 0,
      "text": "[VAR COLOR(0009)]???:[VAR COLOR(0000)] L’hanno preso delle Reclute alla\\nTorre Pokémon."
    },
    {
      "index": 16,
      "id": "msg_main0716_aporo_01",
      "hash": "70ecc682cf30bcc0",
      "flags": 0,
      "text": "[VAR COLOR(0009)]???:[VAR COLOR(0000)] Il teschio che ha sulla testa\\nè di rara bellezza...\\c\\nSe lo facciamo evolvere in un Marowak\\ne lo vendiamo, ne ricaveremo un bel gruzzoletto!"
    },
    {
      "index": 17,
      "id": "msg_main0716_aporo_02",
      "hash": "70ecc982cf30c1d9",
      "flags": 0,
      "text": "[VAR COLOR(0009)]???:[VAR COLOR(0000)] ..."
    },
    {
      "index": 18,
      "id": "msg_main0716_system_09",
      "hash": "9a38184f995ebb9a",
      "flags": 0,
      "text": "Sembra che stiano parlando di questioni\\ncomplicate..."
    },
    {
      "index": 19,
      "id": "msg_main0716_partner_a_03",
      "hash": "de5281e3612bc593",
      "flags": 0,
      "text": "Pika!"
    },
    {
      "index": 20,
      "id": "msg_main0716_partner_b_03",
      "hash": "d9db41cc8dd9f4a0",
      "flags": 0,
      "text": "Veevee!"
    },
    {
      "index": 21,
      "id": "msg_main0716_system_10",
      "hash": "9a348b4f995b962c",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] ottiene la [VAR COLOR(0006)]Chiave ascensore[VAR COLOR(0000)]!"
    },
    {
      "index": 22,
      "id": "msg_main0716_musashi_01",
      "hash": "9282ba81ee37a857",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Cos’è stato quel rumore?"
    },
    {
      "index": 23,
      "id": "msg_main0716_kojiro_01",
      "hash": "3c3113220278a5a5",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] In effetti l’ho sentito anch’io!\\nNon sarà... un intruso?!"
    },
    {
      "index": 24,
      "id": "msg_main0716_partner_a_04",
      "hash": "de5286e3612bce12",
      "flags": 0,
      "text": "Pika..."
    },
    {
      "index": 25,
      "id": "msg_main0716_partner_b_04",
      "hash": "d9db48cc8dda0085",
      "flags": 0,
      "text": "Vee..."
    },
    {
      "index": 26,
      "id": "msg_main0716_nyasu_01",
      "hash": "d5d98422263741ff",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Meowth:[VAR COLOR(0000)] Guuurgle...!"
    },
    {
      "index": 27,
      "id": "msg_main0716_kojiro_02",
      "hash": "3c3110220278a08c",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] Ah, era solo la pancia di Meowth\\nche brontolava!"
    },
    {
      "index": 28,
      "id": "msg_main0716_musashi_02",
      "hash": "9282bb81ee37aa0a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Ci hai spaventati per niente!"
    },
    {
      "index": 29,
      "id": "msg_main0716_musashi_03",
      "hash": "9282bc81ee37abbd",
      "flags": 4,
      "text": "Il Persian del capo è splendido, vero?"
    },
    {
      "index": 30,
      "id": "msg_main0716_kojiro_03",
      "hash": "3c3111220278a23f",
      "flags": 4,
      "text": "Ed è pure fortissimo!\\c\\nPuò usare la mossa Bruciapelo, che fa sempre\\ntentennare l’avversario!"
    },
    {
      "index": 31,
      "id": "msg_main0716_musashi_04",
      "hash": "9282b581ee379fd8",
      "flags": 4,
      "text": "Ah, non ti avevo detto che il mio Ekans\\nsi è evoluto!"
    },
    {
      "index": 32,
      "id": "msg_main0716_kojiro_04",
      "hash": "3c310e2202789d26",
      "flags": 4,
      "text": "Oh, fantastico! Anche il mio Koffing\\nsi è evoluto in Weezing!"
    },
    {
      "index": 33,
      "id": "msg_main0716_musashi_05",
      "hash": "9282b681ee37a18b",
      "flags": 4,
      "text": "Hai presente il Generale Archer?\\c\\nL’altro giorno ho incrociato il suo Golbat\\nin corridoio...\\c\\nE mi sono venuti i sudori freddi!"
    },
    {
      "index": 34,
      "id": "msg_main0716_kojiro_05",
      "hash": "3c310f2202789ed9",
      "flags": 0,
      "text": "Quell’Archer ha anche un Weezing!\\c\\nMi avrà forse copiato...?"
    },
    {
      "index": 35,
      "id": "msg_main0716_musashi_06",
      "hash": "9282b781ee37a33e",
      "flags": 0,
      "text": "Che noia stare di guardia..."
    },
    {
      "index": 36,
      "id": "msg_main0716_kojiro_06",
      "hash": "3c310c22027899c0",
      "flags": 4,
      "text": "Una noia mortale..."
    },
    {
      "index": 37,
      "id": "msg_main0716_bg_01",
      "hash": "633d1e3b1cd26624",
      "flags": 4,
      "text": "È la teca dell’estintore...\\c\\nSembra troppo pesante da spostare!"
    },
    {
      "index": 38,
      "id": "msg_main0716_bg_02",
      "hash": "633d213b1cd26b3d",
      "flags": 0,
      "text": "C’è un documento intitolato “Le migliori\\ntattiche del Team Rocket”."
    },
    {
      "index": 39,
      "id": "msg_main0716_bg_03",
      "hash": "633d203b1cd2698a",
      "flags": 0,
      "text": "Questa sedia è traballante.\\nMeglio non usarla."
    },
    {
      "index": 40,
      "id": "msg_main0716_bg_04",
      "hash": "633d1b3b1cd2610b",
      "flags": 0,
      "text": "[~ 40]"
    },
    {
      "index": 41,
      "id": "msg_main0716_bg_05",
      "hash": "633d1a3b1cd25f58",
      "flags": 4,
      "text": "È una mappa di Kanto...\\nÈ piena di annotazioni sospette."
    },
    {
      "index": 42,
      "id": "msg_main0716_bg_06",
      "hash": "633d1d3b1cd26471",
      "flags": 0,
      "text": "Gli scatoloni sono troppo pesanti.\\nNon si riesce a spostarli."
    },
    {
      "index": 43,
      "id": "msg_main0716_bg_07",
      "hash": "633d1c3b1cd262be",
      "flags": 4,
      "text": "È un messaggio scritto in brutta grafia!\\c\\n“Si prega di non fare entrare i Pokémon\\nnel condotto di aerazione per evitare\\r\\nche passino sopra i muri!”"
    },
    {
      "index": 44,
      "id": "msg_main0716_bg_08",
      "hash": "633d173b1cd25a3f",
      "flags": 0,
      "text": "[~ 44]"
    },
    {
      "index": 45,
      "id": "msg_main0716_bg_09",
      "hash": "633d163b1cd2588c",
      "flags": 4,
      "text": "È un telefono dotato di monitor...\\c\\nNon si sa a cosa sia connesso.\\nMeglio non toccare."
    },
    {
      "index": 46,
      "id": "msg_main0716_bg_10",
      "hash": "633a193b1cd027ce",
      "flags": 0,
      "text": "[~ 46]"
    },
    {
      "index": 47,
      "id": "msg_main0716_bg_11",
      "hash": "633a1a3b1cd02981",
      "flags": 0,
      "text": "C’è un libro intitolato “Manuale del perfetto\\ncriminale”."
    },
    {
      "index": 48,
      "id": "msg_main0716_system_11",
      "hash": "9a348c4f995b97df",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] è di nuovo con te!"
    },
    {
      "index": 49,
      "id": "msg_main0716_system_12",
      "hash": "9a348d4f995b9992",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve la [VAR COLOR(0006)]Chiave ascensore[VAR COLOR(0000)]\\nda [VAR PKNICK(0003)]."
    },
    {
      "index": 50,
      "id": "msg_main0716_system_13",
      "hash": "9a348e4f995b9b45",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] è lì! Dai, salta!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0716_max",
      "hash": "a27de33b6faa98c1"
    }
  ]
