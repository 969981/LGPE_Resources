    {
      "index": 4,
      "id": "msg_main0300_rival_04",
      "hash": "f88a79d2bc91ba81",
      "flags": 4,
      "text": "Avevo sentito che poco più avanti c’era la casa\\ndi quel famoso appassionato di Pokémon...\\c\\nE insomma, ho deciso di farci un giro per vedere\\nse aveva qualche Pokémon raro!"
    },
    {
      "index": 5,
      "id": "msg_main0300_rival_05",
      "hash": "f88a78d2bc91b8ce",
      "flags": 0,
      "text": "Ma quando sono arrivato in quella casa...\\nNon ci crederai, ma..."
    },
    {
      "index": 6,
      "id": "msg_main0300_rival_06",
      "hash": "f88a77d2bc91b71b",
      "flags": 0,
      "text": "Non ho trovato Bill, l’appassionato di Pokémon...\\nAl suo posto c’era un Pokémon...\\r\\nUn Pokémon parlante!! Capisci?!"
    },
    {
      "index": 7,
      "id": "msg_main0300_rival_07",
      "hash": "f88a76d2bc91b568",
      "flags": 0,
      "text": "Brrrr! Che paura! Stai attent[VAR GENDBR(00FF,0101)]oa anche tu,\\n[VAR TRNAME(0000)]! Non avvicinarti a quella casa!"
