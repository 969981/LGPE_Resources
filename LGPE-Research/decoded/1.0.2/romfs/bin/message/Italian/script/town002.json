      "text": "Smeraldopoli\\nEterno paradiso verde"
    },
    {
      "index": 1,
      "id": "msg_town002_kanban_02",
      "hash": "7637afc9d1a1bb02",
      "flags": 0,
      "text": "Palestra di Smeraldopoli"
    },
    {
      "index": 2,
      "id": "msg_town002_door_01",
      "hash": "b7246880b3c9c456",
      "flags": 0,
      "text": "Le porte della Palestra sono chiuse..."
    },
    {
      "index": 3,
      "id": "msg_town002_kanban_03",
      "hash": "7637b0c9d1a1bcb5",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "msg_town002_kanban_04",
      "hash": "7637a9c9d1a1b0d0",
      "flags": 0,
      "text": "Consigli utili\\c\\nQuando sei a corto di Poké Ball, vai\\nal Pokémon-Market e comprane altre!"
    },
    {
      "index": 5,
      "id": "msg_town002_kanban_05",
      "hash": "7637aac9d1a1b283",
      "flags": 8,
      "text": "Scuola per Allenatori\\nImpara l’arte e mettila nella Poké Ball!"
    },
    {
      "index": 6,
      "id": "msg_town002_childm_01_01",
      "hash": "514de6fb5176410d",
      "flags": 4,
      "text": "Ehi! Quello è un Pokémon, vero?\\c\\nÈ davvero fantastico andarsene a spasso assieme\\nai propri Pokémon preferiti!"
    },
    {
      "index": 7,
      "id": "msg_town002_oldm_01_01",
      "hash": "75c5dea9e5248190",
      "flags": 0,
      "text": "Questa Palestra è sempre chiusa.\\nMi domando chi sia il Capopalestra..."
    },
    {
      "index": 8,
      "id": "msg_town002_oldm_01_02",
      "hash": "75c5e1a9e52486a9",
      "flags": 4,
      "text": "È tornato il Capopalestra di Smeraldopoli!"
    },
    {
      "index": 9,
      "id": "msg_town002_bugcatcher_01_01",
      "hash": "064dd86c3fe6a1d6",
      "flags": 0,
      "text": "Vuoi sapere qual è la differenza tra Weedle\\ne Caterpie?"
    },
    {
      "index": 10,
      "id": "msg_town002_bugcatcher_01_02",
      "hash": "064dd76c3fe6a023",
      "flags": 4,
      "text": "Oh, va bene!"
    },
    {
      "index": 11,
      "id": "msg_town002_bugcatcher_01_03",
      "hash": "064dd66c3fe69e70",
      "flags": 0,
      "text": "Caterpie non ha veleno, Weedle sì!\\nFai attenzione alla sua Velenospina!"
    },
    {
      "index": 12,
      "id": "msg_town002_jevenile_f_01",
      "hash": "52931ec5d1be27bf",
      "flags": 0,
      "text": "[~ 12]"
    },
    {
      "index": 13,
      "id": "msg_town002_poke_01",
      "hash": "1102f61156ce1dad",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Oddish:[VAR COLOR(0000)] Dish!"
    },
    {
      "index": 14,
      "id": "msg_town002_middlem_01",
      "hash": "01f9b8b8687961de",
      "flags": 4,
      "text": "Ohilà! Benvenut[VAR GENDBR(00FF,0101)]oa, Allenat[VAR GENDBR(00FF,0302)]orrice di Biancavilla!"
