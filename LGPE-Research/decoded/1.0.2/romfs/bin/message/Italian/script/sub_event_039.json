  "lines": [
    {
      "index": 0,
      "id": "msg_sub039_policef_01",
      "hash": "426534fabe078478",
      "flags": 4,
      "text": "Ho appena catturato uno Squirtle che non faceva\\naltro che combinare guai!\\c\\nAvrebbe bisogno di un Allenatore capace che\\nsappia dargli una raddrizzata..."
    },
    {
      "index": 1,
      "id": "msg_sub039_policef_06",
      "hash": "42653bfabe07905d",
      "flags": 4,
      "text": "Oh, finora hai catturato [VAR NUM9(0000,002E)] Pokémon!"
    },
    {
      "index": 2,
      "id": "msg_sub039_policef_02",
      "hash": "426537fabe078991",
      "flags": 4,
      "text": "Allora devi essere un[VAR GENDBR(00FF,0B0A)] Allenator’Allenatrice in gamba!\\c\\nChe ne dici di prenderti cura di questo\\nSquirtle birichino?"
    },
    {
      "index": 3,
      "id": "msg_sub039_policef_03",
      "hash": "426536fabe0787de",
      "flags": 0,
      "text": "Va bene, allora te lo affido!\\nMi raccomando, trattalo con cura!"
    },
    {
      "index": 4,
      "id": "msg_sub039_policef_07",
      "hash": "42653afabe078eaa",
      "flags": 4,
      "text": "Avrei un favore da chiederti, ma prima devi\\ncatturare almeno [VAR NUM3(0000)] Pokémon!"
    },
    {
      "index": 5,
      "id": "msg_sub039_policef_04",
      "hash": "426539fabe078cf7",
      "flags": 0,
      "text": "Capisco... E adesso cosa faccio?"
    },
    {
      "index": 6,
      "id": "msg_sub039_policef_05",
      "hash": "426538fabe078b44",
      "flags": 0,
      "text": "Come se la passa Squirtle?"
    },
    {
      "index": 7,
      "id": "msg_sub039_poke_01",
      "hash": "fe599006e0672827",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Squirtle:[VAR COLOR(0000)] Squirtle! Squirtle!"
    }
  ],
