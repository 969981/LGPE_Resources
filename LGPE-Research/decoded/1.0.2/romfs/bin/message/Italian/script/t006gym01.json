  "lines": [
    {
      "index": 0,
      "id": "msg_t006gym01_gym_01",
      "hash": "2e794eb10bfeff6b",
      "flags": 0,
      "text": "Ti aspettavo, aspirante Campione[VAR GENDBR(00FF,0300)]ssa!\\c\\nIl Capopalestra Lt. Surge è un Allenatore\\nfulminante!\\c\\nÈ un esperto di Pokémon di tipo Elettro, perciò\\nquelli di tipo Volante e Acqua sono a rischio.\\c\\nFai attenzione anche alle paralisi!\\c\\nLt. Surge è molto prudente, quindi\\nnon ti sarà facile raggiungerlo!"
    },
    {
      "index": 1,
      "id": "msg_t006gym01_gym_02",
      "hash": "2e794fb10bff011e",
      "flags": 0,
      "text": "Wow! Che lotta elettrizzante!"
    },
    {
      "index": 2,
      "id": "msg_t006gym01_statue_01",
      "hash": "dd9408e725ee8ef6",
      "flags": 0,
      "text": "Palestra di Aranciopoli\\c\\nAllenatori certificati da Lt. Surge:\\n[VAR TRNAME(0001)]"
    },
    {
      "index": 3,
      "id": "msg_t006gym01_statue_02",
      "hash": "dd9407e725ee8d43",
      "flags": 0,
      "text": "Palestra di Aranciopoli\\c\\nAllenatori certificati da Lt. Surge:\\n[VAR TRNAME(0001)] e [VAR TRNAME(0000)]"
    },
    {
      "index": 4,
      "id": "msg_t006gym01_gomi_01",
      "hash": "c6622a2b2c72f4ce",
      "flags": 4,
      "text": "Acqua!\\nC’è solo spazzatura qui!"
    },
    {
      "index": 5,
      "id": "msg_t006gym01_gomi_02",
      "hash": "c662292b2c72f31b",
      "flags": 0,
      "text": "Fuoco!\\nC’è un pulsante sul fondo del bidone!\\c\\nProva a premerlo!"
    },
    {
      "index": 6,
      "id": "msg_t006gym01_gomi_05",
      "hash": "c6622e2b2c72fb9a",
      "flags": 0,
      "text": "La prima barriera elettrica è stata disattivata."
    },
    {
      "index": 7,
      "id": "msg_t006gym01_gomi_03",
      "hash": "c662282b2c72f168",
      "flags": 0,
      "text": "La seconda barriera elettrica è stata disattivata.\\nOra puoi passare."
    },
    {
      "index": 8,
      "id": "msg_t006gym01_gomi_04",
      "hash": "c6622f2b2c72fd4d",
      "flags": 4,
      "text": "Ah! La barriera elettrica è stata riattivata!"
    },
    {
      "index": 9,
      "id": "msg_t006gym01_gomi_06",
      "hash": "c6622d2b2c72f9e7",
      "flags": 4,
      "text": "Un bidone rosso."
    },
    {
      "index": 10,
      "id": "msg_t006gym01_gomi_07",
      "hash": "c6622c2b2c72f834",
      "flags": 4,
      "text": "Un bidone blu."
    },
    {
      "index": 11,
      "id": "msg_t006gym01_gomi_08",
      "hash": "c662232b2c72e8e9",
      "flags": 4,
      "text": "Hai già premuto il pulsante dentro\\na questo bidone."
    }
  ],
