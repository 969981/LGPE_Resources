{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0430_captain_01",
      "hash": "474d4bf0c26a7e54",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitano:[VAR COLOR(0000)] Mi sento uno straccio...\\nOh...! Il mal di mare...!"
    },
    {
      "index": 1,
      "id": "msg_main0430_sys_01",
      "hash": "e5d62e6437bebe1b",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] massaggia la schiena\\nal capitano!"
    },
    {
      "index": 2,
      "id": "msg_main0430_sys_03",
      "hash": "e5d6306437bec181",
      "flags": 8,
      "text": "Scratch...\\nScratch..."
    },
    {
      "index": 3,
      "id": "msg_main0430_captain_02",
      "hash": "474d4ef0c26a836d",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitano:[VAR COLOR(0000)] Ah! Grazie! Mi sento molto meglio!!"
    },
    {
      "index": 4,
      "id": "msg_main0430_captain_13",
      "hash": "4749c5f0c26764cb",
      "flags": 0,
      "text": "Sei venut[VAR GENDBR(00FF,0101)]oa anche tu per imparare\\nla mia Tecnica Segreta...?\\c\\nMa certo, ma certo! Vieni, ti insegno!"
    },
    {
      "index": 5,
      "id": "msg_main0430_partner_a_01",
      "hash": "89fec1e6e8f7587a",
      "flags": 0,
      "text": "Piiika!"
    },
    {
      "index": 6,
      "id": "msg_main0430_partner_b_01",
      "hash": "e333820030487eed",
      "flags": 4,
      "text": "Eevee! Vee!"
    },
    {
      "index": 7,
      "id": "msg_main0430_captain_07",
      "hash": "474d49f0c26a7aee",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitano:[VAR COLOR(0000)] Ah ah ah! Questo [VAR POKNAME(0002)]\\nsembra davvero impaziente!\\c\\nPurtroppo, però, la mia Tecnica Segreta\\nla possono usare solo gli esseri umani..."
    },
    {
      "index": 8,
      "id": "msg_main0430_captain_08",
      "hash": "474d44f0c26a726f",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitano:[VAR COLOR(0000)] Come...? Vuoi impararla a tutti i costi?"
    },
    {
      "index": 9,
      "id": "msg_main0430_captain_14",
      "hash": "4749caf0c2676d4a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitano:[VAR COLOR(0000)] Durante i miei viaggi ne ho viste\\ndi cotte e di crude...\\c\\nMa non ho mai incontrato un Pokémon\\nche volesse imparare una Tecnica Segreta!"
    },
    {
      "index": 10,
      "id": "msg_main0430_captain_12",
      "hash": "4749c4f0c2676318",
      "flags": 0,
      "text": "Dal suo sguardo si intuisce che fa sul serio...\\nE va bene! Mi avete convinto!\\c\\nInsegnerò la mia Tecnica Segreta\\nal tuo [VAR POKNAME(0002)]!"
    },
    {
      "index": 11,
      "id": "msg_main0430_captain_03",
      "hash": "474d4df0c26a81ba",
      "flags": 0,
      "text": "Su, vieni."
    },
    {
      "index": 12,
      "id": "msg_main0430_captain_04",
      "hash": "474d48f0c26a793b",
      "flags": 4,
      "text": "Osserva bene..."
    },
    {
      "index": 13,
      "id": "msg_main0430_captain_09",
      "hash": "474d43f0c26a70bc",
      "flags": 0,
      "text": "..."
    },
    {
      "index": 14,
      "id": "msg_main0430_captain_10",
      "hash": "4749c6f0c267667e",
      "flags": 0,
      "text": "[~ 14]"
    },
    {
      "index": 15,
      "id": "msg_main0430_captain_11",
      "hash": "4749c7f0c2676831",
      "flags": 4,
      "text": "Aaah! Zac!"
    },
    {
      "index": 16,
      "id": "msg_main0430_partner_a_02",
      "hash": "89fec0e6e8f756c7",
      "flags": 0,
      "text": "[~ 16]"
    },
    {
      "index": 17,
      "id": "msg_main0430_partner_b_02",
      "hash": "e3337f00304879d4",
      "flags": 0,
      "text": "[~ 17]"
    },
    {
      "index": 18,
      "id": "msg_main0430_sys_02",
      "hash": "e5d62f6437bebfce",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] impara la [VAR COLOR(0006)]Tecnica Segreta[VAR COLOR(0000)]\\n[VAR COLOR(0006)]Fendente[VAR COLOR(0000)]!"
    },
    {
      "index": 19,
      "id": "msg_main0430_captain_05",
      "hash": "474d47f0c26a7788",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitano:[VAR COLOR(0000)] Ooh! Incredibile...! È davvero riuscito\\na imparare Fendente!"
    },
    {
      "index": 20,
      "id": "msg_main0430_captain_15",
      "hash": "4749cbf0c2676efd",
      "flags": 0,
      "text": "Grazie al Fendente di [VAR POKNAME(0002)]\\npotrai abbattere piccoli alberi!\\c\\nProva a usarlo su qualcuno degli alberi\\nche ci sono ad Aranciopoli!"
    },
    {
      "index": 21,
      "id": "msg_main0430_captain_06",
      "hash": "474d4af0c26a7ca1",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitano:[VAR COLOR(0000)] Beh, adesso è ora di partire!\\nLa Motonave Anna sta per salpare!\\c\\nStammi bene! Ci rivediamo la prossima\\nvolta che faremo scalo ad Aranciopoli!"
    },
    {
      "index": 22,
      "id": "msg_seaman1_01_p05_cave_d0308",
      "hash": "5f5346594f04464d",
      "flags": 0,
      "text": "[~ 22]"
    }
  ],
