    {
      "index": 1,
      "id": "msg_main0100_clerkm_02",
      "hash": "cd2963b82837acf1",
      "flags": 0,
      "text": "Conoscerai senz’altro il Professor Oak!\\c\\nÈ arrivato quello che stava aspettando,\\nma sono troppo impegnato per portarglielo...\\c\\nNon è che puoi pensarci tu?"
    },
    {
      "index": 2,
      "id": "msg_main0100_sys_01",
      "hash": "273c0ce0fcfa18e3",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve un [VAR COLOR(0006)]Pacco[VAR COLOR(0000)]!"
    },
    {
      "index": 3,
      "id": "msg_main0100_clerkm_03",
      "hash": "cd2962b82837ab3e",
      "flags": 4,
      "text": "Ok!\\nSaluta il Professor Oak da parte mia!"
    },
    {
      "index": 4,
      "id": "msg_main0100_clerkm_04",
