  "lines": [
    {
      "index": 0,
      "id": "msg_sub038_adultm_01",
      "hash": "f87cb4ed9d98299a",
      "flags": 0,
      "text": "Sono proprio una frana ad allenare i Pokémon...\\c\\nOgni volta che guardo il mio Charmander\\nmi dispiace che sia così debole...\\c\\nMi piacerebbe affidarlo a un Allenatore\\nmigliore di me..."
    },
    {
      "index": 1,
      "id": "msg_sub038_adultm_05",
      "hash": "f87cb0ed9d9822ce",
      "flags": 0,
      "text": "Mmh, vedo che hai catturato\\n[VAR NUM9(0000,002E)] Pokémon...!"
    },
    {
      "index": 2,
      "id": "msg_sub038_adultm_06",
      "hash": "f87cafed9d98211b",
      "flags": 0,
      "text": "Formidabile! Vorrei che ti prendessi cura tu\\ndi questo Charmander! Che ne dici?"
    },
    {
      "index": 3,
      "id": "msg_sub038_adultm_02",
      "hash": "f87cb3ed9d9827e7",
      "flags": 0,
      "text": "Prendilo allora, è tuo!"
    },
    {
      "index": 4,
      "id": "msg_sub038_adultm_07",
      "hash": "f87caeed9d981f68",
      "flags": 4,
      "text": "Io ho catturato [VAR NUM3(0000)] Pokémon.\\nSe ti interessa, torna quando mi avrai raggiunto!"
    },
    {
      "index": 5,
      "id": "msg_sub038_adultm_03",
      "hash": "f87cb2ed9d982634",
      "flags": 4,
      "text": "Oh...\\nMagari lo invierò al Professore..."
    },
    {
      "index": 6,
      "id": "msg_sub038_adultm_04",
      "hash": "f87cb1ed9d982481",
      "flags": 0,
      "text": "Come sta Charmander?!\\nSe la passa bene?"
    },
    {
      "index": 7,
      "id": "msg_sub038_poke_01",
      "hash": "a722653a024051d0",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Charmander:[VAR COLOR(0000)] Char! Chaar!"
    }
  ],
