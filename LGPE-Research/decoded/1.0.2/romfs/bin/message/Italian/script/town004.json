{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_town004_kanban_01",
      "hash": "b51317a8f3060e71",
      "flags": 0,
      "text": "Celestopoli\\nCircondata da una misteriosa aura celeste"
    },
    {
      "index": 1,
      "id": "msg_town004_kanban_02",
      "hash": "b51314a8f3060958",
      "flags": 0,
      "text": "Consigli utili\\c\\nQuando un Pokémon si sta evolvendo, puoi\\nbloccare il processo premendo il pulsante B."
    },
    {
      "index": 2,
      "id": "msg_town004_kanban_03",
      "hash": "b51315a8f3060b0b",
      "flags": 0,
      "text": "Casa dell’esperto di Bici"
    },
    {
      "index": 3,
      "id": "msg_town004_kanban_04",
      "hash": "b5131aa8f306138a",
      "flags": 0,
      "text": "Palestra di Celestopoli\\c\\nCapopalestra: Misty\\nLa sirena maschiaccio!"
    },
    {
      "index": 4,
      "id": "msg_town004_adultm_01",
      "hash": "974467edc6eb5151",
      "flags": 4,
      "text": "Anche tu sei un[VAR GENDBR(00FF,0B0A)] Allenator’Allenatrice, eh?\\c\\nCatturare i Pokémon, lottare...\\nChe vita dura!"
    },
    {
      "index": 5,
      "id": "msg_town004_youngm_01_01",
      "hash": "39c978ef1accc119",
      "flags": 0,
      "text": "Vicino al Pokémon-Market è cresciuto\\nun alberello che impedisce di andare\\r\\ndall’altra parte.\\c\\nCredo che ci sia anche un’altra strada,\\ncomunque."
    },
    {
      "index": 6,
      "id": "msg_boya1_01_p02_field_t004",
      "hash": "6dbca59f00f65f78",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_town004_middlem_01",
      "hash": "3a702dc61ba863a4",
      "flags": 4,
      "text": "Oh oh oh...\\nStai completando il Pokédex?\\c\\nSembra divertente!"
    },
    {
      "index": 8,
      "id": "msg_town004_policef_01",
      "hash": "eedfa2d161c67198",
      "flags": 0,
      "text": "Le persone che vivono qui sono state derubate...\\c\\nStando ai testimoni oculari i colpevoli sono\\ndei membri del Team Rocket!\\c\\nIo me ne sto qui di guardia per proteggere\\nle vittime di questo crimine...\\c\\nInsomma, di qui non si passa!\\nNon farò entrare nemmeno un Rattata!"
    },
    {
      "index": 9,
      "id": "msg_town004_youngf_01_01",
      "hash": "89c3f2c67ed7bf0c",
      "flags": 0,
      "text": "Forza, Electrode! Usa Sonicboom!\\c\\nInsomma, Electrode...! Ascolta quello che ti dico!"
    },
    {
      "index": 10,
      "id": "msg_town004_youngf_01_02",
      "hash": "89c3f5c67ed7c425",
      "flags": 4,
      "text": "Electrode, usa Azione!\\nUff... Niente da fare, eh...?"
    },
    {
      "index": 11,
      "id": "msg_town004_youngf_01_03",
      "hash": "89c3f4c67ed7c272",
      "flags": 4,
      "text": "Electrode, usa Comete!\\nAhh... No, non quella mossa! Comete, ho detto!\\r\\nChe difficile farsi dare retta dai Pokémon!\\c\\nSeguono gli ordini solo se il loro Allenatore\\nè bravo."
    },
    {
      "index": 12,
      "id": "msg_town004_poke_01_01",
      "hash": "bbf3f6e0c799a43b",
      "flags": 4,
      "text": "Electrode fa un pisolino..."
    },
    {
      "index": 13,
      "id": "msg_town004_poke_01_02",
      "hash": "bbf3f7e0c799a5ee",
      "flags": 4,
      "text": "Electrode fa il pigrone..."
    },
    {
      "index": 14,
      "id": "msg_town004_poke_01_03",
      "hash": "bbf3f8e0c799a7a1",
      "flags": 4,
      "text": "Electrode si volta dall’altra parte..."
    },
    {
      "index": 15,
      "id": "msg_town004_poke_01_04",
      "hash": "bbf3f9e0c799a954",
      "flags": 4,
      "text": "Electrode ignora gli ordini..."
    },
    {
      "index": 16,
      "id": "msg_town004_childf_01",
      "hash": "0333cfa13f0b2060",
      "flags": 4,
      "text": "Il signore che vive in quella casa colleziona\\nbiciclette da tutto il mondo!"
    },
    {
      "index": 17,
      "id": "msg_trainerm1_01_p01_field_t004",
      "hash": "424b20fd31d344f4",
      "flags": 0,
      "text": "Questa è la Grotta Celeste! Ci vivono Pokémon\\nfortissimi!\\c\\nPuò entrarci solo il Campione della Lega\\nPokémon!"
    },
    {
      "index": 18,
      "id": "msg_town004_fat_01",
      "hash": "9b47f4cb990902d1",
      "flags": 0,
      "text": "[~ 18]"
    },
    {
      "index": 19,
      "id": "msg_town004_poke_02_01",
      "hash": "1259bee863036144",
      "flags": 0,
      "text": "[~ 19]"
    },
