{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub013_sister_01",
      "hash": "26f68ca277e78a2c",
      "flags": 0,
      "text": "Ciao, [VAR TRNAME(0000)]!\\c\\nVuoi sapere com’è l’intesa fra te e i tuoi\\nPokémon?"
    },
    {
      "index": 1,
      "id": "msg_sub013_sister_02",
      "hash": "26f68fa277e78f45",
      "flags": 0,
      "text": "Ciao, [VAR TRNAME(0000)]!\\c\\nVuoi sapere com’è l’intesa fra te e i tuoi\\nPokémon?"
    },
    {
      "index": 2,
      "id": "msg_sub013_sister_03",
      "hash": "26f68ea277e78d92",
      "flags": 0,
      "text": "Se ti prendi cura dei tuoi Pokémon, vedrai che\\nriuscirai a stabilire un’intesa perfetta con loro!"
    },
    {
      "index": 3,
      "id": "msg_sub013_sister_04",
      "hash": "26f689a277e78513",
      "flags": 0,
      "text": "Benissimo! Allora diamo un’occhiata\\na [VAR PKNICK(0001)]..."
    },
    {
      "index": 4,
      "id": "msg_sub013_sister_05",
      "hash": "26f688a277e78360",
      "flags": 0,
      "text": "Sembra che [VAR PKNICK(0001)] ti voglia\\ndavvero un mondo di bene!\\c\\nTra voi due c’è un’intesa fenomenale!"
    },
    {
      "index": 5,
      "id": "msg_sub013_sister_06",
      "hash": "26f68ba277e78879",
      "flags": 0,
      "text": "Sento che [VAR PKNICK(0001)] vuole restare\\nsempre assieme a te!\\c\\nTra di voi c’è un’ottima intesa!"
    },
    {
      "index": 6,
      "id": "msg_sub013_sister_07",
      "hash": "26f68aa277e786c6",
      "flags": 0,
      "text": "Sembra che tra te e [VAR PKNICK(0001)] ci sia\\nuna buona intesa!"
    },
    {
      "index": 7,
      "id": "msg_sub013_sister_08",
      "hash": "26f695a277e79977",
      "flags": 8,
      "text": "State diventando amici!\\nContinuate così!"
    },
    {
      "index": 8,
      "id": "msg_sub013_sister_09",
      "hash": "26f694a277e797c4",
      "flags": 0,
      "text": "Vedo un barlume di affetto nei suoi occhi!\\nSento che siete sulla strada giusta...!"
    },
    {
      "index": 9,
      "id": "msg_sub013_sister_10",
      "hash": "26f307a277e47256",
      "flags": 0,
      "text": "Vi siete appena conosciuti, non è vero?\\nNon vedo l’ora che facciate amicizia!"
    },
    {
      "index": 10,
      "id": "msg_sub013_sister_11",
      "hash": "26f308a277e47409",
      "flags": 4,
      "text": "Ho l’impressione che questo Pokémon venga\\nmandato KO un po’ troppo spesso... Mi sbaglio?"
    },
    {
      "index": 11,
      "id": "msg_sub013_sister_12",
      "hash": "26f305a277e46ef0",
      "flags": 4,
      "text": "Oh no, guarda in che condizioni è questo\\nPokémon!!\\c\\nChe aspetti?\\nCorri in un Centro Pokémon, presto!"
    },
    {
      "index": 12,
      "id": "msg_woman1_01_p11_t001_r0201",
