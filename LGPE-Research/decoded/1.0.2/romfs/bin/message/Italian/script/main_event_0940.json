{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0940_rocketboss_01",
      "hash": "13ec62a8c0b49f03",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Giovanni:[VAR COLOR(0000)] Presidente, non crederai mica\\ndi potermi prendere in giro?!"
    },
    {
      "index": 1,
      "id": "msg_main0940_rocketboss_06",
      "hash": "13ec67a8c0b4a782",
      "flags": 0,
      "text": "Le Master Ball...\\nSono già pronte, vero?"
    },
    {
      "index": 2,
      "id": "msg_main0940_president_01",
      "hash": "578d27f5487e1a18",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Presidente:[VAR COLOR(0000)] Pensi davvero che sia così facile\\nrealizzarle?"
    },
    {
      "index": 3,
      "id": "msg_main0940_president_04",
      "hash": "578d2cf5487e2297",
      "flags": 4,
      "text": "E comunque ora che ho scoperto le tue vere\\nintenzioni...\\c\\nNon ho più nessuna voglia di produrre\\nle Master Ball!"
    },
    {
      "index": 4,
      "id": "msg_main0940_rocketboss_02",
      "hash": "13ec63a8c0b4a0b6",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Giovanni:[VAR COLOR(0000)] Cosa?!"
    },
    {
      "index": 5,
      "id": "msg_main0940_president_02",
      "hash": "578d2af5487e1f31",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Presidente:[VAR COLOR(0000)] Dovrai anche abbandonare il piano\\ndi usare la Silph S.p.A. per creare\\r\\nuna schiera di Pokémon potenti!"
    },
    {
      "index": 6,
      "id": "msg_main0940_president_05",
      "hash": "578d2bf5487e20e4",
      "flags": 0,
      "text": "Nella nostra azienda non siamo abituati a creare\\nPokémon sfruttando ricerche rubate!"
    },
    {
      "index": 7,
      "id": "msg_main0940_rocketboss_03",
      "hash": "13ec64a8c0b4a269",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Giovanni:[VAR COLOR(0000)] Ehi! I patti non erano questi!"
    },
    {
      "index": 8,
      "id": "msg_main0940_rocketboss_12",
      "hash": "13ef65a8c0b6d9f3",
      "flags": 0,
      "text": "Pensa ai tuoi impiegati! Se rifiuti di lavorare\\nper noi se la vedranno brutta!\\r\\nNon ti importa di loro?"
    },
    {
      "index": 9,
      "id": "msg_main0940_president_03",
      "hash": "578d29f5487e1d7e",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Presidente:[VAR COLOR(0000)] ..."
    },
    {
      "index": 10,
      "id": "msg_main0940_rocketboss_04",
      "hash": "13ec65a8c0b4a41c",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Giovanni:[VAR COLOR(0000)] Ah, [VAR TRNAME(0000)]!\\nCi rincontriamo!\\c\\nIl presidente e io stiamo discutendo\\ndi un affare molto importante.\\c\\nNon t’immischiare nelle faccende\\ndei grandi..."
    },
    {
      "index": 11,
      "id": "msg_main0940_rocketboss_07",
      "hash": "13ec68a8c0b4a935",
      "flags": 4,
      "text": "Altrimenti te ne pentirai!"
    },
    {
      "index": 12,
      "id": "msg_main0940_dummy_01",
      "hash": "1ae20b304fe2d1a8",
      "flags": 0,
      "text": "[~ 12]"
    },
    {
      "index": 13,
      "id": "msg_main0940_rocketboss_05",
      "hash": "13ec66a8c0b4a5cf",
      "flags": 0,
      "text": "Maledizione! Hai mandato a monte\\ni nostri piani per la Silph!"
    },
    {
      "index": 14,
      "id": "msg_main0940_rocketboss_08",
      "hash": "13ec69a8c0b4aae8",
      "flags": 0,
      "text": "Ma il Team Rocket non cederà mai!"
    },
    {
      "index": 15,
      "id": "msg_main0940_rocketboss_09",
      "hash": "13ec6aa8c0b4ac9b",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]! Ricordati bene una cosa..."
    },
    {
      "index": 16,
      "id": "msg_main0940_rocketboss_10",
      "hash": "13ef67a8c0b6dd59",
      "flags": 0,
      "text": "Tutti i Pokémon esistono per essere usati\\ndal Team Rocket!"
    },
    {
      "index": 17,
      "id": "msg_main0940_rocketboss_11",
      "hash": "13ef66a8c0b6dba6",
      "flags": 4,
      "text": "Ora devo andare, ma ritornerò!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0940_max",
      "hash": "3aa8d0ca74782e2c"
    }
  ]
}
