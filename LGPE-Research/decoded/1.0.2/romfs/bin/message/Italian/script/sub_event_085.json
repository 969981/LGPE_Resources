      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Ehi tu, fai largo!"
    },
    {
      "index": 1,
      "id": "msg_sub085_rocketm_01",
      "hash": "776568bd7cee60a0",
      "flags": 8,
      "text": "Scordatelo! Mi hanno detto di lasciar passare\\nsolo i membri."
    },
    {
      "index": 2,
      "id": "msg_sub085_kojiro_01",
      "hash": "26e795e55c88e1ff",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] Non essere così pedante!"
    },
    {
      "index": 3,
      "id": "msg_sub085_musasi_02",
      "hash": "5ea00fdf50658a3c",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Ora basta, la mia pazienza ha un limite!"
    },
    {
      "index": 4,
      "id": "msg_sub085_musasi_03",
      "hash": "5ea010df50658bef",
      "flags": 8,
      "text": "Spostati, t’ho detto!!"
    },
    {
      "index": 5,
      "id": "msg_sub085_kojiro_02",
      "hash": "26e796e55c88e3b2",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] Ehi, Jessie! Aspettami!"
    },
    {
      "index": 6,
      "id": "msg_sub085_stop_01",
      "hash": "7a5645749be1654b",
      "flags": 0,
      "text": "Sono un agente di sicurezza.\\nNon sono ammessi mocciosi sospetti qui dentro!"
    },
    {
      "index": 7,
      "id": "msg_sub085_stop_02",
      "hash": "7a5646749be166fe",
      "flags": 4,
      "text": "Urgh..."
