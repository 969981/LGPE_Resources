    },
    {
      "index": 4,
      "id": "msg_main1020_musashi_01",
      "hash": "a7661d11c28260fc",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Ci avevano detto che al GO Park\\navremmo trovato un sacco di Pokémon rari...\\c\\nE invece siamo venuti per niente..."
    },
    {
      "index": 5,
      "id": "msg_main1020_kojiro_01",
      "hash": "63dae89e4730b568",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] Applicazioni di qua...\\nCollegamenti di là...\\r\\nE chi ci capisce niente...?!\\c\\nCe ne siamo andati con la coda tra le gambe..."
    },
    {
      "index": 6,
      "id": "msg_main1020_nyasu_01",
      "hash": "9cf6c3ec7942f750",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Meowth:[VAR COLOR(0000)] Meow..."
    },
    {
      "index": 7,
      "id": "msg_main1020_kojiro_02",
      "hash": "63daeb9e4730ba81",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "msg_main1020_musashi_02",
      "hash": "a7662011c2826615",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Forse troviamo il modo di raggranellare\\nqualcosa..."
    },
    {
      "index": 9,
      "id": "msg_main1020_musashi_09",
      "hash": "a7662511c2826e94",
      "flags": 0,
      "text": "Mh...?! Ho colpito qualcosa di duro\\ncon il piede...!"
    },
    {
      "index": 10,
      "id": "msg_main1020_kojiro_03",
      "hash": "63daea9e4730b8ce",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] Che sia un tesoro?!\\nProviamo a scavare!"
    },
    {
      "index": 11,
      "id": "msg_main1020_musashi_03",
      "hash": "a7661f11c2826462",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie e James:[VAR COLOR(0000)] Puff... Pant...!\\nPant... Puff...!"
    },
    {
      "index": 12,
      "id": "msg_main1020_kojiro_04",
      "hash": "63daed9e4730bde7",
      "flags": 0,
      "text": "[~ 12]"
    },
    {
      "index": 13,
      "id": "msg_main1020_nyasu_02",
      "hash": "9cf6c6ec7942fc69",
      "flags": 0,
      "text": "[~ 13]"
    },
    {
      "index": 14,
      "id": "msg_main1020_musashi_04",
      "hash": "a7661a11c2825be3",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Wow! Guarda come luccica!\\nAbbiamo trovato un tesoro favoloso!"
    },
    {
      "index": 15,
      "id": "msg_main1020_musashi_05",
      "hash": "a7661911c2825a30",
      "flags": 0,
      "text": "Bleah! Cos’è ’sta roba?!\\nUna [VAR COLOR(0006)]dentiera[VAR COLOR(0000)]?!"
    },
    {
      "index": 16,
      "id": "msg_main1020_kojiro_05",
      "hash": "63daec9e4730bc34",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] U... Una dentiera...?!\\c\\nSarà anche d’oro, ma non ce ne facciamo\\nniente di questa robaccia...!"
    },
    {
      "index": 17,
      "id": "msg_main1020_musashi_06",
      "hash": "a7661c11c2825f49",
      "flags": 0,
      "text": "[~ 17]"
    },
    {
      "index": 18,
      "id": "msg_main1020_musashi_07",
      "hash": "a7661b11c2825d96",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Ah, [VAR GENDBR(00FF,1212)]il solito mocciosola solita mocciosa!\\nCosa ci fai qui?!\\c\\nBeh, non importa.\\nPrendi questi!"
    },
    {
      "index": 19,
      "id": "msg_main1020_sys_02",
      "hash": "1ed557a826255042",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve i [VAR COLOR(0006)]Denti d’oro[VAR COLOR(0000)]!"
    },
    {
      "index": 20,
      "id": "msg_main1020_kojiro_06",
      "hash": "63daef9e4730c14d",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] Tieniteli pure!\\nNoi abbiamo cose più urgenti a cui badare!"
    },
    {
      "index": 21,
      "id": "msg_main1020_musashi_08",
      "hash": "a7662611c2827047",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Voglio assolutamente lavarmi le mani!\\nForza, squagliamocela!"
    }
  ],
