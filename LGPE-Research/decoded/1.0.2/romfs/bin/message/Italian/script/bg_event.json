{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "fe_amai_msg00",
      "hash": "7a6591e7fa5270a7",
      "flags": 0,
      "text": "Pare che qui non ci sia nulla..."
    },
    {
      "index": 1,
      "id": "msg_kagu1_bg",
      "hash": "cdf3b18078b3f908",
      "flags": 0,
      "text": "Ci sono piatti e vassoi in perfetto ordine."
    },
    {
      "index": 2,
      "id": "msg_kagu2_bg",
      "hash": "a0b3a17a163fa0e3",
      "flags": 0,
      "text": "Che profumino! Qualcuno deve aver cucinato,\\npoco fa..."
    },
    {
      "index": 3,
      "id": "msg_kagu3_bg",
      "hash": "c9eb816ecbc1f832",
      "flags": 4,
      "text": "È una bella credenza. Sembra molto capiente."
    },
    {
      "index": 4,
      "id": "msg_kagu4_bg",
      "hash": "730c41672ff1c605",
      "flags": 0,
      "text": "Ci sono parecchi snack."
    },
    {
      "index": 5,
      "id": "msg_kagu5_bg",
      "hash": "49245160d0548fe4",
      "flags": 4,
      "text": "È una bella immagine di un Pokémon.\\nSembra contento."
    },
    {
      "index": 6,
      "id": "msg_kagu6_bg",
      "hash": "9b158156be707c7f",
      "flags": 4,
      "text": "È uno strano macchinario. Meglio non toccare..."
    },
    {
      "index": 7,
      "id": "msg_kagu7_bg",
      "hash": "712e91505ed4f95e",
      "flags": 4,
      "text": "È un telefono. Meglio non usarlo..."
    },
    {
      "index": 8,
      "id": "msg_kagu8_bg",
      "hash": "03f0b1cd88a71721",
      "flags": 4,
      "text": "È un cartellone pubblicitario con prodotti\\ndi ogni tipo."
    },
    {
      "index": 9,
      "id": "msg_kagu9_bg",
      "hash": "2d2881c23e295340",
      "flags": 0,
      "text": "Che profumino!\\nFa venire l’acquolina in bocca!"
    },
    {
      "index": 10,
      "id": "msg_kagu10_bg",
      "hash": "2900f7fa1e970ca4",
      "flags": 0,
      "text": "Qui dentro...\\n... ...\\c\\n... non c’è niente!"
    },
    {
      "index": 11,
      "id": "msg_kagu11_bg",
      "hash": "ffc8e805691463c5",
      "flags": 4,
      "text": "È una tazza con un Pokémon disegnato sopra."
    },
    {
      "index": 12,
      "id": "msg_kagu12_bg",
      "hash": "510b37e9ad17761e",
      "flags": 4,
      "text": "I vetri della finestra sembrano appena stati lavati."
    },
    {
      "index": 13,
      "id": "msg_kagu13_bg",
      "hash": "27d327f4f794cd3f",
      "flags": 0,
      "text": "Dalla finestra si vede un cielo magnifico..."
    },
    {
      "index": 14,
      "id": "msg_kagu14_bg",
      "hash": "574a581eaef36dc8",
      "flags": 0,
      "text": "Ci sono luci lampeggianti di vario colore."
    },
    {
      "index": 15,
      "id": "msg_kagu15_bg",
      "hash": "59600823d6bb57e9",
      "flags": 0,
      "text": "Ci sono oggetti di ogni tipo."
    },
    {
      "index": 16,
      "id": "msg_bouenkyou_01_p01_r011_r0102",
      "hash": "11249d7b557c7c93",
      "flags": 0,
      "text": "Guardi attraverso il binocolo...\\c\\nSi vede un enorme Pokémon che dorme\\nin mezzo alla strada!"
    },
    {
      "index": 17,
      "id": "msg_bouenkyou_01_p02_r011_r0102",
      "hash": "d0e85fd19bb0169c",
      "flags": 0,
      "text": "Guardi attraverso il binocolo...\\c\\nSi vede un magnifico panorama!"
    },
    {
      "index": 18,
      "id": "msg_bouenkyou_02_p01_r011_r0102",
      "hash": "33193af75a560fb0",
      "flags": 0,
      "text": "Guardi attraverso il binocolo...\\c\\nSembra che il Tunnel Roccioso sia un buon modo\\nper andare da Celestopoli a Lavandonia!"
    },
    {
      "index": 19,
      "id": "msg_bouenkyou_01_p01_r012_r0102",
      "hash": "2a2fd25bba926a22",
      "flags": 0,
      "text": "Guardi attraverso il binocolo...\\c\\nSi vede un uomo che pesca!"
    },
    {
      "index": 20,
      "id": "msg_bouenkyou_02_p01_r012_r0102",
      "hash": "1447c575cf496bf5",
      "flags": 0,
      "text": "Guardi attraverso il binocolo...\\c\\nSi vede la Torre Pokémon!"
    },
    {
      "index": 21,
      "id": "msg_bouenkyou_01_p01_r015_r0102",
      "hash": "d7f7e45d55f7429f",
      "flags": 0,
      "text": "Guardi attraverso il binocolo...\\c\\nSi vede un grande e lucente Pokémon alato\\nche vola verso il mare."
    },
    {
      "index": 22,
      "id": "msg_bouenkyou_02_p01_r015_r0102",
      "hash": "98836cfee336ff7c",
      "flags": 0,
      "text": "Guardi attraverso il binocolo...\\c\\nSi vede una piccola isola!"
    },
    {
      "index": 23,
      "id": "msg_bouenkyou_01_p01_r016_r0202",
      "hash": "cea1afb32e7dc323",
      "flags": 0,
      "text": "Guardi attraverso il binocolo...\\c\\nSi vede il Centro Commerciale di Azzurropoli!"
    },
    {
      "index": 24,
      "id": "msg_bouenkyou_02_p01_r016_r0202",
      "hash": "e85828a3f4702cc0",
      "flags": 0,
      "text": "Guardi attraverso il binocolo...\\c\\nSi vede una lunga via sull’acqua!"
    },
    {
      "index": 25,
      "id": "msg_bouenkyou_01_p01_r018_r0102",
      "hash": "f4dd8c32d544ae70",
      "flags": 0,
      "text": "Guardi attraverso il binocolo...\\c\\nSi vede Biancavilla, a ovest!"
    },
    {
      "index": 26,
      "id": "msg_bouenkyou_02_p01_r018_r0102",
      "hash": "4f604c3fda8dddd3",
      "flags": 0,
      "text": "Guardi attraverso il binocolo...\\c\\nSi vede una persona che nuota!"
    },
    {
      "index": 27,
      "id": "msg_sylph_door_01",
      "hash": "c36b343ea1a7c0f8",
      "flags": 4,
      "text": "Evviva!\\nL’Apriporta ha funzionato!"
    },
    {
      "index": 28,
      "id": "msg_sylph_door_02",
      "hash": "c36b373ea1a7c611",
      "flags": 4,
      "text": "Oh, no!\\nCi vuole l’Apriporta!"
    },
    {
      "index": 29,
      "id": "msg_book_01_bg",
      "hash": "7bb6486bae7c5172",
      "flags": 4,
      "text": "È pieno zeppo di libri Pokémon!"
    },
    {
      "index": 30,
      "id": "msg_townmap_01_bg",
      "hash": "0de10cb9a0a3d80b",
      "flags": 4,
      "text": "È una Mappa città."
    },
    {
      "index": 31,
      "id": "msg_fsrack_01_bg",
      "hash": "6c92a1bfb5eb3e83",
      "flags": 0,
      "text": "Wow! Ci sono montagne di oggetti Pokémon!"
    },
    {
      "index": 32,
      "id": "msg_fs_01_bg",
      "hash": "1df07aa8257f8e68",
      "flags": 4,
      "text": "Abbiamo tutti gli strumenti per te!\\nPokémon-Market"
    },
    {
      "index": 33,
      "id": "msg_pc_01_bg",
      "hash": "dfee76fbce4be542",
      "flags": 0,
      "text": "Rimetti in sesto i tuoi Pokémon!\\nCentro Pokémon"
    },
    {
      "index": 34,
      "id": "msg_freeze_01_bg",
      "hash": "8e164c7fbea26a00",
      "flags": 0,
      "text": "Dev’essere pieno di cibi deliziosi!"
    },
    {
      "index": 35,
      "id": "msg_sekkeizu_01_bg",
      "hash": "fa393e9b9200f706",
      "flags": 0,
      "text": "Sembra un progetto per costruire qualcosa.\\nLe pagine sono piene di testi e diagrammi."
    },
    {
      "index": 36,
      "id": "msg_pc_02_bg",
      "hash": "37629715141fdcf9",
      "flags": 4,
      "text": "È pieno di parole e numeri incomprensibili..."
    },
    {
      "index": 37,
      "id": "msg_masaki_01_bg",
      "hash": "93d2d7a15f3e81dd",
      "flags": 4,
      "text": "È uno strano macchinario. Sembra straordinario!"
    },
    {
      "index": 38,
      "id": "msg_game_01_bg",
      "hash": "5cb767c46e41f135",
      "flags": 4,
      "text": "È un videogioco appena uscito.\\nSembra divertente!"
    },
    {
      "index": 39,
      "id": "msg_dorobou_01_bg",
      "hash": "a07f7a27a1a4b8e9",
      "flags": 4,
      "text": "I ladri hanno lasciato chiari segni\\ndel loro passaggio."
    },
    {
      "index": 40,
      "id": "msg_tv_01_bg",
      "hash": "bb6a7c7d0b1fc1b5",
      "flags": 0,
      "text": "C’è un Pokémon in TV. Sembra divertirsi\\nun mondo!"
    },
    {
      "index": 41,
      "id": "msg_tv_02_bg",
      "hash": "8ca18c64fdd8eb8e",
      "flags": 0,
      "text": "Quello che compare sul televisore... è il tuo viso!"
    },
    {
      "index": 42,
      "id": "msg_t007r0805_elevator_01",
      "hash": "6b7cd65aaddff314",
      "flags": 0,
      "text": "Sembra che serva una chiave..."
    },
    {
      "index": 43,
      "id": "msg_main_event_1100_switch_01",
      "hash": "ccd6e3039bca99fd",
      "flags": 0,
      "text": "Clic!\\c\\nHai premuto un pulsante segreto!"
    },
    {
      "index": 44,
      "id": "msg_main_event_1100_switch_04",
      "hash": "ccd6de039bca917e",
      "flags": 0,
      "text": "Si è sentito un rumore! Qualcosa si è mosso\\nda qualche parte..."
    },
    {
      "index": 45,
      "id": "msg_main_event_1100_switch_02",
      "hash": "ccd6e0039bca94e4",
      "flags": 0,
      "text": "[~ 45]"
    },
    {
      "index": 46,
      "id": "msg_main_event_1100_switch_03",
      "hash": "ccd6e1039bca9697",
      "flags": 0,
      "text": "[~ 46]"
    },
    {
      "index": 47,
      "id": "msg_shop_bg_01",
      "hash": "3682ef731ccc848b",
      "flags": 0,
      "text": "Ci sono un sacco di Pozioni e Repellenti."
    },
    {
      "index": 48,
      "id": "msg_shop_bg_02",
      "hash": "3682f0731ccc863e",
      "flags": 0,
      "text": "Ci sono un sacco di prodotti diversi. Parla con\\nil commesso se vuoi comprare qualcosa!"
    },
    {
      "index": 49,
      "id": "msg_kanban_bg_01",
      "hash": "ff617b40a90b04f0",
      "flags": 0,
      "text": "Non riesci a leggere il cartello... perché\\nle scritte sono dall’altra parte!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_bg_event_max",
      "hash": "f825892cbb5f8bbe"
    }
  ]
}
