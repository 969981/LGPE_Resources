{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub043_middle_01",
      "hash": "636a64446d37698e",
      "flags": 0,
      "text": "Gradisci dei Plumbeosalatini?\\nLa specialità di Plumbeopoli per soli 500 ₽!\\c\\nLa vendita è limitata: un pacchetto al giorno."
    },
    {
      "index": 1,
      "id": "msg_sub043_select_01",
      "hash": "c08b22c858810d85",
      "flags": 0,
      "text": "Sì, grazie!"
    },
    {
      "index": 2,
      "id": "msg_sub043_select_02",
      "hash": "c08b1fc85881086c",
      "flags": 0,
      "text": "Non mi va..."
    },
    {
      "index": 3,
      "id": "msg_sub043_middle_02",
      "hash": "636a63446d3767db",
      "flags": 0,
      "text": "Grazie!\\c\\nTi avviso, però: sono molto duri.\\nAttenzione ai denti!"
    },
    {
      "index": 4,
      "id": "msg_sub043_system_01",
      "hash": "b51a3afa6e71ae92",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve dei Plumbeosalatini!"
    },
    {
      "index": 5,
      "id": "msg_sub043_middle_03",
      "hash": "636a62446d376628",
      "flags": 4,
      "text": "Ah, peccato. Allora sarà per la prossima volta."
    },
    {
      "index": 6,
      "id": "msg_sub043_middle_04",
      "hash": "636a69446d37720d",
      "flags": 4,
      "text": "Oh, non ti bastano i soldi. La prossima volta,\\nallora."
    },
    {
      "index": 7,
      "id": "msg_sub043_middle_05",
      "hash": "636a68446d37705a",
      "flags": 4,
      "text": "Hai già una scorta notevole di Plumbeosalatini.\\nPerché te ne porti dietro così tanti?\\c\\nMi raccomando, mangiali!"
    },
    {
      "index": 8,
      "id": "msg_sub043_middle_06",
      "hash": "636a67446d376ea7",
      "flags": 0,
      "text": "Solo uno al giorno, mi dispiace.\\nTorna a trovarmi domani!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_043_max",
      "hash": "e43f42cffdc6fe6f"
    }
  ]
}
