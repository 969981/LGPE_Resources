    {
      "index": 0,
      "id": "msg_sub027_clerkm_01",
      "hash": "702f96ce8afd0c87",
      "flags": 4,
      "text": "Oh, no! Un[VAR GENDBR(00FF,0606)] altro’altra cliente!\\c\\nDevo andare in bagno, accidenti...\\nE il mio collega è in ritardo...\\c\\nSe solo ci fosse qualcuno ad aiutarmi...\\nBeh, a proposito di aiutare gli altri... Tieni!"
    },
    {
      "index": 1,
      "id": "msg_sub027_sys_01",
      "hash": "0368ad17774bd62e",
      "flags": 0,
      "text": "[~ 1]"
    },
    {
      "index": 2,
      "id": "msg_sub027_clerkm_02",
      "hash": "702f97ce8afd0e3a",
      "flags": 0,
      "text": "La MT03 contiene Altruismo!\\c\\nÈ una mossa che aumenta la potenza\\ndegli attacchi di un alleato."
    },
    {
      "index": 3,
      "id": "msg_sub027_clerkm_03",
      "hash": "702f98ce8afd0fed",
      "flags": 8,
      "text": "Stai usando Altruismo? Spero tanto che prima\\no poi qualcuno la usi con me!"
    },
