{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8020_volt_01",
      "hash": "89318c21a2f32408",
      "flags": 0,
      "text": "Welcome alla Palestra di Aranciopoli!"
    },
    {
      "index": 1,
      "id": "msg_main8020_volt_07",
      "hash": "89319221a2f32e3a",
      "flags": 4,
      "text": "E tu chi sei, baby?\\nUn[VAR GENDBR(00FF,0706)] nuovoa nuova challenger?"
    },
    {
      "index": 2,
      "id": "msg_main8020_volt_08",
      "hash": "89318521a2f31823",
      "flags": 4,
      "text": "Ah ah ah! Pensi di potermi battere\\ncon una squadra così weak?\\r\\nHai del courage, ragazzin[VAR GENDBR(00FF,0101)]oa!"
    },
    {
      "index": 3,
      "id": "msg_main8020_volt_09",
      "hash": "89318421a2f31670",
      "flags": 0,
      "text": "Ma temo che tu non stia prendendo sul serious\\nle lotte di Pokémon!"
    },
    {
      "index": 4,
      "id": "msg_main8020_volt_10",
      "hash": "892e0721a2f00c32",
      "flags": 0,
      "text": "Let’s battle! Ti darò un bello shock con\\ni miei Pokémon!"
    },
    {
      "index": 5,
      "id": "msg_gymleader_03_07",
      "hash": "47fdc3356398ac8b",
      "flags": 0,
      "text": "[~ 5]"
    },
    {
      "index": 6,
      "id": "msg_main8020_volt_02",
      "hash": "89318f21a2f32921",
      "flags": 0,
      "text": "Wow!\\c\\nAlright, prendi la Medaglia Tuono!"
    },
    {
      "index": 7,
      "id": "msg_main8020_sys_01",
      "hash": "cbbdb782c305534c",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve la [VAR COLOR(0006)]Medaglia Tuono[VAR COLOR(0000)]\\nda Lt. Surge!"
    },
    {
      "index": 8,
      "id": "msg_main8020_volt_03",
      "hash": "89318e21a2f3276e",
      "flags": 4,
      "text": "Aaaand... Siccome sei speciale...\\nTieni, prendi questo!"
    },
    {
      "index": 9,
      "id": "msg_main8020_sys_02",
      "hash": "cbbdba82c3055865",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve un [VAR COLOR(0006)]Autografo[VAR COLOR(0000)]\\ndel Lt. Surge!"
    },
    {
      "index": 10,
      "id": "msg_main8020_volt_04",
      "hash": "89319121a2f32c87",
      "flags": 0,
      "text": "..."
    },
    {
      "index": 11,
      "id": "msg_main8020_volt_11",
      "hash": "892e0821a2f00de5",
      "flags": 4,
      "text": "Ah ah ah! Don’t worry! Ho anche altro da darti!\\nPrendi!"
    },
    {
      "index": 12,
      "id": "msg_main8020_sys_03",
      "hash": "cbbdb982c30556b2",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve la [VAR ITEM2(0001)]\\nche contiene [VAR COLOR(0006)][VAR MOVE(0002)][VAR COLOR(0000)] da Lt. Surge!"
    },
    {
      "index": 13,
      "id": "msg_main8020_volt_05",
      "hash": "89319021a2f32ad4",
      "flags": 4,
      "text": "Inside questa MT36 c’è Fulmine!\\c\\nÈ una mossa davvero shocking...\\nInsegnala ai tuoi Pokémon di tipo Elettro!"
    },
    {
      "index": 14,
      "id": "msg_main8020_volt_06",
      "hash": "89319321a2f32fed",
      "flags": 0,
      "text": "Voglio darti un advice!\\c\\nLe mosse di tipo Elettro sono davvero powerful,\\nma contro i Pokémon di tipo Terra sono useless!"
    },
    {
      "index": 15,
      "id": "msg_gymleader_03_06",
      "hash": "47fdc2356398aad8",
      "flags": 0,
      "text": "[~ 15]"
    }
  ],
