      "id": "msg_town008_fat_01",
      "hash": "1e2bdb6d43ba0e65",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Erik:[VAR COLOR(0000)] Dov’è Sara?\\nDovevamo incontrarci qui."
