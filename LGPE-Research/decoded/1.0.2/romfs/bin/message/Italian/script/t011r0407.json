{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t011r0407_staffm_01_01",
      "hash": "e697afe7de4cf5dc",
      "flags": 0,
      "text": "Chissà se è tutto a posto al 10º piano.\\nSono preoccupato per il nostro presidente..."
    },
    {
      "index": 1,
      "id": "msg_t011r0407_staffm_01_02",
      "hash": "e697b2e7de4cfaf5",
      "flags": 4,
      "text": "Hai salvato il nostro presidente!\\nGrazie mille, davvero!"
    },
    {
      "index": 2,
      "id": "msg_t011r0407_staffm_02_01",
      "hash": "1115a7dc94e43893",
      "flags": 4,
      "text": "Il Team Rocket stava cercando la Master Ball,\\nuna Poké Ball in grado di catturare qualsiasi\\r\\nPokémon a colpo sicuro!\\c\\nProbabilmente volevano produrle in massa."
    },
    {
      "index": 3,
      "id": "msg_t011r0407_staffm_02_02",
      "hash": "1115a8dc94e43a46",
      "flags": 0,
      "text": "Per colpa del Team Rocket il progetto della\\nMaster Ball è stato cancellato."
    },
    {
      "index": 4,
      "id": "msg_t011r0407_staffm_03_01",
      "hash": "0e26fbd76c64647e",
      "flags": 0,
      "text": "Sarebbe tremendo se la Silph S.p.A. e i Pokémon\\ncadessero nelle mani del Team Rocket!"
    },
    {
      "index": 5,
      "id": "msg_t011r0407_staffm_03_02",
      "hash": "0e26fad76c6462cb",
      "flags": 0,
      "text": "Wow!\\c\\nHai cacciato il Team Rocket senza nessun aiuto?"
    },
    {
      "index": 6,
      "id": "msg_t011r0407_stafff_01_01",
      "hash": "1df9a9528b42a8a9",
      "flags": 4,
      "text": "Ehi! È pericoloso qui!\\c\\nSei qui per salvarmi? Impossibile!"
    },
    {
      "index": 7,
      "id": "msg_t011r0407_stafff_01_02",
      "hash": "1df9a6528b42a390",
      "flags": 0,
      "text": "Finalmente salvi!\\nGrazie infinite!"
    },
    {
      "index": 8,
      "id": "msg_t011r0407_kanban_01",
      "hash": "cef63d77c514c564",
      "flags": 0,
      "text": "Sede della Silph S.p.A.\\n6º piano"
    }
  ],
