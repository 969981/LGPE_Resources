      "hash": "9d82bf08a6225dfd",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Archer:[VAR COLOR(0000)] Non un passo oltre!"
    },
    {
      "index": 1,
      "id": "msg_main0920_rival_01",
      "hash": "eea065068af47a9a",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Uah! Ancora tu?!"
    },
    {
      "index": 2,
      "id": "msg_main0920_rocketchief_02",
      "hash": "9d82bc08a62258e4",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Archer:[VAR COLOR(0000)] Sì, ancora io!\\nNon vi permetterò di arrivare dal capo!"
    },
    {
      "index": 3,
      "id": "msg_main0920_rival_02",
      "hash": "eea064068af478e7",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Eh?!\\nIl capo, hai detto?"
    },
    {
      "index": 4,
      "id": "msg_main0920_rival_03",
      "hash": "eea063068af47734",
      "flags": 0,
      "text": "[VAR TRNAME(0000)], sai cosa significa questo?"
    },
    {
      "index": 5,
      "id": "msg_main0920_select_01",
      "hash": "a495754c28984226",
      "flags": 0,
      "text": "Certo!"
    },
    {
      "index": 6,
      "id": "msg_main0920_select_02",
      "hash": "a495744c28984073",
      "flags": 0,
      "text": "Giovanni è qui!"
    },
    {
      "index": 7,
      "id": "msg_main0920_rival_04",
      "hash": "eea062068af47581",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Quindi il Capo del\\nTeam Rocket si trova in questo edificio...!\\c\\nBene, in tal caso..."
    },
    {
      "index": 8,
      "id": "msg_main0920_rival_05",
      "hash": "eea061068af473ce",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Vai, [VAR TRNAME(0000)]!\\nÈ la nostra opportunità per sconfiggerlo!"
    },
    {
      "index": 9,
      "id": "msg_main0920_rival_06",
      "hash": "eea060068af4721b",
      "flags": 4,
      "text": "Io intanto penserò a questo bellimbusto!"
    },
    {
      "index": 10,
      "id": "msg_main0920_rocketchief_03",
      "hash": "9d82bd08a6225a97",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Archer:[VAR COLOR(0000)] Ngh...\\nDevo avvertire il capo!"
    },
    {
      "index": 11,
      "id": "msg_main0920_rival_07",
      "hash": "eea05f068af47068",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Forza, [VAR TRNAME(0000)]!\\c\\nVai a sconfiggere il Capo del Team Rocket\\nuna volta per tutte!"
    },
