{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub087_middle_f_01",
      "hash": "69183b2fbfcbb2c9",
      "flags": 4,
      "text": "Oh, Slowpoke... Cosa devo fare con te?"
    },
    {
      "index": 1,
      "id": "msg_sub087_middle_f_02",
      "hash": "6918382fbfcbadb0",
      "flags": 4,
      "text": "Ehi, ciao! Non è che potresti farmi un favore?"
    },
    {
      "index": 2,
      "id": "msg_sub087_middle_f_03",
      "hash": "6918392fbfcbaf63",
      "flags": 0,
      "text": "Capisco, hai molto da fare...\\nScusa se ti ho disturbat[VAR GENDBR(00FF,0101)]oa!"
    },
    {
      "index": 3,
      "id": "msg_sub087_middle_f_04",
      "hash": "69183e2fbfcbb7e2",
      "flags": 0,
      "text": "Sai, vorrei proprio andare a fare un giro\\nal Museo di Plumbeopoli, ma il mio\\r\\nSlowpoke non vuole saperne di muoversi!"
    },
    {
      "index": 4,
      "id": "msg_sub087_yadon_01",
      "hash": "f0f118be8033672a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Slowpoke:[VAR COLOR(0000)] Slooooow..."
    },
    {
      "index": 5,
      "id": "msg_sub087_middle_f_05",
      "hash": "69183f2fbfcbb995",
      "flags": 0,
      "text": "Non è che ti andrebbe di tenerlo d’occhio\\nmentre sono via?"
    },
    {
      "index": 6,
      "id": "msg_sub087_middle_f_09",
      "hash": "6918432fbfcbc061",
      "flags": 4,
      "text": "Oh, chi si rivede! Sei tornat[VAR GENDBR(00FF,0101)]oa a tenere d’occhio\\nil mio Slowpoke?"
    },
    {
      "index": 7,
      "id": "msg_sub087_select_01",
      "hash": "087a940740025655",
      "flags": 0,
      "text": "Va bene"
    },
    {
      "index": 8,
      "id": "msg_sub087_select_02",
      "hash": "087a91074002513c",
      "flags": 0,
      "text": "Non posso..."
    },
    {
      "index": 9,
      "id": "msg_sub087_middle_f_06",
      "hash": "69183c2fbfcbb47c",
      "flags": 0,
      "text": "Grazie mille, sei un vero tesoro! Beh, allora\\nposso andarmene tranquilla, sapendo che\\r\\npenserai tu al mio Slowpoke!"
    },
    {
      "index": 10,
      "id": "msg_sub087_yadon_02",
      "hash": "f0f117be80336577",
      "flags": 0,
      "text": "... ... ..."
    },
    {
      "index": 11,
      "id": "msg_sub087_system_01",
      "hash": "a2604769f3459b22",
      "flags": 8,
      "text": "Slowpoke guarda di fronte a sé con aria\\ndistratta..."
    },
    {
      "index": 12,
      "id": "msg_sub087_system_02",
      "hash": "a2604669f345996f",
      "flags": 8,
      "text": "Slowpoke si dedica completamente\\nal far niente..."
    },
    {
      "index": 13,
      "id": "msg_sub087_system_03",
      "hash": "a2604569f34597bc",
      "flags": 8,
      "text": "Slowpoke se ne sta immobile con aria beata..."
    },
    {
      "index": 14,
      "id": "msg_sub087_system_04",
      "hash": "a2604469f3459609",
      "flags": 8,
      "text": "Slowpoke ha un’aria pensierosa..."
    },
    {
      "index": 15,
      "id": "msg_sub087_system_05",
      "hash": "a2604369f3459456",
      "flags": 8,
      "text": "Slowpoke si è accorto per la prima volta\\ndella presenza di [VAR TRNAME(0000)]..."
    },
    {
      "index": 16,
      "id": "msg_sub087_system_06",
      "hash": "a2604269f34592a3",
      "flags": 8,
      "text": "Slowpoke osserva [VAR TRNAME(0000)]\\ncercando di non farsi vedere..."
    },
    {
      "index": 17,
      "id": "msg_sub087_system_07",
      "hash": "a2604169f34590f0",
      "flags": 8,
      "text": "Slowpoke sembra interessarsi appena appena\\na [VAR TRNAME(0000)]..."
    },
    {
      "index": 18,
      "id": "msg_sub087_system_08",
      "hash": "a2605069f345aa6d",
      "flags": 8,
      "text": "Slowpoke sembra a suo agio\\nassieme a [VAR TRNAME(0000)]..."
    },
    {
      "index": 19,
      "id": "msg_sub087_system_09",
      "hash": "a2604f69f345a8ba",
      "flags": 8,
      "text": "Slowpoke sembra felice..."
    },
    {
      "index": 20,
      "id": "msg_sub087_system_10",
      "hash": "a25cc269f342834c",
      "flags": 8,
      "text": "Slowpoke è felice di passare del tempo\\nassieme a [VAR TRNAME(0000)]!"
    },
    {
      "index": 21,
      "id": "msg_sub087_system_11",
      "hash": "a25cc369f34284ff",
      "flags": 4,
      "text": "Hai trascorso del tempo in tranquillità\\nassieme a Slowpoke!"
    },
    {
      "index": 22,
      "id": "msg_sub087_middle_f_07",
      "hash": "69183d2fbfcbb62f",
      "flags": 0,
      "text": "Grazie mille per esserti pres[VAR GENDBR(00FF,0101)]oa cura\\ndel mio Slowpoke!\\c\\nTieni, questo è per ringraziarti del tuo aiuto!"
    },
    {
      "index": 23,
      "id": "msg_sub087_system_12",
      "hash": "a25cc469f34286b2",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve\\n[VAR VARITA02(0001)][VAR ITEM2(0001)] dalla signora!"
    },
    {
      "index": 24,
      "id": "msg_sub087_middle_f_08",
      "hash": "6918422fbfcbbeae",
      "flags": 0,
      "text": "Torna pure domani, se hai voglia di badare\\ndi nuovo al mio Slowpoke!"
    }
  ],
  "unpaired_labels": [
