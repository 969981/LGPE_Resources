{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub024_researcher_01",
      "hash": "d427d40043ea8c98",
      "flags": 0,
      "text": "Salve! Sono uno studioso importante, sai?\\nMolto importante!\\c\\nE mi occupo di fossili di Pokémon rari!\\c\\nHai qualche fossile da farmi vedere?"
    },
    {
      "index": 1,
      "id": "msg_sub024_select_01",
      "hash": "9c5bbb480ccf64a2",
      "flags": 4,
      "text": "Un Helixfossile"
    },
    {
      "index": 2,
      "id": "msg_sub024_select_02",
      "hash": "9c5bba480ccf62ef",
      "flags": 4,
      "text": "Un Domofossile"
    },
    {
      "index": 3,
      "id": "msg_sub024_select_03",
      "hash": "9c5bb9480ccf613c",
      "flags": 4,
      "text": "Un’Ambra antica"
    },
    {
      "index": 4,
      "id": "msg_sub024_select_04",
      "hash": "9c5bb8480ccf5f89",
      "flags": 0,
      "text": "Non ho fossili..."
    },
    {
      "index": 5,
      "id": "msg_sub024_researcher_02",
      "hash": "d427d70043ea91b1",
      "flags": 4,
      "text": "Oh, no! Che peccato..."
    },
    {
      "index": 6,
      "id": "msg_sub024_researcher_03",
      "hash": "d427d60043ea8ffe",
      "flags": 0,
      "text": "Ce l’ho fatta! Proprio come previsto!\\c\\nDal fossile che mi hai dato ho rigenerato\\n[VAR FRAITA][VAR VARITA02(0004)][VAR POKNAME(0004)]!"
    },
    {
      "index": 7,
      "id": "msg_sub024_sys_01",
      "hash": "0fa5772ce07503fd",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve [VAR POKNAME(0004)]\\ndallo strano studioso!"
    },
    {
      "index": 8,
      "id": "msg_sub024_researcher_04",
      "hash": "d427d90043ea9517",
      "flags": 4,
      "text": "Oh! Hai [VAR VARITA02(0002)][VAR ITEM2(0002)]!\\c\\nÈ un fossile di [VAR POKNAME(0001)], un Pokémon\\nestinto molto tempo fa!\\c\\nLo rigenererò con la mia macchina rigenera\\nPokémon, ok?"
    },
    {
      "index": 9,
      "id": "msg_sub024_researcher_05",
      "hash": "d427d80043ea9364",
      "flags": 0,
      "text": "Presto, da’ qua!"
    },
    {
      "index": 10,
      "id": "msg_sub024_sys_02",
      "hash": "0fa5742ce074fee4",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] dà [VAR VARITA00(0002)][VAR ITEM2(0002)]\\nallo strano studioso!"
    },
    {
      "index": 11,
      "id": "msg_sub024_researcher_06",
      "hash": "d427db0043ea987d",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_sub024_researcher_07",
      "hash": "d427da0043ea96ca",
      "flags": 0,
      "text": "Torna quando vuoi!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_024_max",
