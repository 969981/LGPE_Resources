    {
      "index": 1,
      "id": "msg_main0400_sailor_02",
      "hash": "4d9b65f4be6bb486",
      "flags": 0,
      "text": "Benvenut[VAR GENDBR(00FF,0101)]oa sulla Motonave Anna!\\nScusa, hai il biglietto?"
    },
    {
      "index": 2,
      "id": "msg_main0400_sys_01",
      "hash": "0c44b0c349338b86",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] mostra il Biglietto nave\\nal marinaio!"
    },
    {
      "index": 3,
      "id": "msg_main0400_sailor_03",
      "hash": "4d9b66f4be6bb639",
      "flags": 0,
      "text": "Benissimo! Accomodati pure a bordo!\\c\\nOh...! Congratulazioni! Sei [VAR GENDBR(00FF,0C0C)]il centesimola centesima\\npassegger[VAR GENDBR(00FF,0101)]oa di oggi!\\c\\nTieni, questo è per te...\\c\\nUn completo leggerissimo, ideale per chi\\nama farsi accarezzare dalla brezza marina!"
    },
    {
      "index": 4,
      "id": "msg_main0400_sys_02",
      "hash": "0c44afc3493389d3",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve il [VAR COLOR(0006)]completo da marinaio[VAR COLOR(0000)]\\ndal marinaio!"
    },
    {
      "index": 5,
      "id": "msg_main0400_sys_04",
      "hash": "0c44b5c349339405",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] ripone il [VAR COLOR(0006)]completo da marinaio[VAR COLOR(0000)]\\nnella Valigia vestiti!"
    },
    {
      "index": 6,
      "id": "msg_main0400_sailor_04",
