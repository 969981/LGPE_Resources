  "lines": [
    {
      "index": 0,
      "id": "msg_town005_kanban_01",
      "hash": "e9b56ce052d8e502",
      "flags": 0,
      "text": "Lavandonia\\nNobile città viola"
    },
    {
      "index": 1,
      "id": "msg_town005_kanban_02",
      "hash": "e9b56be052d8e34f",
      "flags": 0,
      "text": "La nuova Spettrosonda è ora disponibile\\ne rende visibile l’invisibile!\\r\\nSilph S.p.A."
    },
    {
      "index": 2,
      "id": "msg_town005_kanban_03",
      "hash": "e9b56ae052d8e19c",
      "flags": 0,
      "text": "Casa Pokémon\\nCentro di volontariato di Lavandonia"
    },
    {
      "index": 3,
      "id": "msg_town005_kanban_04",
      "hash": "e9b569e052d8dfe9",
      "flags": 0,
      "text": "Torre Pokémon\\nChe le anime dei Pokémon riposino in pace!"
    },
    {
      "index": 4,
      "id": "msg_town005_juveniles_01_01",
      "hash": "dd108a5f7ce63432",
      "flags": 0,
      "text": "Credi agli spettri?"
    },
    {
      "index": 5,
      "id": "msg_town005_juveniles_01_02",
      "hash": "dd10895f7ce6327f",
      "flags": 0,
      "text": "Davvero?\\nNon farmi ridere!"
    },
    {
      "index": 6,
      "id": "msg_town005_juveniles_01_03",
      "hash": "dd10885f7ce630cc",
      "flags": 4,
      "text": "Ah ah ah! Neppure io!\\nQuindi quella mano bianca sulla tua spalla...\\r\\nè solo frutto della mia immaginazione, vero?"
    },
    {
      "index": 7,
      "id": "msg_town005_adultm_01",
      "hash": "85160d0b0641adba",
      "flags": 0,
      "text": "Questa città è famosa per le tombe\\ndei Pokémon.\\c\\nQuando i Pokémon muoiono vengono portati\\nalla Torre Pokémon, affinché il loro spirito possa\\r\\nriposare in pace."
    },
    {
      "index": 8,
      "id": "msg_town005_youngm_01",
      "hash": "992c8d4ceabdd3c2",
      "flags": 0,
      "text": "Sono apparsi degli spettri nella Torre Pokémon.\\c\\nSembra che siano gli spiriti dei Pokémon che non\\nsono riusciti a sfuggire alle grinfie\\r\\ndel Team Rocket."
    },
    {
      "index": 9,
      "id": "msg_town005_oldf_01",
      "hash": "2d0312137a06f17c",
      "flags": 4,
      "text": "Aaah... Come mi rilassa il profumo dell’incenso..."
    },
    {
      "index": 10,
      "id": "msg_town005_poke_01",
      "hash": "575f74472b704770",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Nidoran♀:[VAR COLOR(0000)] Nidooo!"
    },
    {
      "index": 11,
      "id": "msg_town005_childf_01",
      "hash": "e3b08901e734d73f",
      "flags": 0,
      "text": "Non si fa rumore nella Torre Pokémon!\\nMe lo ha detto la mamma..."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_town005_max",
