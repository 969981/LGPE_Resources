  "lines": [
    {
      "index": 0,
      "id": "msg_main1200_rival_01",
      "hash": "723f186098a8ef50",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Mmh...?\\nPerché la Palestra è chiusa?"
    },
    {
      "index": 1,
      "id": "msg_main1200_rival_02",
      "hash": "723f1b6098a8f469",
      "flags": 4,
      "text": "Apriti sesamo!"
    },
    {
      "index": 2,
      "id": "msg_main1200_rival_03",
      "hash": "723f1a6098a8f2b6",
      "flags": 0,
      "text": "Vabbè, ci ho provato..."
    },
    {
      "index": 3,
      "id": "msg_main1200_rival_04",
      "hash": "723f1d6098a8f7cf",
      "flags": 0,
      "text": "Bah..."
    },
    {
      "index": 4,
      "id": "msg_main1200_rival_05",
      "hash": "723f1c6098a8f61c",
      "flags": 4,
      "text": "Ah, [VAR TRNAME(0000)]! Eri qui!\\c\\nDi’ qualcosa la prossima volta! Fatti notare!\\nVorrei evitare di fare queste figuracce..."
    },
    {
      "index": 5,
      "id": "msg_main1200_rival_06",
      "hash": "723f1f6098a8fb35",
      "flags": 0,
      "text": "Vabbè...\\nDimmi, piuttosto... tu quante Medaglie hai?"
    },
    {
      "index": 6,
      "id": "msg_main1200_rival_10",
      "hash": "723bb36098a60dda",
      "flags": 0,
      "text": "... Sette?! Come me! Wow!\\c\\nOrmai non ci resta da affrontare che la Palestra\\ndi Smeraldopoli!\\r\\nSolo che è chiusa..."
    },
    {
      "index": 7,
      "id": "msg_main1200_rival_07",
      "hash": "723f1e6098a8f982",
      "flags": 0,
      "text": "Forse possiamo chiedere informazioni\\na qualcuno...\\c\\nUhm... Ma a chi potremmo chiedere...?"
    },
    {
      "index": 8,
      "id": "msg_main1200_select_01",
      "hash": "4847a94b196d6768",
      "flags": 4,
      "text": "Al Professor Oak"
    },
    {
      "index": 9,
      "id": "msg_main1200_select_02",
      "hash": "4847ac4b196d6c81",
      "flags": 4,
      "text": "A [VAR POKNAME(0003)]"
    },
    {
      "index": 10,
      "id": "msg_main1200_select_03",
      "hash": "4847ab4b196d6ace",
      "flags": 4,
      "text": "A quel vecchietto lì"
    },
    {
      "index": 11,
      "id": "msg_main1200_oldman_01",
      "hash": "c70dc56b184a5299",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Vecchietto: [VAR COLOR(0000)]Che? Io...? Boh! Io non ne ho la più\\npallida idea..."
    },
    {
      "index": 12,
      "id": "msg_main1200_rival_11",
      "hash": "723bb46098a60f8d",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Già... Non credo proprio che\\nquel signore ne sappia qualcosa...\\c\\nDunque... pensiamoci un po’ su..."
    },
    {
      "index": 13,
      "id": "msg_main1200_rival_08",
      "hash": "723f216098a8fe9b",
      "flags": 0,
      "text": "Sì, facciamo così! Andiamo, allora!"
    },
    {
      "index": 14,
      "id": "msg_main1200_poke_01",
      "hash": "463c8e1cd61b3757",
      "flags": 0,
      "text": "Pika pikaaa!"
    },
    {
      "index": 15,
      "id": "msg_main1200_poke_02",
      "hash": "463c8f1cd61b390a",
      "flags": 0,
      "text": "Veeee!"
    },
    {
      "index": 16,
      "id": "msg_main1200_rival_09",
      "hash": "723f206098a8fce8",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Ma certo! Come ho fatto\\na non pensarci prima!\\c\\nEh eh... Scherzo! Non ho proprio idea di cosa\\nstia dicendo..."
    }
  ],
