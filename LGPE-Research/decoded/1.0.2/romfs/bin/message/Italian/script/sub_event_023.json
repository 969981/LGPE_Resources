    {
      "index": 8,
      "id": "msg_sub023_karate_01_04",
      "hash": "eaf8a85e834718a2",
      "flags": 0,
      "text": "Vuoi Hitmonlee, dal calcio devastante?"
    },
    {
      "index": 9,
      "id": "msg_sub023_sys_01_01",
      "hash": "384f6f255b68c6d4",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve [VAR VARITA02(0004)][VAR POKNAME(0004)]\\ndal maestro di karate!"
