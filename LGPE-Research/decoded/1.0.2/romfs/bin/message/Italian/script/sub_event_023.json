      "hash": "eaf8a55e83471389",
      "flags": 0,
      "text": "Grrr!\\c\\nSono il maestro di karate! Sono il capo qui!"
    },
    {
      "index": 1,
      "id": "msg_sub023_karate_01_09",
      "hash": "eaf8ad5e83472121",
      "flags": 0,
      "text": "Vuoi sfidarci? Non avremo pietà!"
    },
    {
      "index": 2,
      "id": "msg_sub023_karate_01_10",
      "hash": "eafc2a5e834a2b5f",
      "flags": 0,
      "text": "Fuaaa!"
    },
    {
      "index": 3,
      "id": "msg_sub023_karate_01_02",
      "hash": "eaf8a25e83470e70",
      "flags": 4,
      "text": "Ebbene sì, ho perso!"
    },
    {
      "index": 4,
      "id": "msg_sub023_karate_01_07",
      "hash": "eaf8a75e834716ef",
      "flags": 0,
      "text": "Ma ti supplico di non prendere il nostro\\nemblema come trofeo!"
    },
    {
      "index": 5,
      "id": "msg_sub023_karate_01_08",
      "hash": "eaf8ac5e83471f6e",
      "flags": 4,
      "text": "In cambio ti darò un potente Pokémon\\ndi tipo Lotta!"
    },
    {
      "index": 6,
      "id": "msg_sub023_karate_01_06",
      "hash": "eaf8a65e8347153c",
      "flags": 8,
      "text": "Scegli quello che preferisci!"
    },
    {
      "index": 7,
      "id": "msg_sub023_karate_01_03",
      "hash": "eaf8a35e83471023",
      "flags": 4,
      "text": "Ehi! Vuoi fare degli allenamenti di karate\\ncon noi?"
