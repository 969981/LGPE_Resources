{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub020_sys_01",
      "hash": "61867d565a832009",
      "flags": 0,
      "text": "C’è un Pokémon che dorme con aria beata!"
    },
    {
      "index": 1,
      "id": "msg_sub020_sys_02",
      "hash": "61867a565a831af0",
      "flags": 0,
      "text": "Vuoi suonare il Poké Flauto?"
    },
    {
      "index": 2,
      "id": "msg_sub020_sys_03",
      "hash": "61867b565a831ca3",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] suona il Poké Flauto."
    },
    {
      "index": 3,
      "id": "msg_sub020_sys_04",
      "hash": "618680565a832522",
      "flags": 8,
      "text": "Snorlax si è risvegliato!"
    },
    {
      "index": 4,
      "id": "msg_sub020_sys_07",
      "hash": "61867f565a83236f",
      "flags": 8,
      "text": "Snorlax fissa [VAR TRNAME(0000)] con aria\\nmolto affamata...!"
    },
    {
      "index": 5,
      "id": "msg_sub020_fuji_01",
      "hash": "dd4ceab8a4c8f45a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]???:[VAR COLOR(0000)] [VAR TRNAME(0000)]!"
    },
    {
      "index": 6,
      "id": "msg_sub020_fuji_02",
      "hash": "dd4ce9b8a4c8f2a7",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Mr. Fuji:[VAR COLOR(0000)] Quando ti ho dato il Poké Flauto\\nho dimenticato di dirti una cosa importante..."
    },
    {
      "index": 7,
      "id": "msg_sub020_fuji_03",
      "hash": "dd4ce8b8a4c8f0f4",
      "flags": 4,
      "text": "Ah, vedo che sono arrivato proprio\\nal momento giusto!"
    },
    {
      "index": 8,
      "id": "msg_sub020_fuji_05",
      "hash": "dd4ce6b8a4c8ed8e",
      "flags": 4,
      "text": "Uno Snorlax appena sveglio può essere\\nmolto pericoloso.\\c\\nSpesso scambia la prima cosa che vede\\nper un succulento spuntino... e attacca!"
    },
    {
      "index": 9,
      "id": "msg_sub020_fuji_06",
      "hash": "dd4ce5b8a4c8ebdb",
      "flags": 4,
      "text": "In questi casi, la cosa migliore\\nè farlo calmare con una lotta!"
    },
    {
      "index": 10,
      "id": "msg_sub020_fuji_07",
      "hash": "dd4ce4b8a4c8ea28",
      "flags": 0,
      "text": "Dopo averlo sconfitto potrai provare a catturarlo\\nnormalmente."
    },
    {
      "index": 11,
      "id": "msg_sub020_sys_06",
      "hash": "61867e565a8321bc",
      "flags": 8,
      "text": "Snorlax sembra un po’ confuso e... ti attacca!"
    },
    {
      "index": 12,
      "id": "msg_sub020_sys_05",
      "hash": "618681565a8326d5",
      "flags": 8,
      "text": "Snorlax si calma, poi sbadiglia e se ne torna\\nsulle montagne!"
    },
    {
      "index": 13,
      "id": "msg_sub020_fuji_08",
      "hash": "dd4ce3b8a4c8e875",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Mr. Fuji:[VAR COLOR(0000)] Ben fatto, [VAR TRNAME(0000)]!\\nOttimo lavoro!"
    },
    {
      "index": 14,
      "id": "msg_sub020_fuji_09",
      "hash": "dd4ce2b8a4c8e6c2",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Mr. Fuji:[VAR COLOR(0000)] Che peccato, [VAR TRNAME(0000)]!\\nNon sei riuscit[VAR GENDBR(00FF,0101)]oa a catturarlo!"
    },
    {
      "index": 15,
      "id": "msg_sub020_fuji_10",
      "hash": "dd4965b8a4c5dc84",
      "flags": 4,
      "text": "Alcuni Pokémon si comportano come questo\\nSnorlax e attaccano tutti gli Allenatori\\r\\nche gli capitano a tiro!\\c\\nPer catturarli, dovrai prima sconfiggerli\\nin una lotta. Tutto chiaro?\\c\\nRicapitolando: lotta, vittoria, cattura!"
    },
    {
      "index": 16,
      "id": "msg_sub020_fuji_11",
      "hash": "dd4966b8a4c5de37",
      "flags": 0,
      "text": "Beh, ci vediamo!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_020_max",
      "hash": "af6dc9a4f7b39c54"
    }
  ]
}
