{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "poke_waza_01_01",
      "hash": "29fdd1ac6c57525c",
      "flags": 4,
      "text": "Io sono... Ecco... io...\\nOps... Non me lo ricordo più...!\\c\\n...\\n... ...\\c\\nAh, aspetta! Ora mi ricordo!\\nSì! Sono il Cancellamosse!"
    },
    {
      "index": 1,
      "id": "poke_waza_01_02",
      "hash": "29fdd4ac6c575775",
      "flags": 0,
      "text": "Sei qui per far dimenticare delle mosse ai tuoi\\nPokémon?"
    },
    {
      "index": 2,
      "id": "poke_waza_01_03",
      "hash": "29fdd3ac6c5755c2",
      "flags": 8,
      "text": "Scegli un Pokémon."
    },
    {
      "index": 3,
      "id": "poke_waza_01_04",
      "hash": "29fdceac6c574d43",
      "flags": 0,
      "text": "Ricordati di me quando vuoi far dimenticare\\nuna mossa a un tuo Pokémon!"
    },
    {
      "index": 4,
      "id": "poke_waza_01_05",
      "hash": "29fdcdac6c574b90",
      "flags": 4,
      "text": "Il tuo Pokémon conosce solo una mossa.\\nNon puoi fargliela dimenticare!"
    },
    {
      "index": 5,
      "id": "poke_waza_01_06",
      "hash": "29fdd0ac6c5750a9",
      "flags": 0,
      "text": "Ma... è un Uovo...! Questo Pokémon non è ancora\\nnato, come può avere mosse da dimenticare...?"
    },
    {
      "index": 6,
      "id": "poke_waza_01_07",
      "hash": "29fdcfac6c574ef6",
      "flags": 0,
      "text": "Va bene... e poi cosa volevo dire...?\\nAh, sì! Quale mossa vuoi fargli dimenticare?"
    },
    {
      "index": 7,
      "id": "poke_waza_01_08",
      "hash": "29fddaac6c5761a7",
      "flags": 4,
      "text": "È andato tutto a meraviglia!\\c\\nIl tuo Pokémon ha completamente\\ndimenticato [VAR MOVE(0000)]!"
    },
    {
      "index": 8,
      "id": "poke_waza_02_01",
      "hash": "547bc9a122ee9513",
      "flags": 4,
      "text": "Io sono Memorina. Conosco tutte le mosse\\nche i Pokémon imparano crescendo.\\c\\nE posso far ricordare loro quelle che hanno\\ndimenticato!\\c\\nIn cambio, ti chiedo solo una Squama Cuore."
    },
    {
      "index": 9,
      "id": "poke_waza_02_02",
      "hash": "547bcaa122ee96c6",
      "flags": 0,
      "text": "Vuoi far ricordare una mossa a un tuo Pokémon\\nin cambio di [VAR VARITA02(0000)][VAR ITEM2(0000)]?"
    },
    {
      "index": 10,
      "id": "poke_waza_02_03",
      "hash": "547bcba122ee9879",
      "flags": 0,
      "text": "Se vuoi far ricordare una mossa a un Pokémon,\\nportami [VAR VARITA02(0000)][VAR ITEM2(0000)]!"
    },
    {
      "index": 11,
      "id": "poke_waza_02_04",
      "hash": "547bcca122ee9a2c",
      "flags": 8,
      "text": "Scegli un Pokémon."
    },
    {
      "index": 12,
      "id": "poke_waza_02_05",
      "hash": "547bcda122ee9bdf",
      "flags": 0,
      "text": "Ma... quello è un Uovo!"
    },
    {
      "index": 13,
      "id": "poke_waza_02_06",
      "hash": "547bcea122ee9d92",
      "flags": 4,
      "text": "Anche con le migliori intenzioni, non potrebbe\\nricordare alcuna mossa..."
    },
    {
      "index": 14,
      "id": "poke_waza_02_07",
      "hash": "547bcfa122ee9f45",
      "flags": 0,
      "text": "Quale mossa vuoi che ricordi?"
    },
    {
      "index": 15,
      "id": "poke_waza_02_13",
      "hash": "547f4ba122f1a7d0",
      "flags": 0,
      "text": "Memorina riceve [VAR VARITA00(0000)][VAR ITEM2(0000)] in cambio!"
    },
    {
      "index": 16,
      "id": "poke_waza_02_14",
      "hash": "547f52a122f1b3b5",
      "flags": 4,
      "text": "Ecco fatto, mossa ricordata!\\nTorna pure quando vuoi!"
    },
    {
      "index": 17,
      "id": "poke_waza_02_15",
      "hash": "547f51a122f1b202",
      "flags": 4,
      "text": "Uno,[WAIT 20] due[WAIT 20] e[WAIT 20]...[WAIT 20] ta-daaaa![VAR SFX(0003)][VAR SFX(0000)]\\c\\n[VAR PKNICK(0000)] dimentica [VAR MOVE(0001)]!\\c\\nAl suo posto...\\c\\n[VAR PKNICK(0000)] impara [VAR MOVE(0002)]![VAR SFX(0004)][VAR SFX(0001)]\\n"
    },
    {
      "index": 18,
      "id": "poke_waza_02_16",
      "hash": "547f50a122f1b04f",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] impara [VAR MOVE(0002)]![VAR SFX(0004)][VAR SFX(0001)]"
    },
