    },
    {
      "index": 7,
      "id": "msg_main0030_new_doctor_01",
      "hash": "e79395d568abbc54",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Prof. Oak:[VAR COLOR(0000)] Grazie dell’aiuto, miei piccoli\\nPidgey!"
    },
    {
      "index": 8,
      "id": "msg_main0030_new_doctor_09",
      "hash": "e7938dd568abaebc",
      "flags": 4,
      "text": "Oggi ho imparato qualcosa di nuovo su di voi."
    },
    {
      "index": 9,
      "id": "msg_main0030_new_doctor_02",
      "hash": "e79398d568abc16d",
      "flags": 4,
      "text": "Oh, chi si vede. Ciao, [VAR TRNAME(0000)]!"
    },
    {
      "index": 10,
      "id": "msg_main0030_new_doctor_10",
      "hash": "e79010d568a8a47e",
      "flags": 4,
      "text": "Ah, giusto, giusto! Oggi è un giorno molto\\nimportante per te e [VAR TRNAME(0001)].\\c\\nSpero siate pronti a ricevere i vostri primi\\nPokémon! Presto, andiamo al mio laboratorio."
    },
    {
      "index": 11,
      "id": "msg_main0030_new_doctor_03",
      "hash": "e79397d568abbfba",
      "flags": 0,
      "text": "Mmh?"
    },
    {
      "index": 12,
      "id": "msg_main0030_new_doctor_04",
      "hash": "e79392d568abb73b",
      "flags": 0,
      "text": "Ma cosa...?!"
    },
    {
      "index": 13,
      "id": "msg_main0030_new_doctor_05",
      "hash": "e79391d568abb588",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Prof. Oak:[VAR COLOR(0000)] Però, complimenti! Una cattura\\nesemplare, per essere la tua prima volta."
    },
    {
      "index": 14,
      "id": "msg_main0030_new_doctor_11",
      "hash": "e79011d568a8a631",
      "flags": 0,
      "text": "Su, raccogli la Poké Ball.\\c\\nSe vuoi puoi dare un soprannome\\n[VAR VARITA06(0002)][VAR POKNAME(0002)] che hai appena catturato!"
    },
    {
      "index": 15,
      "id": "msg_main0030_new_doctor_06",
      "hash": "e79394d568abbaa1",
      "flags": 0,
      "text": "Ma che succede?!"
    },
    {
      "index": 16,
      "id": "msg_main0030_new_doctor_07",
      "hash": "e79393d568abb8ee",
      "flags": 0,
      "text": "Non ho mai visto un Pokémon così irrequieto!"
    },
    {
      "index": 17,
      "id": "msg_main0030_new_doctor_08",
      "hash": "e7938ed568abb06f",
      "flags": 4,
      "text": "Aspetta! Ma dove vai?!"
    }
  ],
