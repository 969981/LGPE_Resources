{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t003r0102_scientist_01_01",
      "hash": "514b6d4ef4dcd574",
      "flags": 0,
      "text": "La mostra di questo mese è dedicata allo spazio."
    },
    {
      "index": 1,
      "id": "msg_t003r0102_juvenilem_01_01",
      "hash": "10f7633cdae62c4f",
      "flags": 4,
      "text": "Una Pietralunare... Cos’ha di tanto speciale?"
    },
    {
      "index": 2,
      "id": "msg_t003r0102_oldm_01_01",
      "hash": "b1922d572e9219a6",
      "flags": 0,
      "text": "Quasi mezzo secolo fa l’uomo ha messo piede\\nsulla luna...\\c\\nOra si punta più lontano, ed è il pianeta rosso\\nla nuova meta da raggiungere.\\c\\nChe emozione! Le notizie sui viaggi nello spazio\\nmi appassionano sempre!"
    },
    {
      "index": 3,
      "id": "msg_t003r0102_juveniles_01_01",
      "hash": "5cb2366d0b013951",
      "flags": 0,
      "text": "Voglio [VAR FRAITA][VAR VARITA02(0002)][VAR POKNAME(0002)]! È così carino!\\nPapà, me ne catturi uno?"
    },
    {
      "index": 4,
      "id": "msg_t003r0102_fat_01_01",
      "hash": "66105d63106ee55d",
      "flags": 0,
      "text": "Sì, promesso, avrai il tuo [VAR POKNAME(0002)]!"
    },
    {
      "index": 5,
      "id": "msg_t003r0102_fat_01_02",
      "hash": "66105a63106ee044",
      "flags": 0,
      "text": "Mmmmh... Volevo chiederti di darmi\\nil tuo [VAR POKNAME(0002)]... ma non me la sento...\\c\\nSi vede che diventerete grandi amici, voi due..."
    },
    {
      "index": 6,
      "id": "msg_t003r0102_fat_01_03",
      "hash": "66105b63106ee1f7",
      "flags": 0,
      "text": "Mi piacerebbe avere il tuo [VAR POKNAME(0002)],\\nma sembra così affezionato a te..."
    },
    {
      "index": 7,
      "id": "msg_t003r0102_tenji_01",
      "hash": "921e27ae1e5adf7e",
      "flags": 8,
      "text": "Space Shuttle"
    },
    {
      "index": 8,
      "id": "msg_t003r0102_tenji_02",
      "hash": "921e26ae1e5addcb",
      "flags": 4,
      "text": "Un meteorite caduto sul Monte Luna.\\nPare si tratti di una Pietralunare."
    },
    {
      "index": 9,
      "id": "msg_t003r0102_tenji_03",
      "hash": "921e25ae1e5adc18",
      "flags": 4,
      "text": "Un ologramma tridimensionale intitolato\\n“La mappa dell’universo”."
    },
    {
      "index": 10,
      "id": "msg_t003r0102_tenji_04",
      "hash": "921e2cae1e5ae7fd",
      "flags": 0,
      "text": "Dei frammenti di meteorite."
    },
    {
      "index": 11,
      "id": "msg_t003r0102_tenji_05",
      "hash": "921e2bae1e5ae64a",
      "flags": 0,
      "text": "L’origine dell’universo."
    },
    {
      "index": 12,
      "id": "msg_t003r0102_bg_01",
      "hash": "1bd115a03a3feafd",
      "flags": 0,
      "text": "Percorso di visita"
    },
    {
      "index": 13,
      "id": "msg_t003r0102_bg_02",
      "hash": "1bd112a03a3fe5e4",
      "flags": 0,
      "text": "Nel microscopio si vede un meraviglioso\\ncristallo!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t003r0102_max",
      "hash": "593271a4df38e148"
    }
  ]
}
