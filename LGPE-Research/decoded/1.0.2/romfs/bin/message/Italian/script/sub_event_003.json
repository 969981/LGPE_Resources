    {
      "index": 15,
      "id": "msg_sub003_childf_07",
      "hash": "c1626854b51baaf3",
      "flags": 0,
      "text": "Forte! Un Lemonsucco!\\c\\nGrazie! Prendi questa in cambio!"
    },
    {
      "index": 16,
      "id": "msg_sub003_childf_08",
      "hash": "c1627554b51bc10a",
      "flags": 0,
      "text": "La MT07 contiene Protezione!\\c\\nÈ una mossa che permette di bloccare tutti\\ngli attacchi del nemico!"
