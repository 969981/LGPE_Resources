    {
      "index": 12,
      "id": "msg_sub003_childf_05",
      "hash": "c1626a54b51bae59",
      "flags": 0,
      "text": "Fantastico! Una Gassosa!\\c\\nGrazie! Prendi questa in cambio!"
    },
    {
      "index": 13,
      "id": "msg_sub003_childf_06",
      "hash": "c1626754b51ba940",
      "flags": 0,
      "text": "La MT09 contiene Riflesso!\\c\\nÈ una mossa che riduce i danni causati\\ndagli attacchi fisici del nemico."
    },
    {
      "index": 14,
      "id": "msg_present_01_p07_t007_fs07",
