    {
      "index": 8,
      "id": "msg_sub003_childf_03",
      "hash": "c1626c54b51bb1bf",
      "flags": 4,
      "text": "Evviva! Dell’Acqua fresca!\\c\\nGrazie! Prendi questa in cambio!"
    },
    {
      "index": 9,
      "id": "msg_sub003_sys_02",
      "hash": "18b71f43373e4401",
      "flags": 0,
      "text": "[~ 9]"
    },
    {
      "index": 10,
      "id": "msg_sub003_childf_04",
      "hash": "c1626954b51baca6",
      "flags": 0,
      "text": "La MT06 contiene Schermoluce!\\c\\nÈ una mossa che riduce i danni causati\\ndagli attacchi speciali del nemico."
    },
    {
      "index": 11,
      "id": "msg_present_01_p05_t007_fs07",
