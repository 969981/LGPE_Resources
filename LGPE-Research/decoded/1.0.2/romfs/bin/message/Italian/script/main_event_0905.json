    {
      "index": 4,
      "id": "msg_main0905_green_01",
      "hash": "31286df728b1b018",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Blu:[VAR COLOR(0000)] Vuoi sfidarmi tu per prim[VAR GENDBR(00FF,0101)]oa?"
    },
    {
      "index": 5,
      "id": "msg_main0905_green_02",
      "hash": "312870f728b1b531",
      "flags": 0,
      "text": "Molto bene! Cominciamo!"
    },
    {
      "index": 6,
      "id": "msg_main0905_dummy_02",
      "hash": "3ce78b6f47fb37f4",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main0905_green_03",
      "hash": "31286ff728b1b37e",
      "flags": 4,
      "text": "Ah no? Come preferisci."
    },
    {
      "index": 8,
      "id": "msg_main0905_green_04",
      "hash": "312872f728b1b897",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Blu:[VAR COLOR(0000)] Ah ah ah! Direi che sei abbastanza forte\\nper affrontare il Team Rocket!\\c\\nLa Silph S.p.A. è in buone mani.\\nPosso stare tranquillo!"
    },
    {
      "index": 9,
      "id": "msg_main0905_red_03",
      "hash": "cf2dde7ee5ed07ce",
      "flags": 0,
      "text": "[~ 9]"
    },
    {
      "index": 10,
      "id": "msg_main0905_sys_02",
      "hash": "b0a05f3c3ff2a7a3",
      "flags": 0,
      "text": "[~ 10]"
    },
    {
      "index": 11,
      "id": "msg_main0905_green_05",
      "hash": "312871f728b1b6e4",
      "flags": 4,
      "text": "Ok, adesso tocca a te, [VAR TRNAME(0001)]!\\nFatti sotto!"
    },
    {
      "index": 12,
      "id": "msg_main0905_rival_01",
      "hash": "ab975143120cf9bd",
      "flags": 0,
      "text": "[~ 12]"
    },
    {
      "index": 13,
      "id": "msg_main0905_rival_02",
      "hash": "ab974e43120cf4a4",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Uff! Mi sono agitato\\nanche solo a guardarvi lottare...!\\c\\nHai visto che sguardo i Pokémon di Blu?!\\nPazzesco...\\c\\nMa anche io mi farò valere, vedrai!\\nTu vai pure avanti, [VAR TRNAME(0000)]!"
    },
    {
      "index": 14,
      "id": "msg_main0905_stafff_01",
      "hash": "0dd0da442d90e603",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Receptionist:[VAR COLOR(0000)] Blu è un Allenatore famoso, sai?!\\nEd è così forte...\\c\\nMi è pure sembrato che facesse sul serio con te.\\nForse potresti davvero salvare la Silph S.p.A.!"
    }
