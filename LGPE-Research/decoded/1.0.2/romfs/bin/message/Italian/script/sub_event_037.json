{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub037_adultf_01",
      "hash": "0754a41f7a189db8",
      "flags": 4,
      "text": "Io mi prendo cura dei Pokémon feriti."
    },
    {
      "index": 1,
      "id": "msg_sub037_adultf_02",
      "hash": "0754a71f7a18a2d1",
      "flags": 0,
      "text": "Questo Bulbasaur ormai si è rimesso del tutto,\\nquindi vorrei affidarlo a un Allenatore che ha\\r\\ncatturato molti Pokémon, una persona fidata..."
    },
    {
      "index": 2,
      "id": "msg_sub037_adultf_08",
      "hash": "07549d1f7a1891d3",
      "flags": 0,
      "text": "Dimmi un po’, quanti Pokémon\\nhai catturato finora?\\c\\nOh, ne hai catturati [VAR NUM9(0000,002E)]...?!"
    },
    {
      "index": 3,
      "id": "msg_sub037_adultf_03",
      "hash": "0754a61f7a18a11e",
      "flags": 4,
      "text": "Incredibile! Che ne dici di prendere tu\\nquesto Bulbasaur?"
    },
    {
      "index": 4,
      "id": "msg_sub037_adultf_04",
      "hash": "0754a91f7a18a637",
      "flags": 4,
      "text": "Allora te lo affido!\\nTrattalo bene, mi raccomando!"
    },
    {
      "index": 5,
      "id": "msg_sub037_adultf_09",
      "hash": "07549c1f7a189020",
      "flags": 0,
      "text": "Puoi tornare quando avrai catturato\\nalmeno [VAR NUM2(0000)] Pokémon?"
    },
    {
      "index": 6,
      "id": "msg_sub037_adultf_05",
      "hash": "0754a81f7a18a484",
      "flags": 0,
      "text": "Sono certa che Bulbasaur se la passa bene\\ncon te!"
    },
    {
      "index": 7,
      "id": "msg_sub037_adultf_06",
      "hash": "0754ab1f7a18a99d",
      "flags": 4,
      "text": "Oh, capisco...\\nChe peccato..."
    },
    {
      "index": 8,
      "id": "msg_sub037_poke_01",
      "hash": "96bdf2947fd99335",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Bulbasaur:[VAR COLOR(0000)] Bulba!\\nBulbasauuuur!"
    }
  ],
