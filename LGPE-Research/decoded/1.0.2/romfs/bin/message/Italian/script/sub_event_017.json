    {
      "index": 13,
      "id": "msg_sub017_system_06",
      "hash": "6b07f6203d385962",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] osserva le bollicine\\ndella Gassosa con aria stupita!"
