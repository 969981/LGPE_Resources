    {
      "index": 8,
      "id": "msg_sub017_system_03",
      "hash": "6b07f3203d385449",
      "flags": 0,
      "text": "Non hai abbastanza soldi!\\c\\nUn momento... In fondo a una tasca trovi\\n500 ₽! Che fortuna!"
    },
    {
      "index": 9,
      "id": "msg_sub017_system_04",
      "hash": "6b07f4203d3855fc",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] dà [VAR VARITA00(0002)][VAR ITEM2(0002)]\\na [VAR PKNICK(0003)]!"
