{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t003r0101_scientist_01_01",
      "hash": "40fdab8e6795129d",
      "flags": 4,
      "text": "Il biglietto per i bambini costa 50 ₽.\\nVuoi entrare?"
    },
    {
      "index": 1,
      "id": "msg_t003r0101_scientist_01_02",
      "hash": "40fda88e67950d84",
      "flags": 0,
      "text": "Torna quando vuoi."
    },
    {
      "index": 2,
      "id": "msg_t003r0101_scientist_01_03",
      "hash": "40fda98e67950f37",
      "flags": 0,
      "text": "Bene, sono 50 ₽! Grazie!"
    },
    {
      "index": 3,
      "id": "msg_t003r0101_scientist_01_04",
      "hash": "40fda68e67950a1e",
      "flags": 0,
      "text": "Mi dispiace... Non hai abbastanza soldi!"
    },
    {
      "index": 4,
      "id": "msg_t003r0101_scientist_01_05",
      "hash": "40fda78e67950bd1",
      "flags": 0,
      "text": "Buon divertimento!"
    },
    {
      "index": 5,
      "id": "msg_t003r0101_scientist_01_06",
      "hash": "40fda48e679506b8",
      "flags": 0,
      "text": "Ma che monell[VAR GENDBR(00FF,0101)]oa che sei!\\nNon si può entrare dal retro!\\c\\nUff... vabbè. Piuttosto, sai che cos’è l’ambra?!"
    },
    {
      "index": 6,
      "id": "msg_t003r0101_scientist_01_07",
      "hash": "40fda58e6795086b",
      "flags": 0,
      "text": "C’è un laboratorio in cui stanno cercando di\\nriportare in vita dei Pokémon antichi utilizzando\\r\\nil materiale genetico contenuto nell’ambra."
    },
    {
      "index": 7,
      "id": "msg_t003r0101_scientist_01_08",
      "hash": "40fda28e67950352",
      "flags": 0,
      "text": "L’ambra è resina antichissima che si è fossilizzata\\ne indurita con il passare dei secoli."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_033_max",
      "hash": "39c45feef4e720a4"
    }
  ]
}
