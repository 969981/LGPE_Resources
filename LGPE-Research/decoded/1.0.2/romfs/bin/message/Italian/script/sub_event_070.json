  "lines": [
    {
      "index": 0,
      "id": "msg_sub070_pokemaniac_01",
      "hash": "8107bdd0a1e3bea9",
      "flags": 4,
      "text": "Oooooh! Ma... s-sbaglio o tu sei\\n[VAR GENDBR(00FF,0202)]illa Ca-Campione[VAR GENDBR(00FF,0300)]ssa?!\\c\\nÈ u-un vero onore parlare con te!\\nSo-Sono felicissimo!"
    },
    {
      "index": 1,
      "id": "msg_sub070_pokemaniac_02",
      "hash": "8107bad0a1e3b990",
      "flags": 4,
      "text": "I-Io mi specializzo i-in pietre rare! Ho delle\\nMegapietre che po-potrebbero interessarti...\\c\\nLe ho tro-trovate all’estero, ma se le vuoi\\nte le po-posso vendere a poco prezzo!"
    },
    {
      "index": 2,
      "id": "msg_sub070_select_01",
      "hash": "f24dce3d0034442f",
      "flags": 0,
      "text": "Beedrillite"
    },
    {
      "index": 3,
      "id": "msg_sub070_select_02",
      "hash": "f24dcf3d003445e2",
      "flags": 0,
      "text": "Pidgeotite"
    },
    {
      "index": 4,
      "id": "msg_sub070_select_03",
      "hash": "f24dd03d00344795",
      "flags": 4,
      "text": "Alakazamite"
    },
    {
      "index": 5,
      "id": "msg_sub070_select_04",
      "hash": "f24dc93d00343bb0",
      "flags": 8,
      "text": "Slowbroite"
    },
    {
      "index": 6,
      "id": "msg_sub070_select_05",
      "hash": "f24dca3d00343d63",
      "flags": 0,
      "text": "Gengarite"
    },
    {
      "index": 7,
      "id": "msg_sub070_select_06",
      "hash": "f24dcb3d00343f16",
      "flags": 0,
      "text": "Kangaskhanite"
    },
    {
      "index": 8,
      "id": "msg_sub070_select_07",
      "hash": "f24dcc3d003440c9",
      "flags": 0,
      "text": "Pinsirite"
    },
    {
      "index": 9,
      "id": "msg_sub070_select_08",
      "hash": "f24dd53d00345014",
      "flags": 0,
      "text": "Gyaradosite"
    },
    {
      "index": 10,
      "id": "msg_sub070_select_09",
      "hash": "f24dd63d003451c7",
      "flags": 4,
      "text": "Aerodactylite"
    },
    {
      "index": 11,
      "id": "msg_sub070_select_10",
      "hash": "f251533d00375c05",
      "flags": 4,
      "text": "Annulla"
    },
    {
      "index": 12,
      "id": "msg_sub070_pokemaniac_03",
      "hash": "8107bbd0a1e3bb43",
      "flags": 0,
      "text": "La Beedrillite, eh? Serve a far megaevolvere\\nBeedrill... Te la vendo per [VAR NUM5(0000,002E)] ₽!"
    },
    {
      "index": 13,
      "id": "msg_sub070_pokemaniac_04",
      "hash": "8107c0d0a1e3c3c2",
      "flags": 0,
      "text": "La Pidgeotite, eh? Serve a far megaevolvere\\nPidgeot... Te la vendo per [VAR NUM5(0000,002E)] ₽!"
    },
    {
      "index": 14,
      "id": "msg_sub070_pokemaniac_05",
      "hash": "8107c1d0a1e3c575",
      "flags": 0,
      "text": "L’Alakazamite, eh? Serve a far megaevolvere\\nAlakazam... Te la vendo per [VAR NUM5(0000,002E)] ₽!"
    },
    {
      "index": 15,
      "id": "msg_sub070_pokemaniac_06",
      "hash": "8107bed0a1e3c05c",
      "flags": 0,
      "text": "La Slowbroite, eh? Serve a far megaevolvere\\nSlowbro... Te la vendo per [VAR NUM5(0000,002E)] ₽!"
    },
    {
      "index": 16,
      "id": "msg_sub070_pokemaniac_07",
      "hash": "8107bfd0a1e3c20f",
      "flags": 0,
      "text": "La Gengarite, eh? Serve a far megaevolvere\\nGengar... Te la vendo per [VAR NUM5(0000,002E)] ₽!"
    },
    {
      "index": 17,
      "id": "msg_sub070_pokemaniac_08",
      "hash": "8107c4d0a1e3ca8e",
      "flags": 0,
      "text": "La Kangaskhanite, eh? Serve a far megaevolvere\\nKangaskhan... Te la vendo per [VAR NUM5(0000,002E)] ₽!"
    },
    {
      "index": 18,
      "id": "msg_sub070_pokemaniac_09",
      "hash": "8107c5d0a1e3cc41",
      "flags": 0,
      "text": "La Pinsirite, eh? Serve a far megaevolvere\\nPinsir... Te la vendo per [VAR NUM5(0000,002E)] ₽!"
    },
    {
      "index": 19,
      "id": "msg_sub070_pokemaniac_10",
      "hash": "810ac2d0a1e5fcff",
      "flags": 0,
      "text": "La Gyaradosite, eh? Serve a far megaevolvere\\nGyarados... Te la vendo per [VAR NUM5(0000,002E)] ₽!"
    },
    {
      "index": 20,
      "id": "msg_sub070_pokemaniac_11",
      "hash": "810ac1d0a1e5fb4c",
      "flags": 0,
      "text": "L’Aerodactylite, eh? Serve a far megaevolvere\\nAerodactyl... Te la vendo per [VAR NUM5(0000,002E)] ₽!"
    },
    {
      "index": 21,
      "id": "msg_sub070_select_11",
      "hash": "f251523d00375a52",
      "flags": 0,
      "text": "La compro!"
    },
    {
      "index": 22,
      "id": "msg_sub070_select_12",
      "hash": "f251513d0037589f",
      "flags": 0,
      "text": "Meglio di no..."
    },
    {
      "index": 23,
      "id": "msg_sub070_pokemaniac_12",
      "hash": "810ac4d0a1e60065",
      "flags": 0,
      "text": "G-Grazie per aver comprato u-una delle mie\\nMegapietre! Ne vu-vuoi un’altra?"
    },
    {
      "index": 24,
      "id": "msg_sub070_pokemaniac_13",
      "hash": "810ac3d0a1e5feb2",
      "flags": 0,
      "text": "To-Torna presto...!"
    },
    {
      "index": 25,
      "id": "msg_sub070_pokemaniac_14",
      "hash": "810abed0a1e5f633",
      "flags": 0,
      "text": "No-Non hai a-abbastanza soldi..."
    },
    {
      "index": 26,
      "id": "msg_sub070_pokemaniac_15",
      "hash": "810abdd0a1e5f480",
      "flags": 4,
      "text": "Hai comprato tu-tutte le mie Megapietre...!\\nMa è i-incredibile!\\c\\nSo che ne saprai fare buon uso...\\nSei [VAR GENDBR(00FF,0202)]illa Ca-Campione[VAR GENDBR(00FF,0300)]ssa, dopotutto!"
    },
    {
      "index": 27,
      "id": "msg_sub070_pokemaniac_16",
      "hash": "810ac0d0a1e5f999",
      "flags": 4,
      "text": "Ah, chi si rivede...! [VAR GENDBR(00FF,0202)]IlLa Ca-Campione[VAR GENDBR(00FF,0300)]ssa...!\\nTi sono state utili le m-mie Megapietre?"
    },
    {
      "index": 28,
      "id": "msg_sub070_select_13",
      "hash": "f251503d003756ec",
      "flags": 0,
      "text": "Negozio di Megapietre"
    }
  ],
