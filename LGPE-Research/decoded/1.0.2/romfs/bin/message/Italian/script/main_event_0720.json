    {
      "index": 22,
      "id": "msg_main0720_musashi_back",
      "hash": "e0a3affd79ba23d0",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Non possiamo lottare se hai solo\\nun Pokémon in squadra, però!\\c\\nVanne a prendere un altro e torna subito qui!"
