    },
    {
      "index": 1,
      "id": "msg_main0720_musashi_01",
      "hash": "716869af2e38670c",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Ehi, tu! Io ti conosco! Sei\\nquel[VAR GENDBR(00FF,0200)]la moccios[VAR GENDBR(00FF,0101)]oa del Monte Luna!"
    },
    {
      "index": 2,
      "id": "msg_main0720_musashi_04",
      "hash": "716866af2e3861f3",
      "flags": 0,
      "text": "Che sei venut[VAR GENDBR(00FF,0101)]oa a fare qui?"
    },
    {
      "index": 3,
      "id": "msg_main0720_select_01",
      "hash": "6d0c15488af76bc0",
      "flags": 0,
      "text": "Sono venut[VAR GENDBR(00FF,0101)]oa a salvare Cubone!"
    },
    {
      "index": 4,
      "id": "msg_main0720_select_02",
      "hash": "6d0c18488af770d9",
      "flags": 0,
      "text": "Voglio entrare nel Team Rocket!"
    },
    {
      "index": 5,
      "id": "msg_main0720_musashi_05",
      "hash": "716865af2e386040",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Che? Cubone?\\c\\nBah! Arrivi tardi, carin[VAR GENDBR(00FF,0101)]oa!\\nLo abbiamo già sbolognato al capo!"
    },
    {
      "index": 6,
      "id": "msg_main0720_musashi_06",
      "hash": "716868af2e386559",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Sul serio!? Con tutto il tuo potenziale\\nsaresti un bell’acquisto per il team!\\c\\nAh...! Guarda che non me la fai, moccios[VAR GENDBR(00FF,0101)]oa!"
    },
    {
      "index": 7,
      "id": "msg_main0720_musashi_07",
      "hash": "716867af2e3863a6",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Se credi di poter arrivare al nostro capo,\\nti sbagli di grosso!"
    },
    {
      "index": 8,
      "id": "msg_main0720_kojiro_01",
      "hash": "fea20c2f34fd4158",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] Ora la pagherai per averci rubato\\nquel fossile al Monte Luna, moccios[VAR GENDBR(00FF,0101)]oa!"
    },
    {
      "index": 9,
      "id": "msg_main0720_dummy_01",
      "hash": "c43546420b584cb0",
      "flags": 0,
      "text": "[~ 9]"
    },
    {
      "index": 10,
      "id": "msg_main0720_dummy_02",
      "hash": "c43549420b5851c9",
      "flags": 0,
      "text": "[~ 10]"
    },
    {
      "index": 11,
      "id": "msg_main0720_musashi_02",
      "hash": "71686caf2e386c25",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] Argh, che rabbia mi fai venire!\\c\\nTi dai tante arie solo perché i tuoi Pokémon\\nsono un pochiiino più forti della norma! Tsè!"
    },
    {
      "index": 12,
      "id": "msg_main0720_kojiro_02",
      "hash": "fea20f2f34fd4671",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James: [VAR COLOR(0000)]Esatto, ben detto!\\c\\nPiccol[VAR GENDBR(00FF,0101)]oa impertinente! Ti insegnerò io a metterti\\ncontro quelli più grandi di te!"
    },
    {
      "index": 13,
      "id": "msg_main0720_poke_01_01",
      "hash": "22d8a1ef446a6873",
      "flags": 0,
      "text": "Pikaaaa!"
    },
    {
      "index": 14,
      "id": "msg_main0720_poke_02_01",
      "hash": "f85aa9fa8dd325bc",
      "flags": 4,
      "text": "Eeveeveee!"
    },
    {
      "index": 15,
      "id": "msg_main0720_kojiro_03",
      "hash": "fea20e2f34fd44be",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James: [VAR COLOR(0000)]Iiiiiih!"
    },
    {
      "index": 16,
      "id": "msg_main0720_musashi_03",
      "hash": "71686baf2e386a72",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie e James:[VAR COLOR(0000)] Il Team Rocket riparte\\nalla velocità della luce!!"
    },
    {
      "index": 17,
      "id": "msg_main0720_poke_01_02",
