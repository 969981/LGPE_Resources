    },
    {
      "index": 4,
      "id": "msg_main0600_rock_01",
      "hash": "2bf9b58d7de5c4d2",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Brock:[VAR COLOR(0000)] Oh! Che sorpresa incontrarti qui!"
    },
    {
      "index": 5,
      "id": "msg_main0600_rock_02",
      "hash": "2bf9b48d7de5c31f",
      "flags": 4,
      "text": "Io sono appena tornato dalla Palestra\\ndi Azzurropoli.\\c\\nSai, mantenere buoni rapporti\\ntra Capipalestra è importantissimo!"
    },
    {
      "index": 6,
      "id": "msg_main0600_rock_03",
      "hash": "2bf9b38d7de5c16c",
      "flags": 0,
      "text": "Per qualche motivo, però, non mi hanno\\nfatto entrare..."
    },
    {
      "index": 7,
      "id": "msg_main0600_rock_04",
      "hash": "2bf9b28d7de5bfb9",
      "flags": 4,
      "text": "Avevo persino portato dei Plumbeosalatini\\ncome souvenir per la Capopalestra...\\c\\nBeh, tieni! Prendili tu, [VAR TRNAME(0000)]!"
    },
    {
      "index": 8,
      "id": "msg_main0600_sys_01",
      "hash": "b2b5b4f4538dbccc",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve dei Plumbeosalatini\\nda Brock!"
    },
    {
      "index": 9,
      "id": "msg_main0600_rock_05",
      "hash": "2bf9b18d7de5be06",
      "flags": 4,
      "text": "Ah, quasi dimenticavo! I Plumbeosalatini sono\\nmolto asciutti, quindi fanno venire sete...\\c\\nTieni, questo è per rinfrescarti la gola!"
    },
    {
      "index": 10,
      "id": "msg_main0600_sys_02",
      "hash": "b2b5b7f4538dc1e5",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] riceve del [VAR COLOR(0006)]Tè[VAR COLOR(0000)] da Brock!"
    },
    {
      "index": 11,
      "id": "msg_main0600_rock_07",
      "hash": "2bf9af8d7de5baa0",
      "flags": 4,
      "text": "Ops! Non ho più Tè da dare a quel\\nguardiano assetato..."
    },
    {
      "index": 12,
      "id": "msg_main0600_rock_06",
      "hash": "2bf9b08d7de5bc53",
      "flags": 0,
      "text": "Comunque... Vedo che stai facendo il giro\\ndelle Palestre di Kanto.\\c\\nBravissim[VAR GENDBR(00FF,0101)]oa! Faccio il tifo per te!"
    }
  ],
