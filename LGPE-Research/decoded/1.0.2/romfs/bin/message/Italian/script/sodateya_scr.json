    },
    {
      "index": 67,
      "id": "msg_sodateya_girl_16",
      "hash": "59d4c7704e5ea094",
      "flags": 0,
      "text": "[~ 67]"
    },
    {
      "index": 68,
      "id": "msg_sodateya_girl_17",
      "hash": "59d4c8704e5ea247",
      "flags": 0,
      "text": "[~ 68]"
    },
    {
      "index": 69,
      "id": "msg_sodateya_girl_18",
      "hash": "59d4bd704e5e8f96",
      "flags": 0,
      "text": "[~ 69]"
    },
    {
      "index": 70,
      "id": "msg_sodateya001",
      "hash": "81b5057d801b3fa2",
      "flags": 0,
      "text": "Sono la proprietaria della Pensione Pokémon.\\nCosa posso fare per te?"
    },
    {
      "index": 71,
      "id": "msg_sodateya002",
      "hash": "81b5047d801b3def",
      "flags": 0,
      "text": "Sono la proprietaria della Pensione Pokémon.\\c\\nAiuto gli Allenatori a rendere più forti i loro\\nPokémon. Cosa posso fare per te?"
    },
    {
      "index": 72,
      "id": "msg_sodateya003",
      "hash": "81b5037d801b3c3c",
      "flags": 0,
      "text": "Va bene. Torna a trovarmi!"
    },
    {
      "index": 73,
      "id": "msg_sodateya004",
      "hash": "81b5027d801b3a89",
      "flags": 0,
      "text": "Se mi affidi l’unico Pokémon che hai,\\ncome farai poi a lottare?\\c\\nTorna a trovarmi quando avrai catturato\\nqualche altro Pokémon!"
    },
    {
      "index": 74,
      "id": "msg_sodateya005",
      "hash": "81b5017d801b38d6",
      "flags": 0,
      "text": "Puoi affidarmi un Pokémon solo se ne hai\\nalmeno tre in totale, contando quelli in squadra\\r\\ne quelli nel Box Pokémon.\\c\\nTorna a trovarmi quando avrai catturato\\nqualche altro Pokémon!"
    },
    {
      "index": 75,
      "id": "msg_sodateya006",
      "hash": "81b5007d801b3723",
      "flags": 8,
      "text": "Scegli il Pokémon che vuoi affidarmi."
    },
    {
      "index": 76,
      "id": "msg_sodateya007",
      "hash": "81b4ff7d801b3570",
      "flags": 4,
      "text": "Oh, che tenerezza! Sembra che non voglia\\nsepararsi da te. Che bello vedervi così uniti..."
    },
    {
      "index": 77,
      "id": "msg_sodateya008",
      "hash": "81b50e7d801b4eed",
      "flags": 0,
      "text": "Bene! Allora mi occuperò di\\n[VAR PKNICK(0000)] per un po’."
    },
    {
      "index": 78,
      "id": "msg_sodateya009",
      "hash": "81b50d7d801b4d3a",
      "flags": 0,
      "text": "Torna a prenderlo tra un po’."
    },
    {
      "index": 79,
      "id": "msg_sodateya010",
      "hash": "81b1807d801827cc",
      "flags": 4,
      "text": "Il livello di [VAR PKNICK(0000)] è salito di [VAR NUM2(0001)]!"
    },
    {
      "index": 80,
      "id": "msg_sodateya011",
      "hash": "81b1817d8018297f",
      "flags": 0,
      "text": "Per ritirare [VAR PKNICK(0000)] devi pagare\\n[VAR NUM5(0001,002E)] ₽. Va bene?"
    },
    {
      "index": 81,
      "id": "msg_sodateya012",
      "hash": "81b1827d80182b32",
      "flags": 4,
      "text": "Oh... Sembra che tu non abbia abbastanza soldi."
    },
    {
      "index": 82,
      "id": "msg_sodateya013",
      "hash": "81b1837d80182ce5",
      "flags": 0,
      "text": "Ma guarda! Sembra che la tua squadra e\\nil Box Pokémon siano al completo.\\c\\nTorna quando avrai un po’ di spazio."
    },
    {
      "index": 83,
      "id": "msg_sodateya014",
      "hash": "81b17c7d80182100",
      "flags": 4,
      "text": "Ah! Guarda cos’ha trovato il tuo Pokémon..."
    },
    {
      "index": 84,
      "id": "msg_sodateya015",
      "hash": "81b17d7d801822b3",
      "flags": 0,
      "text": "Torna pure a trovarmi se hai bisogno\\ndi una mano con i tuoi Pokémon!"
    },
    {
      "index": 85,
      "id": "msg_sodateya016",
      "hash": "81b17e7d80182466",
      "flags": 0,
      "text": "Se mi affidi l’unico Pokémon che hai,\\ncome farai poi a lottare?"
    },
    {
      "index": 86,
      "id": "msg_tokkun001",
      "hash": "264f9dc66325087e",
      "flags": 0,
      "text": "Piacere! Sono Nonno Pro.\\nL’Allenamento Pro è la mia specialità!\\c\\nTorna a trovarmi quando sarai un[VAR GENDBR(00FF,0100)]a Campione[VAR GENDBR(00FF,0300)]ssa."
    },
    {
      "index": 87,
      "id": "msg_tokkun002",
      "hash": "264f9cc6632506cb",
      "flags": 4,
      "text": "Oh oh! Sei diventat[VAR GENDBR(00FF,0101)]oa un[VAR GENDBR(00FF,0100)]a Campione[VAR GENDBR(00FF,0300)]ssa!\\nCongratulazioni!\\c\\nIo sono Nonno Pro e posso rendere più forti i\\nPokémon di livello 100 con l’Allenamento Pro!\\c\\nPortami un Tappo d’argento e potenzierò\\nuna statistica del tuo Pokémon.\\c\\nSe mi porti un Tappo d’oro, invece,\\nle potenzierò tutte al massimo!"
    },
    {
      "index": 88,
      "id": "msg_tokkun003",
      "hash": "264f9bc663250518",
      "flags": 0,
      "text": "Sono Nonno Pro!\\nVuoi che alleni i tuoi Pokémon?"
    },
    {
      "index": 89,
      "id": "msg_tokkun004",
      "hash": "264fa2c6632510fd",
      "flags": 0,
      "text": "Mi dispiace... Niente Tappi, niente\\nAllenamento Pro!"
    },
    {
      "index": 90,
      "id": "msg_tokkun005",
      "hash": "264fa1c663250f4a",
      "flags": 0,
      "text": "Quale Pokémon vuoi sottoporre\\nall’Allenamento Pro?"
    },
    {
      "index": 91,
      "id": "msg_tokkun006",
      "hash": "264fa0c663250d97",
      "flags": 0,
      "text": "No, no... Quel Pokémon non ha raggiunto il\\nlivello giusto. Deve essere di livello 100..."
    },
    {
      "index": 92,
      "id": "msg_tokkun007",
      "hash": "264f9fc663250be4",
      "flags": 4,
      "text": "Allenare quel Pokémon così forte?\\nNon credo che ne abbia bisogno..."
    },
    {
      "index": 93,
      "id": "msg_tokkun008",
      "hash": "264f96c66324fc99",
      "flags": 0,
      "text": "Quale statistica vuoi sottoporre\\nall’Allenamento Pro?"
    },
    {
      "index": 94,
      "id": "msg_tokkun009",
      "hash": "264f95c66324fae6",
      "flags": 0,
      "text": "Potenziamo la statistica [VAR EVSTAT(0001)] di\\n[VAR PKNICK(0000)] con questo bel Tappo\\r\\nd’argento?"
    },
    {
      "index": 95,
      "id": "msg_tokkun010",
      "hash": "264c98c66322ca28",
      "flags": 0,
      "text": "Potenziamo tutte le statistiche\\ndi [VAR PKNICK(0000)] con questo bel Tappo d’oro?"
    },
    {
      "index": 96,
      "id": "msg_tokkun011",
      "hash": "264c99c66322cbdb",
      "flags": 0,
      "text": "Bene! Andiamo, [VAR PKNICK(0000)]!\\nÈ ora di fare un Allenamento Pro coi fiocchi!"
    },
    {
      "index": 97,
      "id": "msg_tokkun012",
      "hash": "264c9ac66322cd8e",
      "flags": 4,
      "text": "Uuuuooaaah! Vai! Così mi piaci! Tieni duro!\\nHop hop hop! Uno due! Uno due! Yaaah!"
    },
    {
      "index": 98,
      "id": "msg_tokkun013",
      "hash": "264c9bc66322cf41",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] adesso è più forte\\ngrazie all’allenamento del Nonno Pro!"
    },
    {
      "index": 99,
      "id": "msg_tokkun014",
      "hash": "264c9cc66322d0f4",
      "flags": 0,
      "text": "Vuoi allenare un altro Pokémon?"
    },
    {
      "index": 100,
      "id": "msg_tokkun015",
      "hash": "264c9dc66322d2a7",
      "flags": 0,
      "text": "Beh, per questa volta è tutto!\\nTorna a trovarmi quando vuoi."
    },
    {
      "index": 101,
      "id": "msg_tokkun016",
      "hash": "264c9ec66322d45a",
      "flags": 4,
      "text": "Ora ti spiego cos’è l’Allenamento Pro...\\nPront[VAR GENDBR(00FF,0101)]oa?\\c\\nQuando un Pokémon raggiunge il livello 100,\\npuò sfruttare l’Allenamento Pro per aumentare\\r\\nulteriormente le varie statistiche.\\c\\nPer allenare un Pokémon però dovrai portarmi\\ndei tappi speciali che colleziono.\\c\\nPortami un Tappo d’argento e potenzierò\\nuna statistica del tuo Pokémon.\\c\\nSe mi porti un Tappo d’oro, invece,\\nle potenzierò tutte al massimo!\\c\\nQuesto è quanto!"
    },
    {
      "index": 102,
      "id": "msg_sodateya_menu01",
      "hash": "eeb861ca2b4fbadc",
