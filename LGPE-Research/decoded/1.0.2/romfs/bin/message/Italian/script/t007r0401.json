    {
      "index": 1,
      "id": "msg_t007r0401_adultf_01",
      "hash": "884e545bfba5d96c",
      "flags": 0,
      "text": "Sono in vacanza con mio fratello e il mio ragazzo.\\c\\nAzzurropoli è proprio una bella città!"
    },
    {
      "index": 2,
      "id": "msg_t007r0401_adultm_01",
      "hash": "92639c9626c6a5fb",
      "flags": 0,
      "text": "Ma perché ha portato suo fratello...?"
    },
    {
      "index": 3,
      "id": "msg_t007r0401_childm_01",
      "hash": "a50ea319e5c2eafd",
      "flags": 0,
      "text": "Mia sorella mi ha portato in vacanza con lei!\\nEvviva!"
    }
  ],
