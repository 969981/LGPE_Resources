    {
      "index": 6,
      "id": "msg_main1220_young_f_05",
      "hash": "b718b6f58baabf19",
      "flags": 4,
      "text": "Ah, a proposito! Ho sentito che il Capopalestra\\ndi Smeraldopoli è tornato...\\c\\nForza, forza! Andate a Smeraldopoli!"
    },
    {
      "index": 7,
      "id": "msg_main1220_young_f_06",
      "hash": "b718b3f58baaba00",
      "flags": 0,
      "text": "Mi raccomando, non dire a [VAR TRNAME(0001)]\\nche stavo raccogliendo dei fiori...!"
    }
