    {
      "index": 5,
      "id": "msg_main1220_young_f_04",
      "hash": "b718b5f58baabd66",
      "flags": 4,
      "text": "Oh, [VAR TRNAME(0000)]! Mi raccomando...\\nChe questa cosa rimanga un segreto fra noi due!"
