    {
      "index": 4,
      "id": "msg_t011r0406_stafff_01_01",
      "hash": "5be33248487ab10c",
      "flags": 0,
      "text": "Vedi quest’uomo vicino a me?\\nÈ un mollaccione!"
    },
    {
      "index": 5,
      "id": "msg_t011r0406_stafff_01_02",
      "hash": "5be33548487ab625",
      "flags": 0,
      "text": "Vedi quest’uomo vicino a me? È così tenero\\nche...\\r\\nQuasi quasi me lo sposo!"
    },
    {
      "index": 6,
      "id": "msg_t011r0406_stafff_02_01",
      "hash": "84aeaa3cfda138c3",
      "flags": 4,
      "text": "Il Team Rocket cerca di conquistare il mondo\\ncon i Pokémon!"
