{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "cnt_select_win_01",
      "hash": "209514ec56c75baa",
      "flags": 0,
      "text": "Premi un pulsante del controller che vuoi usare."
    },
    {
      "index": 1,
      "id": "cnt_select_win_02",
      "hash": "209513ec56c759f7",
      "flags": 0,
      "text": "Vuoi usare questo controller?"
    },
    {
      "index": 2,
      "id": "cnt_select_win_03",
      "hash": "209512ec56c75844",
      "flags": 0,
      "text": "Le funzioni dei pulsanti sono state invertite."
    },
    {
      "index": 3,
      "id": "cnt_select_win_04",
      "hash": "209511ec56c75691",
      "flags": 0,
      "text": "Se non completi la procedura di inizializzazione\\nnon potrai utilizzare la tua Poké Ball Plus.\\r\\nVuoi interrompere la procedura?"
    },
    {
      "index": 4,
      "id": "cnt_select_win_05",
      "hash": "209510ec56c754de",
      "flags": 0,
      "text": "La procedura di inizializzazione\\nè stata completata."
    },
    {
      "index": 5,
      "id": "cnt_select_win_06",
      "hash": "20950fec56c7532b",
      "flags": 4,
      "text": "Inizializzazione in corso.\\nNon spegnere la console."
    },
    {
      "index": 6,
      "id": "cnt_select_win_07",
      "hash": "20950eec56c75178",
      "flags": 0,
      "text": "Si è verificato un errore.\\n\\nRiprendi la procedura da capo."
    },
    {
      "index": 7,
      "id": "cnt_select_win_08",
      "hash": "20950dec56c74fc5",
      "flags": 0,
      "text": "La Poké Ball Plus contiene un Pokémon\\nin regalo per te.\\n\\nScegli “Comunicazione” dal menu e poi\\nseleziona “Dono Segreto”."
    },
    {
      "index": 8,
      "id": "cnt_select_win_09",
      "hash": "20950cec56c74e12",
      "flags": 8,
      "text": "Scegli il controller per il secondo giocatore."
    },
    {
      "index": 9,
      "id": "cnt_select_win_10",
      "hash": "20918fec56c443d4",
      "flags": 0,
      "text": "Vuoi invertire la funzione dei pulsanti\\ndella Poké Ball Plus?"
    },
    {
      "index": 10,
      "id": "cnt_select_win_11",
      "hash": "209190ec56c44587",
      "flags": 8,
      "text": "Scegli il controller per il primo giocatore."
    },
    {
      "index": 11,
      "id": "cnt_select_win_12",
      "hash": "209191ec56c4473a",
      "flags": 0,
      "text": "Connessione in corso."
    },
    {
      "index": 12,
      "id": "cnt_select_info_01",
      "hash": "b671815c01514bc8",
      "flags": 0,
      "text": "Se stai giocando con la Poké Ball Plus,\\npremi il pulsante superiore per aprire il menu."
    },
    {
      "index": 13,
      "id": "cnt_select_info_02",
      "hash": "b671845c015150e1",
      "flags": 4,
      "text": "Una volta aperto il menu, scuoti due volte\\nla Poké Ball Plus per accedere alla schermata\\ndelle opzioni."
    },
    {
      "index": 14,
      "id": "cnt_select_info_03",
      "hash": "b671835c01514f2e",
      "flags": 0,
      "text": "Se stai giocando con il Joy-Con (R),\\npremi il pulsante X per aprire il menu."
    },
    {
      "index": 15,
      "id": "cnt_select_info_04",
      "hash": "b671865c01515447",
      "flags": 0,
      "text": "Se usi il Joy-Con (R), puoi confermare:\\n\\n・ premendo lo stick destro\\n・ con il pulsante R\\n・ con il pulsante ZR"
    },
    {
      "index": 16,
      "id": "cnt_select_info_05",
      "hash": "b671855c01515294",
      "flags": 0,
      "text": "Se stai giocando con il Joy-Con (L),\\npremi il pulsante Su per aprire il menu."
    },
    {
      "index": 17,
      "id": "cnt_select_info_06",
      "hash": "b671885c015157ad",
      "flags": 0,
      "text": "Se usi il Joy-Con (L), puoi confermare:\\n\\n・ premendo lo stick sinistro\\n・ con il pulsante L\\n・ con il pulsante ZL\\n"
    },
    {
      "index": 18,
      "id": "cnt_select_info_07",
      "hash": "b671875c015155fa",
      "flags": 0,
      "text": "Se stai giocando in modalità portatile,\\npremi il pulsante X per aprire il menu."
    },
    {
      "index": 19,
      "id": "cnt_select_info_08",
      "hash": "b6717a5c01513fe3",
      "flags": 0,
      "text": "Per confermare in modalità portatile\\npremi lo stick destro.\\n\\nIn alcune schermate puoi usare anche\\nil touch screen."
    },
    {
      "index": 20,
      "id": "cnt_select_sel_01",
      "hash": "b34042664de9fcd8",
      "flags": 4,
      "text": "Ok"
    },
    {
      "index": 21,
      "id": "cnt_select_sel_02",
      "hash": "b34045664dea01f1",
      "flags": 4,
      "text": "Info"
    },
    {
      "index": 22,
      "id": "cnt_select_sel_03",
      "hash": "b34044664dea003e",
      "flags": 4,
      "text": "Inverti i pulsanti"
    },
