  "lines": [
    {
      "index": 0,
      "id": "net_save_win_01",
      "hash": "eeefe4d96acc1c25",
      "flags": 0,
      "text": "Salvataggio in corso.\\nAttendi..."
    },
    {
      "index": 1,
      "id": "net_save_win_02",
      "hash": "eeefe1d96acc170c",
      "flags": 4,
      "text": "Attenzione!\\n\\nSe durante uno scambio la console si spegne\\no si verifica un errore di comunicazione,\\nper un po’ non potrai più fare scambi."
    },
    {
      "index": 2,
      "id": "net_save_win_03",
      "hash": "eeefe2d96acc18bf",
      "flags": 0,
      "text": "Comunicazione in corso.\\nAttendi..."
    },
    {
      "index": 3,
      "id": "net_save_win_04",
      "hash": "eeefdfd96acc13a6",
      "flags": 0,
      "text": "Vuoi interrompere la connessione?"
    },
    {
      "index": 4,
      "id": "net_save_sel_01",
      "hash": "0bb15cc36812039f",
      "flags": 0,
      "text": "Sì"
    },
    {
      "index": 5,
      "id": "net_save_sel_02",
      "hash": "0bb15dc368120552",
      "flags": 0,
      "text": "No"
    },
    {
      "index": 6,
      "id": "net_save_sel_03",
      "hash": "0bb15ec368120705",
      "flags": 4,
      "text": "Annulla"
    },
    {
      "index": 7,
      "id": "net_save_win_05",
      "hash": "eeefe0d96acc1559",
      "flags": 0,
      "text": "L’altro giocatore ha scelto di terminare\\nlo scambio. Lo scambio verrà annullato."
    }
  ],
