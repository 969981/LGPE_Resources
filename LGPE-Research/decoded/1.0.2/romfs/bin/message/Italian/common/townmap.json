      "flags": 0,
      "text": "← → Cambia Pokémon"
    },
    {
      "index": 6,
      "id": "TOWNMAP_05_01",
      "hash": "537c053b87998f1d",
      "flags": 0,
      "text": "Destinazione: [VAR LOCATION(0000)]\\nVuoi andarci con la Tecnica Segreta Solcanubi?"
    },
    {
      "index": 7,
      "id": "TOWNMAP_05_02",
      "hash": "537c023b87998a04",
      "flags": 0,
      "text": "Sì"
    },
    {
      "index": 8,
      "id": "TOWNMAP_05_03",
      "hash": "537c033b87998bb7",
      "flags": 0,
      "text": "No"
    },
    {
      "index": 9,
      "id": "TOWNMAP_10_01",
      "hash": "c7de207c7f324b27",
      "flags": 0,
      "text": "[VAR LOCATION(0000)]"
    },
    {
      "index": 10,
      "id": "TOWNMAP_20_01",
      "hash": "9e9ac914d7a1ec8a",
      "flags": 4,
      "text": "Habitat di [VAR POKNAME(0000)]"
    },
    {
      "index": 11,
      "id": "TOWNMAP_20_02",
      "hash": "9e9ac814d7a1ead7",
      "flags": 4,
      "text": "Habitat sconosciuto"
    },
    {
      "index": 12,
      "id": "TM_GUIDE_01",
      "hash": "de793f7747865099",
      "flags": 0,
      "text": "Tranquilla strada di campagna ricca\\ndi vegetazione."
    },
    {
      "index": 13,
      "id": "TM_GUIDE_02",
      "hash": "de793c7747864b80",
      "flags": 0,
      "text": "Percorso con numerosi dislivelli nei pressi\\ndel Bosco Smeraldo."
    },
    {
      "index": 14,
      "id": "TM_GUIDE_03",
      "hash": "de793d7747864d33",
      "flags": 0,
      "text": "Percorso erboso su cui si vedono, qua e là,\\ndei massi caduti dalle montagne vicine."
    },
    {
      "index": 15,
      "id": "TM_GUIDE_04",
      "hash": "de794277478655b2",
      "flags": 0,
      "text": "Percorso che conduce al Monte Luna.\\nDal lato di Celestopoli non si può risalire."
    },
    {
      "index": 16,
      "id": "TM_GUIDE_05",
      "hash": "de79437747865765",
      "flags": 0,
      "text": "Percorso in leggera pendenza con accesso\\nalla Via Sotterranea."
    },
    {
      "index": 17,
      "id": "TM_GUIDE_06",
      "hash": "de7940774786524c",
      "flags": 0,
      "text": "Percorso che collega Aranciopoli a\\nZafferanopoli con accesso alla Via Sotterranea."
    },
    {
      "index": 18,
      "id": "TM_GUIDE_07",
      "hash": "de794177478653ff",
      "flags": 0,
      "text": "Breve percorso collegato al Percorso 8\\ntramite la Via Sotterranea."
    },
    {
      "index": 19,
      "id": "TM_GUIDE_08",
      "hash": "de79467747865c7e",
      "flags": 0,
      "text": "Breve percorso collegato al Percorso 7\\ntramite la Via Sotterranea."
    },
    {
      "index": 20,
      "id": "TM_GUIDE_09",
      "hash": "de79477747865e31",
      "flags": 0,
      "text": "Percorso pieno di dislivelli in cui i bambini\\nvanno spesso a giocare."
    },
    {
      "index": 21,
      "id": "TM_GUIDE_10",
      "hash": "de7cc4774789686f",
      "flags": 0,
      "text": "Percorso che costeggia un canale e dà accesso\\nal Tunnel Roccioso."
    },
    {
      "index": 22,
      "id": "TM_GUIDE_11",
      "hash": "de7cc377478966bc",
      "flags": 0,
      "text": "Percorso erboso gremito di Allenatori che dà\\naccesso alla Grotta Diglett."
    },
    {
      "index": 23,
      "id": "TM_GUIDE_12",
      "hash": "de7cc67747896bd5",
      "flags": 0,
      "text": "Complesso di pontili conosciuto anche come\\n“Ponte Silenzio”. Molto popolare fra i Pescatori."
    },
    {
      "index": 24,
      "id": "TM_GUIDE_13",
      "hash": "de7cc57747896a22",
      "flags": 4,
      "text": "Un complicato labirinto costruito lungo\\nun piacevole percorso costeggiato dal mare."
    },
    {
      "index": 25,
      "id": "TM_GUIDE_14",
      "hash": "de7cc077478961a3",
      "flags": 0,
      "text": "Largo percorso costiero ornato da siepi\\ne accarezzato da una piacevole brezza marina."
    },
    {
      "index": 26,
      "id": "TM_GUIDE_15",
      "hash": "de7cbf7747895ff0",
      "flags": 0,
      "text": "Lungo rettilineo erboso che si estende a est\\ndi Fucsiapoli."
    },
    {
      "index": 27,
      "id": "TM_GUIDE_16",
      "hash": "de7cc27747896509",
      "flags": 0,
      "text": "Percorso dall’atmosfera vivace a nord\\ndella Passeggiata Pokémon."
    },
    {
      "index": 28,
      "id": "TM_GUIDE_17",
      "hash": "de7cc17747896356",
      "flags": 0,
      "text": "Viale noto come “Passeggiata Pokémon” in cui\\nPokémon e Allenatori vanno a spasso insieme."
    },
    {
      "index": 29,
      "id": "TM_GUIDE_18",
      "hash": "de7ccc7747897607",
      "flags": 0,
      "text": "Percorso a sud della Passeggiata Pokémon\\ndove alcuni Allenatori si ritrovano per lottare."
    },
    {
      "index": 30,
      "id": "TM_GUIDE_19",
      "hash": "de7ccb7747897454",
      "flags": 0,
      "text": "Luogo ideale per nuotare o per prendere\\nil sole sulla spiaggia."
    },
    {
      "index": 31,
      "id": "TM_GUIDE_20",
      "hash": "de72d27747812bb4",
      "flags": 0,
      "text": "Lungo tratto di mare diviso in due\\ndalle Isole Spumarine."
    },
    {
      "index": 32,
      "id": "TM_GUIDE_21",
      "hash": "de72d37747812d67",
      "flags": 0,
      "text": "La presenza di un vulcano rende l’acqua\\ndi questo tratto di mare relativamente calda."
    },
    {
      "index": 33,
      "id": "TM_GUIDE_22",
      "hash": "de72d47747812f1a",
      "flags": 0,
      "text": "Rettilineo lastricato che porta alla Lega\\nPokémon."
    },
    {
      "index": 34,
      "id": "TM_GUIDE_23",
      "hash": "de72d577478130cd",
      "flags": 0,
      "text": "Percorso di montagna il cui accesso è consentito\\nsolo agli Allenatori più forti."
    },
    {
      "index": 35,
      "id": "TM_GUIDE_24",
      "hash": "de72ce77478124e8",
      "flags": 0,
      "text": "Percorso a nord di Celestopoli famoso\\nper il suo scintillante ponte d’oro."
    },
    {
      "index": 36,
      "id": "TM_GUIDE_25",
      "hash": "de72cf774781269b",
      "flags": 0,
      "text": "Labirinto di siepi che conduce a un promontorio."
    },
    {
      "index": 37,
      "id": "TM_GUIDE_26",
      "hash": "de72d0774781284e",
      "flags": 0,
      "text": "Piccola città di campagna che ospita\\nil Laboratorio Pokémon."
    },
    {
      "index": 38,
      "id": "TM_GUIDE_27",
      "hash": "de72d17747812a01",
      "flags": 0,
      "text": "Città immersa nella natura in cui i fiori\\nsbocciano tutto l’anno"
    },
    {
      "index": 39,
      "id": "TM_GUIDE_28",
      "hash": "de72ca7747811e1c",
      "flags": 0,
      "text": "Città con edifici costruiti in pietra che si\\nestende ai piedi di una montagna rocciosa."
    },
    {
      "index": 40,
      "id": "TM_GUIDE_29",
      "hash": "de72cb7747811fcf",
      "flags": 0,
      "text": "Città circondata dall’acqua. È ricca di risorse\\nidriche e ospita la Palestra di tipo Acqua."
    },
    {
      "index": 41,
      "id": "TM_GUIDE_30",
      "hash": "de75d87747836bbd",
      "flags": 0,
      "text": "Città dall’atmosfera tranquilla e solenne\\nche ospita le tombe dei Pokémon."
    },
    {
      "index": 42,
      "id": "TM_GUIDE_31",
      "hash": "de75d77747836a0a",
      "flags": 0,
      "text": "Città portuale in cui fanno scalo lussuose navi\\npasseggeri provenienti da tutto il mondo."
    },
    {
      "index": 43,
      "id": "TM_GUIDE_32",
      "hash": "de75d67747836857",
      "flags": 0,
      "text": "Città abitata da persone di tutte le età,\\nfamosa per il suo centro commerciale."
    },
    {
      "index": 44,
      "id": "TM_GUIDE_33",
      "hash": "de75d577478366a4",
      "flags": 0,
      "text": "Città in cui si raduna un gran numero di persone\\ne di Pokémon attirati dalla Zona Safari."
    },
    {
      "index": 45,
      "id": "TM_GUIDE_34",
      "hash": "de75d477478364f1",
      "flags": 0,
      "text": "Città sorta su un’isola vulcanica in cui si trova\\nuna villa in rovina."
    },
    {
      "index": 46,
      "id": "TM_GUIDE_35",
      "hash": "de75d3774783633e",
      "flags": 4,
      "text": "Altopiano in cui si erge la sede dell’autorevole\\nLega Pokémon."
    },
    {
      "index": 47,
      "id": "TM_GUIDE_36",
      "hash": "de75d2774783618b",
      "flags": 0,
      "text": "File di grattacieli svettano in questa città,\\nche è la più grande di Kanto."
    },
    {
      "index": 48,
      "id": "TM_GUIDE_37",
      "hash": "de75d17747835fd8",
      "flags": 0,
      "text": "Bosco molto grande e fitto che pullula\\ndi Pokémon di tipo Coleottero."
    },
    {
      "index": 49,
      "id": "TM_GUIDE_38",
      "hash": "de75d07747835e25",
      "flags": 0,
      "text": "Montagna su cui sono caduti molti meteoriti.\\nVi si possono trovare dei fossili."
    },
    {
      "index": 50,
      "id": "TM_GUIDE_39",
      "hash": "de75cf7747835c72",
      "flags": 0,
      "text": "Grande tunnel naturale in cui regna l’oscurità.\\nPer attraversarlo è necessaria una fonte di luce."
    },
    {
      "index": 51,
      "id": "TM_GUIDE_40",
      "hash": "de6bc677477af8a2",
      "flags": 8,
      "text": "Struttura piena di macchinari abitata\\nda Pokémon di tipo Elettro."
    },
    {
      "index": 52,
      "id": "TM_GUIDE_41",
      "hash": "de6bc777477afa55",
      "flags": 0,
      "text": "Tunnel scavato dai Diglett che collega\\nPlumbeopoli ad Aranciopoli."
    },
    {
      "index": 53,
      "id": "TM_GUIDE_42",
      "hash": "de6bc477477af53c",
      "flags": 0,
      "text": "Due piccole isole gemelle straordinariamente\\nfredde al loro interno."
    },
    {
      "index": 54,
      "id": "TM_GUIDE_43",
      "hash": "de6bc577477af6ef",
      "flags": 4,
      "text": "Impervia grotta in cui si radunano gli Allenatori\\nche puntano alla Lega Pokémon."
    },
    {
