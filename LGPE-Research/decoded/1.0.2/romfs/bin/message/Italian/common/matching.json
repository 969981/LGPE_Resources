{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "matching_win_01",
      "hash": "0244fd0f825809cb",
      "flags": 4,
      "text": "Il collegamento verrà avviato.\\nScegli con chi vuoi giocare."
    },
    {
      "index": 1,
      "id": "matching_win_02",
      "hash": "0244fe0f82580b7e",
      "flags": 0,
      "text": "Cosa vuoi fare?"
    },
    {
      "index": 2,
      "id": "matching_win_03",
      "hash": "0244ff0f82580d31",
      "flags": 8,
      "text": "Scegli lo stesso codice della persona con cui\\nvuoi connetterti."
    },
    {
      "index": 3,
      "id": "matching_win_04",
      "hash": "0245000f82580ee4",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "matching_win_05",
      "hash": "0245010f82581097",
      "flags": 8,
      "text": "Scegli una combinazione di tre Pokémon, che\\ndiventerà il tuo codice. Ti potrai così connettere\\r\\ncon un giocatore che ha lo stesso codice."
    },
    {
      "index": 5,
      "id": "matching_win_06",
      "hash": "0245020f8258124a",
      "flags": 0,
      "text": "Ricerca di un giocatore per la Lotta in Singolo\\nin corso."
    },
    {
      "index": 6,
      "id": "matching_win_07",
      "hash": "0245030f825813fd",
      "flags": 0,
      "text": "Ricerca di un giocatore per la Lotta in Doppio\\nin corso."
    },
    {
      "index": 7,
      "id": "matching_win_08",
      "hash": "0244f40f8257fa80",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "matching_win_09",
      "hash": "0244f50f8257fc33",
      "flags": 0,
      "text": "Ricerca di un giocatore con cui effettuare\\nuno scambio in corso."
    },
    {
      "index": 9,
      "id": "matching_win_10",
      "hash": "0248820f825b21a1",
      "flags": 4,
      "text": "È stato trovato un giocatore.\\nAttendi..."
    },
    {
      "index": 10,
      "id": "matching_win_11",
      "hash": "0248810f825b1fee",
      "flags": 0,
      "text": "Durante l’ultimo scambio in link si è verificato\\nun errore di comunicazione o la console si è\\nspenta. Per questo motivo, al momento non è\\npossibile effettuare scambi in link.\\n\\n[VAR COLOR(0002)]Riprova più tardi.[VAR COLOR(0000)]"
    },
    {
      "index": 11,
      "id": "matching_win_12",
      "hash": "0248800f825b1e3b",
      "flags": 0,
      "text": "Per poter fare uno scambio devi avere almeno\\ndue Pokémon.\\n\\nNon puoi scambiare il tuo compagno\\nd’avventura o un Pokémon che hai fatto\\nuscire dalla Poké Ball.\\n\\nRiprova quando avrai più Pokémon."
    },
    {
      "index": 12,
      "id": "matching_win_13",
      "hash": "02487f0f825b1c88",
      "flags": 4,
      "text": "Hai un solo Pokémon in squadra o nel Box.\\nImpossibile partecipare a una Lotta in Doppio.\\n\\nRiprova quando avrai più Pokémon."
    },
    {
      "index": 13,
      "id": "matching_win_14",
      "hash": "0248860f825b286d",
      "flags": 0,
      "text": "Verrà stabilito il collegamento a Internet.\\nIl gioco verrà salvato. Vuoi continuare?"
    },
    {
      "index": 14,
      "id": "matching_win_15",
      "hash": "0248850f825b26ba",
      "flags": 0,
      "text": "Collegamento a Internet riuscito."
    },
    {
      "index": 15,
      "id": "matching_win_16",
      "hash": "0248840f825b2507",
      "flags": 0,
      "text": "Salvataggio in corso.\\nAttendi..."
    },
    {
      "index": 16,
      "id": "matching_win_17",
      "hash": "0248830f825b2354",
      "flags": 0,
      "text": "Connessione in corso.\\nAttendi..."
    },
    {
      "index": 17,
      "id": "matching_cap_01",
      "hash": "b85892b9113f52d9",
      "flags": 0,
      "text": "Giocatori vicini"
    },
    {
      "index": 18,
      "id": "matching_cap_02",
      "hash": "b8588fb9113f4dc0",
      "flags": 0,
      "text": "Giocatori lontani"
    },
    {
      "index": 19,
      "id": "matching_cap_03",
      "hash": "b85890b9113f4f73",
      "flags": 0,
      "text": "Tramite comunicazione locale"
    },
    {
      "index": 20,
      "id": "matching_cap_04",
      "hash": "b85895b9113f57f2",
      "flags": 0,
      "text": "Tramite Internet"
    },
    {
      "index": 21,
      "id": "matching_cap_05",
      "hash": "b85896b9113f59a5",
      "flags": 8,
      "text": "Scambio in link"
    },
    {
      "index": 22,
      "id": "matching_cap_06",
      "hash": "b85893b9113f548c",
      "flags": 0,
      "text": "Lotta in Singolo"
    },
    {
      "index": 23,
      "id": "matching_cap_07",
      "hash": "b85894b9113f563f",
      "flags": 0,
      "text": "Lotta in Doppio"
