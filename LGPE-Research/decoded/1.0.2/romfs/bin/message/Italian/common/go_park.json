    },
    {
      "index": 86,
      "id": "go_park_60_10",
      "hash": "24879ff5675761f9",
      "flags": 0,
      "text": "Cattura"
    },
    {
      "index": 87,
      "id": "go_park_60_11",
      "hash": "24879ef567576046",
      "flags": 8,
      "text": "Sposta"
    },
    {
      "index": 88,
      "id": "go_park_70_01",
      "hash": "b46a7ac07b9d68a0",
      "flags": 0,
      "text": "[VAR NUM2(0000)]:[VAR NUM2(0001)].[VAR NUM2(0002)]"
    },
    {
      "index": 89,
      "id": "go_park_80_01",
      "hash": "82fa3762ec0872bd",
      "flags": 0,
      "text": "Se catturi un Pokémon in un GO Park, i suoi dati\\noriginali di Pokémon GO verranno modificati.\\nVuoi continuare?"
    },
    {
      "index": 90,
      "id": "go_park_90_01",
      "hash": "950ad72a53682d1a",
      "flags": 0,
      "text": " [VAR NUM3(0000)]"
    },
    {
      "index": 91,
      "id": "go_park_100_01",
      "hash": "3b2093cb115b62e2",
      "flags": 0,
      "text": "Guida i Pokémon fino al traguardo!\\nX: Menu Y: Zoom"
    }
