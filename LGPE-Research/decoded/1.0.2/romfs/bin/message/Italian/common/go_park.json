  "lines": [
    {
      "index": 0,
      "id": "go_park_00_01",
      "hash": "7fbbaaedc1e6df95",
      "flags": 0,
      "text": "Benvenut[VAR GENDBR(00FF,0101)]oa al GO Park!"
    },
    {
      "index": 1,
      "id": "go_park_00_02",
      "hash": "7fbba7edc1e6da7c",
      "flags": 8,
      "text": "Scegli un argomento."
    },
    {
      "index": 2,
      "id": "go_park_00_03",
      "hash": "7fbba8edc1e6dc2f",
      "flags": 0,
      "text": "Cosa vuoi fare?"
    },
    {
      "index": 3,
      "id": "go_park_00_10",
      "hash": "7fbf2fedc1e9f76b",
      "flags": 0,
      "text": "Trasferisci Pokémon"
    },
    {
      "index": 4,
      "id": "go_park_00_11",
      "hash": "7fbf2eedc1e9f5b8",
      "flags": 0,
      "text": "Visita un GO Park"
    },
    {
      "index": 5,
      "id": "go_park_00_12",
      "hash": "7fbf31edc1e9fad1",
      "flags": 0,
      "text": "Vai all’Area Svago"
    },
    {
      "index": 6,
      "id": "go_park_00_13",
      "hash": "7fbf30edc1e9f91e",
      "flags": 0,
      "text": "Chiedi informazioni"
    },
    {
      "index": 7,
      "id": "go_park_00_14",
      "hash": "7fbf33edc1e9fe37",
      "flags": 4,
      "text": "Esci"
    },
    {
      "index": 8,
      "id": "go_park_00_15",
      "hash": "7fbf32edc1e9fc84",
      "flags": 0,
      "text": "Trasferire i Pokémon"
    },
    {
      "index": 9,
      "id": "go_park_00_16",
      "hash": "7fbf35edc1ea019d",
      "flags": 0,
      "text": "GO Park"
    },
    {
      "index": 10,
      "id": "go_park_00_17",
      "hash": "7fbf34edc1e9ffea",
      "flags": 4,
      "text": "Area Svago"
    },
    {
      "index": 11,
      "id": "go_park_00_20",
      "hash": "7fb51dedc1e18450",
      "flags": 4,
      "text": "I Pokémon ottenuti in Pokémon GO possono\\nessere trasferiti in un GO Park.\\c\\nPer prima cosa, vai alla schermata delle opzioni\\ne seleziona “Collegamento a Pokémon GO” per\\r\\nassociare il gioco a un account di Pokémon GO.\\c\\nPoi vai su Pokémon GO e scegli i Pokémon\\nche vuoi trasferire.\\c\\nUna volta trasferiti in un GO Park, i Pokémon\\nnon possono più essere riportati in Pokémon GO."
    },
    {
      "index": 12,
      "id": "go_park_00_21",
      "hash": "7fb51eedc1e18603",
      "flags": 0,
      "text": "Troverai i Pokémon trasferiti da Pokémon GO\\nche giocano in un GO Park.\\c\\nParla con un Pokémon per catturarlo\\no trasferirlo in un altro GO Park.\\c\\nUna volta catturato, un Pokémon non\\npuò più tornare nei GO Park.\\c\\nSe vuoi uscire da un GO park, premi\\nil pulsante X."
    },
    {
      "index": 13,
      "id": "go_park_00_22",
      "hash": "7fb51fedc1e187b6",
      "flags": 0,
      "text": "Se hai 25 Pokémon della stessa specie\\nnei GO Park puoi giocare nell’Area Svago.\\c\\nPer vincere, devi guidare tutti i Pokémon\\nfino al traguardo entro il limite di tempo!\\c\\nMa fai attenzione ai Pokémon che sbucano\\ndal terreno per ostacolarti!\\c\\nPer smettere di giocare, premi il pulsante X."
    },
    {
      "index": 14,
      "id": "go_park_01_01",
      "hash": "d5055ee3b2da9820",
      "flags": 0,
      "text": "GO Park 1"
    },
