      "hash": "0cf80ee3f10e4692",
      "flags": 4,
      "text": "Esci"
    },
    {
      "index": 38,
      "id": "go_park_10_02",
      "hash": "0cf80de3f10e44df",
      "flags": 0,
      "text": "Cambia nome"
    },
    {
      "index": 39,
      "id": "go_park_10_03",
      "hash": "0cf80ce3f10e432c",
      "flags": 4,
      "text": "Info"
    },
    {
      "index": 40,
      "id": "go_park_20_01",
      "hash": "8b27a758d40dea4f",
      "flags": 8,
      "text": "Scegli un GO Park."
    },
    {
      "index": 41,
      "id": "go_park_20_02",
      "hash": "8b27a858d40dec02",
      "flags": 0,
      "text": "Dove vuoi andare?"
    },
    {
      "index": 42,
      "id": "go_park_20_03",
      "hash": "8b27a958d40dedb5",
      "flags": 0,
      "text": "Dove si trovano i Pokémon con cui vuoi giocare?"
    },
    {
      "index": 43,
      "id": "go_park_20_04",
      "hash": "8b27a258d40de1d0",
      "flags": 8,
      "text": "Scegli il Pokémon con cui vuoi giocare."
    },
    {
      "index": 44,
      "id": "go_park_20_05",
      "hash": "8b27a358d40de383",
      "flags": 0,
      "text": "Si trova in: [VAR COLOR(0006)][VAR GOPARKLOCAL(0000)][VAR COLOR(0000)]"
    },
    {
      "index": 45,
      "id": "go_park_20_06",
      "hash": "8b27a458d40de536",
      "flags": 0,
      "text": "Cosa vuoi fare con [VAR GOPARKPKM(0000)]?"
    },
    {
      "index": 46,
      "id": "go_park_25_01",
      "hash": "8f31e36fa702e296",
      "flags": 0,
      "text": "Pokémon in: [VAR GOPARKLOCAL(0000)]"
    },
    {
      "index": 47,
      "id": "go_park_25_02",
      "hash": "8f31e26fa702e0e3",
      "flags": 0,
      "text": "← → Cambia GO Park"
    },
    {
      "index": 48,
      "id": "go_park_30_01",
      "hash": "1aa10723e7fa36ec",
      "flags": 0,
      "text": "L’hai spostato in:\\n[VAR GOPARKLOCAL(0000)]!"
    },
    {
      "index": 49,
      "id": "go_park_40_01",
      "hash": "6e71df9790fa2fe9",
      "flags": 0,
      "text": "Vuoi provare di nuovo?"
    },
    {
      "index": 50,
      "id": "go_park_40_02",
      "hash": "6e71dc9790fa2ad0",
      "flags": 0,
      "text": "Sì"
    },
    {
      "index": 51,
      "id": "go_park_40_03",
      "hash": "6e71dd9790fa2c83",
      "flags": 0,
      "text": "No"
    },
    {
      "index": 52,
      "id": "go_park_41_01",
      "hash": "16c5b38ff47b0654",
      "flags": 4,
      "text": "Hai sospeso il gioco.\\nCosa vuoi fare?"
    },
    {
      "index": 53,
      "id": "go_park_41_02",
      "hash": "16c5b68ff47b0b6d",
      "flags": 0,
      "text": "Continua a giocare"
    },
    {
      "index": 54,
      "id": "go_park_41_03",
      "hash": "16c5b58ff47b09ba",
      "flags": 0,
      "text": "Ricomincia da capo"
    },
    {
      "index": 55,
      "id": "go_park_41_04",
      "hash": "16c5b08ff47b013b",
      "flags": 4,
      "text": "Esci dall’Area Svago"
    },
    {
      "index": 56,
      "id": "go_park_45_01",
      "hash": "3ccc6b6dd7c07818",
      "flags": 0,
      "text": "Non hai abbastanza Pokémon della specie\\nselezionata.\\nDevono essercene almeno 25 nei GO Park."
    },
    {
      "index": 57,
      "id": "go_park_45_02",
      "hash": "3ccc6e6dd7c07d31",
      "flags": 0,
      "text": "Per giocare nell’Area Svago\\ndevono esserci almeno 25 Pokémon\\ndella stessa specie nei GO Park."
    },
    {
      "index": 58,
      "id": "go_park_48_01",
      "hash": "0e636f55cacbd511",
      "flags": 0,
      "text": "Tempo"
    },
    {
      "index": 59,
      "id": "go_park_48_02",
      "hash": "0e636c55cacbcff8",
      "flags": 0,
      "text": "Numero di arrivi simultanei"
    },
    {
      "index": 60,
      "id": "go_park_48_03",
      "hash": "0e636d55cacbd1ab",
      "flags": 0,
      "text": "[~ 60]"
    },
    {
      "index": 61,
      "id": "go_park_48_04",
      "hash": "0e637255cacbda2a",
      "flags": 0,
      "text": "Punteggio"
    },
    {
      "index": 62,
      "id": "go_park_49_01",
      "hash": "372e634a7ff17c7c",
      "flags": 0,
      "text": "[VAR NUM2(0000)]"
    },
    {
      "index": 63,
      "id": "go_park_50_02",
      "hash": "fb41428dbfc4c353",
      "flags": 0,
      "text": "[VAR NUM4(0000,002E)]"
    },
    {
      "index": 64,
      "id": "go_park_50_03",
      "hash": "fb41418dbfc4c1a0",
      "flags": 0,
      "text": "Record di [VAR POKNAME(0000)]"
    },
    {
      "index": 65,
      "id": "go_park_55_01",
      "hash": "a279077478cf9dbf",
      "flags": 0,
      "text": "Cosa vuoi fare?\\n[VAR COLOR(0006)]Y: regola zoom[VAR COLOR(0000)]"
    },
    {
      "index": 66,
      "id": "go_park_55_02",
      "hash": "a279087478cf9f72",
      "flags": 0,
      "text": "Salva"
    },
    {
      "index": 67,
      "id": "go_park_55_03",
      "hash": "a279097478cfa125",
      "flags": 0,
      "text": "Torna all’ingresso"
    },
    {
      "index": 68,
      "id": "go_park_55_05",
      "hash": "a279037478cf96f3",
      "flags": 4,
      "text": "Info"
    },
    {
      "index": 69,
      "id": "go_park_55_04",
      "hash": "a279027478cf9540",
      "flags": 0,
      "text": "Niente"
    },
    {
      "index": 70,
      "id": "go_park_55_06",
      "hash": "a279047478cf98a6",
      "flags": 4,
      "text": "Hai ricevuto [VAR NUM3(0001)] [VAR ITEMBAG(0000)]\\nin regalo!"
    },
    {
      "index": 71,
      "id": "go_park_55_07",
      "hash": "a279057478cf9a59",
      "flags": 4,
      "text": "Hai messo la ricompensa\\n[VAR VARITA07(0001)][VAR COLOR(0006)][VAR BAG(0001)][VAR COLOR(0000)]!"
    },
    {
      "index": 72,
      "id": "go_park_55_10",
      "hash": "a27c8c7478d2b595",
      "flags": 0,
      "text": "Vuoi salvare il gioco?"
    },
    {
      "index": 73,
      "id": "go_park_55_11",
      "hash": "a27c8b7478d2b3e2",
      "flags": 0,
      "text": "Salvataggio in corso. Non spegnere la console."
    },
    {
      "index": 74,
      "id": "go_park_55_12",
      "hash": "a27c8a7478d2b22f",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] ha salvato il gioco."
    },
    {
      "index": 75,
      "id": "go_park_55_13",
      "hash": "a27c897478d2b07c",
      "flags": 4,
      "text": "Il salvataggio non è riuscito."
    },
