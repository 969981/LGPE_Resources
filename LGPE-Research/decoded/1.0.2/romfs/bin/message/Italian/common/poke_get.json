    },
    {
      "index": 52,
      "id": "poke_get_40_01",
      "hash": "f3d3d054a2eb0b0a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Prof. Oak:[VAR COLOR(0000)] Che strano...\\nCosa ci fa un [VAR POKNAME(0000)] da queste parti?\\c\\nBeh, capita proprio a proposito. Un’occasione\\nperfetta per imparare a [VAR COLOR(0006)]catturare Pokémon[VAR COLOR(0000)]!\\c\\nForza! Per catturarlo ti basta lanciargli contro\\nuna [VAR COLOR(0006)]Poké Ball[VAR COLOR(0000)]!"
    },
    {
      "index": 53,
      "id": "poke_get_40_02",
      "hash": "f3d3cf54a2eb0957",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Prof. Oak:[VAR COLOR(0000)] Non è facile come sembra, eh?\\nTieni, ti do delle altre Poké Ball. Prova di nuovo!"
    },
    {
      "index": 54,
      "id": "poke_get_50_01",
      "hash": "67046c5e742075ed",
      "flags": 0,
      "text": "Punta il Joy-Con verso lo schermo."
    },
    {
      "index": 55,
      "id": "poke_get_50_02",
      "hash": "6704695e742070d4",
      "flags": 0,
      "text": "Premi il pulsante A per afferrare la Poké Ball."
    },
    {
      "index": 56,
      "id": "poke_get_50_03",
      "hash": "67046a5e74207287",
      "flags": 8,
      "text": "Scuoti una volta il Joy-Con per lanciare\\nla Poké Ball."
    },
    {
      "index": 57,
      "id": "poke_get_50_04",
      "hash": "6704675e74206d6e",
      "flags": 0,
      "text": "Cerca di mirare all’interno del cerchio."
    },
    {
      "index": 58,
      "id": "poke_get_50_05",
      "hash": "6704685e74206f21",
      "flags": 0,
      "text": "Fai attenzione all’ambiente circostante\\ne non fare movimenti eccessivi!"
    },
    {
      "index": 59,
      "id": "poke_get_60_01",
      "hash": "d78b089360342284",
      "flags": 0,
      "text": "Tieni la console tra le mani e premi A\\nper afferrare la Poké Ball."
    },
    {
      "index": 60,
      "id": "poke_get_60_02",
      "hash": "d78b0b936034279d",
      "flags": 4,
      "text": "Una volta impugnata la Poké Ball, muovi\\nla console per guardarti intorno."
    },
    {
      "index": 61,
      "id": "poke_get_60_03",
      "hash": "d78b0a93603425ea",
      "flags": 0,
      "text": "Premi A per lanciare la Poké Ball\\nverso il centro dello schermo."
    },
    {
      "index": 62,
      "id": "poke_get_60_04",
      "hash": "d78b059360341d6b",
      "flags": 0,
      "text": "Cerca di mirare all’interno del cerchio."
    },
    {
      "index": 63,
      "id": "poke_get_60_05",
      "hash": "d78b049360341bb8",
      "flags": 0,
      "text": "Se hai difficoltà a inquadrare il bersaglio,\\npremi B per ripristinare la visuale iniziale."
    },
    {
      "index": 64,
      "id": "poke_get_70_01",
      "hash": "1d1727bc4a7b69a7",
      "flags": 4,
      "text": "Hai cambiato modalità di comando.\\nIniziamo da capo!"
    },
    {
      "index": 65,
      "id": "poke_get_80_01",
      "hash": "b4ecb8880ddd1d76",
      "flags": 4,
      "text": "Hai cambiato modalità di comando.\\nVuoi vedere la spiegazione su come funziona?"
    },
    {
      "index": 66,
      "id": "poke_get_80_02",
      "hash": "b4ecb7880ddd1bc3",
      "flags": 0,
      "text": "Vuoi vedere la spiegazione su come lanciare\\nuna Poké Ball?"
    },
    {
      "index": 67,
      "id": "poke_get_80_03",
      "hash": "b4ecb6880ddd1a10",
      "flags": 8,
      "text": "Scegli una bacca dalla Borsa per utilizzarla!"
    },
    {
      "index": 68,
      "id": "poke_get_80_04",
      "hash": "b4ecbd880ddd25f5",
      "flags": 0,
      "text": "Lancia la Poké Ball all’interno del cerchio\\ncolorato per ottenere un bonus per il bel tiro!"
    },
    {
      "index": 69,
      "id": "poke_get_80_05",
      "hash": "b4ecbc880ddd2442",
      "flags": 0,
      "text": "Più piccolo è il cerchio quando lo centri,\\nmaggiori saranno i bonus che riceverai!"
    }
  ],
