  "lines": [
    {
      "index": 0,
      "id": "poke_get_01_00",
      "hash": "3a06eefb470cba20",
      "flags": 0,
      "text": "[VAR POKNAME(0000)] è apparso nel GO Park!"
    },
    {
      "index": 1,
      "id": "poke_get_01_01",
      "hash": "3a06effb470cbbd3",
      "flags": 4,
      "text": "Ah! Ti sei imbattut[VAR GENDBR(00FF,0101)]oa in [VAR FRAITA][VAR VARITA02(0000)][VAR POKNAME(0000)]\\nselvatico!"
    },
    {
      "index": 2,
      "id": "poke_get_01_02",
      "hash": "3a06f0fb470cbd86",
      "flags": 0,
      "text": "Questa è la tua chance!\\nCattura [VAR FRAITA][VAR VARITA00(0000)][VAR POKNAME(0000)] selvatico!"
    },
    {
      "index": 3,
      "id": "poke_get_01_03",
      "hash": "3a06f1fb470cbf39",
      "flags": 0,
      "text": "Questa è la tua chance!\\nCattura [VAR POKNAME(0000)]!"
    },
    {
      "index": 4,
      "id": "poke_get_01_04",
      "hash": "3a06f2fb470cc0ec",
      "flags": 0,
      "text": "Vuoi rinunciare a catturare questo Pokémon?"
    },
    {
      "index": 5,
      "id": "poke_get_01_05",
      "hash": "3a06f3fb470cc29f",
      "flags": 0,
      "text": "Vuoi interrompere la spiegazione\\nsu come lanciare una Poké Ball?"
    },
    {
      "index": 6,
      "id": "poke_get_01_06",
      "hash": "3a06f4fb470cc452",
      "flags": 4,
      "text": "Hai raggiunto il numero massimo di Pokémon!\\nMeglio tornare indietro..."
    },
    {
      "index": 7,
      "id": "poke_get_01_07",
      "hash": "3a06f5fb470cc605",
      "flags": 0,
      "text": "Non ti è rimasta nemmeno una Poké Ball!\\nMeglio ritirarsi per adesso..."
    },
    {
      "index": 8,
      "id": "poke_get_01_08",
      "hash": "3a06f6fb470cc7b8",
      "flags": 4,
      "text": "Oh no! Il Pokémon è uscito dalla Poké Ball!"
    },
    {
      "index": 9,
      "id": "poke_get_01_09",
      "hash": "3a06f7fb470cc96b",
      "flags": 4,
      "text": "Accipicchia! Mancava così poco!"
    },
    {
      "index": 10,
      "id": "poke_get_01_10",
      "hash": "3a0a74fb470fd3a9",
      "flags": 0,
      "text": "Peccato! L’avevi quasi preso!"
    },
    {
      "index": 11,
      "id": "poke_get_01_11",
      "hash": "3a0a73fb470fd1f6",
      "flags": 0,
      "text": "Caspita! C’eri quasi!"
    },
    {
      "index": 12,
      "id": "poke_get_01_12",
      "hash": "3a0a72fb470fd043",
      "flags": 4,
      "text": "Evviva! Hai catturato [VAR POKNAME(0000)]!"
    },
    {
      "index": 13,
      "id": "poke_get_01_13",
      "hash": "3a0a71fb470fce90",
      "flags": 0,
      "text": "[VAR POKNAME(0000)] è fuggito!"
    },
    {
      "index": 14,
      "id": "poke_get_01_14",
      "hash": "3a0a78fb470fda75",
      "flags": 8,
      "text": "Scampato pericolo!"
    },
    {
      "index": 15,
      "id": "poke_get_01_15",
      "hash": "3a0a77fb470fd8c2",
      "flags": 4,
      "text": "Un[VAR GENDBR(00FF,0A0B)]’Allenatric Allenatore di [VAR SUPPORT(0000)]\\nè sbucat[VAR GENDBR(00FF,0101)]ao fuori per aiutarti!"
    },
    {
      "index": 16,
      "id": "poke_get_02_01",
      "hash": "660df801a876ce1c",
      "flags": 0,
      "text": "Sì"
    },
    {
      "index": 17,
      "id": "poke_get_02_02",
      "hash": "660dfb01a876d335",
      "flags": 0,
      "text": "No"
    },
