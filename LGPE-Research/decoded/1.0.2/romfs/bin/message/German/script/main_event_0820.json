    {
      "index": 2,
      "id": "msg_main0820_fuji_03",
      "hash": "12da7ad4123aea93",
      "flags": 0,
      "text": "Hm...? Wer bist du?\\nStimmt irgendwas nicht?"
    },
    {
      "index": 3,
      "id": "msg_main0820_fuji_04",
      "hash": "12da7fd4123af312",
      "flags": 0,
      "text": "Was? Team Rocket soll es auf mich abgesehen\\nhaben?\\c\\nIch war so damit beschäftigt, Knoggas Seele zu\\nberuhigen, dass ich nichts mitbekommen habe."
    },
    {
      "index": 4,
      "id": "msg_main0820_fuji_05",
      "hash": "12da80d4123af4c5",
      "flags": 0,
      "text": "Ah, wie es scheint, hat Knoggas Seele endlich\\nFrieden gefunden."
    },
    {
      "index": 5,
      "id": "msg_main0820_fuji_06",
      "hash": "12da7dd4123aefac",
      "flags": 0,
      "text": "Bitte begleite mich doch zu mir nach Hause.\\nIch möchte mich bei dir bedanken."
    }
  ],
