    },
    {
      "index": 5,
      "id": "msg_main0040_doctor_03",
      "hash": "d72bd27e070853b0",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Prof. Eich:[VAR COLOR(0000)] Hey, wo willst du denn hin?\\nDein Pokémon wartet auf dich!"
    },
    {
      "index": 6,
      "id": "msg_main0040_rival_02",
      "hash": "14283ebd92c1b1c4",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main0040_new_rival_01",
      "hash": "300dda520826e5ae",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Professor!\\c\\nKönnen Sie mir erklären, warum da auf einmal\\ndrei Pokébälle liegen? Ich könnte schwören,\\r\\neben waren es noch zwei..."
    },
    {
      "index": 8,
      "id": "msg_main0040_new_doctor_01",
      "hash": "4e6eefdd0a5feaff",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Prof. Eich:[VAR COLOR(0000)] Da steckt der kleine Ausreißer also!\\c\\nIch schätze, im dritten Pokéball befindet sich\\ndas [VAR POKNAME(0002)], das [VAR TRNAME(0000)] eben\\r\\ngefangen hat."
    },
    {
      "index": 9,
      "id": "msg_main0040_new_rival_02",
      "hash": "300dd9520826e3fb",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]: [VAR COLOR(0000)]Was, echt? Du hast ganz\\nallein ein Pokémon gefangen, [VAR TRNAME(0000)]?!"
    },
    {
      "index": 10,
      "id": "msg_main0040_new_rival_03",
      "hash": "300dd8520826e248",
      "flags": 0,
      "text": "Woah! Habt ihr das gesehen?!"
    },
    {
      "index": 11,
      "id": "msg_main0040_new_doctor_02",
      "hash": "4e6ef0dd0a5fecb2",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Prof. Eich:[VAR COLOR(0000)] Hahaha! Dieses Pokémon ist wirklich\\nquicklebendig!"
    },
    {
      "index": 12,
      "id": "msg_main0040_new_doctor_04",
      "hash": "4e6eeadd0a5fe280",
      "flags": 0,
      "text": "Los, [VAR TRNAME(0000)]! Heb den Pokéball auf\\nund halte ihn diesmal ganz fest in der Hand!"
    },
    {
      "index": 13,
      "id": "msg_main0040_new_doctor_03",
      "hash": "4e6ef1dd0a5fee65",
      "flags": 0,
      "text": "Na los, hol dir dein [VAR POKNAME(0002)]!"
    },
    {
      "index": 14,
      "id": "msg_main0040_new_rival_04",
      "hash": "300ddf520826ee2d",
      "flags": 0,
      "text": "Ich glaube, das Pokémon, das du gefangen hast,\\nsteckt im mittleren Pokéball..."
    },
    {
      "index": 15,
      "id": "msg_main0040_new_rival_05",
      "hash": "300dde520826ec7a",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Hehe, sieht nicht so aus,\\nals würde es dir die Wahl lassen!"
    }
  ],
