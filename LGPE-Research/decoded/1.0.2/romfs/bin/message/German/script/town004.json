{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_town004_kanban_01",
      "hash": "b51317a8f3060e71",
      "flags": 0,
      "text": "Azuria City\\nUmgeben von einer mysteriösen blauen Aura!"
    },
    {
      "index": 1,
      "id": "msg_town004_kanban_02",
      "hash": "b51314a8f3060958",
      "flags": 0,
      "text": "Tipps für Trainer\\c\\nWenn du während der Entwicklung den B-Knopf\\ndrückst, wird sie gestoppt."
    },
    {
      "index": 2,
      "id": "msg_town004_kanban_03",
      "hash": "b51315a8f3060b0b",
      "flags": 0,
      "text": "Haus des Fahrradmaniacs"
    },
    {
      "index": 3,
      "id": "msg_town004_kanban_04",
      "hash": "b5131aa8f306138a",
      "flags": 0,
      "text": "Pokémon-Arena von Azuria City\\nArenaleiterin: Misty\\r\\nDie kecke Meerjungfrau!"
    },
    {
      "index": 4,
      "id": "msg_town004_adultm_01",
      "hash": "974467edc6eb5151",
      "flags": 0,
      "text": "Du bist also auch ein Trainer!\\c\\nDiese ganze Sammelei und Kämpferei ist sicher\\nmanchmal ganz schön anstrengend, oder?"
    },
    {
      "index": 5,
      "id": "msg_town004_youngm_01_01",
      "hash": "39c978ef1accc119",
      "flags": 0,
      "text": "Gegenüber vom Supermarkt wächst ein Strauch,\\nsodass man nicht auf die andere Seite kommt.\\c\\nAber angeblich soll es noch einen anderen Weg\\ndorthin geben..."
    },
    {
      "index": 6,
      "id": "msg_boya1_01_p02_field_t004",
      "hash": "6dbca59f00f65f78",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_town004_middlem_01",
      "hash": "3a702dc61ba863a4",
      "flags": 0,
      "text": "Du arbeitest an einer Pokémon-Enzyklopädie?\\nKlingt nach ’nem schönen Zeitvertreib!"
    },
    {
      "index": 8,
      "id": "msg_town004_policef_01",
      "hash": "eedfa2d161c67198",
      "flags": 0,
      "text": "Bei den Leuten in diesem Haus wurde\\neingebrochen.\\c\\nZeugenaussagen zufolge gehört der Täter zu\\nTeam Rocket.\\c\\nUm die Opfer des Einbruchs zu schützen, lasse\\nich hier momentan nicht mal ein Rattfratz\\r\\nungesehen passieren!"
    },
    {
      "index": 9,
      "id": "msg_town004_youngf_01_01",
      "hash": "89c3f2c67ed7bf0c",
      "flags": 0,
      "text": "Los, Lektrobal! Setze Ultraschall ein!\\c\\nKomm schon, Lektro, tu, was ich sage!"
    },
    {
      "index": 10,
      "id": "msg_town004_youngf_01_02",
      "hash": "89c3f5c67ed7c425",
      "flags": 0,
      "text": "Lektrobal! Tackle! Jetzt!\\c\\nMenno, das war schon wieder nichts..."
    },
    {
      "index": 11,
      "id": "msg_town004_youngf_01_03",
      "hash": "89c3f4c67ed7c272",
      "flags": 0,
      "text": "Lektrobal! Sternschauer!\\c\\n*Seufz...* Das war die falsche Attacke...\\nEs ist echt nicht einfach, Pokémon zu trainieren.\\c\\nOb ein Pokémon gehorcht oder nicht, hängt vom\\nKönnen seines Trainers ab."
    },
    {
      "index": 12,
      "id": "msg_town004_poke_01_01",
      "hash": "bbf3f6e0c799a43b",
      "flags": 0,
      "text": "Lektrobal macht ein Nickerchen..."
    },
    {
      "index": 13,
      "id": "msg_town004_poke_01_02",
      "hash": "bbf3f7e0c799a5ee",
      "flags": 0,
      "text": "Lektrobal faulenzt..."
    },
    {
      "index": 14,
      "id": "msg_town004_poke_01_03",
      "hash": "bbf3f8e0c799a7a1",
      "flags": 0,
      "text": "Lektrobal wendet sich ab..."
    },
    {
      "index": 15,
      "id": "msg_town004_poke_01_04",
      "hash": "bbf3f9e0c799a954",
      "flags": 0,
      "text": "Lektrobal ignoriert dich..."
    },
    {
      "index": 16,
      "id": "msg_town004_childf_01",
      "hash": "0333cfa13f0b2060",
      "flags": 0,
      "text": "Die Leute sagen, dass der Mann in dem Haus da\\nFahrräder aus der ganzen Welt sammelt!"
    },
    {
      "index": 17,
      "id": "msg_trainerm1_01_p01_field_t004",
      "hash": "424b20fd31d344f4",
      "flags": 0,
      "text": "Das hier ist die Azuria-Höhle.\\nDarin halten sich extrem starke Pokémon auf!\\c\\nEs wird nur Trainern Zutritt gewährt, die von der\\nPokémon-Liga als Champ anerkannt werden!"
    },
    {
      "index": 18,
      "id": "msg_town004_fat_01",
      "hash": "9b47f4cb990902d1",
      "flags": 0,
      "text": "[~ 18]"
    },
    {
      "index": 19,
      "id": "msg_town004_poke_02_01",
      "hash": "1259bee863036144",
      "flags": 0,
      "text": "[~ 19]"
    },
    {
      "index": 20,
      "id": "msg_town004_miniskirt_01",
      "hash": "a554ab1074d15de6",
      "flags": 0,
      "text": "[~ 20]"
    },
    {
      "index": 21,
      "id": "msg_town004_poke_03",
      "hash": "da1f26e2db35d5ad",
      "flags": 0,
      "text": "[~ 21]"
    },
    {
      "index": 22,
      "id": "msg_town004_poke_04",
      "hash": "da1f1fe2db35c9c8",
      "flags": 0,
      "text": "[~ 22]"
    }
  ],
