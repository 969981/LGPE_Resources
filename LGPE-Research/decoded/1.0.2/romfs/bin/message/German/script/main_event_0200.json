{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0200_scientist_01",
      "hash": "1997f465dac34205",
      "flags": 0,
      "text": "Halt! Stopp! Finger weg!"
    },
    {
      "index": 1,
      "id": "msg_main0200_scientist_05",
      "hash": "1997f065dac33b39",
      "flags": 0,
      "text": "Ich habe diese Fossilien gefunden, also gehören\\nsie auch mir."
    },
    {
      "index": 2,
      "id": "msg_main0200_scientist_06",
      "hash": "1997ed65dac33620",
      "flags": 0,
      "text": "Wer zuerst kommt, mahlt zuerst!"
    },
    {
      "index": 3,
      "id": "msg_science_02_02",
      "hash": "3f4233734bcf5c9d",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "msg_main0200_scientist_02",
      "hash": "1997f165dac33cec",
      "flags": 0,
      "text": "Na schön, teilen wir. Es gibt ein Fossil pro Kopf.\\nAber bloß nicht gierig werden!"
    },
    {
      "index": 5,
      "id": "msg_main0200_sys_01",
      "hash": "4a818fc482d38e68",
      "flags": 0,
      "text": "Entscheidest du dich für das Domfossil?"
    },
    {
      "index": 6,
      "id": "msg_main0200_sys_02",
      "hash": "4a8192c482d39381",
      "flags": 0,
      "text": "Entscheidest du dich für das Helixfossil?"
    },
    {
      "index": 7,
      "id": "msg_main0200_sys_03",
      "hash": "4a8191c482d391ce",
      "flags": 0,
      "text": "Du erhältst das Helixfossil!"
    },
    {
      "index": 8,
      "id": "msg_main0200_sys_04",
      "hash": "4a8194c482d396e7",
      "flags": 0,
      "text": "Du erhältst das Domfossil!"
    },
    {
      "index": 9,
      "id": "msg_main0200_scientist_03",
      "hash": "1997f265dac33e9f",
      "flags": 0,
      "text": "Nun gut, dann nehme ich das hier."
    },
    {
      "index": 10,
      "id": "msg_main0200_scientist_04",
      "hash": "1997ef65dac33986",
      "flags": 0,
      "text": "Auf der fernen Zinnoberinsel steht ein Pokémon-\\nLabor. Es heißt, man versuche dort, Fossilien in\\r\\nPokémon zurückzuverwandeln..."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0200_max",
