    {
      "index": 0,
      "id": "msg_t006r0101_fat_01_01",
      "hash": "16a1c4266049649d",
      "flags": 0,
      "text": "Schau mal! Hat mein Pikachu nicht einen\\nniedlichen Schweif?"
    },
    {
      "index": 1,
      "id": "msg_t006r0101_fat_01_02",
      "hash": "16a1c12660495f84",
      "flags": 0,
      "text": "Pah!\\c\\nMein Pikachu ist mindestens doppelt so süß!"
    },
    {
      "index": 2,
      "id": "msg_t006r0101_youngf_01_01",
      "hash": "0ee506a6250d159c",
      "flags": 0,
      "text": "Ich liebe mein Jurob!\\nEs quiekt, wenn ich es in den Arm nehme!"
    },
    {
      "index": 3,
      "id": "msg_t006r0101_youngf_01_02",
      "hash": "0ee509a6250d1ab5",
      "flags": 0,
      "text": "Ohoho!\\c\\nMein Jurob ist mindestens doppelt so niedlich!"
    },
    {
      "index": 4,
      "id": "msg_t006r0101_poke_01",
      "hash": "92f57942219c9e77",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Pikachu:[VAR COLOR(0000)] Pikachu!"
    },
    {
      "index": 5,
      "id": "msg_t006r0101_poke_02",
      "hash": "92f57a42219ca02a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jurob:[VAR COLOR(0000)] Rooob!"
    },
    {
      "index": 6,
      "id": "msg_t006r0101_stafff_01",
      "hash": "eeb3cbaafce30758",
      "flags": 0,
      "text": "Unser Vorsitzender redet ununterbrochen über\\nPokémon."
    },
    {
      "index": 7,
      "id": "msg_t006r0101_poster_01",
      "hash": "26d385ca9600a6a3",
      "flags": 0,
      "text": "Wenn ein Trainer voller Stolz von seinen\\nPokémon schwärmt, höre ihm aufmerksam zu!"
    },
    {
      "index": 8,
      "id": "msg_t006r0101_poster_02",
      "hash": "26d386ca9600a856",
      "flags": 0,
      "text": "Wenn dir jemand etwas vorschwärmt, dann\\nschwärme zehn Mal so schwärmerisch zurück!"
    },
    {
      "index": 9,
      "id": "msg_t006r0101_poster_03",
      "hash": "26d387ca9600aa09",
      "flags": 0,
      "text": "„Mein niedliches Gallopa!“"
    },
    {
      "index": 10,
      "id": "msg_t006r0101_poster_04",
      "hash": "26d388ca9600abbc",
      "flags": 0,
      "text": "„Mein geliebtes Ibitak!“"
    },
    {
      "index": 11,
      "id": "msg_t006r0101_poster_05",
      "hash": "26d389ca9600ad6f",
      "flags": 0,
      "text": "„Ich und meine geliebten Pokémon!“"
    },
    {
      "index": 12,
      "id": "msg_t006r0101_poster_06",
      "hash": "26d38aca9600af22",
      "flags": 0,
      "text": "Hier ist ein Magazin mit dem Titel:\\c\\n„Meine Pokémon und ich – eine Freundschaft\\nin Bildern“"
