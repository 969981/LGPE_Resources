  "lines": [
    {
      "index": 0,
      "id": "msg_sub031_bigman_01",
      "hash": "690f43ce056a08a6",
      "flags": 0,
      "text": "*Gähn...* Ich wollte mich nur ein bisschen in der\\nSonne ausruhen und schon war ich eingenickt."
    },
    {
      "index": 1,
      "id": "msg_sub031_bigman_02",
      "hash": "690f42ce056a06f3",
      "flags": 0,
      "text": "Ich hatte einen seltsamen Traum..."
    },
    {
      "index": 2,
      "id": "msg_sub031_bigman_03",
      "hash": "690f41ce056a0540",
      "flags": 0,
      "text": "Da war so eine verlorene Seele. Sie ist zu einer\\nFlamme geworden und schwirrte dann in der\\r\\nGegend umher.\\c\\nHuch? Wo kommt denn diese TM plötzlich her?"
    },
    {
      "index": 3,
      "id": "msg_sub031_bigman_04",
      "hash": "690f48ce056a1125",
      "flags": 0,
      "text": "Uuuh... Das ist unheimlich! Hier, nimm du sie!"
    },
    {
      "index": 4,
      "id": "msg_sub031_bigman_05",
      "hash": "690f47ce056a0f72",
      "flags": 0,
      "text": "Die TM11 enthält... die Attacke Irrlicht...\\c\\nHuch... Da läuft’s mir eiskalt den Rücken runter..."
    },
    {
      "index": 5,
      "id": "msg_bigman1_01_p01_field_t002",
      "hash": "0d8abe8d759c5238",
      "flags": 0,
      "text": "[~ 5]"
