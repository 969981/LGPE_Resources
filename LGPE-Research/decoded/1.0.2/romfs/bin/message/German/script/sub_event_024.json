{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub024_researcher_01",
      "hash": "d427d40043ea8c98",
      "flags": 0,
      "text": "Hallo!\\c\\nIch bin ein wirklich superwichtiger\\nWissenschaftler hier!\\c\\nIch erforsche unermüdlich seltene Fossilien!\\c\\nUnd du, hmmm?\\nHast du ein wertvolles Fossil dabei?"
    },
    {
      "index": 1,
      "id": "msg_sub024_select_01",
      "hash": "9c5bbb480ccf64a2",
      "flags": 0,
      "text": "Helixfossil"
    },
    {
      "index": 2,
      "id": "msg_sub024_select_02",
      "hash": "9c5bba480ccf62ef",
      "flags": 0,
      "text": "Domfossil"
    },
    {
      "index": 3,
      "id": "msg_sub024_select_03",
      "hash": "9c5bb9480ccf613c",
      "flags": 0,
      "text": "Altbernstein"
    },
    {
      "index": 4,
      "id": "msg_sub024_select_04",
      "hash": "9c5bb8480ccf5f89",
      "flags": 0,
      "text": "Abbrechen"
    },
    {
      "index": 5,
      "id": "msg_sub024_researcher_02",
      "hash": "d427d70043ea91b1",
      "flags": 0,
      "text": "Hmmm, du hast also keins dabei...\\nDas ist aber schade."
    },
    {
      "index": 6,
      "id": "msg_sub024_researcher_03",
      "hash": "d427d60043ea8ffe",
      "flags": 0,
      "text": "Das Experiment ist geglückt, hmmm!\\c\\nDein Fossil war ein [VAR POKNAME(0004)].\\nGanz, wie ich es vermutet hatte, hmmm!"
    },
    {
      "index": 7,
      "id": "msg_sub024_sys_01",
      "hash": "0fa5772ce07503fd",
      "flags": 0,
      "text": "[VAR POKNAME(0004)] erhalten!"
    },
    {
      "index": 8,
      "id": "msg_sub024_researcher_04",
      "hash": "d427d90043ea9517",
      "flags": 0,
      "text": "Hmmm! Ein [VAR ITEM2(0002)]!\\c\\nIch denke, das ist ein Fossil des lange\\nausgestorbenen Pokémon [VAR POKNAME(0001)].\\c\\nDank der Maschine, die ich entworfen habe,\\nkann ich es in ein Pokémon zurückverwandeln!\\c\\nMöchtest du, dass ich das Fossil in ein Pokémon\\nzurückverwandle?"
    },
    {
      "index": 9,
      "id": "msg_sub024_researcher_05",
      "hash": "d427d80043ea9364",
      "flags": 0,
      "text": "Hmmm, nun mach schon! Gib es endlich her!"
    },
    {
      "index": 10,
      "id": "msg_sub024_sys_02",
      "hash": "0fa5742ce074fee4",
      "flags": 0,
      "text": "Du gibst dem kauzigen Wissenschaftler\\n[VAR VARGER01(0002)][VAR ITEM2(0002)]."
    },
    {
      "index": 11,
      "id": "msg_sub024_researcher_06",
      "hash": "d427db0043ea987d",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_sub024_researcher_07",
      "hash": "d427da0043ea96ca",
      "flags": 0,
      "text": "Hmmm, du kannst mich jederzeit besuchen\\nkommen!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_024_max",
