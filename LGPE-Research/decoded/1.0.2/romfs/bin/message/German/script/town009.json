  "lines": [
    {
      "index": 0,
      "id": "msg_town009_kanban_01",
      "hash": "fb2eb207c83c71be",
      "flags": 0,
      "text": "Zinnoberinsel\\nHier glüht die Leidenschaft rot wie Feuer!"
    },
    {
      "index": 1,
      "id": "msg_town009_kanban_02",
      "hash": "fb2eb107c83c700b",
      "flags": 0,
      "text": "Zinnoberinsel-Labor\\nPokémon-Forschungsinstitut"
    },
    {
      "index": 2,
      "id": "msg_town009_kanban_03",
      "hash": "fb2eb007c83c6e58",
      "flags": 0,
      "text": "Pokémon-Arena der Zinnoberinsel\\nArenaleiter: Pyro\\r\\nDer hitzköpfige Quizmaster!"
    },
    {
      "index": 3,
      "id": "msg_town009_door_01",
      "hash": "7c8fc01f8569409f",
      "flags": 0,
      "text": "Auf der Tür steht etwas in kleiner Schrift\\ngeschrieben:\\c\\n„Frage:\\nWo befindet sich der Schlüssel zu dieser Arena?\\c\\nHinweis:\\nVielleicht in einem zugewachsenen Gebäude?“"
    },
    {
      "index": 4,
      "id": "msg_town009_youngf_01_01",
      "hash": "a8d70bfaf363b6cd",
      "flags": 0,
      "text": "Pyro, der Arenaleiter der Zinnoberinsel, ist ein\\nseltsamer Mann. Er hat hier schon gelebt, bevor\\r\\ndas Labor gebaut wurde."
    },
    {
      "index": 5,
      "id": "msg_town009_oldm_01_01",
      "hash": "8b31d9faa53907bb",
      "flags": 0,
      "text": "Hin und wieder sehe ich, wie Forscher in der\\nPokémon-Villa verschwinden.\\c\\nOb sie da drin etwa Experimente durchführen?"
    },
    {
      "index": 6,
      "id": "msg_town009_poke_01",
      "hash": "e5ebf5a8a6bca1dc",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Magmar:[VAR COLOR(0000)] Maaa!"
    },
    {
      "index": 7,
      "id": "msg_town009_poke_02",
      "hash": "e5ebf8a8a6bca6f5",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Sterndu:[VAR COLOR(0000)] Duduuu!"
    },
