    },
    {
      "index": 7,
      "id": "msg_main0030_new_doctor_01",
      "hash": "e79395d568abbc54",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Prof. Eich:[VAR COLOR(0000)] Vielen Dank, Freunde!"
    },
    {
      "index": 8,
      "id": "msg_main0030_new_doctor_09",
      "hash": "e7938dd568abaebc",
      "flags": 0,
      "text": "Ihr habt mir dabei geholfen, euch Taubsi etwas\\nbesser zu verstehen. Macht’s gut!"
    },
    {
      "index": 9,
      "id": "msg_main0030_new_doctor_02",
      "hash": "e79398d568abc16d",
      "flags": 0,
      "text": "Oh, sieh einer an! Wenn das mal nicht\\n[VAR TRNAME(0000)] ist."
    },
    {
      "index": 10,
      "id": "msg_main0030_new_doctor_10",
      "hash": "e79010d568a8a47e",
      "flags": 0,
      "text": "Ach, stimmt ja! Ich hatte versprochen, dir und\\n[VAR TRNAME(0001)] euer erstes Pokémon zu geben!\\c\\nDann lass uns doch gleich zum Labor gehen..."
    },
    {
      "index": 11,
      "id": "msg_main0030_new_doctor_03",
      "hash": "e79397d568abbfba",
      "flags": 0,
      "text": "Hm?"
    },
    {
      "index": 12,
      "id": "msg_main0030_new_doctor_04",
      "hash": "e79392d568abb73b",
      "flags": 0,
      "text": "Na, so was!"
    },
    {
      "index": 13,
      "id": "msg_main0030_new_doctor_05",
      "hash": "e79391d568abb588",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Prof. Eich: [VAR COLOR(0000)]Ein hervorragender Wurf! Kaum zu\\nglauben, dass das dein allererster Fang war."
    },
    {
      "index": 14,
      "id": "msg_main0030_new_doctor_11",
      "hash": "e79011d568a8a631",
      "flags": 0,
      "text": "Jetzt musst du den Pokéball nur noch aufheben,\\nund schon gehört das Pokémon dir!\\c\\nWenn du möchtest, kannst du deinem [VAR POKNAME(0002)]\\nsogar einen Spitznamen geben!"
    },
    {
      "index": 15,
      "id": "msg_main0030_new_doctor_06",
      "hash": "e79394d568abbaa1",
      "flags": 0,
      "text": "Huch?!"
    },
    {
      "index": 16,
      "id": "msg_main0030_new_doctor_07",
      "hash": "e79393d568abb8ee",
      "flags": 0,
      "text": "Das ist aber ein lebendiges Kerlchen!"
    },
    {
      "index": 17,
      "id": "msg_main0030_new_doctor_08",
      "hash": "e7938ed568abb06f",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Prof. Eich:[VAR COLOR(0000)] Hey, warte doch! Komm zurück!"
    }
  ],
