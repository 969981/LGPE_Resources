  "lines": [
    {
      "index": 0,
      "id": "msg_sub070_pokemaniac_01",
      "hash": "8107bdd0a1e3bea9",
      "flags": 0,
      "text": "Wow! D-Du bist also der Ch-Champ?!\\c\\nUnd d-du sprichst ausgerechnet m-mich an?\\nM-Mensch, das macht mich echt st-stolz!"
    },
    {
      "index": 1,
      "id": "msg_sub070_pokemaniac_02",
      "hash": "8107bad0a1e3b990",
      "flags": 0,
      "text": "I-Ich verkaufe seltene St-Steine...\\c\\nD-Dir als Ch-Champ mache ich für die\\nMega-Steine, d-die ich im Ausland erworben\\r\\nhabe, natürlich ein b-besonders gutes Angebot!"
    },
    {
      "index": 2,
      "id": "msg_sub070_select_01",
      "hash": "f24dce3d0034442f",
