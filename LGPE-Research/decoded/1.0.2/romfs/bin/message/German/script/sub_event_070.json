    {
      "index": 12,
      "id": "msg_sub070_pokemaniac_03",
      "hash": "8107bbd0a1e3bb43",
      "flags": 0,
      "text": "Es löst bei Bibor die Mega-Entwicklung aus.\\nIch überlass es dir für [VAR NUM5(0000,002E)] ₽."
    },
    {
      "index": 13,
      "id": "msg_sub070_pokemaniac_04",
      "hash": "8107c0d0a1e3c3c2",
      "flags": 0,
      "text": "Es löst bei Tauboss die Mega-Entwicklung aus.\\nIch überlass es dir für [VAR NUM5(0000,002E)] ₽."
    },
    {
      "index": 14,
      "id": "msg_sub070_pokemaniac_05",
