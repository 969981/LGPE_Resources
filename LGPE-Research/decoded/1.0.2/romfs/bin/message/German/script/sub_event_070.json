    },
    {
      "index": 17,
      "id": "msg_sub070_pokemaniac_08",
      "hash": "8107c4d0a1e3ca8e",
      "flags": 0,
      "text": "Es löst bei Kangama die Mega-Entwicklung aus.\\nIch überlass es dir für [VAR NUM5(0000,002E)] ₽."
    },
    {
      "index": 18,
      "id": "msg_sub070_pokemaniac_09",
