    {
      "index": 20,
      "id": "msg_sub070_pokemaniac_11",
      "hash": "810ac1d0a1e5fb4c",
      "flags": 0,
      "text": "Es löst bei Aerodactyl die Mega-Entwicklung aus.\\nIch überlass es dir für [VAR NUM5(0000,002E)] ₽."
