    {
      "index": 21,
      "id": "msg_sub070_select_11",
      "hash": "f251523d00375a52",
      "flags": 0,
      "text": "Ich kaufe es."
    },
    {
      "index": 22,
      "id": "msg_sub070_select_12",
      "hash": "f251513d0037589f",
      "flags": 0,
      "text": "Nein danke."
    },
    {
      "index": 23,
      "id": "msg_sub070_pokemaniac_12",
      "hash": "810ac4d0a1e60065",
      "flags": 0,
      "text": "V-Vielen Dank für d-deinen Einkauf...\\nD-Darf es s-sonst noch etwas sein?"
    },
    {
      "index": 24,
      "id": "msg_sub070_pokemaniac_13",
      "hash": "810ac3d0a1e5feb2",
      "flags": 0,
      "text": "B-Bis zum nächsten M-Mal!"
    },
    {
      "index": 25,
      "id": "msg_sub070_pokemaniac_14",
      "hash": "810abed0a1e5f633",
      "flags": 0,
      "text": "D-Du hast wohl leider nicht genug G-Geld\\nd-dabei..."
    },
    {
      "index": 26,
      "id": "msg_sub070_pokemaniac_15",
      "hash": "810abdd0a1e5f480",
      "flags": 0,
      "text": "W-Wer hätte gedacht, d-dass du mir tatsächlich\\na-alle Mega-Steine abkaufst!\\c\\nAber d-das macht halt einen Ch-Champ aus.\\nS-Setze die Mega-Steine immer f-fleißig ein."
    },
    {
      "index": 27,
      "id": "msg_sub070_pokemaniac_16",
      "hash": "810ac0d0a1e5f999",
      "flags": 0,
      "text": "Hallo, Ch-Champ! Und? S-Setzt du deine\\nMega-Steine f-fleißig ein?"
    },
    {
      "index": 28,
      "id": "msg_sub070_select_13",
      "hash": "f251503d003756ec",
      "flags": 0,
      "text": "Mega-Stein-Verkäufer"
    }
