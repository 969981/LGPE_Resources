    {
      "index": 5,
      "id": "msg_main_1010_sys_01",
      "hash": "1651f10d6b07e451",
      "flags": 0,
      "text": "[~ 5]"
    },
    {
      "index": 6,
      "id": "msg_main_1010_sys_02",
      "hash": "1651ee0d6b07df38",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main1010_muscle_04",
      "hash": "313c7eb68af79e19",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "msg_main1010_muscle_n_01",
      "hash": "27012684004f6025",
      "flags": 0,
      "text": "Mein Lapras mag schon in die Jahre gekommen\\nsein, es bezaubert mich aber wie eh und je..."
    },
    {
      "index": 9,
      "id": "msg_main1010_muscle_n_09",
      "hash": "27012e84004f6dbd",
      "flags": 0,
      "text": "Weißt du, früher bin ich zusammen mit ihm\\nüber die Wellen geritten und zu neuen\\r\\nHorizonten aufgebrochen!"
    },
    {
      "index": 10,
      "id": "msg_main1010_poke_n_01",
      "hash": "0fbf99abdfd06be7",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Lapras:[VAR COLOR(0000)] Laaa!"
    },
    {
      "index": 11,
      "id": "msg_main1010_muscle_n_02",
      "hash": "27012384004f5b0c",
      "flags": 0,
      "text": "Aber mittlerweile kann Lapras nicht mehr\\nso gut schwimmen...\\c\\nDaher habe ich mich entschlossen, das Surfbrett\\nan den Nagel zu hängen und hier bei meinem\\r\\nalten Freund zu bleiben."
    },
    {
      "index": 12,
      "id": "msg_main1010_muscle_n_03",
      "hash": "27012484004f5cbf",
      "flags": 0,
      "text": "Hach ja...\\c\\nDanke, dass du mir zugehört hast."
    },
    {
      "index": 13,
      "id": "msg_main1010_muscle_n_10",
      "hash": "2704ab84005277fb",
      "flags": 0,
      "text": "Im Gegenzug könnte ich dir beibringen, wie du\\ndie [VAR COLOR(0006)]Geheime Technik Wellenspurt[VAR COLOR(0000)] einsetzt.\\c\\nDamit kannst du über das Wasser flitzen!"
    },
    {
      "index": 14,
      "id": "msg_main1010_muscle_n_04",
      "hash": "27012184004f57a6",
      "flags": 0,
      "text": "Haha! Dein kleines [VAR POKNAME(0002)] möchte\\nsie wohl auch erlernen!"
    },
    {
      "index": 15,
      "id": "msg_main1010_muscle_n_11",
      "hash": "2704aa8400527648",
      "flags": 0,
      "text": "Dabei ist es gar kein Wasser-Pokémon...\\nOb das gutgeht?"
    },
    {
      "index": 16,
      "id": "msg_main1010_partner_a_01",
      "hash": "f1cf0975034c2acf",
      "flags": 0,
      "text": "Pika, pika!"
    },
    {
      "index": 17,
      "id": "msg_main1010_partner_b_01",
      "hash": "f30a517a2a59c078",
      "flags": 0,
      "text": "Voli!"
    },
    {
      "index": 18,
      "id": "msg_main1010_muscle_n_05",
      "hash": "27012284004f5959",
      "flags": 0,
      "text": "Dieser Blick in seinen Augen erinnert mich sehr\\nan mein Lapras. Solch eine Kraft...!"
    },
    {
      "index": 19,
      "id": "msg_main1010_muscle_n_12",
      "hash": "2704ad8400527b61",
      "flags": 0,
      "text": "Na gut, du hast mich überzeugt. Pass gut auf!"
    },
    {
      "index": 20,
      "id": "msg_main1010_partner_a_02",
      "hash": "f1cf0a75034c2c82",
      "flags": 0,
      "text": "Pika! Pikachuuu!"
    },
    {
      "index": 21,
      "id": "msg_main1010_partner_b_02",
      "hash": "f30a547a2a59c591",
      "flags": 0,
      "text": "Vo, voli!"
    },
    {
      "index": 22,
      "id": "msg_main1010_muscle_n_06",
      "hash": "27011f84004f5440",
      "flags": 0,
      "text": "Aaaalso, der Trick ist, auf dem Wasser die\\nBalance zu halten.\\c\\nDafür musst du deinen Schwerpunkt nach unten\\nverlagern und deinen Oberkörper stabil halten!"
    },
    {
      "index": 23,
      "id": "msg_main1010_sys_n_01",
      "hash": "5b153dffd0bef2dd",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] hat die [VAR COLOR(0006)]Geheime Technik[VAR COLOR(0000)]\\n[VAR COLOR(0006)]Wellenspurt[VAR COLOR(0000)] erlernt!"
    },
    {
      "index": 24,
      "id": "msg_main1010_muscle_n_07",
      "hash": "27012084004f55f3",
      "flags": 0,
      "text": "Das hast du ganz hervorragend gemacht!\\nHier, mein Surfbrett gebe ich dir auch."
    },
    {
      "index": 25,
      "id": "msg_main1010_muscle_n_13",
      "hash": "2704ac84005279ae",
      "flags": 0,
      "text": "Reitet zusammen über die Wellen und brecht\\nzu neuen Horizonten auf!"
    },
    {
      "index": 26,
      "id": "msg_main1010_muscle_n_08",
      "hash": "27012d84004f6c0a",
      "flags": 0,
      "text": "Ich wünsche [VAR POKNAME(0002)] und dir, dass eure\\nFreundschaft so lange hält wie unsere."
    }
  ],
