{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub037_adultf_01",
      "hash": "0754a41f7a189db8",
      "flags": 0,
      "text": "Ich kümmere mich hier um verletzte Pokémon."
    },
    {
      "index": 1,
      "id": "msg_sub037_adultf_02",
      "hash": "0754a71f7a18a2d1",
      "flags": 0,
      "text": "Jetzt, wo Bisasam wieder richtig fit ist, würde ich\\nes gerne in die Obhut eines erfahrenen Trainers\\r\\ngeben, der schon etliche Pokémon gefangen hat."
    },
    {
      "index": 2,
      "id": "msg_sub037_adultf_08",
      "hash": "07549d1f7a1891d3",
      "flags": 0,
      "text": "Du hast bisher [VAR NUM9(0000,202F)] Pokémon\\ngefangen?"
    },
    {
      "index": 3,
      "id": "msg_sub037_adultf_03",
      "hash": "0754a61f7a18a11e",
      "flags": 0,
      "text": "Das ist wirklich beeindruckend! Ich glaube,\\ndir kann ich vertrauen.\\c\\nWärst du so lieb und würdest dieses Bisasam\\nan dich nehmen?"
    },
    {
      "index": 4,
      "id": "msg_sub037_adultf_04",
      "hash": "0754a91f7a18a637",
      "flags": 0,
      "text": "Vielen Dank! Kümmere dich gut um Bisasam!"
    },
    {
      "index": 5,
      "id": "msg_sub037_adultf_09",
      "hash": "07549c1f7a189020",
      "flags": 0,
      "text": "Hmmm, ich weiß ja nicht...\\c\\nKomm wieder, wenn du mindestens [VAR NUM2(0000)] Pokémon\\ngefangen hast, dann reden wir noch mal darüber."
    },
    {
      "index": 6,
      "id": "msg_sub037_adultf_05",
      "hash": "0754a81f7a18a484",
      "flags": 0,
      "text": "Ich hoffe, Bisasam geht es gut."
    },
    {
      "index": 7,
      "id": "msg_sub037_adultf_06",
      "hash": "0754ab1f7a18a99d",
      "flags": 0,
      "text": "Oh... Das ist aber schade..."
    },
    {
      "index": 8,
      "id": "msg_sub037_poke_01",
      "hash": "96bdf2947fd99335",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Bisasam:[VAR COLOR(0000)] Bisa! Bisasam!"
    }
  ],
