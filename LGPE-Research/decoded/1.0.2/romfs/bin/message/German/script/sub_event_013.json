{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub013_sister_01",
      "hash": "26f68ca277e78a2c",
      "flags": 0,
      "text": "Hallo [VAR TRNAME(0000)]!\\c\\nMöchtest du wissen, wie sehr deine Pokémon\\ndir vertrauen?"
    },
    {
      "index": 1,
      "id": "msg_sub013_sister_02",
      "hash": "26f68fa277e78f45",
      "flags": 0,
      "text": "Hallo [VAR TRNAME(0000)]!\\c\\nMöchtest du wissen, wie sehr deine Pokémon\\ndir vertrauen?"
    },
    {
      "index": 2,
      "id": "msg_sub013_sister_03",
      "hash": "26f68ea277e78d92",
      "flags": 0,
      "text": "Wenn ein Trainer sich gut um seine Pokémon\\nkümmert, fassen diese immer mehr Vertrauen."
    },
    {
      "index": 3,
      "id": "msg_sub013_sister_04",
      "hash": "26f689a277e78513",
      "flags": 0,
      "text": "Dann schaue ich mir dein [VAR PKNICK(0001)]\\nmal kurz an."
    },
    {
      "index": 4,
      "id": "msg_sub013_sister_05",
      "hash": "26f688a277e78360",
      "flags": 0,
      "text": "[VAR PKNICK(0001)] scheint dir blind zu vertrauen!\\nIhr müsst einander schrecklich gernhaben!"
    },
    {
      "index": 5,
      "id": "msg_sub013_sister_06",
      "hash": "26f68ba277e78879",
      "flags": 0,
      "text": "[VAR PKNICK(0001)] hegt großes Vertrauen in dich!\\nEs möchte für immer bei dir bleiben!"
    },
    {
      "index": 6,
      "id": "msg_sub013_sister_07",
      "hash": "26f68aa277e786c6",
      "flags": 0,
      "text": "[VAR PKNICK(0001)] scheint dir zu vertrauen!"
    },
    {
      "index": 7,
      "id": "msg_sub013_sister_08",
      "hash": "26f695a277e79977",
      "flags": 0,
      "text": "Sein Vertrauen in dich wächst!\\nMach einfach weiter so!"
    },
    {
      "index": 8,
      "id": "msg_sub013_sister_09",
      "hash": "26f694a277e797c4",
      "flags": 0,
      "text": "Es vertraut dir schon ein bisschen!\\nDas scheint in die richtige Richtung zu gehen!"
    },
    {
      "index": 9,
      "id": "msg_sub013_sister_10",
      "hash": "26f307a277e47256",
      "flags": 0,
      "text": "Ihr kennt euch noch nicht lange, oder?\\nIch hoffe, ihr lernt euch bald besser kennen!"
    },
    {
      "index": 10,
      "id": "msg_sub013_sister_11",
      "hash": "26f308a277e47409",
      "flags": 0,
      "text": "Kann es sein, dass es bei Pokémon-Kämpfen\\noft besiegt wird...?"
    },
    {
      "index": 11,
      "id": "msg_sub013_sister_12",
      "hash": "26f305a277e46ef0",
      "flags": 0,
      "text": "Wie furchtbar! Was machst du noch hier?\\nBring es sofort in ein Pokémon-Center!"
    },
    {
      "index": 12,
      "id": "msg_woman1_01_p11_t001_r0201",
      "hash": "d543d023df5a8e8d",
