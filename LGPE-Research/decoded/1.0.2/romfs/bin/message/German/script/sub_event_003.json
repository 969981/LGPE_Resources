      "flags": 0,
      "text": "Ich hab Durst! Ich will jetzt sofort was aus dem\\nGetränkeautomaten haben!"
    },
    {
      "index": 1,
      "id": "msg_sub003_sys_00",
      "hash": "18b71d43373e409b",
      "flags": 0,
      "text": "Möchtest du dem Mädchen ein Getränk\\nabgeben?"
    },
    {
      "index": 2,
      "id": "msg_sub003_childf_02",
      "hash": "c1626b54b51bb00c",
      "flags": 0,
      "text": "Ich hab Durst! Ich will jetzt sofort was aus dem\\nGetränkeautomaten haben!"
    },
    {
      "index": 3,
      "id": "msg_sub003_sys_01",
      "hash": "18b71c43373e3ee8",
      "flags": 0,
      "text": "Welches Getränk möchtest du ihr geben?"
