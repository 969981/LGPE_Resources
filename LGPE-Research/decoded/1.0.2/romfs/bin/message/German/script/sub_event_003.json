    {
      "index": 15,
      "id": "msg_sub003_childf_07",
      "hash": "c1626854b51baaf3",
      "flags": 0,
      "text": "Cool, Limonade!\\c\\nDas war lecker, danke schön. Dafür schenke ich\\ndir auch etwas ganz Tolles!"
    },
