    {
      "index": 0,
      "id": "msg_town008_kanban_01",
      "hash": "b2517de2ea7f3fcd",
      "flags": 0,
      "text": "Fuchsania City\\nDie Stadt der rosaroten Träume!"
    },
    {
      "index": 1,
      "id": "msg_town008_kanban_02",
      "hash": "b2517ae2ea7f3ab4",
      "flags": 0,
      "text": "Pokémon-Arena von Fuchsania City\\nArenaleiter: Koga\\r\\nDer giftige Ninja-Meister!"
    },
    {
      "index": 2,
      "id": "msg_town008_kanban_03",
      "hash": "b2517be2ea7f3c67",
      "flags": 0,
      "text": "Willkommen in der Safari-Zone\\nHier wimmelt es von Pokémon!"
    },
    {
      "index": 3,
      "id": "msg_town008_kanban_04",
      "hash": "b25178e2ea7f374e",
      "flags": 0,
      "text": "Hereinspaziert in den GO Park!\\c\\nVertreibe dir auf unserer berühmten Spielwiese\\ndie Zeit als Pokémon-Hirte!"
    },
    {
      "index": 4,
      "id": "msg_town008_kanban_05",
      "hash": "b25179e2ea7f3901",
      "flags": 0,
      "text": "Safari-Zone\\nHaus des Direktors"
