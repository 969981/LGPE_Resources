{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "poke_waza_01_01",
      "hash": "29fdd1ac6c57525c",
      "flags": 0,
      "text": "Ich bin, äh...\\nW-Wer bin ich noch gleich?\\c\\n...\\c\\nAch so... Ja, genau!\\nIch bin der Attacken-Verlerner!"
    },
    {
      "index": 1,
      "id": "poke_waza_01_02",
      "hash": "29fdd4ac6c575775",
      "flags": 0,
      "text": "Du willst, dass ich eines deiner Pokémon\\neine Attacke vergessen lasse, stimmt’s?"
    },
    {
      "index": 2,
      "id": "poke_waza_01_03",
      "hash": "29fdd3ac6c5755c2",
      "flags": 0,
      "text": "Welches Pokémon soll eine Attacke vergessen?"
    },
    {
      "index": 3,
      "id": "poke_waza_01_04",
      "hash": "29fdceac6c574d43",
      "flags": 0,
      "text": "Erinnere dich an mich, wenn du möchtest, dass\\neines deiner Pokémon eine Attacke vergisst."
    },
    {
      "index": 4,
      "id": "poke_waza_01_05",
      "hash": "29fdcdac6c574b90",
      "flags": 0,
      "text": "Nanu? Dieses Pokémon kennt nur eine Attacke,\\ndaher kann es keine vergessen..."
    },
    {
      "index": 5,
      "id": "poke_waza_01_06",
      "hash": "29fdd0ac6c5750a9",
      "flags": 0,
      "text": "Nanu? Das ist doch ein Ei!\\nEier kennen keine Attacken!"
    },
    {
      "index": 6,
      "id": "poke_waza_01_07",
      "hash": "29fdcfac6c574ef6",
      "flags": 0,
      "text": "Welche Attacke soll vergessen werden?"
    },
    {
      "index": 7,
      "id": "poke_waza_01_08",
      "hash": "29fddaac6c5761a7",
      "flags": 0,
      "text": "Das lief ja wie geschmiert!\\c\\nDein Pokémon hat [VAR MOVE(0000)]\\nkomplett vergessen."
    },
    {
      "index": 8,
      "id": "poke_waza_02_01",
      "hash": "547bc9a122ee9513",
      "flags": 0,
      "text": "Mich nennen alle Madame Erinnerung.\\c\\nIch kenne nämlich alle Attacken, die Pokémon\\ndurch Levelaufstieg erlernen können.\\c\\nUnd ich kann dafür sorgen, dass sie sich\\nwieder an sie erinnern!\\c\\nIm Tausch gegen eine Herzschuppe\\nhelfe ich dem Gedächtnis eines Pokémon\\r\\ngern auf die Sprünge!"
    },
    {
      "index": 9,
      "id": "poke_waza_02_02",
      "hash": "547bcaa122ee96c6",
      "flags": 0,
      "text": "Soll sich ein Pokémon im Tausch gegen eine\\n[VAR GERM00(0000)] wieder an eine Attacke erinnern?"
    },
    {
      "index": 10,
      "id": "poke_waza_02_03",
      "hash": "547bcba122ee9879",
      "flags": 0,
      "text": "Komm mit einer [VAR ITEM2(0000)] wieder,\\nwenn ich einem Pokémon bei einer alten\\r\\nAttacke auf die Sprünge helfen soll!"
    },
    {
      "index": 11,
      "id": "poke_waza_02_04",
      "hash": "547bcca122ee9a2c",
      "flags": 0,
      "text": "Welches Pokémon soll sich wieder\\nan eine Attacke erinnern?"
    },
    {
      "index": 12,
      "id": "poke_waza_02_05",
      "hash": "547bcda122ee9bdf",
      "flags": 0,
      "text": "Ähm... Du weißt schon, dass das ein Ei ist...?"
    },
    {
      "index": 13,
      "id": "poke_waza_02_06",
      "hash": "547bcea122ee9d92",
      "flags": 0,
      "text": "Dieses Pokémon kann sich an keine Attacke\\nerinnern, da es noch keine vergessen hat."
    },
    {
      "index": 14,
      "id": "poke_waza_02_07",
      "hash": "547bcfa122ee9f45",
      "flags": 0,
      "text": "An welche Attacke soll es sich erinnern?"
    },
    {
      "index": 15,
      "id": "poke_waza_02_13",
      "hash": "547f4ba122f1a7d0",
      "flags": 0,
      "text": "Du hast als Gegenleistung eine\\n[VAR ITEM2(0000)] abgegeben."
    },
    {
      "index": 16,
      "id": "poke_waza_02_14",
      "hash": "547f52a122f1b3b5",
      "flags": 0,
      "text": "Dein Pokémon hat sich an die Attacke erinnert!\\nKomm jederzeit wieder, wenn du mich brauchst."
    },
    {
      "index": 17,
      "id": "poke_waza_02_15",
      "hash": "547f51a122f1b202",
      "flags": 0,
      "text": "Eins,[WAIT 20] zwei[WAIT 20] und[WAIT 20]... schwupp![VAR SFX(0003)][VAR SFX(0000)]\\c\\n[VAR PKNICK(0000)] hat [VAR MOVE(0001)]\\nvergessen und [VAR MOVE(0002)] erlernt![VAR SFX(0004)][VAR SFX(0001)]"
    },
    {
      "index": 18,
      "id": "poke_waza_02_16",
      "hash": "547f50a122f1b04f",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] erlernt\\n[VAR MOVE(0002)]![VAR SFX(0004)][VAR SFX(0001)]"
    },
