  "lines": [
    {
      "index": 0,
      "id": "msg_main_0460_nresercher_01",
      "hash": "b935a9e59962c99d",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Assistent:[VAR COLOR(0000)] Hallo, [VAR TRNAME(0000)]!"
    },
    {
      "index": 1,
      "id": "msg_main_0460_nresercher_02",
      "hash": "b935a6e59962c484",
      "flags": 0,
      "text": "Erinnerst du dich noch an mich?\\nIch bin’s, Professor Eichs Lieblingsassistent!"
    },
    {
      "index": 2,
      "id": "msg_main_0460_nresercher_03",
      "hash": "b935a7e59962c637",
      "flags": 0,
      "text": "Gut, dass ich dich treffe! Ich will dir was zeigen."
    },
    {
      "index": 3,
      "id": "msg_main_0460_nresercher_04",
      "hash": "b935a4e59962c11e",
      "flags": 0,
      "text": "Aber hier ist es ein bisschen zu hell dafür."
    },
    {
      "index": 4,
      "id": "msg_main_0460_nresercher_05",
      "hash": "b935a5e59962c2d1",
      "flags": 0,
      "text": "Am besten wir gehen dafür kurz ins Haus.\\nIch warte drinnen auf dich, [VAR TRNAME(0000)]."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0460_max",
