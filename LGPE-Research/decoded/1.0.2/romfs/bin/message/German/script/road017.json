    {
      "index": 0,
      "id": "msg_road017_kanban_01",
      "hash": "a226f27247818ecb",
      "flags": 0,
      "text": "Da hängt ein Hinweis...\\c\\n„Halte die Augen offen nach weggeworfenen\\nItems!“"
    },
    {
      "index": 1,
      "id": "msg_road017_kanban_02",
      "hash": "a226f3724781907e",
      "flags": 0,
      "text": "Tipps für Trainer\\c\\nWenn du zwei Pokémon derselben Art mit\\nidentischem Level fängst, unterscheiden sie\\r\\nsich immer geringfügig in ihrem Potenzial.\\c\\nWenn du sie fleißig trainierst, werden diese\\nUnterschiede immer deutlicher."
    },
    {
      "index": 2,
      "id": "msg_road017_kanban_03",
      "hash": "a226f47247819231",
      "flags": 0,
      "text": "[~ 2]"
    },
    {
      "index": 3,
      "id": "msg_road017_kanban_07",
      "hash": "a226f872478198fd",
      "flags": 0,
      "text": "Tipps für Trainer\\c\\nBeim Fangen von Pokémon solltest du stets in\\ndie Mitte des farbigen Rings zielen.\\c\\nJe kleiner dieser Ring ist, desto leichter wird es,\\neinen „guten Wurf“ oder einen „großartigen\\c\\nWurf“ zu erzielen und das Pokémon zu fangen!"
    },
    {
      "index": 4,
      "id": "msg_road017_kanban_04",
      "hash": "a226f572478193e4",
      "flags": 0,
      "text": "Route 17\\nVerbindet Prismania City mit Fuchsania City"
    },
    {
      "index": 5,
      "id": "msg_road017_kanban_05",
      "hash": "a226f67247819597",
      "flags": 0,
      "text": "Da hängt ein Hinweis...\\c\\n„Wirf nicht die Konsole. Wirf lieber Pokébälle!“"
    },
    {
      "index": 6,
      "id": "msg_road017_kanban_06",
      "hash": "a226f7724781974a",
      "flags": 0,
      "text": "Auf diesem Weg laufen Menschen und Pokémon\\nSeite an Seite."
    },
