{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_town005_kanban_01",
      "hash": "e9b56ce052d8e502",
      "flags": 0,
      "text": "Lavandia\\nDie edle, violette Stadt!"
    },
    {
      "index": 1,
      "id": "msg_town005_kanban_02",
      "hash": "e9b56be052d8e34f",
      "flags": 0,
      "text": "Das neue Silph Scope!\\nEnthüllt, was dem bloßen Auge verborgen bleibt!\\c\\n– Silph Company"
    },
    {
      "index": 2,
      "id": "msg_town005_kanban_03",
      "hash": "e9b56ae052d8e19c",
      "flags": 0,
      "text": "Pokémon-Clubhaus\\nEhrenamtliche Arbeit aus Verbundenheit!"
    },
    {
      "index": 3,
      "id": "msg_town005_kanban_04",
      "hash": "e9b569e052d8dfe9",
      "flags": 0,
      "text": "Pokémon-Turm\\nHier ruhen Pokémon in Frieden."
    },
    {
      "index": 4,
      "id": "msg_town005_juveniles_01_01",
      "hash": "dd108a5f7ce63432",
      "flags": 0,
      "text": "Glaubst du an Gespenster?"
    },
    {
      "index": 5,
      "id": "msg_town005_juveniles_01_02",
      "hash": "dd10895f7ce6327f",
      "flags": 0,
      "text": "Hm... Es gibt also Leute, die an sie glauben."
    },
    {
      "index": 6,
      "id": "msg_town005_juveniles_01_03",
      "hash": "dd10885f7ce630cc",
      "flags": 0,
      "text": "Hahaha, natürlich nicht!\\c\\nUnd diese weiße Hand da auf deiner rechten\\nSchulter bilde ich mir nur ein, stimmt’s?"
    },
    {
      "index": 7,
      "id": "msg_town005_adultm_01",
      "hash": "85160d0b0641adba",
      "flags": 0,
      "text": "Diese Stadt ist für ihre Pokémon-Ruhestätte\\nbekannt.\\c\\nTrainer bringen ihre verstorbenen Pokémon in\\nden Pokémon-Turm und gedenken ihrer dort."
    },
    {
      "index": 8,
      "id": "msg_town005_youngm_01",
      "hash": "992c8d4ceabdd3c2",
      "flags": 0,
      "text": "In letzter Zeit sollen im Pokémon-Turm häufig\\nGespenster herumspuken...\\c\\nIch glaube, das hat mit den Pokémon zu tun,\\ndie von Team Rocket entführt wurden.\\c\\nDie sind nämlich nie wieder zurückgekehrt..."
    },
    {
      "index": 9,
      "id": "msg_town005_oldf_01",
      "hash": "2d0312137a06f17c",
      "flags": 0,
      "text": "*Schnüffel, schnüffel...*\\nAh, der Duft von Räucherstäbchen entspannt..."
    },
    {
      "index": 10,
      "id": "msg_town005_poke_01",
      "hash": "575f74472b704770",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Nidoran♀:[VAR COLOR(0000)] Nido!"
    },
    {
      "index": 11,
      "id": "msg_town005_childf_01",
      "hash": "e3b08901e734d73f",
      "flags": 0,
      "text": "Du, weißt du was? Im Pokémon-Turm soll man\\nnicht laut sein und so. Das sagt Mama immer."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_town005_max",
      "hash": "28597b37fbf817c7"
    }
  ]
}
