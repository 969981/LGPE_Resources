    },
    {
      "index": 69,
      "id": "msg_sodateya_girl_18",
      "hash": "59d4bd704e5e8f96",
      "flags": 0,
      "text": "[~ 69]"
    },
    {
      "index": 70,
      "id": "msg_sodateya001",
      "hash": "81b5057d801b3fa2",
      "flags": 0,
      "text": "Willkommen in meiner Pokémon-Pension!\\nWie kann ich dir helfen?"
    },
    {
      "index": 71,
      "id": "msg_sodateya002",
      "hash": "81b5047d801b3def",
      "flags": 0,
      "text": "Willkommen in meiner Pokémon-Pension!\\c\\nHier können Trainer ihre Pokémon in meine\\nObhut geben. Ich kümmere mich um sie und\\r\\nhalte sie fit!\\c\\nAlso, wie kann ich dir helfen?"
    },
    {
      "index": 72,
      "id": "msg_sodateya003",
      "hash": "81b5037d801b3c3c",
      "flags": 0,
      "text": "Verstehe. Vielleicht beim nächsten Mal.\\nAuf Wiedersehen!"
    },
    {
      "index": 73,
      "id": "msg_sodateya004",
      "hash": "81b5027d801b3a89",
      "flags": 0,
      "text": "Wenn ich dieses Pokémon in meine Obhut\\nnehmen würde, hättest du nicht mehr genügend\\r\\nPokémon, um zum Kampf anzutreten.\\c\\nKomm doch einfach wieder, wenn dein Team\\ngrößer ist, ja?"
    },
    {
      "index": 74,
      "id": "msg_sodateya005",
      "hash": "81b5017d801b38d6",
      "flags": 0,
      "text": "Ich kann erst eines deiner Pokémon in meine\\nObhut nehmen, wenn du in deinem Team und\\r\\nin deiner Pokémon-Box insgesamt mindestens\\r\\ndrei Pokémon vorzuweisen hast.\\c\\nWarum fängst du nicht einfach ein paar Pokémon\\nund kommst dann wieder?"
    },
    {
      "index": 75,
      "id": "msg_sodateya006",
      "hash": "81b5007d801b3723",
      "flags": 0,
      "text": "Dann zeig mir doch mal, um welches Pokémon\\nich mich für dich kümmern soll."
    },
    {
      "index": 76,
      "id": "msg_sodateya007",
      "hash": "81b4ff7d801b3570",
      "flags": 0,
      "text": "Hehe, dieses hier macht nicht den Eindruck,\\nals würde es von deiner Seite weichen wollen.\\c\\nEinfach herzerwärmend, wie sehr ihr aneinander\\nhängt!"
    },
    {
      "index": 77,
      "id": "msg_sodateya008",
      "hash": "81b50e7d801b4eed",
      "flags": 0,
      "text": "In Ordnung, ich kümmere mich eine Weile um\\ndein [VAR PKNICK(0000)]."
    },
    {
      "index": 78,
      "id": "msg_sodateya009",
      "hash": "81b50d7d801b4d3a",
      "flags": 0,
      "text": "Komm später einfach wieder, um den kleinen\\nRacker abzuholen."
    },
    {
      "index": 79,
      "id": "msg_sodateya010",
      "hash": "81b1807d801827cc",
      "flags": 0,
      "text": "Ich würde mal sagen, dein [VAR PKNICK(0000)] ist\\num [VAR NUM2(0001)] Level aufgestiegen."
    },
    {
      "index": 80,
      "id": "msg_sodateya011",
      "hash": "81b1817d8018297f",
      "flags": 0,
      "text": "Du willst [VAR PKNICK(0000)] wieder mitnehmen?\\nDas macht dann genau [VAR NUM5(0001,002E)] ₽."
    },
    {
      "index": 81,
      "id": "msg_sodateya012",
      "hash": "81b1827d80182b32",
      "flags": 0,
      "text": "Oje, dir fehlt wohl das nötige Kleingeld."
    },
    {
      "index": 82,
      "id": "msg_sodateya013",
      "hash": "81b1837d80182ce5",
      "flags": 0,
      "text": "Solange dein Team und deine Pokémon-Box\\nvoll sind, kann ich dir leider nicht helfen.\\c\\nSchaff doch einfach bisschen Platz und komm\\ndann wieder, ja?"
    },
    {
      "index": 83,
      "id": "msg_sodateya014",
      "hash": "81b17c7d80182100",
      "flags": 0,
      "text": "Ach ja, das hier hat dein Pokémon offenbar\\nirgendwo gefunden."
    },
    {
      "index": 84,
      "id": "msg_sodateya015",
      "hash": "81b17d7d801822b3",
      "flags": 0,
      "text": "Komm jederzeit wieder, wenn ich mich um eines\\ndeiner Pokémon kümmern soll."
    },
    {
      "index": 85,
      "id": "msg_sodateya016",
      "hash": "81b17e7d80182466",
      "flags": 0,
      "text": "Wenn ich dieses Pokémon in meine Obhut\\nnehmen würde, hättest du nicht mehr genügend\\r\\nPokémon, um zum Kampf anzutreten."
    },
    {
      "index": 86,
      "id": "msg_tokkun001",
      "hash": "264f9dc66325087e",
      "flags": 0,
      "text": "Hallo, [VAR GENDBR(00FF,0A0B,0000)]junger Mannjunge Dame! Ich bin überall als der\\nSuper-Spezial-Opa bekannt.\\c\\nDu fragst dich sicher, warum das so ist, oder?\\nDieses Geheimnis kann ich nur außergewöhnlich\\r\\nguten Pokémon-Trainern verraten.\\c\\nWie man zu einem außergewöhnlich guten\\nPokémon-Trainer wird? Na, indem man sich den\\r\\nTitel des Champs verdient!"
    },
    {
      "index": 87,
      "id": "msg_tokkun002",
      "hash": "264f9cc6632506cb",
      "flags": 0,
      "text": "Oho, steht da etwa ein waschechter Champ\\nvor mir?\\c\\nEinem außergewöhnlich guten Pokémon-Trainer\\nwie dir kann ich mein Geheimnis verraten.\\c\\nMan nennt mich den Super-Spezial-Opa, weil ich\\nPokémon, die Level 100 erreicht haben, dem\\r\\nSuper-Spezialtraining unterziehen kann!\\c\\nUnd im Tausch dafür will ich einfach nur einen\\nKronkorken haben. Ein Schnäppchen, oder?\\c\\nFür einen Silberkronkorken erhöhe ich einen\\nder Statuswerte eines Pokémon auf den\\r\\nMaximalwert.\\c\\nUnd für einen Goldkronkorken erhöhe ich alle\\nStatuswerte eines Pokémon auf den Maximalwert!"
    },
    {
      "index": 88,
      "id": "msg_tokkun003",
      "hash": "264f9bc663250518",
      "flags": 0,
      "text": "Der Super-Spezial-Opa grüßt dich!\\nIst deine[VAR ITEMPLUR1(00FD,0101)]mn Pokémon nach einer Runde Training?"
    },
    {
      "index": 89,
      "id": "msg_tokkun004",
      "hash": "264fa2c6632510fd",
      "flags": 0,
      "text": "Wenn du willst, dass ich dein[VAR ITEMPLUR1(00FD,0100)]e Pokémon\\ntrainiere, musst du mir Kronkorken bringen!"
    },
    {
      "index": 90,
      "id": "msg_tokkun005",
      "hash": "264fa1c663250f4a",
      "flags": 0,
      "text": "Welches deiner Pokémon soll mein besonderes\\nSuper-Spezialtraining absolvieren?"
    },
    {
      "index": 91,
      "id": "msg_tokkun006",
      "hash": "264fa0c663250d97",
      "flags": 0,
      "text": "Ein Pokémon muss Level 100 erreicht haben, um\\nfür mein Super-Spezialtraining bereit zu sein!"
    },
    {
      "index": 92,
      "id": "msg_tokkun007",
      "hash": "264f9fc663250be4",
      "flags": 0,
      "text": "Dieses Pokémon hat mein Super-Spezialtraining\\nnicht mehr nötig."
    },
    {
      "index": 93,
      "id": "msg_tokkun008",
      "hash": "264f96c66324fc99",
      "flags": 0,
      "text": "Auf welchen Statuswert soll ich mich beim\\nSuper-Spezialtraining konzentrieren?"
    },
    {
      "index": 94,
      "id": "msg_tokkun009",
      "hash": "264f95c66324fae6",
      "flags": 0,
      "text": "[VAR EVSTAT(0001)] also?\\c\\nJetzt bekomme ich noch einen Silberkronkorken\\nvon dir und dann kann das Training für dein\\r\\n[VAR PKNICK(0000)] auch schon losgehen.\\c\\nEinverstanden?"
    },
    {
      "index": 95,
      "id": "msg_tokkun010",
      "hash": "264c98c66322ca28",
      "flags": 0,
      "text": "Okay, im Tausch gegen einen Goldkronkorken\\nerhöhe ich mit meinem Super-Spezialtraining\\r\\nalle Statuswerte von [VAR PKNICK(0000)].\\c\\nEinverstanden?"
    },
    {
      "index": 96,
      "id": "msg_tokkun011",
      "hash": "264c99c66322cbdb",
      "flags": 0,
      "text": "Dann nehme ich mir dein [VAR PKNICK(0000)] mal\\nzur Brust. Bereit? Drei, zwei, eins..."
    },
    {
      "index": 97,
      "id": "msg_tokkun012",
      "hash": "264c9ac66322cd8e",
      "flags": 0,
      "text": "SUPER-SPEZIALTRAINING, LET’S GO!\\nUuuuoooooaaaah! Haiiiiiiiyah!!!"
    },
    {
      "index": 98,
      "id": "msg_tokkun013",
      "hash": "264c9bc66322cf41",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] ist durch mein Training\\nsuperstark geworden!"
    },
    {
      "index": 99,
      "id": "msg_tokkun014",
      "hash": "264c9cc66322d0f4",
      "flags": 0,
      "text": "Soll ich weitermachen?"
