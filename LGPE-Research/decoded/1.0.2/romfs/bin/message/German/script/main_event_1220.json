{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main1220_partner_a_01",
      "hash": "4efb61fc06ce0c44",
      "flags": 0,
      "text": "Pika, pika!"
    },
    {
      "index": 1,
      "id": "msg_main1220_partner_b_01",
      "hash": "f89599f46b644f3b",
      "flags": 0,
      "text": "Voli!"
    },
    {
      "index": 2,
      "id": "msg_main1220_young_f_01",
      "hash": "b718baf58baac5e5",
      "flags": 0,
      "text": "Oh, [VAR POKNAME(0002)]!"
    },
    {
      "index": 3,
      "id": "msg_main1220_young_f_02",
      "hash": "b718b7f58baac0cc",
      "flags": 0,
      "text": "Interessiert dich, was ich hier mache?"
    },
    {
      "index": 4,
      "id": "msg_main1220_young_f_03",
      "hash": "b718b8f58baac27f",
      "flags": 0,
      "text": "Ich pflücke Blumen!\\c\\nSpäter werde ich sie zu einem hübschen Strauß\\nbinden und einem Menschen schenken, der mir\\r\\nsehr wichtig ist."
    },
    {
      "index": 5,
      "id": "msg_main1220_young_f_04",
      "hash": "b718b5f58baabd66",
      "flags": 0,
      "text": "D-Das ist aber ein Geheimnis...\\nBehalte es bitte für dich!"
    },
    {
      "index": 6,
      "id": "msg_main1220_young_f_05",
      "hash": "b718b6f58baabf19",
      "flags": 0,
      "text": "H-Hast du schon das Neuste gehört?!\\nDer Arenaleiter von Vertania City ist wieder da!\\c\\nDas freut dich doch bestimmt, oder? Du solltest\\ngleich mal in der Arena vorbeischauen...\\c\\nN-Na los, ab mit dir!"
    },
    {
      "index": 7,
      "id": "msg_main1220_young_f_06",
      "hash": "b718b3f58baaba00",
      "flags": 0,
      "text": "Erzähl bitte niemandem von den Blumen.\\nGanz besonders nicht [VAR TRNAME(0001)]!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_1220_max",
      "hash": "72cc4a06d164628a"
    }
  ]
}
