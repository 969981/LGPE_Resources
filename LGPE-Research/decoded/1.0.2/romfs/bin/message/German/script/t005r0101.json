    {
      "index": 6,
      "id": "msg_book_01_p01_t005_r0101",
      "hash": "687235c0f3f98ae7",
      "flags": 0,
      "text": "Großes Pokémon-Gewinnspiel des\\nMonatsmagazins „Der Pokémon-Freund“!\\c\\nMal sehen... Die Teilnahmekarte...\\c\\nNanu? Sie wurde schon ausgeschnitten!"
    },
    {
