    {
      "index": 0,
      "id": "msg_t005r0101_youngm_01",
      "hash": "5a81f7f43e3646ca",
      "flags": 0,
      "text": "Seltsam! Mr. Fuji ist nicht zu Hause. Wohin mag\\ner gegangen sein?"
    },
    {
      "index": 1,
      "id": "msg_t005r0101_youngm_02",
      "hash": "5a81f6f43e364517",
      "flags": 0,
      "text": "Mr. Fuji war unterwegs, um die Seele von\\nKnogga zu besänftigen."
    },
    {
      "index": 2,
      "id": "msg_t005r0101_juveniles_01",
      "hash": "b3092b7e97f4b1c8",
      "flags": 0,
      "text": "Das hier ist Mr. Fujis Haus. Er ist sehr fürsorglich.\\c\\nEr kümmert sich um ausgesetzte und verwaiste\\nPokémon."
    },
    {
      "index": 3,
      "id": "msg_t005r0101_juveniles_02",
      "hash": "b3092e7e97f4b6e1",
      "flags": 0,
      "text": "Hach, so kuschelig... Pokémon sind so schön\\nwarm, wenn man sie in die Arme nimmt."
    },
    {
      "index": 4,
      "id": "msg_t005r0101_poke_01",
      "hash": "0385607c405e4cb8",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Nidorino:[VAR COLOR(0000)] Nido!"
    },
    {
      "index": 5,
      "id": "msg_t005r0101_poke_02",
      "hash": "0385637c405e51d1",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Enton:[VAR COLOR(0000)] Tooon!"
