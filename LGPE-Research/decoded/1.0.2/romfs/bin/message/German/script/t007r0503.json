    },
    {
      "index": 1,
      "id": "msg_t007r0503_jevenilem_01",
      "hash": "e4384f0ab442ee86",
      "flags": 0,
      "text": "Cool!\\c\\nMein Kumpel tauscht sein Kangama gegen mein\\nAlpollo!"
    },
    {
      "index": 2,
      "id": "msg_t007r0503_jevenilem_02",
      "hash": "e4384e0ab442ecd3",
      "flags": 0,
      "text": "Ich kann’s kaum erwarten...! Komm zu mir, mein\\nkleines Alpollo!\\c\\nIch bin Alpollo-Sammler, weißt du? Deshalb will\\nich unbed-- Huch?\\c\\nDas Alpollo hat sich beim Tausch zu einem\\nanderen Pokémon entwickelt!"
    },
    {
      "index": 3,
      "id": "msg_t007r0503_chilef_01",
      "hash": "97b8808b2d55e818",
      "flags": 0,
      "text": "Alle Pokémon, die du dir selber gefangen hast,\\nhaben ein und dieselbe ID-Nummer.\\c\\nPokémon mit einer anderen ID-Nummer hast\\ndu also ziemlich sicher per Tausch bekommen."
    },
    {
      "index": 4,
      "id": "msg_t007r0503_game_01",
      "hash": "92d1753fbd58e1f1",
      "flags": 0,
      "text": "Das ist eine Nintendo Switch-Konsole!"
    },
    {
      "index": 5,
      "id": "msg_t007r0503_game_02",
      "hash": "92d1723fbd58dcd8",
      "flags": 0,
      "text": "Ein Rollenspiel!\\nAber du hast leider keine Zeit zum Spielen..."
    },
    {
      "index": 6,
      "id": "msg_t007r0503_game_03",
      "hash": "92d1733fbd58de8b",
      "flags": 0,
      "text": "Ein Sportspiel!\\nDas würde Papa sicher gefallen."
    },
    {
      "index": 7,
      "id": "msg_t007r0503_game_04",
      "hash": "92d1783fbd58e70a",
      "flags": 0,
      "text": "Ein Puzzlespiel!\\nDas ist bestimmt fesselnd."
    },
    {
      "index": 8,
      "id": "msg_t007r0503_game_05",
      "hash": "92d1793fbd58e8bd",
      "flags": 0,
      "text": "Ein Kampfspiel!\\nSieht ziemlich anspruchsvoll aus."
    },
    {
      "index": 9,
      "id": "msg_t007r0503_kanban_01",
      "hash": "fa4116cb02ff9bc2",
      "flags": 0,
      "text": "2. OG: Videospiele"
    },
    {
      "index": 10,
      "id": "msg_t007r0503_poster_01",
      "hash": "ae05700f9e7f81a4",
      "flags": 0,
      "text": "Pikachu und Evoli!\\nDie beiden sind wahre Pokémon-Stars!"
    }
  ],
