  "lines": [
    {
      "index": 0,
      "id": "msg_sub017_partner_a_01",
      "hash": "93b1be4a1a433c4e",
      "flags": 0,
      "text": "Piiikachu!"
    },
    {
      "index": 1,
      "id": "msg_sub017_partner_b_01",
      "hash": "9828fe60ed950d41",
      "flags": 0,
      "text": "Voli, voli?"
    },
    {
      "index": 2,
      "id": "msg_sub017_system_01",
      "hash": "6b07f1203d3850e3",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] starrt neugierig den\\nGetränkeautomaten an."
    },
    {
      "index": 3,
      "id": "msg_sub017_system_02",
      "hash": "6b07f2203d385296",
      "flags": 0,
      "text": "Möchtest du ihm ein Getränk kaufen?"
    },
    {
      "index": 4,
      "id": "msg_sub017_select_01",
      "hash": "47853b7097ab1b90",
      "flags": 0,
      "text": "Tafelwasser [VAR SYMBOL(0000)][VAR NUM3(0001)] ₽"
    },
    {
      "index": 5,
      "id": "msg_sub017_select_02",
      "hash": "47853e7097ab20a9",
      "flags": 0,
      "text": "Sprudel [VAR SYMBOL(0000)][VAR NUM3(0001)] ₽"
    },
    {
      "index": 6,
      "id": "msg_sub028_select_03",
      "hash": "9918769606bfc6b8",
      "flags": 0,
      "text": "Limonade [VAR SYMBOL(0000)][VAR NUM3(0001)] ₽"
    },
    {
      "index": 7,
      "id": "msg_sub028_select_04",
      "hash": "99187d9606bfd29d",
      "flags": 0,
      "text": "Abbrechen"
    },
    {
      "index": 8,
      "id": "msg_sub017_system_03",
      "hash": "6b07f3203d385449",
      "flags": 0,
      "text": "Du hast nicht genügend Geld.\\c\\nVerzweifelt durchwühlst du deinen Beutel...\\c\\nWas für ein Glück! Im hintersten Winkel einer\\ndeiner Taschen findest du 500 ₽!"
    },
    {
      "index": 9,
      "id": "msg_sub017_system_04",
      "hash": "6b07f4203d3855fc",
      "flags": 0,
      "text": "Du gibst [VAR PKNICK(0003)] [VAR VARGER01(0002)]\\n[VAR GERM01(0002)]."
    },
    {
      "index": 10,
      "id": "msg_sub017_partner_a_02",
      "hash": "93b1bd4a1a433a9b",
      "flags": 0,
      "text": "Pika!"
    },
    {
      "index": 11,
      "id": "msg_sub017_partner_b_02",
      "hash": "9828fb60ed950828",
      "flags": 0,
      "text": "Voli!"
    },
    {
      "index": 12,
      "id": "msg_sub017_system_05",
      "hash": "6b07f5203d3857af",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] scheint das Tafelwasser sehr zu\\nschmecken!"
    },
    {
      "index": 13,
      "id": "msg_sub017_system_06",
      "hash": "6b07f6203d385962",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] scheint davon überrascht zu\\nsein, wie sehr der Sprudel zischt!"
    },
    {
      "index": 14,
      "id": "msg_sub017_system_07",
      "hash": "6b07f7203d385b15",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] scheint vom milden Geschmack\\nder Limonade hingerissen zu sein!"
    },
    {
      "index": 15,
      "id": "msg_sub017_system_08",
      "hash": "6b07f8203d385cc8",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] sieht etwas enttäuscht aus..."
    },
    {
