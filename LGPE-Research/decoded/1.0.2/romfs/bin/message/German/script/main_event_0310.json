{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0310_rocketm_01",
      "hash": "d0bf455f5b512f68",
      "flags": 0,
      "text": "Herzlichen Glückwunsch! Du hast alle fünf\\nTrainer besiegt.\\c\\nHier, dieser großartige Preis ist für dich!"
    },
    {
      "index": 1,
      "id": "msg_main0310_sys_01",
      "hash": "fda0b6542407ea06",
      "flags": 0,
      "text": "Du erhältst ein Nugget von einem dubiosen\\nTrainer!"
    },
    {
      "index": 2,
      "id": "msg_main0310_rocketm_02",
      "hash": "d0bf485f5b513481",
      "flags": 0,
      "text": "Übrigens... Und das bleibt unter uns...\\c\\nMöchtest du nicht Team Rocket beitreten?"
    },
    {
      "index": 3,
      "id": "msg_main0310_rocketm_04",
      "hash": "d0bf4a5f5b5137e7",
      "flags": 0,
      "text": "Und schwupp...!"
    },
    {
      "index": 4,
      "id": "msg_main0310_rocketm_05",
      "hash": "d0bf495f5b513634",
      "flags": 0,
      "text": "Wir von Team Rocket benutzen Pokémon dazu,\\nunsere finsteren Pläne zu verwirklichen!"
    },
    {
      "index": 5,
      "id": "msg_main0310_rocketm_06",
      "hash": "d0bf4c5f5b513b4d",
      "flags": 0,
      "text": "Bist du dabei?"
    },
    {
      "index": 6,
      "id": "msg_main0310_rocketm_07",
      "hash": "d0bf4b5f5b51399a",
      "flags": 0,
      "text": "Du bist dabei, oder?"
    },
    {
      "index": 7,
      "id": "msg_main0310_rocketm_08",
      "hash": "d0bf3e5f5b512383",
      "flags": 0,
      "text": "Jetzt mach schon mit!"
    },
    {
      "index": 8,
      "id": "msg_main0310_rocketm_09",
      "hash": "d0bf3d5f5b5121d0",
      "flags": 0,
      "text": "Mach mit, hab ich gesagt!!"
    },
    {
      "index": 9,
      "id": "msg_main0310_rocketm_10",
      "hash": "d0bbc05f5b4e1792",
      "flags": 0,
      "text": "Seltsam, du siehst aus, als wolltest du dieses\\ngroßartige Angebot ausschlagen."
    },
    {
      "index": 10,
      "id": "msg_main0310_rocketm_11",
      "hash": "d0bbc15f5b4e1945",
      "flags": 0,
      "text": "Tja, dann muss ich wohl ein wenig mehr\\nÜberzeugungsarbeit leisten!"
    },
    {
      "index": 11,
      "id": "msg_main0150_dummy_01",
      "hash": "ff67b6d57bb9318b",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_main0310_rocketm_03",
      "hash": "d0bf475f5b5132ce",
      "flags": 0,
      "text": "Mit deinem Können hättest du eine glänzende\\nKarriere bei Team Rocket vor dir.\\c\\nWelch eine Verschwendung von Talent..."
    },
    {
      "index": 13,
      "id": "msg_main0310_rocketm_12",
      "hash": "d0bbbe5f5b4e142c",
      "flags": 0,
      "text": "Herzlichen Glückwunsch! Du hast alle fünf\\nTrainer besiegt."
    }
  ],
