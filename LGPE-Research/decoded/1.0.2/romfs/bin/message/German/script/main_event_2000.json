{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main2000_rival_01",
      "hash": "4568f4f74cfce003",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Hallo, ich bin’s!\\nSchätze mal, [VAR GENDBR(00FF,0302,0000)]ersie ist noch oben, oder?\\c\\nDanke!"
    },
    {
      "index": 1,
      "id": "msg_main2000_rival_02",
      "hash": "4568f5f74cfce1b6",
      "flags": 0,
      "text": "Hey, [VAR TRNAME(0000)]!\\nIch komm mal hoch, ja?"
    },
    {
      "index": 2,
      "id": "msg_main2000_rival_03",
      "hash": "4568f6f74cfce369",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Morgen, Champ von Kanto!\\c\\nNa? Gefällt’s dir, so angesprochen zu werden?"
    },
    {
      "index": 3,
      "id": "msg_main2000_rival_09",
      "hash": "4568fcf74cfced9b",
      "flags": 0,
      "text": "Gewöhn dich besser nicht allzu sehr an den Titel.\\c\\nWenn ich erst mal in Fahrt gekommen bin,\\ngehört der ruckzuck mir!"
    },
    {
      "index": 4,
      "id": "msg_main2000_rival_04",
      "hash": "4568f7f74cfce51c",
      "flags": 0,
      "text": "Aber das ist erst mal egal. Hast du auch schon\\nvon diesem superstarken Pokémon gehört?"
    },
    {
      "index": 5,
      "id": "msg_main2000_sel_01",
      "hash": "8b65dee0045ddfb3",
      "flags": 0,
      "text": "Superstark? Wie stark denn?"
    },
    {
      "index": 6,
      "id": "msg_main2000_sel_02",
      "hash": "8b65dfe0045de166",
      "flags": 0,
      "text": "Superstark? Muss ich haben!"
    },
    {
      "index": 7,
      "id": "msg_main2000_rival_05",
      "hash": "4568f8f74cfce6cf",
      "flags": 0,
      "text": "Keine Ahnung, stark eben! Und megacool\\naussehen soll es auch!"
    },
    {
      "index": 8,
      "id": "msg_main2000_rival_06",
      "hash": "4568f9f74cfce882",
      "flags": 0,
      "text": "Haha! Ich wusste doch, dass dich das reizen\\nwürde!"
    },
    {
      "index": 9,
      "id": "msg_main2000_rival_07",
      "hash": "4568faf74cfcea35",
      "flags": 0,
      "text": "Das Pokémon wurde in der Nähe von [VAR COLOR(0006)]Azuria City[VAR COLOR(0000)]\\ngesichtet."
    },
    {
      "index": 10,
      "id": "msg_main2000_rival_10",
      "hash": "456bf9f74cff1e59",
      "flags": 0,
      "text": "Angeblich hat es sich dort in irgendeiner Höhle\\nversteckt."
    },
    {
      "index": 11,
      "id": "msg_main2000_rival_08",
      "hash": "4568fbf74cfcebe8",
      "flags": 0,
      "text": "Was sagst du, gehen wir es suchen?"
    },
    {
      "index": 12,
      "id": "msg_main2000_rival_11",
      "hash": "456bf8f74cff1ca6",
      "flags": 0,
      "text": "Wer es zuerst fängt, gewinnt!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_2000_max",
      "hash": "9104968fcbd7dad1"
    }
  ]
}
