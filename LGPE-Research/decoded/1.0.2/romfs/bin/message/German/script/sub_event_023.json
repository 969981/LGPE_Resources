{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub023_karate_01_01",
      "hash": "eaf8a55e83471389",
      "flags": 0,
      "text": "Willkommen im Kampf-Dojo.\\c\\nIch bin der Karate-Meister und zuständig für die\\nAusbildung der Schüler, haiyaaah!"
    },
    {
      "index": 1,
      "id": "msg_sub023_karate_01_09",
      "hash": "eaf8ad5e83472121",
      "flags": 0,
      "text": "Wenn du nach einer Herausforderung für Körper\\nund Geist suchst, bist du hier an der richtigen\\r\\nAdresse!\\c\\nDu kannst dir sicher sein, dass ich mich unter\\nkeinen Umständen zurückhalte."
    },
    {
      "index": 2,
      "id": "msg_sub023_karate_01_10",
      "hash": "eafc2a5e834a2b5f",
      "flags": 0,
      "text": "Haiyaaah!"
    },
    {
      "index": 3,
      "id": "msg_sub023_karate_01_02",
      "hash": "eaf8a25e83470e70",
      "flags": 0,
      "text": "Ich bin dir eindeutig unterlegen..."
    },
    {
      "index": 4,
      "id": "msg_sub023_karate_01_07",
      "hash": "eaf8a75e834716ef",
      "flags": 0,
      "text": "Doch ich flehe dich an, das Emblem unseres\\nKampf-Dojos nicht als Trophäe mitzunehmen!"
    },
    {
      "index": 5,
      "id": "msg_sub023_karate_01_08",
      "hash": "eaf8ac5e83471f6e",
      "flags": 0,
      "text": "Stattdessen biete ich dir eines meiner\\nwertvollen Kampf-Pokémon an."
    },
    {
      "index": 6,
      "id": "msg_sub023_karate_01_06",
      "hash": "eaf8a65e8347153c",
      "flags": 0,
      "text": "Bitte! Du darfst auch völlig frei wählen!"
    },
    {
      "index": 7,
      "id": "msg_sub023_karate_01_03",
      "hash": "eaf8a35e83471023",
      "flags": 0,
      "text": "Warum bleibst du nicht eine Weile hier und\\ntrainierst Karate mit uns?"
    },
    {
      "index": 8,
      "id": "msg_sub023_karate_01_04",
      "hash": "eaf8a85e834718a2",
      "flags": 0,
      "text": "Haiyaaah! Du entscheidest dich für Kicklee,\\ndas trittstarke Pokémon?"
    },
    {
      "index": 9,
      "id": "msg_sub023_sys_01_01",
      "hash": "384f6f255b68c6d4",
      "flags": 0,
      "text": "Du erhältst [VAR POKNAME(0004)] vom Karate-Meister!"
    },
    {
      "index": 10,
      "id": "msg_sub023_karate_01_05",
      "hash": "eaf8a95e83471a55",
      "flags": 0,
      "text": "Haiyaaah! Du entscheidest dich für Nockchan,\\nden Meister des Boxkampfs?"
    },
    {
      "index": 11,
      "id": "msg_sub023_sys_01_02",
      "hash": "384f72255b68cbed",
      "flags": 0,
      "text": "Jetzt nur nicht gierig werden..."
    },
    {
      "index": 12,
      "id": "msg_sub023_poke_01_01",
      "hash": "1c43cc5dba1082f6",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Kicklee: [VAR COLOR(0000)]Kiiick!"
    },
    {
      "index": 13,
      "id": "msg_sub023_poke_02_01",
      "hash": "4b19cc75c761fea9",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Nockchan: [VAR COLOR(0000)]Nooock!"
    }
  ],
