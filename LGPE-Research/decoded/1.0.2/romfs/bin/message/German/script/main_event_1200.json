{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main1200_rival_01",
      "hash": "723f186098a8ef50",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Verschlossen, wie gedacht...\\nAber warum?"
    },
    {
      "index": 1,
      "id": "msg_main1200_rival_02",
      "hash": "723f1b6098a8f469",
      "flags": 0,
      "text": "Sesam, öffne dich!"
    },
    {
      "index": 2,
      "id": "msg_main1200_rival_03",
      "hash": "723f1a6098a8f2b6",
      "flags": 0,
      "text": "So wird das nichts..."
    },
    {
      "index": 3,
      "id": "msg_main1200_rival_04",
      "hash": "723f1d6098a8f7cf",
      "flags": 0,
      "text": "Huch..."
    },
    {
      "index": 4,
      "id": "msg_main1200_rival_05",
      "hash": "723f1c6098a8f61c",
      "flags": 0,
      "text": "Hey, [VAR TRNAME(0000)]!\\nSag doch was, anstatt mir dabei zuzusehen,\\r\\nwie ich mich hier zum Hampelmann mache!"
    },
    {
      "index": 5,
      "id": "msg_main1200_rival_06",
      "hash": "723f1f6098a8fb35",
      "flags": 0,
      "text": "Aber ist ja auch nicht so wichtig...\\c\\nVerrat mir lieber, wie viele Orden du dir schon\\nerkämpft hast."
    },
    {
      "index": 6,
      "id": "msg_main1200_rival_10",
      "hash": "723bb36098a60dda",
      "flags": 0,
      "text": "Sieben?! Damit liegen wir ja Kopf an Kopf!\\c\\nFehlt bloß noch die Arena von Vertania City,\\naber aus irgendeinem Grund ist sie nie offen..."
    },
    {
      "index": 7,
      "id": "msg_main1200_rival_07",
      "hash": "723f1e6098a8f982",
      "flags": 0,
      "text": "Wir müssen jemanden finden, der uns sagen\\nkann, warum wir nicht in die Arena kommen.\\c\\nFällt dir jemand ein, der uns helfen könnte?"
    },
    {
      "index": 8,
      "id": "msg_main1200_select_01",
      "hash": "4847a94b196d6768",
      "flags": 0,
      "text": "Professor Eich!"
    },
    {
      "index": 9,
      "id": "msg_main1200_select_02",
      "hash": "4847ac4b196d6c81",
      "flags": 0,
      "text": "[VAR POKNAME(0003)]!"
    },
    {
      "index": 10,
      "id": "msg_main1200_select_03",
      "hash": "4847ab4b196d6ace",
      "flags": 0,
      "text": "Der alte Mann da!"
    },
    {
      "index": 11,
      "id": "msg_main1200_oldman_01",
      "hash": "c70dc56b184a5299",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Alter Mann:[VAR COLOR(0000)] Wie bitte? Ich weiß von gar nichts!"
    },
    {
      "index": 12,
      "id": "msg_main1200_rival_11",
      "hash": "723bb46098a60f8d",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] N-Natürlich nicht, sorry!\\c\\nDas müssen wir uns noch mal durch den Kopf\\ngehen lassen."
    },
    {
      "index": 13,
      "id": "msg_main1200_rival_08",
      "hash": "723f216098a8fe9b",
      "flags": 0,
      "text": "Natürlich, wer sonst! Na los, machen wir uns auf\\ndie Socken!"
    },
    {
      "index": 14,
      "id": "msg_main1200_poke_01",
      "hash": "463c8e1cd61b3757",
      "flags": 0,
      "text": "Pika, pika!"
    },
    {
      "index": 15,
      "id": "msg_main1200_poke_02",
      "hash": "463c8f1cd61b390a",
      "flags": 0,
      "text": "Voli!"
    },
    {
      "index": 16,
      "id": "msg_main1200_rival_09",
      "hash": "723f206098a8fce8",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Aha, meinst du? Okay...\\c\\nIch hab kein Wort verstanden."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_1200_max",
      "hash": "b01f702cfacb0504"
