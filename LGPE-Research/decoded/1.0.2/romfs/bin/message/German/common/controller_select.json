{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "cnt_select_win_01",
      "hash": "209514ec56c75baa",
      "flags": 0,
      "text": "Bitte drücke einen Knopf auf dem Controller,\\nden du benutzen möchtest."
    },
    {
      "index": 1,
      "id": "cnt_select_win_02",
      "hash": "209513ec56c759f7",
      "flags": 0,
      "text": "Möchtest du diesen Controller benutzen?"
    },
    {
      "index": 2,
      "id": "cnt_select_win_03",
      "hash": "209512ec56c75844",
      "flags": 0,
      "text": "Die Knopfbelegung wurde geändert."
    },
    {
      "index": 3,
      "id": "cnt_select_win_04",
      "hash": "209511ec56c75691",
      "flags": 0,
      "text": "Du kannst den Pokéball Plus nicht benutzen,\\nwenn du den Einrichtungsvorgang jetzt abbrichst.\\r\\nDennoch abbrechen?"
    },
    {
      "index": 4,
      "id": "cnt_select_win_05",
      "hash": "209510ec56c754de",
      "flags": 0,
      "text": "Der Einrichtungsvorgang wurde abgeschlossen."
    },
    {
      "index": 5,
      "id": "cnt_select_win_06",
      "hash": "20950fec56c7532b",
      "flags": 0,
      "text": "Die Vorbereitungen laufen...\\nBitte das System nicht ausschalten."
    },
    {
      "index": 6,
      "id": "cnt_select_win_07",
      "hash": "20950eec56c75178",
      "flags": 0,
      "text": "Ein Fehler ist aufgetreten.\\n\\nBitte führe alle Schritte noch einmal durch."
    },
    {
      "index": 7,
      "id": "cnt_select_win_08",
      "hash": "20950dec56c74fc5",
      "flags": 0,
      "text": "Dein Pokéball Plus enthält ein Pokémon als\\nGeschenk.\\n\\nWähle im Spielmenü erst „Kommunikation“ und\\nanschließend „Geheimgeschenk“ aus, um dein\\nGeschenk im Spiel abzuholen."
    },
    {
      "index": 8,
      "id": "cnt_select_win_09",
      "hash": "20950cec56c74e12",
      "flags": 0,
      "text": "Bitte wähle den Controller aus, den der zweite\\nSpieler benutzen soll."
    },
    {
      "index": 9,
      "id": "cnt_select_win_10",
      "hash": "20918fec56c443d4",
      "flags": 0,
      "text": "Möchtest du die Knopfbelegung des\\nPokéball Plus ändern?"
    },
    {
      "index": 10,
      "id": "cnt_select_win_11",
      "hash": "209190ec56c44587",
      "flags": 0,
      "text": "Bitte wähle den Controller aus, den der erste\\nSpieler benutzen soll."
    },
    {
      "index": 11,
      "id": "cnt_select_win_12",
      "hash": "209191ec56c4473a",
      "flags": 0,
      "text": "Datenübertragung wird ausgeführt..."
    },
    {
      "index": 12,
      "id": "cnt_select_info_01",
      "hash": "b671815c01514bc8",
      "flags": 0,
      "text": "Wenn du einen Pokéball Plus als Controller\\nverwendest, kannst du das Spielmenü öffnen,\\nindem du den oberen Knopf drückst."
    },
    {
      "index": 13,
      "id": "cnt_select_info_02",
      "hash": "b671845c015150e1",
      "flags": 0,
      "text": "Schüttele im Spielmenü zwei Mal den\\nPokéball Plus, um in die Einstellungen\\nzu gelangen."
    },
    {
      "index": 14,
      "id": "cnt_select_info_03",
      "hash": "b671835c01514f2e",
      "flags": 0,
      "text": "Wenn du den rechten Joy-Con als Controller\\nverwendest, kannst du das Spielmenü öffnen,\\nindem du den X-Knopf drückst."
    },
    {
      "index": 15,
      "id": "cnt_select_info_04",
      "hash": "b671865c01515447",
      "flags": 0,
      "text": "Wenn du den rechten Joy-Con als Controller\\nverwendest, kannst du deine Auswahl wie folgt\\nbestätigen:\\n\\n・ Stick drücken\\n・ R-Taste drücken\\n・ ZR-Taste drücken"
    },
    {
      "index": 16,
      "id": "cnt_select_info_05",
      "hash": "b671855c01515294",
      "flags": 0,
      "text": "Wenn du den linken Joy-Con als Controller\\nverwendest, kannst du das Spielmenü mit dem\\nAufwärts-Knopf öffnen."
    },
    {
      "index": 17,
      "id": "cnt_select_info_06",
      "hash": "b671885c015157ad",
      "flags": 0,
      "text": "Wenn du den linken Joy-Con als Controller\\nverwendest, kannst du deine Auswahl wie folgt\\nbestätigen:\\n\\n・ Stick drücken\\n・ L-Taste drücken\\n・ ZL-Taste drücken"
    },
    {
      "index": 18,
      "id": "cnt_select_info_07",
      "hash": "b671875c015155fa",
      "flags": 0,
      "text": "Wenn du im Handheld-Modus spielst, kannst du\\ndas Spielmenü mit dem X-Knopf öffnen."
    },
    {
      "index": 19,
      "id": "cnt_select_info_08",
      "hash": "b6717a5c01513fe3",
      "flags": 0,
      "text": "Im Handheld-Modus kannst du deine Auswahl\\nauch bestätigen, indem du auf den rechten Stick\\ndrückst.\\n\\nDen Touchscreen kannst du nur in bestimmten\\nFällen zum Bestätigen deiner Auswahl benutzen."
    },
    {
      "index": 20,
      "id": "cnt_select_sel_01",
      "hash": "b34042664de9fcd8",
      "flags": 0,
      "text": "Ja"
    },
