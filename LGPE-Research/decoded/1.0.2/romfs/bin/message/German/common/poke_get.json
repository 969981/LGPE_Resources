      "hash": "3a06eefb470cba20",
      "flags": 0,
      "text": "[VAR POKNAME(0000)] aus dem GO Park erscheint!"
    },
    {
      "index": 1,
      "id": "poke_get_01_01",
      "hash": "3a06effb470cbbd3",
      "flags": 0,
      "text": "Ein wildes [VAR POKNAME(0000)] erscheint!"
    },
    {
      "index": 2,
      "id": "poke_get_01_02",
      "hash": "3a06f0fb470cbd86",
      "flags": 0,
      "text": "Das ist deine Chance, das wilde\\n[VAR POKNAME(0000)] zu fangen!"
    },
    {
      "index": 3,
      "id": "poke_get_01_03",
      "hash": "3a06f1fb470cbf39",
      "flags": 0,
      "text": "Das ist deine Chance,\\n[VAR POKNAME(0000)] zu fangen!"
    },
    {
      "index": 4,
      "id": "poke_get_01_04",
      "hash": "3a06f2fb470cc0ec",
      "flags": 0,
      "text": "Willst du es aufgeben, das Pokémon zu fangen?"
    },
    {
      "index": 5,
      "id": "poke_get_01_05",
      "hash": "3a06f3fb470cc29f",
      "flags": 0,
      "text": "Willst du die Anleitung zum Werfen von\\nPokébällen verlassen?"
    },
    {
      "index": 6,
      "id": "poke_get_01_06",
      "hash": "3a06f4fb470cc452",
      "flags": 0,
      "text": "Du hast keinen Platz für weitere Pokémon.\\nDir bleibt keine Wahl, als dich zurückzuziehen..."
    },
    {
      "index": 7,
      "id": "poke_get_01_07",
      "hash": "3a06f5fb470cc605",
      "flags": 0,
      "text": "Du hast keine Pokébälle mehr.\\nDir bleibt keine Wahl, als dich zurückzuziehen..."
    },
    {
      "index": 8,
      "id": "poke_get_01_08",
      "hash": "3a06f6fb470cc7b8",
      "flags": 0,
      "text": "Mist! Das Pokémon hat sich befreit!"
    },
    {
      "index": 9,
      "id": "poke_get_01_09",
      "hash": "3a06f7fb470cc96b",
      "flags": 0,
      "text": "Oh! Fast hätte es geklappt!"
    },
    {
      "index": 10,
      "id": "poke_get_01_10",
      "hash": "3a0a74fb470fd3a9",
      "flags": 0,
      "text": "Mist! Das war knapp!"
    },
    {
      "index": 11,
      "id": "poke_get_01_11",
      "hash": "3a0a73fb470fd1f6",
      "flags": 0,
      "text": "Verflixt! Es hätte beinahe geklappt!"
    },
    {
      "index": 12,
      "id": "poke_get_01_12",
      "hash": "3a0a72fb470fd043",
      "flags": 0,
      "text": "Klasse! [VAR POKNAME(0000)] wurde gefangen!"
    },
    {
      "index": 13,
      "id": "poke_get_01_13",
      "hash": "3a0a71fb470fce90",
      "flags": 0,
      "text": "[VAR POKNAME(0000)] ergreift die Flucht!"
    },
    {
      "index": 14,
      "id": "poke_get_01_14",
      "hash": "3a0a78fb470fda75",
      "flags": 0,
      "text": "Du bist entkommen!"
    },
    {
      "index": 15,
      "id": "poke_get_01_15",
      "hash": "3a0a77fb470fd8c2",
      "flags": 0,
      "text": "Ein [VAR SUPPORT(0000)] kommt dir plötzlich zu Hilfe!"
    },
