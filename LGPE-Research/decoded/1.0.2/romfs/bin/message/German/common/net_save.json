{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "net_save_win_01",
      "hash": "eeefe4d96acc1c25",
      "flags": 0,
      "text": "Speichervorgang...\\nBitte warte einen Moment."
    },
    {
      "index": 1,
      "id": "net_save_win_02",
      "hash": "eeefe1d96acc170c",
      "flags": 0,
      "text": "Achtung!\\n\\nKommt es bei der Abwicklung eines Tausches\\nzu einem Verbindungsfehler oder wird das\\nSystem ausgeschaltet, kannst du für kurze Zeit\\nkeine Pokémon mehr tauschen."
    },
    {
      "index": 2,
      "id": "net_save_win_03",
      "hash": "eeefe2d96acc18bf",
      "flags": 0,
      "text": "Verbindung wird hergestellt...\\nBitte warte einen Moment."
    },
    {
      "index": 3,
      "id": "net_save_win_04",
      "hash": "eeefdfd96acc13a6",
      "flags": 0,
      "text": "Soll die Verbindung getrennt werden?"
    },
    {
      "index": 4,
      "id": "net_save_sel_01",
      "hash": "0bb15cc36812039f",
      "flags": 0,
      "text": "Ja"
    },
    {
      "index": 5,
      "id": "net_save_sel_02",
      "hash": "0bb15dc368120552",
      "flags": 0,
      "text": "Nein"
    },
    {
      "index": 6,
      "id": "net_save_sel_03",
      "hash": "0bb15ec368120705",
      "flags": 0,
      "text": "Abbrechen"
    },
    {
      "index": 7,
      "id": "net_save_win_05",
      "hash": "eeefe0d96acc1559",
      "flags": 0,
      "text": "Ein Teilnehmer hat die Verbindung getrennt.\\nDer Tausch wird beendet."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_net_save_max",
