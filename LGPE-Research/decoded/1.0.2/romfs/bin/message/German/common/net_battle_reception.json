{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_b_nbr_win_01",
      "hash": "91a262d8ccb53c27",
      "flags": 0,
      "text": "Diese Spieler werden an einem Einzelkampf\\nteilnehmen."
    },
    {
      "index": 1,
      "id": "msg_b_nbr_win_02",
      "hash": "91a263d8ccb53dda",
      "flags": 0,
      "text": "Diese Spieler werden an einem Doppelkampf\\nteilnehmen."
    },
    {
      "index": 2,
      "id": "msg_b_nbr_win_03",
      "hash": "91a264d8ccb53f8d",
      "flags": 0,
      "text": "[~ 2]"
    },
    {
      "index": 3,
      "id": "msg_b_nbr_win_04",
      "hash": "91a25dd8ccb533a8",
      "flags": 0,
      "text": "Bitte lege die Kampfregeln fest."
    },
    {
      "index": 4,
      "id": "msg_b_nbr_win_05",
      "hash": "91a25ed8ccb5355b",
      "flags": 0,
      "text": "Der Kampf wird ohne Einschränkungen\\nausgetragen. Möchtest du fortfahren?"
    },
    {
      "index": 5,
      "id": "msg_b_nbr_win_06",
      "hash": "91a25fd8ccb5370e",
      "flags": 0,
      "text": "Der Kampf wird mit normalen Regeln\\nausgetragen. Möchtest du fortfahren?"
    },
    {
      "index": 6,
      "id": "msg_b_nbr_win_07",
      "hash": "91a260d8ccb538c1",
      "flags": 0,
      "text": "Bei Kämpfen ohne Einschränkungen werden an\\ndeinem Team keine Änderungen vorgenommen.\\n\\nDiese Einstellung empfiehlt sich, wenn deine\\nSpielzeit mit der des Gegners vergleichbar ist."
    },
    {
      "index": 7,
      "id": "msg_b_nbr_win_08",
      "hash": "91a259d8ccb52cdc",
      "flags": 0,
      "text": "Bei Kämpfen mit normalen Regeln werden alle\\nPokémon auf Level 50 gesetzt.\\n\\nErhöhte Statuswerte werden ebenfalls auf den\\ngleichen Wert gesetzt.\\n\\nDiese Einstellung empfiehlt sich, wenn deine\\nSpielzeit stark von der des Gegners abweicht."
    },
    {
      "index": 8,
      "id": "msg_b_nbr_win_09",
      "hash": "91a25ad8ccb52e8f",
      "flags": 0,
      "text": "Bitte wähle, mit welchen Pokémon du zum Kampf\\nantreten willst."
    },
    {
      "index": 9,
      "id": "msg_b_nbr_win_10",
      "hash": "91a567d8ccb77a7d",
      "flags": 0,
      "text": "Du trittst mit deinen aktuellen Team-Pokémon\\nzum Kampf an. Möchtest du fortfahren?"
    },
    {
      "index": 10,
      "id": "msg_b_nbr_win_11",
      "hash": "91a566d8ccb778ca",
      "flags": 0,
      "text": "Du trittst mit Pokémon aus der Pokémon-Box\\nzum Kampf an. Möchtest du fortfahren?"
    },
    {
      "index": 11,
      "id": "msg_b_nbr_win_12",
      "hash": "91a565d8ccb77717",
      "flags": 0,
      "text": "Du benötigst mindestens 2 Pokémon."
    },
    {
      "index": 12,
      "id": "msg_b_nbr_win_13",
      "hash": "91a564d8ccb77564",
      "flags": 0,
      "text": "Du benötigst mindestens 1 Pokémon."
    },
    {
      "index": 13,
      "id": "msg_b_nbr_win_14",
      "hash": "91a563d8ccb773b1",
      "flags": 0,
      "text": "Möchtest du einen weiteren Kampf austragen?"
    },
    {
      "index": 14,
      "id": "msg_b_nbr_win_15",
      "hash": "91a562d8ccb771fe",
      "flags": 0,
      "text": "Möchtest du den Link-Kampf beenden?"
    },
    {
      "index": 15,
      "id": "msg_b_nbr_win_16",
      "hash": "91a561d8ccb7704b",
      "flags": 0,
      "text": "Verbindung wird hergestellt...\\nBitte warte einen Moment."
    },
    {
      "index": 16,
      "id": "msg_b_nbr_win_17",
      "hash": "91a560d8ccb76e98",
      "flags": 0,
      "text": "Die Verbindung wird getrennt...\\nBitte warte einen Moment."
    },
    {
      "index": 17,
      "id": "msg_b_nbr_win_18",
      "hash": "91a55fd8ccb76ce5",
      "flags": 0,
      "text": "Dein Gegner hat den Kampf verlassen.\\nDer Kampf wird beendet."
    },
    {
      "index": 18,
      "id": "msg_b_nbr_win_19",
      "hash": "91a55ed8ccb76b32",
      "flags": 0,
      "text": "Der Kampf wird ohne Einschränkungen\\nausgetragen."
    },
    {
      "index": 19,
      "id": "msg_b_nbr_win_20",
      "hash": "91a8cdd8ccba5da6",
      "flags": 0,
      "text": "Der Kampf wird mit normalen Regeln\\nausgetragen."
    },
    {
      "index": 20,
      "id": "msg_b_nbr_win_21",
      "hash": "91a8ced8ccba5f59",
      "flags": 0,
      "text": "Für Doppelkämpfe werden mindestens\\n2 Pokémon benötigt."
    },
    {
      "index": 21,
      "id": "msg_b_nbr_win_22",
      "hash": "91a8cbd8ccba5a40",
      "flags": 0,
      "text": "Es gibt ein Problem mit mindestens einem\\nder Pokémon."
    },
    {
      "index": 22,
      "id": "msg_b_nbr_btl_01",
      "hash": "913afb8ac86d9e9f",
      "flags": 0,
      "text": "Einzelkampf"
    },
    {
      "index": 23,
      "id": "msg_b_nbr_btl_02",
      "hash": "913afc8ac86da052",
      "flags": 0,
      "text": "Doppelkampf"
    },
    {
      "index": 24,
      "id": "msg_b_nbr_btl_03",
      "hash": "913afd8ac86da205",
      "flags": 0,
      "text": "Multikampf"
    },
    {
      "index": 25,
      "id": "msg_b_nbr_rule_01",
      "hash": "c090870c6fed4179",
      "flags": 0,
      "text": "Keine Einschränkungen"
    },
    {
      "index": 26,
      "id": "msg_b_nbr_rule_02",
      "hash": "c090840c6fed3c60",
      "flags": 0,
      "text": "Normale Regeln"
    },
    {
      "index": 27,
      "id": "msg_b_nbr_rule_03",
      "hash": "c090850c6fed3e13",
      "flags": 0,
      "text": "---"
    },
    {
