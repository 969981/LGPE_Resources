    },
    {
      "index": 4,
      "id": "TOWNMAP_01_03",
      "hash": "adebeb59f5f81173",
      "flags": 0,
      "text": "Pokémon wechseln"
    },
    {
      "index": 5,
      "id": "TOWNMAP_02_01",
      "hash": "54b72d40aea6ee66",
      "flags": 0,
      "text": "← → Pokémon wechseln"
    },
    {
      "index": 6,
      "id": "TOWNMAP_05_01",
      "hash": "537c053b87998f1d",
      "flags": 0,
      "text": "Ziel: [VAR LOCATION(0000)]\\nMit der Geheimen Technik Himmelsritt hinfliegen?"
    },
    {
      "index": 7,
      "id": "TOWNMAP_05_02",
      "hash": "537c023b87998a04",
      "flags": 0,
      "text": "Ja"
    },
    {
      "index": 8,
      "id": "TOWNMAP_05_03",
      "hash": "537c033b87998bb7",
      "flags": 0,
      "text": "Nein"
    },
    {
      "index": 9,
      "id": "TOWNMAP_10_01",
      "hash": "c7de207c7f324b27",
      "flags": 0,
      "text": "[VAR LOCATION(0000)]"
    },
    {
      "index": 10,
      "id": "TOWNMAP_20_01",
      "hash": "9e9ac914d7a1ec8a",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]-Habitate"
    },
    {
      "index": 11,
      "id": "TOWNMAP_20_02",
      "hash": "9e9ac814d7a1ead7",
      "flags": 0,
      "text": "Habitat unbekannt"
    },
    {
      "index": 12,
      "id": "TM_GUIDE_01",
      "hash": "de793f7747865099",
      "flags": 0,
      "text": "Dieser ländliche Weg ist dicht bewachsen und\\nstrahlt eine behagliche Atmosphäre aus."
    },
    {
      "index": 13,
      "id": "TM_GUIDE_02",
      "hash": "de793c7747864b80",
      "flags": 0,
      "text": "Dieser stufenreiche Weg führt bis zum\\nVertania-Wald."
    },
    {
      "index": 14,
      "id": "TM_GUIDE_03",
      "hash": "de793d7747864d33",
      "flags": 0,
      "text": "Ein mit Gras bewachsener Pfad in Bergnähe,\\nauf dem hier und da Felsen liegen."
    },
    {
      "index": 15,
      "id": "TM_GUIDE_04",
      "hash": "de794277478655b2",
      "flags": 0,
      "text": "Der Weg läuft beidseitig steil auf den Mondberg\\nzu. Bei Azuria City wird er zur Einbahnstraße."
    },
    {
      "index": 16,
      "id": "TM_GUIDE_05",
      "hash": "de79437747865765",
      "flags": 0,
      "text": "Ein sanft abfallender Hang. Es gibt dort eine\\nUnterführung."
    },
    {
      "index": 17,
      "id": "TM_GUIDE_06",
      "hash": "de7940774786524c",
      "flags": 0,
      "text": "Dieser Weg verläuft zwischen Orania City und\\nSaffronia City. Es gibt dort eine Unterführung."
    },
    {
      "index": 18,
      "id": "TM_GUIDE_07",
      "hash": "de794177478653ff",
      "flags": 0,
      "text": "Eine kurze Route. Der Eingang zur Unterführung,\\ndie zu Route 8 führt, befindet sich hier."
    },
    {
      "index": 19,
      "id": "TM_GUIDE_08",
      "hash": "de79467747865c7e",
      "flags": 0,
      "text": "Eine kurze Route. Der Eingang zur Unterführung,\\ndie zu Route 7 führt, befindet sich hier."
    },
    {
      "index": 20,
      "id": "TM_GUIDE_09",
      "hash": "de79477747865e31",
      "flags": 0,
      "text": "Ein Pfad mit vielen stufenförmigen Vorsprüngen.\\nHier sieht man oft Kinder spielen."
    },
    {
      "index": 21,
      "id": "TM_GUIDE_10",
      "hash": "de7cc4774789686f",
      "flags": 0,
      "text": "Dieser Weg folgt streckenweise dem Verlauf\\neines Kanals. Der Felstunnel liegt hier."
    },
    {
      "index": 22,
      "id": "TM_GUIDE_11",
      "hash": "de7cc377478966bc",
      "flags": 0,
      "text": "Eine wild bewachsene Route, wo sich viele\\nTrainer tummeln. Die Digda-Höhle liegt hier."
    },
    {
      "index": 23,
      "id": "TM_GUIDE_12",
      "hash": "de7cc67747896bd5",
      "flags": 0,
      "text": "Dieser Steg ist ein Treffpunkt für Angler und\\nwird auch die „Schweigebrücke“ genannt."
    },
    {
      "index": 24,
      "id": "TM_GUIDE_13",
      "hash": "de7cc57747896a22",
      "flags": 0,
      "text": "Ein Teil dieses erfrischenden und nah am Meer\\ngelegenen Wegs wurde als Labyrinth konzipiert."
    },
    {
      "index": 25,
      "id": "TM_GUIDE_14",
      "hash": "de7cc077478961a3",
      "flags": 0,
      "text": "Dieser breit angelegte Küstenweg wird von einer\\nfrischen Meeresbrise umweht."
    },
    {
      "index": 26,
      "id": "TM_GUIDE_15",
      "hash": "de7cbf7747895ff0",
      "flags": 0,
      "text": "Ein langer, grasbewachsener Fußpfad, der sich\\nöstlich von Fuchsania City erstreckt."
    },
    {
      "index": 27,
      "id": "TM_GUIDE_16",
      "hash": "de7cc27747896509",
      "flags": 0,
      "text": "Der nördliche Abschnitt des Pokémon-Wegs.\\nHier ist immer was los."
    },
    {
      "index": 28,
      "id": "TM_GUIDE_17",
      "hash": "de7cc17747896356",
      "flags": 0,
      "text": "Der Pokémon-Weg dient als Flaniermeile\\nfür Trainer und ihre Pokémon."
    },
    {
      "index": 29,
      "id": "TM_GUIDE_18",
      "hash": "de7ccc7747897607",
      "flags": 0,
      "text": "Der südliche Abschnitt des Pokémon-Wegs.\\nHier halten sich viele kampflustige Trainer auf."
    },
    {
      "index": 30,
      "id": "TM_GUIDE_19",
      "hash": "de7ccb7747897454",
      "flags": 0,
      "text": "Ein beliebter Strand, der zum Sonnen und Baden\\neinlädt."
    },
    {
      "index": 31,
      "id": "TM_GUIDE_20",
      "hash": "de72d27747812bb4",
      "flags": 0,
      "text": "Die Seeschauminseln in der Mitte dieser Route\\nunterteilen den Seeweg in Osten und Westen."
    },
    {
      "index": 32,
      "id": "TM_GUIDE_21",
      "hash": "de72d37747812d67",
      "flags": 0,
      "text": "Der Vulkan in der Nähe dieser Wasserroute sorgt\\nfür eine besonders milde Wassertemperatur."
    },
    {
      "index": 33,
      "id": "TM_GUIDE_22",
      "hash": "de72d47747812f1a",
      "flags": 0,
      "text": "Ein gepflasterter Weg, der direkt zur\\nPokémon-Liga führt."
    },
    {
      "index": 34,
      "id": "TM_GUIDE_23",
      "hash": "de72d577478130cd",
      "flags": 0,
      "text": "Nur ganz besonders starke Trainer dürfen\\ndiesen Bergpfad passieren."
    },
    {
      "index": 35,
      "id": "TM_GUIDE_24",
      "hash": "de72ce77478124e8",
      "flags": 0,
      "text": "Diese Route liegt nördlich von Azuria City und\\nist für ihre goldene Brücke bekannt."
    },
    {
      "index": 36,
      "id": "TM_GUIDE_25",
      "hash": "de72cf774781269b",
      "flags": 0,
      "text": "Diese Route schlängelt sich durch ein kleines\\nHeckenlabyrinth bis zum Kap."
    },
    {
      "index": 37,
      "id": "TM_GUIDE_26",
      "hash": "de72d0774781284e",
      "flags": 0,
      "text": "Ein kleines Städtchen auf dem Lande, in dem es\\naber immerhin ein Pokémon-Labor gibt."
    },
    {
      "index": 38,
      "id": "TM_GUIDE_27",
      "hash": "de72d17747812a01",
      "flags": 0,
      "text": "Diese Stadt liebt die Natur. Hier blühen das\\nganze Jahr über Blumen."
    },
    {
      "index": 39,
      "id": "TM_GUIDE_28",
      "hash": "de72ca7747811e1c",
      "flags": 0,
      "text": "Diese steinerne Stadt liegt am Fuße eines\\nBerges, der mit Felsbrocken übersät ist."
    },
    {
      "index": 40,
      "id": "TM_GUIDE_29",
      "hash": "de72cb7747811fcf",
      "flags": 0,
      "text": "Diese Stadt steht ganz wie die Arena im Zeichen\\ndes Typs Wasser. Viele Gewässer grenzen an sie."
    },
    {
      "index": 41,
      "id": "TM_GUIDE_30",
      "hash": "de75d87747836bbd",
      "flags": 0,
      "text": "Eine ruhige und erhabene Stadt mit einem\\nMausoleum für verstorbene Pokémon."
    },
    {
      "index": 42,
      "id": "TM_GUIDE_31",
      "hash": "de75d77747836a0a",
      "flags": 0,
      "text": "In dieser internationalen Hafenstadt legen\\nsogar Kreuzfahrtschiffe an."
    },
    {
      "index": 43,
      "id": "TM_GUIDE_32",
      "hash": "de75d67747836857",
      "flags": 0,
      "text": "In dieser Stadt wohnen Leute unterschiedlicher\\nAltersklassen. Es gibt dort ein Einkaufscenter."
    },
    {
      "index": 44,
      "id": "TM_GUIDE_33",
      "hash": "de75d577478366a4",
      "flags": 0,
      "text": "Die Safari-Zone in dieser Stadt ist ein wahrer\\nMagnet für Trainer und Pokémon aller Art."
    },
    {
      "index": 45,
      "id": "TM_GUIDE_34",
      "hash": "de75d477478364f1",
      "flags": 0,
      "text": "Auf dieser Vulkaninsel liegt ein beschauliches\\nStädtchen mit einer verlassenen Villa."
    },
    {
      "index": 46,
      "id": "TM_GUIDE_35",
      "hash": "de75d3774783633e",
      "flags": 0,
      "text": "Auf diesem Plateau thront das Hauptquartier\\nder Pokémon-Liga."
    },
    {
      "index": 47,
      "id": "TM_GUIDE_36",
      "hash": "de75d2774783618b",
      "flags": 0,
      "text": "Die Stadt mit den höchsten Häusern und der\\ngrößten Bevölkerungsdichte der Kanto-Region."
    },
    {
      "index": 48,
      "id": "TM_GUIDE_37",
      "hash": "de75d17747835fd8",
      "flags": 0,
      "text": "In diesem großen, schattigen Wald kann man\\nviele Käfer-Pokémon finden."
    },
    {
      "index": 49,
      "id": "TM_GUIDE_38",
      "hash": "de75d07747835e25",
      "flags": 0,
      "text": "Dieser Berg ist bekannt für Fossilfunde und\\nals Einschlagsort für Sternschnuppen."
    },
    {
      "index": 50,
      "id": "TM_GUIDE_39",
      "hash": "de75cf7747835c72",
      "flags": 0,
      "text": "Ein natürlicher Felstunnel, in dem es so finster\\nist, dass man ohne Lichtquelle nicht weit kommt."
    },
    {
      "index": 51,
      "id": "TM_GUIDE_40",
      "hash": "de6bc677477af8a2",
      "flags": 0,
      "text": "Ein Kraftwerk voller Maschinerie, in dem sich\\nElektro-Pokémon tummeln."
    },
    {
      "index": 52,
      "id": "TM_GUIDE_41",
      "hash": "de6bc777477afa55",
      "flags": 0,
      "text": "Dieser von Digda gegrabene Tunnel verbindet\\nMarmoria City mit Orania City."
    },
    {
      "index": 53,
      "id": "TM_GUIDE_42",
      "hash": "de6bc477477af53c",
      "flags": 0,
      "text": "Diese Inseln treiben wie Schaumwolken auf dem\\nOzean. In den dortigen Höhlen ist es sehr kalt."
    },
    {
      "index": 54,
      "id": "TM_GUIDE_43",
      "hash": "de6bc577477af6ef",
      "flags": 0,
      "text": "In dieser Höhle triffst du auf viele starke Trainer,\\ndie die allerbesten sein wollen."
    },
    {
