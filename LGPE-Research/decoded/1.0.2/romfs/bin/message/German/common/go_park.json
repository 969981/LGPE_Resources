{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "go_park_00_01",
      "hash": "7fbbaaedc1e6df95",
      "flags": 0,
      "text": "Willkommen im GO Park!"
    },
    {
      "index": 1,
      "id": "go_park_00_02",
      "hash": "7fbba7edc1e6da7c",
      "flags": 0,
      "text": "Worüber möchtest du mehr erfahren?"
    },
    {
      "index": 2,
      "id": "go_park_00_03",
      "hash": "7fbba8edc1e6dc2f",
      "flags": 0,
      "text": "Was möchtest du tun?"
    },
    {
      "index": 3,
      "id": "go_park_00_10",
      "hash": "7fbf2fedc1e9f76b",
      "flags": 0,
      "text": "Pokémon übertragen"
    },
    {
      "index": 4,
      "id": "go_park_00_11",
      "hash": "7fbf2eedc1e9f5b8",
      "flags": 0,
      "text": "Einen GO Park besuchen"
    },
    {
      "index": 5,
      "id": "go_park_00_12",
      "hash": "7fbf31edc1e9fad1",
      "flags": 0,
      "text": "Die Spielwiese besuchen"
    },
    {
      "index": 6,
      "id": "go_park_00_13",
      "hash": "7fbf30edc1e9f91e",
      "flags": 0,
      "text": "Erklärungen anhören"
    },
    {
      "index": 7,
      "id": "go_park_00_14",
      "hash": "7fbf33edc1e9fe37",
      "flags": 0,
      "text": "Abbrechen"
    },
    {
      "index": 8,
      "id": "go_park_00_15",
      "hash": "7fbf32edc1e9fc84",
      "flags": 0,
      "text": "Übertragung von Pokémon"
    },
    {
      "index": 9,
      "id": "go_park_00_16",
      "hash": "7fbf35edc1ea019d",
      "flags": 0,
      "text": "GO Park"
    },
    {
      "index": 10,
      "id": "go_park_00_17",
      "hash": "7fbf34edc1e9ffea",
      "flags": 0,
      "text": "Spielwiese"
    },
    {
      "index": 11,
      "id": "go_park_00_20",
      "hash": "7fb51dedc1e18450",
      "flags": 0,
      "text": "Du kannst Pokémon aus Pokémon GO in den\\nGO Park übertragen.\\c\\nDafür musst du zunächst das Spielmenü öffnen\\nund in den Einstellungen die Option\\r\\n„Mit Pokémon GO verbinden“ auswählen, um\\r\\ndein Spiel mit einem Pokémon GO-Konto\\r\\nzu verbinden.\\c\\nDanach kannst du in Pokémon GO die Pokémon\\nauswählen, die du verschicken möchtest.\\c\\nBitte sei dir bewusst, dass in den GO Park\\nverschickte Pokémon nicht mehr zurück auf\\r\\nPokémon GO übertragen werden können."
    },
    {
      "index": 12,
      "id": "go_park_00_21",
      "hash": "7fb51eedc1e18603",
      "flags": 0,
      "text": "Im GO Park spielen die Pokémon, die du\\naus Pokémon GO übertragen hast.\\c\\nWenn du sie ansprichst, kannst du sie fangen\\noder in einen anderen GO Park verschieben.\\c\\nGefangene Pokémon können nicht in den\\nGO Park zurückkehren.\\c\\nDrücke den X-Knopf, um einen GO Park zu\\nverlassen."
    },
    {
      "index": 13,
      "id": "go_park_00_22",
      "hash": "7fb51fedc1e187b6",
      "flags": 0,
      "text": "Wenn sich 25 Pokémon derselben Art im\\nGO Park befinden, kannst du mit ihnen\\r\\nauf der Spielwiese spielen.\\c\\nFühre alle Pokémon innerhalb des Zeitlimits\\nnach oben zum Ziel und nimm dich dabei vor\\r\\nstörenden Pokémon in Acht, die aus dem\\r\\nBoden kommen!\\c\\nWenn du die Spielwiese verlassen möchtest,\\ndrücke den X-Knopf."
    },
    {
      "index": 14,
      "id": "go_park_01_01",
      "hash": "d5055ee3b2da9820",
      "flags": 0,
      "text": "GO Park 1"
    },
    {
      "index": 15,
      "id": "go_park_01_02",
      "hash": "d50561e3b2da9d39",
      "flags": 0,
      "text": "GO Park 2"
    },
    {
      "index": 16,
      "id": "go_park_01_03",
      "hash": "d50560e3b2da9b86",
      "flags": 0,
      "text": "GO Park 3"
    },
