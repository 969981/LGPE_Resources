{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "BTR_STATE_00_01",
      "hash": "4fb031d3b2084edc",
      "flags": 0,
      "text": "[~ 0]"
    },
    {
      "index": 1,
      "id": "BTR_STATE_00_02",
      "hash": "4fb034d3b20853f5",
      "flags": 0,
      "text": "[~ 1]"
    },
    {
      "index": 2,
      "id": "BTR_STATE_01_01",
      "hash": "7bb6bdda13718e71",
      "flags": 0,
      "text": "Sonne"
    },
    {
      "index": 3,
      "id": "BTR_STATE_01_02",
      "hash": "7bb6bada13718958",
      "flags": 0,
      "text": "Es herrscht sonniges Wetter. Die Stärke von\\nFeuer-Attacken ist gestiegen, während die\\nStärke von Wasser-Attacken gesunken ist."
    },
    {
      "index": 4,
      "id": "BTR_STATE_02_01",
      "hash": "773f7dc3401fbd7e",
      "flags": 0,
      "text": "Regen"
    },
    {
      "index": 5,
      "id": "BTR_STATE_02_02",
      "hash": "773f7cc3401fbbcb",
      "flags": 0,
      "text": "Es herrscht regnerisches Wetter. Die Stärke\\nvon Wasser-Attacken ist gestiegen, während\\ndie Stärke von Feuer-Attacken gesunken ist."
    },
    {
      "index": 6,
      "id": "BTR_STATE_03_01",
      "hash": "7a2e29c8689f9193",
      "flags": 0,
      "text": "Sandsturm"
    },
    {
      "index": 7,
      "id": "BTR_STATE_03_02",
      "hash": "7a2e2ac8689f9346",
      "flags": 0,
      "text": "Ein Sandsturm tobt. Bis auf Gesteins-, Boden-\\nund Stahl-Pokémon nehmen alle Pokémon in\\njeder Runde Schaden. Die Spezial-Verteidigung\\nvon Gesteins-Pokémon ist gestiegen."
    },
    {
      "index": 8,
      "id": "BTR_STATE_04_01",
      "hash": "4a11a9b05a3879c0",
      "flags": 0,
      "text": "Hagelsturm"
    },
    {
      "index": 9,
      "id": "BTR_STATE_04_02",
      "hash": "4a11acb05a387ed9",
      "flags": 0,
      "text": "Ein Hagelsturm tobt. Bis auf Eis-Pokémon\\nnehmen alle Pokémon in jeder Runde Schaden."
    },
    {
      "index": 10,
      "id": "BTR_STATE_05_01",
      "hash": "a1bdf5b7f6b7d9b5",
      "flags": 0,
      "text": "Elektrofeld"
    },
    {
      "index": 11,
      "id": "BTR_STATE_05_02",
      "hash": "a1bdf2b7f6b7d49c",
      "flags": 0,
      "text": "Verhindert fünf Runden lang, dass Pokémon,\\ndie sich am Boden befinden, einschlafen.\\nDie Stärke von Elektro-Attacken ist gestiegen."
    },
    {
      "index": 12,
      "id": "BTR_STATE_06_01",
      "hash": "7354759fe9c25662",
      "flags": 0,
      "text": "Grasfeld"
    },
    {
      "index": 13,
      "id": "BTR_STATE_06_02",
      "hash": "7354749fe9c254af",
      "flags": 0,
      "text": "Die KP von Pokémon, die sich am Boden\\nbefinden, werden fünf Runden lang leicht\\naufgefüllt. Die Stärke von Pflanzen-Attacken\\nist gestiegen."
    },
    {
      "index": 14,
      "id": "BTR_STATE_07_01",
      "hash": "1e0ac1a9f8ce9dd7",
      "flags": 0,
      "text": "Nebelfeld"
    },
    {
      "index": 15,
      "id": "BTR_STATE_07_02",
      "hash": "1e0ac2a9f8ce9f8a",
      "flags": 0,
      "text": "Verhindert fünf Runden lang, dass Pokémon,\\ndie sich am Boden befinden, Statusprobleme\\nerleiden. Der erlittene Schaden durch\\nDrachen-Attacken wird halbiert."
    },
    {
      "index": 16,
      "id": "BTR_STATE_08_01",
      "hash": "da8a0216b2928334",
      "flags": 0,
      "text": "Bizarroraum"
    },
    {
      "index": 17,
      "id": "BTR_STATE_08_02",
      "hash": "da8a0516b292884d",
      "flags": 0,
      "text": "Pokémon mit niedriger Initiative kommen\\nfünf Runden lang zuerst zum Zug."
    },
    {
      "index": 18,
      "id": "BTR_STATE_09_01",
      "hash": "dbc52e1bd99fe949",
      "flags": 0,
      "text": "Magieraum"
    },
    {
      "index": 19,
      "id": "BTR_STATE_09_02",
      "hash": "dbc52b1bd99fe430",
      "flags": 0,
      "text": "Die getragenen Items aller Pokémon verlieren\\nfünf Runden lang ihre Wirkung."
    },
    {
      "index": 20,
      "id": "BTR_STATE_10_01",
      "hash": "c03652089e1b28bf",
      "flags": 0,
      "text": "Wunderraum"
    },
    {
      "index": 21,
      "id": "BTR_STATE_10_02",
      "hash": "c03653089e1b2a72",
      "flags": 0,
      "text": "Verteidigung aller Pokémon wird fünf Runden\\nlang mit ihrer Spezial-Verteidigung getauscht."
    },
    {
      "index": 22,
      "id": "BTR_STATE_11_01",
      "hash": "136025fe8d40b14a",
      "flags": 0,
      "text": "Mehr Volltreffer"
    },
    {
      "index": 23,
      "id": "BTR_STATE_11_02",
      "hash": "136024fe8d40af97",
      "flags": 0,
      "text": "Die Wahrscheinlichkeit, dass das Pokémon\\neinen Volltreffer landet, wurde erhöht."
    },
    {
      "index": 24,
      "id": "BTR_STATE_12_01",
      "hash": "c152661a48912d3d",
      "flags": 0,
      "text": "Verwirrung"
    },
    {
      "index": 25,
      "id": "BTR_STATE_12_02",
      "hash": "c152631a48912824",
      "flags": 0,
      "text": "Es besteht bis zu vier Runden lang die Gefahr,\\ndass sich das Pokémon selbst verletzt."
    },
    {
      "index": 26,
      "id": "BTR_STATE_13_01",
      "hash": "ebd0da0eff2942a8",
      "flags": 0,
      "text": "Anziehung"
    },
    {
      "index": 27,
      "id": "BTR_STATE_13_02",
      "hash": "ebd0dd0eff2947c1",
      "flags": 0,
      "text": "Versucht das Pokémon, ein Pokémon vom\\nanderen Geschlecht anzugreifen, schlägt\\nder Angriff eventuell fehl."
    },
    {
      "index": 28,
      "id": "BTR_STATE_14_01",
      "hash": "45059a28467a691b",
      "flags": 0,
      "text": "Nachtmahr"
    },
    {
      "index": 29,
      "id": "BTR_STATE_14_02",
      "hash": "45059b28467a6ace",
      "flags": 0,
      "text": "Solange das Pokémon schläft, verliert es in\\njeder Runde KP."
    },
    {
      "index": 30,
      "id": "BTR_STATE_15_01",
      "hash": "18fe8e21e5105006",
      "flags": 0,
      "text": "Schlaf"
    },
    {
      "index": 31,
      "id": "BTR_STATE_15_02",
      "hash": "18fe8d21e5104e53",
      "flags": 0,
      "text": "Das Pokémon schläft in der Runde, nachdem\\nes von einer Attacke erfasst wurde, ein."
    },
    {
      "index": 32,
      "id": "BTR_STATE_16_01",
      "hash": "1d75ce38b86220f9",
      "flags": 0,
      "text": "Zugabe"
    },
    {
      "index": 33,
      "id": "BTR_STATE_16_02",
      "hash": "1d75cb38b8621be0",
      "flags": 0,
      "text": "Das Pokémon kann drei Runden lang nur\\ndie Attacke [VAR MOVE(0000)] einsetzen."
    },
    {
      "index": 34,
      "id": "BTR_STATE_17_01",
      "hash": "f028623255e2a224",
      "flags": 0,
      "text": "Keine Fähigkeit"
    },
    {
      "index": 35,
      "id": "BTR_STATE_17_02",
      "hash": "f028653255e2a73d",
      "flags": 0,
      "text": "Die Fähigkeit des Pokémon hat ihre Wirkung\\nverloren."
    },
    {
      "index": 36,
      "id": "BTR_STATE_18_01",
      "hash": "5fbb61c6d790d587",
      "flags": 0,
      "text": "Folterknecht"
    },
    {
      "index": 37,
      "id": "BTR_STATE_18_02",
      "hash": "5fbb62c6d790d73a",
      "flags": 0,
      "text": "Das Pokémon kann dieselbe Attacke nicht\\nzweimal hintereinander einsetzen."
    },
    {
      "index": 38,
      "id": "BTR_STATE_19_01",
      "hash": "88f355bb8d134ed2",
      "flags": 0,
      "text": "Rückenwind"
    },
    {
      "index": 39,
      "id": "BTR_STATE_19_02",
      "hash": "88f354bb8d134d1f",
      "flags": 0,
      "text": "Die Initiative aller Team-Pokémon, die am Kampf\\nteilnehmen, wird vier Runden lang verdoppelt."
    },
    {
      "index": 40,
      "id": "BTR_STATE_20_01",
      "hash": "6f0ff569da3dc0c2",
      "flags": 0,
      "text": "Beschwörung"
    },
    {
      "index": 41,
      "id": "BTR_STATE_20_02",
      "hash": "6f0ff469da3dbf0f",
      "flags": 0,
      "text": "Das Pokémon ist vor gegnerischen Volltreffern\\ngeschützt."
    },
    {
      "index": 42,
      "id": "BTR_STATE_21_01",
      "hash": "c6bbc17176bc4737",
      "flags": 0,
      "text": "Nachspiel"
    },
    {
      "index": 43,
      "id": "BTR_STATE_21_02",
      "hash": "c6bbc27176bc48ea",
      "flags": 0,
      "text": "Wird das Pokémon durch eine gegnerische\\nAttacke besiegt, sinkt der AP-Wert dieser\\nAttacke auf 0."
    },
    {
      "index": 44,
      "id": "BTR_STATE_22_01",
      "hash": "f2c2a977d8262320",
      "flags": 0,
      "text": "Heilblockade"
    },
    {
      "index": 45,
      "id": "BTR_STATE_22_02",
      "hash": "f2c2ac77d8262839",
      "flags": 0,
      "text": "Das Pokémon wird fünf Runden lang daran\\ngehindert durch Attacken, Fähigkeiten oder\\ngetragene Items KP zu regenerieren."
    },
    {
      "index": 46,
      "id": "BTR_STATE_23_01",
      "hash": "9d78f581e7326a95",
      "flags": 0,
      "text": "Gesichte"
    },
    {
      "index": 47,
      "id": "BTR_STATE_23_02",
      "hash": "9d78f281e732657c",
      "flags": 0,
      "text": "Attacken, die in bestimmten Fällen wirkungslos\\nwaren, treffen nun ihr Ziel. Außerdem werden\\nerhöhte Fluchtwerte ignoriert."
    },
    {
      "index": 48,
      "id": "BTR_STATE_24_01",
      "hash": "cb32fd884a0e115e",
      "flags": 0,
      "text": "Aussetzer"
    },
    {
      "index": 49,
      "id": "BTR_STATE_24_02",
      "hash": "cb32fc884a0e0fab",
      "flags": 0,
      "text": "Das Pokémon kann vier Runden lang nicht\\ndie Attacke [VAR MOVE(0000)] einsetzen."
    },
    {
      "index": 50,
      "id": "BTR_STATE_25_01",
      "hash": "212ba98fe51accf3",
      "flags": 0,
      "text": "Wechselsperre"
    },
    {
      "index": 51,
      "id": "BTR_STATE_25_02",
      "hash": "212baa8fe51acea6",
      "flags": 0,
      "text": "Das Pokémon kann nicht ausgewechselt werden\\noder fliehen."
    },
    {
      "index": 52,
      "id": "BTR_STATE_26_01",
      "hash": "f6adb19b2e838a3c",
      "flags": 0,
      "text": "Zielschuss"
    },
    {
      "index": 53,
      "id": "BTR_STATE_26_02",
      "hash": "f6adb49b2e838f55",
      "flags": 0,
      "text": "Das Pokémon trifft in der Runde, nachdem es\\nZielschuss eingesetzt hat, mit seiner nächsten\\nAttacke auf jeden Fall sein Ziel."
    },
    {
      "index": 54,
      "id": "BTR_STATE_27_01",
      "hash": "2467bda1915f37d1",
      "flags": 0,
      "text": "Itemsperre"
    },
    {
      "index": 55,
      "id": "BTR_STATE_27_02",
      "hash": "2467baa1915f32b8",
      "flags": 0,
      "text": "Das Pokémon kann fünf Runden lang keine\\nItems verwenden. Das gilt auch für das von\\nihm getragene Item."
    },
    {
      "index": 56,
      "id": "BTR_STATE_28_01",
      "hash": "cf1e05aba06b787a",
      "flags": 0,
      "text": "Ladevorgang"
    },
    {
      "index": 57,
      "id": "BTR_STATE_28_02",
      "hash": "cf1e04aba06b76c7",
      "flags": 0,
      "text": "Setzt das Pokémon in der Runde, nachdem es\\nLadevorgang eingesetzt hat, eine Elektro-\\nAttacke ein, wird ihre Stärke verdoppelt."
    },
    {
      "index": 58,
      "id": "BTR_STATE_29_01",
      "hash": "fb24f1b201d55b2f",
      "flags": 0,
      "text": "Erdanziehung"
    },
    {
      "index": 59,
      "id": "BTR_STATE_29_02",
      "hash": "fb24f2b201d55ce2",
      "flags": 0,
      "text": "Die Wahrscheinlichkeit, dass Attacken ihr Ziel\\ntreffen, wurde für fünf Runden erhöht. Pokémon\\nvom Typ Flug und mit der Fähigkeit Schwebe\\nkönnen mit Boden-Attacken getroffen werden.\\nFlug-Attacken können nicht eingesetzt werden."
    },
    {
      "index": 60,
      "id": "BTR_STATE_30_01",
      "hash": "df29959ec5f4a245",
      "flags": 0,
      "text": "Weißnebel"
    },
    {
      "index": 61,
      "id": "BTR_STATE_30_02",
      "hash": "df29929ec5f49d2c",
      "flags": 0,
      "text": "Die Statuswerte des Pokémon können fünf\\nRunden lang nicht gesenkt werden."
    },
    {
      "index": 62,
      "id": "BTR_STATE_31_01",
      "hash": "0a1489937ce8b010",
      "flags": 0,
      "text": "Bodyguard"
    },
    {
      "index": 63,
      "id": "BTR_STATE_31_02",
      "hash": "0a148c937ce8b529",
      "flags": 0,
      "text": "Das Pokémon ist fünf Runden lang vor\\nStatusproblemen geschützt."
    },
    {
      "index": 64,
      "id": "BTR_STATE_32_01",
      "hash": "06b9618e540cea67",
      "flags": 0,
      "text": "Tarnsteine"
    },
    {
      "index": 65,
      "id": "BTR_STATE_32_02",
      "hash": "06b9628e540cec1a",
      "flags": 0,
      "text": "Pokémon, die in den Kampf eingewechselt\\nwerden, nehmen Schaden."
    },
    {
      "index": 66,
      "id": "BTR_STATE_33_01",
      "hash": "31a3d5830b001eb2",
      "flags": 0,
      "text": "Horter"
    },
    {
      "index": 67,
      "id": "BTR_STATE_33_02",
      "hash": "31a3d4830b001cff",
      "flags": 0,
      "text": "Jedes Mal, wenn das Pokémon die Attacke\\nHorter einsetzt, steigen seine Verteidigung und\\nSpezial-Verteidigung."
    },
    {
      "index": 68,
      "id": "BTR_STATE_34_01",
      "hash": "3a069dbd34b03041",
      "flags": 0,
      "text": "Verhöhner"
    },
    {
      "index": 69,
      "id": "BTR_STATE_34_02",
      "hash": "3a069abd34b02b28",
      "flags": 0,
      "text": "Das Pokémon kann nur noch Attacken einsetzen,\\ndie dem Ziel Schaden zufügen."
    },
    {
      "index": 70,
      "id": "BTR_STATE_35_01",
      "hash": "385e51b80d45c1ec",
      "flags": 0,
      "text": "Telekinese"
    },
    {
      "index": 71,
      "id": "BTR_STATE_35_02",
      "hash": "385e54b80d45c705",
      "flags": 0,
      "text": "Das Pokémon wird drei Runden lang von allen\\nAttacken getroffen, es sei denn, es handelt sich\\ndabei um eine K.O.-Attacke. Dafür kann das\\nPokémon aber nicht mit Boden-Attacken\\ngetroffen werden."
    },
    {
      "index": 72,
      "id": "BTR_STATE_36_01",
      "hash": "62dc49acc3dd04a3",
      "flags": 0,
      "text": "Magnetflug"
    },
    {
      "index": 73,
      "id": "BTR_STATE_36_02",
      "hash": "62dc4aacc3dd0656",
      "flags": 0,
      "text": "Das Pokémon kann fünf Runden lang nicht mit\\nBoden-Attacken getroffen werden."
    },
    {
      "index": 74,
      "id": "BTR_STATE_37_01",
      "hash": "358f5da6615e5f4e",
      "flags": 0,
      "text": "Giftspitzen"
    },
    {
      "index": 75,
      "id": "BTR_STATE_37_02",
      "hash": "358f5ca6615e5d9b",
      "flags": 0,
      "text": "Pokémon, die in den Kampf eingewechselt\\nwerden, werden vergiftet. Pokémon vom Typ\\nFlug und mit der Fähigkeit Schwebe sind nicht\\ndavon betroffen."
    },
    {
      "index": 76,
      "id": "BTR_STATE_38_01",
      "hash": "6a0365e1c67ed69d",
      "flags": 0,
      "text": "Lehmsuhler"
    },
    {
      "index": 77,
      "id": "BTR_STATE_38_02",
      "hash": "6a0362e1c67ed184",
      "flags": 0,
      "text": "Die Stärke von Elektro-Attacken wird\\nfünf Runden lang halbiert."
    },
    {
      "index": 78,
      "id": "BTR_STATE_39_01",
      "hash": "948159d67d161288",
      "flags": 0,
      "text": "Wunschtraum"
    },
    {
      "index": 79,
      "id": "BTR_STATE_39_02",
      "hash": "94815cd67d1617a1",
      "flags": 0,
      "text": "Die KP des Pokémon werden in der Runde,\\nnachdem es Wunschtraum eingesetzt hat,\\naufgefüllt."
    },
    {
      "index": 80,
      "id": "BTR_STATE_40_01",
      "hash": "e979a57045ab8090",
      "flags": 0,
      "text": "Klebenetz"
    },
    {
      "index": 81,
      "id": "BTR_STATE_40_02",
      "hash": "e979a87045ab85a9",
      "flags": 0,
      "text": "Die Initiative von Pokémon, die in den Kampf\\neingewechselt werden, wird gesenkt."
    },
    {
      "index": 82,
      "id": "BTR_STATE_41_01",
      "hash": "be8eb17b8eb772c5",
      "flags": 0,
      "text": "Verwurzler"
    },
    {
      "index": 83,
      "id": "BTR_STATE_41_02",
      "hash": "be8eae7b8eb76dac",
      "flags": 0,
      "text": "Die KP des Pokémon werden am Ende des\\nZugs aufgefüllt. Hat ein Pokémon Verwurzler\\neingesetzt, kann es nicht mehr ausgewechselt\\nwerden."
    },
    {
      "index": 84,
      "id": "BTR_STATE_42_01",
      "hash": "1108f15fd3c2ef32",
      "flags": 0,
      "text": "Fluch"
    },
    {
      "index": 85,
      "id": "BTR_STATE_42_02",
      "hash": "1108f05fd3c2ed7f",
      "flags": 0,
      "text": "Das Pokémon verliert am Ende jedes Zugs KP."
    },
    {
      "index": 86,
      "id": "BTR_STATE_43_01",
      "hash": "e61e7d6b1ccfbae7",
      "flags": 0,
      "text": "Halloween"
    },
    {
      "index": 87,
      "id": "BTR_STATE_43_02",
      "hash": "e61e7e6b1ccfbc9a",
      "flags": 0,
      "text": "Das Pokémon hat zusätzlich den Typ Geist\\nangenommen."
    },
    {
      "index": 88,
      "id": "BTR_STATE_44_01",
      "hash": "17c36d94d608926c",
      "flags": 0,
      "text": "Lichtschild"
    },
    {
      "index": 89,
      "id": "BTR_STATE_44_02",
      "hash": "17c37094d6089785",
      "flags": 0,
      "text": "Der erlittene Schaden durch Spezial-Attacken\\nwird fünf Runden lang halbiert."
    },
    {
      "index": 90,
      "id": "BTR_STATE_45_01",
      "hash": "196bb999fd7300c1",
      "flags": 0,
      "text": "Reflektor"
    },
    {
      "index": 91,
      "id": "BTR_STATE_45_02",
      "hash": "196bb699fd72fba8",
      "flags": 0,
      "text": "Der erlittene Schaden durch physische\\nAttacken wird fünf Runden lang halbiert."
    },
    {
      "index": 92,
      "id": "BTR_STATE_46_01",
      "hash": "14f479832a212fce",
      "flags": 0,
      "text": "Begrenzer"
    },
    {
      "index": 93,
      "id": "BTR_STATE_46_02",
      "hash": "14f478832a212e1b",
      "flags": 0,
      "text": "Gegnerische Pokémon können Attacken, die\\nauch vom Pokémon beherrscht werden, das\\nBegrenzer eingesetzt hat, nicht mehr ausführen."
    },
    {
      "index": 94,
      "id": "BTR_STATE_47_01",
      "hash": "424165898c9fd523",
      "flags": 0,
      "text": "Abgesang"
    },
    {
      "index": 95,
      "id": "BTR_STATE_47_02",
      "hash": "424166898c9fd6d6",
      "flags": 0,
      "text": "Alle Pokémon, die den Abgesang gehört haben,\\nwerden nach drei Runden kampfunfähig."
    },
    {
      "index": 96,
      "id": "BTR_STATE_48_01",
      "hash": "73e675b345d8e308",
      "flags": 0,
      "text": "Stachler"
    },
    {
      "index": 97,
      "id": "BTR_STATE_48_02",
      "hash": "73e678b345d8e821",
      "flags": 0,
      "text": "Pokémon, die in den Kampf eingewechselt\\nwerden, nehmen Schaden. Pokémon vom Typ\\nFlug und mit der Fähigkeit Schwebe sind nicht\\ndavon betroffen."
    },
    {
      "index": 98,
      "id": "BTR_STATE_49_01",
      "hash": "496881be8f41a71d",
      "flags": 0,
      "text": "Nassmacher"
    },
    {
      "index": 99,
      "id": "BTR_STATE_49_02",
      "hash": "49687ebe8f41a204",
      "flags": 0,
      "text": "Die Stärke von Feuer-Attacken wird\\nfünf Runden lang halbiert."
    },
    {
      "index": 100,
      "id": "BTR_STATE_50_01",
      "hash": "599345a531626213",
      "flags": 0,
      "text": "Abgangsbund"
    },
    {
      "index": 101,
      "id": "BTR_STATE_50_02",
      "hash": "599346a5316263c6",
      "flags": 0,
      "text": "Wird das Pokémon, welches Abgangsbund\\neingesetzt hat, von einem anderen besiegt,\\nwird der Angreifer ebenfalls kampfunfähig."
    },
    {
      "index": 102,
      "id": "BTR_STATE_51_01",
      "hash": "56a499a008e28dfe",
      "flags": 0,
      "text": "Waldesfluch"
    },
    {
      "index": 103,
      "id": "BTR_STATE_51_02",
      "hash": "56a498a008e28c4b",
      "flags": 0,
      "text": "Das Pokémon hat zusätzlich den Typ Pflanze\\nangenommen."
    },
    {
      "index": 104,
      "id": "BTR_STATE_52_01",
      "hash": "5b1bd9b6dc345ef1",
      "flags": 0,
      "text": "Egelsamen"
    },
    {
      "index": 105,
      "id": "BTR_STATE_52_02",
      "hash": "5b1bd6b6dc3459d8",
      "flags": 0,
      "text": "Das Pokémon verliert am Ende jeder Runde KP,\\nmit denen anschließend jenes Pokémon, das\\ndiese Attacke eingesetzt hat, geheilt wird."
    },
    {
      "index": 106,
      "id": "BTR_STATE_53_01",
      "hash": "2f154db07acb1f5c",
      "flags": 0,
      "text": "Zielschuss"
    },
    {
      "index": 107,
      "id": "BTR_STATE_53_02",
      "hash": "2f1550b07acb2475",
      "flags": 0,
      "text": "Der nächste Angriff auf das Pokémon, auf das\\nZielschuss angewendet wurde, trifft garantiert."
    },
    {
      "index": 108,
      "id": "BTR_STATE_54_01",
      "hash": "fd6fdd86c1916e57",
      "flags": 0,
      "text": "Umschlingung"
    },
    {
      "index": 109,
      "id": "BTR_STATE_54_02",
      "hash": "fd6fde86c191700a",
      "flags": 0,
      "text": "Das Pokémon wurde umschlungen und\\nnimmt in jeder Runde Schaden."
    },
    {
      "index": 110,
      "id": "BTR_STATE_55_01",
      "hash": "52b9917cb28526e2",
      "flags": 0,
      "text": "Geduld"
    },
    {
      "index": 111,
      "id": "BTR_STATE_55_02",
      "hash": "52b9907cb285252f",
      "flags": 0,
      "text": "Das Pokémon erduldet zwei Runden lang\\ngegnerische Angriffe. Dann schlägt es mit\\ndoppelt so viel Schaden zurück, wie es selbst\\nerlitten hat."
    },
    {
      "index": 112,
      "id": "BTR_STATE_56_01",
      "hash": "81231194bf7aaa35",
      "flags": 0,
      "text": "Wutanfall"
    },
    {
      "index": 113,
      "id": "BTR_STATE_56_02",
      "hash": "81230e94bf7aa51c",
      "flags": 0,
      "text": "Das Pokémon schlägt zwei bis drei Runden lang\\nwild um sich. Danach ist es verwirrt."
    },
    {
      "index": 114,
      "id": "BTR_STATE_57_01",
      "hash": "2976c58d22fb4a40",
      "flags": 0,
      "text": "Fuchtler"
    },
    {
      "index": 115,
      "id": "BTR_STATE_57_02",
      "hash": "2976c88d22fb4f59",
      "flags": 0,
      "text": "Das Pokémon schlägt zwei bis drei Runden lang\\nwild um sich. Danach ist es verwirrt."
    },
    {
      "index": 116,
      "id": "BTR_STATE_58_01",
      "hash": "e2ba15e8307b01eb",
      "flags": 0,
      "text": "Blättertanz"
    },
    {
      "index": 117,
      "id": "BTR_STATE_58_02",
      "hash": "e2ba16e8307b039e",
      "flags": 0,
      "text": "Das Pokémon schlägt zwei bis drei Runden lang\\nwild um sich. Danach ist es verwirrt."
    },
    {
      "index": 118,
      "id": "BTR_STATE_59_01",
      "hash": "8c5449e095113e16",
      "flags": 0,
      "text": "Schwere Vergiftung"
    },
    {
      "index": 119,
      "id": "BTR_STATE_59_02",
      "hash": "8c5448e095113c63",
      "flags": 0,
      "text": "Das Pokémon ist schwer vergiftet. Es erleidet\\nam Ende jeder Runde etwas mehr Schaden."
    },
    {
      "index": 120,
      "id": "BTR_STATE_60_01",
      "hash": "5d592a13a8f43f36",
      "flags": 0,
      "text": "Zukunftsattacke"
    },
    {
      "index": 121,
      "id": "BTR_STATE_60_02",
      "hash": "5d592913a8f43d83",
      "flags": 0,
      "text": "Das Pokémon nimmt zwei Züge, nachdem der\\nGegner eine bestimmte Attacke eingesetzt hat,\\nSchaden."
    },
    {
      "index": 122,
      "id": "BTR_STATE_61_01",
      "hash": "5f00f618d05dd40b",
      "flags": 0,
      "text": "Aufruhr"
    },
    {
      "index": 123,
      "id": "BTR_STATE_61_02",
      "hash": "5f00f718d05dd5be",
      "flags": 0,
      "text": "Das Pokémon schlägt drei Runden lang wild um\\nsich. In diesem Zeitraum können keine Pokémon\\neinschlafen."
    },
    {
      "index": 124,
      "id": "BTR_STATE_62_01",
      "hash": "3482fe2419c69154",
      "flags": 0,
      "text": "Wasserring"
    },
    {
      "index": 125,
      "id": "BTR_STATE_62_02",
      "hash": "3483012419c6966d",
      "flags": 0,
      "text": "Das Pokémon hat sich mit einem Schleier aus\\nWasser umgeben. Dies führt dazu, dass seine\\nKP in jeder Runde leicht aufgefüllt werden."
    },
    {
      "index": 126,
      "id": "BTR_STATE_63_01",
      "hash": "8c2f2a2bb645bae9",
      "flags": 0,
      "text": "Autotomie"
    },
    {
      "index": 127,
      "id": "BTR_STATE_63_02",
      "hash": "8c2f272bb645b5d0",
      "flags": 0,
      "text": "Das Pokémon ist leichter geworden und seine\\nInitiative ist stark gestiegen."
    },
    {
      "index": 128,
      "id": "BTR_STATE_64_01",
      "hash": "2d5c01ef1724f5ba",
      "flags": 0,
      "text": "Katapult"
    },
    {
      "index": 129,
      "id": "BTR_STATE_64_02",
      "hash": "2d5c00ef1724f407",
      "flags": 0,
      "text": "Das Pokémon wurde hoch in die Luft\\nkatapultiert und ist danach zu Boden\\ngefallen."
    },
    {
      "index": 130,
      "id": "BTR_STATE_65_01",
      "hash": "02ddedfa608d836f",
      "flags": 0,
      "text": "Feenschloss"
    },
    {
      "index": 131,
      "id": "BTR_STATE_65_02",
      "hash": "02ddeefa608d8522",
      "flags": 0,
      "text": "Alle Pokémon werden in dieser Runde an\\nder Flucht gehindert."
    },
    {
      "index": 132,
      "id": "BTR_STATE_66_01",
      "hash": "5a89b601fd0c0318",
      "flags": 0,
      "text": "Regenbogen"
    },
    {
      "index": 133,
      "id": "BTR_STATE_66_02",
      "hash": "5a89b901fd0c0831",
      "flags": 0,
      "text": "Zusatzeffekte werden öfter ausgelöst."
    },
    {
      "index": 134,
      "id": "BTR_STATE_67_01",
      "hash": "8690c2085e761c2d",
      "flags": 0,
      "text": "Sumpf"
    },
    {
      "index": 135,
      "id": "BTR_STATE_67_02",
      "hash": "8690bf085e761714",
      "flags": 0,
      "text": "Die Initiative des Pokémon ist um 75 %\\ngesunken."
    },
    {
      "index": 136,
      "id": "BTR_STATE_68_01",
      "hash": "d2ebf9d0a8c6399e",
      "flags": 0,
      "text": "Meer aus Feuer"
    },
    {
      "index": 137,
      "id": "BTR_STATE_68_02",
      "hash": "d2ebf8d0a8c637eb",
      "flags": 0,
      "text": "Bis auf Feuer-Pokémon nehmen die Pokémon auf\\nder betroffenen Seite in jeder Runde Schaden."
    },
    {
      "index": 138,
      "id": "BTR_STATE_69_01",
      "hash": "28e4a5d843d2f533",
      "flags": 0,
      "text": "Gleißende Sonne"
    },
    {
      "index": 139,
      "id": "BTR_STATE_69_02",
      "hash": "28e4a6d843d2f6e6",
      "flags": 0,
      "text": "Es herrscht sehr starkes Sonnenlicht. Die Stärke\\nvon Feuer-Attacken ist gestiegen und Attacken\\nvom Typ Wasser sind wirkungslos."
    },
    {
      "index": 140,
      "id": "BTR_STATE_70_01",
      "hash": "cc2c4a4893958499",
      "flags": 0,
      "text": "Strömender Regen"
    },
    {
      "index": 141,
      "id": "BTR_STATE_70_02",
      "hash": "cc2c474893957f80",
      "flags": 0,
      "text": "Es herrscht strömender Regen. Die Stärke von\\nWasser-Attacken ist gestiegen und Attacken\\nvom Typ Feuer sind wirkungslos."
    },
    {
      "index": 142,
      "id": "BTR_STATE_71_01",
      "hash": "f7175e3d4a89c8c4",
      "flags": 0,
      "text": "Luftströmungen"
    },
    {
      "index": 143,
      "id": "BTR_STATE_71_02",
      "hash": "f717613d4a89cddd",
      "flags": 0,
      "text": "Es herrschen rätselhafte Luftströmungen.\\nDie Stärke von Attacken, die gegen\\nFlug-Pokémon sehr effektiv sind, sinkt."
    },
    {
      "index": 144,
      "id": "BTR_STATE_72_01",
      "hash": "a0b19635af200bbb",
      "flags": 0,
      "text": "Psychofeld"
    },
    {
      "index": 145,
      "id": "BTR_STATE_72_02",
      "hash": "a0b19735af200d6e",
      "flags": 0,
      "text": "Attacken mit hoher Erstschlagquote verfehlen\\nfünf Runden lang alle Pokémon, die sich am\\nBoden befinden. Außerdem ist die Stärke von\\nPsycho-Attacken gestiegen."
    },
    {
      "index": 146,
      "id": "BTR_STATE_73_01",
      "hash": "72f78a2f4c445e26",
      "flags": 0,
      "text": "Neck Strike"
    },
    {
      "index": 147,
      "id": "BTR_STATE_73_02",
      "hash": "72f7892f4c445c73",
      "flags": 0,
      "text": "Es können zwei Runden lang keine Attacken\\neingesetzt werden, die Klänge erzeugen."
    },
    {
      "index": 148,
      "id": "BTR_STATE_74_01",
      "hash": "c84162253d3853dd",
      "flags": 0,
      "text": "Auroraschleier"
    },
    {
      "index": 149,
      "id": "BTR_STATE_74_02",
      "hash": "c8415f253d384ec4",
      "flags": 0,
      "text": "Die Stärke von physischen Attacken sowie\\nSpezial-Attacken wird fünf Runden lang halbiert."
    },
    {
      "index": 150,
      "id": "BTR_STATE_75_01",
      "hash": "9c3a561edbce3ac8",
      "flags": 0,
      "text": "Konzentration"
    },
    {
      "index": 151,
      "id": "BTR_STATE_75_02",
      "hash": "9c3a591edbce3fe1",
      "flags": 0,
      "text": "Die Attacke, die in der Runde nach dem Einsatz\\nvon Konzentration ausgeführt wird, wird ein\\nVolltreffer."
    },
    {
      "index": 152,
      "id": "BTR_STATE_76_01",
      "hash": "c5724e139150badf",
      "flags": 0,
      "text": "[~ 152]"
    },
    {
      "index": 153,
      "id": "BTR_STATE_76_02",
      "hash": "c5724f139150bc92",
      "flags": 0,
      "text": "[~ 153]"
    },
    {
      "index": 154,
      "id": "BTR_STATE_77_01",
      "hash": "6f0ca20bf5e72d6a",
      "flags": 0,
      "text": "[~ 154]"
    },
    {
      "index": 155,
      "id": "BTR_STATE_77_02",
      "hash": "6f0ca10bf5e72bb7",
      "flags": 0,
      "text": "[~ 155]"
    },
    {
      "index": 156,
      "id": "BTR_STATE_78_01",
      "hash": "41bf9a0593685881",
      "flags": 0,
      "text": "[~ 156]"
    },
    {
