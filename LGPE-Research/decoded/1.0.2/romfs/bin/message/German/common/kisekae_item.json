    {
      "index": 178,
      "id": "kisekae_item_shop_01",
      "hash": "0761ff1f93abba5b",
      "flags": 0,
      "text": "Herzlich willkommen!\\nWomit kann ich dir weiterhelfen?"
    },
    {
      "index": 179,
      "id": "kisekae_item_shop_02",
      "hash": "0762001f93abbc0e",
      "flags": 0,
      "text": "Oh, Moment. Du hast ja schon unser ganzes\\nSortiment aufgekauft!"
    },
    {
      "index": 180,
      "id": "kisekae_item_shop_03",
      "hash": "0762011f93abbdc1",
      "flags": 0,
      "text": "[VAR STYLEITEM(0001)]?\\nDafür bekomme ich [VAR NUM6(0002,002E)] ₽!"
    },
    {
      "index": 181,
      "id": "kisekae_item_shop_04",
      "hash": "0762021f93abbf74",
      "flags": 0,
      "text": "Ist gekauft!"
    },
    {
      "index": 182,
      "id": "kisekae_item_shop_05",
      "hash": "0762031f93abc127",
      "flags": 0,
      "text": "Ich hab’s mir anders überlegt."
    },
    {
      "index": 183,
      "id": "kisekae_item_shop_06",
      "hash": "0762041f93abc2da",
      "flags": 0,
      "text": "Vielen Dank für deinen Einkauf!"
    },
    {
      "index": 184,
      "id": "kisekae_item_shop_07",
      "hash": "0762051f93abc48d",
      "flags": 0,
      "text": "Du verstaust deinen Einkauf im Klamottenkoffer."
    },
    {
      "index": 185,
      "id": "kisekae_item_shop_08",
      "hash": "0761f61f93abab10",
      "flags": 0,
      "text": "Vielen Dank für deinen Besuch!"
    },
    {
      "index": 186,
      "id": "kisekae_item_shop_09",
      "hash": "0761f71f93abacc3",
      "flags": 0,
      "text": "Oh! Tut mir leid, aber ich fürchte, dafür reicht\\ndein Geld nicht aus..."
    },
