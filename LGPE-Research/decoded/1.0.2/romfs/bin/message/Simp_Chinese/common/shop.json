    },
    {
      "index": 10,
      "id": "msg_shop_04_01",
      "hash": "9860e793540f2c42",
      "flags": 0,
      "text": "退出"
    },
    {
      "index": 11,
      "id": "msg_shop_04_02",
      "hash": "9860e693540f2a8f",
      "flags": 0,
      "text": "购买"
    },
    {
      "index": 12,
      "id": "msg_shop_04_03",
      "hash": "9860e593540f28dc",
      "flags": 0,
      "text": "持有数　[VAR NUM3(0000)]"
    },
    {
      "index": 13,
      "id": "msg_shop_06_01",
      "hash": "1c139ba151f78ea0",
      "flags": 0,
      "text": "请拿好。\\n谢谢惠顾。"
    },
    {
      "index": 14,
      "id": "msg_shop_06_02",
      "hash": "1c139ea151f793b9",
      "flags": 0,
      "text": "您的钱不够呢！"
    },
    {
      "index": 15,
      "id": "msg_shop_06_03",
      "hash": "1c139da151f79206",
      "flags": 0,
      "text": "您已经拿不下了呢！"
    },
    {
      "index": 16,
      "id": "msg_shop_07_02",
      "hash": "c6c9e4ab6103d0fc",
      "flags": 0,
      "text": "是"
    },
    {
      "index": 17,
      "id": "msg_shop_07_03",
      "hash": "c6c9e5ab6103d2af",
      "flags": 0,
      "text": "否"
    },
    {
      "index": 18,
      "id": "msg_shop_10_01",
      "hash": "63578fe6ae819bc1",
      "flags": 0,
      "text": "欢迎光临！\\n请问您想要什么？"
    },
    {
      "index": 19,
      "id": "msg_shop_p01",
      "hash": "d39f6a6a74c086a7",
      "flags": 0,
      "text": "[~ 19]"
    },
    {
      "index": 20,
      "id": "msg_shop_10_02",
      "hash": "63578ce6ae8196a8",
      "flags": 0,
      "text": "购买"
    },
    {
      "index": 21,
      "id": "msg_shop_10_03",
      "hash": "63578de6ae81985b",
      "flags": 0,
      "text": "出售"
    },
    {
      "index": 22,
      "id": "msg_shop_10_04",
      "hash": "635792e6ae81a0da",
      "flags": 0,
      "text": "什么也不需要"
    },
    {
      "index": 23,
      "id": "msg_shop_10_05",
      "hash": "635793e6ae81a28d",
      "flags": 0,
      "text": "欢迎再次光临！"
    },
    {
      "index": 24,
      "id": "msg_shop_10_06",
      "hash": "635790e6ae819d74",
      "flags": 0,
      "text": "还有什么其他需要吗？"
    },
    {
      "index": 25,
      "id": "msg_shop_11_01",
      "hash": "61af43e187172d6c",
      "flags": 0,
      "text": "[~ 25]"
    },
    {
      "index": 26,
      "id": "msg_shop_12_01",
      "hash": "8c2d3bd63dae7023",
      "flags": 0,
      "text": "是[VAR ITEM2(0000)]啊。\\n[VAR NUM2(0001)]个一共₽[VAR NUM7(0002,0000)]，可以吗？"
    },
    {
      "index": 27,
      "id": "msg_shop_12_02",
      "hash": "8c2d3cd63dae71d6",
      "flags": 0,
      "text": "是[VAR ITEM2(0000)]啊。\\n[VAR NUM2(0001)]个一共₽[VAR NUM7(0002,0000)]，可以吗？"
    },
    {
      "index": 28,
      "id": "msg_shop_13_01",
      "hash": "5ee04fcfdb2fcace",
      "flags": 0,
      "text": "将[VAR ITEM2(0000)]放入了\\n[VAR COLOR(0006)][VAR BAG(0001)][VAR COLOR(0000)]。"
    },
    {
      "index": 29,
      "id": "mes_shop_13_02",
      "hash": "16870383c05fcf3d",
      "flags": 0,
      "text": "还要多送[VAR NUM2(0000)]个纪念球给您哦！"
    },
    {
      "index": 30,
      "id": "mes_shop_14_01",
      "hash": "e694f05a089850bf",
      "flags": 0,
      "text": "[~ 30]"
