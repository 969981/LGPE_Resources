      "text": "₽[VAR NUM7(0000,0000)]"
    },
    {
      "index": 6,
      "id": "msg_shop_03_02",
      "hash": "4db8accb0b309e38",
      "flags": 0,
      "text": "₽[VAR NUM5(0000,0000)]"
    },
    {
      "index": 7,
