    },
    {
      "index": 37,
      "id": "poke_get_10_08",
      "hash": "fe23db2622a1e0d6",
      "flags": 0,
      "text": "同步捕获"
    },
    {
      "index": 38,
      "id": "poke_get_10_09",
      "hash": "fe23dc2622a1e289",
      "flags": 0,
