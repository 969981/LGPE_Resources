    },
    {
      "index": 35,
      "id": "poke_get_10_06",
      "hash": "fe23e52622a1f1d4",
      "flags": 0,
      "text": ""
    },
    {
      "index": 36,
      "id": "poke_get_10_07",
      "hash": "fe23e62622a1f387",
      "flags": 0,
