      "flags": 0,
      "text": ""
    },
    {
      "index": 2,
      "id": "TOWNMAP_01_01",
      "hash": "adebed59f5f814d9",
      "flags": 0,
      "text": "凌空渡"
    },
    {
      "index": 3,
      "id": "TOWNMAP_01_02",
      "hash": "adebea59f5f80fc0",
      "flags": 0,
      "text": "退出"
    },
    {
      "index": 4,
      "id": "TOWNMAP_01_03",
      "hash": "adebeb59f5f81173",
      "flags": 0,
      "text": "切换宝可梦"
    },
    {
      "index": 5,
      "id": "TOWNMAP_02_01",
      "hash": "54b72d40aea6ee66",
      "flags": 0,
      "text": "← → 切换宝可梦"
    },
    {
      "index": 6,
      "id": "TOWNMAP_05_01",
      "hash": "537c053b87998f1d",
      "flags": 0,
      "text": "要使用秘术“凌空渡”\\n飞到[VAR LOCATION(0000)]吗？"
    },
    {
      "index": 7,
      "id": "TOWNMAP_05_02",
      "hash": "537c023b87998a04",
      "flags": 0,
      "text": "是"
    },
    {
      "index": 8,
      "id": "TOWNMAP_05_03",
      "hash": "537c033b87998bb7",
      "flags": 0,
      "text": "否"
    },
    {
      "index": 9,
      "id": "TOWNMAP_10_01",
      "hash": "c7de207c7f324b27",
      "flags": 0,
      "text": "[VAR LOCATION(0000)]"
    },
    {
      "index": 10,
      "id": "TOWNMAP_20_01",
      "hash": "9e9ac914d7a1ec8a",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]的栖息地"
    },
    {
      "index": 11,
      "id": "TOWNMAP_20_02",
      "hash": "9e9ac814d7a1ead7",
      "flags": 0,
      "text": "栖息地　不明"
    },
    {
      "index": 12,
      "id": "TM_GUIDE_01",
      "hash": "de793f7747865099",
      "flags": 0,
      "text": "植物生长茂盛，\\n让人恬然自得的乡间道路。"
    },
    {
      "index": 13,
      "id": "TM_GUIDE_02",
      "hash": "de793c7747864b80",
      "flags": 0,
      "text": "通往常青森林，\\n有着很多台阶的道路。"
    },
    {
      "index": 14,
      "id": "TM_GUIDE_03",
      "hash": "de793d7747864d33",
      "flags": 0,
      "text": "散落着许多大岩石的\\n山边草径。"
    },
    {
      "index": 15,
      "id": "TM_GUIDE_04",
      "hash": "de794277478655b2",
      "flags": 0,
      "text": "通往月见山坡道。\\n往下走到华蓝市后就回不去了。"
    },
    {
      "index": 16,
      "id": "TM_GUIDE_05",
      "hash": "de79437747865765",
      "flags": 0,
      "text": "较为平缓的坡道。\\n那里有通往地下通道的入口。"
    },
    {
      "index": 17,
      "id": "TM_GUIDE_06",
      "hash": "de7940774786524c",
      "flags": 0,
      "text": "连接着枯叶市和金黄市的道路。\\n那里有通往地下通道的入口。"
    },
    {
      "index": 18,
      "id": "TM_GUIDE_07",
      "hash": "de794177478653ff",
      "flags": 0,
      "text": "一条较短的道路。\\n那里有通往８号道路的地下通道。"
    },
    {
      "index": 19,
      "id": "TM_GUIDE_08",
      "hash": "de79467747865c7e",
      "flags": 0,
      "text": "一条较短的道路。\\n那里有通往７号道路的地下通道。"
    },
    {
      "index": 20,
      "id": "TM_GUIDE_09",
      "hash": "de79477747865e31",
      "flags": 0,
      "text": "台阶较多的道路，\\n同时也是孩子们的游乐场。"
    },
    {
      "index": 21,
      "id": "TM_GUIDE_10",
      "hash": "de7cc4774789686f",
      "flags": 0,
      "text": "沿着运河的道路。\\n那里有着岩山隧道的入口。"
    },
    {
      "index": 22,
      "id": "TM_GUIDE_11",
      "hash": "de7cc377478966bc",
      "flags": 0,
      "text": "训练家云集的草地。\\n那里有着通往地鼠洞穴的入口。"
    },
    {
      "index": 23,
      "id": "TM_GUIDE_12",
      "hash": "de7cc67747896bd5",
      "flags": 0,
      "text": "垂钓者云集的栈桥。\\n也被称为寂静桥。"
    },
    {
      "index": 24,
      "id": "TM_GUIDE_13",
      "hash": "de7cc57747896a22",
      "flags": 0,
      "text": "清爽宜人的沿海道路。\\n部分路段变成了迷宫。"
    },
    {
      "index": 25,
      "id": "TM_GUIDE_14",
      "hash": "de7cc077478961a3",
      "flags": 0,
      "text": "海边宽阔的林荫道。\\n在那里能感受到清新怡人的海风。"
    },
    {
      "index": 26,
      "id": "TM_GUIDE_15",
      "hash": "de7cbf7747895ff0",
      "flags": 0,
      "text": "一条笔直地通往浅红市\\n东侧的长长草径。"
    },
    {
      "index": 27,
      "id": "TM_GUIDE_16",
      "hash": "de7cc27747896509",
      "flags": 0,
      "text": "宝可梦大道北侧的道路。\\n那里一直热闹非凡。"
    },
    {
      "index": 28,
      "id": "TM_GUIDE_17",
      "hash": "de7cc17747896356",
      "flags": 0,
      "text": "能让宝可梦和训练家享受\\n散步乐趣的宝可梦大道。"
    },
    {
      "index": 29,
      "id": "TM_GUIDE_18",
      "hash": "de7ccc7747897607",
      "flags": 0,
      "text": "位于宝可梦大道以南。\\n那里有着许多热衷于对战的训练家。"
    },
    {
      "index": 30,
      "id": "TM_GUIDE_19",
      "hash": "de7ccb7747897454",
      "flags": 0,
      "text": "人气很高的游泳地点。\\n还能在海滩上享受日光浴。"
    },
    {
      "index": 31,
      "id": "TM_GUIDE_20",
      "hash": "de72d27747812bb4",
      "flags": 0,
      "text": "被矗立在中央的双子岛\\n一分为二的海洋。"
    },
    {
      "index": 32,
      "id": "TM_GUIDE_21",
      "hash": "de72d37747812d67",
      "flags": 0,
      "text": "因受到火山的影响，\\n水温有些偏高的海路。"
    },
    {
      "index": 33,
      "id": "TM_GUIDE_22",
      "hash": "de72d47747812f1a",
      "flags": 0,
      "text": "一条铺着地砖，笔直通往\\n宝可梦联盟的道路。"
    },
    {
      "index": 34,
      "id": "TM_GUIDE_23",
      "hash": "de72d577478130cd",
      "flags": 0,
      "text": "只有强大的训练家\\n才能通过的山路。"
    },
    {
      "index": 35,
      "id": "TM_GUIDE_24",
      "hash": "de72ce77478124e8",
      "flags": 0,
      "text": "位于华蓝市以北。\\n以水路上那座金光闪闪的桥闻名。"
    },
    {
      "index": 36,
      "id": "TM_GUIDE_25",
      "hash": "de72cf774781269b",
      "flags": 0,
      "text": "通过栽植树木建造而成的\\n通往海角的迷宫道路。"
    },
    {
      "index": 37,
      "id": "TM_GUIDE_26",
      "hash": "de72d0774781284e",
      "flags": 0,
      "text": "乡间小镇。\\n宝可梦研究所就在那里。"
    },
    {
      "index": 38,
      "id": "TM_GUIDE_27",
      "hash": "de72d17747812a01",
      "flags": 0,
      "text": "热爱大自然，\\n一年四季鲜花盛开的城镇。"
    },
    {
      "index": 39,
      "id": "TM_GUIDE_28",
      "hash": "de72ca7747811e1c",
      "flags": 0,
      "text": "延伸到巨大岩石\\n山脚下的石城。"
    },
    {
      "index": 40,
      "id": "TM_GUIDE_29",
      "hash": "de72cb7747811fcf",
      "flags": 0,
      "text": "水路环绕，拥有水属性道馆\\n以及丰富水资源的城镇。"
    },
    {
      "index": 41,
      "id": "TM_GUIDE_30",
      "hash": "de75d87747836bbd",
      "flags": 0,
      "text": "一个有着宝可梦坟墓，\\n宁静而庄严的城镇。"
    },
    {
      "index": 42,
      "id": "TM_GUIDE_31",
      "hash": "de75d77747836a0a",
      "flags": 0,
      "text": "连豪华游轮也会来此的\\n国际港口城市。"
    },
    {
      "index": 43,
      "id": "TM_GUIDE_32",
      "hash": "de75d67747836857",
      "flags": 0,
      "text": "多代人共同生活的城镇。\\n百货公司就在这里。"
    },
    {
      "index": 44,
      "id": "TM_GUIDE_33",
      "hash": "de75d577478366a4",
      "flags": 0,
      "text": "狩猎地带所在的城镇。\\n里面挤满了宝可梦和人。"
    },
    {
      "index": 45,
      "id": "TM_GUIDE_34",
      "hash": "de75d477478364f1",
      "flags": 0,
      "text": "建造在火山岛上的城镇。\\n里面有的屋子已经成了废墟。"
    },
    {
      "index": 46,
      "id": "TM_GUIDE_35",
      "hash": "de75d3774783633e",
      "flags": 0,
      "text": "矗立着最高机构\\n宝可梦联盟本部的高原。"
    },
    {
      "index": 47,
      "id": "TM_GUIDE_36",
      "hash": "de75d2774783618b",
      "flags": 0,
      "text": "高楼林立，关都地区\\n首屈一指的城市。"
    },
    {
      "index": 48,
      "id": "TM_GUIDE_37",
      "hash": "de75d17747835fd8",
      "flags": 0,
      "text": "能够找到很多虫宝可梦的\\n广袤大森林。"
    },
    {
      "index": 49,
      "id": "TM_GUIDE_38",
      "hash": "de75d07747835e25",
      "flags": 0,
      "text": "流星坠落的高山。\\n在那里能找到化石。"
    },
    {
      "index": 50,
      "id": "TM_GUIDE_39",
      "hash": "de75cf7747835c72",
      "flags": 0,
      "text": "天然形成的大隧道。\\n里面漆黑无比，所以需要光源。"
    },
    {
      "index": 51,
      "id": "TM_GUIDE_40",
      "hash": "de6bc677477af8a2",
      "flags": 0,
      "text": "满是机器的工厂。\\n里面住着电属性的宝可梦。"
    },
    {
      "index": 52,
      "id": "TM_GUIDE_41",
      "hash": "de6bc777477afa55",
      "flags": 0,
      "text": "地鼠开挖出来的隧道。\\n是从深灰市前往枯叶市的近路。"
    },
    {
      "index": 53,
      "id": "TM_GUIDE_42",
      "hash": "de6bc477477af53c",
      "flags": 0,
      "text": "两座并排在一起的小岛。\\n内部无比惊人的寒冷。"
    },
    {
      "index": 54,
      "id": "TM_GUIDE_43",
      "hash": "de6bc577477af6ef",
      "flags": 0,
      "text": "险峻的洞窟。那里聚集着很多\\n以最强为目标的训练家。"
    },
    {
      "index": 55,
      "id": "TM_PLACE_COMMON_01",
      "hash": "8435be3e473a535c",
      "flags": 0,
      "text": "宝可梦中心"
    },
    {
      "index": 56,
      "id": "TM_PLACE_COMMON_02",
      "hash": "8435c13e473a5875",
      "flags": 0,
      "text": "友好商店"
    },
    {
      "index": 57,
      "id": "TM_PLACE_COMMON_05",
      "hash": "8435ba3e473a4c90",
      "flags": 0,
      "text": "宝可梦研究所"
    },
    {
      "index": 58,
      "id": "TM_PLACE_COMMON_06",
      "hash": "8435bd3e473a51a9",
      "flags": 0,
      "text": "训练家学校"
    },
    {
      "index": 59,
      "id": "TM_PLACE_COMMON_07",
      "hash": "8435bc3e473a4ff6",
      "flags": 0,
      "text": "宝可梦道馆"
    },
    {
      "index": 60,
      "id": "TM_PLACE_COMMON_09",
      "hash": "8435c63e473a60f4",
      "flags": 0,
      "text": "深灰科学博物馆"
    },
    {
      "index": 61,
      "id": "TM_PLACE_COMMON_12",
      "hash": "8432373e47373820",
      "flags": 0,
      "text": "宝可梦塔"
    },
    {
      "index": 62,
      "id": "TM_PLACE_COMMON_13",
      "hash": "8432383e473739d3",
      "flags": 0,
      "text": "宝可梦之家"
    },
    {
      "index": 63,
      "id": "TM_PLACE_COMMON_14",
      "hash": "84323d3e47374252",
      "flags": 0,
      "text": "姓名鉴定师"
    },
    {
      "index": 64,
      "id": "TM_PLACE_COMMON_16",
      "hash": "84323b3e47373eec",
      "flags": 0,
      "text": "枯叶港"
    },
    {
      "index": 65,
      "id": "TM_PLACE_COMMON_17",
      "hash": "84323c3e4737409f",
      "flags": 0,
      "text": "宝可梦发烧友俱乐部"
    },
    {
      "index": 66,
      "id": "TM_PLACE_COMMON_19",
      "hash": "8432423e47374ad1",
      "flags": 0,
      "text": "玉虹百货公司"
    },
    {
      "index": 67,
      "id": "TM_PLACE_COMMON_20",
      "hash": "842ed33e4734585d",
      "flags": 0,
      "text": "玉虹大厦"
    },
    {
      "index": 68,
      "id": "TM_PLACE_COMMON_21",
      "hash": "842ed23e473456aa",
      "flags": 0,
      "text": "火箭游戏城"
    },
    {
      "index": 69,
      "id": "TM_PLACE_COMMON_22",
      "hash": "842ed13e473454f7",
      "flags": 0,
      "text": "占卜师"
    },
    {
      "index": 70,
      "id": "TM_PLACE_COMMON_24",
      "hash": "842ecf3e47345191",
      "flags": 0,
      "text": "GO Park"
    },
    {
      "index": 71,
      "id": "TM_PLACE_COMMON_26",
      "hash": "842ecd3e47344e2b",
      "flags": 0,
      "text": "宝可梦屋"
    },
    {
      "index": 72,
      "id": "TM_PLACE_COMMON_27",
      "hash": "842ecc3e47344c78",
      "flags": 0,
      "text": "红莲研究所"
    },
    {
      "index": 73,
      "id": "TM_PLACE_COMMON_29",
      "hash": "842eca3e47344912",
      "flags": 0,
      "text": "西尔佛公司"
    },
    {
      "index": 74,
      "id": "TM_PLACE_COMMON_30",
      "hash": "842b4d3e47313ed4",
      "flags": 0,
      "text": "格斗道场"
    },
    {
      "index": 75,
      "id": "TM_PLACE_COMMON_31",
      "hash": "842b4e3e47314087",
      "flags": 0,
      "text": "搭档招式传授所"
    },
    {
      "index": 76,
      "id": "TM_PLACE_COMMON_32",
      "hash": "842b4f3e4731423a",
      "flags": 0,
      "text": "招式回忆处"
    },
    {
      "index": 77,
      "id": "TM_PLACE_COMMON_33",
