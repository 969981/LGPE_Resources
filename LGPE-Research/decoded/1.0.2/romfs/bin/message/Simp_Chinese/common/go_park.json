      "text": "[VAR NUM3(0000)]只"
    },
    {
      "index": 36,
      "id": "go_park_03_01",
      "hash": "5152aad5b4f235c2",
      "flags": 0,
      "text": "×[VAR NUM4(0000,0000)]"
    },
    {
      "index": 37,
      "id": "go_park_10_01",
      "hash": "0cf80ee3f10e4692",
      "flags": 0,
      "text": "退出"
    },
    {
      "index": 38,
      "id": "go_park_10_02",
      "hash": "0cf80de3f10e44df",
      "flags": 0,
      "text": "更改名字"
    },
    {
      "index": 39,
      "id": "go_park_10_03",
      "hash": "0cf80ce3f10e432c",
      "flags": 0,
      "text": "查看信息"
    },
    {
      "index": 40,
      "id": "go_park_20_01",
      "hash": "8b27a758d40dea4f",
      "flags": 0,
      "text": "请选择GO Park"
    },
    {
      "index": 41,
      "id": "go_park_20_02",
      "hash": "8b27a858d40dec02",
      "flags": 0,
      "text": "要去哪里？"
    },
    {
      "index": 42,
      "id": "go_park_20_03",
      "hash": "8b27a958d40dedb5",
      "flags": 0,
      "text": "要和哪里的宝可梦玩耍？"
    },
    {
      "index": 43,
      "id": "go_park_20_04",
      "hash": "8b27a258d40de1d0",
      "flags": 0,
      "text": "请选择要一起玩耍的宝可梦"
    },
    {
      "index": 44,
      "id": "go_park_20_05",
      "hash": "8b27a358d40de383",
      "flags": 0,
      "text": "在[VAR COLOR(0006)][VAR GOPARKLOCAL(0000)][VAR COLOR(0000)]里"
    },
    {
      "index": 45,
      "id": "go_park_20_06",
      "hash": "8b27a458d40de536",
      "flags": 0,
      "text": "要对[VAR GOPARKPKM(0000)]做什么？"
    },
    {
      "index": 46,
      "id": "go_park_25_01",
      "hash": "8f31e36fa702e296",
      "flags": 0,
      "text": "[VAR GOPARKLOCAL(0000)]里的宝可梦"
    },
    {
      "index": 47,
      "id": "go_park_25_02",
      "hash": "8f31e26fa702e0e3",
      "flags": 0,
      "text": "← → 切换GO Park"
    },
    {
      "index": 48,
      "id": "go_park_30_01",
      "hash": "1aa10723e7fa36ec",
      "flags": 0,
      "text": "已把它移动到\\n[VAR GOPARKLOCAL(0000)]！"
    },
    {
      "index": 49,
      "id": "go_park_40_01",
      "hash": "6e71df9790fa2fe9",
      "flags": 0,
      "text": "要再挑战一次吗？"
    },
    {
      "index": 50,
      "id": "go_park_40_02",
      "hash": "6e71dc9790fa2ad0",
      "flags": 0,
      "text": "是"
    },
    {
      "index": 51,
      "id": "go_park_40_03",
      "hash": "6e71dd9790fa2c83",
      "flags": 0,
      "text": "否"
    },
    {
      "index": 52,
      "id": "go_park_41_01",
      "hash": "16c5b38ff47b0654",
      "flags": 0,
      "text": "已暂停游戏。\\n要做什么？"
    },
    {
      "index": 53,
      "id": "go_park_41_02",
      "hash": "16c5b68ff47b0b6d",
      "flags": 0,
      "text": "继续游戏"
    },
    {
      "index": 54,
      "id": "go_park_41_03",
      "hash": "16c5b58ff47b09ba",
      "flags": 0,
      "text": "重来"
    },
    {
      "index": 55,
      "id": "go_park_41_04",
      "hash": "16c5b08ff47b013b",
      "flags": 0,
      "text": "离开游乐区"
    },
    {
      "index": 56,
      "id": "go_park_45_01",
      "hash": "3ccc6b6dd7c07818",
      "flags": 0,
      "text": "选择的宝可梦数量不足。\\n请往GO Park里寄放\\n25只宝可梦。"
    },
    {
      "index": 57,
      "id": "go_park_45_02",
      "hash": "3ccc6e6dd7c07d31",
      "flags": 0,
      "text": "想在游乐区玩耍的话，\\n请往GO Park里寄放\\n25只相同的宝可梦。"
    },
    {
      "index": 58,
      "id": "go_park_48_01",
      "hash": "0e636f55cacbd511",
      "flags": 0,
      "text": "完成时间"
    },
    {
      "index": 59,
      "id": "go_park_48_02",
      "hash": "0e636c55cacbcff8",
      "flags": 0,
      "text": "同时到达终点的数量"
    },
    {
      "index": 60,
      "id": "go_park_48_03",
      "hash": "0e636d55cacbd1ab",
      "flags": 0,
      "text": "[~ 60]"
    },
    {
      "index": 61,
      "id": "go_park_48_04",
      "hash": "0e637255cacbda2a",
      "flags": 0,
      "text": "本次的得分"
    },
    {
      "index": 62,
      "id": "go_park_49_01",
      "hash": "372e634a7ff17c7c",
      "flags": 0,
      "text": "[VAR NUM2(0000)]只"
    },
    {
      "index": 63,
      "id": "go_park_50_02",
      "hash": "fb41428dbfc4c353",
      "flags": 0,
      "text": "[VAR NUM4(0000,0000)]分"
    },
    {
      "index": 64,
      "id": "go_park_50_03",
      "hash": "fb41418dbfc4c1a0",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]的最高纪录"
    },
    {
      "index": 65,
      "id": "go_park_55_01",
      "hash": "a279077478cf9dbf",
      "flags": 0,
      "text": "要做什么？\\n[VAR COLOR(0006)]Ｙ：缩放[VAR COLOR(0000)]"
    },
    {
      "index": 66,
      "id": "go_park_55_02",
      "hash": "a279087478cf9f72",
      "flags": 0,
      "text": "写记录"
    },
    {
      "index": 67,
      "id": "go_park_55_03",
      "hash": "a279097478cfa125",
      "flags": 0,
      "text": "返回前台"
    },
    {
      "index": 68,
      "id": "go_park_55_05",
      "hash": "a279037478cf96f3",
      "flags": 0,
      "text": "查看信息"
    },
    {
      "index": 69,
      "id": "go_park_55_04",
      "hash": "a279027478cf9540",
      "flags": 0,
      "text": "什么都不做"
    },
    {
      "index": 70,
      "id": "go_park_55_06",
      "hash": "a279047478cf98a6",
      "flags": 0,
      "text": "获赠[VAR NUM3(0001)]个\\n[VAR ITEM2(0000)]！"
    },
    {
      "index": 71,
      "id": "go_park_55_07",
      "hash": "a279057478cf9a59",
      "flags": 0,
      "text": "放进了[VAR COLOR(0006)][VAR BAG(0001)][VAR COLOR(0000)]。"
    },
    {
      "index": 72,
      "id": "go_park_55_10",
      "hash": "a27c8c7478d2b595",
      "flags": 0,
      "text": "要写记录吗？"
    },
    {
      "index": 73,
      "id": "go_park_55_11",
      "hash": "a27c8b7478d2b3e2",
      "flags": 0,
      "text": "正在写入宝可梦记录……\\n请勿切断电源。"
    },
    {
      "index": 74,
      "id": "go_park_55_12",
      "hash": "a27c8a7478d2b22f",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]\\n完好地写下了记录！"
    },
    {
      "index": 75,
      "id": "go_park_55_13",
      "hash": "a27c897478d2b07c",
      "flags": 0,
      "text": "保存记录失败。"
    },
    {
      "index": 76,
      "id": "go_park_60_00",
      "hash": "248419f567544870",
      "flags": 0,
      "text": "[VAR GOPARKPKM(0000)]"
    },
    {
      "index": 77,
      "id": "go_park_60_01",
      "hash": "24841af567544a23",
      "flags": 0,
      "text": "CP　[VAR NUM5(0000,0000)]"
    },
    {
      "index": 78,
      "id": "go_park_60_02",
      "hash": "24841bf567544bd6",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]"
    },
    {
