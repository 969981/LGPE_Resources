{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "TOKUSEIINFO_000",
      "hash": "7ba40506d12f4b74",
      "flags": 0,
      "text": "―\\n―"
    },
    {
      "index": 1,
      "id": "TOKUSEIINFO_001",
      "hash": "7ba40606d12f4d27",
      "flags": 0,
      "text": "通过释放臭臭的气味，\\n在攻击的时候，\\n有时会使对手畏缩。"
    },
    {
      "index": 2,
      "id": "TOKUSEIINFO_002",
      "hash": "7ba40706d12f4eda",
      "flags": 0,
      "text": "出场时，\\n会将天气变为下雨。"
    },
    {
      "index": 3,
      "id": "TOKUSEIINFO_003",
      "hash": "7ba40806d12f508d",
      "flags": 0,
      "text": "每一回合速度会变快。"
    },
    {
      "index": 4,
      "id": "TOKUSEIINFO_004",
      "hash": "7ba40106d12f44a8",
      "flags": 0,
      "text": "被坚硬的甲壳守护着，\\n不会被对手的攻击击中要害。"
    },
    {
      "index": 5,
      "id": "TOKUSEIINFO_005",
      "hash": "7ba40206d12f465b",
      "flags": 0,
      "text": "即使受到对手的招式攻击，\\n也不会被一击打倒。\\n一击必杀的招式也没有效果。"
    },
    {
      "index": 6,
      "id": "TOKUSEIINFO_006",
      "hash": "7ba40306d12f480e",
      "flags": 0,
      "text": "通过把周围都弄湿，\\n使谁都无法使用自爆等爆炸类的招式。"
    },
    {
      "index": 7,
      "id": "TOKUSEIINFO_007",
      "hash": "7ba40406d12f49c1",
      "flags": 0,
      "text": "因为身体柔软，\\n不会变为麻痹状态。"
    },
    {
      "index": 8,
      "id": "TOKUSEIINFO_008",
      "hash": "7ba3fd06d12f3ddc",
      "flags": 0,
      "text": "在沙暴的时候，\\n闪避率会提高。"
    },
    {
      "index": 9,
      "id": "TOKUSEIINFO_009",
      "hash": "7ba3fe06d12f3f8f",
      "flags": 0,
      "text": "身上带有静电，\\n有时会让接触到的对手麻痹。"
    },
    {
      "index": 10,
      "id": "TOKUSEIINFO_010",
      "hash": "7ba70b06d1318b7d",
      "flags": 0,
      "text": "受到电属性的招式攻击时，\\n不会受到伤害，而是会回复。"
    },
    {
      "index": 11,
      "id": "TOKUSEIINFO_011",
      "hash": "7ba70a06d13189ca",
      "flags": 0,
      "text": "受到水属性的招式攻击时，\\n不会受到伤害，而是会回复。"
    },
    {
      "index": 12,
      "id": "TOKUSEIINFO_012",
      "hash": "7ba70906d1318817",
      "flags": 0,
      "text": "因为感觉迟钝，\\n不会变为着迷和被挑衅状态。"
    },
    {
      "index": 13,
      "id": "TOKUSEIINFO_013",
      "hash": "7ba70806d1318664",
      "flags": 0,
      "text": "任何天气的影响都会消失。"
    },
    {
      "index": 14,
      "id": "TOKUSEIINFO_014",
      "hash": "7ba70706d13184b1",
      "flags": 0,
      "text": "因为拥有复眼，\\n招式的命中率会提高。"
    },
    {
      "index": 15,
      "id": "TOKUSEIINFO_015",
      "hash": "7ba70606d13182fe",
      "flags": 0,
      "text": "因为是不会睡觉的体质，\\n所以不会变为睡眠状态。"
    },
    {
      "index": 16,
      "id": "TOKUSEIINFO_016",
      "hash": "7ba70506d131814b",
      "flags": 0,
      "text": "自己的属性会变为\\n从对手处所受招式的属性。"
    },
    {
      "index": 17,
      "id": "TOKUSEIINFO_017",
      "hash": "7ba70406d1317f98",
      "flags": 0,
      "text": "因为体内拥有免疫能力，\\n不会变为中毒状态。"
    },
    {
      "index": 18,
      "id": "TOKUSEIINFO_018",
      "hash": "7ba70306d1317de5",
      "flags": 0,
      "text": "受到火属性的招式攻击时，\\n吸收火焰，自己使出的\\n火属性招式会变强。"
    },
    {
      "index": 19,
      "id": "TOKUSEIINFO_019",
      "hash": "7ba70206d1317c32",
      "flags": 0,
      "text": "被鳞粉守护着，\\n不会受到招式的追加效果影响。"
    },
    {
      "index": 20,
      "id": "TOKUSEIINFO_020",
      "hash": "7baa7106d1346ea6",
      "flags": 0,
      "text": "因为我行我素，\\n不会变为混乱状态。"
    },
    {
      "index": 21,
      "id": "TOKUSEIINFO_021",
      "hash": "7baa7206d1347059",
      "flags": 0,
      "text": "用吸盘牢牢贴在地面上，\\n让替换宝可梦的招式和道具无效。"
    },
    {
      "index": 22,
      "id": "TOKUSEIINFO_022",
      "hash": "7baa6f06d1346b40",
      "flags": 0,
      "text": "出场时威吓对手，\\n让其退缩，\\n降低对手的攻击。"
    },
    {
      "index": 23,
      "id": "TOKUSEIINFO_023",
      "hash": "7baa7006d1346cf3",
      "flags": 0,
      "text": "踩住对手的影子\\n使其无法逃走或替换。"
    },
    {
      "index": 24,
      "id": "TOKUSEIINFO_024",
      "hash": "7baa7506d1347572",
      "flags": 0,
      "text": "受到攻击时，\\n用粗糙的皮肤弄伤\\n接触到自己的对手。"
    },
    {
      "index": 25,
      "id": "TOKUSEIINFO_025",
      "hash": "7baa7606d1347725",
      "flags": 0,
      "text": "不可思议的力量，\\n只有效果绝佳的招式才能击中。"
    },
    {
      "index": 26,
      "id": "TOKUSEIINFO_026",
      "hash": "7baa7306d134720c",
      "flags": 0,
      "text": "从地面浮起，\\n从而不会受到地面属性招式的攻击。"
    },
    {
      "index": 27,
      "id": "TOKUSEIINFO_027",
      "hash": "7baa7406d13473bf",
      "flags": 0,
      "text": "受到攻击时，\\n有时会把接触到自己的对手\\n变为中毒、麻痹或睡眠状态。"
    },
    {
      "index": 28,
      "id": "TOKUSEIINFO_028",
      "hash": "7baa7906d1347c3e",
      "flags": 0,
      "text": "将自己的中毒、麻痹\\n或灼伤状态传染给对手。"
    },
    {
      "index": 29,
      "id": "TOKUSEIINFO_029",
      "hash": "7baa7a06d1347df1",
      "flags": 0,
      "text": "不会因为对手的招式或特性\\n而被降低能力。"
    },
    {
      "index": 30,
      "id": "TOKUSEIINFO_030",
      "hash": "7badf706d137882f",
      "flags": 0,
      "text": "回到同行队伍后，\\n异常状态就会被治愈。"
    },
    {
      "index": 31,
      "id": "TOKUSEIINFO_031",
      "hash": "7badf606d137867c",
      "flags": 0,
      "text": "将电属性的招式吸引到自己身上，\\n不会受到伤害，而是会提高特攻。"
    },
    {
      "index": 32,
      "id": "TOKUSEIINFO_032",
      "hash": "7badf906d1378b95",
      "flags": 0,
      "text": "托天恩的福，\\n招式的追加效果容易出现。"
    },
    {
      "index": 33,
      "id": "TOKUSEIINFO_033",
      "hash": "7badf806d13789e2",
      "flags": 0,
      "text": "下雨天气时，\\n速度会提高。"
    },
    {
      "index": 34,
      "id": "TOKUSEIINFO_034",
      "hash": "7badf306d1378163",
      "flags": 0,
      "text": "晴朗天气时，\\n速度会提高。"
    },
    {
      "index": 35,
      "id": "TOKUSEIINFO_035",
      "hash": "7badf206d1377fb0",
      "flags": 0,
      "text": "通过让周围变亮，\\n变得容易遇到野生的宝可梦。"
    },
    {
      "index": 36,
      "id": "TOKUSEIINFO_036",
      "hash": "7badf506d13784c9",
      "flags": 0,
      "text": "出场时，复制对手的特性，\\n变为与之相同的特性。"
    },
    {
      "index": 37,
      "id": "TOKUSEIINFO_037",
      "hash": "7badf406d1378316",
      "flags": 0,
      "text": "物理攻击的威力会变为２倍。"
    },
    {
      "index": 38,
      "id": "TOKUSEIINFO_038",
      "hash": "7badff06d13795c7",
      "flags": 0,
      "text": "有时会让接触到自己的\\n对手变为中毒状态。"
    },
    {
      "index": 39,
      "id": "TOKUSEIINFO_039",
      "hash": "7badfe06d1379414",
      "flags": 0,
      "text": "通过锻炼精神，\\n不会因对手的攻击而畏缩。"
    },
    {
      "index": 40,
      "id": "TOKUSEIINFO_040",
      "hash": "7b966d06d123bed0",
      "flags": 0,
      "text": "将炽热的熔岩覆盖在身上，\\n不会变为冰冻状态。"
    },
    {
      "index": 41,
      "id": "TOKUSEIINFO_041",
      "hash": "7b966e06d123c083",
      "flags": 0,
      "text": "将水幕裹在身上，\\n不会变为灼伤状态。"
    },
    {
      "index": 42,
      "id": "TOKUSEIINFO_042",
      "hash": "7b966f06d123c236",
      "flags": 0,
      "text": "用磁力吸住钢属性的宝可梦，\\n使其无法逃走。"
    },
    {
      "index": 43,
      "id": "TOKUSEIINFO_043",
      "hash": "7b967006d123c3e9",
      "flags": 0,
      "text": "通过屏蔽声音，\\n不受到声音招式的攻击。"
    },
    {
      "index": 44,
      "id": "TOKUSEIINFO_044",
      "hash": "7b967106d123c59c",
      "flags": 0,
      "text": "下雨天气时，\\n会缓缓回复HP。"
    },
    {
      "index": 45,
      "id": "TOKUSEIINFO_045",
      "hash": "7b967206d123c74f",
      "flags": 0,
      "text": "出场时，\\n会把天气变为沙暴。"
    },
    {
      "index": 46,
      "id": "TOKUSEIINFO_046",
      "hash": "7b967306d123c902",
      "flags": 0,
      "text": "给予对手压迫感，\\n大量减少其使用招式的PP。"
    },
    {
      "index": 47,
      "id": "TOKUSEIINFO_047",
      "hash": "7b967406d123cab5",
      "flags": 0,
      "text": "因为被厚厚的脂肪保护着，\\n会让火属性和冰属性的招式伤害减半。"
    },
    {
      "index": 48,
      "id": "TOKUSEIINFO_048",
      "hash": "7b967506d123cc68",
      "flags": 0,
      "text": "即使变为睡眠状态，\\n也能以２倍的速度提早醒来。"
    },
    {
      "index": 49,
      "id": "TOKUSEIINFO_049",
      "hash": "7b967606d123ce1b",
      "flags": 0,
      "text": "有时会让接触到自己的\\n对手变为灼伤状态。"
    },
    {
      "index": 50,
      "id": "TOKUSEIINFO_050",
      "hash": "7b997306d125fed9",
      "flags": 0,
      "text": "一定能从野生宝可梦\\n那儿逃走。"
    },
    {
      "index": 51,
      "id": "TOKUSEIINFO_051",
      "hash": "7b997206d125fd26",
      "flags": 0,
      "text": "多亏了锐利的目光，\\n命中率不会被降低。"
    },
    {
      "index": 52,
      "id": "TOKUSEIINFO_052",
      "hash": "7b997106d125fb73",
      "flags": 0,
      "text": "因为拥有以力量自豪的钳子，\\n不会被对手降低攻击。"
    },
    {
      "index": 53,
      "id": "TOKUSEIINFO_053",
      "hash": "7b997006d125f9c0",
      "flags": 0,
      "text": "有时会捡来对手用过的道具，\\n冒险过程中也会捡到。"
    },
    {
      "index": 54,
      "id": "TOKUSEIINFO_054",
      "hash": "7b997706d12605a5",
      "flags": 0,
      "text": "如果使出招式，\\n下一回合就会休息。"
    },
    {
      "index": 55,
      "id": "TOKUSEIINFO_055",
      "hash": "7b997606d12603f2",
      "flags": 0,
      "text": "自己的攻击变高，\\n但命中率会降低。"
    },
    {
      "index": 56,
      "id": "TOKUSEIINFO_056",
      "hash": "7b997506d126023f",
      "flags": 0,
      "text": "有时会让接触到自己的对手着迷。"
    },
    {
      "index": 57,
      "id": "TOKUSEIINFO_057",
      "hash": "7b997406d126008c",
      "flags": 0,
      "text": "出场的伙伴之间\\n如果有正电或负电特性的宝可梦，\\n自己的特攻会提高。"
    },
    {
      "index": 58,
      "id": "TOKUSEIINFO_058",
      "hash": "7b997b06d1260c71",
      "flags": 0,
      "text": "出场的伙伴之间\\n如果有正电或负电特性的宝可梦，\\n自己的特攻会提高。"
    },
    {
      "index": 59,
      "id": "TOKUSEIINFO_059",
      "hash": "7b997a06d1260abe",
      "flags": 0,
      "text": "受天气的影响，\\n会变为水属性、火属性\\n或冰属性中的某一个。"
    },
    {
      "index": 60,
      "id": "TOKUSEIINFO_060",
      "hash": "7b9cf906d1291862",
      "flags": 0,
      "text": "因为道具是粘在黏性身体上的，\\n所以不会被对手夺走。"
    },
    {
      "index": 61,
      "id": "TOKUSEIINFO_061",
      "hash": "7b9cfa06d1291a15",
      "flags": 0,
      "text": "通过蜕去身上的皮，\\n有时会治愈异常状态。"
    },
    {
      "index": 62,
      "id": "TOKUSEIINFO_062",
      "hash": "7b9cf706d12914fc",
      "flags": 0,
      "text": "如果变为异常状态，\\n会拿出毅力，\\n攻击会提高。"
    },
    {
      "index": 63,
      "id": "TOKUSEIINFO_063",
      "hash": "7b9cf806d12916af",
      "flags": 0,
      "text": "如果变为异常状态，\\n神奇鳞片会发生反应，\\n防御会提高。"
    },
    {
      "index": 64,
      "id": "TOKUSEIINFO_064",
      "hash": "7b9cf506d1291196",
      "flags": 0,
      "text": "吸收了污泥浆的对手\\n会因强烈的恶臭\\n而受到伤害，减少HP。"
    },
    {
      "index": 65,
      "id": "TOKUSEIINFO_065",
      "hash": "7b9cf606d1291349",
      "flags": 0,
      "text": "HP减少的时候，\\n草属性的招式威力会提高。"
    },
    {
      "index": 66,
      "id": "TOKUSEIINFO_066",
      "hash": "7b9cf306d1290e30",
      "flags": 0,
      "text": "HP减少的时候，\\n火属性的招式威力会提高。"
    },
    {
      "index": 67,
      "id": "TOKUSEIINFO_067",
      "hash": "7b9cf406d1290fe3",
      "flags": 0,
      "text": "HP减少的时候，\\n水属性的招式威力会提高。"
    },
    {
      "index": 68,
      "id": "TOKUSEIINFO_068",
      "hash": "7b9d0106d12925fa",
      "flags": 0,
      "text": "HP减少的时候，\\n虫属性的招式威力会提高。"
    },
    {
      "index": 69,
      "id": "TOKUSEIINFO_069",
      "hash": "7b9d0206d12927ad",
      "flags": 0,
      "text": "即使使出会受反作用力伤害的招式，\\nHP也不会减少。"
    },
    {
      "index": 70,
      "id": "TOKUSEIINFO_070",
      "hash": "7ba07f06d12c31eb",
      "flags": 0,
      "text": "出场时，\\n会将天气变为晴朗。"
    },
    {
      "index": 71,
      "id": "TOKUSEIINFO_071",
      "hash": "7ba07e06d12c3038",
      "flags": 0,
      "text": "在战斗中让对手无法逃走。"
    },
    {
      "index": 72,
      "id": "TOKUSEIINFO_072",
      "hash": "7ba08106d12c3551",
      "flags": 0,
      "text": "通过激发出干劲，\\n不会变为睡眠状态。"
    },
    {
      "index": 73,
      "id": "TOKUSEIINFO_073",
      "hash": "7ba08006d12c339e",
      "flags": 0,
      "text": "被白色烟雾保护着，\\n不会被对手降低能力。"
    },
    {
      "index": 74,
      "id": "TOKUSEIINFO_074",
      "hash": "7ba08306d12c38b7",
      "flags": 0,
      "text": "因瑜伽的力量，\\n物理攻击的威力会变为２倍。"
    },
    {
      "index": 75,
      "id": "TOKUSEIINFO_075",
      "hash": "7ba08206d12c3704",
      "flags": 0,
      "text": "被坚硬的壳保护着，\\n对手的攻击不会击中要害。"
    },
    {
      "index": 76,
      "id": "TOKUSEIINFO_076",
      "hash": "7ba08506d12c3c1d",
      "flags": 0,
      "text": "所有天气的影响都会消失。"
    },
    {
      "index": 77,
      "id": "TOKUSEIINFO_077",
      "hash": "7ba08406d12c3a6a",
      "flags": 0,
      "text": "在混乱状态时，\\n闪避率会提高。"
    },
    {
      "index": 78,
      "id": "TOKUSEIINFO_078",
      "hash": "7ba07706d12c2453",
      "flags": 0,
      "text": "受到电属性的招式攻击时，\\n不会受到伤害，而是速度会提高。"
    },
    {
      "index": 79,
      "id": "TOKUSEIINFO_079",
      "hash": "7ba07606d12c22a0",
      "flags": 0,
      "text": "面对性别相同的对手，\\n会燃起斗争心，变得更强。\\n而面对性别不同的，则会变弱。"
    },
    {
      "index": 80,
      "id": "TOKUSEIINFO_080",
      "hash": "7bbef506d145f7fc",
      "flags": 0,
      "text": "每次畏缩时，\\n不屈之心就会燃起，\\n速度也会提高。"
    },
    {
      "index": 81,
      "id": "TOKUSEIINFO_081",
      "hash": "7bbef606d145f9af",
      "flags": 0,
      "text": "冰雹天气时，\\n闪避率会提高。"
    },
    {
      "index": 82,
      "id": "TOKUSEIINFO_082",
      "hash": "7bbef706d145fb62",
      "flags": 0,
      "text": "原本HP变得很少时才会吃树果，\\n在HP还有一半时就会把它吃掉。"
    },
    {
      "index": 83,
      "id": "TOKUSEIINFO_083",
      "hash": "7bbef806d145fd15",
      "flags": 0,
      "text": "要害被击中时，\\n会大发雷霆，\\n攻击力变为最大。"
    },
    {
      "index": 84,
      "id": "TOKUSEIINFO_084",
      "hash": "7bbef106d145f130",
      "flags": 0,
      "text": "失去所持有的道具时，\\n速度会提高。"
    },
    {
      "index": 85,
      "id": "TOKUSEIINFO_085",
      "hash": "7bbef206d145f2e3",
      "flags": 0,
      "text": "耐热的体质会\\n让火属性的招式威力减半。"
    },
    {
      "index": 86,
      "id": "TOKUSEIINFO_086",
      "hash": "7bbef306d145f496",
      "flags": 0,
      "text": "能力变化会变为平时的２倍。"
    },
    {
      "index": 87,
      "id": "TOKUSEIINFO_087",
      "hash": "7bbef406d145f649",
      "flags": 0,
      "text": "下雨天气时和受到水属性的招式时，\\nHP会回复。晴朗天气时和受到火属性的\\n招式时，HP会减少。"
    },
    {
      "index": 88,
      "id": "TOKUSEIINFO_088",
      "hash": "7bbefd06d1460594",
      "flags": 0,
      "text": "比较对手的防御和特防，\\n根据较低的那项能力\\n相应地提高自己的攻击或特攻。"
    },
    {
      "index": 89,
      "id": "TOKUSEIINFO_089",
      "hash": "7bbefe06d1460747",
      "flags": 0,
      "text": "使用拳类招式的威力会提高。"
    },
    {
      "index": 90,
      "id": "TOKUSEIINFO_090",
      "hash": "7bc27b06d1491185",
      "flags": 0,
      "text": "变为中毒状态时，\\nHP不会减少，反而会增加起来。"
    },
    {
      "index": 91,
      "id": "TOKUSEIINFO_091",
      "hash": "7bc27a06d1490fd2",
      "flags": 0,
      "text": "与自身同属性的招式\\n威力会提高。"
    },
    {
      "index": 92,
      "id": "TOKUSEIINFO_092",
      "hash": "7bc27906d1490e1f",
      "flags": 0,
      "text": "如果使用连续招式，\\n总是能使出最高次数。"
    },
    {
      "index": 93,
      "id": "TOKUSEIINFO_093",
      "hash": "7bc27806d1490c6c",
      "flags": 0,
      "text": "下雨天气时，\\n异常状态会治愈。"
    },
    {
      "index": 94,
      "id": "TOKUSEIINFO_094",
      "hash": "7bc27706d1490ab9",
      "flags": 0,
      "text": "晴朗天气时，\\n特攻会提高，\\n而每回合HP会减少。"
    },
    {
      "index": 95,
      "id": "TOKUSEIINFO_095",
      "hash": "7bc27606d1490906",
      "flags": 0,
      "text": "变为异常状态时，\\n速度会提高。"
    },
    {
      "index": 96,
      "id": "TOKUSEIINFO_096",
      "hash": "7bc27506d1490753",
      "flags": 0,
      "text": "无论是什么属性的招式，\\n全部会变为一般属性。\\n威力会少量提高。"
    },
    {
      "index": 97,
      "id": "TOKUSEIINFO_097",
      "hash": "7bc27406d14905a0",
      "flags": 0,
      "text": "击中要害时，\\n威力会变得更强。"
    },
    {
      "index": 98,
      "id": "TOKUSEIINFO_098",
      "hash": "7bc28306d1491f1d",
      "flags": 0,
      "text": "不会受到攻击以外的伤害。"
    },
    {
      "index": 99,
      "id": "TOKUSEIINFO_099",
      "hash": "7bc28206d1491d6a",
      "flags": 0,
      "text": "由于无防守战术，\\n双方使出的招式都必定会击中。"
    },
    {
      "index": 100,
      "id": "TOKUSEIINFO_100",
      "hash": "84ba2006d67378df",
      "flags": 0,
      "text": "使出招式的顺序\\n必定会变为最后。"
    },
    {
      "index": 101,
      "id": "TOKUSEIINFO_101",
      "hash": "84ba1f06d673772c",
      "flags": 0,
      "text": "攻击时可以将\\n低威力招式的威力提高。"
    },
    {
      "index": 102,
      "id": "TOKUSEIINFO_102",
      "hash": "84ba2206d6737c45",
      "flags": 0,
      "text": "晴朗天气时，\\n不会变为异常状态。"
    },
    {
      "index": 103,
      "id": "TOKUSEIINFO_103",
      "hash": "84ba2106d6737a92",
      "flags": 0,
      "text": "无法使用持有的道具。"
    },
    {
      "index": 104,
      "id": "TOKUSEIINFO_104",
      "hash": "84ba1c06d6737213",
      "flags": 0,
      "text": "可以不受对手特性的干扰，\\n向对手使出招式。"
    },
    {
      "index": 105,
      "id": "TOKUSEIINFO_105",
      "hash": "84ba1b06d6737060",
      "flags": 0,
      "text": "因为拥有超幸运，\\n攻击容易击中对手的要害。"
    },
    {
      "index": 106,
      "id": "TOKUSEIINFO_106",
      "hash": "84ba1e06d6737579",
      "flags": 0,
      "text": "变为濒死时，\\n会对接触到自己的对手造成伤害。"
    },
    {
      "index": 107,
      "id": "TOKUSEIINFO_107",
      "hash": "84ba1d06d67373c6",
      "flags": 0,
      "text": "可以察觉到\\n对手拥有的危险招式。"
    },
    {
      "index": 108,
      "id": "TOKUSEIINFO_108",
      "hash": "84ba2806d6738677",
      "flags": 0,
      "text": "出场时，\\n只读取１个对手拥有的招式。"
    },
    {
      "index": 109,
      "id": "TOKUSEIINFO_109",
      "hash": "84ba2706d67384c4",
      "flags": 0,
      "text": "可以无视对手能力的变化，\\n进行攻击。"
    },
    {
      "index": 110,
      "id": "TOKUSEIINFO_110",
      "hash": "84b69a06d6705f56",
      "flags": 0,
      "text": "可以将效果不好的招式\\n以通常的威力使出。"
    },
    {
      "index": 111,
      "id": "TOKUSEIINFO_111",
      "hash": "84b69b06d6706109",
      "flags": 0,
      "text": "受到效果绝佳的攻击时，\\n可以减弱其威力。"
    },
    {
      "index": 112,
      "id": "TOKUSEIINFO_112",
      "hash": "84b69806d6705bf0",
      "flags": 0,
      "text": "在５回合内，\\n攻击和速度减半。"
    },
    {
      "index": 113,
      "id": "TOKUSEIINFO_113",
      "hash": "84b69906d6705da3",
      "flags": 0,
      "text": "一般属性和格斗属性的招式\\n可以击中幽灵属性的宝可梦。"
    },
    {
      "index": 114,
      "id": "TOKUSEIINFO_114",
      "hash": "84b69e06d6706622",
      "flags": 0,
      "text": "将水属性的招式引到自己身上，\\n不会受到伤害，而是会提高特攻。"
    },
    {
      "index": 115,
      "id": "TOKUSEIINFO_115",
      "hash": "84b69f06d67067d5",
      "flags": 0,
      "text": "冰雹天气时，\\n会缓缓回复HP。"
    },
    {
      "index": 116,
      "id": "TOKUSEIINFO_116",
      "hash": "84b69c06d67062bc",
      "flags": 0,
      "text": "受到效果绝佳的攻击时，\\n可以减弱其威力。"
    },
    {
      "index": 117,
      "id": "TOKUSEIINFO_117",
      "hash": "84b69d06d670646f",
      "flags": 0,
      "text": "出场时，\\n会将天气变为冰雹。"
    },
    {
      "index": 118,
      "id": "TOKUSEIINFO_118",
      "hash": "84b6a206d6706cee",
      "flags": 0,
      "text": "战斗结束时，\\n有时候会捡来甜甜蜜。"
    },
    {
      "index": 119,
      "id": "TOKUSEIINFO_119",
      "hash": "84b6a306d6706ea1",
      "flags": 0,
      "text": "出场时，\\n可以察觉对手的持有物。"
    },
    {
      "index": 120,
      "id": "TOKUSEIINFO_120",
      "hash": "84b33406d66d7c2d",
      "flags": 0,
      "text": "自己会因反作用力受伤的招式，\\n其威力会提高。"
    },
    {
      "index": 121,
      "id": "TOKUSEIINFO_121",
      "hash": "84b33306d66d7a7a",
      "flags": 0,
      "text": "自己的属性会根据持有的石板\\n或Ｚ纯晶的属性而改变。"
    },
    {
      "index": 122,
      "id": "TOKUSEIINFO_122",
      "hash": "84b33206d66d78c7",
      "flags": 0,
      "text": "晴朗天气时，\\n自己与同伴的攻击和\\n特防能力会提高。"
    },
    {
      "index": 123,
      "id": "TOKUSEIINFO_123",
      "hash": "84b33106d66d7714",
      "flags": 0,
      "text": "给予睡眠状态的对手伤害。"
    },
    {
      "index": 124,
      "id": "TOKUSEIINFO_124",
      "hash": "84b33006d66d7561",
      "flags": 0,
      "text": "盗取接触到自己的\\n对手的道具。"
    },
    {
      "index": 125,
      "id": "TOKUSEIINFO_125",
      "hash": "84b32f06d66d73ae",
      "flags": 0,
      "text": "招式的追加效果消失，\\n但因此能以更高的威力使出招式。"
    },
    {
      "index": 126,
      "id": "TOKUSEIINFO_126",
      "hash": "84b32e06d66d71fb",
      "flags": 0,
      "text": "能力的变化发生逆转，\\n原本提高时会降低，\\n而原本降低时会提高。"
    },
    {
      "index": 127,
      "id": "TOKUSEIINFO_127",
      "hash": "84b32d06d66d7048",
      "flags": 0,
      "text": "让对手紧张，\\n使其无法食用树果。"
    },
    {
      "index": 128,
      "id": "TOKUSEIINFO_128",
      "hash": "84b32c06d66d6e95",
      "flags": 0,
      "text": "能力被降低时，\\n攻击会大幅提高。"
    },
    {
      "index": 129,
      "id": "TOKUSEIINFO_129",
      "hash": "84b32b06d66d6ce2",
      "flags": 0,
      "text": "HP减半时，\\n会变得软弱，\\n攻击和特攻会减半。"
    },
    {
      "index": 130,
      "id": "TOKUSEIINFO_130",
      "hash": "84afae06d66a62a4",
      "flags": 0,
      "text": "受到攻击时，\\n有时会把对手的招式\\n变为定身法状态。"
    },
    {
      "index": 131,
      "id": "TOKUSEIINFO_131",
      "hash": "84afaf06d66a6457",
      "flags": 0,
      "text": "有时会治愈异常状态的同伴。"
    },
    {
      "index": 132,
      "id": "TOKUSEIINFO_132",
      "hash": "84afb006d66a660a",
      "flags": 0,
      "text": "可以减少我方的伤害。"
    },
    {
      "index": 133,
      "id": "TOKUSEIINFO_133",
      "hash": "84afb106d66a67bd",
      "flags": 0,
      "text": "如果因物理招式受到伤害，\\n防御会降低，\\n速度会大幅提高。"
    },
    {
      "index": 134,
      "id": "TOKUSEIINFO_134",
      "hash": "84afaa06d66a5bd8",
      "flags": 0,
      "text": "自身的重量会变为２倍。"
    },
    {
      "index": 135,
      "id": "TOKUSEIINFO_135",
      "hash": "84afab06d66a5d8b",
      "flags": 0,
      "text": "自身的重量会减半。"
    },
    {
      "index": 136,
      "id": "TOKUSEIINFO_136",
      "hash": "84afac06d66a5f3e",
      "flags": 0,
      "text": "HP全满时，\\n受到的伤害会变少。"
    },
    {
      "index": 137,
      "id": "TOKUSEIINFO_137",
      "hash": "84afad06d66a60f1",
      "flags": 0,
      "text": "变为中毒状态时，\\n物理招式的威力会提高。"
    },
    {
      "index": 138,
      "id": "TOKUSEIINFO_138",
      "hash": "84afa606d66a550c",
      "flags": 0,
      "text": "变为灼伤状态时，\\n特殊招式的威力会提高。"
    },
    {
      "index": 139,
      "id": "TOKUSEIINFO_139",
      "hash": "84afa706d66a56bf",
      "flags": 0,
      "text": "可以多次制作出\\n已被使用掉的树果。"
    },
    {
      "index": 140,
      "id": "TOKUSEIINFO_140",
      "hash": "84aca806d668229b",
      "flags": 0,
      "text": "读取我方的攻击，\\n并闪避其招式伤害。"
    },
    {
      "index": 141,
      "id": "TOKUSEIINFO_141",
      "hash": "84aca706d66820e8",
      "flags": 0,
      "text": "每一回合，能力中的某项\\n会大幅提高，而某项会降低。"
    },
    {
      "index": 142,
      "id": "TOKUSEIINFO_142",
      "hash": "84acaa06d6682601",
      "flags": 0,
      "text": "不会受到沙暴或冰雹等的伤害。\\n不会受到粉末类招式的攻击。"
    },
    {
      "index": 143,
      "id": "TOKUSEIINFO_143",
      "hash": "84aca906d668244e",
      "flags": 0,
      "text": "只通过接触就有可能\\n让对手变为中毒状态。"
    },
    {
      "index": 144,
      "id": "TOKUSEIINFO_144",
      "hash": "84acac06d6682967",
      "flags": 0,
      "text": "退回同行队伍后，\\nHP会少量回复。"
    },
    {
      "index": 145,
      "id": "TOKUSEIINFO_145",
      "hash": "84acab06d66827b4",
      "flags": 0,
      "text": "不会受到防御降低的效果。"
    },
    {
      "index": 146,
      "id": "TOKUSEIINFO_146",
      "hash": "84acae06d6682ccd",
      "flags": 0,
      "text": "沙暴天气时，\\n速度会提高。"
    },
    {
      "index": 147,
      "id": "TOKUSEIINFO_147",
      "hash": "84acad06d6682b1a",
      "flags": 0,
      "text": "成为不易受到变化招式\\n攻击的身体。"
    },
    {
      "index": 148,
      "id": "TOKUSEIINFO_148",
      "hash": "84aca006d6681503",
      "flags": 0,
      "text": "如果在最后使出招式，\\n招式的威力会提高。"
    },
    {
      "index": 149,
      "id": "TOKUSEIINFO_149",
      "hash": "84ac9f06d6681350",
      "flags": 0,
      "text": "假扮成同行队伍中的\\n最后一个宝可梦出场，\\n迷惑对手。"
    },
    {
      "index": 150,
      "id": "TOKUSEIINFO_150",
      "hash": "84a92206d6650912",
      "flags": 0,
      "text": "变身为当前面对的宝可梦。"
    },
    {
      "index": 151,
      "id": "TOKUSEIINFO_151",
      "hash": "84a92306d6650ac5",
      "flags": 0,
      "text": "可以穿透对手的壁障\\n或替身进行攻击。"
    },
    {
      "index": 152,
      "id": "TOKUSEIINFO_152",
      "hash": "84a92006d66505ac",
      "flags": 0,
      "text": "被对手接触到后，\\n会将对手变为木乃伊。"
    },
    {
      "index": 153,
      "id": "TOKUSEIINFO_153",
      "hash": "84a92106d665075f",
      "flags": 0,
      "text": "如果打倒对手，\\n就会充满自信，攻击会提高。"
    },
    {
      "index": 154,
      "id": "TOKUSEIINFO_154",
      "hash": "84a91e06d6650246",
      "flags": 0,
      "text": "受到恶属性的招式攻击时，\\n因为正义感，攻击会提高。"
    },
    {
      "index": 155,
      "id": "TOKUSEIINFO_155",
      "hash": "84a91f06d66503f9",
      "flags": 0,
      "text": "受到恶属性、幽灵属性\\n和虫属性的招式攻击时，\\n会因胆怯而速度提高。"
    },
    {
      "index": 156,
      "id": "TOKUSEIINFO_156",
      "hash": "84a91c06d664fee0",
      "flags": 0,
      "text": "可以不受到由对手使出的\\n变化招式影响，并将其反弹。"
    },
    {
      "index": 157,
      "id": "TOKUSEIINFO_157",
      "hash": "84a91d06d6650093",
      "flags": 0,
      "text": "受到草属性的招式攻击时，\\n不会受到伤害，而是攻击会提高。"
    },
    {
      "index": 158,
      "id": "TOKUSEIINFO_158",
      "hash": "84a92a06d66516aa",
      "flags": 0,
      "text": "可以率先使出变化招式。"
    },
    {
      "index": 159,
      "id": "TOKUSEIINFO_159",
      "hash": "84a92b06d665185d",
      "flags": 0,
      "text": "沙暴天气时，\\n岩石属性、地面属性\\n和钢属性的招式威力会提高。"
    },
    {
      "index": 160,
      "id": "TOKUSEIINFO_160",
      "hash": "84a59c06d661ef89",
      "flags": 0,
      "text": "用铁刺给予接触到自己的\\n对手伤害。"
    },
    {
      "index": 161,
      "id": "TOKUSEIINFO_161",
      "hash": "84a59b06d661edd6",
      "flags": 0,
      "text": "HP变为一半以下时，\\n样子会改变。"
    },
    {
      "index": 162,
      "id": "TOKUSEIINFO_162",
      "hash": "84a59a06d661ec23",
      "flags": 0,
      "text": "自己和同伴的命中率会提高。"
    },
    {
      "index": 163,
      "id": "TOKUSEIINFO_163",
      "hash": "84a59906d661ea70",
      "flags": 0,
      "text": "可以不受对手特性的干扰，\\n向对手使出招式。"
    },
    {
      "index": 164,
      "id": "TOKUSEIINFO_164",
      "hash": "84a5a006d661f655",
      "flags": 0,
      "text": "可以不受对手特性的干扰，\\n向对手使出招式。"
    },
    {
      "index": 165,
      "id": "TOKUSEIINFO_165",
      "hash": "84a59f06d661f4a2",
      "flags": 0,
      "text": "可以防住向自己和同伴\\n发出的心灵攻击。"
    },
    {
      "index": 166,
      "id": "TOKUSEIINFO_166",
      "hash": "84a59e06d661f2ef",
      "flags": 0,
      "text": "我方的草属性宝可梦\\n能力不会降低，\\n也不会变为异常状态。"
    },
    {
      "index": 167,
      "id": "TOKUSEIINFO_167",
      "hash": "84a59d06d661f13c",
      "flags": 0,
      "text": "无论是哪种树果，\\n食用后，HP都会回复。"
    },
    {
      "index": 168,
      "id": "TOKUSEIINFO_168",
      "hash": "84a5a406d661fd21",
      "flags": 0,
      "text": "变为与自己使出的招式\\n相同的属性。"
    },
    {
      "index": 169,
      "id": "TOKUSEIINFO_169",
      "hash": "84a5a306d661fb6e",
      "flags": 0,
      "text": "对手给予的物理招式的\\n伤害会减半。"
    },
    {
      "index": 170,
      "id": "TOKUSEIINFO_170",
      "hash": "84a21606d65ed600",
      "flags": 0,
      "text": "夺走被自己的招式\\n击中的对手的道具。"
    },
    {
      "index": 171,
      "id": "TOKUSEIINFO_171",
      "hash": "84a21706d65ed7b3",
      "flags": 0,
      "text": "可以防住对手的\\n球和弹类招式。"
    },
    {
      "index": 172,
      "id": "TOKUSEIINFO_172",
      "hash": "84a21806d65ed966",
      "flags": 0,
      "text": "如果能力被降低，\\n特攻就会大幅提高。"
    },
    {
      "index": 173,
      "id": "TOKUSEIINFO_173",
      "hash": "84a21906d65edb19",
      "flags": 0,
      "text": "因为颚部强壮，\\n啃咬类招式的威力会提高。"
    },
    {
      "index": 174,
      "id": "TOKUSEIINFO_174",
      "hash": "84a21a06d65edccc",
      "flags": 0,
      "text": "一般属性的招式\\n会变为冰属性。\\n威力会少量提高。"
    },
    {
      "index": 175,
      "id": "TOKUSEIINFO_175",
      "hash": "84a21b06d65ede7f",
      "flags": 0,
      "text": "我方的宝可梦\\n不会变为睡眠状态。"
    },
    {
      "index": 176,
      "id": "TOKUSEIINFO_176",
      "hash": "84a21c06d65ee032",
      "flags": 0,
      "text": "如果使出攻击招式，会变为刀剑形态，\\n如果使出招式“王者盾牌”，\\n会变为盾牌形态。"
    },
    {
      "index": 177,
      "id": "TOKUSEIINFO_177",
      "hash": "84a21d06d65ee1e5",
      "flags": 0,
      "text": "HP全满时，\\n飞行属性的招式可以率先使出。"
    },
    {
      "index": 178,
      "id": "TOKUSEIINFO_178",
      "hash": "84a21e06d65ee398",
      "flags": 0,
      "text": "波动和波导类招式的\\n威力会提高。"
    },
    {
      "index": 179,
      "id": "TOKUSEIINFO_179",
      "hash": "84a21f06d65ee54b",
      "flags": 0,
      "text": "在青草场地时，\\n防御会提高。"
    },
    {
      "index": 180,
      "id": "TOKUSEIINFO_180",
      "hash": "84d53006d68a5bc7",
      "flags": 0,
      "text": "同伴使用道具时，\\n会把自己持有的道具传递给同伴。"
    },
    {
      "index": 181,
      "id": "TOKUSEIINFO_181",
      "hash": "84d52f06d68a5a14",
      "flags": 0,
      "text": "接触到对手的招式\\n威力会提高。"
    },
    {
      "index": 182,
      "id": "TOKUSEIINFO_182",
      "hash": "84d53206d68a5f2d",
      "flags": 0,
      "text": "一般属性的招式\\n会变为妖精属性。\\n威力会少量提高。"
    },
    {
      "index": 183,
      "id": "TOKUSEIINFO_183",
      "hash": "84d53106d68a5d7a",
      "flags": 0,
      "text": "对于用攻击接触到自己的对手，\\n会降低其速度。"
    },
    {
      "index": 184,
      "id": "TOKUSEIINFO_184",
      "hash": "84d52c06d68a54fb",
      "flags": 0,
      "text": "一般属性的招式\\n会变为飞行属性。\\n威力会少量提高。"
    },
    {
      "index": 185,
      "id": "TOKUSEIINFO_185",
      "hash": "84d52b06d68a5348",
      "flags": 0,
      "text": "亲子俩可以合计攻击２次。"
    },
    {
      "index": 186,
      "id": "TOKUSEIINFO_186",
      "hash": "84d52e06d68a5861",
      "flags": 0,
      "text": "全体的恶属性招式变强。"
    },
    {
      "index": 187,
      "id": "TOKUSEIINFO_187",
      "hash": "84d52d06d68a56ae",
      "flags": 0,
      "text": "全体的妖精属性招式变强。"
    },
    {
      "index": 188,
      "id": "TOKUSEIINFO_188",
      "hash": "84d52806d68a4e2f",
      "flags": 0,
      "text": "让气场的效果发生逆转，\\n降低威力。"
    },
    {
      "index": 189,
      "id": "TOKUSEIINFO_189",
      "hash": "84d52706d68a4c7c",
      "flags": 0,
      "text": "变为不会受到\\n火属性攻击的天气。"
    },
    {
      "index": 190,
      "id": "TOKUSEIINFO_190",
      "hash": "84d1aa06d687423e",
      "flags": 0,
      "text": "变为不会受到\\n水属性攻击的天气。"
    },
    {
      "index": 191,
      "id": "TOKUSEIINFO_191",
      "hash": "84d1ab06d68743f1",
      "flags": 0,
      "text": "变为令飞行属性的弱点\\n消失的天气。"
    },
    {
      "index": 192,
      "id": "TOKUSEIINFO_192",
      "hash": "84d1a806d6873ed8",
      "flags": 0,
      "text": "受到攻击时，\\n防御会提高。"
    },
    {
      "index": 193,
      "id": "TOKUSEIINFO_193",
      "hash": "84d1a906d687408b",
      "flags": 0,
      "text": "HP变为一半时，\\n会慌慌张张逃走，\\n退回同行队伍中。"
    },
    {
      "index": 194,
      "id": "TOKUSEIINFO_194",
      "hash": "84d1ae06d687490a",
      "flags": 0,
      "text": "HP变为一半时，\\n为了回避危险，\\n会退回到同行队伍中。"
    },
    {
      "index": 195,
      "id": "TOKUSEIINFO_195",
      "hash": "84d1af06d6874abd",
      "flags": 0,
      "text": "受到水属性的招式攻击时，\\n防御会大幅提高。"
    },
    {
      "index": 196,
      "id": "TOKUSEIINFO_196",
      "hash": "84d1ac06d68745a4",
      "flags": 0,
      "text": "攻击中毒状态的对手时，\\n必定会击中要害。"
    },
    {
      "index": 197,
      "id": "TOKUSEIINFO_197",
      "hash": "84d1ad06d6874757",
      "flags": 0,
      "text": "HP变为一半时，\\n壳会坏掉，变得有攻击性。"
    },
    {
      "index": 198,
      "id": "TOKUSEIINFO_198",
      "hash": "84d1a206d68734a6",
      "flags": 0,
      "text": "可以对替换出场的对手\\n以２倍的伤害进行攻击。"
    },
    {
      "index": 199,
      "id": "TOKUSEIINFO_199",
      "hash": "84d1a306d6873659",
      "flags": 0,
      "text": "降低与自己相对的火属性\\n招式的威力，不会灼伤。"
    },
    {
      "index": 200,
      "id": "TOKUSEIINFO_200",
      "hash": "8dd05b06dbb7dcaa",
      "flags": 0,
      "text": "钢属性的招式威力会提高。"
    },
    {
      "index": 201,
      "id": "TOKUSEIINFO_201",
      "hash": "8dd05c06dbb7de5d",
      "flags": 0,
      "text": "因对手的攻击\\nHP变为一半时，\\n特攻会提高。"
    },
    {
      "index": 202,
      "id": "TOKUSEIINFO_202",
      "hash": "8dd05906dbb7d944",
      "flags": 0,
      "text": "冰雹天气时，\\n速度会提高。"
    },
    {
      "index": 203,
      "id": "TOKUSEIINFO_203",
      "hash": "8dd05a06dbb7daf7",
      "flags": 0,
      "text": "可以不接触对手\\n就使出所有的招式。"
    },
    {
      "index": 204,
      "id": "TOKUSEIINFO_204",
      "hash": "8dd05706dbb7d5de",
      "flags": 0,
      "text": "所有的声音招式\\n都变为水属性。"
    },
    {
      "index": 205,
      "id": "TOKUSEIINFO_205",
      "hash": "8dd05806dbb7d791",
      "flags": 0,
      "text": "可以率先使出回复招式。"
    },
    {
      "index": 206,
      "id": "TOKUSEIINFO_206",
      "hash": "8dd05506dbb7d278",
      "flags": 0,
      "text": "一般属性的招式\\n会变为电属性。\\n威力会少量提高。"
    },
    {
      "index": 207,
      "id": "TOKUSEIINFO_207",
      "hash": "8dd05606dbb7d42b",
      "flags": 0,
      "text": "电气场地时，\\n速度会变为２倍。"
    },
    {
      "index": 208,
      "id": "TOKUSEIINFO_208",
      "hash": "8dd05306dbb7cf12",
      "flags": 0,
      "text": "HP多的时候会聚起来变强。\\nHP剩余量变少时，\\n群体会分崩离析。"
    },
    {
      "index": 209,
      "id": "TOKUSEIINFO_209",
      "hash": "8dd05406dbb7d0c5",
      "flags": 0,
      "text": "通过画皮覆盖住身体，\\n可以防住１次攻击。"
    },
    {
      "index": 210,
      "id": "TOKUSEIINFO_210",
      "hash": "8dd3c106dbbabfd3",
      "flags": 0,
      "text": "打倒对手时，与训练家的牵绊会增强，\\n变为小智版甲贺忍蛙。\\n飞水手里剑的招式威力会增强。"
    },
    {
      "index": 211,
      "id": "TOKUSEIINFO_211",
      "hash": "8dd3c006dbbabe20",
      "flags": 0,
      "text": "HP变为一半时，\\n细胞们会赶来支援，\\n变为完全体形态。"
    },
    {
      "index": 212,
      "id": "TOKUSEIINFO_212",
      "hash": "8dd3c306dbbac339",
      "flags": 0,
      "text": "可以使钢属性和毒属性的宝可梦\\n也陷入中毒状态。"
    },
    {
      "index": 213,
      "id": "TOKUSEIINFO_213",
      "hash": "8dd3c206dbbac186",
      "flags": 0,
      "text": "总是半梦半醒的状态，\\n绝对不会醒来。\\n可以就这么睡着进行攻击。"
    },
    {
      "index": 214,
      "id": "TOKUSEIINFO_214",
      "hash": "8dd3c506dbbac69f",
      "flags": 0,
      "text": "向对手施加威慑力，\\n使其无法对我方使出先制招式。"
    },
    {
      "index": 215,
      "id": "TOKUSEIINFO_215",
      "hash": "8dd3c406dbbac4ec",
      "flags": 0,
      "text": "被对手打倒的时候，\\n会给予对手相当于\\nHP剩余量的伤害。"
    },
    {
      "index": 216,
      "id": "TOKUSEIINFO_216",
      "hash": "8dd3c706dbbaca05",
      "flags": 0,
      "text": "有谁使出跳舞招式时，\\n自己也能就这么接着使出跳舞招式。"
    },
    {
      "index": 217,
      "id": "TOKUSEIINFO_217",
      "hash": "8dd3c606dbbac852",
      "flags": 0,
      "text": "会提高我方的\\n特殊招式的威力。"
    },
    {
      "index": 218,
      "id": "TOKUSEIINFO_218",
      "hash": "8dd3c906dbbacd6b",
      "flags": 0,
      "text": "会将对手所给予的接触类招式的伤害减半，\\n但火属性招式的伤害会变为２倍。"
    },
    {
      "index": 219,
      "id": "TOKUSEIINFO_219",
      "hash": "8dd3c806dbbacbb8",
      "flags": 0,
      "text": "让对手吓一跳，\\n使其无法对我方使出先制招式。"
    },
    {
      "index": 220,
      "id": "TOKUSEIINFO_220",
      "hash": "8dc94f06dbb1a998",
      "flags": 0,
      "text": "宝可梦每次变为濒死状态时，\\n特攻会提高。"
    },
    {
      "index": 221,
      "id": "TOKUSEIINFO_221",
      "hash": "8dc95006dbb1ab4b",
      "flags": 0,
      "text": "对于用攻击接触到自己的对手，\\n会降低其速度。"
    },
    {
      "index": 222,
      "id": "TOKUSEIINFO_222",
      "hash": "8dc95106dbb1acfe",
      "flags": 0,
      "text": "继承被打倒的同伴的特性，\\n变为相同的特性。"
    },
    {
      "index": 223,
      "id": "TOKUSEIINFO_223",
      "hash": "8dc95206dbb1aeb1",
      "flags": 0,
      "text": "继承被打倒的同伴的特性，\\n变为相同的特性。"
    },
    {
      "index": 224,
      "id": "TOKUSEIINFO_224",
      "hash": "8dc95306dbb1b064",
      "flags": 0,
      "text": "打倒对手的时候，\\n自己最高的那项能力会提高。"
    },
    {
      "index": 225,
      "id": "TOKUSEIINFO_225",
      "hash": "8dc95406dbb1b217",
      "flags": 0,
      "text": "根据持有的存储碟，\\n自己的属性会改变。"
    },
    {
      "index": 226,
      "id": "TOKUSEIINFO_226",
      "hash": "8dc95506dbb1b3ca",
      "flags": 0,
      "text": "出场时，\\n会布下电气场地。"
    },
    {
      "index": 227,
      "id": "TOKUSEIINFO_227",
      "hash": "8dc95606dbb1b57d",
      "flags": 0,
      "text": "出场时，\\n会布下精神场地。"
    },
    {
      "index": 228,
      "id": "TOKUSEIINFO_228",
      "hash": "8dc94706dbb19c00",
      "flags": 0,
      "text": "出场时，\\n会布下薄雾场地。"
    },
    {
      "index": 229,
      "id": "TOKUSEIINFO_229",
      "hash": "8dc94806dbb19db3",
      "flags": 0,
      "text": "出场时，\\n会布下青草场地。"
    },
    {
      "index": 230,
      "id": "TOKUSEIINFO_230",
      "hash": "8dccd506dbb4c321",
      "flags": 0,
      "text": "不会因为对手的招式或特性\\n而被降低能力。"
    },
    {
      "index": 231,
      "id": "TOKUSEIINFO_231",
      "hash": "8dccd406dbb4c16e",
      "flags": 0,
      "text": "HP全满时，\\n受到的伤害会变少。"
    },
    {
      "index": 232,
      "id": "TOKUSEIINFO_232",
      "hash": "8dccd306dbb4bfbb",
      "flags": 0,
      "text": "受到效果绝佳的攻击时，\\n可以减弱其威力。"
    },
    {
      "index": 233,
      "id": "TOKUSEIINFO_233",
      "hash": "8dccd206dbb4be08",
      "flags": 0,
      "text": "效果绝佳的攻击，\\n威力会变得更强。"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_tokuseiinfo_max",
      "hash": "7c55fa6c8ed2c7fc"
    }
  ]
}
