{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "pmgo_set_win_01",
      "hash": "50aeeea835eb51b0",
      "flags": 0,
      "text": "要进行匹配与\\nPokémon GO连接吗？"
    },
    {
      "index": 1,
      "id": "pmgo_set_win_02",
      "hash": "50aef1a835eb56c9",
      "flags": 0,
      "text": "正在搜寻Pokémon GO……"
    },
    {
      "index": 2,
      "id": "pmgo_set_win_03",
      "hash": "50aef0a835eb5516",
      "flags": 0,
      "text": "找到了[VAR PGOTRAINER(0000)]。\\n要进行匹配吗？"
    },
    {
      "index": 3,
      "id": "pmgo_set_win_04",
      "hash": "50aef3a835eb5a2f",
      "flags": 0,
      "text": "正在进行连接……\\n请勿切断电源。"
    },
    {
      "index": 4,
      "id": "pmgo_set_win_05",
      "hash": "50aef2a835eb587c",
      "flags": 0,
      "text": "已与[VAR PGOTRAINER(0000)]的\\nPokémon GO匹配。\\n\\n你可以在浅红市的\\nGO Park里传送宝可梦。"
    },
    {
      "index": 5,
      "id": "pmgo_set_win_06",
      "hash": "50aef5a835eb5d95",
      "flags": 0,
      "text": "接下来还能带[VAR NUM3(0000)]只\\n宝可梦去[VAR GOPARKLOCAL(0001)]。"
    },
    {
      "index": 6,
      "id": "pmgo_set_win_07",
      "hash": "50aef4a835eb5be2",
      "flags": 0,
      "text": "由于传送的宝可梦数量超过50只，\\n因此无法传送至\\n[VAR GOPARKLOCAL(0000)]。\\n\\n请整理\\n[VAR GOPARKLOCAL(0000)]\\n里的宝可梦或选择其他GO Park。"
    },
    {
      "index": 7,
      "id": "pmgo_set_win_08",
      "hash": "50aef7a835eb60fb",
      "flags": 0,
      "text": "未与Pokémon GO进行匹配。\\n\\n请从Ｘ菜单的“设置”里选择\\n“与Pokémon GO连接”进行匹配。"
    },
    {
      "index": 8,
      "id": "pmgo_set_win_09",
      "hash": "50aef6a835eb5f48",
      "flags": 0,
      "text": "为了恢复数据，\\n正在和Pokémon GO进行连接。\\n请勿切断电源，\\n等待片刻。"
    },
    {
      "index": 9,
      "id": "pmgo_set_win_10",
      "hash": "50ab89a835e8703a",
      "flags": 0,
      "text": "想要传送的宝可梦\\n可能会消失。\\n真的要退出吗？"
    },
    {
      "index": 10,
      "id": "pmgo_set_win_11",
      "hash": "50ab8aa835e871ed",
      "flags": 0,
      "text": "Pokémon GO里留有宝可梦。\\n\\n请重新再试一次。"
    },
    {
      "index": 11,
      "id": "pmgo_set_win_12",
      "hash": "50ab87a835e86cd4",
      "flags": 0,
      "text": "正在结束……\\n请稍等片刻。"
    },
    {
      "index": 12,
      "id": "pmgo_set_win_13",
      "hash": "50ab88a835e86e87",
      "flags": 0,
      "text": "从[VAR PGOTRAINER(0000)]的\\nPokémon GO那里传送来了\\n[VAR NUM4(0001,0000)]只宝可梦。\\n\\n快去[VAR GOPARKLOCAL(0002)]里看看吧！"
    },
    {
      "index": 13,
      "id": "pmgo_set_win_14",
      "hash": "50ab85a835e8696e",
      "flags": 0,
      "text": "[VAR PGOTRAINER(0000)]要传送\\n[VAR NUM4(0001,0000)]只宝可梦，\\n但[VAR GOPARKLOCAL(0003)]里\\n只能再接收[VAR NUM3(0002)]只宝可梦。"
    },
    {
      "index": 14,
      "id": "pmgo_set_win_15",
      "hash": "50ab86a835e86b21",
      "flags": 0,
      "text": "已找到[VAR PGOTRAINER(0000)]。\\n要接收宝可梦吗？"
    },
    {
      "index": 15,
      "id": "pmgo_set_win_16",
      "hash": "50ab83a835e86608",
      "flags": 0,
      "text": "将《精灵宝可梦 Let's Go! 皮卡丘/\\nLet's Go! 伊布》连接到\\n《Pokémon GO》的时候，\\n你的游戏识别用户ID和\\n游戏信息会被发送到\\n《Pokémon GO》。"
    },
    {
      "index": 16,
      "id": "pmgo_set_sel_01",
      "hash": "4950366029620392",
      "flags": 0,
      "text": "是"
    },
    {
      "index": 17,
      "id": "pmgo_set_sel_02",
      "hash": "49503560296201df",
      "flags": 0,
      "text": "否"
    },
    {
      "index": 18,
      "id": "pmgo_set_sel_03",
      "hash": "495034602962002c",
      "flags": 0,
      "text": "继续"
    },
    {
      "index": 19,
      "id": "pmgo_set_sel_04",
      "hash": "495033602961fe79",
      "flags": 0,
      "text": "退出"
    },
    {
      "index": 20,
      "id": "pmgo_set_sel_05",
      "hash": "495032602961fcc6",
      "flags": 0,
      "text": "开始连接"
    },
    {
      "index": 21,
      "id": "pmgo_set_cap_01",
      "hash": "619e152042febb32",
      "flags": 0,
      "text": "开始"
    },
    {
      "index": 22,
      "id": "pmgo_set_cap_02",
      "hash": "619e142042feb97f",
      "flags": 0,
      "text": "退出"
    },
    {
      "index": 23,
      "id": "pmgo_set_cap_03",
      "hash": "619e132042feb7cc",
      "flags": 0,
      "text": "结束"
    },
    {
      "index": 24,
      "id": "pmgo_set_cap_04",
      "hash": "619e122042feb619",
      "flags": 0,
      "text": "[VAR NUM3(0000)]％"
    }
  ],
