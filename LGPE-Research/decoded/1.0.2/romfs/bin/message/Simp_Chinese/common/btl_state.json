{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "BTR_STATE_00_01",
      "hash": "4fb031d3b2084edc",
      "flags": 0,
      "text": "[~ 0]"
    },
    {
      "index": 1,
      "id": "BTR_STATE_00_02",
      "hash": "4fb034d3b20853f5",
      "flags": 0,
      "text": "[~ 1]"
    },
    {
      "index": 2,
      "id": "BTR_STATE_01_01",
      "hash": "7bb6bdda13718e71",
      "flags": 0,
      "text": "大晴天"
    },
    {
      "index": 3,
      "id": "BTR_STATE_01_02",
      "hash": "7bb6bada13718958",
      "flags": 0,
      "text": "天气为晴朗状态。\\n火属性的招式威力会提高。\\n水属性的招式威力会降低。"
    },
    {
      "index": 4,
      "id": "BTR_STATE_02_01",
      "hash": "773f7dc3401fbd7e",
      "flags": 0,
      "text": "下雨"
    },
    {
      "index": 5,
      "id": "BTR_STATE_02_02",
      "hash": "773f7cc3401fbbcb",
      "flags": 0,
      "text": "天气为下雨状态。\\n水属性的招式威力会提高。\\n火属性的招式威力会降低。"
    },
    {
      "index": 6,
      "id": "BTR_STATE_03_01",
      "hash": "7a2e29c8689f9193",
      "flags": 0,
      "text": "沙暴"
    },
    {
      "index": 7,
      "id": "BTR_STATE_03_02",
      "hash": "7a2e2ac8689f9346",
      "flags": 0,
      "text": "天气为沙暴状态。\\n岩石、地面和钢属性以外的宝可梦，\\n每回合会受到伤害。\\n岩石属性的特防会变强。"
    },
    {
      "index": 8,
      "id": "BTR_STATE_04_01",
      "hash": "4a11a9b05a3879c0",
      "flags": 0,
      "text": "冰雹"
    },
    {
      "index": 9,
      "id": "BTR_STATE_04_02",
      "hash": "4a11acb05a387ed9",
      "flags": 0,
      "text": "天气为冰雹状态。\\n冰属性以外的宝可梦，\\n每回合会受到伤害。"
    },
    {
      "index": 10,
      "id": "BTR_STATE_05_01",
      "hash": "a1bdf5b7f6b7d9b5",
      "flags": 0,
      "text": "电气场地"
    },
    {
      "index": 11,
      "id": "BTR_STATE_05_02",
      "hash": "a1bdf2b7f6b7d49c",
      "flags": 0,
      "text": "在５回合内，\\n地面上的宝可梦不会变为睡眠状态。\\n电属性的招式威力会提高。"
    },
    {
      "index": 12,
      "id": "BTR_STATE_06_01",
      "hash": "7354759fe9c25662",
      "flags": 0,
      "text": "青草场地"
    },
    {
      "index": 13,
      "id": "BTR_STATE_06_02",
      "hash": "7354749fe9c254af",
      "flags": 0,
      "text": "在５回合内，\\n地面上的宝可梦会缓缓回复HP。\\n草属性的招式威力会提高。"
    },
    {
      "index": 14,
      "id": "BTR_STATE_07_01",
      "hash": "1e0ac1a9f8ce9dd7",
      "flags": 0,
      "text": "薄雾场地"
    },
    {
      "index": 15,
      "id": "BTR_STATE_07_02",
      "hash": "1e0ac2a9f8ce9f8a",
      "flags": 0,
      "text": "在５回合内，\\n地面上的宝可梦不会陷入异常状态。\\n龙属性招式的伤害也会减半。"
    },
    {
      "index": 16,
      "id": "BTR_STATE_08_01",
      "hash": "da8a0216b2928334",
      "flags": 0,
      "text": "戏法空间"
    },
    {
      "index": 17,
      "id": "BTR_STATE_08_02",
      "hash": "da8a0516b292884d",
      "flags": 0,
      "text": "在５回合内，\\n速度慢的宝可梦可以先行动。"
    },
    {
      "index": 18,
      "id": "BTR_STATE_09_01",
      "hash": "dbc52e1bd99fe949",
      "flags": 0,
      "text": "魔法空间"
    },
    {
      "index": 19,
      "id": "BTR_STATE_09_02",
      "hash": "dbc52b1bd99fe430",
      "flags": 0,
      "text": "在５回合内，\\n变得无法使用持有物。"
    },
    {
      "index": 20,
      "id": "BTR_STATE_10_01",
      "hash": "c03652089e1b28bf",
      "flags": 0,
      "text": "奇妙空间"
    },
    {
      "index": 21,
      "id": "BTR_STATE_10_02",
      "hash": "c03653089e1b2a72",
      "flags": 0,
      "text": "在５回合内，\\n宝可梦的防御和特防会互换。"
    },
    {
      "index": 22,
      "id": "BTR_STATE_11_01",
      "hash": "136025fe8d40b14a",
      "flags": 0,
      "text": "易中要害"
    },
    {
      "index": 23,
      "id": "BTR_STATE_11_02",
      "hash": "136024fe8d40af97",
      "flags": 0,
      "text": "击中对手要害的几率变高。"
    },
    {
      "index": 24,
      "id": "BTR_STATE_12_01",
      "hash": "c152661a48912d3d",
      "flags": 0,
      "text": "混乱"
    },
    {
      "index": 25,
      "id": "BTR_STATE_12_02",
      "hash": "c152631a48912824",
      "flags": 0,
      "text": "在１～４回合内，\\n有时会攻击自己。"
    },
    {
      "index": 26,
      "id": "BTR_STATE_13_01",
      "hash": "ebd0da0eff2942a8",
      "flags": 0,
      "text": "着迷"
    },
    {
      "index": 27,
      "id": "BTR_STATE_13_02",
      "hash": "ebd0dd0eff2947c1",
      "flags": 0,
      "text": "♂的话对♀，♀的话对♂，\\n会变得很难使出招式。"
    },
    {
      "index": 28,
      "id": "BTR_STATE_14_01",
      "hash": "45059a28467a691b",
      "flags": 0,
      "text": "恶梦"
    },
    {
      "index": 29,
      "id": "BTR_STATE_14_02",
      "hash": "45059b28467a6ace",
      "flags": 0,
      "text": "在睡着的时候，\\n每回合HP会减少。"
    },
    {
      "index": 30,
      "id": "BTR_STATE_15_01",
      "hash": "18fe8e21e5105006",
      "flags": 0,
      "text": "瞌睡"
    },
    {
      "index": 31,
      "id": "BTR_STATE_15_02",
      "hash": "18fe8d21e5104e53",
      "flags": 0,
      "text": "在受到招式攻击的下一回合，\\n变为睡眠状态。"
    },
    {
      "index": 32,
      "id": "BTR_STATE_16_01",
      "hash": "1d75ce38b86220f9",
      "flags": 0,
      "text": "再来一次"
    },
    {
      "index": 33,
      "id": "BTR_STATE_16_02",
      "hash": "1d75cb38b8621be0",
      "flags": 0,
      "text": "受到再来一次的招式后，在３回合内，\\n只能使出[VAR MOVE(0000)]。"
    },
    {
      "index": 34,
      "id": "BTR_STATE_17_01",
      "hash": "f028623255e2a224",
      "flags": 0,
      "text": "无特性"
    },
    {
      "index": 35,
      "id": "BTR_STATE_17_02",
      "hash": "f028653255e2a73d",
      "flags": 0,
      "text": "特性会消失，变得没有效果。"
    },
    {
      "index": 36,
      "id": "BTR_STATE_18_01",
      "hash": "5fbb61c6d790d587",
      "flags": 0,
      "text": "无理取闹"
    },
    {
      "index": 37,
      "id": "BTR_STATE_18_02",
      "hash": "5fbb62c6d790d73a",
      "flags": 0,
      "text": "不能连续使出同样的招式。"
    },
    {
      "index": 38,
      "id": "BTR_STATE_19_01",
      "hash": "88f355bb8d134ed2",
      "flags": 0,
      "text": "顺风"
    },
    {
      "index": 39,
      "id": "BTR_STATE_19_02",
      "hash": "88f354bb8d134d1f",
      "flags": 0,
      "text": "在４回合内，\\n出战的宝可梦速度会变为２倍。"
    },
    {
      "index": 40,
      "id": "BTR_STATE_20_01",
      "hash": "6f0ff569da3dc0c2",
      "flags": 0,
      "text": "幸运咒语"
    },
    {
      "index": 41,
      "id": "BTR_STATE_20_02",
      "hash": "6f0ff469da3dbf0f",
      "flags": 0,
      "text": "变得不会被对手的招式击中要害。"
    },
    {
      "index": 42,
      "id": "BTR_STATE_21_01",
      "hash": "c6bbc17176bc4737",
      "flags": 0,
      "text": "怨念"
    },
    {
      "index": 43,
      "id": "BTR_STATE_21_02",
      "hash": "c6bbc27176bc48ea",
      "flags": 0,
      "text": "因对手的招式而濒死时，\\n该招式的PP会变为０。"
    },
    {
      "index": 44,
      "id": "BTR_STATE_22_01",
      "hash": "f2c2a977d8262320",
      "flags": 0,
      "text": "回复封锁"
    },
    {
      "index": 45,
      "id": "BTR_STATE_22_02",
      "hash": "f2c2ac77d8262839",
      "flags": 0,
      "text": "在５回合内，\\n无法通过招式、特性\\n或携带的道具回复HP。"
    },
    {
      "index": 46,
      "id": "BTR_STATE_23_01",
      "hash": "9d78f581e7326a95",
      "flags": 0,
      "text": "被识破"
    },
    {
      "index": 47,
      "id": "BTR_STATE_23_02",
      "hash": "9d78f281e732657c",
      "flags": 0,
      "text": "会被那些原本不会有\\n特定效果的招式击中。\\n无视闪避率提升的效果，\\n都会受到攻击。"
    },
    {
      "index": 48,
      "id": "BTR_STATE_24_01",
      "hash": "cb32fd884a0e115e",
      "flags": 0,
      "text": "定身法"
    },
    {
      "index": 49,
      "id": "BTR_STATE_24_02",
      "hash": "cb32fc884a0e0fab",
      "flags": 0,
      "text": "在４回合内，\\n[VAR MOVE(0000)]会变得无法使用。"
    },
    {
      "index": 50,
      "id": "BTR_STATE_25_01",
      "hash": "212ba98fe51accf3",
      "flags": 0,
      "text": "无法逃走"
    },
    {
      "index": 51,
      "id": "BTR_STATE_25_02",
      "hash": "212baa8fe51acea6",
      "flags": 0,
      "text": "无法逃走或替换。"
    },
    {
      "index": 52,
      "id": "BTR_STATE_26_01",
      "hash": "f6adb19b2e838a3c",
      "flags": 0,
      "text": "锁定"
    },
    {
      "index": 53,
      "id": "BTR_STATE_26_02",
      "hash": "f6adb49b2e838f55",
      "flags": 0,
      "text": "在锁定的下一回合，\\n招式必定会击中。"
    },
    {
      "index": 54,
      "id": "BTR_STATE_27_01",
      "hash": "2467bda1915f37d1",
      "flags": 0,
      "text": "查封"
    },
    {
      "index": 55,
      "id": "BTR_STATE_27_02",
      "hash": "2467baa1915f32b8",
      "flags": 0,
      "text": "在５回合内，\\n持有物和道具会变得无法使用。"
    },
    {
      "index": 56,
      "id": "BTR_STATE_28_01",
      "hash": "cf1e05aba06b787a",
      "flags": 0,
      "text": "充电"
    },
    {
      "index": 57,
      "id": "BTR_STATE_28_02",
      "hash": "cf1e04aba06b76c7",
      "flags": 0,
      "text": "在充电的下一回合，\\n电属性的招式威力会变为２倍。"
    },
    {
      "index": 58,
      "id": "BTR_STATE_29_01",
      "hash": "fb24f1b201d55b2f",
      "flags": 0,
      "text": "重力"
    },
    {
      "index": 59,
      "id": "BTR_STATE_29_02",
      "hash": "fb24f2b201d55ce2",
      "flags": 0,
      "text": "在５回合内，\\n招式会变得容易击中。\\n飘浮特性和飞行属性的宝可梦\\n会被地面招式击中。\\n飞向空中的招式将无法使用。"
    },
    {
      "index": 60,
      "id": "BTR_STATE_30_01",
      "hash": "df29959ec5f4a245",
      "flags": 0,
      "text": "白雾"
    },
    {
      "index": 61,
      "id": "BTR_STATE_30_02",
      "hash": "df29929ec5f49d2c",
      "flags": 0,
      "text": "在５回合内，\\n不会被降低能力。"
    },
    {
      "index": 62,
      "id": "BTR_STATE_31_01",
      "hash": "0a1489937ce8b010",
      "flags": 0,
      "text": "神秘守护"
    },
    {
      "index": 63,
      "id": "BTR_STATE_31_02",
      "hash": "0a148c937ce8b529",
      "flags": 0,
      "text": "在５回合内，\\n不会陷入异常状态。"
    },
    {
      "index": 64,
      "id": "BTR_STATE_32_01",
      "hash": "06b9618e540cea67",
      "flags": 0,
      "text": "隐形岩"
    },
    {
      "index": 65,
      "id": "BTR_STATE_32_02",
      "hash": "06b9628e540cec1a",
      "flags": 0,
      "text": "替换出场的宝可梦会受到伤害。"
    },
    {
      "index": 66,
      "id": "BTR_STATE_33_01",
      "hash": "31a3d5830b001eb2",
      "flags": 0,
      "text": "蓄力"
    },
    {
      "index": 67,
      "id": "BTR_STATE_33_02",
      "hash": "31a3d4830b001cff",
      "flags": 0,
      "text": "在蓄力的时候，\\n防御和特防会提高。"
    },
    {
      "index": 68,
      "id": "BTR_STATE_34_01",
      "hash": "3a069dbd34b03041",
      "flags": 0,
      "text": "挑衅"
    },
    {
      "index": 69,
      "id": "BTR_STATE_34_02",
      "hash": "3a069abd34b02b28",
      "flags": 0,
      "text": "变得只能使出给予伤害的招式。"
    },
    {
      "index": 70,
      "id": "BTR_STATE_35_01",
      "hash": "385e51b80d45c1ec",
      "flags": 0,
      "text": "意念移物"
    },
    {
      "index": 71,
      "id": "BTR_STATE_35_02",
      "hash": "385e54b80d45c705",
      "flags": 0,
      "text": "在３回合内，\\n一击必杀以外的招式也必定会击中。\\n地面属性的招式会变得无法击中。"
    },
    {
      "index": 72,
      "id": "BTR_STATE_36_01",
      "hash": "62dc49acc3dd04a3",
      "flags": 0,
      "text": "电磁飘浮"
    },
    {
      "index": 73,
      "id": "BTR_STATE_36_02",
      "hash": "62dc4aacc3dd0656",
      "flags": 0,
      "text": "在５回合内，\\n地面属性的招式会变得无法击中。"
    },
    {
      "index": 74,
      "id": "BTR_STATE_37_01",
      "hash": "358f5da6615e5f4e",
      "flags": 0,
      "text": "毒菱"
    },
    {
      "index": 75,
      "id": "BTR_STATE_37_02",
      "hash": "358f5ca6615e5d9b",
      "flags": 0,
      "text": "让替换出场的宝可梦陷入中毒状态。\\n飞行属性和飘浮特性的宝可梦\\n不会被击中。"
    },
    {
      "index": 76,
      "id": "BTR_STATE_38_01",
      "hash": "6a0365e1c67ed69d",
      "flags": 0,
      "text": "玩泥巴"
    },
    {
      "index": 77,
      "id": "BTR_STATE_38_02",
      "hash": "6a0362e1c67ed184",
      "flags": 0,
      "text": "在５回合内，\\n电属性的招式威力会减半。"
    },
    {
      "index": 78,
      "id": "BTR_STATE_39_01",
      "hash": "948159d67d161288",
      "flags": 0,
      "text": "祈愿"
    },
    {
      "index": 79,
      "id": "BTR_STATE_39_02",
      "hash": "94815cd67d1617a1",
      "flags": 0,
      "text": "使用祈愿后的下一回合，\\nHP会回复。"
    },
    {
      "index": 80,
      "id": "BTR_STATE_40_01",
      "hash": "e979a57045ab8090",
      "flags": 0,
      "text": "黏黏网"
    },
    {
      "index": 81,
      "id": "BTR_STATE_40_02",
      "hash": "e979a87045ab85a9",
      "flags": 0,
      "text": "降低替换出场的宝可梦的速度。"
    },
    {
      "index": 82,
      "id": "BTR_STATE_41_01",
      "hash": "be8eb17b8eb772c5",
      "flags": 0,
      "text": "扎根"
    },
    {
      "index": 83,
      "id": "BTR_STATE_41_02",
      "hash": "be8eae7b8eb76dac",
      "flags": 0,
      "text": "在每回合结束时回复HP。\\n扎根的宝可梦无法替换。"
    },
    {
      "index": 84,
      "id": "BTR_STATE_42_01",
      "hash": "1108f15fd3c2ef32",
      "flags": 0,
      "text": "诅咒"
    },
    {
      "index": 85,
      "id": "BTR_STATE_42_02",
      "hash": "1108f05fd3c2ed7f",
      "flags": 0,
      "text": "在每回合结束时减少HP。"
    },
    {
      "index": 86,
      "id": "BTR_STATE_43_01",
      "hash": "e61e7d6b1ccfbae7",
      "flags": 0,
      "text": "万圣夜"
    },
    {
      "index": 87,
      "id": "BTR_STATE_43_02",
      "hash": "e61e7e6b1ccfbc9a",
      "flags": 0,
      "text": "宝可梦会被追加幽灵属性。"
    },
    {
      "index": 88,
      "id": "BTR_STATE_44_01",
      "hash": "17c36d94d608926c",
      "flags": 0,
      "text": "光墙"
    },
    {
      "index": 89,
      "id": "BTR_STATE_44_02",
      "hash": "17c37094d6089785",
      "flags": 0,
      "text": "在５回合内，\\n受到的特殊攻击威力会减半。"
    },
    {
      "index": 90,
      "id": "BTR_STATE_45_01",
      "hash": "196bb999fd7300c1",
      "flags": 0,
      "text": "反射壁"
    },
    {
      "index": 91,
      "id": "BTR_STATE_45_02",
      "hash": "196bb699fd72fba8",
      "flags": 0,
      "text": "在５回合内，\\n受到的物理攻击威力会减半。"
    },
    {
      "index": 92,
      "id": "BTR_STATE_46_01",
      "hash": "14f479832a212fce",
      "flags": 0,
      "text": "封印"
    },
    {
      "index": 93,
      "id": "BTR_STATE_46_02",
      "hash": "14f478832a212e1b",
      "flags": 0,
      "text": "宝可梦使出封印后，\\n其所学会的招式，\\n对手的宝可梦将无法使出。"
    },
    {
      "index": 94,
      "id": "BTR_STATE_47_01",
      "hash": "424165898c9fd523",
      "flags": 0,
      "text": "灭亡之歌"
    },
    {
      "index": 95,
      "id": "BTR_STATE_47_02",
      "hash": "424166898c9fd6d6",
      "flags": 0,
      "text": "听了灭亡之歌的全部宝可梦\\n３回合后陷入濒死。"
    },
    {
      "index": 96,
      "id": "BTR_STATE_48_01",
      "hash": "73e675b345d8e308",
      "flags": 0,
      "text": "撒菱"
    },
    {
      "index": 97,
      "id": "BTR_STATE_48_02",
      "hash": "73e678b345d8e821",
      "flags": 0,
      "text": "给予替换出场的宝可梦伤害。\\n飞行属性和飘浮特性的宝可梦\\n不会被击中。"
    },
    {
      "index": 98,
      "id": "BTR_STATE_49_01",
      "hash": "496881be8f41a71d",
      "flags": 0,
      "text": "玩水"
    },
    {
      "index": 99,
      "id": "BTR_STATE_49_02",
      "hash": "49687ebe8f41a204",
      "flags": 0,
      "text": "在５回合内，\\n火属性的招式威力会减半。"
    },
    {
      "index": 100,
      "id": "BTR_STATE_50_01",
      "hash": "599345a531626213",
      "flags": 0,
      "text": "同命"
    },
    {
      "index": 101,
      "id": "BTR_STATE_50_02",
      "hash": "599346a5316263c6",
      "flags": 0,
      "text": "让自己陷入濒死的对手，\\n也会一同陷入濒死。"
    },
    {
      "index": 102,
      "id": "BTR_STATE_51_01",
      "hash": "56a499a008e28dfe",
      "flags": 0,
      "text": "森林诅咒"
    },
    {
      "index": 103,
      "id": "BTR_STATE_51_02",
      "hash": "56a498a008e28c4b",
      "flags": 0,
      "text": "宝可梦会被追加草属性。"
    },
    {
      "index": 104,
      "id": "BTR_STATE_52_01",
      "hash": "5b1bd9b6dc345ef1",
      "flags": 0,
      "text": "寄生种子"
    },
    {
      "index": 105,
      "id": "BTR_STATE_52_02",
      "hash": "5b1bd6b6dc3459d8",
      "flags": 0,
      "text": "每回合结束时，\\n会被寄生种子夺走HP，\\n同时回复对手的HP。"
    },
    {
      "index": 106,
      "id": "BTR_STATE_53_01",
      "hash": "2f154db07acb1f5c",
      "flags": 0,
      "text": "锁定"
    },
    {
      "index": 107,
      "id": "BTR_STATE_53_02",
      "hash": "2f1550b07acb2475",
      "flags": 0,
      "text": "招式必定会命中锁定了的对手。"
    },
    {
      "index": 108,
      "id": "BTR_STATE_54_01",
      "hash": "fd6fdd86c1916e57",
      "flags": 0,
      "text": "束缚"
    },
    {
      "index": 109,
      "id": "BTR_STATE_54_02",
      "hash": "fd6fde86c191700a",
      "flags": 0,
      "text": "被紧紧绑住，每一回合\\n都会受到伤害。"
    },
    {
      "index": 110,
      "id": "BTR_STATE_55_01",
      "hash": "52b9917cb28526e2",
      "flags": 0,
      "text": "忍耐"
    },
    {
      "index": 111,
      "id": "BTR_STATE_55_02",
      "hash": "52b9907cb285252f",
      "flags": 0,
      "text": "在２回合内忍受攻击，\\n受到的伤害会２倍返还给对手。"
    },
    {
      "index": 112,
      "id": "BTR_STATE_56_01",
      "hash": "81231194bf7aaa35",
      "flags": 0,
      "text": "逆鳞"
    },
    {
      "index": 113,
      "id": "BTR_STATE_56_02",
      "hash": "81230e94bf7aa51c",
      "flags": 0,
      "text": "在２～３回合内，\\n乱打一气地进行攻击。\\n大闹一番后自己会陷入混乱。"
    },
    {
      "index": 114,
      "id": "BTR_STATE_57_01",
      "hash": "2976c58d22fb4a40",
      "flags": 0,
      "text": "大闹一番"
    },
    {
      "index": 115,
      "id": "BTR_STATE_57_02",
      "hash": "2976c88d22fb4f59",
      "flags": 0,
      "text": "在２～３回合内，\\n乱打一气地进行攻击。\\n大闹一番后自己会陷入混乱。"
    },
    {
      "index": 116,
      "id": "BTR_STATE_58_01",
      "hash": "e2ba15e8307b01eb",
      "flags": 0,
      "text": "花瓣舞"
    },
    {
      "index": 117,
      "id": "BTR_STATE_58_02",
      "hash": "e2ba16e8307b039e",
      "flags": 0,
      "text": "在２～３回合内，\\n乱打一气地进行攻击。\\n大闹一番后自己会陷入混乱。"
    },
    {
      "index": 118,
      "id": "BTR_STATE_59_01",
      "hash": "8c5449e095113e16",
      "flags": 0,
      "text": "剧毒"
    },
    {
      "index": 119,
      "id": "BTR_STATE_59_02",
      "hash": "8c5448e095113c63",
      "flags": 0,
      "text": "剧毒状态。\\n随着回合的推进，中毒伤害会增加。"
    },
    {
      "index": 120,
      "id": "BTR_STATE_60_01",
      "hash": "5d592a13a8f43f36",
      "flags": 0,
      "text": "未来攻击"
    },
    {
      "index": 121,
      "id": "BTR_STATE_60_02",
      "hash": "5d592913a8f43d83",
      "flags": 0,
      "text": "被招式攻击的２回合后，\\n会受到伤害。"
    },
    {
      "index": 122,
      "id": "BTR_STATE_61_01",
      "hash": "5f00f618d05dd40b",
      "flags": 0,
      "text": "吵闹"
    },
    {
      "index": 123,
      "id": "BTR_STATE_61_02",
      "hash": "5f00f718d05dd5be",
      "flags": 0,
      "text": "在３回合内，用骚乱攻击对手。\\n在此期间谁都不能入眠。"
    },
    {
      "index": 124,
      "id": "BTR_STATE_62_01",
      "hash": "3482fe2419c69154",
      "flags": 0,
      "text": "水流环"
    },
    {
      "index": 125,
      "id": "BTR_STATE_62_02",
      "hash": "3483012419c6966d",
      "flags": 0,
      "text": "在自己身体的周围覆盖用水制造的幕。\\n每回合回复HP。"
    },
    {
      "index": 126,
      "id": "BTR_STATE_63_01",
      "hash": "8c2f2a2bb645bae9",
      "flags": 0,
      "text": "身体轻量化"
    },
    {
      "index": 127,
      "id": "BTR_STATE_63_02",
      "hash": "8c2f272bb645b5d0",
      "flags": 0,
      "text": "速度会大幅度提高，\\n体重也会变轻。"
    },
    {
      "index": 128,
      "id": "BTR_STATE_64_01",
      "hash": "2d5c01ef1724f5ba",
      "flags": 0,
      "text": "击落"
    },
    {
      "index": 129,
      "id": "BTR_STATE_64_02",
      "hash": "2d5c00ef1724f407",
      "flags": 0,
      "text": "被击落，掉到地面的状态。"
    },
    {
      "index": 130,
      "id": "BTR_STATE_65_01",
      "hash": "02ddedfa608d836f",
      "flags": 0,
      "text": "妖精之锁"
    },
    {
      "index": 131,
      "id": "BTR_STATE_65_02",
      "hash": "02ddeefa608d8522",
      "flags": 0,
      "text": "在使用招式的下一回合，\\n所有的宝可梦都无法逃走。"
    },
    {
      "index": 132,
      "id": "BTR_STATE_66_01",
      "hash": "5a89b601fd0c0318",
      "flags": 0,
      "text": "彩虹"
    },
    {
      "index": 133,
      "id": "BTR_STATE_66_02",
      "hash": "5a89b901fd0c0831",
      "flags": 0,
      "text": "招式的追加效果变得更易出现。"
    },
    {
      "index": 134,
      "id": "BTR_STATE_67_01",
      "hash": "8690c2085e761c2d",
      "flags": 0,
      "text": "湿地"
    },
    {
      "index": 135,
      "id": "BTR_STATE_67_02",
      "hash": "8690bf085e761714",
      "flags": 0,
      "text": "速度变为原来的１／４。"
    },
    {
      "index": 136,
      "id": "BTR_STATE_68_01",
      "hash": "d2ebf9d0a8c6399e",
      "flags": 0,
      "text": "火海"
    },
    {
      "index": 137,
      "id": "BTR_STATE_68_02",
      "hash": "d2ebf8d0a8c637eb",
      "flags": 0,
      "text": "火属性以外的宝可梦，\\n每回合受到伤害。"
    },
    {
      "index": 138,
      "id": "BTR_STATE_69_01",
      "hash": "28e4a5d843d2f533",
      "flags": 0,
      "text": "大日照"
    },
    {
      "index": 139,
      "id": "BTR_STATE_69_02",
      "hash": "28e4a6d843d2f6e6",
      "flags": 0,
      "text": "天气为大日照状态。\\n火属性的招式威力会提高。\\n不会受到水属性招式的攻击。"
    },
    {
      "index": 140,
      "id": "BTR_STATE_70_01",
      "hash": "cc2c4a4893958499",
      "flags": 0,
      "text": "大雨"
    },
    {
      "index": 141,
      "id": "BTR_STATE_70_02",
      "hash": "cc2c474893957f80",
      "flags": 0,
      "text": "天气为大雨状态。\\n水属性的招式威力会提高。\\n不会受到火属性招式的攻击。"
    },
    {
      "index": 142,
      "id": "BTR_STATE_71_01",
      "hash": "f7175e3d4a89c8c4",
      "flags": 0,
      "text": "乱流"
    },
    {
      "index": 143,
      "id": "BTR_STATE_71_02",
      "hash": "f717613d4a89cddd",
      "flags": 0,
      "text": "天气为乱流状态。\\n与飞行属性相克且效果绝佳的属性，\\n其招式威力会变弱。"
    },
    {
      "index": 144,
      "id": "BTR_STATE_72_01",
      "hash": "a0b19635af200bbb",
      "flags": 0,
      "text": "精神场地"
    },
    {
      "index": 145,
      "id": "BTR_STATE_72_02",
      "hash": "a0b19735af200d6e",
      "flags": 0,
      "text": "在５回合内，\\n地面上的宝可梦不会受到先制招式的攻击。\\n超能力属性的招式威力会提高。"
    },
    {
      "index": 146,
      "id": "BTR_STATE_73_01",
      "hash": "72f78a2f4c445e26",
      "flags": 0,
      "text": "地狱突刺"
    },
    {
      "index": 147,
      "id": "BTR_STATE_73_02",
      "hash": "72f7892f4c445c73",
      "flags": 0,
      "text": "在２回合内，\\n无法使出发声音的招式。"
    },
    {
      "index": 148,
      "id": "BTR_STATE_74_01",
      "hash": "c84162253d3853dd",
      "flags": 0,
      "text": "极光幕"
    },
    {
      "index": 149,
      "id": "BTR_STATE_74_02",
      "hash": "c8415f253d384ec4",
      "flags": 0,
      "text": "在５回合内，\\n物理与特殊攻击的威力会减半。"
    },
    {
      "index": 150,
      "id": "BTR_STATE_75_01",
      "hash": "9c3a561edbce3ac8",
      "flags": 0,
      "text": "磨砺"
    },
    {
      "index": 151,
      "id": "BTR_STATE_75_02",
      "hash": "9c3a591edbce3fe1",
      "flags": 0,
      "text": "在使用磨砺的下一回合，\\n招式必定会击中要害。"
    },
    {
      "index": 152,
      "id": "BTR_STATE_76_01",
      "hash": "c5724e139150badf",
      "flags": 0,
      "text": "[~ 152]"
    },
    {
      "index": 153,
      "id": "BTR_STATE_76_02",
      "hash": "c5724f139150bc92",
      "flags": 0,
      "text": "[~ 153]"
    },
    {
      "index": 154,
      "id": "BTR_STATE_77_01",
      "hash": "6f0ca20bf5e72d6a",
      "flags": 0,
      "text": "[~ 154]"
    },
