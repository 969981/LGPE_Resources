{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_road017_kanban_01",
      "hash": "a226f27247818ecb",
      "flags": 0,
      "text": "这里贴着一张告示！\\c\\n……小心别人丢弃的道具！"
    },
    {
      "index": 1,
      "id": "msg_road017_kanban_02",
      "hash": "a226f3724781907e",
      "flags": 0,
      "text": "……有用的公告牌！\\c\\n即使是种类和等级相同的宝可梦，\\n每次捕捉时\\r\\n它们的能力都会有微妙的差异……\\r\\n经过培养，这些差异便会更加明显！"
    },
    {
      "index": 2,
      "id": "msg_road017_kanban_03",
      "hash": "a226f47247819231",
      "flags": 0,
      "text": "[~ 2]"
    },
    {
      "index": 3,
      "id": "msg_road017_kanban_07",
      "hash": "a226f872478198fd",
      "flags": 0,
      "text": "……有用的公告牌！\\c\\n捕捉宝可梦时，\\n要瞄准有颜色的圆圈投球！\\c\\n圆圈越小，就越有可能出现\\n“漂亮一投”和“精彩一投”，\\r\\n宝可梦也越容易捕捉。"
    },
    {
      "index": 4,
      "id": "msg_road017_kanban_04",
      "hash": "a226f572478193e4",
      "flags": 0,
      "text": "这里是17号道路\\n玉虹市　……　浅红市"
    },
    {
      "index": 5,
      "id": "msg_road017_kanban_05",
      "hash": "a226f67247819597",
      "flags": 0,
      "text": "这里贴着一张告示！\\c\\n别扔游戏！\\n要扔就扔精灵球！"
    },
    {
      "index": 6,
      "id": "msg_road017_kanban_06",
      "hash": "a226f7724781974a",
      "flags": 0,
      "text": "人类与宝可梦\\n可以一起通行的路"
    },
    {
      "index": 7,
      "id": "msg_road017_poke_01",
      "hash": "1b23d3da193d6069",
      "flags": 0,
      "text": "卡咪龟：咪～呐～"
    },
    {
      "index": 8,
      "id": "msg_road017_poke_02",
      "hash": "1b23d0da193d5b50",
      "flags": 0,
      "text": "椰蛋树：伸长伸长～！"
    },
    {
      "index": 9,
      "id": "msg_road017_poke_03",
      "hash": "1b23d1da193d5d03",
      "flags": 0,
      "text": "猫老大：猫喵猫喵～"
    },
    {
      "index": 10,
      "id": "msg_road017_poke_04",
      "hash": "1b23d6da193d6582",
      "flags": 0,
      "text": "水伊布：黏糊糊～"
    },
    {
      "index": 11,
      "id": "msg_road017_poke_05",
      "hash": "1b23d7da193d6735",
      "flags": 0,
      "text": "口呆花：口呆！"
    },
    {
      "index": 12,
      "id": "msg_road017_poke_06",
      "hash": "1b23d4da193d621c",
      "flags": 0,
      "text": "火伊布：火火焰～"
    },
    {
      "index": 13,
      "id": "msg_road017_poke_07",
      "hash": "1b23d5da193d63cf",
      "flags": 0,
      "text": "火暴猴：暴暴火暴～！"
    },
    {
      "index": 14,
      "id": "msg_road017_poke_08",
      "hash": "1b23dada193d6c4e",
      "flags": 0,
      "text": "六尾：尾尾～"
    },
    {
      "index": 15,
      "id": "msg_road017_poke_09",
      "hash": "1b23dbda193d6e01",
      "flags": 0,
      "text": "雷伊布：锯齿锯齿～"
    }
  ],
