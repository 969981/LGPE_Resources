{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_s001r0101_woman_01",
      "hash": "d584d755a1a6e5d4",
      "flags": 0,
      "text": "敦子：说好要一起去捉宝可梦的……\\n弘二这家伙到底在哪儿啊！"
    },
    {
      "index": 1,
      "id": "msg_s001r0101_miniskirt_01",
      "hash": "e4be0bc5834e1abc",
      "flags": 0,
      "text": "这是我捉到的\\n袋兽、小火马和迷你龙。\\r\\n送给你吧！"
    },
    {
      "index": 2,
      "id": "msg_s001r0101_childm_01",
      "hash": "7dce70172545f1f5",
      "flags": 0,
      "text": "哇～～\\n姐姐给我的Switch里\\r\\n传送来了宝可梦呢！"
    },
    {
      "index": 3,
      "id": "msg_s001r0101_jeveniles_01",
      "hash": "2004766406f5a463",
      "flags": 0,
      "text": "我和爸爸约好在这里碰头！\\c\\n爸爸要把他捉到的宝可梦送给我呢！\\n好希望他能快点回来呀。"
    },
    {
      "index": 4,
      "id": "msg_s001r0101_bg_01",
      "hash": "ef7d72c4d1c4136f",
      "flags": 0,
      "text": "从Pokémon GO带来的宝可梦们\\n正在GO Park里开心地玩耍！"
    },
    {
      "index": 5,
      "id": "msg_s001r0101_bg_02",
      "hash": "ef7d73c4d1c41522",
      "flags": 0,
      "text": "有人带着许多从Pokémon GO\\n带来的宝可梦一起到处散步！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_s001r0101_max",
      "hash": "7ed7b6b954a8f736"
    }
  ]
}
