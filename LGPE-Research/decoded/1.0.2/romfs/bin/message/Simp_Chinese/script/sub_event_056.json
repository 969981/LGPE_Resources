    {
      "index": 7,
      "id": "msg_sub056_select_02",
      "hash": "774707d385c9033a",
      "flags": 0,
      "text": "扔₽50"
    },
    {
      "index": 8,
      "id": "msg_sub056_select_03",
      "hash": "774708d385c904ed",
      "flags": 0,
      "text": "不扔了"
    },
    {
      "index": 9,
      "id": "msg_sub056_system_03",
      "hash": "72c7ec0669721e8a",
      "flags": 0,
      "text": "……噗通～噗通～噗通通！！"
    },
    {
      "index": 10,
      "id": "msg_sub056_system_04",
      "hash": "72c7e7066972160b",
      "flags": 0,
      "text": "……噗通！"
    },
    {
      "index": 11,
      "id": "msg_sub056_system_05",
      "hash": "72c7e60669721458",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]往喷水池里\\n扔进了₽[VAR NUM3(0001)]！"
    },
    {
      "index": 12,
      "id": "msg_sub056_partner_a_03",
      "hash": "efa39e4895ade8a5",
      "flags": 0,
      "text": "皮卡！皮～卡皮～！"
    },
    {
      "index": 13,
      "id": "msg_sub015_partner_b_03",
      "hash": "a95d56c4875f7dc1",
      "flags": 0,
      "text": "布伊布伊！布～伊！"
    },
    {
      "index": 14,
      "id": "msg_sub056_system_06",
      "hash": "72c7e90669721971",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]看上去好像挺开心！"
