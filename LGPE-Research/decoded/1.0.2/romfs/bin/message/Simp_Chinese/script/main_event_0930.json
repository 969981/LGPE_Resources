      "hash": "adb6fb13daa45e37",
      "flags": 0,
      "text": "站住站住～！！"
    },
    {
      "index": 1,
      "id": "msg_main0930_kojiro_02",
      "hash": "adb6fc13daa45fea",
      "flags": 0,
      "text": "小次郎：现在我们老大\\n正在谈重要的生意！\\c\\n你可休想捣乱！"
    },
    {
      "index": 2,
      "id": "msg_main0930_poke_01",
      "hash": "5b87615b7bf33a98",
      "flags": 0,
      "text": "喵喵：喵～！"
    },
    {
      "index": 3,
      "id": "msg_main0930_dummy_01",
