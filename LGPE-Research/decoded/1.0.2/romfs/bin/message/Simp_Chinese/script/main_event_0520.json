      "hash": "4e6d4b14c82cf186",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]：喂～～！卡拉卡拉！"
    },
    {
      "index": 1,
      "id": "msg_main0520_rival_02",
      "hash": "4e6d4a14c82cefd3",
      "flags": 0,
      "text": "哪儿都找不到呢……"
    },
    {
      "index": 2,
      "id": "msg_main0520_rival_05",
      "hash": "4e6d4f14c82cf852",
      "flags": 0,
      "text": "……呃，嗯？\\c\\n那个是？…………"
    },
    {
      "index": 3,
      "id": "msg_main0520_rival_03",
      "hash": "4e6d4914c82cee20",
      "flags": 0,
      "text": "！？！？！？\\c\\n呼……噢……\\n是咕……咕……"
    },
    {
      "index": 4,
      "id": "msg_main0520_rival_04",
      "hash": "4e6d5014c82cfa05",
      "flags": 0,
      "text": "鬼啊————！！！！\\n哇啊————！！"
    },
    {
      "index": 5,
      "id": "msg_main0520_karakara_01",
      "hash": "17b6e360cc60349a",
      "flags": 0,
      "text": "卡拉卡拉：灭……灭……！"
    },
    {
      "index": 6,
      "id": "msg_main0520_karakara_02",
      "hash": "17b6e260cc6032e7",
      "flags": 0,
      "text": "卡拉卡拉：吗嘛……"
    },
    {
      "index": 7,
      "id": "msg_main0520_sys_02",
      "hash": "1d7d732f937b4c0c",
      "flags": 0,
      "text": "卡拉卡拉一脸寂寞地下了楼。"
    },
    {
      "index": 8,
      "id": "msg_main0520_ghost_01",
      "hash": "a2819e116675adf3",
      "flags": 0,
      "text": "幽灵：离开吧……离开吧……"
    },
    {
      "index": 9,
      "id": "msg_main0520_sys_01",
      "hash": "1d7d762f937b5125",
      "flags": 0,
      "text": "被送回１楼了！"
    },
    {
      "index": 10,
      "id": "msg_main0520_garagara_01",
      "hash": "9389215f33b09c32",
      "flags": 0,
      "text": "……离开吧！\\n……从这里……离开吧……"
    },
    {
      "index": 11,
      "id": "msg_main0520_partner_a_01",
      "hash": "96b12953d45c8fd4",
      "flags": 0,
      "text": "皮……"
    },
    {
      "index": 12,
      "id": "msg_main0520_partner_b_01",
      "hash": "c12f21488af3d28b",
      "flags": 0,
      "text": "布咿……"
    },
    {
      "index": 13,
      "id": "msg_main0520_system_01",
      "hash": "5a9ae2a108e3b4cd",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]开始发抖，\\n不能前进了！"
    }
