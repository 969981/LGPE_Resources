{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0210_musashi_01",
      "hash": "b18ad45a43f61188",
      "flags": 0,
      "text": "？？？：且慢！"
    },
    {
      "index": 1,
      "id": "msg_main0210_musashi_02",
      "hash": "b18ad75a43f616a1",
      "flags": 0,
      "text": "？？？：我说！\\n那是我们的化石啦！"
    },
    {
      "index": 2,
      "id": "msg_main0210_kojiro_01",
      "hash": "8385b0e2d97ca66c",
      "flags": 0,
      "text": "？？？：气人啊！趁我们不注意\\n赶超我们什么的，太奸诈了吧！"
    },
    {
      "index": 3,
      "id": "msg_main0210_musashi_04",
      "hash": "b18ad95a43f61a07",
      "flags": 0,
      "text": "武藏：穿梭在银河的火箭队！\\n我是武藏！"
    },
    {
      "index": 4,
      "id": "msg_main0210_kojiro_02",
      "hash": "8385b3e2d97cab85",
      "flags": 0,
      "text": "小次郎：我是小次郎！"
    },
    {
      "index": 5,
      "id": "msg_main0210_musashi_05",
      "hash": "b18ad85a43f61854",
      "flags": 0,
      "text": "武藏：接下来就由我们两个\\n绚丽地抢走你手里的化石！"
    },
    {
      "index": 6,
      "id": "msg_main0210_dummy_01",
      "hash": "b7d4e7646265c3dc",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main0210_dummy_02",
      "hash": "b7d4ea646265c8f5",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "msg_main0210_musashi_03",
      "hash": "b18ad65a43f614ee",
      "flags": 0,
      "text": "火箭队：好讨厌的感觉啊～！"
    },
    {
      "index": 9,
      "id": "msg_main0210_musashi_back",
      "hash": "fe1468fabfa6374c",
      "flags": 0,
      "text": "武藏：话说，你只有１只宝可梦\\n怎么跟我们对战啊！\\c\\n带上另外１只宝可梦\\n再回来重新来过吧！"
    }
  ],
