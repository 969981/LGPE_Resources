      "id": "msg_sub018_rocketm_02",
      "hash": "c2e70a864051acf7",
      "flags": 0,
      "text": "……好了好了！\\n物归原主就是了。"
    },
    {
      "index": 2,
      "id": "msg_sub018_sys_01",
      "hash": "60db5616f88016d0",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]拿回了\\n[VAR ITEM2(0001)]\\r\\n“[VAR COLOR(0006)][VAR MOVE(0002)][VAR COLOR(0000)]”！"
