    {
      "index": 12,
      "id": "msg_sub017_system_05",
      "hash": "6b07f5203d3857af",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]喝了美味之水，\\n看上去很满足的样子！"
    },
    {
      "index": 13,
      "id": "msg_sub017_system_06",
      "hash": "6b07f6203d385962",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]被劲爽汽水的\\n泡泡吓了一跳！"
