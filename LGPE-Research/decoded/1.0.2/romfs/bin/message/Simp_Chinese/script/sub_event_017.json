    {
      "index": 8,
      "id": "msg_sub017_system_03",
      "hash": "6b07f3203d385449",
      "flags": 0,
      "text": "钱不够！\\c\\n……咦？\\n从口袋里找到了₽500！"
    },
    {
      "index": 9,
      "id": "msg_sub017_system_04",
      "hash": "6b07f4203d3855fc",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]送给[VAR PKNICK(0003)]了\\n[VAR ITEM2(0002)]！"
