      "hash": "6b07f1203d3850e3",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]正满脸好奇地\\n注视着自动贩卖机！"
    },
    {
      "index": 3,
      "id": "msg_sub017_system_02",
      "hash": "6b07f2203d385296",
      "flags": 0,
      "text": "要给它买饮料喝吗？"
    },
    {
      "index": 4,
      "id": "msg_sub017_select_01",
      "hash": "47853b7097ab1b90",
      "flags": 0,
      "text": "美味之水[VAR SYMBOL(0000)]₽[VAR NUM3(0001)]"
