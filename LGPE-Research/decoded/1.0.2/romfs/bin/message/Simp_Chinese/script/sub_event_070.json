    {
      "index": 17,
      "id": "msg_sub070_pokemaniac_08",
      "hash": "8107c4d0a1e3ca8e",
      "flags": 0,
      "text": "可以让袋兽超级进化的袋兽进化石，\\n售价₽[VAR NUM5(0000,0000)]……"
