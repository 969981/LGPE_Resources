{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "cnt_select_win_01",
      "hash": "209514ec56c75baa",
      "flags": 0,
      "text": "Pulsa un botón en el mando que quieras utilizar."
    },
    {
      "index": 1,
      "id": "cnt_select_win_02",
      "hash": "209513ec56c759f7",
      "flags": 0,
      "text": "¿Quieres utilizar este mando?"
    },
    {
      "index": 2,
      "id": "cnt_select_win_03",
      "hash": "209512ec56c75844",
      "flags": 0,
      "text": "Se han invertido las funciones de los botones."
    },
    {
      "index": 3,
      "id": "cnt_select_win_04",
      "hash": "209511ec56c75691",
      "flags": 0,
      "text": "No puedes usar la Poké Ball Plus sin haber\\nfinalizado los preparativos. ¿Quieres cancelar?"
    },
    {
      "index": 4,
      "id": "cnt_select_win_05",
      "hash": "209510ec56c754de",
      "flags": 0,
      "text": "Se han finalizado los preparativos."
    },
    {
      "index": 5,
      "id": "cnt_select_win_06",
      "hash": "20950fec56c7532b",
      "flags": 0,
      "text": "Finalizando preparativos...\\nNo apagues la consola."
    },
    {
      "index": 6,
      "id": "cnt_select_win_07",
      "hash": "20950eec56c75178",
      "flags": 0,
      "text": "Se ha producido un error.\\n\\nRepite el proceso desde el principio."
    },
    {
      "index": 7,
      "id": "cnt_select_win_08",
      "hash": "20950dec56c74fc5",
      "flags": 0,
      "text": "La Poké Ball Plus contiene un Pokémon de\\nregalo.\\n\\nSelecciona \"Comunicación\" en el menú y a\\ncontinuación \"Regalo Misterioso\" para recibirlo."
    },
    {
      "index": 8,
      "id": "cnt_select_win_09",
      "hash": "20950cec56c74e12",
      "flags": 0,
      "text": "Selecciona un mando para el segundo jugador."
    },
    {
      "index": 9,
      "id": "cnt_select_win_10",
      "hash": "20918fec56c443d4",
      "flags": 0,
      "text": "¿Quieres invertir la función de los botones de la\\nPoké Ball Plus?"
    },
    {
      "index": 10,
      "id": "cnt_select_win_11",
      "hash": "209190ec56c44587",
      "flags": 0,
      "text": "Selecciona un mando para el primer jugador."
    },
    {
      "index": 11,
      "id": "cnt_select_win_12",
      "hash": "209191ec56c4473a",
      "flags": 0,
      "text": "Conectando..."
    },
    {
      "index": 12,
      "id": "cnt_select_info_01",
      "hash": "b671815c01514bc8",
      "flags": 0,
      "text": "Cuando juegues con la Poké Ball Plus, podrás\\nabrir el menú principal con el botón superior."
    },
    {
      "index": 13,
      "id": "cnt_select_info_02",
      "hash": "b671845c015150e1",
      "flags": 4,
      "text": "En la pantalla del menú, agita dos veces la\\nPoké Ball Plus para acceder a \"Opciones\"."
    },
    {
      "index": 14,
      "id": "cnt_select_info_03",
      "hash": "b671835c01514f2e",
      "flags": 0,
      "text": "Cuando juegues con el Joy-Con derecho, podrás\\nabrir el menú principal con el botón X."
    },
    {
      "index": 15,
      "id": "cnt_select_info_04",
      "hash": "b671865c01515447",
      "flags": 0,
      "text": "Para confirmar una acción, pulsa cualquiera de\\nlas siguientes opciones:\\n\\n- Palanca derecha\\n- Botón R\\n- Botón ZR"
    },
    {
      "index": 16,
      "id": "cnt_select_info_05",
      "hash": "b671855c01515294",
      "flags": 0,
      "text": "Cuando juegues con el Joy-Con izquierdo,\\npodrás abrir el menú principal con el\\nbotón arriba."
    },
    {
      "index": 17,
      "id": "cnt_select_info_06",
      "hash": "b671885c015157ad",
      "flags": 0,
      "text": "Para confirmar una acción, pulsa cualquiera de\\nlas siguientes opciones:\\n\\n- Palanca izquierda\\n- Botón L\\n- Botón ZL"
    },
    {
      "index": 18,
      "id": "cnt_select_info_07",
      "hash": "b671875c015155fa",
      "flags": 0,
      "text": "Cuando juegues en modo portátil, podrás abrir\\nel menú principal con el botón X."
    },
    {
      "index": 19,
      "id": "cnt_select_info_08",
      "hash": "b6717a5c01513fe3",
      "flags": 0,
      "text": "Pulsa la palanca derecha para confirmar en el\\nmodo portátil\\n\\nLa pantalla táctil podrá utilizarse solo en\\nalgunas ocasiones."
    },
    {
      "index": 20,
      "id": "cnt_select_sel_01",
      "hash": "b34042664de9fcd8",
      "flags": 0,
      "text": "Confirmar"
    },
    {
      "index": 21,
      "id": "cnt_select_sel_02",
      "hash": "b34045664dea01f1",
      "flags": 0,
      "text": "Ver detalles "
    },
    {
      "index": 22,
      "id": "cnt_select_sel_03",
      "hash": "b34044664dea003e",
      "flags": 4,
      "text": "Invertir botones"
    },
    {
      "index": 23,
      "id": "cnt_select_sel_04",
      "hash": "b34047664dea0557",
      "flags": 0,
      "text": "Salir"
    },
