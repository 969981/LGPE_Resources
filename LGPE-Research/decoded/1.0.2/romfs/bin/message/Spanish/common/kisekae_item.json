    {
      "index": 178,
      "id": "kisekae_item_shop_01",
      "hash": "0761ff1f93abba5b",
      "flags": 0,
      "text": "Bienvenid[VAR GENDBR(00FF,0101)]oa. ¿En qué puedo ayudarle?\\n¿Busca algo en concreto?"
    },
    {
      "index": 179,
      "id": "kisekae_item_shop_02",
      "hash": "0762001f93abbc0e",
      "flags": 4,
      "text": "Oh, me parece que ya ha adquirido todo el\\ngénero del que disponemos."
    },
    {
      "index": 180,
      "id": "kisekae_item_shop_03",
      "hash": "0762011f93abbdc1",
      "flags": 0,
      "text": "¿[VAR VARESP01(0001)][VAR STYLEITEM(0001)]?\\nMuy buena decisión y mejor precio todavía:\\r\\ntan solo [VAR NUM6(0002,202F)] ₽."
    },
    {
      "index": 181,
      "id": "kisekae_item_shop_04",
      "hash": "0762021f93abbf74",
      "flags": 0,
      "text": "¡Trato hecho!"
    },
    {
      "index": 182,
      "id": "kisekae_item_shop_05",
      "hash": "0762031f93abc127",
      "flags": 0,
      "text": "Mejor no, gracias"
    },
    {
      "index": 183,
      "id": "kisekae_item_shop_06",
      "hash": "0762041f93abc2da",
      "flags": 0,
      "text": "Muchas gracias por su compra.\\n¡Con clientes como usted, da gusto!"
    },
    {
      "index": 184,
      "id": "kisekae_item_shop_07",
      "hash": "0762051f93abc48d",
      "flags": 0,
      "text": "Has puesto [VAR VARESP00(0001)][VAR STYLEITEM(0001)]\\nen la Maleta."
    },
    {
      "index": 185,
      "id": "kisekae_item_shop_08",
      "hash": "0761f61f93abab10",
      "flags": 0,
      "text": "¡Vuelva cuando quiera!"
    },
    {
      "index": 186,
      "id": "kisekae_item_shop_09",
      "hash": "0761f71f93abacc3",
      "flags": 0,
      "text": "Mucho me temo que no dispone de efectivo\\nsuficiente."
