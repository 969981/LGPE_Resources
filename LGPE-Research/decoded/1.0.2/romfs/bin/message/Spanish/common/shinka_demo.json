  "lines": [
    {
      "index": 0,
      "id": "msg_shinka_01_01",
      "hash": "ca1cc2bee54179c3",
      "flags": 0,
      "text": "¡Anda! ¡[VAR PKNICK(0000)] está evolucionando!"
    },
    {
      "index": 1,
      "id": "msg_shinka_02_01",
      "hash": "a1514aca301af20c",
      "flags": 0,
      "text": "¿Eh? ¡La evolución de [VAR PKNICK(0000)]\\nse ha detenido!"
    },
    {
      "index": 2,
      "id": "msg_shinka_03_01",
      "hash": "f7b716d1cb84b5e1",
      "flags": 0,
      "text": "¡Enhorabuena! ¡Tu [VAR PKNICK(0000)]\\nha evolucionado a [VAR POKNAME(0001)]!"
    },
    {
      "index": 3,
      "id": "msg_shinka_04_01",
      "hash": "98e44e952c6493d2",
      "flags": 0,
      "text": "¡[VAR PKNICK(0000)] ha aprendido\\n[VAR MOVE(0001)]![VAR SFX(0004)][VAR SFX(0001)]"
    },
    {
      "index": 4,
      "id": "msg_shinka_05_01",
      "hash": "6fac5aa076e21a87",
      "flags": 0,
      "text": "1, [WAIT 20]2 y... [WAIT 20]¡puf![VAR SFX(0003)][VAR SFX(0000)]\\c\\n¡[VAR PKNICK(0000)] ha olvidado cómo utilizar\\n[VAR MOVE(0001)]!\\c\\nY...\\c\\n¡Ha aprendido [VAR MOVE(0002)]![VAR SFX(0004)][VAR SFX(0001)]"
    },
    {
      "index": 5,
      "id": "msg_shinka_06_01",
      "hash": "c61202a8124ba130",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] no ha aprendido\\n[VAR MOVE(0001)]."
    },
    {
      "index": 6,
      "id": "msg_shinka_07_01",
      "hash": "f35f0eae74ca7ce5",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] quiere aprender\\n[VAR MOVE(0001)].\\c\\n¿Quieres sustituir alguno de sus movimientos\\npor [VAR MOVE(0001)]?"
    },
    {
      "index": 7,
      "id": "msg_shinka_10_01",
      "hash": "3c11b2c38f68a511",
      "flags": 0,
      "text": "Sustituir un movimiento"
    },
    {
      "index": 8,
      "id": "msg_shinka_10_02",
      "hash": "3c11afc38f689ff8",
      "flags": 0,
      "text": "Conservar movimientos"
