{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "matching_win_01",
      "hash": "0244fd0f825809cb",
      "flags": 0,
      "text": "Se va a iniciar la comunicación.\\nElige una opción."
    },
    {
      "index": 1,
      "id": "matching_win_02",
      "hash": "0244fe0f82580b7e",
      "flags": 0,
      "text": "¿Qué quieres hacer?"
    },
    {
      "index": 2,
      "id": "matching_win_03",
      "hash": "0244ff0f82580d31",
      "flags": 4,
      "text": "Introduce el mismo código que otro jugador\\npara establecer la conexión."
    },
    {
      "index": 3,
      "id": "matching_win_04",
      "hash": "0245000f82580ee4",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "matching_win_05",
      "hash": "0245010f82581097",
      "flags": 0,
      "text": "Puedes establecer conexión con otro jugador\\ntras introducir el mismo código.\\c\\nSelecciona tres Pokémon en el mismo orden."
    },
    {
      "index": 5,
      "id": "matching_win_06",
      "hash": "0245020f8258124a",
      "flags": 0,
      "text": "Buscando rival para un Combate Individual..."
    },
    {
      "index": 6,
      "id": "matching_win_07",
      "hash": "0245030f825813fd",
      "flags": 0,
      "text": "Buscando rival para un Combate Doble..."
    },
    {
      "index": 7,
      "id": "matching_win_08",
      "hash": "0244f40f8257fa80",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "matching_win_09",
      "hash": "0244f50f8257fc33",
      "flags": 0,
      "text": "Buscando una persona con la que realizar un\\nintercambio..."
    },
    {
      "index": 9,
      "id": "matching_win_10",
      "hash": "0248820f825b21a1",
      "flags": 0,
      "text": "Se ha encontrado una persona interesada.\\nEspera unos instantes."
    },
    {
      "index": 10,
      "id": "matching_win_11",
      "hash": "0248810f825b1fee",
      "flags": 4,
      "text": "Ahora mismo no puedes realizar intercambios\\nen conexión porque se produjo un error de\\nconexión o la consola se apagó durante el\\ntranscurso del último intercambio.\\n\\n[VAR COLOR(0002)]Inténtalo de nuevo más tarde.[VAR COLOR(0000)]"
    },
    {
      "index": 11,
      "id": "matching_win_12",
      "hash": "0248800f825b1e3b",
      "flags": 0,
      "text": "Para poder realizar intercambios necesitas\\ncontar con dos Pokémon por lo menos.\\n\\nNo puedes intercambiar a tu compañero ni a un\\nPokémon que hayas sacado de su Poké Ball.\\n\\nVuelve a intentarlo cuando tengas más Pokémon."
    },
    {
      "index": 12,
      "id": "matching_win_13",
      "hash": "02487f0f825b1c88",
      "flags": 0,
      "text": "No es posible librar un Combate Doble porque\\nnecesitas al menos dos Pokémon en tu equipo\\no en tu caja.\\n\\nVuelve a intentarlo cuando tengas más Pokémon."
    },
    {
      "index": 13,
      "id": "matching_win_14",
      "hash": "0248860f825b286d",
      "flags": 0,
      "text": "Se va a establecer la conexión a internet.\\nTu partida se guardará.\\c\\n¿Quieres seguir adelante?"
    },
    {
      "index": 14,
      "id": "matching_win_15",
      "hash": "0248850f825b26ba",
      "flags": 0,
      "text": "Se ha establecido la conexión a internet."
    },
    {
      "index": 15,
      "id": "matching_win_16",
      "hash": "0248840f825b2507",
      "flags": 0,
      "text": "Guardando...\\nEspera unos instantes."
    },
    {
      "index": 16,
      "id": "matching_win_17",
      "hash": "0248830f825b2354",
      "flags": 0,
      "text": "Conexión en curso...\\nEspera unos instantes."
    },
    {
      "index": 17,
      "id": "matching_cap_01",
      "hash": "b85892b9113f52d9",
      "flags": 0,
      "text": "Jugadores cercanos"
    },
    {
      "index": 18,
      "id": "matching_cap_02",
      "hash": "b8588fb9113f4dc0",
      "flags": 0,
      "text": "Jugadores lejanos"
    },
    {
      "index": 19,
      "id": "matching_cap_03",
      "hash": "b85890b9113f4f73",
      "flags": 0,
      "text": "Comunicación local"
    },
    {
      "index": 20,
      "id": "matching_cap_04",
      "hash": "b85895b9113f57f2",
      "flags": 0,
      "text": "Conexión a internet"
    },
    {
      "index": 21,
