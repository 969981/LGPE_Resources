    {
      "index": 10,
      "id": "TOWNMAP_20_01",
      "hash": "9e9ac914d7a1ec8a",
      "flags": 0,
      "text": "Hábitat de [VAR POKNAME(0000)]"
    },
    {
      "index": 11,
      "id": "TOWNMAP_20_02",
      "hash": "9e9ac814d7a1ead7",
      "flags": 0,
      "text": "Hábitat desconocido"
    },
    {
      "index": 12,
      "id": "TM_GUIDE_01",
      "hash": "de793f7747865099",
      "flags": 4,
      "text": "Una apacible senda campestre de exuberante\\nvegetación."
    },
    {
      "index": 13,
      "id": "TM_GUIDE_02",
      "hash": "de793c7747864b80",
      "flags": 4,
      "text": "Un camino con abundantes desniveles que parte\\ndel Bosque Verde."
    },
    {
      "index": 14,
      "id": "TM_GUIDE_03",
      "hash": "de793d7747864d33",
      "flags": 4,
      "text": "En esta senda, situada a los pies de la montaña,\\nabundan las rocas de gran tamaño."
    },
    {
      "index": 15,
      "id": "TM_GUIDE_04",
      "hash": "de794277478655b2",
      "flags": 4,
      "text": "Esta senda, que atraviesa el Monte Moon, no\\npuede remontarse tras llegar a Ciudad Celeste."
    },
    {
      "index": 16,
      "id": "TM_GUIDE_05",
      "hash": "de79437747865765",
      "flags": 4,
      "text": "Una cuesta poco pronunciada desde la que se\\naccede a una Vía Subterránea."
    },
    {
      "index": 17,
      "id": "TM_GUIDE_06",
      "hash": "de7940774786524c",
      "flags": 4,
      "text": "Una senda entre Ciudad Azafrán y Ciudad\\nCarmín con acceso a una Vía Subterránea."
    },
    {
      "index": 18,
      "id": "TM_GUIDE_07",
      "hash": "de794177478653ff",
      "flags": 4,
      "text": "Un breve trecho con acceso a la Vía\\nSubterránea que conduce a la Ruta 8."
    },
    {
      "index": 19,
      "id": "TM_GUIDE_08",
      "hash": "de79467747865c7e",
      "flags": 4,
      "text": "Un breve trecho con acceso a la Vía\\nSubterránea que conduce a la Ruta 7."
    },
    {
      "index": 20,
      "id": "TM_GUIDE_09",
      "hash": "de79477747865e31",
      "flags": 4,
      "text": "Una senda con abundantes desniveles donde\\nlos niños suelen ir a jugar."
    },
    {
      "index": 21,
      "id": "TM_GUIDE_10",
      "hash": "de7cc4774789686f",
      "flags": 4,
      "text": "Este camino, que discurre paralelo a un canal,\\nconduce al Túnel Roca."
    },
    {
      "index": 22,
      "id": "TM_GUIDE_11",
      "hash": "de7cc377478966bc",
      "flags": 4,
      "text": "Un prado que sirve de punto de encuentro para\\nEntrenadores y de acceso a la Cueva Diglett."
    },
    {
      "index": 23,
      "id": "TM_GUIDE_12",
      "hash": "de7cc67747896bd5",
      "flags": 0,
      "text": "Los Pescadores frecuentan los pantalanes de\\nesta zona, apodada Puente Silencio."
    },
    {
      "index": 24,
      "id": "TM_GUIDE_13",
      "hash": "de7cc57747896a22",
      "flags": 4,
      "text": "Una refrescante senda costera con una zona\\nlaberíntica."
    },
    {
      "index": 25,
      "id": "TM_GUIDE_14",
      "hash": "de7cc077478961a3",
      "flags": 4,
      "text": "Una senda costera flanqueada por árboles\\ndonde disfrutar de la salada brisa marina."
    },
    {
      "index": 26,
      "id": "TM_GUIDE_15",
      "hash": "de7cbf7747895ff0",
      "flags": 4,
      "text": "Una senda con abundante vegetación que se\\nextiende en línea recta al este de Ciudad Fucsia."
    },
    {
      "index": 27,
      "id": "TM_GUIDE_16",
      "hash": "de7cc27747896509",
      "flags": 0,
      "text": "La parte norte del Camino de Pokémon es una\\nzona que siempre está rebosante de actividad."
    },
    {
      "index": 28,
      "id": "TM_GUIDE_17",
      "hash": "de7cc17747896356",
      "flags": 4,
      "text": "El Camino de Pokémon, donde Entrenadores y\\nPokémon disfrutan paseando juntos."
    },
    {
      "index": 29,
      "id": "TM_GUIDE_18",
      "hash": "de7ccc7747897607",
      "flags": 0,
      "text": "La parte sur del Camino de Pokémon, donde\\nmuchos Entrenadores se reúnen para combatir."
    },
    {
      "index": 30,
      "id": "TM_GUIDE_19",
      "hash": "de7ccb7747897454",
      "flags": 4,
      "text": "Un lugar ideal para darse un chapuzón o\\ntumbarse a la bartola bajo el sol."
    },
    {
      "index": 31,
      "id": "TM_GUIDE_20",
      "hash": "de72d27747812bb4",
      "flags": 4,
      "text": "Una ruta marina en cuyo centro se encuentran\\nlas Islas Espuma."
    },
    {
      "index": 32,
      "id": "TM_GUIDE_21",
      "hash": "de72d37747812d67",
      "flags": 4,
      "text": "Una ruta de aguas inusualmente cálidas, debido\\na la actividad volcánica."
    },
    {
      "index": 33,
      "id": "TM_GUIDE_22",
      "hash": "de72d47747812f1a",
      "flags": 4,
      "text": "Un camino pavimentado que conduce\\ndirectamente a la Liga Pokémon."
    },
    {
      "index": 34,
      "id": "TM_GUIDE_23",
      "hash": "de72d577478130cd",
      "flags": 4,
      "text": "Una senda de montaña cuyo paso está\\nreservado a los Entrenadores más fuertes."
    },
    {
      "index": 35,
      "id": "TM_GUIDE_24",
      "hash": "de72ce77478124e8",
      "flags": 4,
      "text": "Una ruta al norte de Ciudad Celeste donde se\\nencuentra el famoso Puente Pepita."
    },
    {
      "index": 36,
      "id": "TM_GUIDE_25",
      "hash": "de72cf774781269b",
      "flags": 4,
      "text": "Un laberinto de arbustos que conduce hasta el\\ncabo."
    },
    {
      "index": 37,
      "id": "TM_GUIDE_26",
      "hash": "de72d0774781284e",
      "flags": 4,
      "text": "Un pueblecito de la campiña que alberga un\\nLaboratorio Pokémon."
    },
    {
      "index": 38,
      "id": "TM_GUIDE_27",
      "hash": "de72d17747812a01",
      "flags": 4,
      "text": "Un lugar para amantes de la naturaleza, donde\\nlas flores muestran su belleza todo el año."
    },
    {
      "index": 39,
      "id": "TM_GUIDE_28",
      "hash": "de72ca7747811e1c",
      "flags": 4,
      "text": "Una ciudad construida en piedra que yace a los\\npies de una montaña rocosa."
    },
    {
      "index": 40,
      "id": "TM_GUIDE_29",
      "hash": "de72cb7747811fcf",
      "flags": 4,
      "text": "En esta ciudad a orillas de un río se yergue el\\nGimnasio Pokémon de tipo Agua."
    },
    {
      "index": 41,
      "id": "TM_GUIDE_30",
      "hash": "de75d87747836bbd",
      "flags": 4,
      "text": "Un pueblo tranquilo y solemne donde los\\nPokémon descansan en paz."
    },
    {
      "index": 42,
      "id": "TM_GUIDE_31",
      "hash": "de75d77747836a0a",
      "flags": 4,
      "text": "Un puerto internacional desde el que zarpan\\ncruceros de lujo."
    },
    {
      "index": 43,
      "id": "TM_GUIDE_32",
      "hash": "de75d67747836857",
      "flags": 4,
      "text": "Una ciudad que aúna distintas generaciones,\\nfamosa por su centro comercial."
    },
    {
      "index": 44,
      "id": "TM_GUIDE_33",
      "hash": "de75d577478366a4",
      "flags": 4,
      "text": "En esta ciudad se encuentra la Zona Safari, que\\natrae a multitud de humanos y Pokémon."
    },
    {
      "index": 45,
      "id": "TM_GUIDE_34",
      "hash": "de75d477478364f1",
      "flags": 4,
      "text": "Una ciudad que se alza en una isla volcánica\\ny que alberga una mansión en ruinas."
    },
    {
      "index": 46,
      "id": "TM_GUIDE_35",
      "hash": "de75d3774783633e",
      "flags": 4,
      "text": "En este altiplano se alza majestuosa la sede de\\nla Liga Pokémon."
    },
    {
      "index": 47,
      "id": "TM_GUIDE_36",
      "hash": "de75d2774783618b",
      "flags": 0,
      "text": "La principal ciudad de Kanto, que se caracteriza\\npor sus edificios de gran altura."
    },
    {
      "index": 48,
      "id": "TM_GUIDE_37",
      "hash": "de75d17747835fd8",
      "flags": 4,
      "text": "Un bosque vasto y frondoso donde se concentra\\nun gran número de Pokémon insecto."
    },
    {
      "index": 49,
      "id": "TM_GUIDE_38",
      "hash": "de75d07747835e25",
      "flags": 4,
      "text": "Esta montaña, en cuyo interior pueden hallarse\\nfósiles, ha sufrido varios impactos de meteorito."
    },
    {
      "index": 50,
      "id": "TM_GUIDE_39",
      "hash": "de75cf7747835c72",
      "flags": 0,
      "text": "La oscuridad que reina en esta vasta gruta\\nnatural obliga a contar con una fuente de luz."
    },
    {
      "index": 51,
      "id": "TM_GUIDE_40",
      "hash": "de6bc677477af8a2",
      "flags": 4,
      "text": "Estas instalaciones repletas de maquinaria\\natraen a numerosos Pokémon de tipo Eléctrico."
    },
    {
      "index": 52,
      "id": "TM_GUIDE_41",
      "hash": "de6bc777477afa55",
      "flags": 4,
      "text": "Un paso subterráneo horadado por los Diglett\\nque conecta Ciudad Plateada y Ciudad Carmín."
    },
    {
      "index": 53,
      "id": "TM_GUIDE_42",
      "hash": "de6bc477477af53c",
      "flags": 0,
      "text": "Dos islotes en cuyo interior se llegan a alcanzar\\ntemperaturas sumamente bajas."
    },
    {
      "index": 54,
      "id": "TM_GUIDE_43",
      "hash": "de6bc577477af6ef",
      "flags": 0,
      "text": "Cruzarla es tal hazaña, que aquí solo vienen\\nlos Entrenadores que aspiran a lo más alto."
    },
