    },
    {
      "index": 64,
      "id": "go_park_50_03",
      "hash": "fb41418dbfc4c1a0",
      "flags": 0,
      "text": "Récord de [VAR POKNAME(0000)]"
    },
    {
      "index": 65,
      "id": "go_park_55_01",
      "hash": "a279077478cf9dbf",
      "flags": 0,
      "text": "¿Qué quieres hacer?\\nPulsa el [VAR COLOR(0006)]botón Y[VAR COLOR(0000)] para activar el [VAR COLOR(0006)]zoom[VAR COLOR(0000)]."
    },
    {
      "index": 66,
      "id": "go_park_55_02",
      "hash": "a279087478cf9f72",
      "flags": 0,
      "text": "Guardar la partida"
    },
    {
      "index": 67,
      "id": "go_park_55_03",
      "hash": "a279097478cfa125",
      "flags": 0,
      "text": "Volver a la recepción"
    },
    {
      "index": 68,
      "id": "go_park_55_05",
      "hash": "a279037478cf96f3",
      "flags": 0,
      "text": "Ver datos"
    },
    {
      "index": 69,
      "id": "go_park_55_04",
      "hash": "a279027478cf9540",
      "flags": 0,
      "text": "Nada"
    },
    {
      "index": 70,
      "id": "go_park_55_06",
      "hash": "a279047478cf98a6",
      "flags": 0,
      "text": "Te llevas de regalo...\\n¡[VAR NUM3(0001)] [VAR ITEMBAG(0000)]!"
    },
    {
      "index": 71,
      "id": "go_park_55_07",
      "hash": "a279057478cf9a59",
      "flags": 0,
      "text": "Has guardado el premio obtenido en [VAR VARESP00(0001)]\\n[VAR COLOR(0006)][VAR BAG(0001)][VAR COLOR(0000)]."
    },
    {
      "index": 72,
      "id": "go_park_55_10",
      "hash": "a27c8c7478d2b595",
      "flags": 0,
      "text": "¿Quieres guardar la partida?"
    },
    {
      "index": 73,
      "id": "go_park_55_11",
      "hash": "a27c8b7478d2b3e2",
      "flags": 0,
      "text": "Guardando...\\nNo apagues la consola."
    },
    {
      "index": 74,
      "id": "go_park_55_12",
      "hash": "a27c8a7478d2b22f",
      "flags": 0,
      "text": "Se ha guardado la partida."
    },
    {
      "index": 75,
      "id": "go_park_55_13",
      "hash": "a27c897478d2b07c",
      "flags": 0,
      "text": "No se ha podido guardar la partida."
    },
