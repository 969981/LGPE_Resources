      "text": "Pokémon del parque"
    },
    {
      "index": 40,
      "id": "go_park_20_01",
      "hash": "8b27a758d40dea4f",
      "flags": 4,
      "text": "Elige un GO Park."
    },
    {
      "index": 41,
      "id": "go_park_20_02",
      "hash": "8b27a858d40dec02",
      "flags": 0,
      "text": "¿Adónde quieres ir?"
    },
    {
      "index": 42,
      "id": "go_park_20_03",
      "hash": "8b27a958d40dedb5",
      "flags": 0,
      "text": "¿Dónde están los Pokémon con los que quieres jugar?"
    },
    {
      "index": 43,
      "id": "go_park_20_04",
      "hash": "8b27a258d40de1d0",
      "flags": 4,
      "text": "Elige los Pokémon con los que quieres jugar."
    },
    {
      "index": 44,
      "id": "go_park_20_05",
      "hash": "8b27a358d40de383",
      "flags": 4,
      "text": "Está en: [VAR COLOR(0006)][VAR GOPARKLOCAL(0000)][VAR COLOR(0000)]"
    },
    {
      "index": 45,
      "id": "go_park_20_06",
      "hash": "8b27a458d40de536",
      "flags": 0,
      "text": "¿Qué quieres hacer con [VAR GOPARKPKM(0000)]?"
    },
    {
      "index": 46,
      "id": "go_park_25_01",
      "hash": "8f31e36fa702e296",
      "flags": 0,
      "text": "Pokémon en [VAR GOPARKLOCAL(0000)]"
    },
    {
      "index": 47,
      "id": "go_park_25_02",
      "hash": "8f31e26fa702e0e3",
      "flags": 0,
      "text": "⇄ Cambiar de GO Park"
    },
    {
      "index": 48,
      "id": "go_park_30_01",
      "hash": "1aa10723e7fa36ec",
      "flags": 0,
      "text": "Has enviado el Pokémon seleccionado a\\n[VAR GOPARKLOCAL(0000)]."
    },
    {
      "index": 49,
      "id": "go_park_40_01",
      "hash": "6e71df9790fa2fe9",
      "flags": 0,
      "text": "¿Quieres volver a intentarlo?"
    },
    {
      "index": 50,
      "id": "go_park_40_02",
      "hash": "6e71dc9790fa2ad0",
      "flags": 0,
      "text": "Sí"
    },
    {
      "index": 51,
      "id": "go_park_40_03",
      "hash": "6e71dd9790fa2c83",
      "flags": 0,
      "text": "No"
    },
    {
      "index": 52,
      "id": "go_park_41_01",
      "hash": "16c5b38ff47b0654",
      "flags": 0,
      "text": "Has pausado la partida.\\n¿Qué quieres hacer?"
    },
    {
      "index": 53,
      "id": "go_park_41_02",
      "hash": "16c5b68ff47b0b6d",
      "flags": 0,
      "text": "Seguir jugando"
    },
    {
      "index": 54,
      "id": "go_park_41_03",
      "hash": "16c5b58ff47b09ba",
      "flags": 0,
      "text": "Volver a empezar"
    },
    {
      "index": 55,
      "id": "go_park_41_04",
      "hash": "16c5b08ff47b013b",
      "flags": 0,
      "text": "Salir de la Zona Lúdica"
    },
    {
      "index": 56,
      "id": "go_park_45_01",
      "hash": "3ccc6b6dd7c07818",
      "flags": 0,
      "text": "No hay suficientes Pokémon de esa especie.\\nAsegúrate de tener 25 ejemplares de ese\\nPokémon en GO Park."
    },
    {
      "index": 57,
      "id": "go_park_45_02",
      "hash": "3ccc6e6dd7c07d31",
      "flags": 0,
      "text": "Para jugar en la Zona Lúdica necesitas tener\\n25 Pokémon de una misma especie en GO Park."
    },
    {
      "index": 58,
      "id": "go_park_48_01",
      "hash": "0e636f55cacbd511",
      "flags": 0,
      "text": "Tiempo total"
    },
    {
      "index": 59,
      "id": "go_park_48_02",
      "hash": "0e636c55cacbcff8",
      "flags": 0,
      "text": "Mayor grupo de Pokémon entregado"
    },
    {
      "index": 60,
      "id": "go_park_48_03",
      "hash": "0e636d55cacbd1ab",
      "flags": 0,
      "text": "[~ 60]"
    },
    {
      "index": 61,
      "id": "go_park_48_04",
      "hash": "0e637255cacbda2a",
      "flags": 0,
      "text": "Resultado"
    },
