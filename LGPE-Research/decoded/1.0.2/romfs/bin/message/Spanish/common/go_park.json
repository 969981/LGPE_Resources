      "flags": 0,
      "text": "[VAR NUM2(0000)]:[VAR NUM2(0001)],[VAR NUM2(0002)]"
    },
    {
      "index": 89,
      "id": "go_park_80_01",
      "hash": "82fa3762ec0872bd",
      "flags": 0,
      "text": "Si atrapas a un Pokémon en un GO Park,\\ncambiará su información de Pokémon GO.\\n¿Quieres continuar de todos modos?"
    },
