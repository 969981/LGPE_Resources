    },
    {
      "index": 139,
      "id": "msg_box_05_00",
      "hash": "3cafc78d050e2d3b",
      "flags": 0,
      "text": "Se va a realizar el intercambio de Pokémon.\\n¿Quieres continuar?"
    },
    {
      "index": 140,
      "id": "msg_box_05_12",
      "hash": "3cac3f8d050b104c",
      "flags": 0,
      "text": "¿Quieres cancelar el intercambio de Pokémon?"
    },
    {
      "index": 141,
      "id": "msg_box_05_13",
      "hash": "3cac408d050b11ff",
      "flags": 0,
      "text": "¿Quieres transferir el Pokémon seleccionado?"
    },
    {
      "index": 142,
      "id": "msg_box_05_13_2",
      "hash": "93d31e24c2a69ad6",
      "flags": 0,
      "text": "¿Quieres transferir los Pokémon seleccionados?"
    },
    {
      "index": 143,
      "id": "msg_box_05_18",
      "hash": "3cac498d050b214a",
      "flags": 0,
      "text": "No puedes enviar Pokémon de tu lista de\\nfavoritos. ¿Quieres eliminarlo de la lista?"
    },
    {
      "index": 144,
      "id": "msg_box_05_19",
      "hash": "3cac4a8d050b22fd",
      "flags": 0,
      "text": "[VAR COLOR(0006)]¿Seguro que quieres transferir este Pokémon?[VAR COLOR(0000)]"
    },
    {
      "index": 145,
      "id": "msg_box_05_30",
      "hash": "3ca5b58d0505ba20",
      "flags": 0,
      "text": "Has transferido el Pokémon al profesor.\\c\\n...\\c\\nTe ha llegado un mensaje de su parte.\\c"
    },
    {
      "index": 146,
      "id": "msg_box_05_30_2",
      "hash": "896bf5155747d04d",
      "flags": 0,
      "text": "Has transferido los Pokémon al profesor.\\c\\n...\\c\\nTe ha llegado un mensaje de su parte.\\c"
    },
    {
      "index": 147,
      "id": "msg_box_05_31",
      "hash": "3ca5b68d0505bbd3",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Oak:[VAR COLOR(0000)] Gracias por transferirme ese Pokémon.\\nMe vendrá de perlas para mi investigación.\\c"
    },
    {
      "index": 148,
      "id": "msg_box_05_31_2",
      "hash": "8fe10c155a5015a2",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Oak:[VAR COLOR(0000)] Gracias por transferirme esos Pokémon.\\nMe vendrán de perlas para mi investigación.\\c"
    },
    {
      "index": 149,
      "id": "msg_box_05_32",
      "hash": "3ca5b78d0505bd86",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Oak:[VAR COLOR(0000)] ¡Te agradezco tu colaboración!\\nLa investigación va viento en popa gracias a ti.\\c"
    },
    {
      "index": 150,
      "id": "msg_box_05_33",
      "hash": "3ca5b88d0505bf39",
      "flags": 0,
      "text": "Si mis cálculos son correctos, me has enviado\\nya [VAR NUM9(0001,202F)] [VAR POKNAME(0000)].\\c"
    },
    {
      "index": 151,
      "id": "msg_box_05_34",
      "hash": "3ca5b98d0505c0ec",
      "flags": 0,
      "text": "¡Uy! [VAR PKNICK(0000)] es un Pokémon un tanto\\nexcepcional, ¿no crees?\\c"
    },
    {
      "index": 152,
      "id": "msg_box_05_35",
      "hash": "3ca5ba8d0505c29f",
      "flags": 0,
      "text": "Como tu ayuda me está resultando inestimable,\\ncreo que te mereces una recompensa.\\c\\n¡Espero que a tu[VAR ITEMPLUR1(00FD,0100)]s Pokémon le[VAR ITEMPLUR1(00FD,0100)]s gusten los\\n[VAR COLOR(0006)]caramelos[VAR COLOR(0000)]!\\c\\nDale caramelos a un Pokémon para fortalecerlo.\\c"
    },
    {
      "index": 153,
      "id": "msg_box_05_36",
      "hash": "3ca5bb8d0505c452",
      "flags": 0,
      "text": "Te mereces una recompensa.\\c"
    },
    {
      "index": 154,
      "id": "msg_box_05_37",
      "hash": "3ca5bc8d0505c605",
      "flags": 0,
      "text": "Has metido la recompensa en el [VAR COLOR(0006)]Tarro de[VAR COLOR(0000)]\\n[VAR COLOR(0006)]Caramelos[VAR COLOR(0000)].\\c"
    },
    {
      "index": 155,
      "id": "msg_box_05_38",
      "hash": "3ca5bd8d0505c7b8",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Oak:[VAR COLOR(0000)] Por ahora me has enviado un total de\\n[VAR NUM9(0001,202F)] Pokémon. ¡Sigue así!\\c"
    },
    {
      "index": 156,
      "id": "msg_box_05_17",
      "hash": "3cac3c8d050b0b33",
      "flags": 0,
      "text": "[~ 156]"
    },
    {
      "index": 157,
      "id": "msg_box_05_01",
      "hash": "3cafc68d050e2b88",
      "flags": 0,
      "text": "No puedes intercambiar a tu compañero ni a un\\nPokémon que hayas sacado de su Poké Ball."
    },
    {
      "index": 158,
      "id": "msg_box_05_02",
      "hash": "3cafc98d050e30a1",
      "flags": 0,
      "text": "¡Necesitas ese Pokémon para tu aventura!"
    },
    {
      "index": 159,
      "id": "msg_box_05_03",
      "hash": "3cafc88d050e2eee",
      "flags": 0,
