      "flags": 0,
      "text": "[~ 160]"
    },
    {
      "index": 161,
      "id": "msg_box_05_05",
      "hash": "3cafca8d050e3254",
      "flags": 4,
      "text": "Es un Pokémon especial, por lo que no lo\\npuedes intercambiar."
    },
    {
      "index": 162,
      "id": "msg_box_05_06",
      "hash": "3cafcd8d050e376d",
      "flags": 4,
      "text": "Este Pokémon lleva un objeto especial, por lo\\nque no lo puedes intercambiar."
    },
    {
      "index": 163,
      "id": "msg_box_05_07",
      "hash": "3cafcc8d050e35ba",
      "flags": 0,
      "text": "Conectando...\\nPor favor, espera."
