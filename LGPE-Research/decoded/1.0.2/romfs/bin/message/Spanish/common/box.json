    {
      "index": 248,
      "id": "msg_box_search_06_00",
      "hash": "c171276dc3f5e1b5",
      "flags": 0,
      "text": "No se ha podido encontrar ningún Pokémon con\\nesas características."
    },
    {
      "index": 249,
      "id": "msg_box_search_06_01",
      "hash": "c171266dc3f5e002",
      "flags": 0,
      "text": "Los Pokémon se han ordenado según la fecha de\\ncaptura."
    },
    {
      "index": 250,
      "id": "msg_box_search_06_02",
      "hash": "c171256dc3f5de4f",
      "flags": 0,
      "text": "Los Pokémon se han ordenado según su número\\nde entrada de la Pokédex."
    },
    {
      "index": 251,
      "id": "msg_box_search_06_03",
      "hash": "c171246dc3f5dc9c",
      "flags": 0,
      "text": "Los Pokémon se han ordenado según su nivel,\\ndel más alto al más bajo."
    },
    {
      "index": 252,
      "id": "msg_box_search_06_04",
      "hash": "c171236dc3f5dae9",
      "flags": 0,
      "text": "Los Pokémon se han ordenado según su nivel,\\ndel más bajo al más alto."
    },
    {
      "index": 253,
      "id": "msg_box_search_06_05",
      "hash": "c171226dc3f5d936",
      "flags": 0,
      "text": "Los Pokémon se han ordenado según sus Puntos\\nde Combate, de mayor a menor."
    },
    {
      "index": 254,
      "id": "msg_box_search_06_06",
      "hash": "c171216dc3f5d783",
      "flags": 0,
      "text": "Los Pokémon se han ordenado según sus Puntos\\nde Combate, de menor a mayor."
    },
    {
      "index": 255,
      "id": "msg_box_search_06_07",
      "hash": "c171206dc3f5d5d0",
      "flags": 0,
      "text": "Los Pokémon se han ordenado empezando por\\nlos registrados en la lista de favoritos."
    },
    {
      "index": 256,
      "id": "msg_box_search_06_08",
      "hash": "c1712f6dc3f5ef4d",
      "flags": 0,
      "text": "Los Pokémon se han ordenado alfabéticamente\\nsegún el nombre de la especie."
    },
