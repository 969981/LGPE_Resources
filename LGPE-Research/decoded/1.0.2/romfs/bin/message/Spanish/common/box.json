      "index": 286,
      "id": "msg_box_p2ptrade_01",
      "hash": "9c3dfbd95c711245",
      "flags": 4,
      "text": "El otro jugador ha cancelado el intercambio."
    },
    {
      "index": 287,
      "id": "msg_box_p2ptrade_02",
      "hash": "9c3df8d95c710d2c",
      "flags": 0,
      "text": "Has cancelado el intercambio."
    },
    {
      "index": 288,
      "id": "msg_box_p2ptrade_03",
      "hash": "9c3df9d95c710edf",
      "flags": 0,
      "text": "No se puede realizar el intercambio porque hay\\nun problema con el Pokémon del otro jugador."
    },
    {
      "index": 289,
      "id": "msg_box_p2ptrade_04",
      "hash": "9c3df6d95c7109c6",
      "flags": 0,
      "text": "¿Quieres cancelar el intercambio de Pokémon?"
    },
    {
      "index": 290,
      "id": "msg_box_p2ptrade_05",
      "hash": "9c3df7d95c710b79",
      "flags": 4,
      "text": "El intercambio no tendrá lugar ya que el otro\\njugador ha decidido cancelarlo."
    },
    {
      "index": 291,
      "id": "msg_box_p2ptrade_06",
      "hash": "9c3df4d95c710660",
      "flags": 4,
      "text": "Interrumpiendo la conexión...\\nEspera unos instantes."
    },
