  "lines": [
    {
      "index": 0,
      "id": "net_save_win_01",
      "hash": "eeefe4d96acc1c25",
      "flags": 0,
      "text": "Guardando...\\nPor favor, espera."
    },
    {
      "index": 1,
      "id": "net_save_win_02",
      "hash": "eeefe1d96acc170c",
      "flags": 0,
      "text": "¡Aviso!\\n\\nSi se produce un error de conexión o se apaga\\nla consola en mitad de un intercambio de\\nPokémon, deberás esperar un tiempo antes de\\nintentarlo de nuevo."
    },
    {
      "index": 2,
      "id": "net_save_win_03",
      "hash": "eeefe2d96acc18bf",
      "flags": 0,
      "text": "Conectando...\\nPor favor, espera."
    },
    {
      "index": 3,
      "id": "net_save_win_04",
      "hash": "eeefdfd96acc13a6",
      "flags": 0,
      "text": "¿Quieres interrumpir la conexión?"
    },
    {
      "index": 4,
      "id": "net_save_sel_01",
      "hash": "0bb15cc36812039f",
      "flags": 0,
      "text": "Sí"
    },
    {
      "index": 5,
      "id": "net_save_sel_02",
      "hash": "0bb15dc368120552",
      "flags": 0,
      "text": "No"
    },
    {
      "index": 6,
      "id": "net_save_sel_03",
      "hash": "0bb15ec368120705",
      "flags": 0,
      "text": "Cancelar"
    },
    {
      "index": 7,
      "id": "net_save_win_05",
      "hash": "eeefe0d96acc1559",
      "flags": 0,
      "text": "Se ha interrumpido la conexión.\\nEl intercambio no tendrá lugar."
    }
  ],
