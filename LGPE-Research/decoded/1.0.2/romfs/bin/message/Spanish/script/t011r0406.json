{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t011r0406_staffm_01_01",
      "hash": "0be8b870e46fb319",
      "flags": 0,
      "text": "¡El Team Rocket apareció de la nada y se hizo\\ncon el control de todo el edificio!"
    },
    {
      "index": 1,
      "id": "msg_t011r0406_staffm_01_02",
      "hash": "0be8b570e46fae00",
      "flags": 0,
      "text": "Pues nada, ¡más vale que vuelva al trabajo!"
    },
    {
      "index": 2,
      "id": "msg_t011r0406_staffm_02_01",
      "hash": "b2b3f8579d1e8ca6",
      "flags": 0,
      "text": "P-por favor... que alguien nos a-ayude...\\n¡Socorro!"
    },
    {
      "index": 3,
      "id": "msg_t011r0406_staffm_02_02",
      "hash": "b2b3f7579d1e8af3",
      "flags": 4,
      "text": "Acabamos de prometernos. ¡Me caso! ¡Yo!\\n¡Aún no me lo creo!"
    },
    {
      "index": 4,
      "id": "msg_t011r0406_stafff_01_01",
      "hash": "5be33248487ab10c",
      "flags": 0,
      "text": "Madre mía, ¿se puede ser más cobardica?"
    },
    {
      "index": 5,
      "id": "msg_t011r0406_stafff_01_02",
      "hash": "5be33548487ab625",
      "flags": 0,
      "text": "¡Si es que el pobre necesita a alguien que lo\\nmeta en vereda!"
    },
    {
      "index": 6,
      "id": "msg_t011r0406_stafff_02_01",
      "hash": "84aeaa3cfda138c3",
      "flags": 0,
      "text": "¡El Team Rocket planea usar a los Pokémon para\\nconquistar el mundo!"
    },
    {
      "index": 7,
      "id": "msg_t011r0406_stafff_02_02",
      "hash": "84aeab3cfda13a76",
      "flags": 0,
      "text": "¡Gracias a ti el Team Rocket ha salido por\\npatas!"
    },
    {
      "index": 8,
      "id": "msg_t011r0406_staffm_03_01",
      "hash": "e06e045dfffa3a3b",
      "flags": 0,
      "text": "Deben de haber elegido a Silph por nuestros\\nproductos Pokémon."
    },
    {
      "index": 9,
      "id": "msg_t011r0406_staffm_03_02",
      "hash": "e06e055dfffa3bee",
      "flags": 0,
      "text": "¡Vente a trabajar para Silph cuando seas mayor!"
    },
    {
      "index": 10,
      "id": "msg_t011r0406_kanban_01",
      "hash": "b2cecfecd049be2b",
      "flags": 4,
      "text": "Oficina Central de Silph S. A.\\nP5"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t011r0406_max",
