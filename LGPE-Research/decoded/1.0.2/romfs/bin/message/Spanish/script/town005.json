  "lines": [
    {
      "index": 0,
      "id": "msg_town005_kanban_01",
      "hash": "e9b56ce052d8e502",
      "flags": 0,
      "text": "Pueblo Lavanda\\nEl noble pueblo púrpura."
    },
    {
      "index": 1,
      "id": "msg_town005_kanban_02",
      "hash": "e9b56be052d8e34f",
      "flags": 0,
      "text": "¡El nuevo Visor Silph hace visible lo invisible!\\n                          Silph S. A."
    },
    {
      "index": 2,
      "id": "msg_town005_kanban_03",
      "hash": "e9b56ae052d8e19c",
      "flags": 0,
      "text": "Casa Pokémon\\nCentro de voluntariado"
    },
    {
      "index": 3,
      "id": "msg_town005_kanban_04",
      "hash": "e9b569e052d8dfe9",
      "flags": 0,
      "text": "Torre Pokémon\\nDescansen en paz las almas de los Pokémon."
    },
    {
      "index": 4,
      "id": "msg_town005_juveniles_01_01",
      "hash": "dd108a5f7ce63432",
      "flags": 0,
      "text": "¿Crees en los fantasmas?"
    },
    {
      "index": 5,
      "id": "msg_town005_juveniles_01_02",
      "hash": "dd10895f7ce6327f",
      "flags": 0,
      "text": "¿De verdad? ¡Oír para creer!"
    },
    {
      "index": 6,
      "id": "msg_town005_juveniles_01_03",
      "hash": "dd10885f7ce630cc",
      "flags": 0,
      "text": "¡Ja, ja, ja! Yo tampoco.\\c\\nEsa mano blanca sobre tu hombro debe de ser\\nfruto de mi imaginación."
    },
    {
      "index": 7,
      "id": "msg_town005_adultm_01",
      "hash": "85160d0b0641adba",
      "flags": 4,
      "text": "Este pueblo es famoso por las tumbas de\\nPokémon.\\c\\nCuando un Pokémon pasa a mejor vida, lo\\nllevan a la Torre Pokémon para rogar por que\\r\\nsu espíritu halle eterno descanso."
    },
    {
      "index": 8,
      "id": "msg_town005_youngm_01",
      "hash": "992c8d4ceabdd3c2",
      "flags": 0,
      "text": "Dicen que últimamente están apareciendo\\nfantasmas en la Torre Pokémon.\\c\\nYo diría que son espíritus de Pokémon\\nsecuestrados por el Team Rocket."
    },
    {
      "index": 9,
      "id": "msg_town005_oldf_01",
      "hash": "2d0312137a06f17c",
      "flags": 4,
      "text": "Aaah... Cómo me relaja el aroma del incienso..."
    },
    {
      "index": 10,
      "id": "msg_town005_poke_01",
      "hash": "575f74472b704770",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Nidoran♀:[VAR COLOR(0000)] ¡Nidooo!"
    },
    {
      "index": 11,
      "id": "msg_town005_childf_01",
      "hash": "e3b08901e734d73f",
      "flags": 0,
      "text": "¡En la Torre Pokémon no se debe hacer ruido!\\n¿A que no lo sabías?"
    }
  ],
