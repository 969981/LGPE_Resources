  "lines": [
    {
      "index": 0,
      "id": "msg_t006r0101_fat_01_01",
      "hash": "16a1c4266049649d",
      "flags": 0,
      "text": "¿A que es preciosa la cola de mi Pikachu?"
    },
    {
      "index": 1,
      "id": "msg_t006r0101_fat_01_02",
      "hash": "16a1c12660495f84",
      "flags": 0,
      "text": "¡Bah! Mi Pikachu es mucho más cuco que ese."
    },
    {
      "index": 2,
      "id": "msg_t006r0101_youngf_01_01",
      "hash": "0ee506a6250d159c",
      "flags": 0,
      "text": "¡Me encanta mi Seel! Cuando lo abrazo, emite\\nun sonido de lo más mono."
    },
    {
      "index": 3,
      "id": "msg_t006r0101_youngf_01_02",
      "hash": "0ee509a6250d1ab5",
      "flags": 0,
      "text": "¿Sabes qué te digo? Mi Seel es más potito.\\nPero mucho más, ¡dónde va a parar!"
    },
    {
      "index": 4,
      "id": "msg_t006r0101_poke_01",
      "hash": "92f57942219c9e77",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Pikachu:[VAR COLOR(0000)] ¡Pikachu!"
    },
    {
      "index": 5,
      "id": "msg_t006r0101_poke_02",
      "hash": "92f57a42219ca02a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Seel:[VAR COLOR(0000)] ¡Eeel!"
    },
    {
      "index": 6,
      "id": "msg_t006r0101_stafff_01",
      "hash": "eeb3cbaafce30758",
      "flags": 0,
      "text": "Nuestro presidente se enrolla cual persiana en\\ncuanto empieza a hablar sobre Pokémon."
    },
    {
      "index": 7,
      "id": "msg_t006r0101_poster_01",
      "hash": "26d385ca9600a6a3",
      "flags": 0,
      "text": "Sé cortés y presta atención si un Entrenador te\\nhabla de sus adorados Pokémon."
    },
    {
      "index": 8,
      "id": "msg_t006r0101_poster_02",
      "hash": "26d386ca9600a856",
      "flags": 0,
      "text": "Si alguien presume, ¡no te quedes corto y hazlo\\ntú también!"
    },
    {
      "index": 9,
      "id": "msg_t006r0101_poster_03",
      "hash": "26d387ca9600aa09",
      "flags": 0,
      "text": "Mi precioso Rapidash"
    },
    {
      "index": 10,
      "id": "msg_t006r0101_poster_04",
      "hash": "26d388ca9600abbc",
      "flags": 0,
      "text": "Mi adorable Fearow"
    },
    {
      "index": 11,
      "id": "msg_t006r0101_poster_05",
      "hash": "26d389ca9600ad6f",
      "flags": 0,
      "text": "Mis encantadores Pokémon y yo"
    },
    {
      "index": 12,
      "id": "msg_t006r0101_poster_06",
      "hash": "26d38aca9600af22",
      "flags": 0,
      "text": "Diario de una amistad: mis Pokémon y yo"
