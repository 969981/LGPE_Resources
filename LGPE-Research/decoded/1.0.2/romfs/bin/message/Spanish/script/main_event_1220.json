{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main1220_partner_a_01",
      "hash": "4efb61fc06ce0c44",
      "flags": 0,
      "text": "¡Pika, pika!"
    },
    {
      "index": 1,
      "id": "msg_main1220_partner_b_01",
      "hash": "f89599f46b644f3b",
      "flags": 0,
      "text": "¡Viii!"
    },
    {
      "index": 2,
      "id": "msg_main1220_young_f_01",
      "hash": "b718baf58baac5e5",
      "flags": 4,
      "text": "Anda, ¡[VAR POKNAME(0002)]!"
    },
    {
      "index": 3,
      "id": "msg_main1220_young_f_02",
      "hash": "b718b7f58baac0cc",
      "flags": 0,
      "text": "¿Que qué estoy haciendo?"
    },
    {
      "index": 4,
      "id": "msg_main1220_young_f_03",
      "hash": "b718b8f58baac27f",
      "flags": 4,
      "text": "Estoy recogiendo flores para hacer un ramo bien\\nprecioso para una persona muy especial."
    },
    {
      "index": 5,
      "id": "msg_main1220_young_f_04",
      "hash": "b718b5f58baabd66",
      "flags": 0,
      "text": "Pero guárdame el secreto, ¿eh?"
    },
    {
      "index": 6,
      "id": "msg_main1220_young_f_05",
      "hash": "b718b6f58baabf19",
      "flags": 4,
      "text": "Ah, por cierto...\\c\\nEl Líder de Gimnasio de Ciudad Verde ha\\nregresado, según parece.\\c\\n¡Vamos, dirígete a Ciudad Verde! ¡Ve a retarlo!"
    },
    {
      "index": 7,
      "id": "msg_main1220_young_f_06",
      "hash": "b718b3f58baaba00",
      "flags": 0,
      "text": "Por favor, no le digas nada de lo del ramo de\\nflores a [VAR TRNAME(0001)]."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_1220_max",
      "hash": "72cc4a06d164628a"
    }
  ]
}
