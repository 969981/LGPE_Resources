{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub024_researcher_01",
      "hash": "d427d40043ea8c98",
      "flags": 0,
      "text": "¡Hola! Soy un Científico de renombre y estudio\\nsin descanso fósiles de Pokémon.\\c\\n¿Tienes alguno para mí?"
    },
    {
      "index": 1,
      "id": "msg_sub024_select_01",
      "hash": "9c5bbb480ccf64a2",
      "flags": 0,
      "text": "Fósil Hélix"
    },
    {
      "index": 2,
      "id": "msg_sub024_select_02",
      "hash": "9c5bba480ccf62ef",
      "flags": 0,
      "text": "Fósil Domo"
    },
    {
      "index": 3,
      "id": "msg_sub024_select_03",
      "hash": "9c5bb9480ccf613c",
      "flags": 4,
      "text": "Ámbar Viejo"
    },
    {
      "index": 4,
      "id": "msg_sub024_select_04",
      "hash": "9c5bb8480ccf5f89",
      "flags": 0,
      "text": "No"
    },
    {
      "index": 5,
      "id": "msg_sub024_researcher_02",
      "hash": "d427d70043ea91b1",
      "flags": 0,
      "text": "¿No? Vaya, qué pena..."
    },
    {
      "index": 6,
      "id": "msg_sub024_researcher_03",
      "hash": "d427d60043ea8ffe",
      "flags": 0,
      "text": "¡El experimento ha sido todo un éxito!\\c\\nTu fósil ha resultado ser, como yo supuse,\\n¡un [VAR POKNAME(0004)]!"
    },
    {
      "index": 7,
      "id": "msg_sub024_sys_01",
      "hash": "0fa5772ce07503fd",
      "flags": 4,
      "text": "El Científico te ha dado un [VAR POKNAME(0004)]."
    },
    {
      "index": 8,
      "id": "msg_sub024_researcher_04",
      "hash": "d427d90043ea9517",
      "flags": 0,
      "text": "¡Ver para creer! ¡Un [VAR ITEM2(0002)]!\\n¡Se trata ni más ni menos que de un fósil de\\r\\n[VAR POKNAME(0001)]!\\c\\nCon mi máquina recuperadora puedo regenerar\\neste Pokémon extinto. ¿Quieres que proceda?"
    },
    {
      "index": 9,
      "id": "msg_sub024_researcher_05",
      "hash": "d427d80043ea9364",
      "flags": 0,
      "text": "¡Venga, dámelo! No hay tiempo que perder."
    },
    {
      "index": 10,
      "id": "msg_sub024_sys_02",
      "hash": "0fa5742ce074fee4",
      "flags": 0,
      "text": "Le has entregado el [VAR ITEM2(0002)] al\\nCientífico."
    },
    {
      "index": 11,
      "id": "msg_sub024_researcher_06",
      "hash": "d427db0043ea987d",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_sub024_researcher_07",
      "hash": "d427da0043ea96ca",
      "flags": 0,
      "text": "¡Vuelve cuando quieras!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_024_max",
      "hash": "93371b7482b7e5d0"
    }
  ]
}
