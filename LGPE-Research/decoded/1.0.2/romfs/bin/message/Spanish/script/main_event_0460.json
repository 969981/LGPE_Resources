      "flags": 0,
      "text": "¡Hola, [VAR TRNAME(0000)]!"
    },
    {
      "index": 1,
      "id": "msg_main_0460_nresercher_02",
      "hash": "b935a6e59962c484",
      "flags": 0,
      "text": "¿Te acuerdas de mí? Trabajo como ayudante del\\nProfesor Oak."
    },
    {
      "index": 2,
      "id": "msg_main_0460_nresercher_03",
      "hash": "b935a7e59962c637",
      "flags": 0,
      "text": "¡Has venido en el momento justo! Tengo que\\nenseñarte algo muy útil."
    },
    {
      "index": 3,
      "id": "msg_main_0460_nresercher_04",
      "hash": "b935a4e59962c11e",
      "flags": 0,
      "text": "Pero aquí hay demasiada luz."
    },
    {
      "index": 4,
      "id": "msg_main_0460_nresercher_05",
      "hash": "b935a5e59962c2d1",
      "flags": 0,
      "text": "¡Mejor te espero dentro!"
    }
  ],
