{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub043_middle_01",
      "hash": "636a64446d37698e",
      "flags": 0,
      "text": "Vendo Rokikos, tan deliciosos y exclusivos que\\nsolo se puede comprar una bolsa al día.\\c\\nAl fin y al cabo, es el gran reclamo de Ciudad\\nPlateada y se agotan enseguida.\\c\\nEl precio de la bolsa es 500 ₽. ¿Qué dices?"
    },
    {
      "index": 1,
      "id": "msg_sub043_select_01",
      "hash": "c08b22c858810d85",
      "flags": 0,
      "text": "Lo compro"
    },
    {
      "index": 2,
      "id": "msg_sub043_select_02",
      "hash": "c08b1fc85881086c",
      "flags": 0,
      "text": "No me interesa"
    },
    {
      "index": 3,
      "id": "msg_sub043_middle_02",
      "hash": "636a63446d3767db",
      "flags": 0,
      "text": "¡Muchas gracias! Ten cuidado al hincarles el\\ndiente, porque están más duros que una piedra."
    },
    {
      "index": 4,
      "id": "msg_sub043_system_01",
      "hash": "b51a3afa6e71ae92",
      "flags": 0,
      "text": "Has recibido una bolsa de Rokikos."
    },
    {
      "index": 5,
      "id": "msg_sub043_middle_03",
      "hash": "636a62446d376628",
      "flags": 0,
      "text": "Bueno, en otra ocasión será."
    },
    {
      "index": 6,
      "id": "msg_sub043_middle_04",
      "hash": "636a69446d37720d",
      "flags": 0,
      "text": "Pero bueno, ¡si no tienes dinero suficiente!\\nPásate por aquí cuando hayas ahorrado un poco."
    },
    {
      "index": 7,
      "id": "msg_sub043_middle_05",
      "hash": "636a68446d37705a",
      "flags": 0,
      "text": "¡Pero si ya no puedes llevar más contigo!\\n¿Qué pasa? ¿No te los comes?"
    },
    {
      "index": 8,
      "id": "msg_sub043_middle_06",
      "hash": "636a67446d376ea7",
      "flags": 0,
      "text": "Quizá no lo recuerdes, pero el máximo es una\\nbolsa al día. Tendrás que esperar a mañana."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_043_max",
      "hash": "e43f42cffdc6fe6f"
    }
  ]
}
