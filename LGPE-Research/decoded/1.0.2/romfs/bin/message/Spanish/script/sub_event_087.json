{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub087_middle_f_01",
      "hash": "69183b2fbfcbb2c9",
      "flags": 4,
      "text": "Ay, este Slowpoke...\\nMe trae por el caminito de la amargura."
    },
    {
      "index": 1,
      "id": "msg_sub087_middle_f_02",
      "hash": "6918382fbfcbadb0",
      "flags": 0,
      "text": "¡Eh, tú! ¡Chaval[VAR GENDBR(00FF,0302)]ínina!\\n¿Me podrías hacer un favor muy grande?"
    },
    {
      "index": 2,
      "id": "msg_sub087_middle_f_03",
      "hash": "6918392fbfcbaf63",
      "flags": 0,
      "text": "¿No tienes tiempo?\\nPerdona que te haya molestado..."
    },
    {
      "index": 3,
      "id": "msg_sub087_middle_f_04",
      "hash": "69183e2fbfcbb7e2",
      "flags": 0,
      "text": "Quería ir al Museo de la Ciencia, pero mi\\nSlowpoke no se mueve ni a rastras."
    },
    {
      "index": 4,
      "id": "msg_sub087_yadon_01",
      "hash": "f0f118be8033672a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Slowpoke:[VAR COLOR(0000)] ¡Slooow!"
    },
    {
      "index": 5,
      "id": "msg_sub087_middle_f_05",
      "hash": "69183f2fbfcbb995",
      "flags": 0,
      "text": "¿Serías tan amable de cuidármelo un rato?"
    },
    {
      "index": 6,
      "id": "msg_sub087_middle_f_09",
      "hash": "6918432fbfcbc061",
      "flags": 0,
      "text": "¡Tú otra vez! ¿Te importaría volver a cuidar de\\nmi Slowpoke?"
    },
    {
      "index": 7,
      "id": "msg_sub087_select_01",
      "hash": "087a940740025655",
      "flags": 0,
      "text": "Será un placer"
    },
    {
      "index": 8,
      "id": "msg_sub087_select_02",
      "hash": "087a91074002513c",
      "flags": 0,
      "text": "No puedo, lo siento"
    },
    {
      "index": 9,
      "id": "msg_sub087_middle_f_06",
      "hash": "69183c2fbfcbb47c",
      "flags": 0,
      "text": "¡Te lo agradezco mucho! Será solo un ratito.\\n¡Trátamelo bien!"
    },
    {
      "index": 10,
      "id": "msg_sub087_yadon_02",
      "hash": "f0f117be80336577",
      "flags": 0,
      "text": "..."
    },
    {
      "index": 11,
      "id": "msg_sub087_system_01",
      "hash": "a2604769f3459b22",
      "flags": 0,
      "text": "Slowpoke tiene la mirada perdida en el infinito."
    },
    {
      "index": 12,
      "id": "msg_sub087_system_02",
      "hash": "a2604669f345996f",
      "flags": 0,
      "text": "Slowpoke está usando toda su energía para no\\nhacer absolutamente nada."
    },
    {
      "index": 13,
      "id": "msg_sub087_system_03",
      "hash": "a2604569f34597bc",
      "flags": 0,
      "text": "Slowpoke parece cómodamente instalado en su\\nociosidad."
    },
    {
      "index": 14,
      "id": "msg_sub087_system_04",
      "hash": "a2604469f3459609",
      "flags": 0,
      "text": "Slowpoke pone cara de estar pensando algo."
    },
    {
      "index": 15,
      "id": "msg_sub087_system_05",
      "hash": "a2604369f3459456",
      "flags": 0,
      "text": "Parece que Slowpoke no se había dado cuenta\\nde que estabas ahí hasta ahora."
    },
    {
      "index": 16,
      "id": "msg_sub087_system_06",
      "hash": "a2604269f34592a3",
      "flags": 0,
      "text": "Slowpoke te mira de reojo..."
    },
    {
      "index": 17,
      "id": "msg_sub087_system_07",
      "hash": "a2604169f34590f0",
      "flags": 0,
      "text": "Slowpoke empieza a interesarse un poco por ti."
    },
    {
      "index": 18,
      "id": "msg_sub087_system_08",
      "hash": "a2605069f345aa6d",
      "flags": 0,
      "text": "Parece que Slowpoke se ha acostumbrado a ti."
    },
    {
      "index": 19,
      "id": "msg_sub087_system_09",
      "hash": "a2604f69f345a8ba",
      "flags": 0,
      "text": "Slowpoke parece algo contento."
    },
    {
      "index": 20,
      "id": "msg_sub087_system_10",
      "hash": "a25cc269f342834c",
      "flags": 0,
      "text": "¡Slowpoke parece alegrarse un poco de estar\\ncontigo!"
    },
    {
      "index": 21,
      "id": "msg_sub087_system_11",
      "hash": "a25cc369f34284ff",
      "flags": 0,
      "text": "Slowpoke y tú pasáis el rato tranquilamente."
    },
    {
      "index": 22,
      "id": "msg_sub087_middle_f_07",
      "hash": "69183d2fbfcbb62f",
      "flags": 0,
      "text": "Gracias por cuidar a mi Slowpoke.\\n¿Me aceptarías una propinilla?"
    },
    {
      "index": 23,
      "id": "msg_sub087_system_12",
      "hash": "a25cc469f34286b2",
      "flags": 0,
      "text": "La mujer te ha regalado así porque sí [VAR VARESP02(0001)]\\n[VAR ITEM2(0001)]."
    },
    {
      "index": 24,
      "id": "msg_sub087_middle_f_08",
      "hash": "6918422fbfcbbeae",
      "flags": 0,
      "text": "¡Hasta otra! Si te viene bien, claro."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_087_max",
      "hash": "48df59edae2527ff"
    }
  ]
}
