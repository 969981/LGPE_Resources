  "lines": [
    {
      "index": 0,
      "id": "msg_t007r0503_shortpants_01",
      "hash": "74b0ff4fa16bdce3",
      "flags": 0,
      "text": "[~ 0]"
    },
    {
      "index": 1,
      "id": "msg_t007r0503_jevenilem_01",
      "hash": "e4384f0ab442ee86",
      "flags": 0,
      "text": "¡Toma ya!\\c\\n¡Este compi va a cambiarme su Kangaskhan por\\nmi Haunter!"
    },
    {
      "index": 2,
      "id": "msg_t007r0503_jevenilem_02",
      "hash": "e4384e0ab442ecd3",
      "flags": 0,
      "text": "¡Ay, a ver si me llega ya mi Hauntercito!\\c\\n¡Me pirran los Haunter, por si no te has dado\\ncuenta!\\c\\nEh, espera... ¿P-pero qué...?\\c\\n¡Haunter se ha convertido en otro Pokémon!"
    },
    {
      "index": 3,
      "id": "msg_t007r0503_chilef_01",
      "hash": "97b8808b2d55e818",
      "flags": 0,
      "text": "Puedes identificar a los Pokémon que hayas\\nintercambiado por su ID."
    },
    {
      "index": 4,
      "id": "msg_t007r0503_game_01",
      "hash": "92d1753fbd58e1f1",
      "flags": 0,
      "text": "¡Es una Nintendo Switch!"
    },
    {
      "index": 5,
      "id": "msg_t007r0503_game_02",
      "hash": "92d1723fbd58dcd8",
      "flags": 0,
      "text": "¡Un juego de rol! Qué pena no tener tiempo\\npara jugar..."
    },
    {
      "index": 6,
      "id": "msg_t007r0503_game_03",
      "hash": "92d1733fbd58de8b",
      "flags": 0,
      "text": "¡Un juego de deportes! Seguro que a papá le\\ngustaría."
    },
    {
      "index": 7,
      "id": "msg_t007r0503_game_04",
      "hash": "92d1783fbd58e70a",
      "flags": 0,
      "text": "¡Un juego de rompecabezas! Son de esos que\\nuna vez empezados ya no puedes dejarlos hasta\\r\\nque los terminas."
    },
    {
      "index": 8,
      "id": "msg_t007r0503_game_05",
      "hash": "92d1793fbd58e8bd",
      "flags": 0,
      "text": "¡Un juego de lucha! Seguro que no es nada fácil\\ncogerle el tranquillo."
    },
    {
      "index": 9,
      "id": "msg_t007r0503_kanban_01",
      "hash": "fa4116cb02ff9bc2",
      "flags": 0,
      "text": "P2: Videojuegos"
    },
    {
      "index": 10,
      "id": "msg_t007r0503_poster_01",
      "hash": "ae05700f9e7f81a4",
      "flags": 0,
      "text": "Son Eevee y Pikachu, dos de los Pokémon más\\npopulares y queridos por todo el mundo."
    }
  ],
