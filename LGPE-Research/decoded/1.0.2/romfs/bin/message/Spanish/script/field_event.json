      "hash": "c3075734bbf2e150",
      "flags": 0,
      "text": "Parece posible talar este arbusto.\\n¿Quieres usar la TS Tala?"
    },
    {
      "index": 1,
      "id": "msg_fld_hiden_02",
      "hash": "c3075a34bbf2e669",
      "flags": 0,
      "text": "¡[VAR PKNICK(0003)] ha usado Tala!"
    },
    {
      "index": 2,
      "id": "msg_fld_hiden_03",
      "hash": "c3075934bbf2e4b6",
      "flags": 0,
      "text": "Parece posible talar este arbusto."
    },
    {
      "index": 3,
      "id": "msg_fld_hiden_04",
      "hash": "c3075c34bbf2e9cf",
      "flags": 0,
      "text": "No parece que se pueda talar nada por aquí."
    },
    {
      "index": 4,
      "id": "msg_fld_hiden_05",
      "hash": "c3075b34bbf2e81c",
      "flags": 4,
      "text": "Este bloque parece muy pesado.\\n¿Quieres usar la TS Empuje?"
    },
    {
      "index": 5,
      "id": "msg_fld_hiden_06",
      "hash": "c3075e34bbf2ed35",
      "flags": 4,
      "text": "Ahora [VAR PKNICK(0003)] puede usar Empuje para\\ndesplazar bloques."
    },
    {
      "index": 6,
      "id": "msg_fld_hiden_07",
      "hash": "c3075d34bbf2eb82",
      "flags": 4,
      "text": "Este bloque parece muy pesado, pero se podría\\nmover empujándolo con fuerza."
    },
    {
      "index": 7,
      "id": "msg_fld_hiden_08",
      "hash": "c3076034bbf2f09b",
      "flags": 0,
      "text": "Gracias a Empuje se puede apartar el bloque de\\nen medio."
    },
    {
      "index": 8,
      "id": "msg_fld_hiden_19",
      "hash": "c303eb34bbeff3f5",
      "flags": 4,
      "text": "El muro que bloqueaba el camino ha\\ndesaparecido."
    },
    {
      "index": 9,
      "id": "msg_fld_hiden_20",
      "hash": "c3006c34bbece651",
      "flags": 0,
      "text": "¡Clic!"
