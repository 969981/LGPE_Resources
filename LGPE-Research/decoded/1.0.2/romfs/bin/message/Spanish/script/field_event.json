    {
      "index": 10,
      "id": "msg_fld_hiden_09",
      "hash": "c3075f34bbf2eee8",
      "flags": 0,
      "text": "La superficie del agua parece tranquila.\\n¿Quieres usar la TS Surcaaguas?"
    },
    {
      "index": 11,
      "id": "msg_fld_hiden_10",
      "hash": "c303f234bbefffda",
      "flags": 0,
      "text": "¡[VAR PKNICK(0003)] ha usado Surcaaguas!"
    },
    {
