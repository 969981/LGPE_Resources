  "lines": [
    {
      "index": 0,
      "id": "msg_t009r0204_diary_01",
      "hash": "195895652cba1f2a",
      "flags": 0,
      "text": "\"Diario: 1 de septiembre\\nMewtwo es demasiado poderoso.\\c\\nSu fuerza se nos escapa de las manos\"."
    },
    {
      "index": 1,
      "id": "msg_t009r0204_bed_01",
      "hash": "92031dac46130782",
      "flags": 0,
      "text": "Hay una cama...\\nA descansar se ha dicho."
    },
    {
      "index": 2,
      "id": "msg_t009r0204_pod_01",
      "hash": "727f2fb532261b32",
      "flags": 0,
      "text": "Se trata de un gran tanque hecho de cristal\\nblindado.\\c\\nUnas marcas en el interior sugieren que ha sido\\ngolpeado con insistencia."
    },
    {
      "index": 3,
      "id": "msg_t009r0204_pod_02",
      "hash": "727f2eb53226197f",
      "flags": 4,
      "text": "Es un tanque de cristal blindado.\\nEn varios sitios se aprecian marcas de un líquido\\r\\nque se ha secado."
    },
    {
      "index": 4,
      "id": "msg_t009r0204_pod_03",
      "hash": "727f2db5322617cc",
      "flags": 4,
      "text": "Es una máquina con muchos interruptores y\\nmedidores.\\c\\nTiene pinta de no haberse usado en mucho\\ntiempo."
    },
    {
      "index": 5,
      "id": "msg_t009r0204_switch_01",
      "hash": "8000d23baa5c94e9",
      "flags": 0,
      "text": "[~ 5]"
    },
    {
