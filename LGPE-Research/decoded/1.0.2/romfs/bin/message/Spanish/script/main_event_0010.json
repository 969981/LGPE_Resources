{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0010_rival_04",
      "hash": "53625bfae0fb9c85",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]: [VAR COLOR(0000)]¡Holaaa!"
    },
    {
      "index": 1,
      "id": "msg_main0010_rival_05",
      "hash": "53625afae0fb9ad2",
      "flags": 0,
      "text": "¡Voy a subir, [VAR TRNAME(0000)]!\\n¡Espero que no sigas en pijama!"
    },
    {
      "index": 2,
      "id": "msg_main0010_rival_01",
      "hash": "536256fae0fb9406",
      "flags": 0,
      "text": "¡Buenas!"
    },
    {
      "index": 3,
      "id": "msg_main0010_rival_08",
      "hash": "53625ffae0fba351",
      "flags": 0,
      "text": "Vaya cara tienes...\\nTe acabas de levantar, ¿verdad?"
    },
    {
      "index": 4,
      "id": "msg_main0010_rival_02",
      "hash": "536255fae0fb9253",
      "flags": 0,
      "text": "¡Espabila, [VAR GENDBR(00FF,0506)]hombremujer, que ha llegado el gran día!\\c\\n¡Hoy el Profesor Oak nos entregará nuestro\\nprimer Pokémon y, por fin, nos convertiremos\\r\\nen [VAR COLOR(0006)]Entrenadores[VAR COLOR(0000)]! ¡Yo estoy de los nervios!"
    },
    {
      "index": 5,
      "id": "msg_main0010_rival_06",
      "hash": "536259fae0fb991f",
      "flags": 0,
      "text": "Pero, antes de nada..."
    },
    {
      "index": 6,
      "id": "msg_main0010_rival_07",
      "hash": "536258fae0fb976c",
      "flags": 0,
      "text": "Supongo que leíste el correo que te envié ayer,\\n¿no? Si no lo has hecho, échale un ojo."
    },
    {
      "index": 7,
      "id": "msg_main0010_rival_03",
      "hash": "536254fae0fb90a0",
      "flags": 0,
      "text": "Bueno, yo me adelanto. ¡Te espero en el\\nLaboratorio del Profesor Oak!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0010_max",
      "hash": "17402bc9578104da"
    }
  ]
}
