    {
      "index": 0,
      "id": "msg_town002_kanban_01",
      "hash": "7637aec9d1a1b94f",
      "flags": 0,
      "text": "Ciudad Verde\\nEl paraíso del eterno verdor."
    },
    {
      "index": 1,
      "id": "msg_town002_kanban_02",
      "hash": "7637afc9d1a1bb02",
      "flags": 0,
      "text": "Gimnasio Pokémon de Ciudad Verde"
    },
    {
      "index": 2,
      "id": "msg_town002_door_01",
      "hash": "b7246880b3c9c456",
      "flags": 0,
      "text": "Las puertas del gimnasio están cerradas..."
    },
    {
      "index": 3,
      "id": "msg_town002_kanban_03",
      "hash": "7637b0c9d1a1bcb5",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "msg_town002_kanban_04",
      "hash": "7637a9c9d1a1b0d0",
      "flags": 0,
      "text": "¡Pistas para Entrenadores!\\c\\nSi te quedas sin Poké Balls, ve a cualquier\\nTienda Pokémon para reponer tu inventario."
    },
    {
      "index": 5,
      "id": "msg_town002_kanban_05",
      "hash": "7637aac9d1a1b283",
      "flags": 4,
      "text": "Escuela de Entrenadores\\n¡Aprende y crea escuela!"
    },
    {
      "index": 6,
      "id": "msg_town002_childm_01_01",
      "hash": "514de6fb5176410d",
      "flags": 4,
      "text": "Ese que va contigo es tu compañero Pokémon,\\n¿verdad?\\c\\n¡Es genial poder pasear junto a tu Pokémon\\nfavorito!"
    },
    {
      "index": 7,
      "id": "msg_town002_oldm_01_01",
      "hash": "75c5dea9e5248190",
      "flags": 4,
      "text": "Este Gimnasio Pokémon está siempre cerrado.\\nMe pregunto quién será el líder."
    },
    {
      "index": 8,
      "id": "msg_town002_oldm_01_02",
      "hash": "75c5e1a9e52486a9",
      "flags": 0,
      "text": "¡El Líder de Gimnasio de Ciudad Verde ha vuelto!"
    },
    {
      "index": 9,
      "id": "msg_town002_bugcatcher_01_01",
      "hash": "064dd86c3fe6a1d6",
      "flags": 0,
      "text": "¿Quieres saber la diferencia entre los dos\\nPokémon oruga?"
    },
    {
      "index": 10,
      "id": "msg_town002_bugcatcher_01_02",
      "hash": "064dd76c3fe6a023",
      "flags": 0,
      "text": "Vale, pues nada."
    },
    {
      "index": 11,
      "id": "msg_town002_bugcatcher_01_03",
      "hash": "064dd66c3fe69e70",
      "flags": 0,
      "text": "¡Caterpie no es venenoso, pero Weedle sí!\\n¡Procura que no te pique!"
    },
    {
      "index": 12,
      "id": "msg_town002_jevenile_f_01",
      "hash": "52931ec5d1be27bf",
      "flags": 0,
      "text": "[~ 12]"
    },
    {
      "index": 13,
      "id": "msg_town002_poke_01",
      "hash": "1102f61156ce1dad",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Oddish:[VAR COLOR(0000)] ¡Dish!"
    },
    {
      "index": 14,
      "id": "msg_town002_middlem_01",
      "hash": "01f9b8b8687961de",
      "flags": 0,
      "text": "¡Bienvenid[VAR GENDBR(00FF,0101)]oa a nuestra ciudad, paletense!"
    }
  ],
