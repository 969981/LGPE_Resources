      "hash": "ef301e11683d2b10",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] ¡Oye, tú!\\n¡Déjanos pasar!"
    },
    {
      "index": 1,
      "id": "msg_main0890_rocketm_01",
      "hash": "9611c17128a694eb",
      "flags": 0,
      "text": "¡No! Me han dicho que no deje pasar a nadie."
    },
    {
      "index": 2,
      "id": "msg_main0890_kojiro_01",
      "hash": "4e00beb778c8aafe",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] ¡No seas tan cuadriculado, hombre!"
    },
    {
      "index": 3,
      "id": "msg_main0890_musasi_02",
      "hash": "ef302111683d3029",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] ¡Arrg! ¡Es que me saca de quicio!"
    },
    {
      "index": 4,
      "id": "msg_main0890_musasi_03",
      "hash": "ef302011683d2e76",
      "flags": 0,
      "text": "¡A-pár-ta-te!"
    },
    {
      "index": 5,
      "id": "msg_main0890_kojiro_02",
      "hash": "4e00bdb778c8a94b",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] ¡Oye! ¡Jessie, espera!"
    },
    {
      "index": 6,
      "id": "msg_main0890_stop_01",
      "hash": "58540270d3db1c1a",
      "flags": 0,
      "text": "Soy el guarda de seguridad, y aunque seas un[VAR GENDBR(00FF,0100)]a\\nniñ[VAR GENDBR(00FF,0101)]oa no me fío de ti. ¡No puedes pasar!"
    },
    {
      "index": 7,
      "id": "msg_main0890_stop_02",
      "hash": "58540170d3db1a67",
      "flags": 0,
      "text": "Buf..."
    },
    {
      "index": 8,
      "id": "msg_main0890_stop_03",
      "hash": "58540070d3db18b4",
      "flags": 0,
      "text": "Parece que le ha dado un telele..."
