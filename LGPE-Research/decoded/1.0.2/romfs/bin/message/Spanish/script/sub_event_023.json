  "lines": [
    {
      "index": 0,
      "id": "msg_sub023_karate_01_01",
      "hash": "eaf8a55e83471389",
      "flags": 0,
      "text": "¡Kia! ¡Soy el Maestro Karateka!\\n¡Y aquí yo soy el líder!"
    },
    {
      "index": 1,
      "id": "msg_sub023_karate_01_09",
      "hash": "eaf8ad5e83472121",
      "flags": 0,
      "text": "¿Quieres desafiarme?\\n¡No tendré piedad!"
    },
    {
      "index": 2,
      "id": "msg_sub023_karate_01_10",
      "hash": "eafc2a5e834a2b5f",
      "flags": 0,
      "text": "¡Kiaaa!"
    },
    {
      "index": 3,
      "id": "msg_sub023_karate_01_02",
      "hash": "eaf8a25e83470e70",
      "flags": 0,
      "text": "¡Pues sí, he perdido!"
    },
    {
      "index": 4,
      "id": "msg_sub023_karate_01_07",
      "hash": "eaf8a75e834716ef",
      "flags": 0,
      "text": "Pero te suplico que no te lleves nuestro\\nemblema como trofeo."
    },
    {
      "index": 5,
      "id": "msg_sub023_karate_01_08",
      "hash": "eaf8ac5e83471f6e",
      "flags": 4,
      "text": "A cambio te entregaré uno de mis valiosos y\\npoderosos Pokémon de tipo Lucha."
    },
    {
      "index": 6,
      "id": "msg_sub023_karate_01_06",
      "hash": "eaf8a65e8347153c",
      "flags": 4,
      "text": "Elige el que más te guste."
    },
    {
      "index": 7,
      "id": "msg_sub023_karate_01_03",
      "hash": "eaf8a35e83471023",
      "flags": 0,
      "text": "¡Eh! ¡Quédate y practica karate con nosotros!"
    },
    {
      "index": 8,
      "id": "msg_sub023_karate_01_04",
      "hash": "eaf8a85e834718a2",
      "flags": 0,
      "text": "¿Quieres llevarte a Hitmonlee y propinar\\npatadas demoledoras?"
    },
    {
      "index": 9,
      "id": "msg_sub023_sys_01_01",
      "hash": "384f6f255b68c6d4",
      "flags": 4,
      "text": "El Maestro Karateka te ha entregado un\\n[VAR POKNAME(0004)]."
    },
    {
      "index": 10,
      "id": "msg_sub023_karate_01_05",
      "hash": "eaf8a95e83471a55",
      "flags": 0,
      "text": "¿Quieres llevarte a Hitmonchan y asestar\\npuñetazos devastadores?"
    },
    {
      "index": 11,
      "id": "msg_sub023_sys_01_02",
      "hash": "384f72255b68cbed",
      "flags": 0,
      "text": "La avaricia rompe el saco..."
    },
    {
      "index": 12,
      "id": "msg_sub023_poke_01_01",
      "hash": "1c43cc5dba1082f6",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Hitmonlee:[VAR COLOR(0000)] ¡Leee!"
    },
    {
      "index": 13,
      "id": "msg_sub023_poke_02_01",
      "hash": "4b19cc75c761fea9",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Hitmonchan:[VAR COLOR(0000)] ¡Chaaan!"
    }
