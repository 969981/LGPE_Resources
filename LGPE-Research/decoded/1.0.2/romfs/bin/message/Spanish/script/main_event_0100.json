  "lines": [
    {
      "index": 0,
      "id": "msg_main0100_clerkm_01",
      "hash": "cd2960b82837a7d8",
      "flags": 0,
      "text": "¡Oye!\\n¿Vienes de Pueblo Paleta?"
    },
    {
      "index": 1,
      "id": "msg_main0100_clerkm_02",
      "hash": "cd2963b82837acf1",
      "flags": 0,
      "text": "¿Conoces al Profesor Oak?\\c\\nTengo algo para él, pero ahora mismo estoy\\ndemasiado ocupado como para ir hasta allí.\\c\\n¿Se lo podrías llevar tú?"
    },
    {
      "index": 2,
      "id": "msg_main0100_sys_01",
      "hash": "273c0ce0fcfa18e3",
      "flags": 0,
      "text": "¡El empleado de la Tienda Pokémon te ha\\nentregado un [VAR COLOR(0006)]Paquete[VAR COLOR(0000)] para el Profesor Oak!"
    },
    {
      "index": 3,
      "id": "msg_main0100_clerkm_03",
      "hash": "cd2962b82837ab3e",
      "flags": 0,
      "text": "¡Vale, gracias!\\n¡Saluda al Profesor Oak de mi parte!"
    },
    {
      "index": 4,
      "id": "msg_main0100_clerkm_04",
      "hash": "cd2965b82837b057",
      "flags": 0,
      "text": "[~ 4]"
    },
    {
      "index": 5,
      "id": "msg_main0100_sys_02",
      "hash": "273c0de0fcfa1a96",
      "flags": 0,
      "text": "¿Quieres ir directamente al laboratorio?"
    }
  ],
