    {
      "index": 23,
      "id": "msg_sub070_pokemaniac_12",
      "hash": "810ac4d0a1e60065",
      "flags": 0,
      "text": "¡Muchísimas gracias, Campe[VAR GENDBR(00FF,0302)]ónona!\\n¿Necesitas algo más?"
    },
    {
      "index": 24,
      "id": "msg_sub070_pokemaniac_13",
      "hash": "810ac3d0a1e5feb2",
      "flags": 0,
      "text": "Hasta la próxima."
    },
    {
      "index": 25,
      "id": "msg_sub070_pokemaniac_14",
      "hash": "810abed0a1e5f633",
      "flags": 4,
      "text": "Oh, va-vaya... Parece que no tienes suficiente\\ndinero..."
    },
    {
      "index": 26,
      "id": "msg_sub070_pokemaniac_15",
      "hash": "810abdd0a1e5f480",
      "flags": 0,
      "text": "¡N-no puedo creer que me haya quedado sin\\nexistencias!\\c\\nEstoy s-seguro de que aprovecharás a tope el\\np-potencial de las Megapiedras, Campe[VAR GENDBR(00FF,0302)]ónona."
    },
    {
      "index": 27,
      "id": "msg_sub070_pokemaniac_16",
      "hash": "810ac0d0a1e5f999",
      "flags": 0,
      "text": "¡Campe[VAR GENDBR(00FF,0302)]ónona! Espero que te estén resultando\\nútiles las Megapiedras."
    },
