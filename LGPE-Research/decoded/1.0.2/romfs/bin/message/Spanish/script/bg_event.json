{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "fe_amai_msg00",
      "hash": "7a6591e7fa5270a7",
      "flags": 0,
      "text": "Parece que aquí no hay nada..."
    },
    {
      "index": 1,
      "id": "msg_kagu1_bg",
      "hash": "cdf3b18078b3f908",
      "flags": 0,
      "text": "¡Qué bien colocadita está la vajilla!"
    },
    {
      "index": 2,
      "id": "msg_kagu2_bg",
      "hash": "a0b3a17a163fa0e3",
      "flags": 0,
      "text": "¡Mmm, huele que alimenta! Aquí han debido de\\ncocinar algo..."
    },
    {
      "index": 3,
      "id": "msg_kagu3_bg",
      "hash": "c9eb816ecbc1f832",
      "flags": 0,
      "text": "Qué mueble más estupendo... Aquí caben un\\nmontón de cosas."
    },
    {
      "index": 4,
      "id": "msg_kagu4_bg",
      "hash": "730c41672ff1c605",
      "flags": 0,
      "text": "Mmm, cuántas cosas ricas..."
    },
    {
      "index": 5,
      "id": "msg_kagu5_bg",
      "hash": "49245160d0548fe4",
      "flags": 0,
      "text": "Qué foto más bonita. El Pokémon parece estar\\nencantado."
    },
    {
      "index": 6,
      "id": "msg_kagu6_bg",
      "hash": "9b158156be707c7f",
      "flags": 0,
      "text": "¿Para qué servirá? Mejor no tocar, por si acaso..."
    },
    {
      "index": 7,
      "id": "msg_kagu7_bg",
      "hash": "712e91505ed4f95e",
      "flags": 0,
      "text": "Hay un teléfono. Mejor no usarlo."
    },
    {
      "index": 8,
      "id": "msg_kagu8_bg",
      "hash": "03f0b1cd88a71721",
      "flags": 4,
      "text": "Es un póster promocional con todo tipo de\\nproductos."
    },
    {
      "index": 9,
      "id": "msg_kagu9_bg",
      "hash": "2d2881c23e295340",
      "flags": 0,
      "text": "Mmm, ¡qué bien huele! ¡Se hace la boca agua!"
    },
    {
      "index": 10,
      "id": "msg_kagu10_bg",
      "hash": "2900f7fa1e970ca4",
      "flags": 4,
      "text": "A ver...\\n¡No hay nada dentro!"
    },
    {
      "index": 11,
      "id": "msg_kagu11_bg",
      "hash": "ffc8e805691463c5",
      "flags": 0,
      "text": "¡Qué taza más guay! ¡Tiene la huella de un\\nPokémon!"
    },
    {
      "index": 12,
      "id": "msg_kagu12_bg",
      "hash": "510b37e9ad17761e",
      "flags": 0,
      "text": "La ventana está requetelimpia."
    },
    {
      "index": 13,
      "id": "msg_kagu13_bg",
      "hash": "27d327f4f794cd3f",
      "flags": 0,
      "text": "Da gusto mirar por la ventana... El cielo está\\nimpresionante."
    },
    {
      "index": 14,
      "id": "msg_kagu14_bg",
      "hash": "574a581eaef36dc8",
      "flags": 0,
      "text": "Cuántas lucecitas de colores que se encienden y\\nse apagan..."
    },
    {
      "index": 15,
      "id": "msg_kagu15_bg",
      "hash": "59600823d6bb57e9",
      "flags": 0,
      "text": "Hay un montón de herramientas relucientes muy\\nbien ordenadas."
    },
    {
      "index": 16,
      "id": "msg_bouenkyou_01_p01_r011_r0102",
      "hash": "11249d7b557c7c93",
      "flags": 0,
      "text": "Has usado los prismáticos...\\c\\n¡Hay un Pokémon enorme durmiendo en medio\\ndel camino!"
    },
    {
      "index": 17,
      "id": "msg_bouenkyou_01_p02_r011_r0102",
      "hash": "d0e85fd19bb0169c",
      "flags": 0,
      "text": "Has usado los prismáticos...\\c\\n¡Qué vista tan bonita!"
    },
    {
      "index": 18,
      "id": "msg_bouenkyou_02_p01_r011_r0102",
      "hash": "33193af75a560fb0",
      "flags": 0,
      "text": "Has usado los prismáticos...\\c\\n¡Puedes ir de Ciudad Celeste a Pueblo Lavanda\\npor el Túnel Roca!"
    },
    {
      "index": 19,
      "id": "msg_bouenkyou_01_p01_r012_r0102",
      "hash": "2a2fd25bba926a22",
      "flags": 0,
      "text": "Has usado los prismáticos...\\c\\n¡Un hombre está pescando!"
    },
    {
      "index": 20,
      "id": "msg_bouenkyou_02_p01_r012_r0102",
      "hash": "1447c575cf496bf5",
      "flags": 0,
      "text": "Has usado los prismáticos...\\c\\n¡Es la Torre Pokémon!"
    },
    {
      "index": 21,
      "id": "msg_bouenkyou_01_p01_r015_r0102",
      "hash": "d7f7e45d55f7429f",
      "flags": 0,
      "text": "Has usado los prismáticos...\\c\\nUn pájaro grande y brillante vuela hacia el mar."
    },
    {
      "index": 22,
      "id": "msg_bouenkyou_02_p01_r015_r0102",
      "hash": "98836cfee336ff7c",
      "flags": 0,
      "text": "Has usado los prismáticos...\\c\\n¡Parece que hay una pequeña isla!"
    },
    {
      "index": 23,
      "id": "msg_bouenkyou_01_p01_r016_r0202",
      "hash": "cea1afb32e7dc323",
      "flags": 0,
      "text": "Has usado los prismáticos...\\c\\n¡Es el Centro Comercial de Ciudad Azulona!"
    },
    {
      "index": 24,
      "id": "msg_bouenkyou_02_p01_r016_r0202",
      "hash": "e85828a3f4702cc0",
      "flags": 0,
      "text": "Has usado los prismáticos...\\c\\n¡Hay un largo camino sobre el agua!"
    },
    {
      "index": 25,
      "id": "msg_bouenkyou_01_p01_r018_r0102",
      "hash": "f4dd8c32d544ae70",
      "flags": 0,
      "text": "Has usado los prismáticos...\\c\\n¡Pueblo Paleta está al oeste!"
    },
    {
      "index": 26,
      "id": "msg_bouenkyou_02_p01_r018_r0102",
      "hash": "4f604c3fda8dddd3",
      "flags": 0,
      "text": "Has usado los prismáticos...\\c\\n¡Hay gente nadando!"
    },
    {
      "index": 27,
      "id": "msg_sylph_door_01",
      "hash": "c36b343ea1a7c0f8",
      "flags": 0,
      "text": "¡Bingo! ¡La Llave Magnética ha abierto la puerta!"
    },
    {
      "index": 28,
      "id": "msg_sylph_door_02",
      "hash": "c36b373ea1a7c611",
      "flags": 0,
      "text": "¡Nada! ¡Hace falta una Llave Magnética!"
    },
    {
      "index": 29,
      "id": "msg_book_01_bg",
      "hash": "7bb6486bae7c5172",
      "flags": 0,
      "text": "¡Hay un montón de libros sobre los Pokémon!"
    },
    {
      "index": 30,
      "id": "msg_townmap_01_bg",
      "hash": "0de10cb9a0a3d80b",
      "flags": 4,
      "text": "Es un Mapa."
    },
    {
      "index": 31,
      "id": "msg_fsrack_01_bg",
      "hash": "6c92a1bfb5eb3e83",
      "flags": 0,
      "text": "¡Hala! ¡Hay un montón de artículos de Pokémon!"
    },
    {
      "index": 32,
      "id": "msg_fs_01_bg",
      "hash": "1df07aa8257f8e68",
      "flags": 0,
      "text": "Tienda Pokémon\\n¡Compra aquí todos tus objetos!"
    },
    {
      "index": 33,
      "id": "msg_pc_01_bg",
      "hash": "dfee76fbce4be542",
      "flags": 0,
      "text": "Centro Pokémon\\n¡Cura a tus Pokémon!"
    },
    {
      "index": 34,
      "id": "msg_freeze_01_bg",
      "hash": "8e164c7fbea26a00",
      "flags": 0,
      "text": "Seguramente está lleno de cosas de lo más\\napetecibles."
    },
    {
      "index": 35,
      "id": "msg_sekkeizu_01_bg",
      "hash": "fa393e9b9200f706",
      "flags": 0,
      "text": "Y este esquema... ¿de dónde será? Tiene gráficos y\\nanotaciones rarísimas."
    },
    {
      "index": 36,
      "id": "msg_pc_02_bg",
      "hash": "37629715141fdcf9",
      "flags": 0,
      "text": "Qué combinación de números y letras más\\ncomplicada..."
    },
    {
      "index": 37,
      "id": "msg_masaki_01_bg",
      "hash": "93d2d7a15f3e81dd",
      "flags": 4,
      "text": "Esta máquina parece realmente impresionante."
    },
    {
      "index": 38,
      "id": "msg_game_01_bg",
      "hash": "5cb767c46e41f135",
      "flags": 0,
      "text": "¡Lo último en videojuegos! ¡Qué guay!"
    },
    {
      "index": 39,
      "id": "msg_dorobou_01_bg",
      "hash": "a07f7a27a1a4b8e9",
      "flags": 0,
      "text": "Salta a la vista que han entrado a robar..."
    },
    {
      "index": 40,
      "id": "msg_tv_01_bg",
      "hash": "bb6a7c7d0b1fc1b5",
      "flags": 0,
      "text": "¡Está saliendo un Pokémon por la tele!\\nSe le ve encantado..."
    },
    {
      "index": 41,
      "id": "msg_tv_02_bg",
      "hash": "8ca18c64fdd8eb8e",
      "flags": 0,
      "text": "¡Estás saliendo por la tele!\\c\\nAh, no, solo es tu reflejo."
    },
    {
      "index": 42,
      "id": "msg_t007r0805_elevator_01",
      "hash": "6b7cd65aaddff314",
      "flags": 0,
      "text": "Parece que hace falta una llave."
    },
    {
      "index": 43,
      "id": "msg_main_event_1100_switch_01",
      "hash": "ccd6e3039bca99fd",
      "flags": 0,
      "text": "¡Clic!\\nHas pulsado un botón secreto."
    },
    {
      "index": 44,
      "id": "msg_main_event_1100_switch_04",
      "hash": "ccd6de039bca917e",
      "flags": 0,
      "text": "¡Algo se ha movido!"
    },
    {
      "index": 45,
      "id": "msg_main_event_1100_switch_02",
      "hash": "ccd6e0039bca94e4",
      "flags": 0,
      "text": "[~ 45]"
    },
    {
      "index": 46,
      "id": "msg_main_event_1100_switch_03",
      "hash": "ccd6e1039bca9697",
      "flags": 0,
      "text": "[~ 46]"
    },
    {
      "index": 47,
      "id": "msg_shop_bg_01",
      "hash": "3682ef731ccc848b",
      "flags": 0,
      "text": "Hay pociones, repelentes y artículos por el\\nestilo."
    },
    {
      "index": 48,
      "id": "msg_shop_bg_02",
      "hash": "3682f0731ccc863e",
      "flags": 0,
      "text": "¡Hay artículos para dar y tomar! Si quieres\\ncomprar algo, habla con el dependiente."
    },
    {
      "index": 49,
      "id": "msg_kanban_bg_01",
      "hash": "ff617b40a90b04f0",
      "flags": 0,
      "text": "Desde este lado no puedes leer lo que pone."
    }
  ],
