    {
      "index": 7,
      "id": "msg_main0030_new_doctor_01",
      "hash": "e79395d568abbc54",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Oak:[VAR COLOR(0000)] ¡Muchas gracias, pequeños Pidgey!"
    },
    {
      "index": 8,
      "id": "msg_main0030_new_doctor_09",
      "hash": "e7938dd568abaebc",
      "flags": 0,
      "text": "Ha sido una incursión muy productiva.\\nHe aprendido mucho sobre vosotros."
    },
    {
      "index": 9,
      "id": "msg_main0030_new_doctor_02",
      "hash": "e79398d568abc16d",
      "flags": 0,
      "text": "¡Anda, hola, [VAR TRNAME(0000)]!"
    },
    {
      "index": 10,
      "id": "msg_main0030_new_doctor_10",
      "hash": "e79010d568a8a47e",
      "flags": 0,
      "text": "¡Casi se me olvida! Hoy tenía que daros vuestros\\nPokémon a ti y a [VAR TRNAME(0001)], ¿no?\\c\\nPues nada, dirijámonos al laboratorio."
    },
    {
      "index": 11,
      "id": "msg_main0030_new_doctor_03",
      "hash": "e79397d568abbfba",
      "flags": 0,
      "text": "¿Eh?"
    },
    {
      "index": 12,
      "id": "msg_main0030_new_doctor_04",
      "hash": "e79392d568abb73b",
      "flags": 0,
      "text": "¡Ahí va!"
    },
    {
      "index": 13,
      "id": "msg_main0030_new_doctor_05",
      "hash": "e79391d568abb588",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Oak:[VAR COLOR(0000)] ¡No está nada mal para ser tu primera vez!"
    },
    {
      "index": 14,
      "id": "msg_main0030_new_doctor_11",
      "hash": "e79011d568a8a631",
      "flags": 0,
      "text": "¡Anda, recoge la Poké Ball y ponle un mote al\\n[VAR POKNAME(0002)] que has capturado!"
    },
    {
      "index": 15,
      "id": "msg_main0030_new_doctor_06",
      "hash": "e79394d568abbaa1",
      "flags": 0,
      "text": "¿Eh?"
    },
    {
      "index": 16,
      "id": "msg_main0030_new_doctor_07",
      "hash": "e79393d568abb8ee",
      "flags": 0,
      "text": "¡Si es que este Pokémon es puro nervio!"
    },
    {
      "index": 17,
      "id": "msg_main0030_new_doctor_08",
      "hash": "e7938ed568abb06f",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Oak:[VAR COLOR(0000)] ¡Eh, espera! ¡No te vayas!"
    }
  ],
