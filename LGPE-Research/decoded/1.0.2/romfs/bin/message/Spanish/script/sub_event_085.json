  "lines": [
    {
      "index": 0,
      "id": "msg_sub085_musasi_01",
      "hash": "5ea012df50658f55",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] ¡Oye, tú!\\n¡Déjanos pasar!"
    },
    {
      "index": 1,
      "id": "msg_sub085_rocketm_01",
      "hash": "776568bd7cee60a0",
      "flags": 0,
      "text": "¡No! Me han dicho que no deje pasar a nadie."
    },
    {
      "index": 2,
      "id": "msg_sub085_kojiro_01",
      "hash": "26e795e55c88e1ff",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] ¡No seas tan cuadriculado, hombre!"
    },
    {
      "index": 3,
      "id": "msg_sub085_musasi_02",
      "hash": "5ea00fdf50658a3c",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] ¡Arrg! ¡Es que me saca de quicio!"
    },
    {
      "index": 4,
      "id": "msg_sub085_musasi_03",
      "hash": "5ea010df50658bef",
      "flags": 0,
      "text": "¡A-pár-ta-te!"
    },
    {
      "index": 5,
      "id": "msg_sub085_kojiro_02",
      "hash": "26e796e55c88e3b2",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] ¡Oye! ¡Jessie, espera!"
    },
    {
      "index": 6,
      "id": "msg_sub085_stop_01",
      "hash": "7a5645749be1654b",
      "flags": 0,
      "text": "Soy el guarda de seguridad, y aunque seas un[VAR GENDBR(00FF,0100)]a\\nniñ[VAR GENDBR(00FF,0101)]oa no me fío de ti. ¡No puedes pasar!"
    },
    {
      "index": 7,
      "id": "msg_sub085_stop_02",
      "hash": "7a5646749be166fe",
      "flags": 0,
      "text": "Buf..."
    },
    {
      "index": 8,
      "id": "msg_sub085_stop_03",
      "hash": "7a5647749be168b1",
      "flags": 0,
      "text": "Parece que está aturdido..."
    }
  ],
