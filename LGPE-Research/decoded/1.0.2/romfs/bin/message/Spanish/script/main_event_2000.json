{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main2000_rival_01",
      "hash": "4568f4f74cfce003",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] ¡Holaaa!"
    },
    {
      "index": 1,
      "id": "msg_main2000_rival_02",
      "hash": "4568f5f74cfce1b6",
      "flags": 0,
      "text": "¡Oye, [VAR TRNAME(0000)]! ¡Voy a subir!"
    },
    {
      "index": 2,
      "id": "msg_main2000_rival_03",
      "hash": "4568f6f74cfce369",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] ¡Buenos días, Campe[VAR GENDBR(00FF,0302)]ónona de\\nKanto!"
    },
    {
      "index": 3,
      "id": "msg_main2000_rival_09",
      "hash": "4568fcf74cfced9b",
      "flags": 0,
      "text": "No te acostumbres a que te llame así, porque\\npienso arrebatarte el título en cuanto pueda."
    },
    {
      "index": 4,
      "id": "msg_main2000_rival_04",
      "hash": "4568f7f74cfce51c",
      "flags": 0,
      "text": "Pero bueno, cambiemos de tema.\\c\\n¿Te has enterado de que se ha avistado un\\nPokémon que parece la mar de fuerte?"
    },
    {
      "index": 5,
      "id": "msg_main2000_sel_01",
      "hash": "8b65dee0045ddfb3",
      "flags": 0,
      "text": "¿Qué clase de Pokémon?"
    },
    {
      "index": 6,
      "id": "msg_main2000_sel_02",
      "hash": "8b65dfe0045de166",
      "flags": 0,
      "text": "¡Quiero atraparlo!"
    },
    {
      "index": 7,
      "id": "msg_main2000_rival_05",
      "hash": "4568f8f74cfce6cf",
      "flags": 0,
      "text": "Por lo visto, mola un montón. ¡Y encima es más\\nfuerte que yo que sé!"
    },
    {
      "index": 8,
      "id": "msg_main2000_rival_06",
      "hash": "4568f9f74cfce882",
      "flags": 0,
      "text": "Ja, ja. Ya sabía yo que te pirrarías por él en\\ncuanto te lo contase."
    },
    {
      "index": 9,
      "id": "msg_main2000_rival_07",
      "hash": "4568faf74cfcea35",
      "flags": 0,
      "text": "Lo avistaron cerca de [VAR COLOR(0006)]Ciudad Celeste[VAR COLOR(0000)]."
    },
    {
      "index": 10,
      "id": "msg_main2000_rival_10",
      "hash": "456bf9f74cff1e59",
      "flags": 0,
      "text": "Y, según dicen, se refugió en una cueva."
    },
    {
      "index": 11,
      "id": "msg_main2000_rival_08",
      "hash": "4568fbf74cfcebe8",
      "flags": 4,
      "text": "A mí también me pica la curiosidad por saber\\nqué clase de Pokémon es. ¡Vamos a buscarlo!"
    },
    {
      "index": 12,
      "id": "msg_main2000_rival_11",
      "hash": "456bf8f74cff1ca6",
      "flags": 0,
      "text": "¡Venga, vamos a ver quién lo encuentra primero!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_2000_max",
      "hash": "9104968fcbd7dad1"
    }
  ]
}
