    {
      "index": 6,
      "id": "msg_book_01_p01_t005_r0101",
      "hash": "687235c0f3f98ae7",
      "flags": 0,
      "text": "\"¡Gran concurso mensual de dibujo de la revista\\n'Nuestros amigos Pokémon'!\\c\\nPuedes encontrar el formulario en...\"\\c\\n¡Anda, se lo han llevado!"
