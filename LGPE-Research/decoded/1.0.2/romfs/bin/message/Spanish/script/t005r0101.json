    {
      "index": 0,
      "id": "msg_t005r0101_youngm_01",
      "hash": "5a81f7f43e3646ca",
      "flags": 0,
      "text": "¡Qué raro! El Sr. Fuji no está aquí.\\n¿Adónde habrá ido?"
    },
    {
      "index": 1,
      "id": "msg_t005r0101_youngm_02",
      "hash": "5a81f6f43e364517",
      "flags": 4,
      "text": "El Sr. Fuji estaba rindiendo homenaje a la madre\\ndel Cubone."
    },
    {
      "index": 2,
      "id": "msg_t005r0101_juveniles_01",
      "hash": "b3092b7e97f4b1c8",
      "flags": 4,
      "text": "Esta es la casa del Sr. Fuji.\\nEs un hombre muy amable que cuida de los\\r\\nPokémon huérfanos y abandonados."
    },
    {
      "index": 3,
      "id": "msg_t005r0101_juveniles_02",
      "hash": "b3092e7e97f4b6e1",
      "flags": 0,
      "text": "¡Es tan bonito abrazar a los Pokémon!"
    },
    {
      "index": 4,
      "id": "msg_t005r0101_poke_01",
      "hash": "0385607c405e4cb8",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Nidorino:[VAR COLOR(0000)] ¡Nidor!"
