{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0310_rocketm_01",
      "hash": "d0bf455f5b512f68",
      "flags": 0,
      "text": "¡Enhorabuena! ¡Has vencido a nuestros cinco\\nEntrenadores!\\c\\n¡Te has ganado un premio fabuloso!"
    },
    {
      "index": 1,
      "id": "msg_main0310_sys_01",
      "hash": "fda0b6542407ea06",
      "flags": 4,
      "text": "El Entrenador misterioso te ha entregado una\\nPepita."
    },
    {
      "index": 2,
      "id": "msg_main0310_rocketm_02",
      "hash": "d0bf485f5b513481",
      "flags": 4,
      "text": "A todo esto, y que quede entre nosotros...\\n¿No te interesaría incorporarte al Team Rocket?"
    },
    {
      "index": 3,
      "id": "msg_main0310_rocketm_04",
      "hash": "d0bf4a5f5b5137e7",
      "flags": 0,
      "text": "¡Tacháaan!"
    },
    {
      "index": 4,
      "id": "msg_main0310_rocketm_05",
      "hash": "d0bf495f5b513634",
      "flags": 0,
      "text": "Somos una organización que se dedica a utilizar\\nlos Pokémon como meros instrumentos para\\r\\nnuestros maquiavélicos planes."
    },
    {
      "index": 5,
      "id": "msg_main0310_rocketm_06",
      "hash": "d0bf4c5f5b513b4d",
      "flags": 0,
      "text": "¡Venga, únete a nosotros!"
    },
    {
      "index": 6,
      "id": "msg_main0310_rocketm_07",
      "hash": "d0bf4b5f5b51399a",
      "flags": 0,
      "text": "¿Vas a rechazar nuestra generosa oferta?"
    },
    {
      "index": 7,
      "id": "msg_main0310_rocketm_08",
      "hash": "d0bf3e5f5b512383",
      "flags": 0,
      "text": "¡No aceptaré un no por respuesta!"
    },
    {
      "index": 8,
      "id": "msg_main0310_rocketm_09",
      "hash": "d0bf3d5f5b5121d0",
      "flags": 0,
      "text": "¡Únete! ¡Es una orden!"
    },
    {
      "index": 9,
      "id": "msg_main0310_rocketm_10",
      "hash": "d0bbc05f5b4e1792",
      "flags": 0,
      "text": "Tu cara me dice que no estás por la labor...\\c\\n¡En ese caso te vas a unir por narices!\\n¡Pues menudo soy yo!"
    },
    {
      "index": 10,
      "id": "msg_main0310_rocketm_11",
      "hash": "d0bbc15f5b4e1945",
      "flags": 0,
      "text": "¡En guardia!"
    },
    {
      "index": 11,
      "id": "msg_main0150_dummy_01",
      "hash": "ff67b6d57bb9318b",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_main0310_rocketm_03",
      "hash": "d0bf475f5b5132ce",
      "flags": 0,
      "text": "Con esa fuerza que tienes te auguraba un futuro\\nmuy prometedor en el mismísimo Team Rocket...\\c\\n¡Qué pena desperdiciar ese talento!"
    },
    {
      "index": 13,
      "id": "msg_main0310_rocketm_12",
      "hash": "d0bbbe5f5b4e142c",
      "flags": 0,
      "text": "¡Impresionante! ¡Has logrado vencer a los cinco!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0310_max",
      "hash": "02f642f6006b27eb"
    }
  ]
}
