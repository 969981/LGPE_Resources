    {
      "index": 7,
      "id": "msg_main0040_new_rival_01",
      "hash": "300dda520826e5ae",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] ¡Oiga, profesor!\\c\\n¿No había dos Poké Balls antes? ¿Por qué ahora\\nhay tres?"
    },
    {
      "index": 8,
      "id": "msg_main0040_new_doctor_01",
      "hash": "4e6eefdd0a5feaff",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Oak:[VAR COLOR(0000)] ¡Vaya, qué observador! Pues la tercera es\\ndel [VAR POKNAME(0002)] que ha capturado hace nada\\r\\n[VAR TRNAME(0000)]."
    },
    {
      "index": 9,
      "id": "msg_main0040_new_rival_02",
      "hash": "300dd9520826e3fb",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] ¿Lo has capturado tú solit[VAR GENDBR(00FF,0101)]oa,\\n[VAR TRNAME(0000)]?"
    },
    {
      "index": 10,
      "id": "msg_main0040_new_rival_03",
      "hash": "300dd8520826e248",
      "flags": 0,
      "text": "¡Guau, qué pasada!"
    },
    {
      "index": 11,
      "id": "msg_main0040_new_doctor_02",
      "hash": "4e6ef0dd0a5fecb2",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Oak:[VAR COLOR(0000)] ¡Ja, ja, ja! ¡Se ve que rebosa energía!"
    },
    {
      "index": 12,
      "id": "msg_main0040_new_doctor_04",
      "hash": "4e6eeadd0a5fe280",
      "flags": 0,
      "text": "[VAR TRNAME(0000)], coge la Poké Ball, que no\\nmuerde. Vamos, con decisión."
    },
    {
      "index": 13,
      "id": "msg_main0040_new_doctor_03",
      "hash": "4e6ef1dd0a5fee65",
      "flags": 0,
      "text": "Venga, ¡llévate a [VAR POKNAME(0002)] de aventuras!"
    },
    {
      "index": 14,
      "id": "msg_main0040_new_rival_04",
      "hash": "300ddf520826ee2d",
      "flags": 4,
      "text": "El Pokémon que capturaste debe de estar en la\\nPoké Ball del medio."
    },
    {
      "index": 15,
      "id": "msg_main0040_new_rival_05",
      "hash": "300dde520826ec7a",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] ¡Creo que alguien no está de\\nacuerdo con tu elección, ja!"
    }
