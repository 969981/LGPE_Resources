  "lines": [
    {
      "index": 0,
      "id": "msg_main0200_scientist_01",
      "hash": "1997f465dac34205",
      "flags": 4,
      "text": "Eh, ¡las manos quietecitas!"
    },
    {
      "index": 1,
      "id": "msg_main0200_scientist_05",
      "hash": "1997f065dac33b39",
      "flags": 0,
      "text": "Los fósiles los he encontrado yo."
    },
    {
      "index": 2,
      "id": "msg_main0200_scientist_06",
      "hash": "1997ed65dac33620",
      "flags": 0,
      "text": "¡Así que me pertenecen!"
    },
    {
      "index": 3,
      "id": "msg_science_02_02",
      "hash": "3f4233734bcf5c9d",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "msg_main0200_scientist_02",
      "hash": "1997f165dac33cec",
      "flags": 0,
      "text": "Bueno, bueno, ¡uno para cada uno!\\nTampoco hay que ser avaricioso."
    },
    {
      "index": 5,
      "id": "msg_main0200_sys_01",
      "hash": "4a818fc482d38e68",
      "flags": 0,
      "text": "¿Quieres el Fósil Domo?"
    },
    {
      "index": 6,
      "id": "msg_main0200_sys_02",
      "hash": "4a8192c482d39381",
      "flags": 0,
      "text": "¿Quieres el Fósil Hélix?"
    },
    {
      "index": 7,
      "id": "msg_main0200_sys_03",
      "hash": "4a8191c482d391ce",
      "flags": 0,
      "text": "Has conseguido el Fósil Hélix."
    },
    {
      "index": 8,
      "id": "msg_main0200_sys_04",
      "hash": "4a8194c482d396e7",
      "flags": 0,
      "text": "Has conseguido el Fósil Domo."
    },
    {
      "index": 9,
      "id": "msg_main0200_scientist_03",
      "hash": "1997f265dac33e9f",
      "flags": 0,
      "text": "Muy bien. ¡Pues este para mí!"
    },
    {
      "index": 10,
      "id": "msg_main0200_scientist_04",
      "hash": "1997ef65dac33986",
      "flags": 0,
      "text": "Muy lejos, en Isla Canela, hay un laboratorio\\nen el que estudian cómo regenerar los fósiles\\r\\nde Pokémon."
    }
  ],
