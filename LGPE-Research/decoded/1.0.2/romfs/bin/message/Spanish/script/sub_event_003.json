    {
      "index": 10,
      "id": "msg_sub003_childf_04",
      "hash": "c1626954b51baca6",
      "flags": 0,
      "text": "La MT06 te permite enseñar a un Pokémon el\\nmovimiento Pantalla de Luz, que reduce el daño\\r\\nde los ataques especiales del rival."
    },
    {
      "index": 11,
      "id": "msg_present_01_p05_t007_fs07",
