    {
      "index": 8,
      "id": "msg_sub003_childf_03",
      "hash": "c1626c54b51bb1bf",
      "flags": 0,
      "text": "¡Yupiii! ¡Agua Fresca! ¿De verdad me la das?\\c\\n¡Gracias! Toma, a cambio te vas a llevar algo\\nchachi piruli."
    },
    {
      "index": 9,
