    {
      "index": 13,
      "id": "msg_main0050_new_sys_01",
      "hash": "9776b8c56518fb6e",
      "flags": 0,
      "text": "¡[VAR POKNAME(0002)] es ahora tu compañero Pokémon!"
    },
    {
      "index": 14,
      "id": "msg_main0050_new_doctor_01",
      "hash": "7071372226a8744e",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Oak:[VAR COLOR(0000)] ¡Este ejemplar es bien curioso! Sale de su\\nPoké Ball y entra en ella según se le antoja.\\c\\n¡Pero por muy rebelde que sea, yo diría que le\\ngustas!\\c\\n¿Y si le pones un mote, [VAR TRNAME(0000)]?"
    },
    {
      "index": 15,
      "id": "msg_main0050_rival_02",
      "hash": "b021c45d8a7475f7",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] ¡Pues este para mí, profesor!"
    },
    {
      "index": 16,
      "id": "msg_main0050_sys_03",
      "hash": "5ad65770906b6c33",
      "flags": 0,
      "text": "[VAR TRNAME(0001)] ha obtenido a [VAR POKNAME(0004)]."
    },
    {
      "index": 17,
      "id": "msg_main0050_rival_03",
      "hash": "b021c35d8a747444",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] ¡Qué monada!\\nEste [VAR POKNAME(0004)] es muy gracioso."
    },
    {
      "index": 18,
      "id": "msg_main0050_poke_01",
