    {
      "index": 8,
      "id": "msg_main0910_rocketchief_03",
      "hash": "15b80571e05ca54a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Atlas:[VAR COLOR(0000)] Cálmate.\\c\\nBasta con darles una buena lección a estos\\njovenzuelos impertinentes."
