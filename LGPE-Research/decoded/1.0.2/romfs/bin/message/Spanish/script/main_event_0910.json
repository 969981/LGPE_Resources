    {
      "index": 7,
      "id": "msg_main0910_rocketf_03",
      "hash": "21881c7a92c58697",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Recluta:[VAR COLOR(0000)] ¡Eh, mocoso! ¡No te hagas el listillo con\\nmi jefe o lo lamentarás!"
