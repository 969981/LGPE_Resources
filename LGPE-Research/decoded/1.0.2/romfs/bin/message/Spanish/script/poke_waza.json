{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "poke_waza_01_01",
      "hash": "29fdd1ac6c57525c",
      "flags": 0,
      "text": "Yo soy... Ejem... Mmm...\\n¡Ya no me acuerdo de quién soy!\\c\\n...\\n...\\c\\n¡Ah, sí! ¡Claro!\\n¡Soy el Quita-Movimientos!"
    },
    {
      "index": 1,
      "id": "poke_waza_01_02",
      "hash": "29fdd4ac6c575775",
      "flags": 0,
      "text": "¿Quieres que haga que uno de tus Pokémon\\nolvide un movimiento?"
    },
    {
      "index": 2,
      "id": "poke_waza_01_03",
      "hash": "29fdd3ac6c5755c2",
      "flags": 0,
      "text": "¿Qué Pokémon quieres que lo olvide?"
    },
    {
      "index": 3,
      "id": "poke_waza_01_04",
      "hash": "29fdceac6c574d43",
      "flags": 0,
      "text": "Vuelve por aquí si quieres que tus Pokémon\\nolviden algún movimiento."
    },
    {
      "index": 4,
      "id": "poke_waza_01_05",
      "hash": "29fdcdac6c574b90",
      "flags": 4,
      "text": "Ese Pokémon solo conoce un movimiento, así que\\nno puede olvidarlo."
    },
    {
      "index": 5,
      "id": "poke_waza_01_06",
      "hash": "29fdd0ac6c5750a9",
      "flags": 0,
      "text": "¿Eh? ¡Los Huevos no conocen ningún\\nmovimiento!"
    },
    {
      "index": 6,
      "id": "poke_waza_01_07",
      "hash": "29fdcfac6c574ef6",
      "flags": 0,
      "text": "¿Qué movimiento debería olvidar?"
    },
    {
      "index": 7,
      "id": "poke_waza_01_08",
      "hash": "29fddaac6c5761a7",
      "flags": 0,
      "text": "¡Ha salido de perlas!\\c\\nTu Pokémon ha olvidado el movimiento\\n[VAR MOVE(0000)] por completo."
    },
    {
      "index": 8,
      "id": "poke_waza_02_01",
      "hash": "547bc9a122ee9513",
      "flags": 0,
      "text": "Me llamo Remi Niscencia.\\c\\nConozco todos los movimientos que un Pokémon\\npuede aprender según va subiendo de nivel.\\c\\nY también puedo hacer que los recuerde si los\\nha olvidado.\\c\\nSi me traes una Escama Corazón, puedo hacer\\nque alguno de tus Pokémon recuerde un\\r\\nmovimiento."
    },
    {
      "index": 9,
      "id": "poke_waza_02_02",
      "hash": "547bcaa122ee96c6",
      "flags": 0,
      "text": "¿Quieres que uno de tus Pokémon recuerde\\nalgún movimiento?"
    },
    {
      "index": 10,
      "id": "poke_waza_02_03",
      "hash": "547bcba122ee9879",
      "flags": 0,
      "text": "Si quieres que uno de tus Pokémon recuerde un\\nmovimiento, tráeme una [VAR ITEM2(0000)]."
    },
    {
      "index": 11,
      "id": "poke_waza_02_04",
      "hash": "547bcca122ee9a2c",
      "flags": 0,
      "text": "¿Qué Pokémon quieres que lo recuerde?"
    },
    {
      "index": 12,
      "id": "poke_waza_02_05",
      "hash": "547bcda122ee9bdf",
      "flags": 0,
      "text": "¡Pero si solo es un Huevo!"
    },
    {
      "index": 13,
      "id": "poke_waza_02_06",
      "hash": "547bcea122ee9d92",
      "flags": 0,
      "text": "Parece que este Pokémon no puede recordar\\nningún movimiento..."
    },
    {
      "index": 14,
      "id": "poke_waza_02_07",
      "hash": "547bcfa122ee9f45",
      "flags": 0,
      "text": "¿Qué movimiento deseas que recuerde?"
    },
    {
      "index": 15,
      "id": "poke_waza_02_13",
      "hash": "547f4ba122f1a7d0",
      "flags": 0,
      "text": "Has entregado una [VAR ITEM2(0000)] a\\ncambio."
    },
    {
      "index": 16,
      "id": "poke_waza_02_14",
      "hash": "547f52a122f1b3b5",
      "flags": 0,
      "text": "¡Hecho! ¡Ha recordado ese movimiento!\\nVuelve cuando quieras, que aquí te espero."
    },
    {
      "index": 17,
      "id": "poke_waza_02_15",
      "hash": "547f51a122f1b202",
      "flags": 0,
      "text": "1, [WAIT 20]2 y... [WAIT 20]¡puf![VAR SFX(0003)][VAR SFX(0000)]\\c\\n¡[VAR PKNICK(0000)] ha olvidado cómo utilizar\\n[VAR MOVE(0001)]! Y...\\c\\n¡[VAR PKNICK(0000)] ha recordado\\n[VAR MOVE(0002)]![VAR SFX(0004)][VAR SFX(0001)]"
    },
    {
      "index": 18,
      "id": "poke_waza_02_16",
      "hash": "547f50a122f1b04f",
      "flags": 0,
      "text": "¡[VAR PKNICK(0000)] ha recordado\\n[VAR MOVE(0002)]![VAR SFX(0004)][VAR SFX(0001)]"
    },
