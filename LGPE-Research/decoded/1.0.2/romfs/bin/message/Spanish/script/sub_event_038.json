{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub038_adultm_01",
      "hash": "f87cb4ed9d98299a",
      "flags": 0,
      "text": "No se me da demasiado bien entrenar Pokémon.\\nDe hecho, mira qué débil es este Charmander.\\c\\nPrefiero que lo cuide alguien con madera de\\nEntrenador, porque lo que es yo..."
    },
    {
      "index": 1,
      "id": "msg_sub038_adultm_05",
      "hash": "f87cb0ed9d9822ce",
      "flags": 0,
      "text": "Por lo visto, has logrado atrapar un total de\\n[VAR NUM9(0000,202F)] Pokémon hasta el momento."
    },
    {
      "index": 2,
      "id": "msg_sub038_adultm_06",
      "hash": "f87cafed9d98211b",
      "flags": 0,
      "text": "¡Así se hace! Me gustaría que te encargaras de\\neste Charmander, si te parece bien."
    },
    {
      "index": 3,
      "id": "msg_sub038_adultm_02",
      "hash": "f87cb3ed9d9827e7",
      "flags": 4,
      "text": "Estupendo. ¡Cuida bien de él!"
    },
    {
      "index": 4,
      "id": "msg_sub038_adultm_07",
      "hash": "f87caeed9d981f68",
      "flags": 0,
      "text": "He logrado atrapar un total de [VAR NUM3(0000)] Pokémon.\\c\\nPara confiarte a este Charmander tienes que\\nhaber capturado al menos tantos como yo."
    },
    {
      "index": 5,
      "id": "msg_sub038_adultm_03",
      "hash": "f87cb2ed9d982634",
      "flags": 0,
      "text": "¿En serio? Supongo que entonces lo enviaré al\\nprofesor..."
    },
    {
      "index": 6,
      "id": "msg_sub038_adultm_04",
      "hash": "f87cb1ed9d982481",
      "flags": 0,
      "text": "¿Qué tal le va a Charmander?"
    },
    {
      "index": 7,
      "id": "msg_sub038_poke_01",
      "hash": "a722653a024051d0",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Charmander:[VAR COLOR(0000)] ¡Char, char!"
    }
  ],
  "unpaired_labels": [
