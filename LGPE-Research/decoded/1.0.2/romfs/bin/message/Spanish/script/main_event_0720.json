    {
      "index": 1,
      "id": "msg_main0720_musashi_01",
      "hash": "716869af2e38670c",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] ¡Pero si tú eres [VAR GENDBR(00FF,0909)]el mocosola mocosa del Monte\\nMoon!"
    },
    {
      "index": 2,
      "id": "msg_main0720_musashi_04",
      "hash": "716866af2e3861f3",
      "flags": 0,
      "text": "¿Se puede saber qué pintas aquí?"
    },
    {
      "index": 3,
      "id": "msg_main0720_select_01",
      "hash": "6d0c15488af76bc0",
      "flags": 0,
      "text": "He venido a rescatar a Cubone"
    },
    {
      "index": 4,
      "id": "msg_main0720_select_02",
      "hash": "6d0c18488af770d9",
      "flags": 0,
      "text": "Quiero unirme a vosotros"
    },
    {
      "index": 5,
      "id": "msg_main0720_musashi_05",
      "hash": "716865af2e386040",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] ¿Estás aquí por ese Pokémon de poca\\nmonta?\\c\\nJa, pues llegas tarde. Ya se lo hemos dado al\\njefe."
    },
    {
      "index": 6,
      "id": "msg_main0720_musashi_06",
      "hash": "716868af2e386559",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] ¿En serio? ¡Fantástico! Contigo de\\nnuestro lado no habrá nada que pueda...\\c\\nEspera, ¡¿me estás tomando el pelo?!"
    },
    {
      "index": 7,
      "id": "msg_main0720_musashi_07",
      "hash": "716867af2e3863a6",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] ¡Que sepas que no vamos a dejar que te\\nacerques ni un milímetro más al jefe!"
    },
    {
      "index": 8,
      "id": "msg_main0720_kojiro_01",
      "hash": "fea20c2f34fd4158",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] ¡Vas a pagárnoslas por lo del fósil,\\nniñat[VAR GENDBR(00FF,0101)]oa!"
    },
    {
      "index": 9,
      "id": "msg_main0720_dummy_01",
      "hash": "c43546420b584cb0",
      "flags": 0,
      "text": "[~ 9]"
    },
    {
      "index": 10,
      "id": "msg_main0720_dummy_02",
      "hash": "c43549420b5851c9",
      "flags": 0,
      "text": "[~ 10]"
    },
    {
      "index": 11,
      "id": "msg_main0720_musashi_02",
      "hash": "71686caf2e386c25",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie:[VAR COLOR(0000)] ¡Arg, qué rabia me da!\\c\\nNo vayas de sobrad[VAR GENDBR(00FF,0101)]oa por la vida solo porque tus\\nPokémon sean un poquiiito más fuertes."
    },
    {
      "index": 12,
      "id": "msg_main0720_kojiro_02",
      "hash": "fea20f2f34fd4671",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] ¡Eso, eso! ¡Menuda injusticia!\\c\\nHacerle eso a dos adultos no tiene nombre.\\n¡Te vamos a dar una lección que no olvidarás!"
    },
    {
      "index": 13,
      "id": "msg_main0720_poke_01_01",
      "hash": "22d8a1ef446a6873",
      "flags": 0,
      "text": "¡Pikaaaa!"
    },
    {
      "index": 14,
      "id": "msg_main0720_poke_02_01",
      "hash": "f85aa9fa8dd325bc",
      "flags": 0,
      "text": "¡Eevee!"
    },
    {
      "index": 15,
      "id": "msg_main0720_kojiro_03",
      "hash": "fea20e2f34fd44be",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James:[VAR COLOR(0000)] ¡Uaaah!"
    },
    {
      "index": 16,
      "id": "msg_main0720_musashi_03",
      "hash": "71686baf2e386a72",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Team Rocket:[VAR COLOR(0000)] ¡El Team Rocket despega de\\nnuevo!"
    },
