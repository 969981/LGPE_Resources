  "lines": [
    {
      "index": 0,
      "id": "msg_sub060_staffm_01",
      "hash": "395210118b58bbf5",
      "flags": 4,
      "text": "El Team Rocket quiere hacerse con el control de\\nSilph S. A. y crear un Pokémon superpoderoso.\\c\\n¡¿Y si intentaran raptar al Porygon que creé?!\\c\\nNo puedo permitir que le pongan sus sucias\\nmanos encima; he de hallar una forma de\\r\\nllevármelo de aquí..."
    },
    {
      "index": 1,
      "id": "msg_sub060_poke_01",
      "hash": "93a4082409662c61",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Porygon:[VAR COLOR(0000)] Gon, gon..."
    },
    {
      "index": 2,
      "id": "msg_sub060_staffm_02",
      "hash": "39520d118b58b6dc",
      "flags": 0,
      "text": "¿Cómo? ¡No me digas que nos has librado de\\nesos malhechores! ¡Mil gracias!\\c\\n¿Te gustaría ocuparte de un Pokémon creado por\\nSilph?"
    },
    {
      "index": 3,
      "id": "msg_sub060_sys_01",
      "hash": "6ba621a1d50c1595",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "msg_sub060_staffm_03",
      "hash": "39520e118b58b88f",
      "flags": 0,
      "text": "¡Porygon tiene un montón de vértices y ángulos!\\n¿No te parece achuchable?"
    },
    {
      "index": 5,
      "id": "msg_sub060_poke_02",
      "hash": "93a4052409662748",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Porygon:[VAR COLOR(0000)] ¡Gon, gon!"
    }
