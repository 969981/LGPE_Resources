{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0430_captain_01",
      "hash": "474d4bf0c26a7e54",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitán: [VAR COLOR(0000)]¡Puaj! Menudo mareo... Tengo el\\nestómago revuelto."
    },
    {
      "index": 1,
      "id": "msg_main0430_sys_01",
      "hash": "e5d62e6437bebe1b",
      "flags": 0,
      "text": "Le has dado un masaje en la espalda al capitán\\ndel barco."
    },
    {
      "index": 2,
      "id": "msg_main0430_sys_03",
      "hash": "e5d6306437bec181",
      "flags": 0,
      "text": "Sana, sanita..."
    },
    {
      "index": 3,
      "id": "msg_main0430_captain_02",
      "hash": "474d4ef0c26a836d",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitán: [VAR COLOR(0000)]Oh, qué bien. ¡Muchas gracias!\\nYa me siento mucho mejor."
    },
    {
      "index": 4,
      "id": "msg_main0430_captain_13",
      "hash": "4749c5f0c26764cb",
      "flags": 4,
      "text": "Ah, ¿tú también has venido para que te enseñe\\nmi Técnica Secreta? ¡Eso está hecho!\\c\\nVen, acércate."
    },
    {
      "index": 5,
      "id": "msg_main0430_partner_a_01",
      "hash": "89fec1e6e8f7587a",
      "flags": 0,
      "text": "¿Pika?"
    },
    {
      "index": 6,
      "id": "msg_main0430_partner_b_01",
      "hash": "e333820030487eed",
      "flags": 0,
      "text": "¡Viii, viii!"
    },
    {
      "index": 7,
      "id": "msg_main0430_captain_07",
      "hash": "474d49f0c26a7aee",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitán:[VAR COLOR(0000)] ¡Jo, jo! Tu [VAR POKNAME(0002)] parece tener\\nganas de aprender mi Técnica Secreta, pero\\r\\nme temo que solo pueden aprenderla humanos."
    },
    {
      "index": 8,
      "id": "msg_main0430_captain_08",
      "hash": "474d44f0c26a726f",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitán:[VAR COLOR(0000)] ¡Vaya! Parece que quiere aprenderla a\\ntoda costa."
    },
    {
      "index": 9,
      "id": "msg_main0430_captain_14",
      "hash": "4749caf0c2676d4a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitán:[VAR COLOR(0000)] Es la primera vez en mi vida que veo\\nun Pokémon con estas ganas de aprender una\\r\\nTécnica Secreta."
    },
    {
      "index": 10,
      "id": "msg_main0430_captain_12",
      "hash": "4749c4f0c2676318",
      "flags": 4,
      "text": "Esa mirada de determinación me invita a pensar\\nque va totalmente en serio.\\c\\n¡No se hable más! Voy a enseñarle la Técnica\\nSecreta a [VAR POKNAME(0002)]."
    },
    {
      "index": 11,
      "id": "msg_main0430_captain_03",
      "hash": "474d4df0c26a81ba",
      "flags": 0,
      "text": "Muy bien, acércate."
    },
    {
      "index": 12,
      "id": "msg_main0430_captain_04",
      "hash": "474d48f0c26a793b",
      "flags": 0,
      "text": "¡Presta mucha atención!"
    },
    {
      "index": 13,
      "id": "msg_main0430_captain_09",
      "hash": "474d43f0c26a70bc",
      "flags": 0,
      "text": "..."
    },
    {
      "index": 14,
      "id": "msg_main0430_captain_10",
      "hash": "4749c6f0c267667e",
      "flags": 0,
      "text": "[~ 14]"
    },
    {
      "index": 15,
      "id": "msg_main0430_captain_11",
      "hash": "4749c7f0c2676831",
      "flags": 0,
      "text": "¡Toma, Jeroma, pastillas de goma!"
    },
    {
      "index": 16,
      "id": "msg_main0430_partner_a_02",
      "hash": "89fec0e6e8f756c7",
      "flags": 0,
      "text": "[~ 16]"
    },
    {
      "index": 17,
      "id": "msg_main0430_partner_b_02",
      "hash": "e3337f00304879d4",
      "flags": 0,
      "text": "[~ 17]"
    },
    {
      "index": 18,
      "id": "msg_main0430_sys_02",
      "hash": "e5d62f6437bebfce",
      "flags": 0,
      "text": "¡[VAR PKNICK(0003)] ha aprendido la [VAR COLOR(0006)]TS Tala[VAR COLOR(0000)]!"
    },
    {
      "index": 19,
      "id": "msg_main0430_captain_05",
      "hash": "474d47f0c26a7788",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitán:[VAR COLOR(0000)] Jo, jo, jo. ¡Ha logrado aprender Tala de\\nverdad! Menuda fiera."
    },
    {
      "index": 20,
      "id": "msg_main0430_captain_15",
      "hash": "4749cbf0c2676efd",
      "flags": 0,
      "text": "Gracias a Tala podrás deshacerte de los arbustos\\nque crecen en los sitios más inoportunos.\\c\\n¿Por qué no pruebas con el que hay en Ciudad\\nCarmín?"
    },
    {
      "index": 21,
      "id": "msg_main0430_captain_06",
      "hash": "474d4af0c26a7ca1",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitán: [VAR COLOR(0000)]Ahora que se me ha pasado el mareo,\\ncreo que ha llegado la hora de levar anclas.\\c\\nEl S. S. Anne se dispone a zarpar.\\n¡Hasta la vista, Ciudad Carmín!"
    },
    {
      "index": 22,
      "id": "msg_seaman1_01_p05_cave_d0308",
      "hash": "5f5346594f04464d",
      "flags": 0,
      "text": "[~ 22]"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0430_max",
      "hash": "78f4da5393d95da8"
    }
  ]
}
