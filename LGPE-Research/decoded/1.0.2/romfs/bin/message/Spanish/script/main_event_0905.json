    },
    {
      "index": 4,
      "id": "msg_main0905_green_01",
      "hash": "31286df728b1b018",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Azul:[VAR COLOR(0000)] ¿Quieres empezar tú, [VAR TRNAME(0000)]?"
    },
    {
      "index": 5,
      "id": "msg_main0905_green_02",
      "hash": "312870f728b1b531",
      "flags": 4,
      "text": "Así se habla. ¡Prepárate!"
    },
    {
      "index": 6,
      "id": "msg_main0905_dummy_02",
      "hash": "3ce78b6f47fb37f4",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main0905_green_03",
      "hash": "31286ff728b1b37e",
      "flags": 0,
      "text": "Bueno, pues allá tú."
    },
    {
      "index": 8,
      "id": "msg_main0905_green_04",
      "hash": "312872f728b1b897",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Azul:[VAR COLOR(0000)] ¡Ajá! Estás más que preparad[VAR GENDBR(00FF,0101)]oa para luchar\\ncontra el Team Rocket.\\c\\nDejo el destino de Silph S. A. en tus manos."
    },
    {
      "index": 9,
      "id": "msg_main0905_red_03",
      "hash": "cf2dde7ee5ed07ce",
      "flags": 0,
      "text": "[~ 9]"
    },
    {
      "index": 10,
      "id": "msg_main0905_sys_02",
      "hash": "b0a05f3c3ff2a7a3",
      "flags": 0,
      "text": "[~ 10]"
    },
    {
      "index": 11,
      "id": "msg_main0905_green_05",
      "hash": "312871f728b1b6e4",
      "flags": 0,
      "text": "¡Vale! Ahora te toca a ti, [VAR TRNAME(0001)].\\n¡No pienso andarme con chiquitas!"
    },
    {
      "index": 12,
      "id": "msg_main0905_rival_01",
      "hash": "ab975143120cf9bd",
      "flags": 0,
      "text": "[~ 12]"
    },
    {
      "index": 13,
      "id": "msg_main0905_rival_02",
      "hash": "ab974e43120cf4a4",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]:[VAR COLOR(0000)] Buf... Solo de veros ya se me\\nhan puesto los pelos de punta.\\c\\n¡Cómo impone la mirada de los Pokémon de\\nAzul! A ver qué tal se me da.\\c\\n[VAR TRNAME(0000)], ve tirando, que ahora\\nte alcanzo."
    },
    {
      "index": 14,
      "id": "msg_main0905_stafff_01",
      "hash": "0dd0da442d90e603",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Recepcionista:[VAR COLOR(0000)] Azul es famoso por su destreza...\\nY no parece que te haya dejado ganar.\\c\\n¡Impresionante! ¡Ojalá puedas ayudarnos a salvar\\na Silph S. A.!"
    }
  ],
