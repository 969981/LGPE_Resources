    {
      "index": 178,
      "id": "kisekae_item_shop_01",
      "hash": "0761ff1f93abba5b",
      "flags": 0,
      "text": "Bienvenue !\\nQu’est-ce qui vous ferait envie, aujourd’hui ?"
    },
    {
      "index": 179,
      "id": "kisekae_item_shop_02",
      "hash": "0762001f93abbc0e",
      "flags": 4,
      "text": "Oh, mais... C’est incroyable !\\nVous avez déjà acheté tous nos produits ?!"
    },
    {
      "index": 180,
      "id": "kisekae_item_shop_03",
      "hash": "0762011f93abbdc1",
      "flags": 0,
      "text": "Bien sûr ! Cela vous fera [VAR NUM6(0002,202F)] ₽ !"
    },
    {
      "index": 181,
      "id": "kisekae_item_shop_04",
      "hash": "0762021f93abbf74",
      "flags": 0,
      "text": "J’achète !"
    },
    {
      "index": 182,
      "id": "kisekae_item_shop_05",
      "hash": "0762031f93abc127",
      "flags": 0,
      "text": "J’ai changé d’avis..."
    },
    {
      "index": 183,
      "id": "kisekae_item_shop_06",
      "hash": "0762041f93abc2da",
      "flags": 0,
      "text": "Merci ! Passez une bonne journée !"
    },
    {
      "index": 184,
      "id": "kisekae_item_shop_07",
      "hash": "0762051f93abc48d",
      "flags": 0,
      "text": "Vous rangez votre achat dans votre\\nMalle à Costumes."
    },
    {
      "index": 185,
      "id": "kisekae_item_shop_08",
      "hash": "0761f61f93abab10",
      "flags": 0,
      "text": "Nous espérons vous revoir bientôt !"
    },
    {
      "index": 186,
      "id": "kisekae_item_shop_09",
      "hash": "0761f71f93abacc3",
      "flags": 0,
      "text": "Mais... Vous n’avez pas assez d’argent !!!"
