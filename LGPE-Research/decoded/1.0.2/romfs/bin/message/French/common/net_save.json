  "lines": [
    {
      "index": 0,
      "id": "net_save_win_01",
      "hash": "eeefe4d96acc1c25",
      "flags": 0,
      "text": "Sauvegarde en cours...\\nVeuillez patienter."
    },
    {
      "index": 1,
      "id": "net_save_win_02",
      "hash": "eeefe1d96acc170c",
      "flags": 4,
      "text": "Attention !\\n\\nSi une erreur de communication survient ou\\nque votre console s’éteint pendant un échange,\\nvous ne pourrez plus échanger de Pokémon\\npendant un certain temps."
    },
    {
      "index": 2,
      "id": "net_save_win_03",
      "hash": "eeefe2d96acc18bf",
      "flags": 0,
      "text": "Communication en cours...\\nVeuillez patienter."
    },
    {
      "index": 3,
      "id": "net_save_win_04",
      "hash": "eeefdfd96acc13a6",
      "flags": 0,
      "text": "Voulez-vous interrompre la connexion ?"
    },
    {
      "index": 4,
      "id": "net_save_sel_01",
      "hash": "0bb15cc36812039f",
      "flags": 4,
      "text": "Oui"
    },
    {
      "index": 5,
      "id": "net_save_sel_02",
      "hash": "0bb15dc368120552",
      "flags": 0,
      "text": "Non"
    },
    {
      "index": 6,
      "id": "net_save_sel_03",
      "hash": "0bb15ec368120705",
      "flags": 4,
      "text": "Annuler"
    },
    {
      "index": 7,
      "id": "net_save_win_05",
      "hash": "eeefe0d96acc1559",
      "flags": 0,
      "text": "L’autre joueur a choisi d’annuler l’échange.\\nL’échange a donc été interrompu."
    }
  ],
