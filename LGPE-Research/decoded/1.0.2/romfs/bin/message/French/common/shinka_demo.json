      "hash": "ca1cc2bee54179c3",
      "flags": 0,
      "text": "Quoi ?\\n[VAR PKNICK(0000)] évolue !"
    },
    {
      "index": 1,
      "id": "msg_shinka_02_01",
      "hash": "a1514aca301af20c",
      "flags": 0,
      "text": "Hein ?\\n[VAR PKNICK(0000)] n’évolue plus !"
    },
    {
      "index": 2,
      "id": "msg_shinka_03_01",
      "hash": "f7b716d1cb84b5e1",
      "flags": 0,
      "text": "Félicitations !\\n[VAR PKNICK(0000)] évolue en [VAR POKNAME(0001)] !"
    },
    {
      "index": 3,
      "id": "msg_shinka_04_01",
      "hash": "98e44e952c6493d2",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] apprend\\n[VAR MOVE(0001)] ![VAR SFX(0004)][VAR SFX(0001)]"
    },
    {
      "index": 4,
      "id": "msg_shinka_05_01",
      "hash": "6fac5aa076e21a87",
      "flags": 0,
      "text": "1[WAIT 20], 2[WAIT 20], [WAIT 20]... [WAIT 20]... Tadaaa ![VAR SFX(0003)][VAR SFX(0000)]\\c\\n[VAR PKNICK(0000)] oublie\\n[VAR MOVE(0001)].\\c\\nEt...\\c\\nIl apprend [VAR MOVE(0002)] ![VAR SFX(0004)][VAR SFX(0001)]"
    },
    {
      "index": 5,
      "id": "msg_shinka_06_01",
      "hash": "c61202a8124ba130",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] n’a pas appris\\n[VAR MOVE(0001)]."
    },
    {
      "index": 6,
      "id": "msg_shinka_07_01",
      "hash": "f35f0eae74ca7ce5",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] veut apprendre\\n[VAR MOVE(0001)].\\c\\nVoulez-vous oublier une capacité pour apprendre\\n[VAR MOVE(0001)] ?"
    },
    {
      "index": 7,
      "id": "msg_shinka_10_01",
      "hash": "3c11b2c38f68a511",
      "flags": 4,
      "text": "Oublier une capacité"
