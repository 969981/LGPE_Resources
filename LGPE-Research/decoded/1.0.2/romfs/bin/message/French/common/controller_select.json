{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "cnt_select_win_01",
      "hash": "209514ec56c75baa",
      "flags": 4,
      "text": "Appuyez sur un bouton de la manette que vous\\nsouhaitez utiliser."
    },
    {
      "index": 1,
      "id": "cnt_select_win_02",
      "hash": "209513ec56c759f7",
      "flags": 0,
      "text": "Voulez-vous utiliser cette manette ?"
    },
    {
      "index": 2,
      "id": "cnt_select_win_03",
      "hash": "209512ec56c75844",
      "flags": 4,
      "text": "Interversion des fonctions des boutons\\neffectuée."
    },
    {
      "index": 3,
      "id": "cnt_select_win_04",
      "hash": "209511ec56c75691",
      "flags": 0,
      "text": "Vous ne pourrez pas utiliser la Poké Ball Plus\\nsi vous ne terminez pas la mise à jour.\\r\\nVoulez-vous vraiment annuler la mise à jour ?"
    },
    {
      "index": 4,
      "id": "cnt_select_win_05",
      "hash": "209510ec56c754de",
      "flags": 0,
      "text": "Mise à jour terminée."
    },
    {
      "index": 5,
      "id": "cnt_select_win_06",
      "hash": "20950fec56c7532b",
      "flags": 0,
      "text": "Mise à jour en cours...\\nNe pas éteindre la console."
    },
    {
      "index": 6,
      "id": "cnt_select_win_07",
      "hash": "20950eec56c75178",
      "flags": 4,
      "text": "Une erreur s’est produite.\\n\\nVeuillez recommencer depuis le début."
    },
    {
      "index": 7,
      "id": "cnt_select_win_08",
      "hash": "20950dec56c74fc5",
      "flags": 0,
      "text": "Votre Poké Ball Plus contient un Pokémon !\\n\\nPour recevoir ce cadeau, sélectionnez\\nCOMMUNICATION dans le menu principal,\\npuis CADEAU MYSTÈRE."
    },
    {
      "index": 8,
      "id": "cnt_select_win_09",
      "hash": "20950cec56c74e12",
      "flags": 0,
      "text": "Choisissez une manette pour le second joueur."
    },
    {
      "index": 9,
      "id": "cnt_select_win_10",
      "hash": "20918fec56c443d4",
      "flags": 0,
      "text": "Voulez-vous intervertir les fonctions des boutons\\nde la Poké Ball Plus ?"
    },
    {
      "index": 10,
      "id": "cnt_select_win_11",
      "hash": "209190ec56c44587",
      "flags": 0,
      "text": "Choisissez une manette pour le premier joueur."
    },
    {
      "index": 11,
      "id": "cnt_select_win_12",
      "hash": "209191ec56c4473a",
      "flags": 0,
      "text": "Connexion en cours..."
    },
    {
      "index": 12,
      "id": "cnt_select_info_01",
      "hash": "b671815c01514bc8",
      "flags": 0,
      "text": "Lorsque vous jouez avec une Poké Ball Plus,\\nappuyez sur le bouton supérieur pour ouvrir\\nle menu."
    },
    {
      "index": 13,
      "id": "cnt_select_info_02",
      "hash": "b671845c015150e1",
      "flags": 4,
      "text": "Une fois dans le menu principal, secouez deux\\nfois votre Poké Ball Plus pour faire apparaître\\nles PARAMÈTRES."
    },
    {
      "index": 14,
      "id": "cnt_select_info_03",
      "hash": "b671835c01514f2e",
      "flags": 0,
      "text": "Lorsque vous jouez avec le Joy-Con (R),\\nappuyez sur le bouton X pour ouvrir le menu."
    },
    {
      "index": 15,
      "id": "cnt_select_info_04",
      "hash": "b671865c01515447",
      "flags": 0,
      "text": "Lorsque vous utilisez le Joy-Con (R),\\nvous pouvez confirmer une action en appuyant,\\nau choix, sur :\\n\\n- Le stick droit\\n- Le bouton R\\n- Le bouton ZR"
    },
    {
      "index": 16,
      "id": "cnt_select_info_05",
      "hash": "b671855c01515294",
      "flags": 0,
      "text": "Lorsque vous jouez avec le Joy-Con (L),\\nappuyez sur le bouton Haut pour ouvrir le menu."
    },
    {
      "index": 17,
      "id": "cnt_select_info_06",
      "hash": "b671885c015157ad",
      "flags": 0,
      "text": "Lorsque vous utilisez le Joy-Con (L),\\nvous pouvez confirmer une action en appuyant,\\nau choix, sur :\\n\\n- Le stick gauche\\n- Le bouton L\\n- Le bouton ZL"
    },
    {
      "index": 18,
      "id": "cnt_select_info_07",
      "hash": "b671875c015155fa",
      "flags": 0,
      "text": "Lorsque vous jouez en mode portable,\\nappuyez sur le bouton X pour ouvrir le menu."
    },
    {
      "index": 19,
      "id": "cnt_select_info_08",
      "hash": "b6717a5c01513fe3",
      "flags": 0,
      "text": "Lorsque vous jouez en mode portable,\\nvous pouvez confirmer une action en appuyant\\nsur le stick droit.\\n\\nL’écran tactile n’est utilisable que dans\\ncertains cas."
    },
    {
      "index": 20,
      "id": "cnt_select_sel_01",
      "hash": "b34042664de9fcd8",
      "flags": 0,
      "text": "Confirmer"
    },
    {
      "index": 21,
      "id": "cnt_select_sel_02",
      "hash": "b34045664dea01f1",
      "flags": 0,
      "text": "Plus d’informations"
    },
    {
      "index": 22,
      "id": "cnt_select_sel_03",
      "hash": "b34044664dea003e",
      "flags": 4,
      "text": "Intervertir les boutons"
    },
    {
      "index": 23,
      "id": "cnt_select_sel_04",
      "hash": "b34047664dea0557",
      "flags": 0,
      "text": "Retour"
    },
    {
      "index": 24,
      "id": "cnt_select_sel_05",
      "hash": "b34046664dea03a4",
      "flags": 4,
      "text": "Oui"
    },
    {
      "index": 25,
      "id": "cnt_select_sel_06",
      "hash": "b34049664dea08bd",
      "flags": 0,
      "text": "Non"
    },
