{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "matching_win_01",
      "hash": "0244fd0f825809cb",
      "flags": 0,
      "text": "Début de la connexion. Veuillez choisir comment\\nvous connecter à un autre joueur."
    },
    {
      "index": 1,
      "id": "matching_win_02",
      "hash": "0244fe0f82580b7e",
      "flags": 0,
      "text": "Que voulez-vous faire ?"
    },
    {
      "index": 2,
      "id": "matching_win_03",
      "hash": "0244ff0f82580d31",
      "flags": 0,
      "text": "Veuillez entrer le même code que le joueur\\navec lequel vous désirez interagir."
    },
    {
      "index": 3,
      "id": "matching_win_04",
      "hash": "0245000f82580ee4",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "matching_win_05",
      "hash": "0245010f82581097",
      "flags": 0,
      "text": "Veuillez sélectionner trois icônes de Pokémon\\npour créer un code.\\c\\nLe joueur avec lequel vous désirez jouer devra\\nchoisir la même combinaison d’icônes pour\\r\\nse connecter avec vous."
    },
    {
      "index": 5,
      "id": "matching_win_06",
      "hash": "0245020f8258124a",
      "flags": 0,
      "text": "Recherche d’un adversaire pour un Combat Solo\\nen cours..."
    },
    {
      "index": 6,
      "id": "matching_win_07",
      "hash": "0245030f825813fd",
      "flags": 0,
      "text": "Recherche d’un adversaire pour un Combat Duo\\nen cours..."
    },
    {
      "index": 7,
      "id": "matching_win_08",
      "hash": "0244f40f8257fa80",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "matching_win_09",
      "hash": "0244f50f8257fc33",
      "flags": 0,
      "text": "Recherche d’un partenaire pour un échange\\nen cours..."
    },
    {
      "index": 9,
      "id": "matching_win_10",
      "hash": "0248820f825b21a1",
      "flags": 0,
      "text": "Vous allez bientôt être connecté à un autre\\njoueur. Veuillez patienter."
    },
    {
      "index": 10,
      "id": "matching_win_11",
      "hash": "0248810f825b1fee",
      "flags": 4,
      "text": "Une erreur de connexion ou d’alimentation\\na interrompu votre dernier échange.\\nPour cette raison, tout Échange Link est\\nmomentanément impossible.\\n\\n[VAR COLOR(0002)]Veuillez patienter un moment avant de réessayer.[VAR COLOR(0000)]"
    },
    {
      "index": 11,
      "id": "matching_win_12",
      "hash": "0248800f825b1e3b",
      "flags": 4,
      "text": "Impossible d’effectuer un échange car vous ne\\npossédez pas deux Pokémon ou plus.\\n\\nVotre Pokémon partenaire et le Pokémon que\\nvous avez sorti de sa Poké Ball ne peuvent pas\\nêtre échangés.\\n\\nVeuillez réunir suffisamment de Pokémon\\néchangeables, puis réessayez."
    },
    {
      "index": 12,
      "id": "matching_win_13",
      "hash": "02487f0f825b1c88",
      "flags": 4,
      "text": "Impossible de participer à un Combat Duo\\ncar ni votre équipe ni votre Boîte Pokémon\\nne contiennent deux Pokémon ou plus.\\n\\nVeuillez attraper davantage de Pokémon,\\npuis réessayez."
    },
    {
      "index": 13,
      "id": "matching_win_14",
      "hash": "0248860f825b286d",
      "flags": 0,
      "text": "Vous allez maintenant vous connecter à Internet.\\c\\nVotre partie va être sauvegardée.\\nVoulez-vous continuer ?"
    },
    {
      "index": 14,
      "id": "matching_win_15",
      "hash": "0248850f825b26ba",
      "flags": 0,
      "text": "Vous êtes maintenant connecté à Internet."
    },
    {
      "index": 15,
      "id": "matching_win_16",
      "hash": "0248840f825b2507",
      "flags": 0,
      "text": "Sauvegarde en cours...\\nVeuillez patienter."
    },
    {
      "index": 16,
      "id": "matching_win_17",
      "hash": "0248830f825b2354",
      "flags": 0,
      "text": "Connexion en cours...\\nVeuillez patienter."
    },
    {
      "index": 17,
      "id": "matching_cap_01",
      "hash": "b85892b9113f52d9",
      "flags": 4,
      "text": "Un joueur près de vous"
    },
    {
      "index": 18,
      "id": "matching_cap_02",
      "hash": "b8588fb9113f4dc0",
      "flags": 4,
      "text": "Un joueur loin de vous"
    },
    {
