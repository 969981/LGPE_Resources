{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "BTR_STATE_00_01",
      "hash": "4fb031d3b2084edc",
      "flags": 0,
      "text": "[~ 0]"
    },
    {
      "index": 1,
      "id": "BTR_STATE_00_02",
      "hash": "4fb034d3b20853f5",
      "flags": 0,
      "text": "[~ 1]"
    },
    {
      "index": 2,
      "id": "BTR_STATE_01_01",
      "hash": "7bb6bdda13718e71",
      "flags": 0,
      "text": "Soleil"
    },
    {
      "index": 3,
      "id": "BTR_STATE_01_02",
      "hash": "7bb6bada13718958",
      "flags": 0,
      "text": "Le soleil est au zénith. La puissance des\\nattaques de type Feu augmente alors que celle\\ndes attaques de type Eau diminue."
    },
    {
      "index": 4,
      "id": "BTR_STATE_02_01",
      "hash": "773f7dc3401fbd7e",
      "flags": 0,
      "text": "Pluie"
    },
    {
      "index": 5,
      "id": "BTR_STATE_02_02",
      "hash": "773f7cc3401fbbcb",
      "flags": 4,
      "text": "Il pleut. La puissance des attaques de type Eau\\naugmente alors que celle des attaques de type\\nFeu diminue."
    },
    {
      "index": 6,
      "id": "BTR_STATE_03_01",
      "hash": "7a2e29c8689f9193",
      "flags": 0,
      "text": "Tempête de sable"
    },
    {
      "index": 7,
      "id": "BTR_STATE_03_02",
      "hash": "7a2e2ac8689f9346",
      "flags": 4,
      "text": "On n’y voit rien ! Tous les Pokémon, à part ceux\\nde type Roche, Sol ou Acier, subissent des\\ndégâts à la fin de chaque tour. Les Pokémon\\nde type Roche voient leur Défense Spéciale\\naugmenter."
    },
    {
      "index": 8,
      "id": "BTR_STATE_04_01",
      "hash": "4a11a9b05a3879c0",
      "flags": 0,
      "text": "Grêle"
    },
    {
      "index": 9,
      "id": "BTR_STATE_04_02",
      "hash": "4a11acb05a387ed9",
      "flags": 0,
      "text": "Qu’est-ce qu’il fait froid... Tous les Pokémon,\\nà part ceux de type Glace, subissent des\\ndégâts à la fin de chaque tour."
    },
    {
      "index": 10,
      "id": "BTR_STATE_05_01",
      "hash": "a1bdf5b7f6b7d9b5",
      "flags": 0,
      "text": "Champ Électrifié"
    },
    {
      "index": 11,
      "id": "BTR_STATE_05_02",
      "hash": "a1bdf2b7f6b7d49c",
      "flags": 0,
      "text": "Pendant cinq tours, les Pokémon au sol ne\\npeuvent plus dormir. La puissance des\\ncapacités de type Électrik augmente."
    },
    {
      "index": 12,
      "id": "BTR_STATE_06_01",
      "hash": "7354759fe9c25662",
      "flags": 0,
      "text": "Champ Herbu"
    },
    {
      "index": 13,
      "id": "BTR_STATE_06_02",
      "hash": "7354749fe9c254af",
      "flags": 0,
      "text": "Pendant cinq tours, les Pokémon au sol\\nregagnent des PV. La puissance des\\ncapacités de type Plante augmente."
    },
    {
      "index": 14,
      "id": "BTR_STATE_07_01",
      "hash": "1e0ac1a9f8ce9dd7",
      "flags": 0,
      "text": "Champ Brumeux"
    },
    {
      "index": 15,
      "id": "BTR_STATE_07_02",
      "hash": "1e0ac2a9f8ce9f8a",
      "flags": 0,
      "text": "Pendant cinq tours, les Pokémon au sol\\nne peuvent plus subir d’altération de statut.\\nLa puissance des capacités de type Dragon\\ndiminue de moitié."
    },
    {
      "index": 16,
      "id": "BTR_STATE_08_01",
      "hash": "da8a0216b2928334",
      "flags": 0,
      "text": "Distorsion"
    },
    {
      "index": 17,
      "id": "BTR_STATE_08_02",
      "hash": "da8a0516b292884d",
      "flags": 0,
      "text": "Pendant cinq tours, la Vitesse des Pokémon est\\ninversée : les plus lents deviennent les plus\\nrapides, et vice-versa."
    },
    {
      "index": 18,
      "id": "BTR_STATE_09_01",
      "hash": "dbc52e1bd99fe949",
      "flags": 0,
      "text": "Zone Magique"
    },
    {
      "index": 19,
      "id": "BTR_STATE_09_02",
      "hash": "dbc52b1bd99fe430",
      "flags": 0,
      "text": "Pendant cinq tours, aucun objet tenu ne peut\\nêtre activé."
    },
    {
      "index": 20,
      "id": "BTR_STATE_10_01",
      "hash": "c03652089e1b28bf",
      "flags": 0,
      "text": "Zone Étrange"
    },
    {
      "index": 21,
      "id": "BTR_STATE_10_02",
      "hash": "c03653089e1b2a72",
      "flags": 0,
      "text": "Pendant cinq tours, la Défense et la Défense\\nSpéciale de tous les Pokémon sont interverties."
    },
    {
      "index": 22,
      "id": "BTR_STATE_11_01",
      "hash": "136025fe8d40b14a",
      "flags": 0,
      "text": "Chance Critique"
    },
    {
      "index": 23,
      "id": "BTR_STATE_11_02",
      "hash": "136024fe8d40af97",
      "flags": 0,
      "text": "Le Pokémon a plus de chances d’infliger\\ndes coups critiques."
    },
    {
      "index": 24,
      "id": "BTR_STATE_12_01",
      "hash": "c152661a48912d3d",
      "flags": 0,
      "text": "Confusion"
    },
    {
      "index": 25,
      "id": "BTR_STATE_12_02",
      "hash": "c152631a48912824",
      "flags": 0,
      "text": "Pendant un à quatre tours, le Pokémon risque\\nde se blesser lui-même."
    },
    {
      "index": 26,
      "id": "BTR_STATE_13_01",
      "hash": "ebd0da0eff2942a8",
      "flags": 4,
      "text": "Attraction"
    },
    {
      "index": 27,
      "id": "BTR_STATE_13_02",
      "hash": "ebd0dd0eff2947c1",
      "flags": 0,
      "text": "Le Pokémon risque de ne pas pouvoir attaquer\\nles Pokémon de sexe opposé."
    },
    {
      "index": 28,
      "id": "BTR_STATE_14_01",
      "hash": "45059a28467a691b",
      "flags": 0,
      "text": "Cauchemar"
    },
    {
      "index": 29,
      "id": "BTR_STATE_14_02",
      "hash": "45059b28467a6ace",
      "flags": 0,
      "text": "Le Pokémon perd des PV à chaque tour jusqu’à\\nce qu’il se réveille."
    },
    {
      "index": 30,
      "id": "BTR_STATE_15_01",
      "hash": "18fe8e21e5105006",
      "flags": 0,
      "text": "Bâillement"
    },
    {
      "index": 31,
      "id": "BTR_STATE_15_02",
      "hash": "18fe8d21e5104e53",
      "flags": 0,
      "text": "Le Pokémon s’endormira au tour suivant celui\\noù il a été pris pour cible par la capacité."
    },
    {
      "index": 32,
      "id": "BTR_STATE_16_01",
      "hash": "1d75ce38b86220f9",
      "flags": 4,
      "text": "Encore"
    },
    {
      "index": 33,
      "id": "BTR_STATE_16_02",
      "hash": "1d75cb38b8621be0",
      "flags": 0,
      "text": "Pendant trois tours, le Pokémon ne pourra plus\\nque répéter [VAR MOVE(0000)]."
    },
    {
      "index": 34,
      "id": "BTR_STATE_17_01",
      "hash": "f028623255e2a224",
      "flags": 4,
      "text": "Aucun talent"
    },
    {
      "index": 35,
      "id": "BTR_STATE_17_02",
      "hash": "f028653255e2a73d",
      "flags": 0,
      "text": "Le talent du Pokémon ne fait plus effet."
    },
    {
      "index": 36,
      "id": "BTR_STATE_18_01",
      "hash": "5fbb61c6d790d587",
      "flags": 0,
      "text": "Tourmente"
    },
    {
      "index": 37,
      "id": "BTR_STATE_18_02",
      "hash": "5fbb62c6d790d73a",
      "flags": 0,
      "text": "Le Pokémon ne peut plus utiliser la même\\ncapacité deux fois de suite."
    },
    {
      "index": 38,
      "id": "BTR_STATE_19_01",
      "hash": "88f355bb8d134ed2",
      "flags": 0,
      "text": "Vent Arrière"
    },
    {
      "index": 39,
      "id": "BTR_STATE_19_02",
      "hash": "88f354bb8d134d1f",
      "flags": 0,
      "text": "Pendant quatre tours, la Vitesse des Pokémon\\nde l’équipe est doublée."
    },
    {
      "index": 40,
      "id": "BTR_STATE_20_01",
      "hash": "6f0ff569da3dc0c2",
      "flags": 4,
      "text": "Air Veinard"
    },
    {
      "index": 41,
      "id": "BTR_STATE_20_02",
      "hash": "6f0ff469da3dbf0f",
      "flags": 0,
      "text": "Le Pokémon ne peut pas subir de coup critique."
    },
    {
      "index": 42,
      "id": "BTR_STATE_21_01",
      "hash": "c6bbc17176bc4737",
      "flags": 0,
      "text": "Rancune"
    },
    {
      "index": 43,
      "id": "BTR_STATE_21_02",
      "hash": "c6bbc27176bc48ea",
      "flags": 0,
      "text": "Si un Pokémon met celui-ci K.O., les PP de\\nla capacité qu’il a utilisée tomberont à zéro."
    },
    {
      "index": 44,
      "id": "BTR_STATE_22_01",
      "hash": "f2c2a977d8262320",
      "flags": 4,
      "text": "Anti-Soin"
    },
    {
      "index": 45,
      "id": "BTR_STATE_22_02",
      "hash": "f2c2ac77d8262839",
      "flags": 0,
      "text": "Pendant cinq tours, le Pokémon ne peut plus\\nrécupérer de PV grâce à ses capacités,\\nson talent ou l’objet qu’il tient."
    },
    {
      "index": 46,
      "id": "BTR_STATE_23_01",
      "hash": "9d78f581e7326a95",
      "flags": 4,
      "text": "Anti-Spectre"
    },
    {
      "index": 47,
      "id": "BTR_STATE_23_02",
      "hash": "9d78f281e732657c",
      "flags": 0,
      "text": "Certaines capacités qui auraient dû n’avoir\\naucun effet peuvent maintenant atteindre\\nleur cible, et touchent sans prendre en compte\\nles augmentations d’Esquive."
    },
    {
      "index": 48,
      "id": "BTR_STATE_24_01",
      "hash": "cb32fd884a0e115e",
      "flags": 4,
      "text": "Entrave"
    },
    {
      "index": 49,
      "id": "BTR_STATE_24_02",
      "hash": "cb32fc884a0e0fab",
      "flags": 0,
      "text": "Le Pokémon ne peut plus utiliser la capacité\\n[VAR MOVE(0000)] pendant quatre tours."
    },
    {
      "index": 50,
      "id": "BTR_STATE_25_01",
      "hash": "212ba98fe51accf3",
      "flags": 4,
      "text": "Anti-Fuite"
    },
    {
      "index": 51,
      "id": "BTR_STATE_25_02",
      "hash": "212baa8fe51acea6",
      "flags": 0,
      "text": "Le Pokémon ne peut plus être changé pour\\nun autre de l’équipe et ne peut plus fuir."
    },
    {
      "index": 52,
      "id": "BTR_STATE_26_01",
      "hash": "f6adb19b2e838a3c",
      "flags": 0,
      "text": "Verrouillage"
    },
    {
      "index": 53,
      "id": "BTR_STATE_26_02",
      "hash": "f6adb49b2e838f55",
      "flags": 0,
      "text": "La capacité utilisée au tour suivant l’utilisation\\nde Verrouillage touchera à coup sûr."
    },
    {
      "index": 54,
      "id": "BTR_STATE_27_01",
      "hash": "2467bda1915f37d1",
      "flags": 4,
      "text": "Embargo"
    },
    {
      "index": 55,
      "id": "BTR_STATE_27_02",
      "hash": "2467baa1915f32b8",
      "flags": 0,
      "text": "Pendant cinq tours, aucun objet ne peut être\\nutilisé."
    },
    {
      "index": 56,
      "id": "BTR_STATE_28_01",
      "hash": "cf1e05aba06b787a",
      "flags": 0,
      "text": "Chargeur"
    },
    {
      "index": 57,
      "id": "BTR_STATE_28_02",
      "hash": "cf1e04aba06b76c7",
      "flags": 0,
      "text": "Si le Pokémon utilise une capacité Électrik\\nimmédiatement après avoir utilisé Chargeur,\\nla puissance de celle-ci sera doublée."
    },
    {
      "index": 58,
      "id": "BTR_STATE_29_01",
      "hash": "fb24f1b201d55b2f",
      "flags": 0,
      "text": "Gravité"
    },
    {
      "index": 59,
      "id": "BTR_STATE_29_02",
      "hash": "fb24f2b201d55ce2",
      "flags": 0,
      "text": "Pendant cinq tours, il sera plus facile de toucher\\nle Pokémon. Les capacités de type Sol pourront\\ntoucher les Pokémon de type Vol ou ayant le\\ntalent Lévitation. Le Pokémon ne peut plus\\nutiliser de capacité lui permettant de s’envoler."
    },
    {
      "index": 60,
      "id": "BTR_STATE_30_01",
      "hash": "df29959ec5f4a245",
      "flags": 0,
      "text": "Brume"
    },
    {
      "index": 61,
      "id": "BTR_STATE_30_02",
      "hash": "df29929ec5f49d2c",
      "flags": 0,
      "text": "Pendant cinq tours, les stats ne peuvent plus\\nbaisser."
    },
    {
      "index": 62,
      "id": "BTR_STATE_31_01",
      "hash": "0a1489937ce8b010",
      "flags": 0,
      "text": "Rune Protect"
    },
    {
      "index": 63,
      "id": "BTR_STATE_31_02",
      "hash": "0a148c937ce8b529",
      "flags": 0,
      "text": "Pendant cinq tours, le Pokémon est protégé\\ncontre les altérations de statut."
    },
    {
      "index": 64,
      "id": "BTR_STATE_32_01",
      "hash": "06b9618e540cea67",
      "flags": 0,
      "text": "Piège de Roc"
    },
    {
      "index": 65,
      "id": "BTR_STATE_32_02",
      "hash": "06b9628e540cec1a",
      "flags": 4,
      "text": "Inflige des dégâts aux Pokémon entrant sur\\nle terrain."
    },
    {
      "index": 66,
      "id": "BTR_STATE_33_01",
      "hash": "31a3d5830b001eb2",
      "flags": 0,
      "text": "Stockage"
    },
    {
      "index": 67,
      "id": "BTR_STATE_33_02",
      "hash": "31a3d4830b001cff",
      "flags": 0,
      "text": "La Défense et la Défense Spéciale du Pokémon\\naugmentent tant que le Stockage continue."
    },
    {
      "index": 68,
      "id": "BTR_STATE_34_01",
      "hash": "3a069dbd34b03041",
      "flags": 0,
      "text": "Provocation"
    },
    {
      "index": 69,
      "id": "BTR_STATE_34_02",
      "hash": "3a069abd34b02b28",
      "flags": 0,
      "text": "Le Pokémon ne peut plus utiliser que des\\ncapacités infligeant des dégâts."
    },
    {
      "index": 70,
      "id": "BTR_STATE_35_01",
      "hash": "385e51b80d45c1ec",
      "flags": 0,
      "text": "Lévikinésie"
    },
    {
      "index": 71,
      "id": "BTR_STATE_35_02",
      "hash": "385e54b80d45c705",
      "flags": 0,
      "text": "Pendant trois tours, le Pokémon sera touché\\nà coup sûr par toutes les capacités à\\nl’exception de celles qui mettent K.O. en\\nun coup. Par contre, il ne pourra plus être\\ntouché par les capacités de type Sol."
    },
    {
      "index": 72,
      "id": "BTR_STATE_36_01",
      "hash": "62dc49acc3dd04a3",
      "flags": 0,
      "text": "Vol Magnétik"
    },
    {
      "index": 73,
      "id": "BTR_STATE_36_02",
      "hash": "62dc4aacc3dd0656",
      "flags": 0,
      "text": "Pendant cinq tours, le Pokémon ne pourra plus\\nêtre touché par les capacités de type Sol."
    },
    {
      "index": 74,
      "id": "BTR_STATE_37_01",
      "hash": "358f5da6615e5f4e",
      "flags": 0,
      "text": "Pics Toxik"
    },
    {
      "index": 75,
      "id": "BTR_STATE_37_02",
      "hash": "358f5ca6615e5d9b",
      "flags": 4,
      "text": "Empoisonne les Pokémon entrant sur le terrain,\\nsauf s’ils sont de type Vol ou ont le talent\\nLévitation."
    },
    {
      "index": 76,
      "id": "BTR_STATE_38_01",
      "hash": "6a0365e1c67ed69d",
      "flags": 0,
      "text": "Lance-Boue"
    },
    {
      "index": 77,
      "id": "BTR_STATE_38_02",
      "hash": "6a0362e1c67ed184",
      "flags": 0,
      "text": "Pendant cinq tours, la puissance des capacités\\nde type Électrik est divisée par deux."
    },
    {
      "index": 78,
      "id": "BTR_STATE_39_01",
      "hash": "948159d67d161288",
      "flags": 0,
      "text": "Vœu"
    },
    {
      "index": 79,
      "id": "BTR_STATE_39_02",
      "hash": "94815cd67d1617a1",
      "flags": 0,
      "text": "Des PV seront restaurés au tour suivant\\nl’utilisation de Vœu."
    },
    {
      "index": 80,
      "id": "BTR_STATE_40_01",
      "hash": "e979a57045ab8090",
      "flags": 0,
      "text": "Toile Gluante"
    },
    {
      "index": 81,
      "id": "BTR_STATE_40_02",
      "hash": "e979a87045ab85a9",
      "flags": 0,
      "text": "Quand un Pokémon laisse sa place à un\\ncoéquipier, la Vitesse de ce dernier est baissée."
    },
    {
      "index": 82,
      "id": "BTR_STATE_41_01",
      "hash": "be8eb17b8eb772c5",
      "flags": 0,
      "text": "Racines"
    },
    {
      "index": 83,
      "id": "BTR_STATE_41_02",
      "hash": "be8eae7b8eb76dac",
      "flags": 0,
      "text": "Restaure quelques PV à la fin de chaque tour.\\nLe Pokémon affecté ne peut plus laisser\\nsa place à un autre Pokémon."
    },
    {
      "index": 84,
      "id": "BTR_STATE_42_01",
      "hash": "1108f15fd3c2ef32",
      "flags": 0,
      "text": "Malédiction"
    },
    {
      "index": 85,
      "id": "BTR_STATE_42_02",
      "hash": "1108f05fd3c2ed7f",
      "flags": 0,
      "text": "Fait perdre des PV à la fin de chaque tour."
    },
    {
      "index": 86,
      "id": "BTR_STATE_43_01",
      "hash": "e61e7d6b1ccfbae7",
      "flags": 0,
      "text": "Halloween"
    },
    {
      "index": 87,
      "id": "BTR_STATE_43_02",
      "hash": "e61e7e6b1ccfbc9a",
      "flags": 4,
      "text": "Octroie le type Spectre en plus du ou des types\\nque le Pokémon possède normalement."
    },
    {
      "index": 88,
      "id": "BTR_STATE_44_01",
      "hash": "17c36d94d608926c",
      "flags": 0,
      "text": "Mur Lumière"
    },
    {
      "index": 89,
      "id": "BTR_STATE_44_02",
      "hash": "17c37094d6089785",
      "flags": 0,
      "text": "Pendant cinq tours, les dégâts causés par\\nles capacités spéciales subies seront divisés\\npar deux."
    },
    {
      "index": 90,
      "id": "BTR_STATE_45_01",
      "hash": "196bb999fd7300c1",
      "flags": 0,
      "text": "Protection"
    },
    {
      "index": 91,
      "id": "BTR_STATE_45_02",
      "hash": "196bb699fd72fba8",
      "flags": 0,
      "text": "Pendant cinq tours, les dégâts causés par\\nles capacités physiques subies seront divisés\\npar deux."
    },
    {
      "index": 92,
      "id": "BTR_STATE_46_01",
      "hash": "14f479832a212fce",
      "flags": 0,
      "text": "Possessif"
    },
    {
      "index": 93,
      "id": "BTR_STATE_46_02",
      "hash": "14f478832a212e1b",
      "flags": 0,
      "text": "Le Pokémon ayant utilisé Possessif empêche\\nl’ennemi de se servir des capacités qu’ils ont\\nen commun."
    },
    {
      "index": 94,
      "id": "BTR_STATE_47_01",
      "hash": "424165898c9fd523",
      "flags": 0,
      "text": "Requiem"
    },
    {
      "index": 95,
      "id": "BTR_STATE_47_02",
      "hash": "424166898c9fd6d6",
      "flags": 0,
      "text": "Tous les Pokémon ayant entendu le Requiem\\nseront K.O. après trois tours."
    },
    {
      "index": 96,
      "id": "BTR_STATE_48_01",
      "hash": "73e675b345d8e308",
      "flags": 0,
      "text": "Picots"
    },
    {
      "index": 97,
      "id": "BTR_STATE_48_02",
      "hash": "73e678b345d8e821",
      "flags": 4,
      "text": "Inflige des dégâts aux Pokémon entrant\\nsur le terrain, sauf s’ils sont de type Vol\\nou possèdent le talent Lévitation."
    },
    {
      "index": 98,
      "id": "BTR_STATE_49_01",
      "hash": "496881be8f41a71d",
      "flags": 0,
      "text": "Tourniquet"
    },
    {
      "index": 99,
      "id": "BTR_STATE_49_02",
      "hash": "49687ebe8f41a204",
      "flags": 0,
      "text": "Pendant cinq tours, la puissance des capacités\\nde type Feu est divisée par deux."
    },
    {
      "index": 100,
      "id": "BTR_STATE_50_01",
      "hash": "599345a531626213",
      "flags": 0,
      "text": "Prélèvem. Destin"
    },
    {
      "index": 101,
      "id": "BTR_STATE_50_02",
      "hash": "599346a5316263c6",
      "flags": 0,
      "text": "Si ce Pokémon est mis K.O., le Pokémon\\nresponsable sera également mis K.O."
    },
    {
      "index": 102,
      "id": "BTR_STATE_51_01",
      "hash": "56a499a008e28dfe",
      "flags": 0,
      "text": "Maléfice Sylvain"
    },
    {
      "index": 103,
      "id": "BTR_STATE_51_02",
      "hash": "56a498a008e28c4b",
      "flags": 4,
      "text": "Octroie le type Plante en plus du ou des types\\nque le Pokémon possède normalement."
    },
    {
      "index": 104,
      "id": "BTR_STATE_52_01",
      "hash": "5b1bd9b6dc345ef1",
      "flags": 0,
      "text": "Vampigraine"
    },
    {
      "index": 105,
      "id": "BTR_STATE_52_02",
      "hash": "5b1bd6b6dc3459d8",
      "flags": 4,
      "text": "À la fin du tour, la cible se fait voler des PV."
    },
    {
      "index": 106,
      "id": "BTR_STATE_53_01",
      "hash": "2f154db07acb1f5c",
      "flags": 0,
      "text": "Verrouillage"
    },
    {
      "index": 107,
      "id": "BTR_STATE_53_02",
      "hash": "2f1550b07acb2475",
      "flags": 0,
      "text": "Les capacités toucheront le Pokémon cible\\nà coup sûr."
    },
    {
      "index": 108,
      "id": "BTR_STATE_54_01",
      "hash": "fd6fdd86c1916e57",
      "flags": 4,
      "text": "Étreinte"
    },
    {
      "index": 109,
      "id": "BTR_STATE_54_02",
      "hash": "fd6fde86c191700a",
      "flags": 0,
      "text": "Le Pokémon subit des dégâts à chaque tour."
    },
    {
      "index": 110,
      "id": "BTR_STATE_55_01",
      "hash": "52b9917cb28526e2",
      "flags": 0,
      "text": "Patience"
    },
    {
      "index": 111,
      "id": "BTR_STATE_55_02",
      "hash": "52b9907cb285252f",
      "flags": 0,
      "text": "Le Pokémon encaisse les attaques pendant\\ndeux tours, puis renvoie le double des dégâts\\nqu’il a subis à sa cible."
    },
    {
      "index": 112,
      "id": "BTR_STATE_56_01",
      "hash": "81231194bf7aaa35",
      "flags": 0,
      "text": "Colère"
    },
    {
      "index": 113,
      "id": "BTR_STATE_56_02",
      "hash": "81230e94bf7aa51c",
      "flags": 0,
      "text": "Le lanceur enrage et attaque pendant deux\\nou trois tours avant de devenir confus."
    },
    {
      "index": 114,
      "id": "BTR_STATE_57_01",
      "hash": "2976c58d22fb4a40",
      "flags": 0,
      "text": "Mania"
    },
    {
      "index": 115,
      "id": "BTR_STATE_57_02",
      "hash": "2976c88d22fb4f59",
      "flags": 0,
      "text": "Le lanceur enrage et attaque pendant deux\\nou trois tours avant de devenir confus."
    },
    {
      "index": 116,
      "id": "BTR_STATE_58_01",
      "hash": "e2ba15e8307b01eb",
      "flags": 0,
      "text": "Danse-Fleur"
    },
    {
      "index": 117,
      "id": "BTR_STATE_58_02",
      "hash": "e2ba16e8307b039e",
      "flags": 0,
      "text": "Le lanceur enrage et attaque pendant deux\\nou trois tours avant de devenir confus."
    },
    {
      "index": 118,
      "id": "BTR_STATE_59_01",
      "hash": "8c5449e095113e16",
      "flags": 0,
      "text": "Poison grave"
    },
    {
      "index": 119,
      "id": "BTR_STATE_59_02",
      "hash": "8c5448e095113c63",
      "flags": 0,
      "text": "Le Pokémon est gravement empoisonné,\\net perd de plus en plus de PV à chaque tour."
    },
    {
      "index": 120,
      "id": "BTR_STATE_60_01",
      "hash": "5d592a13a8f43f36",
      "flags": 4,
      "text": "Attaque future"
    },
    {
      "index": 121,
      "id": "BTR_STATE_60_02",
      "hash": "5d592913a8f43d83",
      "flags": 0,
      "text": "Le Pokémon subira des dégâts après deux\\ntours."
    },
    {
      "index": 122,
      "id": "BTR_STATE_61_01",
      "hash": "5f00f618d05dd40b",
      "flags": 0,
      "text": "Brouhaha"
    },
    {
      "index": 123,
      "id": "BTR_STATE_61_02",
      "hash": "5f00f718d05dd5be",
      "flags": 0,
      "text": "Le lanceur enrage et attaque pendant trois\\ntours. Aucun Pokémon ne peut dormir pendant\\ncette période."
    },
    {
      "index": 124,
      "id": "BTR_STATE_62_01",
      "hash": "3482fe2419c69154",
      "flags": 4,
      "text": "Anneau Hydro"
    },
    {
      "index": 125,
      "id": "BTR_STATE_62_02",
      "hash": "3483012419c6966d",
      "flags": 4,
      "text": "Un voile d’eau recouvre le lanceur et régénère\\nses PV à chaque tour."
    },
    {
      "index": 126,
      "id": "BTR_STATE_63_01",
      "hash": "8c2f2a2bb645bae9",
      "flags": 4,
      "text": "Allègement"
    },
    {
      "index": 127,
      "id": "BTR_STATE_63_02",
      "hash": "8c2f272bb645b5d0",
      "flags": 0,
      "text": "Le lanceur s’allège et augmente beaucoup\\nsa Vitesse."
    },
    {
      "index": 128,
      "id": "BTR_STATE_64_01",
      "hash": "2d5c01ef1724f5ba",
      "flags": 4,
      "text": "Anti-Air"
    },
    {
      "index": 129,
      "id": "BTR_STATE_64_02",
      "hash": "2d5c00ef1724f407",
      "flags": 0,
      "text": "La cible est touchée en plein vol et s’écrase\\nau sol."
    },
    {
      "index": 130,
      "id": "BTR_STATE_65_01",
      "hash": "02ddedfa608d836f",
      "flags": 0,
      "text": "Verrou Enchanté"
    },
    {
      "index": 131,
      "id": "BTR_STATE_65_02",
      "hash": "02ddeefa608d8522",
      "flags": 4,
      "text": "Aucun Pokémon ne peut quitter le terrain durant\\nle tour suivant l’utilisation de cette capacité."
    },
    {
      "index": 132,
      "id": "BTR_STATE_66_01",
      "hash": "5a89b601fd0c0318",
      "flags": 4,
      "text": "Arc-en-ciel"
    },
    {
      "index": 133,
      "id": "BTR_STATE_66_02",
      "hash": "5a89b901fd0c0831",
      "flags": 4,
      "text": "Augmente les chances qu’un effet additionnel\\nse produise."
    },
    {
      "index": 134,
      "id": "BTR_STATE_67_01",
      "hash": "8690c2085e761c2d",
      "flags": 0,
      "text": "Marécage"
    },
    {
      "index": 135,
      "id": "BTR_STATE_67_02",
      "hash": "8690bf085e761714",
      "flags": 0,
      "text": "Divise la Vitesse par quatre."
    },
    {
      "index": 136,
      "id": "BTR_STATE_68_01",
      "hash": "d2ebf9d0a8c6399e",
      "flags": 0,
      "text": "Mer de Feu"
    },
    {
      "index": 137,
      "id": "BTR_STATE_68_02",
      "hash": "d2ebf8d0a8c637eb",
      "flags": 0,
      "text": "Tous les Pokémon, à part ceux de type Feu,\\nsubissent des dégâts à chaque tour."
    },
    {
      "index": 138,
      "id": "BTR_STATE_69_01",
      "hash": "28e4a5d843d2f533",
      "flags": 0,
      "text": "Soleil intense"
    },
    {
      "index": 139,
      "id": "BTR_STATE_69_02",
      "hash": "28e4a6d843d2f6e6",
      "flags": 4,
      "text": "Un soleil intense brille dans le ciel. La puissance\\ndes capacités de type Feu augmente et les\\ncapacités de type Eau deviennent inefficaces."
    },
    {
      "index": 140,
      "id": "BTR_STATE_70_01",
      "hash": "cc2c4a4893958499",
      "flags": 0,
      "text": "Pluie battante"
    },
    {
      "index": 141,
      "id": "BTR_STATE_70_02",
      "hash": "cc2c474893957f80",
      "flags": 4,
      "text": "Une pluie battante s’abat. La puissance\\ndes capacités de type Eau augmente et les\\ncapacités de type Feu deviennent inefficaces."
    },
    {
      "index": 142,
      "id": "BTR_STATE_71_01",
      "hash": "f7175e3d4a89c8c4",
      "flags": 0,
      "text": "Vent mystérieux"
    },
    {
      "index": 143,
      "id": "BTR_STATE_71_02",
      "hash": "f717613d4a89cddd",
      "flags": 4,
      "text": "Un vent mystérieux s’est levé. Il affaiblit les\\ncapacités super efficaces contre le type Vol."
    },
    {
      "index": 144,
      "id": "BTR_STATE_72_01",
      "hash": "a0b19635af200bbb",
      "flags": 0,
      "text": "Champ Psychique"
    },
    {
      "index": 145,
      "id": "BTR_STATE_72_02",
      "hash": "a0b19735af200d6e",
      "flags": 0,
      "text": "Pendant cinq tours, les Pokémon au sol sont\\nimmunisés aux capacités prioritaires.\\nLa puissance des capacités de type Psy\\nest augmentée."
    },
    {
      "index": 146,
      "id": "BTR_STATE_73_01",
      "hash": "72f78a2f4c445e26",
      "flags": 4,
      "text": "Exécu-Son"
    },
    {
      "index": 147,
      "id": "BTR_STATE_73_02",
      "hash": "72f7892f4c445c73",
      "flags": 0,
      "text": "La cible ne peut plus utiliser de capacités\\nsonores pendant deux tours."
    },
    {
      "index": 148,
      "id": "BTR_STATE_74_01",
      "hash": "c84162253d3853dd",
      "flags": 0,
      "text": "Voile Aurore"
    },
    {
      "index": 149,
      "id": "BTR_STATE_74_02",
      "hash": "c8415f253d384ec4",
      "flags": 0,
      "text": "La puissance des capacités physiques et\\nspéciales est divisée par deux pendant\\ncinq tours."
    },
    {
      "index": 150,
      "id": "BTR_STATE_75_01",
      "hash": "9c3a561edbce3ac8",
      "flags": 4,
      "text": "Affilage"
    },
    {
      "index": 151,
      "id": "BTR_STATE_75_02",
      "hash": "9c3a591edbce3fe1",
      "flags": 0,
      "text": "La capacité utilisée au tour suivant l’activation\\nd’Affilage inflige à coup sûr un coup critique."
    },
