    },
    {
      "index": 31,
      "id": "go_park_01_28",
      "hash": "d4fe6be3b2d48f89",
      "flags": 0,
      "text": "GO Park 18"
    },
    {
      "index": 32,
      "id": "go_park_01_29",
      "hash": "d4fe6ae3b2d48dd6",
      "flags": 0,
      "text": "GO Park 19"
    },
    {
      "index": 33,
      "id": "go_park_01_30",
      "hash": "d4faede3b2d18398",
      "flags": 0,
      "text": "GO Park 20"
    },
    {
      "index": 34,
      "id": "go_park_01_20",
      "hash": "d4fe73e3b2d49d21",
      "flags": 0,
      "text": "[VAR GOPARKLOCAL(0000)]"
    },
    {
      "index": 35,
      "id": "go_park_02_01",
      "hash": "a8fe76dd5170bc37",
      "flags": 0,
      "text": "[VAR NUM3(0000)]"
    },
    {
      "index": 36,
      "id": "go_park_03_01",
      "hash": "5152aad5b4f235c2",
      "flags": 0,
      "text": "× [VAR NUM4(0000,202F)]"
    },
    {
      "index": 37,
      "id": "go_park_10_01",
      "hash": "0cf80ee3f10e4692",
      "flags": 4,
      "text": "Annuler"
    },
    {
      "index": 38,
      "id": "go_park_10_02",
      "hash": "0cf80de3f10e44df",
      "flags": 0,
      "text": "Changer le nom du parc"
    },
    {
      "index": 39,
      "id": "go_park_10_03",
      "hash": "0cf80ce3f10e432c",
      "flags": 4,
      "text": "Informations"
    },
    {
      "index": 40,
      "id": "go_park_20_01",
      "hash": "8b27a758d40dea4f",
      "flags": 0,
      "text": "Sélectionnez un GO Park."
    },
    {
      "index": 41,
      "id": "go_park_20_02",
      "hash": "8b27a858d40dec02",
      "flags": 4,
      "text": "Où voulez-vous aller ?"
    },
    {
      "index": 42,
      "id": "go_park_20_03",
      "hash": "8b27a958d40dedb5",
      "flags": 4,
      "text": "Avec les Pokémon de quel parc voulez-vous jouer ?"
    },
    {
      "index": 43,
      "id": "go_park_20_04",
      "hash": "8b27a258d40de1d0",
      "flags": 0,
      "text": "Sélectionnez l’espèce avec laquelle vous voulez jouer."
    },
    {
      "index": 44,
      "id": "go_park_20_05",
      "hash": "8b27a358d40de383",
      "flags": 4,
      "text": "Ici : [VAR COLOR(0006)][VAR GOPARKLOCAL(0000)][VAR COLOR(0000)]"
    },
    {
      "index": 45,
      "id": "go_park_20_06",
      "hash": "8b27a458d40de536",
      "flags": 0,
      "text": "Que voulez-vous faire avec [VAR GOPARKPKM(0000)] ?"
    },
    {
      "index": 46,
      "id": "go_park_25_01",
      "hash": "8f31e36fa702e296",
      "flags": 0,
      "text": "[VAR GOPARKLOCAL(0000)]"
    },
    {
      "index": 47,
      "id": "go_park_25_02",
      "hash": "8f31e26fa702e0e3",
      "flags": 0,
      "text": "← → Changer de GO Park"
    },
    {
      "index": 48,
      "id": "go_park_30_01",
      "hash": "1aa10723e7fa36ec",
      "flags": 0,
      "text": "Le Pokémon a été envoyé dans le parc suivant :\\n[VAR GOPARKLOCAL(0000)]."
    },
    {
      "index": 49,
      "id": "go_park_40_01",
      "hash": "6e71df9790fa2fe9",
      "flags": 0,
      "text": "Voulez-vous réessayer ?"
    },
    {
      "index": 50,
      "id": "go_park_40_02",
      "hash": "6e71dc9790fa2ad0",
      "flags": 4,
      "text": "Oui"
    },
    {
      "index": 51,
      "id": "go_park_40_03",
      "hash": "6e71dd9790fa2c83",
      "flags": 0,
      "text": "Non"
    },
    {
      "index": 52,
      "id": "go_park_41_01",
      "hash": "16c5b38ff47b0654",
      "flags": 0,
      "text": "Vous avez mis le mini-jeu en pause.\\nQue voulez-vous faire ?"
    },
    {
      "index": 53,
      "id": "go_park_41_02",
      "hash": "16c5b68ff47b0b6d",
      "flags": 0,
      "text": "Reprendre"
    },
    {
      "index": 54,
      "id": "go_park_41_03",
      "hash": "16c5b58ff47b09ba",
      "flags": 0,
      "text": "Recommencer"
    },
    {
      "index": 55,
      "id": "go_park_41_04",
      "hash": "16c5b08ff47b013b",
      "flags": 0,
      "text": "Quitter la Zone de Jeu"
    },
    {
      "index": 56,
      "id": "go_park_45_01",
      "hash": "3ccc6b6dd7c07818",
      "flags": 0,
      "text": "Vous n’avez pas assez de spécimens de l’espèce\\nsélectionnée. Veuillez réunir 25 Pokémon de\\ncette espèce dans vos GO Parks et réessayer."
    },
    {
      "index": 57,
      "id": "go_park_45_02",
      "hash": "3ccc6e6dd7c07d31",
      "flags": 0,
      "text": "Pour jouer dans la Zone de Jeu, vous devez\\nréunir au moins 25 Pokémon de la même espèce\\ndans vos GO Parks."
    },
    {
      "index": 58,
      "id": "go_park_48_01",
      "hash": "0e636f55cacbd511",
      "flags": 0,
      "text": "Temps :"
    },
    {
      "index": 59,
      "id": "go_park_48_02",
      "hash": "0e636c55cacbcff8",
      "flags": 0,
      "text": "Record d’arrivées simultanées :"
    },
    {
      "index": 60,
      "id": "go_park_48_03",
      "hash": "0e636d55cacbd1ab",
      "flags": 0,
      "text": "[~ 60]"
    },
    {
      "index": 61,
      "id": "go_park_48_04",
      "hash": "0e637255cacbda2a",
      "flags": 0,
      "text": "Votre score :"
    },
    {
      "index": 62,
      "id": "go_park_49_01",
      "hash": "372e634a7ff17c7c",
      "flags": 0,
      "text": "[VAR NUM2(0000)]"
    },
    {
      "index": 63,
      "id": "go_park_50_02",
      "hash": "fb41428dbfc4c353",
      "flags": 0,
      "text": "[VAR NUM4(0000,202F)] points"
    },
    {
      "index": 64,
      "id": "go_park_50_03",
      "hash": "fb41418dbfc4c1a0",
      "flags": 0,
      "text": "Record des [VAR POKNAME(0000)] :"
    },
    {
      "index": 65,
      "id": "go_park_55_01",
      "hash": "a279077478cf9dbf",
      "flags": 0,
      "text": "Que voulez-vous faire ?\\nAppuyez sur le [VAR COLOR(0006)]bouton Y pour zoomer[VAR COLOR(0000)]."
    },
    {
      "index": 66,
      "id": "go_park_55_02",
      "hash": "a279087478cf9f72",
      "flags": 0,
      "text": "Sauvegarder"
    },
    {
      "index": 67,
      "id": "go_park_55_03",
      "hash": "a279097478cfa125",
      "flags": 0,
      "text": "Retourner à l’accueil"
    },
    {
      "index": 68,
      "id": "go_park_55_05",
      "hash": "a279037478cf96f3",
      "flags": 4,
      "text": "Informations"
    },
    {
      "index": 69,
      "id": "go_park_55_04",
      "hash": "a279027478cf9540",
      "flags": 0,
      "text": "Rien"
    },
    {
      "index": 70,
      "id": "go_park_55_06",
      "hash": "a279047478cf98a6",
      "flags": 0,
      "text": "Vous remportez [VAR NUM3(0001)] [VAR ITEM2(0000)] !"
    },
    {
      "index": 71,
      "id": "go_park_55_07",
      "hash": "a279057478cf9a59",
      "flags": 0,
      "text": "Vous rangez votre récompense dans\\n[VAR ARTFRA(0001)][VAR COLOR(0006)][VAR BAG(0001)][VAR COLOR(0000)]."
    },
    {
      "index": 72,
      "id": "go_park_55_10",
      "hash": "a27c8c7478d2b595",
      "flags": 0,
      "text": "Voulez-vous sauvegarder ?"
    },
    {
      "index": 73,
      "id": "go_park_55_11",
      "hash": "a27c8b7478d2b3e2",
      "flags": 0,
      "text": "Sauvegarde en cours...\\nNe pas éteindre la console."
    },
    {
      "index": 74,
      "id": "go_park_55_12",
      "hash": "a27c8a7478d2b22f",
      "flags": 0,
      "text": "Partie sauvegardée."
    },
    {
      "index": 75,
      "id": "go_park_55_13",
      "hash": "a27c897478d2b07c",
      "flags": 4,
      "text": "Échec de la sauvegarde."
    },
    {
      "index": 76,
      "id": "go_park_60_00",
      "hash": "248419f567544870",
      "flags": 0,
      "text": "[VAR GOPARKPKM(0000)]"
    },
    {
      "index": 77,
      "id": "go_park_60_01",
      "hash": "24841af567544a23",
      "flags": 0,
      "text": "PC : [VAR NUM5(0000,202F)]"
    },
    {
      "index": 78,
      "id": "go_park_60_02",
      "hash": "24841bf567544bd6",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]"
    },
    {
      "index": 79,
      "id": "go_park_60_03",
      "hash": "24841cf567544d89",
      "flags": 0,
      "text": "[VAR NUM3(0000)]/[VAR NUM3(0001)]"
    },
    {
      "index": 80,
      "id": "go_park_60_04",
      "hash": "24841df567544f3c",
      "flags": 0,
      "text": "Taille :"
    },
    {
      "index": 81,
      "id": "go_park_60_05",
      "hash": "24841ef5675450ef",
      "flags": 0,
      "text": "Poids :"
    },
    {
      "index": 82,
      "id": "go_park_60_06",
      "hash": "24841ff5675452a2",
      "flags": 0,
      "text": "[VAR NUM2(0000)],[VAR NUM2(0001)] m"
    },
    {
      "index": 83,
      "id": "go_park_60_07",
      "hash": "248420f567545455",
      "flags": 0,
      "text": "[VAR NUM3(0000)],[VAR NUM2(0001)] kg"
    },
    {
      "index": 84,
      "id": "go_park_60_08",
      "hash": "248421f567545608",
      "flags": 0,
      "text": "Dresseur d’Origine : [VAR PGOTRAINER(0000)]"
    },
    {
      "index": 85,
      "id": "go_park_60_09",
      "hash": "248422f5675457bb",
      "flags": 0,
      "text": "[VAR NUM2(0002)]/[VAR NUM2(0001)]/[VAR NUM4(0000,0000)]"
    },
    {
      "index": 86,
      "id": "go_park_60_10",
      "hash": "24879ff5675761f9",
      "flags": 0,
      "text": "L’attraper"
    },
    {
      "index": 87,
      "id": "go_park_60_11",
      "hash": "24879ef567576046",
      "flags": 0,
      "text": "L’envoyer ailleurs"
    },
    {
      "index": 88,
      "id": "go_park_70_01",
      "hash": "b46a7ac07b9d68a0",
      "flags": 0,
      "text": "[VAR NUM2(0000)]:[VAR NUM2(0001)].[VAR NUM2(0002)]"
    },
    {
      "index": 89,
      "id": "go_park_80_01",
      "hash": "82fa3762ec0872bd",
      "flags": 0,
      "text": "Si vous attrapez un Pokémon dans un GO Park,\\nses données seront modifiées par rapport\\nà quand il se trouvait dans Pokémon GO.\\nVoulez-vous continuer ?"
    },
    {
      "index": 90,
      "id": "go_park_90_01",
      "hash": "950ad72a53682d1a",
      "flags": 0,
      "text": " [VAR NUM3(0000)]"
    },
    {
      "index": 91,
      "id": "go_park_100_01",
      "hash": "3b2093cb115b62e2",
      "flags": 0,
      "text": "Guidez vos Pokémon jusqu’au portail !\\nBouton X : Menu   Bouton Y : Zoom"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_go_park_max",
