    {
      "index": 6,
      "id": "TOWNMAP_05_01",
      "hash": "537c053b87998f1d",
      "flags": 0,
      "text": "Destination : [VAR LOCATION(0000)].\\nVoulez-vous utiliser la TS Envol pour y aller ?"
    },
    {
      "index": 7,
      "id": "TOWNMAP_05_02",
      "hash": "537c023b87998a04",
      "flags": 4,
      "text": "Oui"
    },
    {
      "index": 8,
      "id": "TOWNMAP_05_03",
