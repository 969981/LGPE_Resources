    },
    {
      "index": 10,
      "id": "TOWNMAP_20_01",
      "hash": "9e9ac914d7a1ec8a",
      "flags": 0,
      "text": "Habitat [VAR VARFRA03(0000)][VAR POKNAME(0000)]"
    },
    {
      "index": 11,
      "id": "TOWNMAP_20_02",
      "hash": "9e9ac814d7a1ead7",
      "flags": 0,
      "text": "Zone inconnue"
    },
    {
      "index": 12,
      "id": "TM_GUIDE_01",
      "hash": "de793f7747865099",
      "flags": 4,
      "text": "Une petite route de campagne tranquille\\nà la végétation riche et au sol fertile."
    },
    {
      "index": 13,
      "id": "TM_GUIDE_02",
      "hash": "de793c7747864b80",
      "flags": 0,
      "text": "Les dénivelés se succèdent en cascades\\nsur cette route qui mène à la Forêt de Jade."
    },
    {
      "index": 14,
      "id": "TM_GUIDE_03",
      "hash": "de793d7747864d33",
      "flags": 4,
      "text": "Un chemin herbu qui est jonché de rochers\\ntombés de la montagne située à proximité."
    },
    {
      "index": 15,
      "id": "TM_GUIDE_04",
      "hash": "de794277478655b2",
      "flags": 4,
      "text": "Une côte qui descend du Mont Sélénite à Azuria\\net se révèle impossible à remonter une fois en bas."
    },
    {
      "index": 16,
      "id": "TM_GUIDE_05",
      "hash": "de79437747865765",
      "flags": 0,
      "text": "L’entrée du Souterrain est située\\nen bas de ce chemin fort incliné."
    },
    {
      "index": 17,
      "id": "TM_GUIDE_06",
      "hash": "de7940774786524c",
      "flags": 0,
      "text": "L’entrée du Souterrain se trouve sur cette voie\\nqui relie Carmin sur Mer et Safrania."
    },
    {
      "index": 18,
      "id": "TM_GUIDE_07",
      "hash": "de794177478653ff",
      "flags": 0,
      "text": "L’entrée du Souterrain qui mène à la Route 8\\nse trouve sur cette allée de longueur réduite."
    },
    {
      "index": 19,
      "id": "TM_GUIDE_08",
      "hash": "de79467747865c7e",
      "flags": 0,
      "text": "L’entrée du Souterrain qui mène à la Route 7\\nse trouve sur cette allée des plus discrètes."
    },
    {
      "index": 20,
      "id": "TM_GUIDE_09",
      "hash": "de79477747865e31",
      "flags": 4,
      "text": "Un chemin parsemé de dénivelés\\noù les enfants aiment s’amuser."
    },
    {
      "index": 21,
      "id": "TM_GUIDE_10",
      "hash": "de7cc4774789686f",
      "flags": 4,
      "text": "Au milieu de ce chemin bordé par un canal,\\nla Grotte Sombre se dévoile."
    },
    {
      "index": 22,
      "id": "TM_GUIDE_11",
      "hash": "de7cc377478966bc",
      "flags": 4,
      "text": "Une prairie appréciée des Dresseurs\\noù se trouve l’entrée de la Grotte Taupiqueur."
    },
    {
      "index": 23,
      "id": "TM_GUIDE_12",
      "hash": "de7cc67747896bd5",
      "flags": 0,
      "text": "Les Pêcheurs apprécient grandement l’ambiance\\nde ce lieu qu’ils nomment le « Pont du Silence »."
    },
    {
      "index": 24,
      "id": "TM_GUIDE_13",
      "hash": "de7cc57747896a22",
      "flags": 4,
      "text": "Un véritable labyrinthe s’étend\\nsur cette route au bord de l’océan."
    },
    {
      "index": 25,
      "id": "TM_GUIDE_14",
      "hash": "de7cc077478961a3",
      "flags": 4,
      "text": "En longeant les arbres qui bordent ce chemin,\\non peut respirer le bon air marin."
    },
    {
      "index": 26,
      "id": "TM_GUIDE_15",
      "hash": "de7cbf7747895ff0",
      "flags": 0,
      "text": "Cette longue et vaste prairie\\ns’étend à l’est de Parmanie."
    },
    {
      "index": 27,
      "id": "TM_GUIDE_16",
      "hash": "de7cc27747896509",
      "flags": 4,
      "text": "Un chemin au nord de la Piste Pokémon,\\nanimé par le passage de nombreuses personnes."
    },
    {
      "index": 28,
      "id": "TM_GUIDE_17",
      "hash": "de7cc17747896356",
      "flags": 0,
      "text": "La Piste Pokémon est chaudement recommandée\\npour une balade avec ses petits protégés."
    },
    {
      "index": 29,
      "id": "TM_GUIDE_18",
      "hash": "de7ccc7747897607",
      "flags": 4,
      "text": "Au sud de la Piste Pokémon,\\nc’est au combat que l’on s’adonne."
    },
    {
      "index": 30,
      "id": "TM_GUIDE_19",
      "hash": "de7ccb7747897454",
      "flags": 0,
      "text": "Les gens apprécient beaucoup cette plage\\noù l’on peut s’adonner à la nage."
    },
    {
      "index": 31,
      "id": "TM_GUIDE_20",
      "hash": "de72d27747812bb4",
      "flags": 4,
      "text": "Un bras de mer séparé d’est en ouest\\npar les Îles Écume qui s’y dressent."
    },
    {
      "index": 32,
      "id": "TM_GUIDE_21",
      "hash": "de72d37747812d67",
      "flags": 0,
      "text": "Ce chenal a vu sa température augmenter\\nsous l’influence du volcan en activité."
    },
    {
      "index": 33,
      "id": "TM_GUIDE_22",
      "hash": "de72d47747812f1a",
      "flags": 0,
      "text": "Quiconque foule le sol de cette route rectiligne\\npourra se mesurer à la Ligue, s’il en est digne."
    },
    {
      "index": 34,
      "id": "TM_GUIDE_23",
      "hash": "de72d577478130cd",
      "flags": 0,
      "text": "Seuls les Dresseurs qui ont beaucoup de poigne\\nauront la force d’arpenter ce sentier de montagne."
    },
    {
      "index": 35,
      "id": "TM_GUIDE_24",
      "hash": "de72ce77478124e8",
      "flags": 4,
      "text": "À la sortie de la ville d’Azuria, au nord,\\ns’étend ce lieu célèbre pour son pont en or."
    },
    {
      "index": 36,
      "id": "TM_GUIDE_25",
      "hash": "de72cf774781269b",
      "flags": 4,
      "text": "Un cap se trouve au bout de ce dédale\\nconstitué de parois végétales."
    },
    {
      "index": 37,
      "id": "TM_GUIDE_26",
      "hash": "de72d0774781284e",
      "flags": 4,
      "text": "Un Laboratoire Pokémon a établi son domicile\\ndans ce petit village des plus tranquilles."
    },
    {
      "index": 38,
      "id": "TM_GUIDE_27",
      "hash": "de72d17747812a01",
      "flags": 4,
      "text": "Une ville respectueuse de l’environnement\\njoliment fleurie toute l’année durant."
    },
    {
      "index": 39,
      "id": "TM_GUIDE_28",
      "hash": "de72ca7747811e1c",
      "flags": 0,
      "text": "Cette ville de pierre est établie au pied\\nd’une montagne recouverte de rochers."
    },
    {
      "index": 40,
      "id": "TM_GUIDE_29",
      "hash": "de72cb7747811fcf",
      "flags": 4,
      "text": "Une ville aquatique entourée de ruisseaux\\net qui abrite l’Arène du type Eau."
    },
    {
      "index": 41,
      "id": "TM_GUIDE_30",
      "hash": "de75d87747836bbd",
      "flags": 4,
      "text": "Une ville calme mais austère,\\naussi connue pour son cimetière."
    },
    {
      "index": 42,
      "id": "TM_GUIDE_31",
      "hash": "de75d77747836a0a",
      "flags": 4,
      "text": "Un port de renommée internationale\\noù les navires de croisière font escale."
    },
    {
      "index": 43,
      "id": "TM_GUIDE_32",
      "hash": "de75d67747836857",
      "flags": 4,
      "text": "Une ville peuplée d’habitants de tous âges,\\ndont le centre commercial est l’apanage."
    },
    {
      "index": 44,
      "id": "TM_GUIDE_33",
      "hash": "de75d577478366a4",
      "flags": 0,
      "text": "Humains comme Pokémon apprécient\\ncette ville et son Parc Safari."
    },
    {
      "index": 45,
      "id": "TM_GUIDE_34",
      "hash": "de75d477478364f1",
      "flags": 4,
      "text": "Une ville bâtie sur une île volcanique,\\noù gisent les ruines d’un manoir antique."
    },
    {
      "index": 46,
      "id": "TM_GUIDE_35",
      "hash": "de75d3774783633e",
      "flags": 0,
      "text": "C’est sur ce plateau vaste et dégagé\\nque la Ligue Pokémon a établi ses quartiers."
    },
    {
      "index": 47,
      "id": "TM_GUIDE_36",
      "hash": "de75d2774783618b",
      "flags": 0,
      "text": "Dans cette ville au cœur de la région de Kanto,\\nles gratte-ciels se dressent toujours plus hauts."
    },
    {
      "index": 48,
      "id": "TM_GUIDE_37",
      "hash": "de75d17747835fd8",
      "flags": 0,
      "text": "Dans cette vaste forêt, dense et sombre,\\nles Pokémon Insecte vivent en grand nombre."
    },
    {
      "index": 49,
      "id": "TM_GUIDE_38",
      "hash": "de75d07747835e25",
      "flags": 0,
      "text": "Les météorites tombent tels des projectiles\\nsur ce mont propice à la recherche de fossiles."
    },
    {
      "index": 50,
      "id": "TM_GUIDE_39",
      "hash": "de75cf7747835c72",
      "flags": 4,
      "text": "Une grotte naturelle, vaste et sombre ;\\nla lumière y est cruciale pour percer la pénombre."
    },
    {
      "index": 51,
      "id": "TM_GUIDE_40",
      "hash": "de6bc677477af8a2",
      "flags": 4,
      "text": "Un établissement rempli de vieilles machines,\\noù des Pokémon Électrik s’agglutinent."
    },
    {
      "index": 52,
      "id": "TM_GUIDE_41",
      "hash": "de6bc777477afa55",
      "flags": 4,
      "text": "Un raccourci entre Argenta et Carmin sur Mer\\ncreusé par des Taupiqueur volontaires."
    },
    {
      "index": 53,
      "id": "TM_GUIDE_42",
      "hash": "de6bc477477af53c",
      "flags": 0,
      "text": "Sous le sol de ces deux îlots adjacents\\nrègne un froid à vous glacer le sang."
    },
    {
      "index": 54,
      "id": "TM_GUIDE_43",
      "hash": "de6bc577477af6ef",
      "flags": 0,
      "text": "Gloire aux Dresseurs qui atteignent le sommet,\\nmais gare aux embûches semées sur le trajet."
    },
    {
      "index": 55,
      "id": "TM_PLACE_COMMON_01",
      "hash": "8435be3e473a535c",
      "flags": 0,
      "text": "Centre Pokémon"
    },
    {
