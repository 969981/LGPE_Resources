    {
      "index": 0,
      "id": "poke_get_01_00",
      "hash": "3a06eefb470cba20",
      "flags": 0,
      "text": "C’est un [VAR POKNAME(0000)] du GO Park !"
    },
    {
      "index": 1,
      "id": "poke_get_01_01",
      "hash": "3a06effb470cbbd3",
      "flags": 4,
      "text": "Un [VAR POKNAME(0000)] sauvage apparaît !"
    },
    {
      "index": 2,
      "id": "poke_get_01_02",
      "hash": "3a06f0fb470cbd86",
      "flags": 0,
      "text": "C’est le moment !\\nEssayez d’attraper [VAR ARTFRA(0000)][VAR POKNAME(0000)] sauvage !"
    },
    {
      "index": 3,
      "id": "poke_get_01_03",
      "hash": "3a06f1fb470cbf39",
      "flags": 0,
      "text": "C’est le moment !\\nEssayez d’attraper [VAR POKNAME(0000)] !"
    },
    {
      "index": 4,
      "id": "poke_get_01_04",
      "hash": "3a06f2fb470cc0ec",
      "flags": 0,
      "text": "Voulez-vous abandonner la capture\\nde ce Pokémon ?"
    },
    {
      "index": 5,
      "id": "poke_get_01_05",
      "hash": "3a06f3fb470cc29f",
      "flags": 0,
      "text": "Voulez-vous arrêter de lire les explications\\nsur le lancer de Poké Balls ?"
    },
    {
      "index": 6,
      "id": "poke_get_01_06",
      "hash": "3a06f4fb470cc452",
      "flags": 0,
      "text": "Vous ne pouvez pas transporter davantage de\\nPokémon ! Mieux vaut s’en aller pour le moment."
    },
    {
      "index": 7,
      "id": "poke_get_01_07",
      "hash": "3a06f5fb470cc605",
      "flags": 0,
      "text": "Vous n’avez plus de Poké Ball !\\nMieux vaut s’en aller pour le moment."
    },
    {
      "index": 8,
      "id": "poke_get_01_08",
      "hash": "3a06f6fb470cc7b8",
      "flags": 4,
      "text": "Oh, non !\\nLe Pokémon s’est libéré !"
    },
    {
      "index": 9,
      "id": "poke_get_01_09",
      "hash": "3a06f7fb470cc96b",
      "flags": 0,
      "text": "Raaah !\\nÇa y était presque !"
    },
    {
      "index": 10,
      "id": "poke_get_01_10",
      "hash": "3a0a74fb470fd3a9",
      "flags": 4,
      "text": "Aaaaah !\\nPresque !"
    },
    {
      "index": 11,
      "id": "poke_get_01_11",
      "hash": "3a0a73fb470fd1f6",
      "flags": 0,
      "text": "Mince !\\nÇa y était presque !"
    },
    {
      "index": 12,
      "id": "poke_get_01_12",
      "hash": "3a0a72fb470fd043",
      "flags": 4,
      "text": "Et hop !\\nVous avez attrapé [VAR POKNAME(0000)] !"
    },
    {
      "index": 13,
      "id": "poke_get_01_13",
      "hash": "3a0a71fb470fce90",
      "flags": 0,
      "text": "[VAR FRAITA][VAR DARTFRA(0000)][VAR POKNAME(0000)] prend la fuite !"
    },
    {
      "index": 14,
      "id": "poke_get_01_14",
      "hash": "3a0a78fb470fda75",
      "flags": 0,
      "text": "Vous prenez la fuite !"
    },
    {
      "index": 15,
      "id": "poke_get_01_15",
      "hash": "3a0a77fb470fd8c2",
      "flags": 4,
      "text": "Un[VAR GENDBR(00FF,0001)]e [VAR SUPPORT(0000)] accourt pour\\nvous aider !"
    },
    {
      "index": 16,
      "id": "poke_get_02_01",
      "hash": "660df801a876ce1c",
      "flags": 4,
      "text": "Oui"
    },
