    {
      "index": 52,
      "id": "poke_get_40_01",
      "hash": "f3d3d054a2eb0b0a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Chen :[VAR COLOR(0000)] Un [VAR POKNAME(0000)] !\\nIls sont vraiment rares, par ici !\\c\\nProfite donc de cette occasion pour t’entraîner\\nà la[VAR COLOR(0006)] capture de Pokémon[VAR COLOR(0000)] !\\c\\nPour l’attraper, lance une [VAR COLOR(0006)]Poké Ball[VAR COLOR(0000)] sur lui,\\net vise bien, surtout !"
    },
    {
      "index": 53,
      "id": "poke_get_40_02",
      "hash": "f3d3cf54a2eb0957",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Chen :[VAR COLOR(0000)] Tu as l’air d’avoir un peu de mal...\\c\\nTiens, prends ces Poké Balls supplémentaires\\net réessaie ! Courage, tu vas y arriver !"
    },
    {
      "index": 54,
      "id": "poke_get_50_01",
      "hash": "67046c5e742075ed",
      "flags": 0,
      "text": "Pointez le Joy-Con en direction de la Poké Ball\\naffichée à l’écran."
    },
    {
      "index": 55,
      "id": "poke_get_50_02",
      "hash": "6704695e742070d4",
      "flags": 0,
      "text": "Dans cette posture, sélectionnez l’option\\nLANCER en appuyant sur le bouton A."
    },
    {
      "index": 56,
      "id": "poke_get_50_03",
      "hash": "67046a5e74207287",
      "flags": 4,
      "text": "Imitez un mouvement de lancer avec le Joy-Con\\npour envoyer la Poké Ball."
    },
    {
      "index": 57,
      "id": "poke_get_50_04",
      "hash": "6704675e74206d6e",
      "flags": 0,
      "text": "Visez bien le cercle !"
    },
    {
      "index": 58,
      "id": "poke_get_50_05",
      "hash": "6704685e74206f21",
      "flags": 0,
      "text": "Faites attention à ce qui vous entoure lorsque\\nvous effectuez le mouvement !"
    },
    {
      "index": 59,
      "id": "poke_get_60_01",
      "hash": "d78b089360342284",
      "flags": 0,
      "text": "Tenez fermement la console à deux mains et\\nchoisissez LANCER en appuyant sur le bouton A."
    },
    {
      "index": 60,
      "id": "poke_get_60_02",
      "hash": "d78b0b936034279d",
      "flags": 4,
      "text": "Avant d’effectuer le lancer, vous pouvez déplacer\\nla console pour observer les alentours."
    },
    {
      "index": 61,
      "id": "poke_get_60_03",
      "hash": "d78b0a93603425ea",
      "flags": 4,
      "text": "Appuyez ensuite sur le bouton A pour lancer\\nla Poké Ball au centre de l’écran."
    },
    {
      "index": 62,
      "id": "poke_get_60_04",
      "hash": "d78b059360341d6b",
      "flags": 0,
      "text": "Visez bien le cercle !"
    },
    {
      "index": 63,
      "id": "poke_get_60_05",
      "hash": "d78b049360341bb8",
      "flags": 0,
      "text": "Si vous avez besoin de ramener la caméra à\\nsa position initiale, appuyez sur le bouton B."
    },
    {
      "index": 64,
      "id": "poke_get_70_01",
      "hash": "1d1727bc4a7b69a7",
      "flags": 0,
      "text": "Le mode d’utilisation a changé.\\nRetour au début des explications."
    },
    {
      "index": 65,
      "id": "poke_get_80_01",
      "hash": "b4ecb8880ddd1d76",
      "flags": 0,
      "text": "Le mode d’utilisation a changé.\\nVoulez-vous lire les explications ?"
    },
    {
      "index": 66,
      "id": "poke_get_80_02",
      "hash": "b4ecb7880ddd1bc3",
      "flags": 0,
      "text": "Voulez-vous lire les explications sur le lancer\\nde Poké Balls ?"
    },
    {
      "index": 67,
      "id": "poke_get_80_03",
      "hash": "b4ecb6880ddd1a10",
      "flags": 0,
      "text": "Pour utiliser une Baie, sélectionnez-en une dans\\nvotre Sac !"
    },
    {
      "index": 68,
      "id": "poke_get_80_04",
      "hash": "b4ecbd880ddd25f5",
      "flags": 0,
      "text": "Visez l’intérieur du cercle mobile pour maximiser\\nvos chances d’effectuer un beau lancer !"
    },
    {
      "index": 69,
      "id": "poke_get_80_05",
      "hash": "b4ecbc880ddd2442",
      "flags": 0,
      "text": "Visez le moment où le cercle rétrécit pour\\neffectuer un meilleur lancer !"
    }
  ],
