{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_opening_doctor_01",
      "hash": "c326c6574dd89d45",
      "flags": 0,
      "text": "Bien le bonjour ! Bienvenue dans le monde\\nincroyable des Pokémon !\\c\\nMon nom est Chen, mais les gens m’appellent\\namicalement le Professeur Pokémon !"
    },
    {
      "index": 1,
      "id": "msg_ookido_01_p02_1_opening_00",
      "hash": "18c364aa4db1cb39",
      "flags": 0,
      "text": "[~ 1]"
    },
    {
      "index": 2,
      "id": "msg_opening_doctor_02",
      "hash": "c326c3574dd8982c",
      "flags": 0,
      "text": "Ce monde est peuplé de créatures appelées\\nPokémon !"
    },
    {
      "index": 3,
      "id": "msg_opening_doctor_03",
      "hash": "c326c4574dd899df",
      "flags": 4,
      "text": "Et ces Pokémon, vois-tu...\\nCertains adorent les chouchouter..."
    },
    {
      "index": 4,
      "id": "msg_opening_doctor_12",
      "hash": "c32a4d574ddbb881",
      "flags": 0,
      "text": "Tandis que d’autres préfèrent les mener\\nau combat."
    },
    {
      "index": 5,
      "id": "msg_opening_doctor_13",
      "hash": "c32a4c574ddbb6ce",
      "flags": 0,
      "text": "Pour ma part..."
    },
    {
      "index": 6,
      "id": "msg_opening_doctor_14",
      "hash": "c32a4f574ddbbbe7",
      "flags": 0,
      "text": "J’ai fait de l’étude des Pokémon ma profession."
    },
    {
      "index": 7,
      "id": "msg_opening_doctor_04",
      "hash": "c326c1574dd894c6",
      "flags": 0,
      "text": "Mais assez parlé de moi. Dis-m’en un peu plus\\nsur toi !"
    },
    {
      "index": 8,
      "id": "msg_opening_doctor_05",
      "hash": "c326c2574dd89679",
      "flags": 4,
      "text": "À quoi ressembles-tu ?"
    },
    {
      "index": 9,
      "id": "msg_opening_doctor_06",
      "hash": "c326bf574dd89160",
      "flags": 4,
      "text": "Et comment t’appelles-tu ?\\c"
    },
    {
      "index": 10,
      "id": "msg_ookido_01_p04_2_opening_00",
      "hash": "128f8ef93299e040",
      "flags": 0,
      "text": "[~ 10]"
    },
    {
      "index": 11,
      "id": "msg_opening_doctor_07",
      "hash": "c326c0574dd89313",
      "flags": 0,
      "text": "Je vois ! Tu t’appelles [VAR TRNAME(0000)] !"
    },
    {
      "index": 12,
      "id": "msg_opening_doctor_08",
      "hash": "c326cd574dd8a92a",
      "flags": 4,
      "text": "Ah, et ce garçon !\\c\\nVous êtes amis et rivaux depuis votre plus tendre\\nenfance, n’est-ce pas ?\\c\\nIl s’appelle... Euh..."
    },
    {
      "index": 13,
      "id": "msg_ookido_01_p06_1_opening_00",
      "hash": "e742d0562f688675",
      "flags": 0,
      "text": "Comment s’appelle-t-il, déjà ?\\c"
    },
    {
      "index": 14,
      "id": "msg_opening_doctor_09",
      "hash": "c326ce574dd8aadd",
      "flags": 0,
      "text": "[VAR TRNAME(0001)], tu dis ?"
    },
    {
      "index": 15,
      "id": "msg_opening_doctor_10",
      "hash": "c32a4b574ddbb51b",
      "flags": 0,
      "text": "Mais oui, c’est bien [VAR TRNAME(0001)] !"
    },
    {
      "index": 16,
      "id": "msg_opening_doctor_11",
      "hash": "c32a4a574ddbb368",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] !"
    },
    {
      "index": 17,
      "id": "msg_opening_doctor_15",
      "hash": "c32a4e574ddbba34",
      "flags": 0,
      "text": "Ta quête des Pokémon est sur le point\\nde commencer !"
    },
    {
      "index": 18,
      "id": "msg_opening_doctor_16",
      "hash": "c32a51574ddbbf4d",
      "flags": 4,
      "text": "Un tout nouveau monde de rêves, d’aventures\\net de Pokémon t’attend !"
    },
    {
      "index": 19,
      "id": "msg_opening_doctor_17",
      "hash": "c32a50574ddbbd9a",
      "flags": 0,
      "text": "Bonne chance !"
    },
    {
      "index": 20,
      "id": "msg_opening_doctor_yes",
      "hash": "ec11fd5aad6f974d",
      "flags": 4,
      "text": "Oui"
    },
    {
      "index": 21,
      "id": "msg_opening_doctor_no",
      "hash": "c3ebf8574e8039f1",
      "flags": 0,
      "text": "Non"
    },
    {
