{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "fe_amai_msg00",
      "hash": "7a6591e7fa5270a7",
      "flags": 4,
      "text": "On dirait qu’il n’y a rien d’intéressant ici..."
    },
    {
      "index": 1,
      "id": "msg_kagu1_bg",
      "hash": "cdf3b18078b3f908",
      "flags": 4,
      "text": "En voilà de la vaisselle bien rangée !"
    },
    {
      "index": 2,
      "id": "msg_kagu2_bg",
      "hash": "a0b3a17a163fa0e3",
      "flags": 0,
      "text": "Quelqu’un a cuisiné ici, ça sent vraiment bon !"
    },
    {
      "index": 3,
      "id": "msg_kagu3_bg",
      "hash": "c9eb816ecbc1f832",
      "flags": 0,
      "text": "C’est une belle commode. On peut y ranger\\nplein de choses !"
    },
    {
      "index": 4,
      "id": "msg_kagu4_bg",
      "hash": "730c41672ff1c605",
      "flags": 4,
      "text": "Il y a un tas de nourriture, ici !"
    },
    {
      "index": 5,
      "id": "msg_kagu5_bg",
      "hash": "49245160d0548fe4",
      "flags": 0,
      "text": "C’est une belle image d’un Pokémon.\\nIl a l’air heureux !"
    },
    {
      "index": 6,
      "id": "msg_kagu6_bg",
      "hash": "9b158156be707c7f",
      "flags": 4,
      "text": "À quoi ça peut bien servir ? Mieux vaut\\nne pas y toucher !"
    },
    {
      "index": 7,
      "id": "msg_kagu7_bg",
      "hash": "712e91505ed4f95e",
      "flags": 0,
      "text": "C’est un téléphone. Mieux vaut ne pas l’utiliser !"
    },
    {
      "index": 8,
      "id": "msg_kagu8_bg",
      "hash": "03f0b1cd88a71721",
      "flags": 0,
      "text": "C’est une publicité pour plein de produits !"
    },
    {
      "index": 9,
      "id": "msg_kagu9_bg",
      "hash": "2d2881c23e295340",
      "flags": 0,
      "text": "Mmm, quelle bonne odeur.\\nÇa donne vraiment faim !"
    },
    {
      "index": 10,
      "id": "msg_kagu10_bg",
      "hash": "2900f7fa1e970ca4",
      "flags": 4,
      "text": "Alors...\\nLà-dedans...\\c\\nIl n’y a... absolument rien."
    },
    {
      "index": 11,
      "id": "msg_kagu11_bg",
      "hash": "ffc8e805691463c5",
      "flags": 0,
      "text": "C’est une tasse avec une marque de Pokémon !"
    },
    {
      "index": 12,
      "id": "msg_kagu12_bg",
      "hash": "510b37e9ad17761e",
      "flags": 0,
      "text": "La fenêtre est super propre !"
    },
    {
      "index": 13,
      "id": "msg_kagu13_bg",
      "hash": "27d327f4f794cd3f",
      "flags": 0,
      "text": "Dehors...\\c\\nIl fait un temps magnifique !"
    },
    {
      "index": 14,
      "id": "msg_kagu14_bg",
      "hash": "574a581eaef36dc8",
      "flags": 4,
      "text": "Il y a plein de petites lampes colorées\\nqui clignotent."
    },
    {
      "index": 15,
      "id": "msg_kagu15_bg",
      "hash": "59600823d6bb57e9",
      "flags": 0,
      "text": "Toutes sortes d’outils sont rangés ici."
    },
    {
      "index": 16,
      "id": "msg_bouenkyou_01_p01_r011_r0102",
      "hash": "11249d7b557c7c93",
      "flags": 0,
      "text": "Vous regardez dans les jumelles...\\c\\nUn énorme Pokémon dort sur la route !"
    },
    {
      "index": 17,
      "id": "msg_bouenkyou_01_p02_r011_r0102",
      "hash": "d0e85fd19bb0169c",
      "flags": 0,
      "text": "Vous regardez dans les jumelles...\\c\\nQuelle vue magnifique ! Bon, on y va ?"
    },
    {
      "index": 18,
      "id": "msg_bouenkyou_02_p01_r011_r0102",
      "hash": "33193af75a560fb0",
      "flags": 0,
      "text": "Vous regardez dans les jumelles...\\c\\nPour aller à Lavanville depuis Azuria, traverser\\nla Grotte Sombre semble être idéal !"
    },
    {
      "index": 19,
      "id": "msg_bouenkyou_01_p01_r012_r0102",
      "hash": "2a2fd25bba926a22",
      "flags": 0,
      "text": "Vous regardez dans les jumelles...\\c\\nVous voyez un pêcheur !"
    },
    {
      "index": 20,
      "id": "msg_bouenkyou_02_p01_r012_r0102",
      "hash": "1447c575cf496bf5",
      "flags": 0,
      "text": "Vous regardez dans les jumelles...\\c\\nC’est la Tour Pokémon !"
    },
    {
      "index": 21,
      "id": "msg_bouenkyou_01_p01_r015_r0102",
      "hash": "d7f7e45d55f7429f",
      "flags": 0,
      "text": "Vous regardez dans les jumelles...\\c\\nUn immense Pokémon oiseau scintillant vole\\nvers la mer."
    },
    {
      "index": 22,
      "id": "msg_bouenkyou_02_p01_r015_r0102",
      "hash": "98836cfee336ff7c",
      "flags": 0,
      "text": "Vous regardez dans les jumelles...\\c\\nVous voyez une petite île à l’horizon !"
    },
    {
      "index": 23,
      "id": "msg_bouenkyou_01_p01_r016_r0202",
      "hash": "cea1afb32e7dc323",
      "flags": 0,
      "text": "Vous regardez dans les jumelles...\\c\\nVous voyez le centre commercial de Céladopole."
    },
    {
      "index": 24,
      "id": "msg_bouenkyou_02_p01_r016_r0202",
      "hash": "e85828a3f4702cc0",
      "flags": 0,
      "text": "Vous regardez dans les jumelles...\\c\\nVous voyez un grand ponton !"
    },
    {
      "index": 25,
      "id": "msg_bouenkyou_01_p01_r018_r0102",
      "hash": "f4dd8c32d544ae70",
      "flags": 0,
      "text": "Vous regardez dans les jumelles...\\c\\nBourg Palette est à l’ouest !"
    },
    {
      "index": 26,
      "id": "msg_bouenkyou_02_p01_r018_r0102",
      "hash": "4f604c3fda8dddd3",
      "flags": 0,
      "text": "Vous regardez dans les jumelles...\\c\\nVous voyez plein de nageurs !"
    },
    {
      "index": 27,
      "id": "msg_sylph_door_01",
      "hash": "c36b343ea1a7c0f8",
      "flags": 0,
      "text": "Bingo !\\nLa Carte Magnétique a ouvert la porte !"
    },
    {
      "index": 28,
      "id": "msg_sylph_door_02",
      "hash": "c36b373ea1a7c611",
      "flags": 0,
      "text": "Zut !\\nIl faut une Carte Magnétique !"
    },
    {
      "index": 29,
      "id": "msg_book_01_bg",
      "hash": "7bb6486bae7c5172",
      "flags": 4,
      "text": "Il y a plein de bouquins sur les Pokémon !"
    },
    {
      "index": 30,
      "id": "msg_townmap_01_bg",
      "hash": "0de10cb9a0a3d80b",
      "flags": 0,
      "text": "Ceci est une Carte."
    },
    {
      "index": 31,
      "id": "msg_fsrack_01_bg",
      "hash": "6c92a1bfb5eb3e83",
      "flags": 0,
      "text": "Cool ! Plein de trucs Pokémon !"
    },
    {
      "index": 32,
      "id": "msg_fs_01_bg",
      "hash": "1df07aa8257f8e68",
      "flags": 0,
      "text": "Boutique Pokémon\\n« Faites le plein d’objets ! »"
    },
    {
      "index": 33,
      "id": "msg_pc_01_bg",
      "hash": "dfee76fbce4be542",
      "flags": 0,
      "text": "Centre Pokémon\\n« Soignez vos Pokémon ! »"
    },
    {
      "index": 34,
      "id": "msg_freeze_01_bg",
      "hash": "8e164c7fbea26a00",
      "flags": 4,
      "text": "Il doit y avoir plein de bonnes choses à manger !"
    },
    {
      "index": 35,
      "id": "msg_sekkeizu_01_bg",
      "hash": "fa393e9b9200f706",
      "flags": 0,
      "text": "C’est une sorte de plan. Il y a plein de notes\\net de diagrammes gribouillés dessus."
    },
    {
      "index": 36,
      "id": "msg_pc_02_bg",
      "hash": "37629715141fdcf9",
      "flags": 0,
      "text": "C’est rempli de mots et de chiffres\\nincompréhensibles..."
    },
    {
      "index": 37,
      "id": "msg_masaki_01_bg",
      "hash": "93d2d7a15f3e81dd",
      "flags": 0,
      "text": "C’est une sorte de machine.\\nElle est vraiment impressionnante !"
    },
    {
      "index": 38,
      "id": "msg_game_01_bg",
      "hash": "5cb767c46e41f135",
      "flags": 0,
      "text": "Le dernier jeu vidéo qui vient de sortir.\\nÇa a l’air génial !"
    },
    {
      "index": 39,
      "id": "msg_dorobou_01_bg",
      "hash": "a07f7a27a1a4b8e9",
      "flags": 4,
      "text": "Il y a des signes d’effraction, ici..."
    },
    {
      "index": 40,
      "id": "msg_tv_01_bg",
      "hash": "bb6a7c7d0b1fc1b5",
      "flags": 4,
      "text": "Une émission avec des Pokémon.\\nÇa a l’air cool !"
    },
    {
      "index": 41,
      "id": "msg_tv_02_bg",
      "hash": "8ca18c64fdd8eb8e",
      "flags": 0,
      "text": "Votre visage se reflète sur l’écran !"
    },
    {
      "index": 42,
      "id": "msg_t007r0805_elevator_01",
      "hash": "6b7cd65aaddff314",
      "flags": 4,
      "text": "Il faut une clé."
    },
    {
      "index": 43,
      "id": "msg_main_event_1100_switch_01",
      "hash": "ccd6e3039bca99fd",
      "flags": 0,
      "text": "Vous appuyez sur un bouton secret !"
    },
    {
      "index": 44,
      "id": "msg_main_event_1100_switch_04",
      "hash": "ccd6de039bca917e",
      "flags": 0,
      "text": "Vous entendez du bruit ! Quelque chose dans\\nles environs vient de bouger !"
    },
    {
      "index": 45,
      "id": "msg_main_event_1100_switch_02",
      "hash": "ccd6e0039bca94e4",
      "flags": 0,
      "text": "[~ 45]"
    },
    {
      "index": 46,
      "id": "msg_main_event_1100_switch_03",
      "hash": "ccd6e1039bca9697",
      "flags": 0,
      "text": "[~ 46]"
    },
    {
      "index": 47,
      "id": "msg_shop_bg_01",
      "hash": "3682ef731ccc848b",
      "flags": 4,
      "text": "Il y a des Potions et des Repousses !"
    },
    {
      "index": 48,
      "id": "msg_shop_bg_02",
      "hash": "3682f0731ccc863e",
      "flags": 4,
      "text": "Il y a tellement de produits, ici ! Ça doit valoir\\nle coup d’en acheter auprès du vendeur !"
    },
    {
      "index": 49,
      "id": "msg_kanban_bg_01",
      "hash": "ff617b40a90b04f0",
      "flags": 0,
      "text": "Difficile de lire le panneau quand on est\\ndu mauvais côté..."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_bg_event_max",
      "hash": "f825892cbb5f8bbe"
    }
  ]
}
