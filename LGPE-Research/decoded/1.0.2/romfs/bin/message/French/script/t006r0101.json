{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t006r0101_fat_01_01",
      "hash": "16a1c4266049649d",
      "flags": 0,
      "text": "Mon Pikachu est le plus beau de tous\\nles Pikachu !"
    },
    {
      "index": 1,
      "id": "msg_t006r0101_fat_01_02",
      "hash": "16a1c12660495f84",
      "flags": 0,
      "text": "Mouais !\\c\\nMon Pikachu est deux fois plus mignon que\\ncelui-là !"
    },
    {
      "index": 2,
      "id": "msg_t006r0101_youngf_01_01",
      "hash": "0ee506a6250d159c",
      "flags": 0,
      "text": "Mon Otaria est vraiment trop mignon !\\nIl fait « squitch » quand je lui fais un câlin !"
    },
    {
      "index": 3,
      "id": "msg_t006r0101_youngf_01_02",
      "hash": "0ee509a6250d1ab5",
      "flags": 0,
      "text": "Fufufu !\\c\\nMon Otaria est deux fois plus élégant !"
    },
    {
      "index": 4,
      "id": "msg_t006r0101_poke_01",
      "hash": "92f57942219c9e77",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Pikachu :[VAR COLOR(0000)] Pikachu !"
    },
    {
      "index": 5,
      "id": "msg_t006r0101_poke_02",
      "hash": "92f57a42219ca02a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Otaria :[VAR COLOR(0000)] Riaaa !"
    },
    {
      "index": 6,
      "id": "msg_t006r0101_stafff_01",
      "hash": "eeb3cbaafce30758",
      "flags": 0,
      "text": "Quand notre président commence à parler\\nde Pokémon, on ne l’arrête plus !"
    },
    {
      "index": 7,
      "id": "msg_t006r0101_poster_01",
      "hash": "26d385ca9600a6a3",
      "flags": 0,
      "text": "« Prêtons une oreille attentive,\\nAux vantards à la dérive... »"
    },
    {
      "index": 8,
      "id": "msg_t006r0101_poster_02",
      "hash": "26d386ca9600a856",
      "flags": 0,
      "text": "« Devant toute vantardise,\\nIl faut doubler la mise ! »"
    },
    {
      "index": 9,
      "id": "msg_t006r0101_poster_03",
      "hash": "26d387ca9600aa09",
      "flags": 0,
      "text": "« Mon Galopa, une beauté qui désarçonne »"
    },
    {
      "index": 10,
      "id": "msg_t006r0101_poster_04",
      "hash": "26d388ca9600abbc",
      "flags": 0,
      "text": "« Mon Rapasdepic qui pique mon cœur »"
    },
    {
      "index": 11,
      "id": "msg_t006r0101_poster_05",
      "hash": "26d389ca9600ad6f",
      "flags": 0,
      "text": "« Mes amours de Pokémon et moi »"
    },
    {
      "index": 12,
      "id": "msg_t006r0101_poster_06",
      "hash": "26d38aca9600af22",
      "flags": 0,
      "text": "« Mes Pokémon et moi :\\nJournal d’une amitié sans borne »"
    },
    {
      "index": 13,
      "id": "msg_workerw1_01_p02_t006_r0201",
      "hash": "5cc7fb3c2e424c3b",
