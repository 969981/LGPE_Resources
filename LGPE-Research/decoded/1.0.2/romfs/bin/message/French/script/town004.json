{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_town004_kanban_01",
      "hash": "b51317a8f3060e71",
      "flags": 4,
      "text": "Azuria\\n« Baignée d’une aura d’un bleu mystérieux »"
    },
    {
      "index": 1,
      "id": "msg_town004_kanban_02",
      "hash": "b51314a8f3060958",
      "flags": 4,
      "text": "Astuce !\\c\\nIl est possible d’interrompre une évolution\\nen appuyant sur le bouton B."
    },
    {
      "index": 2,
      "id": "msg_town004_kanban_03",
      "hash": "b51315a8f3060b0b",
      "flags": 0,
      "text": "Maison du Fan de Vélo"
    },
    {
      "index": 3,
      "id": "msg_town004_kanban_04",
      "hash": "b5131aa8f306138a",
      "flags": 4,
      "text": "Arène Pokémon d’Azuria\\c\\nChampionne : Ondine\\nLa sirène en short !"
    },
    {
      "index": 4,
      "id": "msg_town004_adultm_01",
      "hash": "974467edc6eb5151",
      "flags": 0,
      "text": "T’es un[VAR GENDBR(00FF,0B09)] Dresseure Dresseuse aussi ?\\c\\nCapturer... Collectionner... Combattre...\\nC’est dur, hein ?"
    },
    {
      "index": 5,
      "id": "msg_town004_youngm_01_01",
      "hash": "39c978ef1accc119",
      "flags": 0,
      "text": "L’arbuste en face de la Boutique Pokémon\\nbloque le passage vers le sud de la ville !\\c\\nMais il paraît qu’il y a un autre chemin..."
    },
    {
      "index": 6,
      "id": "msg_boya1_01_p02_field_t004",
      "hash": "6dbca59f00f65f78",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_town004_middlem_01",
      "hash": "3a702dc61ba863a4",
      "flags": 0,
      "text": "Tu remplis un index sur les Pokémon ? Pas mal."
    },
    {
      "index": 8,
      "id": "msg_town004_policef_01",
      "hash": "eedfa2d161c67198",
      "flags": 0,
      "text": "Cette maison a été cambriolée.\\c\\nD’après les témoins, ce serait encore un coup\\nde la Team Rocket.\\c\\nLes pauvres gens qui vivent ici sont encore tout\\nsecoués, alors je surveille leur maison pour les\\r\\nrassurer. Je ne peux laisser entrer personne !"
    },
    {
      "index": 9,
      "id": "msg_town004_youngf_01_01",
      "hash": "89c3f2c67ed7bf0c",
      "flags": 4,
      "text": "Allez ! Électrode !\\nSonicboom ! Sonicboom !\\c\\nTe mets pas en boule et écoute donc c’que j’te dis !"
    },
    {
      "index": 10,
      "id": "msg_town004_youngf_01_02",
      "hash": "89c3f5c67ed7c425",
      "flags": 4,
      "text": "Électrode ! C’est le moment ! Charge !\\n... Pfff, encore raté !"
    },
    {
      "index": 11,
      "id": "msg_town004_youngf_01_03",
      "hash": "89c3f4c67ed7c272",
      "flags": 4,
      "text": "Électrode ! Météores !\\nM-mais naaan, pas cette capacité, l’autre !!!\\r\\nAh là là, c’est compliqué, les combats !\\c\\nFaut croire que les Pokémon n’écoutent que\\nles Dresseurs qui sont à leur niveau..."
    },
    {
      "index": 12,
      "id": "msg_town004_poke_01_01",
      "hash": "bbf3f6e0c799a43b",
      "flags": 4,
      "text": "Électrode pionce comme une masse."
    },
    {
      "index": 13,
      "id": "msg_town004_poke_01_02",
      "hash": "bbf3f7e0c799a5ee",
      "flags": 4,
      "text": "Électrode rêvasse..."
    },
    {
      "index": 14,
      "id": "msg_town004_poke_01_03",
      "hash": "bbf3f8e0c799a7a1",
      "flags": 4,
      "text": "Électrode regarde ailleurs..."
    },
    {
      "index": 15,
      "id": "msg_town004_poke_01_04",
      "hash": "bbf3f9e0c799a954",
      "flags": 4,
      "text": "Électrode ignore les ordres..."
    },
    {
      "index": 16,
      "id": "msg_town004_childf_01",
      "hash": "0333cfa13f0b2060",
      "flags": 0,
      "text": "Le monsieur qui vit dans cette maison\\ncollectionne des vélos du monde entier !"
    },
    {
      "index": 17,
      "id": "msg_trainerm1_01_p01_field_t004",
      "hash": "424b20fd31d344f4",
      "flags": 0,
      "text": "Des Pokémon trop puissants vivent ici,\\ndans la Caverne Azurée !\\c\\nSeuls ceux qui ont remporté la victoire à la Ligue\\nPokémon peuvent s’y aventurer !"
    },
    {
      "index": 18,
      "id": "msg_town004_fat_01",
      "hash": "9b47f4cb990902d1",
      "flags": 0,
      "text": "[~ 18]"
    },
    {
      "index": 19,
      "id": "msg_town004_poke_02_01",
      "hash": "1259bee863036144",
      "flags": 0,
      "text": "[~ 19]"
    },
    {
      "index": 20,
      "id": "msg_town004_miniskirt_01",
