      "hash": "31286df728b1b018",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Blue :[VAR COLOR(0000)] [VAR TRNAME(0000)] !\\nOn commence par toi ?"
    },
    {
      "index": 5,
      "id": "msg_main0905_green_02",
      "hash": "312870f728b1b531",
      "flags": 0,
      "text": "Ça me va !"
    },
    {
      "index": 6,
      "id": "msg_main0905_dummy_02",
      "hash": "3ce78b6f47fb37f4",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main0905_green_03",
      "hash": "31286ff728b1b37e",
      "flags": 0,
      "text": "Comme tu veux."
    },
    {
      "index": 8,
      "id": "msg_main0905_green_04",
      "hash": "312872f728b1b897",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Blue : [VAR COLOR(0000)]Joliii...\\c\\nT’as largement le niveau pour affronter\\nla Team Rocket. Je te laisse nettoyer la Sylphe !"
    },
    {
      "index": 9,
      "id": "msg_main0905_red_03",
      "hash": "cf2dde7ee5ed07ce",
