{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub042_middle_m_01",
      "hash": "624c5dd4ac5b40cd",
      "flags": 0,
      "text": "Ho ho, tu as une belle collection de Poké Balls,\\ndis. C’est bien !\\c\\nTu devrais revenir me voir si ton stock commence\\nà s’épuiser !"
    },
    {
      "index": 1,
      "id": "msg_sub042_middle_m_02",
      "hash": "624c5ad4ac5b3bb4",
      "flags": 0,
      "text": "Bah, il te faut une réserve de Poké Balls, enfin !"
    },
    {
      "index": 2,
      "id": "msg_sub042_middle_m_03",
      "hash": "624c5bd4ac5b3d67",
      "flags": 4,
      "text": "Oh là là, ça ne va pas du tout ! On ne t’a jamais\\ndit que l’avenir appartenait à ceux qui font le\\r\\nplein de Poké Balls ? Qu’est-ce que tu vas faire\\r\\nsi tu te retrouves à sec pile quand tu tombes\\r\\nnez à nez avec un Pokémon exceptionnel, hein ?!\\c\\nHeureusement, j’ai de quoi te dépanner !\\nAllez, tiens, c’est cadeau !"
    },
    {
      "index": 3,
      "id": "msg_sub042_system_01",
      "hash": "2b4199a2669e88c5",
      "flags": 0,
      "text": "Le monsieur vous donne [VAR NUM2(0002)] Poké Balls."
    },
    {
      "index": 4,
      "id": "msg_sub042_middle_m_04",
      "hash": "624c58d4ac5b384e",
      "flags": 0,
      "text": "Ho ho ! J’espère que tu penseras à moi et\\nà la petite leçon de vie que je viens de te donner\\r\\nla prochaine fois que tu attraperas un Pokémon !"
    },
    {
      "index": 5,
      "id": "msg_sub042_sailor_01",
