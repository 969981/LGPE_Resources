{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8010_water_01",
      "hash": "eb0270625db7e4cb",
      "flags": 0,
      "text": "Salut, toi !"
    },
    {
      "index": 1,
      "id": "msg_main8010_water_05",
      "hash": "eb0274625db7eb97",
      "flags": 0,
      "text": "Dis, c’est quoi ta tactique, pour les Pokémon ?"
    },
    {
      "index": 2,
      "id": "msg_main8010_water_06",
      "hash": "eb0275625db7ed4a",
      "flags": 0,
      "text": "La mienne est simple : attaquer encore et\\nencore avec des Pokémon Eau !"
    },
    {
      "index": 3,
      "id": "msg_main8010_water_07",
      "hash": "eb0276625db7eefd",
      "flags": 4,
      "text": "Allez, approche ! Laisse la belle Ondine te donner\\nune petite leçon particulière !"
    },
    {
      "index": 4,
      "id": "msg_main8010_water_08",
      "hash": "eb0267625db7d580",
      "flags": 0,
      "text": "Mais je te préviens, tu risques de boire la tasse !"
    },
    {
      "index": 5,
      "id": "msg_gymleader_02_01",
      "hash": "727c3d2a1a30cc28",
      "flags": 0,
      "text": "[~ 5]"
    },
    {
      "index": 6,
      "id": "msg_gymleader_02_06",
      "hash": "727c442a1a30d80d",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main8010_water_02",
      "hash": "eb0271625db7e67e",
      "flags": 0,
      "text": "Bon, OK !\\c\\nTu m’as battue, donc c’est tout naturel que\\nje te remette le Badge Cascade !"
    },
    {
      "index": 8,
      "id": "msg_main8010_sys_01",
      "hash": "fa93f3e6a1687f4d",
      "flags": 0,
      "text": "Vous obtenez le [VAR COLOR(0006)]Badge Cascade[VAR COLOR(0000)] !"
    },
    {
      "index": 9,
      "id": "msg_main8010_water_03",
      "hash": "eb0272625db7e831",
      "flags": 0,
      "text": "Grâce au Badge Cascade, tu peux te faire obéir\\nau doigt et à l’œil par tous les Pokémon échangés\\r\\njusqu’au niveau 30 !\\c\\nTu gagnes aussi ma CT favorite !"
    },
    {
      "index": 10,
      "id": "msg_main8010_sys_02",
      "hash": "fa93f0e6a1687a34",
      "flags": 0,
      "text": "Vous obtenez la [VAR ITEM2(0001)] [VAR COLOR(0006)][VAR MOVE(0002)][VAR COLOR(0000)] !"
    },
    {
      "index": 11,
      "id": "msg_main8010_water_04",
      "hash": "eb0273625db7e9e4",
      "flags": 0,
      "text": "La CT29 contient Ébullition !\\nApprends-la à un Pokémon Eau ! Ou pas !"
    },
    {
      "index": 12,
      "id": "msg_gymleader_02_05",
      "hash": "727c412a1a30d2f4",
      "flags": 0,
      "text": "[~ 12]"
    },
    {
      "index": 13,
      "id": "msg_gymleader_02_02",
      "hash": "727c402a1a30d141",
      "flags": 0,
      "text": "[~ 13]"
    },
    {
