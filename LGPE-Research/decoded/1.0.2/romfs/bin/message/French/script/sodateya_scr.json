    },
    {
      "index": 68,
      "id": "msg_sodateya_girl_17",
      "hash": "59d4c8704e5ea247",
      "flags": 0,
      "text": "[~ 68]"
    },
    {
      "index": 69,
      "id": "msg_sodateya_girl_18",
      "hash": "59d4bd704e5e8f96",
      "flags": 0,
      "text": "[~ 69]"
    },
    {
      "index": 70,
      "id": "msg_sodateya001",
      "hash": "81b5057d801b3fa2",
      "flags": 0,
      "text": "Bonjour ! Je suis Mémé Limélo, la responsable\\nde la Pension. Que puis-je faire pour toi ?"
    },
    {
      "index": 71,
      "id": "msg_sodateya002",
      "hash": "81b5047d801b3def",
      "flags": 0,
      "text": "Je suis Mémé Limélo, la responsable de la\\nla Pension.\\c\\nLes gens me confient leurs Pokémon et je les\\nélève avec amour.\\c\\nQue puis-je faire pour toi, mon enfant ?"
    },
    {
      "index": 72,
      "id": "msg_sodateya003",
      "hash": "81b5037d801b3c3c",
      "flags": 4,
      "text": "Ah bon ? D’accord. Reviens quand tu veux,\\nm[VAR GENDBR(00FF,0808)]on petita petite. ♥"
    },
    {
      "index": 73,
      "id": "msg_sodateya004",
      "hash": "81b5027d801b3a89",
      "flags": 4,
      "text": "Attention, mon enfant, si tu me confies ce\\nPokémon, tu ne pourras plus te battre.\\c\\nReviens plutôt quand tu auras réussi à en\\ncapturer d’autres."
    },
    {
      "index": 74,
      "id": "msg_sodateya005",
      "hash": "81b5017d801b38d6",
      "flags": 0,
      "text": "Si tu n’as pas au moins trois petits protégés,\\nentre ton équipe et ta Boîte Pokémon, je ne vais\\r\\npas pouvoir m’en occuper.\\c\\nCapture plus de Pokémon et tu pourras m’en\\nconfier ! ♥"
    },
    {
      "index": 75,
      "id": "msg_sodateya006",
      "hash": "81b5007d801b3723",
      "flags": 0,
      "text": "Choisis le Pokémon que tu veux me confier,\\nm[VAR GENDBR(00FF,0808)]on petita petite."
    },
    {
      "index": 76,
      "id": "msg_sodateya007",
      "hash": "81b4ff7d801b3570",
      "flags": 0,
      "text": "Ce Pokémon semble très attaché à toi, il refuse\\nde te quitter. Oooh, comme c’est mignon... ♥"
    },
    {
      "index": 77,
      "id": "msg_sodateya008",
      "hash": "81b50e7d801b4eed",
      "flags": 0,
      "text": "Très bien, je vais donc m’occuper\\nde ton petit [VAR PKNICK(0000)]."
    },
    {
      "index": 78,
      "id": "msg_sodateya009",
      "hash": "81b50d7d801b4d3a",
      "flags": 0,
      "text": "Confie-le-moi quelque temps avant de revenir\\nle chercher !"
    },
    {
      "index": 79,
      "id": "msg_sodateya010",
      "hash": "81b1807d801827cc",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] a progressé, il est monté\\nde [VAR NUM2(0001)] niveau[VAR ITEMPLUR1(0001,0100)]x !"
    },
    {
      "index": 80,
      "id": "msg_sodateya011",
      "hash": "81b1817d8018297f",
      "flags": 0,
      "text": "Tu veux récupérer [VAR PKNICK(0000)] ?\\c\\nDans ce cas, les frais de la Pension s’élèvent\\nà [VAR NUM5(0001,202F)] ₽. C’est bon pour toi ?"
    },
    {
      "index": 81,
      "id": "msg_sodateya012",
      "hash": "81b1827d80182b32",
      "flags": 0,
      "text": "Quel malheur, tu n’as pas assez d’argent..."
    },
    {
      "index": 82,
      "id": "msg_sodateya013",
      "hash": "81b1837d80182ce5",
      "flags": 4,
      "text": "Oh, mais... Tu n’as plus de place ni dans ton\\néquipe ni dans ta Boîte Pokémon...\\c\\nFais donc de la place et reviens me voir plus\\ntard, mon enfant. ♥"
    },
    {
      "index": 83,
      "id": "msg_sodateya014",
      "hash": "81b17c7d80182100",
      "flags": 4,
      "text": "Au fait, ton Pokémon a trouvé quelque chose..."
    },
    {
      "index": 84,
      "id": "msg_sodateya015",
      "hash": "81b17d7d801822b3",
      "flags": 0,
      "text": "Reviens me voir quand tu veux si jamais tu\\nsouhaites me confier l’un de tes Pokémon ! ♥"
    },
    {
      "index": 85,
      "id": "msg_sodateya016",
      "hash": "81b17e7d80182466",
      "flags": 0,
      "text": "Mais tu ne pourras plus te battre si tu me confies\\nce Pokémon !"
    },
    {
      "index": 86,
      "id": "msg_tokkun001",
      "hash": "264f9dc66325087e",
      "flags": 0,
      "text": "Je suis Pépé Ultime ! C’est moi qui suis chargé\\nde l’Entraînement... Ultime !\\c\\nReviens me voir quand tu seras passé[VAR GENDBR(00FF,0100)]e Maître !"
    },
    {
      "index": 87,
      "id": "msg_tokkun002",
      "hash": "264f9cc6632506cb",
      "flags": 0,
      "text": "Ho ho, alors comme ça, tu es passé[VAR GENDBR(00FF,0100)]e Maître ?\\nTu as eu raison de revenir voir Pépé Ultime !\\c\\nSi tu as des Pokémon ayant atteint le niveau 100,\\nje peux leur proposer un Entraînement Ultime !\\c\\nDonne-moi une Capsule d’Argent, et je fais\\nmonter une stat !\\c\\nDonne-moi une Capsule d’Or, et je les fais\\ntoutes monter !\\c\\nQu’on se le dise : Pépé Ultime, c’est l’entraîneur\\ndes champions !"
    },
    {
      "index": 88,
      "id": "msg_tokkun003",
      "hash": "264f9bc663250518",
      "flags": 4,
      "text": "Alors, tu veux faire appel à l’Entraînement\\nUltime de Pépé Ultime ?"
    },
    {
      "index": 89,
      "id": "msg_tokkun004",
      "hash": "264fa2c6632510fd",
      "flags": 4,
      "text": "Attention : pas de Capsule, pas d’Entraînement\\nUltime !"
    },
    {
      "index": 90,
      "id": "msg_tokkun005",
      "hash": "264fa1c663250f4a",
      "flags": 0,
      "text": "Quel Pokémon va suivre mon Entraînement\\nUltime ?"
    },
    {
      "index": 91,
      "id": "msg_tokkun006",
      "hash": "264fa0c663250d97",
      "flags": 0,
      "text": "Mais, ce Pokémon n’a pas le niveau requis !"
    },
    {
      "index": 92,
      "id": "msg_tokkun007",
      "hash": "264f9fc663250be4",
      "flags": 0,
      "text": "Ce Pokémon n’a clairement pas besoin de\\ns’entraîner !"
    },
    {
      "index": 93,
      "id": "msg_tokkun008",
      "hash": "264f96c66324fc99",
      "flags": 0,
      "text": "Quelle stat veux-tu que j’améliore ?"
    },
    {
      "index": 94,
      "id": "msg_tokkun009",
      "hash": "264f95c66324fae6",
      "flags": 0,
      "text": "Hum, [VAR EVSTAT(0001)], tu disais ?\\nPour [VAR PKNICK(0000)], c’est ça ?\\r\\nD’accord, mais ça te coûtera une Capsule\\r\\nd’Argent !"
    },
    {
      "index": 95,
      "id": "msg_tokkun010",
      "hash": "264c98c66322ca28",
      "flags": 0,
      "text": "Hum, toutes les stats, tu disais ?\\nPour [VAR PKNICK(0000)], c’est ça ?\\r\\nD’accord, mais ça te coûtera une Capsule d’Or !"
    },
    {
      "index": 96,
      "id": "msg_tokkun011",
      "hash": "264c99c66322cbdb",
      "flags": 0,
      "text": "Dans ce cas, on commence l’entraînement\\n[VAR VARFRA03(0000)][VAR PKNICK(0000)] !"
    },
    {
      "index": 97,
      "id": "msg_tokkun012",
      "hash": "264c9ac66322cd8e",
      "flags": 0,
      "text": "Hooooo !!!\\nHaaaaa !!!"
    },
    {
      "index": 98,
      "id": "msg_tokkun013",
      "hash": "264c9bc66322cf41",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] a gagné en puissance grâce\\nà l’Entraînement Ultime !"
    },
    {
      "index": 99,
      "id": "msg_tokkun014",
      "hash": "264c9cc66322d0f4",
      "flags": 4,
      "text": "On continue ?"
    },
    {
      "index": 100,
      "id": "msg_tokkun015",
      "hash": "264c9dc66322d2a7",
      "flags": 0,
      "text": "Dans ce cas, à la revoyure !"
    },
    {
      "index": 101,
      "id": "msg_tokkun016",
      "hash": "264c9ec66322d45a",
      "flags": 0,
      "text": "L’Entraînement Ultime, c’est le meilleur moyen\\npour booster les stats d’un Pokémon de\\r\\nniveau 100 pour qu’elles atteignent\\r\\nleur puissance... ultime !\\c\\nTu veux que j’entraîne tes Pokémon ?\\c\\nPas de problème, je te demanderai juste de\\nm’aider à compléter ma collection de capsules\\r\\nen échange !\\c\\nApporte-moi une Capsule d’Argent et je ferai\\nmonter une stat au max !\\c\\nApporte-moi une Capsule d’Or, et je les ferai\\ntoutes monter au max !\\c\\nEt voilà, tu sais tout !"
    },
