{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub023_karate_01_01",
      "hash": "eaf8a55e83471389",
      "flags": 0,
      "text": "Jeune Dresseu[VAR GENDBR(00FF,0201)]rse !\\c\\nJe suis le Grand Karatéka !\\nIci, le Champion, c’est moi !"
    },
    {
      "index": 1,
      "id": "msg_sub023_karate_01_09",
      "hash": "eaf8ad5e83472121",
      "flags": 0,
      "text": "Hein ? Tu me provoques ?\\nTu veux m’affronter ?\\c\\nD’accord, mais je n’aurai aucune pitié !"
    },
    {
      "index": 2,
      "id": "msg_sub023_karate_01_10",
      "hash": "eafc2a5e834a2b5f",
      "flags": 0,
      "text": "Hahaha ! Yahaaa !"
    },
    {
      "index": 3,
      "id": "msg_sub023_karate_01_02",
      "hash": "eaf8a25e83470e70",
      "flags": 4,
      "text": "OK, t’as gagné !"
    },
    {
      "index": 4,
      "id": "msg_sub023_karate_01_07",
      "hash": "eaf8a75e834716ef",
      "flags": 0,
      "text": "Mais ne va pas le crier sur tous les toits !\\nTu sais te battre, on a compris !"
    },
    {
      "index": 5,
      "id": "msg_sub023_karate_01_08",
      "hash": "eaf8ac5e83471f6e",
      "flags": 4,
      "text": "En échange de ton silence... Je sais !\\nJe t’offre un Pokémon Combat !"
    },
    {
      "index": 6,
      "id": "msg_sub023_karate_01_06",
      "hash": "eaf8a65e8347153c",
      "flags": 0,
      "text": "Choisis celui que tu veux !"
    },
    {
      "index": 7,
      "id": "msg_sub023_karate_01_03",
      "hash": "eaf8a35e83471023",
      "flags": 0,
      "text": "Reste avec nous pour faire du karaté !"
    },
    {
      "index": 8,
      "id": "msg_sub023_karate_01_04",
      "hash": "eaf8a85e834718a2",
      "flags": 0,
      "text": "Tu veux Kicklee, l’expert en coups de pied ?"
    },
    {
      "index": 9,
      "id": "msg_sub023_sys_01_01",
      "hash": "384f6f255b68c6d4",
      "flags": 0,
      "text": "Vous recevez un [VAR POKNAME(0004)] !"
    },
    {
      "index": 10,
      "id": "msg_sub023_karate_01_05",
      "hash": "eaf8a95e83471a55",
      "flags": 0,
      "text": "Tu veux Tygnon, le maître de la boxe ?"
    },
    {
      "index": 11,
      "id": "msg_sub023_sys_01_02",
      "hash": "384f72255b68cbed",
      "flags": 0,
      "text": "Tut tut tut !\\nFaut pas être trop gourmand[VAR GENDBR(00FF,0100)]e..."
    },
    {
      "index": 12,
      "id": "msg_sub023_poke_01_01",
      "hash": "1c43cc5dba1082f6",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Kicklee :[VAR COLOR(0000)] Kiiick !"
    },
    {
      "index": 13,
      "id": "msg_sub023_poke_02_01",
      "hash": "4b19cc75c761fea9",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Tygnon :[VAR COLOR(0000)] Gnooon !"
    }
  ],
