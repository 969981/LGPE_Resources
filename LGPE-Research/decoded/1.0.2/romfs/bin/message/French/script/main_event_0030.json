    },
    {
      "index": 7,
      "id": "msg_main0030_new_doctor_01",
      "hash": "e79395d568abbc54",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Chen : [VAR COLOR(0000)]Merci, braves petits Roucool !"
    },
    {
      "index": 8,
      "id": "msg_main0030_new_doctor_09",
      "hash": "e7938dd568abaebc",
      "flags": 0,
      "text": "J’ai encore appris de nouvelles choses sur vous,\\nc’est fou ! La vie n’est que découvertes !"
    },
    {
      "index": 9,
      "id": "msg_main0030_new_doctor_02",
      "hash": "e79398d568abc16d",
      "flags": 0,
      "text": "Tiens, [VAR TRNAME(0000)] !\\nQuel bon vent t’amène ?"
    },
    {
      "index": 10,
      "id": "msg_main0030_new_doctor_10",
      "hash": "e79010d568a8a47e",
      "flags": 4,
      "text": "Ah, oui ! Je dois vous donner des Pokémon,\\nà [VAR TRNAME(0001)] et toi.\\r\\nAllons à mon labo, m[VAR GENDBR(00FF,0C0C)]on jeune amia jeune amie."
    },
    {
      "index": 11,
      "id": "msg_main0030_new_doctor_03",
      "hash": "e79397d568abbfba",
      "flags": 0,
      "text": "Tiens ?"
    },
    {
      "index": 12,
      "id": "msg_main0030_new_doctor_04",
      "hash": "e79392d568abb73b",
      "flags": 0,
      "text": "Mais... ?!"
    },
    {
      "index": 13,
      "id": "msg_main0030_new_doctor_05",
      "hash": "e79391d568abb588",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Chen[VAR COLOR(0000)] [VAR COLOR(0009)]:[VAR COLOR(0000)] Formidable ! Tu t’en sors très bien,\\npour une première capture !"
    },
    {
      "index": 14,
      "id": "msg_main0030_new_doctor_11",
      "hash": "e79011d568a8a631",
      "flags": 0,
      "text": "Tu peux ramasser la Poké Ball, maintenant,\\net donner un surnom à ce joli [VAR POKNAME(0002)] !"
    },
    {
      "index": 15,
      "id": "msg_main0030_new_doctor_06",
      "hash": "e79394d568abbaa1",
      "flags": 0,
      "text": "Quoi ?!"
    },
    {
      "index": 16,
      "id": "msg_main0030_new_doctor_07",
      "hash": "e79393d568abb8ee",
      "flags": 4,
      "text": "Incroyable, il ne tient pas en place !\\nJe n’ai jamais vu un loustic pareil !"
    },
    {
      "index": 17,
      "id": "msg_main0030_new_doctor_08",
      "hash": "e7938ed568abb06f",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Chen[VAR COLOR(0000)] [VAR COLOR(0009)]:[VAR COLOR(0000)] Hé, attends ! Reviens ici, petit fripon !"
    }
  ],
