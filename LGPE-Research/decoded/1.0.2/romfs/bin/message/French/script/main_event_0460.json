      "hash": "b935a9e59962c99d",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] !"
    },
    {
      "index": 1,
      "id": "msg_main_0460_nresercher_02",
      "hash": "b935a6e59962c484",
      "flags": 0,
      "text": "Salut ! Tu te souviens de moi ?\\nJe suis l’un des assistants du Professeur Chen !"
    },
    {
      "index": 2,
      "id": "msg_main_0460_nresercher_03",
      "hash": "b935a7e59962c637",
      "flags": 0,
      "text": "Quelle chance de tomber sur toi ! J’ai justement\\nquelque chose d’éblouissant à te montrer !"
    },
    {
      "index": 3,
      "id": "msg_main_0460_nresercher_04",
      "hash": "b935a4e59962c11e",
      "flags": 0,
      "text": "... Mais pas ici, il nous faudrait un endroit plus\\nsombre..."
    },
    {
      "index": 4,
      "id": "msg_main_0460_nresercher_05",
      "hash": "b935a5e59962c2d1",
      "flags": 0,
      "text": "Retrouve-moi à l’intérieur !"
    }
  ],
  "unpaired_labels": [
