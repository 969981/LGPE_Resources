  "lines": [
    {
      "index": 0,
      "id": "msg_t009r0204_diary_01",
      "hash": "195895652cba1f2a",
      "flags": 0,
      "text": "« Rapport du 1ᵉʳ septembre :\\nMewtwo est beaucoup trop puissant.\\c\\nIl est devenu incontrôlable ! »"
    },
    {
      "index": 1,
      "id": "msg_t009r0204_bed_01",
      "hash": "92031dac46130782",
      "flags": 4,
      "text": "Oh, un lit !\\nProfitons-en pour se reposer !"
    },
    {
      "index": 2,
      "id": "msg_t009r0204_pod_01",
      "hash": "727f2fb532261b32",
      "flags": 0,
      "text": "C’est une grande capsule en verre épais.\\c\\nLa paroi intérieure est tout abîmée, comme si\\nelle avait été martelée..."
    },
    {
      "index": 3,
      "id": "msg_t009r0204_pod_02",
      "hash": "727f2eb53226197f",
      "flags": 0,
      "text": "C’est une capsule en verre épais.\\c\\nIl y a des traces de liquide desséchées par-ci\\npar-là."
    },
    {
      "index": 4,
      "id": "msg_t009r0204_pod_03",
      "hash": "727f2db5322617cc",
      "flags": 0,
      "text": "C’est une grosse machine, avec tout plein\\nde jauges et de boutons.\\c\\nOn dirait qu’elle n’a pas été utilisée depuis\\ntrès longtemps."
    },
    {
      "index": 5,
      "id": "msg_t009r0204_switch_01",
      "hash": "8000d23baa5c94e9",
      "flags": 0,
      "text": "[~ 5]"
