      "flags": 0,
      "text": "Jadielle\\n« Verte comme l’espérance »"
    },
    {
      "index": 1,
      "id": "msg_town002_kanban_02",
      "hash": "7637afc9d1a1bb02",
      "flags": 4,
      "text": "Arène Pokémon de Jadielle"
    },
    {
      "index": 2,
      "id": "msg_town002_door_01",
      "hash": "b7246880b3c9c456",
      "flags": 0,
      "text": "Les portes de l’Arène sont fermées..."
    },
    {
      "index": 3,
      "id": "msg_town002_kanban_03",
      "hash": "7637b0c9d1a1bcb5",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "msg_town002_kanban_04",
      "hash": "7637a9c9d1a1b0d0",
      "flags": 4,
      "text": "Astuce !\\c\\nQuand vous vous retrouvez à court de Poké Balls,\\nréapprovisionnez-vous à la Boutique Pokémon !"
    },
    {
      "index": 5,
      "id": "msg_town002_kanban_05",
      "hash": "7637aac9d1a1b283",
      "flags": 4,
      "text": "École de Dresseurs\\n« L’apprentissage pour apprentis sages ! »"
    },
    {
      "index": 6,
      "id": "msg_town002_childm_01_01",
      "hash": "514de6fb5176410d",
      "flags": 4,
      "text": "Oooh, il est trop mimi, ton Pokémon !\\c\\nC’est trop bien de pouvoir se promener avec\\nson Pokémon préféré !"
    },
    {
      "index": 7,
      "id": "msg_town002_oldm_01_01",
      "hash": "75c5dea9e5248190",
      "flags": 0,
      "text": "Cette Arène Pokémon est toujours fermée.\\nMais qui en est le Champion ?"
    },
    {
      "index": 8,
      "id": "msg_town002_oldm_01_02",
      "hash": "75c5e1a9e52486a9",
      "flags": 0,
      "text": "L’Arène de Jadielle a de nouveau un Champion !"
    },
    {
      "index": 9,
      "id": "msg_town002_bugcatcher_01_01",
      "hash": "064dd86c3fe6a1d6",
      "flags": 0,
      "text": "Tu veux savoir un truc sur Chenipan et Aspicot ?"
    },
    {
      "index": 10,
      "id": "msg_town002_bugcatcher_01_02",
      "hash": "064dd76c3fe6a023",
      "flags": 0,
      "text": "Bon, tant pis !"
    },
    {
      "index": 11,
      "id": "msg_town002_bugcatcher_01_03",
      "hash": "064dd66c3fe69e70",
      "flags": 0,
      "text": "Contrairement à Chenipan, Aspicot est venimeux.\\nAttention à sa piqûre !"
    },
    {
      "index": 12,
      "id": "msg_town002_jevenile_f_01",
      "hash": "52931ec5d1be27bf",
      "flags": 0,
      "text": "[~ 12]"
    },
    {
      "index": 13,
      "id": "msg_town002_poke_01",
      "hash": "1102f61156ce1dad",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Mystherbe :[VAR COLOR(0000)] Myyy !"
    },
    {
      "index": 14,
      "id": "msg_town002_middlem_01",
      "hash": "01f9b8b8687961de",
      "flags": 4,
      "text": "Oh ! Tu viens de Bourg Palette, toi, non ?\\nBienvenue à Jadielle !"
    }
  ],
