{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub037_adultf_01",
      "hash": "0754a41f7a189db8",
      "flags": 0,
      "text": "Je m’occupe de Pokémon blessés."
    },
    {
      "index": 1,
      "id": "msg_sub037_adultf_02",
      "hash": "0754a71f7a18a2d1",
      "flags": 0,
      "text": "J’ai soigné ce Bulbizarre.\\nIl est d’attaque, maintenant !\\c\\nPar contre, je cherche un Dresseur chevronné\\npour s’en occuper. Quelqu’un qui aurait déjà\\r\\ncapturé tout plein de Pokémon, tu vois ?"
    },
    {
      "index": 2,
      "id": "msg_sub037_adultf_08",
      "hash": "07549d1f7a1891d3",
      "flags": 0,
      "text": "D’ailleurs, combien de Pokémon as-tu capturés ?\\n... [VAR NUM9(0000,202F)] ?!"
    },
    {
      "index": 3,
      "id": "msg_sub037_adultf_03",
      "hash": "0754a61f7a18a11e",
      "flags": 0,
      "text": "Super ! Ça te dirait de prendre ce Bulbizarre\\nsous ton aile ?"
    },
    {
      "index": 4,
      "id": "msg_sub037_adultf_04",
      "hash": "0754a91f7a18a637",
      "flags": 0,
      "text": "Prends bien soin de lui !"
    },
    {
      "index": 5,
      "id": "msg_sub037_adultf_09",
      "hash": "07549c1f7a189020",
      "flags": 0,
      "text": "S’il t’intéresse, reviens me voir quand tu auras\\ncapturé au moins [VAR NUM2(0000)] Pokémon, d’accord ?"
    },
    {
      "index": 6,
      "id": "msg_sub037_adultf_05",
      "hash": "0754a81f7a18a484",
      "flags": 0,
      "text": "J’espère que Bulbizarre se porte bien !"
    },
    {
      "index": 7,
      "id": "msg_sub037_adultf_06",
      "hash": "0754ab1f7a18a99d",
      "flags": 4,
      "text": "Oh... C’est fort dommage..."
    },
    {
      "index": 8,
      "id": "msg_sub037_poke_01",
      "hash": "96bdf2947fd99335",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Bulbizarre :[VAR COLOR(0000)] Bizaaarre !"
    }
  ],
