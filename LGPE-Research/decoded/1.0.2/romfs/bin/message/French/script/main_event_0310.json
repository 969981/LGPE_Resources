{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0310_rocketm_01",
      "hash": "d0bf455f5b512f68",
      "flags": 0,
      "text": "Félicitations !\\nTu as battu les cinq Dresseurs !\\c\\nAccepte ce fabuleux prix !"
    },
    {
      "index": 1,
      "id": "msg_main0310_sys_01",
      "hash": "fda0b6542407ea06",
      "flags": 0,
      "text": "Vous obtenez une Pépite !"
    },
    {
      "index": 2,
      "id": "msg_main0310_rocketm_02",
      "hash": "d0bf485f5b513481",
      "flags": 0,
      "text": "D’ailleurs, petit[VAR GENDBR(00FF,0100)]e... Que dirais-tu de rejoindre\\nles rangs de la Team Rocket ?"
    },
    {
      "index": 3,
      "id": "msg_main0310_rocketm_04",
      "hash": "d0bf4a5f5b5137e7",
      "flags": 4,
      "text": "Eh ouais !"
    },
    {
      "index": 4,
      "id": "msg_main0310_rocketm_05",
      "hash": "d0bf495f5b513634",
      "flags": 0,
      "text": "Nous sommes un groupe de criminels spécialisés\\nen Pokémon !"
    },
    {
      "index": 5,
      "id": "msg_main0310_rocketm_06",
      "hash": "d0bf4c5f5b513b4d",
      "flags": 0,
      "text": "Ça t’intéresse ?"
    },
    {
      "index": 6,
      "id": "msg_main0310_rocketm_07",
      "hash": "d0bf4b5f5b51399a",
      "flags": 0,
      "text": "Non ? T’es sûr[VAR GENDBR(00FF,0100)]e ?\\nParce que franchement, on est bons."
    },
    {
      "index": 7,
      "id": "msg_main0310_rocketm_08",
      "hash": "d0bf3e5f5b512383",
      "flags": 4,
      "text": "Allez, viens !"
    },
    {
      "index": 8,
      "id": "msg_main0310_rocketm_09",
      "hash": "d0bf3d5f5b5121d0",
      "flags": 0,
      "text": "Ça suffit maintenant, je t’ai dit de nous rejoindre !"
    },
    {
      "index": 9,
      "id": "msg_main0310_rocketm_10",
      "hash": "d0bbc05f5b4e1792",
      "flags": 0,
      "text": "Je vois...\\c\\nJe vais devoir employer les grands moyens\\net me montrer plus persuasif !"
    },
    {
      "index": 10,
      "id": "msg_main0310_rocketm_11",
      "hash": "d0bbc15f5b4e1945",
      "flags": 0,
      "text": "C’est parti !"
    },
    {
      "index": 11,
      "id": "msg_main0150_dummy_01",
      "hash": "ff67b6d57bb9318b",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_main0310_rocketm_03",
      "hash": "d0bf475f5b5132ce",
      "flags": 0,
      "text": "Tu pourrais vite devenir un[VAR GENDBR(00FF,0100)]e [VAR GENDBR(00FF,0404)]chefboss au sein\\nde la Team Rocket !\\c\\nFranchement, réfléchis-y, ce serait bête de\\nlaisser passer cette chance !"
    },
    {
      "index": 13,
      "id": "msg_main0310_rocketm_12",
      "hash": "d0bbbe5f5b4e142c",
      "flags": 0,
      "text": "Félicitations !\\nTu as battu les cinq Dresseurs !"
    }
  ],
