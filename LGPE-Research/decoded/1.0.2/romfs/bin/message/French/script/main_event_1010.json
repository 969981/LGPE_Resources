    },
    {
      "index": 6,
      "id": "msg_main_1010_sys_02",
      "hash": "1651ee0d6b07df38",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main1010_muscle_04",
      "hash": "313c7eb68af79e19",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "msg_main1010_muscle_n_01",
      "hash": "27012684004f6025",
      "flags": 0,
      "text": "Ce Lokhlass n’est plus très jeune, mais il est\\nmagnifique, tu ne trouves pas ?"
    },
    {
      "index": 9,
      "id": "msg_main1010_muscle_n_09",
      "hash": "27012e84004f6dbd",
      "flags": 4,
      "text": "Il y a longtemps, nous avons défié la houle\\net parcouru le monde entier ensemble !"
    },
    {
      "index": 10,
      "id": "msg_main1010_poke_n_01",
      "hash": "0fbf99abdfd06be7",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Lokhlass :[VAR COLOR(0000)] Khlaaass !"
    },
    {
      "index": 11,
      "id": "msg_main1010_muscle_n_02",
      "hash": "27012384004f5b0c",
      "flags": 0,
      "text": "Malheureusement, il ne peut plus nager comme\\nil le faisait autrefois...\\c\\nJe me suis donc installé ici pour pouvoir rester\\nà ses côtés."
    },
    {
      "index": 12,
      "id": "msg_main1010_muscle_n_03",
      "hash": "27012484004f5cbf",
      "flags": 0,
      "text": "Merci d’avoir écouté ma petite histoire."
    },
    {
      "index": 13,
      "id": "msg_main1010_muscle_n_10",
      "hash": "2704ab84005277fb",
      "flags": 0,
      "text": "Pour te remercier, j’aimerais t’enseigner un moyen\\nde naviguer sur l’eau comme bon te semble :\\r\\nla [VAR COLOR(0006)]Technique Secrète Navigation[VAR COLOR(0000)] !"
    },
    {
      "index": 14,
      "id": "msg_main1010_muscle_n_04",
      "hash": "27012184004f57a6",
      "flags": 0,
      "text": "Ho ho ho ! On dirait que ton petit\\n[VAR POKNAME(0002)] est intéressé !"
    },
    {
      "index": 15,
      "id": "msg_main1010_muscle_n_11",
      "hash": "2704aa8400527648",
      "flags": 4,
      "text": "Il n’est pas de type Eau, mais j’imagine que\\ncela pourrait fonctionner..."
    },
    {
      "index": 16,
      "id": "msg_main1010_partner_a_01",
      "hash": "f1cf0975034c2acf",
      "flags": 0,
      "text": "Pika pika !"
    },
    {
      "index": 17,
      "id": "msg_main1010_partner_b_01",
      "hash": "f30a517a2a59c078",
      "flags": 0,
      "text": "Vooo !"
    },
    {
      "index": 18,
      "id": "msg_main1010_muscle_n_05",
      "hash": "27012284004f5959",
      "flags": 0,
      "text": "Je vois dans son regard la même volonté qui\\nanimait mon Lokhlass dans sa jeunesse."
    },
    {
      "index": 19,
      "id": "msg_main1010_muscle_n_12",
      "hash": "2704ad8400527b61",
      "flags": 4,
      "text": "Il m’a convaincu ! Je vais lui enseigner\\nla Technique Secrète !"
    },
    {
      "index": 20,
      "id": "msg_main1010_partner_a_02",
      "hash": "f1cf0a75034c2c82",
      "flags": 0,
      "text": "Pika ! Pikachuuu !"
    },
    {
      "index": 21,
      "id": "msg_main1010_partner_b_02",
      "hash": "f30a547a2a59c591",
      "flags": 0,
      "text": "Vo voli !"
    },
    {
      "index": 22,
      "id": "msg_main1010_muscle_n_06",
      "hash": "27011f84004f5440",
      "flags": 0,
      "text": "Plif plof, en équilibre sur ta planche, t’es au top !\\nFlip flop, sur les courants, glisse non-stop !\\c\\nYeah oh, abaisse ton centre de gravité !\\nOh yeah, pour mieux te stabiliser !"
    },
    {
      "index": 23,
      "id": "msg_main1010_sys_n_01",
      "hash": "5b153dffd0bef2dd",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] a appris la [VAR COLOR(0006)]TS Navigation[VAR COLOR(0000)] !"
    },
    {
      "index": 24,
      "id": "msg_main1010_muscle_n_07",
      "hash": "27012084004f55f3",
      "flags": 0,
      "text": "Quel talent ! Pour la peine, je t’offre aussi cette\\nplanche de surf !"
    },
    {
      "index": 25,
      "id": "msg_main1010_muscle_n_13",
      "hash": "2704ac84005279ae",
      "flags": 0,
      "text": "Chevauchez les vagues ensemble et glissez\\nsur les courants de votre destinée !"
    },
    {
      "index": 26,
      "id": "msg_main1010_muscle_n_08",
      "hash": "27012d84004f6c0a",
      "flags": 0,
      "text": "C’est maintenant à ton [VAR POKNAME(0002)] et toi\\nde parcourir ensemble un océan d’aventures !"
    }
  ],
