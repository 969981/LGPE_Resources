    {
      "index": 6,
      "id": "msg_book_01_p01_t005_r0101",
      "hash": "687235c0f3f98ae7",
      "flags": 0,
      "text": "« Grand tirage au sort du magazine mensuel\\n\"Fan de Pokémon\" !\\c\\nPour participer, remplissez le formulaire\\nd’inscription et... »\\c\\n... Ah !\\nQuelqu’un l’a déjà découpé !"
