{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main1220_partner_a_01",
      "hash": "4efb61fc06ce0c44",
      "flags": 0,
      "text": "Pika pika !"
    },
    {
      "index": 1,
      "id": "msg_main1220_partner_b_01",
      "hash": "f89599f46b644f3b",
      "flags": 0,
      "text": "Vo ! Évo !"
    },
    {
      "index": 2,
      "id": "msg_main1220_young_f_01",
      "hash": "b718baf58baac5e5",
      "flags": 4,
      "text": "Oh ! Un [VAR POKNAME(0002)] !"
    },
    {
      "index": 3,
      "id": "msg_main1220_young_f_02",
      "hash": "b718b7f58baac0cc",
      "flags": 4,
      "text": "Oui ? Tu veux savoir ce que je fais ici ?"
    },
    {
      "index": 4,
      "id": "msg_main1220_young_f_03",
      "hash": "b718b8f58baac27f",
      "flags": 0,
      "text": "Je cueille des fleurs !\\c\\nAprès, j’en ferai un bouquet pour l’offrir\\nà quelqu’un de spécial."
    },
    {
      "index": 5,
      "id": "msg_main1220_young_f_04",
      "hash": "b718b5f58baabd66",
      "flags": 4,
      "text": "Oh, [VAR TRNAME(0000)] !\\c\\nTu as tout entendu ? N’en parle à personne,\\nd’accord ? Ce sera notre petit secret !"
    },
    {
      "index": 6,
      "id": "msg_main1220_young_f_05",
      "hash": "b718b6f58baabf19",
      "flags": 4,
      "text": "En parlant de secret, en voici un autre !\\nL’Arène de Jadielle a de nouveau un Champion !\\c\\nC’est formidable ! Va donc voir ça de tes\\npropres yeux !"
    },
    {
      "index": 7,
      "id": "msg_main1220_young_f_06",
      "hash": "b718b3f58baaba00",
      "flags": 0,
      "text": "Surtout, ne dis pas à [VAR TRNAME(0001)]\\nque je cueille des fleurs !\\r\\nMotus et bouche cousue !"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_1220_max",
      "hash": "72cc4a06d164628a"
    }
  ]
}
