{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0200_scientist_01",
      "hash": "1997f465dac34205",
      "flags": 0,
      "text": "Hep ! Toi, là !"
    },
    {
      "index": 1,
      "id": "msg_main0200_scientist_05",
      "hash": "1997f065dac33b39",
      "flags": 0,
      "text": "Ces fossiles sont à moi !"
    },
    {
      "index": 2,
      "id": "msg_main0200_scientist_06",
      "hash": "1997ed65dac33620",
      "flags": 0,
      "text": "Parfaitement, les deux !\\nDonc, pas touche !"
    },
    {
      "index": 3,
      "id": "msg_science_02_02",
      "hash": "3f4233734bcf5c9d",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "msg_main0200_scientist_02",
      "hash": "1997f165dac33cec",
      "flags": 4,
      "text": "OK, OK, on peut partager... Chacun le sien !\\nComme ça, pas de jaloux."
    },
    {
      "index": 5,
      "id": "msg_main0200_sys_01",
      "hash": "4a818fc482d38e68",
      "flags": 0,
      "text": "Voulez-vous prendre le Fossile Dôme ?"
    },
    {
      "index": 6,
      "id": "msg_main0200_sys_02",
      "hash": "4a8192c482d39381",
      "flags": 0,
      "text": "Voulez-vous prendre le Nautile ?"
    },
    {
      "index": 7,
      "id": "msg_main0200_sys_03",
      "hash": "4a8191c482d391ce",
      "flags": 0,
      "text": "Vous obtenez le Nautile !"
    },
    {
      "index": 8,
      "id": "msg_main0200_sys_04",
      "hash": "4a8194c482d396e7",
      "flags": 0,
      "text": "Vous obtenez le Fossile Dôme !"
    },
    {
      "index": 9,
      "id": "msg_main0200_scientist_03",
      "hash": "1997f265dac33e9f",
      "flags": 4,
      "text": "OK, je prends l’autre, alors !"
    },
    {
      "index": 10,
      "id": "msg_main0200_scientist_04",
      "hash": "1997ef65dac33986",
      "flags": 4,
      "text": "Il paraît que, très loin d’ici, il y a un laboratoire\\noù des chercheurs tentent de restaurer\\r\\ndes fossiles de Pokémon.\\c\\nCe laboratoire se trouverait à Cramois’Île..."
    }
  ],
