{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub087_middle_f_01",
      "hash": "69183b2fbfcbb2c9",
      "flags": 4,
      "text": "Ah là là, mais qu’est-ce que je vais faire de toi,\\nRalamasse ?"
    },
    {
      "index": 1,
      "id": "msg_sub087_middle_f_02",
      "hash": "6918382fbfcbadb0",
      "flags": 4,
      "text": "Oh, tu tombes bien ! Est-ce que je pourrais\\nte demander un service, par hasard ?"
    },
    {
      "index": 2,
      "id": "msg_sub087_middle_f_03",
      "hash": "6918392fbfcbaf63",
      "flags": 4,
      "text": "Ah, tu es occupé[VAR GENDBR(00FF,0100)]e... Tant pis alors.\\nJe me débrouillerai autrement, ne t’en fais pas."
    },
    {
      "index": 3,
      "id": "msg_sub087_middle_f_04",
      "hash": "69183e2fbfcbb7e2",
      "flags": 0,
      "text": "J’essaie d’aller au Musée des Sciences, mais ma\\npetite Ralamasse refuse de bouger d’un pouce !"
    },
    {
      "index": 4,
      "id": "msg_sub087_yadon_01",
      "hash": "f0f118be8033672a",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Ralamasse :[VAR COLOR(0000)] Molooo..."
    },
    {
      "index": 5,
      "id": "msg_sub087_middle_f_05",
      "hash": "69183f2fbfcbb995",
      "flags": 0,
      "text": "Tu voudrais bien la garder le temps que je visite\\nle musée ? Je ne serai pas longue, promis !"
    },
    {
      "index": 6,
      "id": "msg_sub087_middle_f_09",
      "hash": "6918432fbfcbc061",
      "flags": 4,
      "text": "Ah, te voilà ! Est-ce que tu pourrais garder\\nRalamasse une fois encore, s’il te plaît ?\\r\\nJ’ai quelques petites courses à faire..."
    },
    {
      "index": 7,
      "id": "msg_sub087_select_01",
      "hash": "087a940740025655",
      "flags": 0,
      "text": "Bien sûr !"
    },
    {
      "index": 8,
      "id": "msg_sub087_select_02",
      "hash": "087a91074002513c",
      "flags": 0,
      "text": "J’ai d’autres plans, désolé[VAR GENDBR(00FF,0100)]e..."
    },
    {
      "index": 9,
      "id": "msg_sub087_middle_f_06",
      "hash": "69183c2fbfcbb47c",
      "flags": 0,
      "text": "Merci ! C’est vraiment gentil ! Eh bien, dans ce\\ncas, je te confie Ralamasse !"
    },
    {
      "index": 10,
      "id": "msg_sub087_yadon_02",
      "hash": "f0f117be80336577",
      "flags": 0,
      "text": "...\\n..."
    },
    {
      "index": 11,
      "id": "msg_sub087_system_01",
      "hash": "a2604769f3459b22",
      "flags": 0,
      "text": "Ralamasse a l’air complètement... à la masse..."
    },
    {
      "index": 12,
      "id": "msg_sub087_system_02",
      "hash": "a2604669f345996f",
      "flags": 0,
      "text": "Ralamasse est toute ramollo..."
    },
    {
      "index": 13,
      "id": "msg_sub087_system_03",
      "hash": "a2604569f34597bc",
      "flags": 0,
      "text": "Ralamasse se tient tranquille..."
    },
    {
      "index": 14,
      "id": "msg_sub087_system_04",
      "hash": "a2604469f3459609",
      "flags": 0,
      "text": "Ralamasse réfléchit intensément..."
    },
    {
      "index": 15,
      "id": "msg_sub087_system_05",
      "hash": "a2604369f3459456",
      "flags": 0,
      "text": "Ralamasse semble réaliser seulement maintenant\\nque vous êtes là..."
    },
    {
      "index": 16,
      "id": "msg_sub087_system_06",
      "hash": "a2604269f34592a3",
      "flags": 0,
      "text": "Ralamasse vous observe du coin de l’œil..."
    },
    {
      "index": 17,
      "id": "msg_sub087_system_07",
      "hash": "a2604169f34590f0",
      "flags": 0,
      "text": "Ralamasse commence à s’intéresser à vous..."
    },
    {
      "index": 18,
      "id": "msg_sub087_system_08",
      "hash": "a2605069f345aa6d",
      "flags": 0,
      "text": "Ralamasse semble s’habituer à votre présence..."
    },
    {
      "index": 19,
      "id": "msg_sub087_system_09",
      "hash": "a2604f69f345a8ba",
      "flags": 0,
      "text": "Ralamasse a l’air plutôt contente..."
    },
    {
      "index": 20,
      "id": "msg_sub087_system_10",
      "hash": "a25cc269f342834c",
      "flags": 0,
      "text": "Ralamasse a l’air contente d’être avec vous !"
    },
    {
      "index": 21,
      "id": "msg_sub087_system_11",
      "hash": "a25cc369f34284ff",
      "flags": 0,
      "text": "Vous avez passé un moment super relax\\navec Ralamasse !"
    },
    {
      "index": 22,
      "id": "msg_sub087_middle_f_07",
      "hash": "69183d2fbfcbb62f",
      "flags": 0,
      "text": "Merci d’avoir gardé Ralamasse ! Tiens, voici\\nun petit quelque chose pour te remercier."
    },
    {
      "index": 23,
      "id": "msg_sub087_system_12",
      "hash": "a25cc469f34286b2",
      "flags": 0,
      "text": "La dame vous offre [VAR INARTFRA(0001)][VAR ITEMBAG(0001)] !"
    },
    {
      "index": 24,
      "id": "msg_sub087_middle_f_08",
      "hash": "6918422fbfcbbeae",
      "flags": 0,
      "text": "Je ferai peut-être de nouveau appel à tes\\nservices, si ça t’intéresse !"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_087_max",
      "hash": "48df59edae2527ff"
    }
  ]
}
