  "lines": [
    {
      "index": 0,
      "id": "msg_main0890_musasi_01",
      "hash": "ef301e11683d2b10",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie :[VAR COLOR(0000)] Tu vas nous laisser passer, oui ?!"
    },
    {
      "index": 1,
      "id": "msg_main0890_rocketm_01",
      "hash": "9611c17128a694eb",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Sbire : [VAR COLOR(0000)]Nan ! Y’a que les gens qu’ont un\\nlaissez-passer qui peuvent entrer !"
    },
    {
      "index": 2,
      "id": "msg_main0890_kojiro_01",
      "hash": "4e00beb778c8aafe",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James : [VAR COLOR(0000)]Allez, quoi, laisse-nous passer !"
    },
    {
      "index": 3,
      "id": "msg_main0890_musasi_02",
      "hash": "ef302111683d3029",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie :[VAR COLOR(0000)] Je vais t’en donner, du laissez-passer !\\nEt mon pied au derrière, ça t’irait ?!"
    },
    {
      "index": 4,
      "id": "msg_main0890_musasi_03",
      "hash": "ef302011683d2e76",
      "flags": 0,
      "text": "T’es bouché ou quoi ?\\nDé-ga-ge !"
    },
    {
      "index": 5,
      "id": "msg_main0890_kojiro_02",
      "hash": "4e00bdb778c8a94b",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James :[VAR COLOR(0000)] Bah ?![VAR COLOR(0009)] [VAR COLOR(0000)]Jessie ! Attends-moi, au moins !"
    },
    {
      "index": 6,
      "id": "msg_main0890_stop_01",
      "hash": "58540270d3db1c1a",
      "flags": 0,
      "text": "Moi... J’suis un garde.\\c\\nLes nabots super louches, j’les laisse pas passer !"
    },
    {
      "index": 7,
      "id": "msg_main0890_stop_02",
      "hash": "58540170d3db1a67",
      "flags": 0,
      "text": "*Eurg*"
    },
    {
      "index": 8,
      "id": "msg_main0890_stop_03",
      "hash": "58540070d3db18b4",
      "flags": 4,
      "text": "Il semble avoir perdu connaissance..."
    }
  ],
