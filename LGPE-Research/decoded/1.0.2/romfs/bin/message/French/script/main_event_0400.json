    },
    {
      "index": 1,
      "id": "msg_main0400_sailor_02",
      "hash": "4d9b65f4be6bb486",
      "flags": 0,
      "text": "L’Océane vous souhaite la bienvenue !\\c\\nAvant de monter, il faut toutefois me montrer\\nvotre passe, jeune mousse !"
    },
    {
      "index": 2,
      "id": "msg_main0400_sys_01",
      "hash": "0c44b0c349338b86",
      "flags": 0,
      "text": "Vous montrez votre Passe Bateau !"
    },
    {
      "index": 3,
      "id": "msg_main0400_sailor_03",
      "hash": "4d9b66f4be6bb639",
      "flags": 0,
      "text": "Parfait ! Bienvenue à bord !\\c\\nOh, et félicitations ! Vous êtes notre centième\\npassager, aujourd’hui !\\c\\nTenez, un petit cadeau pour fêter ça. Avec ceci,\\nvous allez pouvoir crâner au bord de la piscine !"
    },
    {
      "index": 4,
      "id": "msg_main0400_sys_02",
      "hash": "0c44afc3493389d3",
      "flags": 0,
      "text": "Vous recevez une [VAR COLOR(0006)]Tenue de Marin[VAR COLOR(0000)] !"
    },
    {
      "index": 5,
      "id": "msg_main0400_sys_04",
      "hash": "0c44b5c349339405",
      "flags": 0,
      "text": "Vous rangez la [VAR COLOR(0006)]Tenue de Marin [VAR COLOR(0000)]dans votre\\nMalle à Costumes."
    },
    {
      "index": 6,
      "id": "msg_main0400_sailor_04",
