{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_fld_hiden_01",
      "hash": "c3075734bbf2e150",
      "flags": 0,
      "text": "Cet arbuste semble pouvoir être coupé.\\nVoulez-vous utiliser la TS Tranchage ?"
    },
    {
      "index": 1,
      "id": "msg_fld_hiden_02",
      "hash": "c3075a34bbf2e669",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] découpe tout avec Tranchage !"
    },
    {
      "index": 2,
      "id": "msg_fld_hiden_03",
      "hash": "c3075934bbf2e4b6",
      "flags": 0,
      "text": "Cet arbuste semble pouvoir être coupé."
    },
    {
      "index": 3,
      "id": "msg_fld_hiden_04",
      "hash": "c3075c34bbf2e9cf",
      "flags": 0,
      "text": "Tranchage ne sert à rien, ici !"
    },
    {
      "index": 4,
      "id": "msg_fld_hiden_05",
      "hash": "c3075b34bbf2e81c",
      "flags": 0,
      "text": "Ce bloc a l’air très lourd !\\nVoulez-vous utiliser la TS Main-Forte ?"
    },
    {
      "index": 5,
      "id": "msg_fld_hiden_06",
      "hash": "c3075e34bbf2ed35",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] peut maintenant pousser\\nles blocs grâce à Main-Forte !"
    },
    {
      "index": 6,
      "id": "msg_fld_hiden_07",
      "hash": "c3075d34bbf2eb82",
      "flags": 0,
      "text": "Ce bloc a l’air très lourd... Il devrait toutefois\\nêtre possible de le déplacer en le poussant fort."
    },
    {
      "index": 7,
      "id": "msg_fld_hiden_08",
      "hash": "c3076034bbf2f09b",
      "flags": 0,
      "text": "Main-Forte permet de déplacer le bloc !"
    },
    {
      "index": 8,
      "id": "msg_fld_hiden_19",
      "hash": "c303eb34bbeff3f5",
      "flags": 0,
      "text": "Le mur est descendu ! Vous pouvez passer !"
    },
    {
      "index": 9,
      "id": "msg_fld_hiden_20",
      "hash": "c3006c34bbece651",
      "flags": 0,
      "text": "*Clic*"
    },
    {
      "index": 10,
      "id": "msg_fld_hiden_09",
      "hash": "c3075f34bbf2eee8",
      "flags": 0,
      "text": "L’eau ondule doucement...\\nVoulez-vous utiliser la TS Navigation ?"
    },
    {
      "index": 11,
      "id": "msg_fld_hiden_10",
      "hash": "c303f234bbefffda",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] utilise Navigation !"
    },
    {
      "index": 12,
      "id": "msg_fld_hiden_11",
      "hash": "c303f334bbf0018d",
      "flags": 4,
      "text": "Impossible d’utiliser Navigation ici..."
    },
    {
      "index": 13,
      "id": "msg_fld_hiden_12",
      "hash": "c303f034bbeffc74",
      "flags": 0,
      "text": "L’eau ondule doucement..."
    },
    {
      "index": 14,
      "id": "msg_fld_hiden_13",
      "hash": "c303f134bbeffe27",
      "flags": 4,
      "text": "Il fait aussi sombre qu’en pleine nuit...\\nVoulez-vous utiliser la TS Lumière ?"
    },
    {
      "index": 15,
      "id": "msg_fld_hiden_14",
      "hash": "c303ee34bbeff90e",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] éclaire les alentours\\ngrâce à Lumière !"
    },
    {
      "index": 16,
      "id": "msg_fld_hiden_17",
      "hash": "c303ed34bbeff75b",
      "flags": 4,
      "text": "Il fait aussi sombre qu’en pleine nuit... Il va être\\ndifficile d’avancer dans ces conditions..."
    },
    {
      "index": 17,
      "id": "msg_fld_hiden_18",
      "hash": "c303ea34bbeff242",
      "flags": 0,
      "text": "Ça ne sert à rien, ici..."
    },
    {
      "index": 18,
      "id": "msg_fld_hiden_15",
      "hash": "c303ef34bbeffac1",
      "flags": 4,
      "text": "Utiliser la TS Envol pour vous rendre là-bas ?"
    },
    {
      "index": 19,
      "id": "msg_fld_hiden_16",
      "hash": "c303ec34bbeff5a8",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] s’élève dans les airs grâce\\nà Envol !"
    },
    {
      "index": 20,
      "id": "msg_fld_select_01",
      "hash": "4eb6529034653db6",
      "flags": 4,
      "text": "Oui"
    },
    {
      "index": 21,
      "id": "msg_fld_select_02",
      "hash": "4eb6519034653c03",
      "flags": 0,
      "text": "Non"
    },
    {
      "index": 22,
      "id": "msg_fld_ev_spray_01",
      "hash": "5c28fa0044bd5c69",
      "flags": 0,
      "text": "L’effet du répulsif s’est dissipé."
    },
    {
      "index": 23,
      "id": "msg_fld_ev_spray_02",
      "hash": "5c28f70044bd5750",
      "flags": 0,
      "text": "L’effet du répulsif s’est dissipé.\\nVoulez-vous en utiliser un autre ?"
    },
    {
      "index": 24,
      "id": "msg_fld_ev_spray_03",
      "hash": "5c28f80044bd5903",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] utilise\\n[VAR INARTFRA(0001)][VAR ITEMBAG(0001)] !"
    },
    {
      "index": 25,
      "id": "msg_fld_ev_bookshelf_01",
      "hash": "d2e186b675233e1f",
      "flags": 0,
      "text": "C’est rempli de livres et d’albums photo\\nsur les Pokémon."
    },
    {
      "index": 26,
      "id": "msg_fld_ev_kowaserurock_01",
      "hash": "82155501d67638d0",
      "flags": 0,
      "text": "Ces rochers ont l’air bien solides...\\c\\nPeut-être qu’un Pokémon assez puissant\\npourrait les briser ?"
    },
    {
      "index": 27,
      "id": "msg_fld_ev_tv_common_01",
      "hash": "5f755c2798a62f24",
      "flags": 4,
      "text": "Une dame présente le journal télévisé\\naccompagnée de son Pokémon !"
    },
    {
      "index": 28,
      "id": "msg_fld_ev_oserurock_01",
      "hash": "2d2b876ebccb41e5",
      "flags": 0,
      "text": "Ce rocher a l’air extrêmement lourd...\\c\\nPeut-être qu’un Pokémon assez musclé pourrait\\nle déplacer ?"
    },
    {
      "index": 29,
      "id": "msg_egg_event_01",
      "hash": "cc883b93ea002f97",
      "flags": 0,
      "text": "... Tiens ?"
    },
    {
      "index": 30,
      "id": "msg_ride_check_01",
      "hash": "6dc3493c009990b8",
      "flags": 0,
      "text": "Voulez-vous appeler Tauros ?"
    },
    {
      "index": 31,
      "id": "msg_ride_check_02",
      "hash": "6dc34c3c009995d1",
      "flags": 0,
      "text": "Voulez-vous appeler Mackogneur ?"
    },
    {
      "index": 32,
      "id": "msg_ride_check_03",
      "hash": "6dc34b3c0099941e",
      "flags": 0,
      "text": "Voulez-vous appeler Sharpedo ?"
    },
    {
      "index": 33,
      "id": "msg_ride_check_ng_01",
      "hash": "6d36fe6fcfb55062",
      "flags": 4,
      "text": "Il n’y a pas assez de place pour appeler\\ncette Poké Monture ici."
    },
    {
      "index": 34,
      "id": "msg_fld_ev_colon_01",
      "hash": "205807eddd52f34f",
      "flags": 0,
      "text": "L’effet du Parfum s’est dissipé."
    },
    {
      "index": 35,
      "id": "msg_fld_ev_colon_02",
      "hash": "205808eddd52f502",
      "flags": 0,
      "text": "L’effet du Parfum s’est dissipé.\\nVoulez-vous en utiliser un autre ?"
    },
    {
      "index": 36,
      "id": "msg_fld_ev_boxfull_01",
      "hash": "9442742ebe9d881a",
      "flags": 0,
      "text": "Malheureusement, votre Boîte Pokémon est\\npleine... Revenez quand vous y aurez fait\\r\\nde la place !"
    },
    {
      "index": 37,
      "id": "msg_fld_ev_no_push_01",
      "hash": "55f78515b56260be",
      "flags": 4,
      "text": "Impossible de le pousser plus loin !"
    },
    {
      "index": 38,
      "id": "msg_fld_ev_no_push_02",
      "hash": "55f78415b5625f0b",
      "flags": 4,
      "text": "Impossible de pousser sous cet angle !"
    }
  ],
