    {
      "index": 0,
      "id": "msg_town005_kanban_01",
      "hash": "e9b56ce052d8e502",
      "flags": 0,
      "text": "Lavanville\\n« Le pourpre de la noblesse »"
    },
    {
      "index": 1,
      "id": "msg_town005_kanban_02",
      "hash": "e9b56be052d8e34f",
      "flags": 0,
      "text": "« Nul n’est invisible devant l’objectif\\ndu tout nouveau Scope Sylphe ! »\\r\\n— Sylphe SARL"
    },
    {
      "index": 2,
      "id": "msg_town005_kanban_03",
      "hash": "e9b56ae052d8e19c",
      "flags": 0,
      "text": "Maison Pokémon\\n« Centre de bénévolat de Lavanville »"
    },
    {
      "index": 3,
      "id": "msg_town005_kanban_04",
      "hash": "e9b569e052d8dfe9",
      "flags": 0,
      "text": "Tour Pokémon\\n« Paix à l’âme des Pokémon »"
    },
    {
      "index": 4,
      "id": "msg_town005_juveniles_01_01",
      "hash": "dd108a5f7ce63432",
      "flags": 0,
      "text": "Crois-tu aux fantômes ?"
    },
    {
      "index": 5,
      "id": "msg_town005_juveniles_01_02",
      "hash": "dd10895f7ce6327f",
      "flags": 0,
      "text": "Vraiment ? Il en faut..."
    },
    {
      "index": 6,
      "id": "msg_town005_juveniles_01_03",
      "hash": "dd10885f7ce630cc",
      "flags": 0,
      "text": "T’as raison. La main toute blanche sur ton\\népaule est probablement en plastique..."
    },
    {
      "index": 7,
      "id": "msg_town005_adultm_01",
      "hash": "85160d0b0641adba",
      "flags": 0,
      "text": "Cette ville est connue pour son cimetière\\nde Pokémon.\\c\\nLa Tour Pokémon en est le lieu de recueillement."
    },
    {
      "index": 8,
      "id": "msg_town005_youngm_01",
      "hash": "992c8d4ceabdd3c2",
      "flags": 0,
      "text": "Des fantômes sont apparus dans la Tour Pokémon.\\c\\nCe doivent être les esprits des Pokémon victimes\\nde la Team Rocket."
    },
    {
      "index": 9,
      "id": "msg_town005_oldf_01",
      "hash": "2d0312137a06f17c",
      "flags": 4,
      "text": "Ah... J’adore l’odeur de l’encens.\\nC’est tellement apaisant !"
    },
    {
      "index": 10,
      "id": "msg_town005_poke_01",
      "hash": "575f74472b704770",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Nidoran♀ :[VAR COLOR(0000)] Dodoran !"
    },
    {
      "index": 11,
      "id": "msg_town005_childf_01",
      "hash": "e3b08901e734d73f",
      "flags": 4,
      "text": "On m’a dit qu’il fallait être bien sage dans\\nla Tour Pokémon !"
    }
  ],
