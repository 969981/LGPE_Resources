{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0430_captain_01",
      "hash": "474d4bf0c26a7e54",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitaine :[VAR COLOR(0000)] *Blorf*\\nJ’suis pas bien...\\c\\n*Burp*"
    },
    {
      "index": 1,
      "id": "msg_main0430_sys_01",
      "hash": "e5d62e6437bebe1b",
      "flags": 0,
      "text": "Vous frottez le dos du capitaine !"
    },
    {
      "index": 2,
      "id": "msg_main0430_sys_03",
      "hash": "e5d6306437bec181",
      "flags": 0,
      "text": "C’est bon...\\nÇa va aller..."
    },
    {
      "index": 3,
      "id": "msg_main0430_captain_02",
      "hash": "474d4ef0c26a836d",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitaine :[VAR COLOR(0000)] Merci, jeune mousse !\\nÇa va beaucoup mieux."
    },
    {
      "index": 4,
      "id": "msg_main0430_captain_13",
      "hash": "4749c5f0c26764cb",
      "flags": 0,
      "text": "Mille sabords ! Toi aussi, tu es venu[VAR GENDBR(00FF,0100)]e apprendre\\nune Technique Secrète ?\\c\\nPas de problème, voyons cela."
    },
    {
      "index": 5,
      "id": "msg_main0430_partner_a_01",
      "hash": "89fec1e6e8f7587a",
      "flags": 0,
      "text": "Pika !"
    },
    {
      "index": 6,
      "id": "msg_main0430_partner_b_01",
      "hash": "e333820030487eed",
      "flags": 0,
      "text": "Vo ! Évo !"
    },
    {
      "index": 7,
      "id": "msg_main0430_captain_07",
      "hash": "474d49f0c26a7aee",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitaine :[VAR COLOR(0000)] Ho ho ho ! Je suis désolé pour ton\\n[VAR POKNAME(0002)], mais les Techniques Secrètes\\r\\nne peuvent être apprises que par les humains !"
    },
    {
      "index": 8,
      "id": "msg_main0430_captain_08",
      "hash": "474d44f0c26a726f",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitaine :[VAR COLOR(0000)] Quoi ? Tu tiens absolument à\\nl’apprendre ?"
    },
    {
      "index": 9,
      "id": "msg_main0430_captain_14",
      "hash": "4749caf0c2676d4a",
      "flags": 0,
      "text": "Ben ça alors, c’est bien la première fois que\\nje rencontre un Pokémon qui veut apprendre\\r\\nune Technique Secrète, et pourtant, j’en ai vu,\\r\\ndu pays !"
    },
    {
      "index": 10,
      "id": "msg_main0430_captain_12",
      "hash": "4749c4f0c2676318",
      "flags": 0,
      "text": "Que d’ardeur !\\c\\nTrès bien, dans ce cas, je vais lui enseigner\\nma Technique Secrète !"
    },
    {
      "index": 11,
      "id": "msg_main0430_captain_03",
      "hash": "474d4df0c26a81ba",
      "flags": 4,
      "text": "Alors, viens par ici..."
    },
    {
      "index": 12,
      "id": "msg_main0430_captain_04",
      "hash": "474d48f0c26a793b",
      "flags": 0,
      "text": "Regarde bien comment je fais !"
    },
    {
      "index": 13,
      "id": "msg_main0430_captain_09",
      "hash": "474d43f0c26a70bc",
      "flags": 0,
      "text": "..."
    },
    {
      "index": 14,
      "id": "msg_main0430_captain_10",
      "hash": "4749c6f0c267667e",
      "flags": 0,
      "text": "[~ 14]"
    },
    {
      "index": 15,
      "id": "msg_main0430_captain_11",
      "hash": "4749c7f0c2676831",
      "flags": 0,
      "text": "Bonzaï !!!"
    },
    {
      "index": 16,
      "id": "msg_main0430_partner_a_02",
      "hash": "89fec0e6e8f756c7",
      "flags": 0,
      "text": "[~ 16]"
    },
    {
      "index": 17,
      "id": "msg_main0430_partner_b_02",
      "hash": "e3337f00304879d4",
      "flags": 0,
      "text": "[~ 17]"
    },
    {
      "index": 18,
      "id": "msg_main0430_sys_02",
      "hash": "e5d62f6437bebfce",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] a appris la[VAR COLOR(0006)] TS Tranchage[VAR COLOR(0000)] !"
    },
    {
      "index": 19,
      "id": "msg_main0430_captain_05",
      "hash": "474d47f0c26a7788",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitaine :[VAR COLOR(0000)] Nom d’un petit bonhomme !\\nC’est qu’il a vraiment retenu la leçon !"
    },
    {
      "index": 20,
      "id": "msg_main0430_captain_15",
      "hash": "4749cbf0c2676efd",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitaine :[VAR COLOR(0000)] Il ira loin, ton [VAR POKNAME(0002)] !\\c\\nMaintenant que je lui ai enseigné Tranchage,\\nil va pouvoir abattre les arbustes qui te barrent\\r\\nle chemin.\\c\\nTu devrais essayer sur ceux qu’on trouve\\nà Carmin sur Mer."
    },
    {
      "index": 21,
      "id": "msg_main0430_captain_06",
      "hash": "474d4af0c26a7ca1",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Capitaine :[VAR COLOR(0000)] L’Océane va lever l’ancre !\\c\\nBon vent ! On se reverra peut-être un jour\\nà Carmin sur Mer !"
    },
    {
      "index": 22,
      "id": "msg_seaman1_01_p05_cave_d0308",
      "hash": "5f5346594f04464d",
      "flags": 0,
      "text": "[~ 22]"
    }
  ],
