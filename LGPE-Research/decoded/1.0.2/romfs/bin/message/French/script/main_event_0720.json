    {
      "index": 11,
      "id": "msg_main0720_musashi_02",
      "hash": "71686caf2e386c25",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie :[VAR COLOR(0000)] Oh ça va, hein ! Pas la peine de faire\\nt[VAR GENDBR(00FF,0A0A)]on crâneura bêcheuse juste parce que ton équipe\\r\\nest un tout p’tit peu balèze !"
    },
    {
      "index": 12,
      "id": "msg_main0720_kojiro_02",
      "hash": "fea20f2f34fd4671",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James :[VAR COLOR(0000)] Ouais, d’abord ! Tu vas voir, on va te..."
