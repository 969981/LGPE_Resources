    {
      "index": 1,
      "id": "msg_main0720_musashi_01",
      "hash": "716869af2e38670c",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie :[VAR COLOR(0000)] Hé ! Je te reconnais ! T’es l[VAR GENDBR(00FF,0A09)]e morveuxa morveuse\\ndu Mont Sélénite !"
    },
    {
      "index": 2,
      "id": "msg_main0720_musashi_04",
      "hash": "716866af2e3861f3",
      "flags": 0,
      "text": "Qu’est-ce que tu fiches ici ?!"
    },
    {
      "index": 3,
      "id": "msg_main0720_select_01",
      "hash": "6d0c15488af76bc0",
      "flags": 0,
      "text": "Je viens chercher Osselait."
    },
    {
      "index": 4,
      "id": "msg_main0720_select_02",
      "hash": "6d0c18488af770d9",
      "flags": 0,
      "text": "Je veux rejoindre la Team Rocket !"
    },
    {
      "index": 5,
      "id": "msg_main0720_musashi_05",
      "hash": "716865af2e386040",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie :[VAR COLOR(0000)] Hein ? Osselait ? Bah, euh...\\nT’arrives un peu tard, on l’a déjà refilé au boss."
    },
    {
      "index": 6,
      "id": "msg_main0720_musashi_06",
      "hash": "716868af2e386559",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie :[VAR COLOR(0000)] Vraiment ?! Super !\\nAvec joie ! Tiens, voilà ton unif...\\c\\n... Eh ! Tu me prends pour une idiote, ou quoi ?"
    },
    {
      "index": 7,
      "id": "msg_main0720_musashi_07",
      "hash": "716867af2e3863a6",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Jessie :[VAR COLOR(0000)] Laisse-moi te dire une bonne chose :\\njamais tu n’arriveras jusqu’au boss !"
    },
    {
      "index": 8,
      "id": "msg_main0720_kojiro_01",
      "hash": "fea20c2f34fd4158",
      "flags": 0,
      "text": "[VAR COLOR(0009)]James :[VAR COLOR(0000)] Comment as-tu osé nous humilier\\nau Mont Sélénite ?\\c\\nCette fois, tu vas prendre cher !"
