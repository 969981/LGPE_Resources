  "lines": [
    {
      "index": 0,
      "id": "msg_main8110_combat_01",
      "hash": "2862f3f0a8471eb5",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Aldo : [VAR COLOR(0000)]Mon nom est Aldo, du Conseil 4 !"
    },
    {
      "index": 1,
      "id": "msg_main8110_combat_05",
      "hash": "2862eff0a84717e9",
      "flags": 0,
      "text": "Notre passion, à mes Pokémon et à moi,\\nc’est la muscu !"
    },
    {
      "index": 2,
      "id": "msg_main8110_combat_06",
      "hash": "2862ecf0a84712d0",
      "flags": 0,
      "text": "J’ai passé toute ma vie à m’entraîner avec mes\\nPokémon Combat, et c’est pas près de changer !"
    },
    {
      "index": 3,
      "id": "msg_main8110_combat_07",
      "hash": "2862edf0a8471483",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] !"
    },
    {
      "index": 4,
      "id": "msg_main8110_combat_08",
      "hash": "2862faf0a8472a9a",
      "flags": 0,
      "text": "Ton [VAR ITEMPLUR1(00FD,0607)]Pokémonéquipe, j’vais en faire du yaourt !"
    },
    {
      "index": 5,
      "id": "msg_main8110_combat_09",
      "hash": "2862fbf0a8472c4d",
      "flags": 4,
      "text": "À table !"
    },
    {
      "index": 6,
      "id": "msg_shiba_01_p02_cave_d1402",
      "hash": "72418348ba117edb",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main8110_combat_02",
      "hash": "2862f0f0a847199c",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Aldo : [VAR COLOR(0000)]Bien joué !\\nTon prochain adversaire t’attend !"
    },
    {
      "index": 8,
      "id": "msg_main8110_combat_03",
      "hash": "2862f1f0a8471b4f",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Aldo : [VAR COLOR(0000)]J’ai senti la puissance de ta détermination\\njusqu’ici, pendant ton combat contre Olga !"
    },
    {
      "index": 9,
      "id": "msg_main8110_combat_10",
      "hash": "2865f8f0a8495d0b",
      "flags": 0,
      "text": "Mais j’me démonterai pas !\\nLaisse-moi te montrer toute la fougue indomptée\\r\\nde mes Pokémon Combat !"
    },
    {
      "index": 10,
      "id": "msg_main8110_combat_11",
      "hash": "2865f7f0a8495b58",
      "flags": 0,
      "text": "Yah !"
    },
    {
      "index": 11,
      "id": "msg_main8110_combat_04",
      "hash": "2862eef0a8471636",
      "flags": 0,
      "text": "Zut ! Je crois qu’il faut qu’on retourne à la salle,\\nmes Pokémon et moi !\\c\\nVa falloir que je retonifie tout ça !\\nNe t’occupe pas de nous, fonce !"
    }
  ],
