  "lines": [
    {
      "index": 0,
      "id": "msg_main0100_clerkm_01",
      "hash": "cd2960b82837a7d8",
      "flags": 0,
      "text": "Hé ! Tu viens de Bourg Palette ?"
    },
    {
      "index": 1,
      "id": "msg_main0100_clerkm_02",
      "hash": "cd2963b82837acf1",
      "flags": 0,
      "text": "Tu connais le Professeur Chen ?\\c\\nJe devais lui apporter un truc, mais je suis\\ndébordé.\\c\\nEst-ce que tu pourrais me dépanner et lui livrer\\nceci à ma place ?"
    },
    {
      "index": 2,
      "id": "msg_main0100_sys_01",
      "hash": "273c0ce0fcfa18e3",
      "flags": 0,
      "text": "Vous obtenez le [VAR COLOR(0006)]Colis[VAR COLOR(0000)] du Professeur Chen !"
    },
    {
      "index": 3,
      "id": "msg_main0100_clerkm_03",
      "hash": "cd2962b82837ab3e",
      "flags": 0,
      "text": "Merci, tu me sauves la mise !\\nEt passe le bonjour au Professeur de ma part !"
    },
    {
      "index": 4,
      "id": "msg_main0100_clerkm_04",
      "hash": "cd2965b82837b057",
      "flags": 0,
      "text": "[~ 4]"
    },
    {
      "index": 5,
      "id": "msg_main0100_sys_02",
      "hash": "273c0de0fcfa1a96",
      "flags": 0,
      "text": "Voulez-vous aller directement au laboratoire ?"
    }
  ],
