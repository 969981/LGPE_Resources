  "lines": [
    {
      "index": 0,
      "id": "msg_main0920_rocketchief_01",
      "hash": "9d82bf08a6225dfd",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Amos : [VAR COLOR(0000)]Pas un pas de plus !"
    },
    {
      "index": 1,
      "id": "msg_main0920_rival_01",
      "hash": "eea065068af47a9a",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)] :[VAR COLOR(0000)] Quoi ? Encore lui ?!\\nMais, il est plus tenace qu’un Crustabri accroché\\r\\nà son rocher !"
    },
    {
      "index": 2,
      "id": "msg_main0920_rocketchief_02",
      "hash": "9d82bc08a62258e4",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Amos : [VAR COLOR(0000)]Exactement ! Jamais je ne vous laisserai\\natteindre notre chef ! Il faudra d’abord me passer\\r\\nsur le corps !"
    },
    {
      "index": 3,
      "id": "msg_main0920_rival_02",
      "hash": "eea064068af478e7",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)]: [VAR COLOR(0000)]Votre chef ?\\nMais..."
    },
    {
      "index": 4,
      "id": "msg_main0920_rival_03",
      "hash": "eea063068af47734",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] !\\nTu réalises ce que ça veut dire ?!"
    },
    {
      "index": 5,
      "id": "msg_main0920_select_01",
      "hash": "a495754c28984226",
      "flags": 4,
      "text": "Oui ! Aucun doute !"
    },
    {
      "index": 6,
      "id": "msg_main0920_select_02",
      "hash": "a495744c28984073",
      "flags": 0,
      "text": "Giovanni est bien là !"
    },
    {
      "index": 7,
      "id": "msg_main0920_rival_04",
      "hash": "eea062068af47581",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)] : [VAR COLOR(0000)]Le boss de la Team\\nRocket se planque dans ce bâtiment !\\r\\nY’a pas à hésiter !"
    },
    {
      "index": 8,
      "id": "msg_main0920_rival_05",
      "hash": "eea061068af473ce",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)] : [VAR COLOR(0000)][VAR TRNAME(0000)],\\nfonce ! Va t’occuper du boss !\\r\\nJe retiens l’autre guignol !"
    },
    {
      "index": 9,
      "id": "msg_main0920_rival_06",
      "hash": "eea060068af4721b",
      "flags": 4,
      "text": "Il a entendu, le Crustabri ? C’est moi qui vais\\nm’occuper de toi !"
    },
    {
      "index": 10,
      "id": "msg_main0920_rocketchief_03",
      "hash": "9d82bd08a6225a97",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Amos : [VAR COLOR(0000)]Malédiction ! Laisse-moi passer, gamin !\\nJe dois aller prévenir Maître Giovanni !"
    },
    {
      "index": 11,
      "id": "msg_main0920_rival_07",
      "hash": "eea05f068af47068",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)] : [VAR COLOR(0000)][VAR TRNAME(0000)] !\\c\\nFonce, je te dis ! Va écraser le boss de\\nla Team Rocket !"
    },
    {
