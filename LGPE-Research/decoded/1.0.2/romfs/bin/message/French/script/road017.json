    {
      "index": 0,
      "id": "msg_road017_kanban_01",
      "hash": "a226f27247818ecb",
      "flags": 4,
      "text": "Avis !\\nNe jetez pas vos objets n’importe où !"
    },
    {
      "index": 1,
      "id": "msg_road017_kanban_02",
      "hash": "a226f3724781907e",
      "flags": 4,
      "text": "Astuce !\\c\\nDeux Pokémon de la même espèce et de niveaux\\nidentiques peuvent avoir des stats différentes.\\c\\nCes différences s’accentuent avec l’entraînement !"
    },
    {
      "index": 2,
      "id": "msg_road017_kanban_03",
      "hash": "a226f47247819231",
      "flags": 0,
      "text": "[~ 2]"
    },
    {
      "index": 3,
      "id": "msg_road017_kanban_07",
      "hash": "a226f872478198fd",
      "flags": 4,
      "text": "Astuce !\\c\\nPour attraper un Pokémon, lancez votre Poké Ball\\ndans le cercle de couleur.\\c\\nPlus le cercle est petit, plus vous aurez de\\nchances d’effectuer un joli lancer ou un superbe\\r\\nlancer, et donc de réussir la capture !"
    },
    {
      "index": 4,
      "id": "msg_road017_kanban_04",
      "hash": "a226f572478193e4",
      "flags": 0,
      "text": "Route 17\\nCéladopole ⇄ Parmanie"
    },
    {
      "index": 5,
      "id": "msg_road017_kanban_05",
      "hash": "a226f67247819597",
      "flags": 4,
      "text": "Avis !\\c\\nNe jetez pas la console, jetez plutôt des\\nPoké Balls !"
    },
    {
