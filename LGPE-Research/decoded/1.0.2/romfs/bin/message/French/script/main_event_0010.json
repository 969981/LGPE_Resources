  "lines": [
    {
      "index": 0,
      "id": "msg_main0010_rival_04",
      "hash": "53625bfae0fb9c85",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)] : [VAR COLOR(0000)]Yo ! C’est moi !"
    },
    {
      "index": 1,
      "id": "msg_main0010_rival_05",
      "hash": "53625afae0fb9ad2",
      "flags": 0,
      "text": "T’es debout, [VAR TRNAME(0000)] ?\\nJe monte !"
    },
    {
      "index": 2,
      "id": "msg_main0010_rival_01",
      "hash": "536256fae0fb9406",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)] :[VAR COLOR(0000)] Salut !"
    },
    {
      "index": 3,
      "id": "msg_main0010_rival_08",
      "hash": "53625ffae0fba351",
      "flags": 0,
      "text": "Ha ha, tu devrais voir ta tête !\\nTu viens d’émerger, ou quoi ?"
    },
    {
      "index": 4,
      "id": "msg_main0010_rival_02",
      "hash": "536255fae0fb9253",
      "flags": 4,
      "text": "Oooh ! Tu rêvais fort à de petits Pokémon ?\\nFlash info, [VAR GENDBR(00FF,0408)]mon potegirl : arrête de rêvasser,\\r\\nsecoue-toi le popotin... et t’en auras un !\\c\\nT’as oublié, ou quoi ? Aujourd’hui, on doit aller\\nvoir le Professeur Chen pour recevoir\\r\\nnos Pokémon ! C’est le grand jour !\\r\\nOn va enfin devenir [VAR COLOR(0006)]Dresseurs[VAR COLOR(0000)] !"
    },
    {
      "index": 5,
      "id": "msg_main0010_rival_06",
      "hash": "536259fae0fb991f",
      "flags": 4,
      "text": "Ah ! Au fait..."
    },
    {
      "index": 6,
      "id": "msg_main0010_rival_07",
      "hash": "536258fae0fb976c",
      "flags": 0,
      "text": "Je sais pas si t’as vu, mais je t’ai envoyé\\nun e-mail, hier ! Jettes-y un œil avant de partir,\\r\\nsi tu l’as pas encore lu."
    },
    {
      "index": 7,
      "id": "msg_main0010_rival_03",
      "hash": "536254fae0fb90a0",
      "flags": 0,
      "text": "Bon, je fonce !\\nJe t’attends chez le Professeur Chen !"
    }
  ],
