    {
      "index": 1,
      "id": "msg_sub060_poke_01",
      "hash": "93a4082409662c61",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Porygon :[VAR COLOR(0000)] Gongon..."
    },
    {
      "index": 2,
      "id": "msg_sub060_staffm_02",
      "hash": "39520d118b58b6dc",
      "flags": 4,
      "text": "Attends, t’as battu la Team Rocket ?!\\nC’est super ! Merci !\\c\\nTiens, ça te dirait de t’occuper d’un Pokémon\\ncréé par la Sylphe ?"
    },
    {
