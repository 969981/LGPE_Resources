    {
      "index": 4,
      "id": "msg_sub060_staffm_03",
      "hash": "39520e118b58b88f",
      "flags": 0,
      "text": "Regarde, il est tout anguleux ! Il est mignon,\\ntu trouves pas ?"
    },
    {
      "index": 5,
      "id": "msg_sub060_poke_02",
