  "lines": [
    {
      "index": 0,
      "id": "msg_t003r0101_oldm_01_01",
      "hash": "7b5f30ecc4e4e575",
      "flags": 0,
      "text": "Quelle chance j’ai de voir les ossements des\\nmonstres sacrés de jadis !"
    },
    {
      "index": 1,
      "id": "msg_t003r0101_scientist_02_01",
      "hash": "e7c8eb752043ec2a",
      "flags": 0,
      "text": "Nous avons plusieurs fossiles de Pokémon\\npréhistoriques dont nous sommes très fiers !"
    },
    {
      "index": 2,
      "id": "msg_t003r0101_tenji_01_01",
      "hash": "ae23c51d9d7cb43d",
      "flags": 4,
      "text": "Il y a un beau morceau d’ambre qui luit\\nd’un éclat doré !"
    },
    {
      "index": 3,
      "id": "msg_t003r0101_tenji_02_01",
      "hash": "00318501e22c384a",
      "flags": 0,
      "text": "C’est un fossile de Ptéra, un Pokémon\\npréhistorique très rare !"
    },
    {
      "index": 4,
      "id": "msg_t003r0101_tenji_03_01",
      "hash": "ad07b10bf306afbf",
      "flags": 0,
      "text": "C’est un fossile de Kabutops, un Pokémon\\npréhistorique très rare !"
    },
    {
      "index": 5,
      "id": "msg_t003r0101_tenji_04_01",
      "hash": "dcf9c135aace2924",
      "flags": 4,
      "text": "Oooh ! C’est un Pokémon ancien !\\n... Ah bah non, c’est juste une vieille réplique..."
    },
    {
      "index": 6,
      "id": "msg_t003r0101_tenji_05_01",
      "hash": "0a472d3c0d4da7f9",
      "flags": 4,
      "text": "Il y a divers fossiles trouvés sur le Mont Sélénite."
    },
    {
      "index": 7,
      "id": "msg_studym1_03_p01_t003_r0101",
      "hash": "4d50ef9853eab16b",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
