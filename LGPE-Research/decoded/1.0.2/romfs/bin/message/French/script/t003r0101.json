    {
      "index": 10,
      "id": "msg_studym1_03_p04_t003_r0101",
      "hash": "dfa5511cde6f5202",
      "flags": 0,
      "text": "[~ 10]"
    },
    {
      "index": 11,
      "id": "msg_t003r0101_scientist_03_01",
      "hash": "3e2e977cbbad799f",
      "flags": 0,
      "text": "Les secrets de l’espace...\\nLes mystères de la terre...\\c\\nIl y a tant de choses que nous ne comprenons\\npas encore, mais cela doit nous motiver\\r\\nà apprendre davantage !"
    }
