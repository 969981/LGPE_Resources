{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main1200_rival_01",
      "hash": "723f186098a8ef50",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)] : [VAR COLOR(0000)]Mais...\\nPourquoi ça veut pas s’ouvrir ? Ça m’énerve..."
    },
    {
      "index": 1,
      "id": "msg_main1200_rival_02",
      "hash": "723f1b6098a8f469",
      "flags": 0,
      "text": "Gemme Sésame, ouvre-toi !\\n..."
    },
    {
      "index": 2,
      "id": "msg_main1200_rival_03",
      "hash": "723f1a6098a8f2b6",
      "flags": 0,
      "text": "Mouais, je me doutais bien que ça ne risquait\\npas de marcher..."
    },
    {
      "index": 3,
      "id": "msg_main1200_rival_04",
      "hash": "723f1d6098a8f7cf",
      "flags": 4,
      "text": "Ouah !"
    },
    {
      "index": 4,
      "id": "msg_main1200_rival_05",
      "hash": "723f1c6098a8f61c",
      "flags": 0,
      "text": "T’étais là, [VAR TRNAME(0000)] ?!\\nBah, faut prévenir ! Moi je suis là en train de faire\\r\\nl’idiot, je me tape la honte ! Ha ha..."
    },
    {
      "index": 5,
      "id": "msg_main1200_rival_06",
      "hash": "723f1f6098a8fb35",
      "flags": 0,
      "text": "Dis-moi plutôt combien tu as de Badges,\\nmaintenant !"
    },
    {
      "index": 6,
      "id": "msg_main1200_rival_10",
      "hash": "723bb36098a60dda",
      "flags": 0,
      "text": "Sept ?! Han, comme moi !\\nIl ne nous manque plus que celui de Jadielle.\\c\\nMais la porte est fermée à clé...\\nOn devrait peut-être essayer de se renseigner ?"
    },
    {
      "index": 7,
      "id": "msg_main1200_rival_07",
      "hash": "723f1e6098a8f982",
      "flags": 4,
      "text": "À ton avis, à qui on pourrait demander ?"
    },
    {
      "index": 8,
      "id": "msg_main1200_select_01",
      "hash": "4847a94b196d6768",
      "flags": 4,
      "text": "Au Professeur Chen !"
    },
    {
      "index": 9,
      "id": "msg_main1200_select_02",
      "hash": "4847ac4b196d6c81",
      "flags": 4,
      "text": "À [VAR POKNAME(0003)] !"
    },
    {
      "index": 10,
      "id": "msg_main1200_select_03",
      "hash": "4847ab4b196d6ace",
      "flags": 4,
      "text": "Au vieux monsieur, là."
    },
    {
      "index": 11,
      "id": "msg_main1200_oldman_01",
      "hash": "c70dc56b184a5299",
      "flags": 0,
      "text": "[VAR COLOR(0009)]Vieux monsieur :[VAR COLOR(0000)] Quoi ? L’Arène ? Les clés ?\\nJ’sais pas, moi !\\c\\nPourquoi vous m’enquiquinez avec ça ?\\nY’a pas marqué « Champion » sur mon front !"
    },
    {
      "index": 12,
      "id": "msg_main1200_rival_11",
      "hash": "723bb46098a60f8d",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)] : [VAR COLOR(0000)]Ah, euh... Oui, pardon...\\c\\nOn va se renseigner ailleurs. On est bien désolés\\ndu dérangement !"
    },
    {
      "index": 13,
      "id": "msg_main1200_rival_08",
      "hash": "723f216098a8fe9b",
      "flags": 4,
      "text": "Ouais, hein ? C’est ce que je me disais aussi.\\nAllez, on fonce chez le Prof !"
    },
    {
      "index": 14,
      "id": "msg_main1200_poke_01",
      "hash": "463c8e1cd61b3757",
      "flags": 0,
      "text": "Pika ? Pikapi, pika ! Pika, pika !"
    },
    {
      "index": 15,
      "id": "msg_main1200_poke_02",
      "hash": "463c8f1cd61b390a",
      "flags": 4,
      "text": "Évo ? Vo ! Voli ! Évovo, voli."
    },
    {
      "index": 16,
      "id": "msg_main1200_rival_09",
      "hash": "723f206098a8fce8",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)] :[VAR COLOR(0000)] ... Ha ha...\\nOui, carrément...\\c\\nJe sais pas pour toi, mais moi, j’ai rien compris."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_1200_max",
      "hash": "b01f702cfacb0504"
    }
  ]
}
