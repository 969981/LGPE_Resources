{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main2000_rival_01",
      "hash": "4568f4f74cfce003",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)] : [VAR COLOR(0000)]Yo ! T’es là-haut ?"
    },
    {
      "index": 1,
      "id": "msg_main2000_rival_02",
      "hash": "4568f5f74cfce1b6",
      "flags": 0,
      "text": "Je monte !"
    },
    {
      "index": 2,
      "id": "msg_main2000_rival_03",
      "hash": "4568f6f74cfce369",
      "flags": 0,
      "text": "[VAR COLOR(0009)][VAR TRNAME(0001)] : [VAR COLOR(0000)]Alors ?\\nComment se porte le Maître de Kanto, ce matin ?"
    },
    {
      "index": 3,
      "id": "msg_main2000_rival_09",
      "hash": "4568fcf74cfced9b",
      "flags": 0,
      "text": "T’endors pas trop sur tes lauriers, [VAR GENDBR(00FF,0408)]mon potegirl.\\nJe compte bien te détrôner un jour !"
    },
    {
      "index": 4,
      "id": "msg_main2000_rival_04",
      "hash": "4568f7f74cfce51c",
      "flags": 4,
      "text": "Au fait, t’as entendu la rumeur ?!\\nOn raconte qu’un Pokémon super fort est apparu !"
    },
    {
      "index": 5,
      "id": "msg_main2000_sel_01",
      "hash": "8b65dee0045ddfb3",
      "flags": 4,
      "text": "Ah ouais ? Quel genre de Pokémon ?"
    },
    {
      "index": 6,
      "id": "msg_main2000_sel_02",
      "hash": "8b65dfe0045de166",
      "flags": 0,
      "text": "Sérieux ? Faut que je le capture !"
    },
    {
      "index": 7,
      "id": "msg_main2000_rival_05",
      "hash": "4568f8f74cfce6cf",
      "flags": 0,
      "text": "Du genre super fort ! Et méga cool !!!"
    },
    {
      "index": 8,
      "id": "msg_main2000_rival_06",
      "hash": "4568f9f74cfce882",
      "flags": 0,
      "text": "Ha ha ha, tu perds pas le nord, toi !"
    },
    {
      "index": 9,
      "id": "msg_main2000_rival_07",
      "hash": "4568faf74cfcea35",
      "flags": 4,
      "text": "En tout cas, il paraît qu’il traînait près d’[VAR COLOR(0006)]Azuria[VAR COLOR(0000)]..."
    },
    {
      "index": 10,
      "id": "msg_main2000_rival_10",
      "hash": "456bf9f74cff1e59",
      "flags": 4,
      "text": "Il se serait planqué dans une grotte."
    },
    {
      "index": 11,
      "id": "msg_main2000_rival_08",
      "hash": "4568fbf74cfcebe8",
      "flags": 0,
      "text": "Ça te dirait qu’on aille à sa recherche ?\\nGenre, maintenant ?"
    },
    {
      "index": 12,
      "id": "msg_main2000_rival_11",
      "hash": "456bf8f74cff1ca6",
      "flags": 4,
      "text": "Allez, go ! Le premier qui l’attrape a gagné !"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_2000_max",
      "hash": "9104968fcbd7dad1"
    }
  ]
}
