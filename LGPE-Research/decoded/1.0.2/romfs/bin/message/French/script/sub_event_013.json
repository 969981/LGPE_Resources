  "lines": [
    {
      "index": 0,
      "id": "msg_sub013_sister_01",
      "hash": "26f68ca277e78a2c",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] !\\nTu veux savoir si t[VAR ITEMPLUR1(00FD,0202)]ones Pokémon t’aime[VAR ITEMPLUR1(00FD,0200)]nt ?"
    },
    {
      "index": 1,
      "id": "msg_sub013_sister_02",
      "hash": "26f68fa277e78f45",
      "flags": 0,
      "text": "[VAR TRNAME(0000)] !\\nTu veux savoir si t[VAR ITEMPLUR1(00FD,0202)]ones Pokémon t’aime[VAR ITEMPLUR1(00FD,0200)]nt ?"
    },
    {
      "index": 2,
      "id": "msg_sub013_sister_03",
      "hash": "26f68ea277e78d92",
      "flags": 0,
      "text": "Plus un[VAR GENDBR(00FF,0100)]e Dresseu[VAR GENDBR(00FF,0201)]rse prend soin de s[VAR ITEMPLUR1(00FD,0202)]ones Pokémon,\\nplus il[VAR ITEMPLUR1(00FD,0100)]s l’aime[VAR ITEMPLUR1(00FD,0200)]nt en retour !"
    },
    {
      "index": 3,
      "id": "msg_sub013_sister_04",
      "hash": "26f689a277e78513",
      "flags": 4,
      "text": "OK ! Laisse-moi examiner [VAR PKNICK(0001)] !"
    },
    {
      "index": 4,
      "id": "msg_sub013_sister_05",
      "hash": "26f688a277e78360",
      "flags": 4,
      "text": "Oh là là ! [VAR PKNICK(0001)] t’aime beaucoup.\\nÉnormément, même !\\c\\nVous avez vraiment confiance l’un en l’autre !"
    },
    {
      "index": 5,
      "id": "msg_sub013_sister_06",
      "hash": "26f68ba277e78879",
      "flags": 0,
      "text": "[VAR PKNICK(0001)] t’aime beaucoup ! Il espère\\nêtre avec toi pour toujours !"
    },
    {
      "index": 6,
      "id": "msg_sub013_sister_07",
      "hash": "26f68aa277e786c6",
      "flags": 0,
      "text": "[VAR PKNICK(0001)] trouve que tu es quelqu’un de\\nbien !"
    },
    {
      "index": 7,
      "id": "msg_sub013_sister_08",
      "hash": "26f695a277e79977",
      "flags": 0,
      "text": "Vous vous entendez de mieux en mieux au fil\\ndes jours ! Continue sur cette lancée !"
    },
    {
      "index": 8,
      "id": "msg_sub013_sister_09",
      "hash": "26f694a277e797c4",
      "flags": 4,
      "text": "Il commence à s’habituer à ta présence.\\nContinue, tu es sur la bonne voie !"
    },
    {
      "index": 9,
      "id": "msg_sub013_sister_10",
      "hash": "26f307a277e47256",
      "flags": 0,
      "text": "Vous venez à peine de vous rencontrer...\\nCes choses-là prennent du temps !"
    },
    {
      "index": 10,
      "id": "msg_sub013_sister_11",
      "hash": "26f308a277e47409",
      "flags": 4,
      "text": "Oh là là... Pauvre Pokémon... J’ose à peine\\nimaginer combien de fois il a été mis K.O..."
    },
    {
      "index": 11,
      "id": "msg_sub013_sister_12",
      "hash": "26f305a277e46ef0",
      "flags": 0,
      "text": "Mais... mais ça ne va pas de le laisser dans cet\\nétat ?! Cours au Centre Pokémon ! Vite !"
    },
    {
      "index": 12,
      "id": "msg_woman1_01_p11_t001_r0201",
