  "lines": [
    {
      "index": 0,
      "id": "msg_sub070_pokemaniac_01",
      "hash": "8107bdd0a1e3bea9",
      "flags": 0,
      "text": "J-j’ai la berlue ! Le Maître ! Le Maître est ici,\\ndevant mes yeux !\\c\\nC-c’est trop d’honneur !"
    },
    {
      "index": 1,
      "id": "msg_sub070_pokemaniac_02",
      "hash": "8107bad0a1e3b990",
      "flags": 0,
      "text": "J-je suis joailler... J’ai en ma possession des\\ngemmes rares que j’ai trouvées à l’étranger.\\c\\nLà-bas, on les appelle des Méga-Gemmes.\\nElles sont très précieuses, mais à vous, Maître,\\r\\nje veux bien les vendre à p-prix réduit !"
    },
    {
      "index": 2,
      "id": "msg_sub070_select_01",
      "hash": "f24dce3d0034442f",
      "flags": 0,
      "text": "Dardargnite"
    },
    {
      "index": 3,
      "id": "msg_sub070_select_02",
      "hash": "f24dcf3d003445e2",
      "flags": 0,
      "text": "Roucarnagite"
    },
    {
      "index": 4,
      "id": "msg_sub070_select_03",
      "hash": "f24dd03d00344795",
      "flags": 4,
      "text": "Alakazamite"
    },
    {
      "index": 5,
      "id": "msg_sub070_select_04",
      "hash": "f24dc93d00343bb0",
      "flags": 0,
      "text": "Flagadossite"
    },
    {
      "index": 6,
      "id": "msg_sub070_select_05",
      "hash": "f24dca3d00343d63",
      "flags": 4,
      "text": "Ectoplasmite"
    },
    {
