  "lines": [
    {
      "index": 0,
      "id": "msg_sub073_beasttamer_01",
      "hash": "b42e6c6f487cb7ba",
      "flags": 0,
      "text": "Ho ho ho ! Mais regardez-moi donc\\nce petit [VAR POKNAME(0003)] ! Quel regard vif !\\c\\nIl semble tout à fait apte à apprendre mes\\ncapacités abracadabrantesques !\\c\\nAllons, ne fais pas de chichis, tu veux que je les\\nlui enseigne, n’est-ce pas ?"
    },
    {
      "index": 1,
      "id": "msg_sub073_beasttamer_02",
      "hash": "b42e6b6f487cb607",
      "flags": 0,
      "text": "Tu veux que j’enseigne mes capacités\\nabracadabrantesques à ton [VAR POKNAME(0003)] ?"
    },
    {
      "index": 2,
      "id": "msg_sub073_beasttamer_03",
      "hash": "b42e6a6f487cb454",
      "flags": 0,
      "text": "J’aurais bien voulu hein, sincèrement...\\nMais je n’ai pas l’impression qu’il en ait besoin !"
    },
    {
      "index": 3,
      "id": "msg_sub073_beasttamer_04",
      "hash": "b42e696f487cb2a1",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] veut apprendre\\n[VAR MOVE(0001)].\\c\\nVoulez-vous oublier une capacité pour apprendre\\n[VAR MOVE(0001)] ?"
    },
    {
      "index": 4,
      "id": "msg_sub073_beasttamer_05",
      "hash": "b42e686f487cb0ee",
      "flags": 4,
      "text": "Il apprend [VAR MOVE(0001)] !"
    },
    {
      "index": 5,
      "id": "msg_sub073_beasttamer_06",
      "hash": "b42e676f487caf3b",
      "flags": 0,
      "text": "1[WAIT 20], 2[WAIT 20], [WAIT 20]... [WAIT 20]... Tadaaa ![VAR SFX(0003)][VAR SFX(0000)]\\c\\n[VAR PKNICK(0000)] oublie [VAR MOVE(0002)].\\c\\nEt...\\c\\nIl apprend [VAR MOVE(0001)] ![VAR SFX(0004)][VAR SFX(0001)]"
    },
    {
      "index": 6,
      "id": "msg_sub073_beasttamer_07",
      "hash": "b42e666f487cad88",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] n’a pas appris\\n[VAR MOVE(0001)]."
    },
    {
      "index": 7,
      "id": "msg_sub073_beasttamer_08",
      "hash": "b42e656f487cabd5",
      "flags": 4,
      "text": "Avec ça, je te garantis que tu vas nouer des liens\\nindéfectibles avec ton Pokémon !"
    },
    {
      "index": 8,
      "id": "msg_sub073_beasttamer_09",
      "hash": "b42e646f487caa22",
      "flags": 0,
      "text": "C’est bien dommage... Si tu changes d’avis,\\ntu sais où me trouver !"
    },
    {
      "index": 9,
      "id": "msg_sub073_beasttamer_10",
      "hash": "b42ae76f48799fe4",
      "flags": 0,
      "text": "Quelle capacité veux-tu qu’il apprenne ?"
    },
    {
      "index": 10,
      "id": "msg_sub073_pikachu_waza01",
