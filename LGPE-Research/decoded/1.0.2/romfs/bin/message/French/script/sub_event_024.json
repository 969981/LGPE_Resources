{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub024_researcher_01",
      "hash": "d427d40043ea8c98",
      "flags": 0,
      "text": "Salut !\\c\\nJe suis un scientifique très sérieux !\\nJ’étudie les fossiles de Pokémon anciens !\\c\\nDis-moi, tu n’aurais pas un fossile pour moi ?"
    },
    {
      "index": 1,
      "id": "msg_sub024_select_01",
      "hash": "9c5bbb480ccf64a2",
      "flags": 0,
      "text": "Nautile"
    },
    {
      "index": 2,
      "id": "msg_sub024_select_02",
      "hash": "9c5bba480ccf62ef",
      "flags": 0,
      "text": "Fossile Dôme"
    },
    {
      "index": 3,
      "id": "msg_sub024_select_03",
      "hash": "9c5bb9480ccf613c",
      "flags": 0,
      "text": "Vieil Ambre"
    },
    {
      "index": 4,
      "id": "msg_sub024_select_04",
      "hash": "9c5bb8480ccf5f89",
      "flags": 0,
      "text": "Non..."
    },
    {
      "index": 5,
      "id": "msg_sub024_researcher_02",
      "hash": "d427d70043ea91b1",
      "flags": 0,
      "text": "C’est bien dommage !"
    },
    {
      "index": 6,
      "id": "msg_sub024_researcher_03",
      "hash": "d427d60043ea8ffe",
      "flags": 0,
      "text": "C’est une réussite !\\c\\nTon fossile a permis de reconstituer\\nun [VAR POKNAME(0004)] !"
    },
    {
      "index": 7,
      "id": "msg_sub024_sys_01",
      "hash": "0fa5772ce07503fd",
      "flags": 0,
      "text": "Vous récupérez [VAR POKNAME(0004)] de la part\\ndu scientifique !"
    },
    {
      "index": 8,
      "id": "msg_sub024_researcher_04",
      "hash": "d427d90043ea9517",
      "flags": 4,
      "text": "Oh ! Ce [VAR ITEM2(0002)] est un fossile\\n[VAR VARFRA03(0001)][VAR POKNAME(0001)], un Pokémon éteint !\\c\\nMa machine va permettre de reconstituer cet\\nancien Pokémon ! Ça t’intéresse ?"
    },
    {
      "index": 9,
      "id": "msg_sub024_researcher_05",
      "hash": "d427d80043ea9364",
      "flags": 4,
      "text": "Allez !\\nDépêche-toi et donne-moi ton échantillon !"
    },
    {
      "index": 10,
      "id": "msg_sub024_sys_02",
      "hash": "0fa5742ce074fee4",
      "flags": 0,
      "text": "Malgré vos doutes, vous avez confié votre\\n[VAR ITEM2(0002)] au scientifique !"
    },
    {
      "index": 11,
      "id": "msg_sub024_researcher_06",
      "hash": "d427db0043ea987d",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_sub024_researcher_07",
      "hash": "d427da0043ea96ca",
      "flags": 4,
      "text": "Allez ! À la prochaine !"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_024_max",
      "hash": "93371b7482b7e5d0"
    }
  ]
}
