    {
      "index": 5,
      "id": "msg_t007r0503_game_02",
      "hash": "92d1723fbd58dcd8",
      "flags": 4,
      "text": "Un jeu de rôle ! Super... mais vous n’avez pas\\nle temps d’y jouer."
