    {
      "index": 2,
      "id": "msg_t007r0503_jevenilem_02",
      "hash": "e4384e0ab442ecd3",
      "flags": 0,
      "text": "Cool ! Un Spectrum !\\nJ’adore ce Pokémon !\\c\\nQue... Hein ?!\\c\\nSpectrum s’est transformé en un autre Pokémon !"
    },
    {
      "index": 3,
      "id": "msg_t007r0503_chilef_01",
      "hash": "97b8808b2d55e818",
      "flags": 0,
      "text": "Pour savoir si l’un de tes Pokémon appartenait\\navant à un autre Dresseur, regarde son nº ID !"
    },
    {
      "index": 4,
      "id": "msg_t007r0503_game_01",
      "hash": "92d1753fbd58e1f1",
      "flags": 4,
      "text": "Une Nintendo Switch !"
