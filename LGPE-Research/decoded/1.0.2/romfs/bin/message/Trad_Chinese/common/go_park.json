      "flags": 0,
      "text": "GO Park 19"
    },
    {
      "index": 33,
      "id": "go_park_01_30",
      "hash": "d4faede3b2d18398",
      "flags": 0,
      "text": "GO Park 20"
    },
    {
      "index": 34,
      "id": "go_park_01_20",
      "hash": "d4fe73e3b2d49d21",
      "flags": 0,
      "text": "[VAR GOPARKLOCAL(0000)]"
    },
    {
      "index": 35,
      "id": "go_park_02_01",
      "hash": "a8fe76dd5170bc37",
      "flags": 0,
      "text": "[VAR NUM3(0000)]隻"
    },
    {
      "index": 36,
      "id": "go_park_03_01",
      "hash": "5152aad5b4f235c2",
      "flags": 0,
      "text": "×[VAR NUM4(0000,0000)]"
    },
    {
      "index": 37,
      "id": "go_park_10_01",
      "hash": "0cf80ee3f10e4692",
      "flags": 0,
      "text": "返回"
    },
    {
      "index": 38,
      "id": "go_park_10_02",
      "hash": "0cf80de3f10e44df",
      "flags": 0,
      "text": "更改名字"
    },
    {
      "index": 39,
      "id": "go_park_10_03",
      "hash": "0cf80ce3f10e432c",
      "flags": 0,
      "text": "查看資訊"
    },
    {
      "index": 40,
      "id": "go_park_20_01",
      "hash": "8b27a758d40dea4f",
      "flags": 0,
      "text": "請選擇GO Park"
    },
    {
      "index": 41,
      "id": "go_park_20_02",
      "hash": "8b27a858d40dec02",
      "flags": 0,
      "text": "要去哪裡？"
    },
    {
      "index": 42,
      "id": "go_park_20_03",
      "hash": "8b27a958d40dedb5",
      "flags": 0,
      "text": "要和哪裡的寶可夢一起玩？"
    },
    {
      "index": 43,
      "id": "go_park_20_04",
      "hash": "8b27a258d40de1d0",
      "flags": 0,
      "text": "請選擇想一起玩的寶可夢"
    },
    {
      "index": 44,
      "id": "go_park_20_05",
      "hash": "8b27a358d40de383",
      "flags": 0,
      "text": "在[VAR COLOR(0006)][VAR GOPARKLOCAL(0000)][VAR COLOR(0000)]裡"
    },
    {
      "index": 45,
      "id": "go_park_20_06",
      "hash": "8b27a458d40de536",
      "flags": 0,
      "text": "要對[VAR GOPARKPKM(0000)]做什麼？"
    },
    {
      "index": 46,
      "id": "go_park_25_01",
      "hash": "8f31e36fa702e296",
      "flags": 0,
      "text": "在[VAR GOPARKLOCAL(0000)]裡的寶可夢"
    },
    {
      "index": 47,
      "id": "go_park_25_02",
      "hash": "8f31e26fa702e0e3",
      "flags": 0,
      "text": "← → 切換GO Park"
    },
    {
      "index": 48,
      "id": "go_park_30_01",
      "hash": "1aa10723e7fa36ec",
      "flags": 0,
      "text": "把牠移動到了\\n[VAR GOPARKLOCAL(0000)]！"
    },
    {
      "index": 49,
      "id": "go_park_40_01",
      "hash": "6e71df9790fa2fe9",
      "flags": 0,
      "text": "要再挑戰一次嗎？"
    },
    {
      "index": 50,
      "id": "go_park_40_02",
      "hash": "6e71dc9790fa2ad0",
      "flags": 0,
      "text": "是"
    },
    {
      "index": 51,
      "id": "go_park_40_03",
      "hash": "6e71dd9790fa2c83",
      "flags": 0,
      "text": "否"
    },
    {
      "index": 52,
      "id": "go_park_41_01",
      "hash": "16c5b38ff47b0654",
      "flags": 0,
      "text": "遊戲已暫停。\\n要做什麼？"
    },
    {
      "index": 53,
      "id": "go_park_41_02",
      "hash": "16c5b68ff47b0b6d",
      "flags": 0,
      "text": "繼續遊戲"
    },
    {
      "index": 54,
      "id": "go_park_41_03",
      "hash": "16c5b58ff47b09ba",
      "flags": 0,
      "text": "重新開始"
    },
    {
      "index": 55,
      "id": "go_park_41_04",
      "hash": "16c5b08ff47b013b",
      "flags": 0,
      "text": "退出遊樂區"
    },
    {
      "index": 56,
      "id": "go_park_45_01",
      "hash": "3ccc6b6dd7c07818",
      "flags": 0,
      "text": "所選擇的寶可夢\\n數量不夠。\\n請在GO Park裡\\n寄放25隻相同的寶可夢。"
    },
    {
      "index": 57,
      "id": "go_park_45_02",
      "hash": "3ccc6e6dd7c07d31",
      "flags": 0,
      "text": "想在遊樂區玩的話，\\n請在GO Park裡\\n寄放25隻相同的寶可夢。"
    },
    {
      "index": 58,
      "id": "go_park_48_01",
      "hash": "0e636f55cacbd511",
      "flags": 0,
      "text": "完成時間"
    },
    {
      "index": 59,
      "id": "go_park_48_02",
      "hash": "0e636c55cacbcff8",
      "flags": 0,
      "text": "同時到達終點的數量"
    },
    {
      "index": 60,
      "id": "go_park_48_03",
      "hash": "0e636d55cacbd1ab",
      "flags": 0,
      "text": "[~ 60]"
    },
    {
      "index": 61,
      "id": "go_park_48_04",
      "hash": "0e637255cacbda2a",
      "flags": 0,
      "text": "本次的紀錄"
    },
    {
      "index": 62,
      "id": "go_park_49_01",
      "hash": "372e634a7ff17c7c",
      "flags": 0,
      "text": "[VAR NUM2(0000)]隻"
    },
    {
      "index": 63,
      "id": "go_park_50_02",
      "hash": "fb41428dbfc4c353",
      "flags": 0,
      "text": "[VAR NUM4(0000,0000)]分"
    },
    {
      "index": 64,
      "id": "go_park_50_03",
      "hash": "fb41418dbfc4c1a0",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]的最高紀錄"
    },
    {
      "index": 65,
      "id": "go_park_55_01",
      "hash": "a279077478cf9dbf",
      "flags": 0,
      "text": "要做什麼？\\n[VAR COLOR(0006)]Ｙ：縮放[VAR COLOR(0000)]"
    },
    {
      "index": 66,
      "id": "go_park_55_02",
      "hash": "a279087478cf9f72",
      "flags": 0,
      "text": "寫紀錄"
    },
    {
      "index": 67,
      "id": "go_park_55_03",
      "hash": "a279097478cfa125",
      "flags": 0,
      "text": "返回櫃台"
    },
    {
      "index": 68,
      "id": "go_park_55_05",
      "hash": "a279037478cf96f3",
      "flags": 0,
      "text": "查看資訊"
    },
    {
      "index": 69,
      "id": "go_park_55_04",
      "hash": "a279027478cf9540",
      "flags": 0,
      "text": "什麼也不做"
    },
    {
      "index": 70,
      "id": "go_park_55_06",
      "hash": "a279047478cf98a6",
      "flags": 0,
      "text": "[VAR GENDBR(00FF,0101)]你妳得到了\\n[VAR NUM3(0001)]個[VAR ITEM2(0000)]！"
    },
    {
      "index": 71,
      "id": "go_park_55_07",
      "hash": "a279057478cf9a59",
      "flags": 0,
      "text": "[VAR GENDBR(00FF,0101)]你妳把道具放進了[VAR COLOR(0006)][VAR BAG(0001)][VAR COLOR(0000)]。"
    },
    {
      "index": 72,
      "id": "go_park_55_10",
      "hash": "a27c8c7478d2b595",
      "flags": 0,
      "text": "要寫下紀錄嗎？"
    },
    {
      "index": 73,
      "id": "go_park_55_11",
      "hash": "a27c8b7478d2b3e2",
      "flags": 0,
      "text": "正在寫入寶可夢紀錄……\\n請勿關閉電源。"
    },
    {
      "index": 74,
      "id": "go_park_55_12",
      "hash": "a27c8a7478d2b22f",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]\\n確實寫下了紀錄！"
    },
    {
      "index": 75,
      "id": "go_park_55_13",
      "hash": "a27c897478d2b07c",
      "flags": 0,
      "text": "紀錄儲存失敗。"
    },
    {
      "index": 76,
      "id": "go_park_60_00",
      "hash": "248419f567544870",
      "flags": 0,
      "text": "[VAR GOPARKPKM(0000)]"
    },
    {
      "index": 77,
      "id": "go_park_60_01",
      "hash": "24841af567544a23",
      "flags": 0,
      "text": "CP [VAR NUM5(0000,0000)]"
    },
    {
      "index": 78,
      "id": "go_park_60_02",
      "hash": "24841bf567544bd6",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]"
    },
    {
      "index": 79,
      "id": "go_park_60_03",
      "hash": "24841cf567544d89",
      "flags": 0,
      "text": "[VAR NUM3(0000)]/[VAR NUM3(0001)]"
    },
    {
      "index": 80,
      "id": "go_park_60_04",
      "hash": "24841df567544f3c",
      "flags": 0,
      "text": "身高"
    },
    {
      "index": 81,
      "id": "go_park_60_05",
      "hash": "24841ef5675450ef",
      "flags": 0,
      "text": "體重"
    },
    {
      "index": 82,
      "id": "go_park_60_06",
      "hash": "24841ff5675452a2",
      "flags": 0,
      "text": "[VAR NUM2(0000)].[VAR NUM2(0001)]m"
    },
    {
      "index": 83,
      "id": "go_park_60_07",
      "hash": "248420f567545455",
      "flags": 0,
      "text": "[VAR NUM3(0000)].[VAR NUM2(0001)]kg"
    },
    {
      "index": 84,
      "id": "go_park_60_08",
      "hash": "248421f567545608",
      "flags": 0,
      "text": "訓練家　[VAR PGOTRAINER(0000)]"
    },
    {
      "index": 85,
      "id": "go_park_60_09",
      "hash": "248422f5675457bb",
      "flags": 0,
      "text": "[VAR NUM4(0000,0000)]/[VAR NUM2(0001)]/[VAR NUM2(0002)]"
    },
    {
      "index": 86,
      "id": "go_park_60_10",
      "hash": "24879ff5675761f9",
      "flags": 0,
      "text": "捕捉"
    },
    {
      "index": 87,
      "id": "go_park_60_11",
      "hash": "24879ef567576046",
      "flags": 0,
      "text": "移動"
    },
    {
      "index": 88,
      "id": "go_park_70_01",
      "hash": "b46a7ac07b9d68a0",
      "flags": 0,
      "text": "[VAR NUM2(0000)]:[VAR NUM2(0001)].[VAR NUM2(0002)]"
    },
    {
      "index": 89,
      "id": "go_park_80_01",
      "hash": "82fa3762ec0872bd",
      "flags": 0,
      "text": "若捕捉GO Park裡的寶可夢，\\n寶可夢的資訊將變得\\n與原先在GO Park時不同。\\n確定要繼續嗎？"
    },
    {
      "index": 90,
      "id": "go_park_90_01",
      "hash": "950ad72a53682d1a",
      "flags": 0,
      "text": "[VAR NUM3(0000)]"
    },
    {
      "index": 91,
      "id": "go_park_100_01",
      "hash": "3b2093cb115b62e2",
      "flags": 0,
      "text": "引導寶可夢前往終點吧！\\nＸ：選單　Ｙ：縮放"
    }
  ],
  "unpaired_labels": [
