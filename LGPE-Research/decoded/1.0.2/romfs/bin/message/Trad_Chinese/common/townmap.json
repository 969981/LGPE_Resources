      "text": ""
    },
    {
      "index": 2,
      "id": "TOWNMAP_01_01",
      "hash": "adebed59f5f814d9",
      "flags": 0,
      "text": "凌空渡"
    },
    {
      "index": 3,
      "id": "TOWNMAP_01_02",
      "hash": "adebea59f5f80fc0",
      "flags": 0,
      "text": "退出"
    },
    {
      "index": 4,
      "id": "TOWNMAP_01_03",
      "hash": "adebeb59f5f81173",
      "flags": 0,
      "text": "切換寶可夢"
    },
    {
      "index": 5,
      "id": "TOWNMAP_02_01",
      "hash": "54b72d40aea6ee66",
      "flags": 0,
      "text": "← → 切換寶可夢"
    },
    {
      "index": 6,
      "id": "TOWNMAP_05_01",
      "hash": "537c053b87998f1d",
      "flags": 0,
      "text": "要使用秘術「凌空渡」\\n飛往[VAR LOCATION(0000)]嗎？"
    },
    {
      "index": 7,
      "id": "TOWNMAP_05_02",
      "hash": "537c023b87998a04",
      "flags": 0,
      "text": "是"
    },
    {
      "index": 8,
      "id": "TOWNMAP_05_03",
      "hash": "537c033b87998bb7",
      "flags": 0,
      "text": "否"
    },
    {
      "index": 9,
      "id": "TOWNMAP_10_01",
      "hash": "c7de207c7f324b27",
      "flags": 0,
      "text": "[VAR LOCATION(0000)]"
    },
    {
      "index": 10,
      "id": "TOWNMAP_20_01",
      "hash": "9e9ac914d7a1ec8a",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]的棲息地"
    },
    {
      "index": 11,
      "id": "TOWNMAP_20_02",
      "hash": "9e9ac814d7a1ead7",
      "flags": 0,
      "text": "棲息地　不明"
    },
    {
      "index": 12,
      "id": "TM_GUIDE_01",
      "hash": "de793f7747865099",
      "flags": 0,
      "text": "草木生長茂盛，\\n氣氛悠閒的鄉村小路。"
    },
    {
      "index": 13,
      "id": "TM_GUIDE_02",
      "hash": "de793c7747864b80",
      "flags": 0,
      "text": "通往常青森林，\\n地形高低不平的道路。"
    },
    {
      "index": 14,
      "id": "TM_GUIDE_03",
      "hash": "de793d7747864d33",
      "flags": 0,
      "text": "位在山區附近，\\n隨處可見大岩石的草徑。"
    },
    {
      "index": 15,
      "id": "TM_GUIDE_04",
      "hash": "de794277478655b2",
      "flags": 0,
      "text": "通往月見山的坡道。\\n往下走到華藍市就不能折返了。"
    },
    {
      "index": 16,
      "id": "TM_GUIDE_05",
      "hash": "de79437747865765",
      "flags": 0,
      "text": "平緩的坡道。\\n這裡有通往地下通道的入口。"
    },
    {
      "index": 17,
      "id": "TM_GUIDE_06",
      "hash": "de7940774786524c",
      "flags": 0,
      "text": "連接枯葉市和金黃市的道路。\\n這裡有通往地下通道的入口。"
    },
    {
      "index": 18,
      "id": "TM_GUIDE_07",
      "hash": "de794177478653ff",
      "flags": 0,
      "text": "一條很短的道路。這裡有通往\\n８號道路的地下通道入口。"
    },
    {
      "index": 19,
      "id": "TM_GUIDE_08",
      "hash": "de79467747865c7e",
      "flags": 0,
      "text": "一條很短的道路。這裡有通往\\n７號道路的地下通道入口。"
    },
    {
      "index": 20,
      "id": "TM_GUIDE_09",
      "hash": "de79477747865e31",
      "flags": 0,
      "text": "地形高低不平的道路。\\n同時也是孩子們的遊樂場。"
    },
    {
      "index": 21,
      "id": "TM_GUIDE_10",
      "hash": "de7cc4774789686f",
      "flags": 0,
      "text": "位於運河旁的道路。\\n這裡有岩山隧道的入口。"
    },
    {
      "index": 22,
      "id": "TM_GUIDE_11",
      "hash": "de7cc377478966bc",
      "flags": 0,
      "text": "訓練家雲集的草地。\\n這裡有地鼠洞穴的入口。"
    },
    {
      "index": 23,
      "id": "TM_GUIDE_12",
      "hash": "de7cc67747896bd5",
      "flags": 0,
      "text": "釣魚者聚集的棧橋。\\n也被稱為寂靜橋。"
    },
    {
      "index": 24,
      "id": "TM_GUIDE_13",
      "hash": "de7cc57747896a22",
      "flags": 0,
      "text": "清爽宜人的沿海道路。\\n部分路段形成了迷宮。"
    },
    {
      "index": 25,
      "id": "TM_GUIDE_14",
      "hash": "de7cc077478961a3",
      "flags": 0,
      "text": "位於海邊的寬闊林蔭道。\\n海風的氣味令人心曠神怡。"
    },
    {
      "index": 26,
      "id": "TM_GUIDE_15",
      "hash": "de7cbf7747895ff0",
      "flags": 0,
      "text": "一條筆直向淺紅市東邊\\n延伸的長長草徑。"
    },
    {
      "index": 27,
      "id": "TM_GUIDE_16",
      "hash": "de7cc27747896509",
      "flags": 0,
      "text": "位於寶可夢大道北邊的道路。\\n這裡總是熱鬧非凡。"
    },
    {
      "index": 28,
      "id": "TM_GUIDE_17",
      "hash": "de7cc17747896356",
      "flags": 0,
      "text": "能讓寶可夢和訓練家\\n享受散步樂趣的寶可夢大道。"
    },
    {
      "index": 29,
      "id": "TM_GUIDE_18",
      "hash": "de7ccc7747897607",
      "flags": 0,
      "text": "位於寶可夢大道南邊的道路。\\n這裡有些熱衷對戰的訓練家。"
    },
    {
      "index": 30,
      "id": "TM_GUIDE_19",
      "hash": "de7ccb7747897454",
      "flags": 0,
      "text": "十分熱門的游泳勝地。\\n在沙灘上還能享受日光浴。"
    },
    {
      "index": 31,
      "id": "TM_GUIDE_20",
      "hash": "de72d27747812bb4",
      "flags": 0,
      "text": "被位於中央的雙子島\\n一分為二的海洋。"
    },
    {
      "index": 32,
      "id": "TM_GUIDE_21",
      "hash": "de72d37747812d67",
      "flags": 0,
      "text": "受到火山的影響，\\n導致水溫較高的海路。"
    },
    {
      "index": 33,
      "id": "TM_GUIDE_22",
      "hash": "de72d47747812f1a",
      "flags": 0,
      "text": "通往寶可夢聯盟，\\n鋪著地磚的筆直道路。"
    },
    {
      "index": 34,
      "id": "TM_GUIDE_23",
      "hash": "de72d577478130cd",
      "flags": 0,
      "text": "只有強大的訓練家\\n才能通過的山路。"
    },
    {
      "index": 35,
      "id": "TM_GUIDE_24",
      "hash": "de72ce77478124e8",
      "flags": 0,
      "text": "位於華藍市北邊的道路。\\n以水路上金光閃閃的橋而聞名。"
    },
    {
      "index": 36,
      "id": "TM_GUIDE_25",
      "hash": "de72cf774781269b",
      "flags": 0,
      "text": "一條由灌木構成，\\n通往海角的迷宮道路。"
    },
    {
      "index": 37,
      "id": "TM_GUIDE_26",
      "hash": "de72d0774781284e",
      "flags": 0,
      "text": "鄉間小鎮。\\n這裡有寶可夢研究所。"
    },
    {
      "index": 38,
      "id": "TM_GUIDE_27",
      "hash": "de72d17747812a01",
      "flags": 0,
      "text": "一個喜愛大自然的城市。\\n這裡一年四季都有鮮花盛放。"
    },
    {
      "index": 39,
      "id": "TM_GUIDE_28",
      "hash": "de72ca7747811e1c",
      "flags": 0,
      "text": "位於巨大岩石山\\n山腳下的石城。"
    },
    {
      "index": 40,
      "id": "TM_GUIDE_29",
      "hash": "de72cb7747811fcf",
      "flags": 0,
      "text": "四周被水路圍繞，水資源豐富的城市。\\n水屬性道館也座落於此。"
    },
    {
      "index": 41,
      "id": "TM_GUIDE_30",
      "hash": "de75d87747836bbd",
      "flags": 0,
      "text": "一個寧靜而莊嚴的城鎮。\\n這裡有許多寶可夢的墳墓。"
    },
    {
      "index": 42,
      "id": "TM_GUIDE_31",
      "hash": "de75d77747836a0a",
      "flags": 0,
      "text": "豪華遊輪也會停泊於此的\\n國際化港口城市。"
    },
    {
      "index": 43,
      "id": "TM_GUIDE_32",
      "hash": "de75d67747836857",
      "flags": 0,
      "text": "許多不同年代居民居住的城市。\\n百貨公司就在這裡。"
    },
    {
      "index": 44,
      "id": "TM_GUIDE_33",
      "hash": "de75d577478366a4",
      "flags": 0,
      "text": "狩獵地帶所在的城市。\\n聚集了許多寶可夢和人。"
    },
    {
      "index": 45,
      "id": "TM_GUIDE_34",
      "hash": "de75d477478364f1",
      "flags": 0,
      "text": "位於火山島上的城市。\\n這裡有一間成了廢墟的大屋。"
    },
    {
      "index": 46,
      "id": "TM_GUIDE_35",
      "hash": "de75d3774783633e",
      "flags": 0,
      "text": "聳立著最高機構\\n寶可夢聯盟總部的高原。"
    },
    {
      "index": 47,
      "id": "TM_GUIDE_36",
      "hash": "de75d2774783618b",
      "flags": 0,
      "text": "高樓聳立，關都地區\\n首屈一指的都市。"
    },
    {
      "index": 48,
      "id": "TM_GUIDE_37",
      "hash": "de75d17747835fd8",
      "flags": 0,
      "text": "可以找到很多\\n蟲屬性寶可夢的大森林。"
    },
    {
      "index": 49,
      "id": "TM_GUIDE_38",
      "hash": "de75d07747835e25",
      "flags": 0,
      "text": "流星墜落的高山。\\n在這裡可以找到化石。"
    },
    {
      "index": 50,
      "id": "TM_GUIDE_39",
      "hash": "de75cf7747835c72",
      "flags": 0,
      "text": "天然的大隧道。\\n裡面很暗，所以燈光是必需品。"
    },
    {
      "index": 51,
      "id": "TM_GUIDE_40",
      "hash": "de6bc677477af8a2",
      "flags": 0,
      "text": "到處都是機械的設施。\\n是電屬性寶可夢的棲息地。"
    },
    {
      "index": 52,
      "id": "TM_GUIDE_41",
      "hash": "de6bc777477afa55",
      "flags": 0,
      "text": "地鼠挖出來的隧道。\\n是從深灰市到枯葉市的捷徑。"
    },
    {
      "index": 53,
      "id": "TM_GUIDE_42",
      "hash": "de6bc477477af53c",
      "flags": 0,
      "text": "兩個相連的小島。\\n小島內部冷得嚇人。"
    },
    {
      "index": 54,
      "id": "TM_GUIDE_43",
      "hash": "de6bc577477af6ef",
      "flags": 0,
      "text": "險峻的洞窟。聚集著許多\\n以登上顛峰為目標的訓練家。"
    },
    {
      "index": 55,
      "id": "TM_PLACE_COMMON_01",
      "hash": "8435be3e473a535c",
      "flags": 0,
      "text": "寶可夢中心"
    },
    {
      "index": 56,
      "id": "TM_PLACE_COMMON_02",
      "hash": "8435c13e473a5875",
      "flags": 0,
      "text": "友好商店"
    },
    {
      "index": 57,
      "id": "TM_PLACE_COMMON_05",
      "hash": "8435ba3e473a4c90",
      "flags": 0,
      "text": "寶可夢研究所"
    },
    {
      "index": 58,
      "id": "TM_PLACE_COMMON_06",
      "hash": "8435bd3e473a51a9",
      "flags": 0,
      "text": "訓練家學校"
    },
    {
      "index": 59,
      "id": "TM_PLACE_COMMON_07",
      "hash": "8435bc3e473a4ff6",
      "flags": 0,
      "text": "寶可夢道館"
    },
    {
      "index": 60,
      "id": "TM_PLACE_COMMON_09",
      "hash": "8435c63e473a60f4",
      "flags": 0,
      "text": "深灰科學博物館"
    },
    {
      "index": 61,
      "id": "TM_PLACE_COMMON_12",
      "hash": "8432373e47373820",
      "flags": 0,
      "text": "寶可夢塔"
    },
    {
      "index": 62,
      "id": "TM_PLACE_COMMON_13",
      "hash": "8432383e473739d3",
      "flags": 0,
      "text": "寶可夢之家"
    },
    {
      "index": 63,
      "id": "TM_PLACE_COMMON_14",
      "hash": "84323d3e47374252",
      "flags": 0,
      "text": "姓名鑑定師"
    },
    {
      "index": 64,
      "id": "TM_PLACE_COMMON_16",
      "hash": "84323b3e47373eec",
      "flags": 0,
      "text": "枯葉港"
    },
    {
      "index": 65,
      "id": "TM_PLACE_COMMON_17",
      "hash": "84323c3e4737409f",
      "flags": 0,
      "text": "寶可夢發燒友俱樂部"
    },
    {
      "index": 66,
      "id": "TM_PLACE_COMMON_19",
      "hash": "8432423e47374ad1",
      "flags": 0,
      "text": "玉虹百貨公司"
    },
    {
      "index": 67,
      "id": "TM_PLACE_COMMON_20",
      "hash": "842ed33e4734585d",
      "flags": 0,
      "text": "玉虹大廈"
    },
    {
      "index": 68,
      "id": "TM_PLACE_COMMON_21",
      "hash": "842ed23e473456aa",
      "flags": 0,
      "text": "火箭遊戲城"
    },
    {
      "index": 69,
      "id": "TM_PLACE_COMMON_22",
      "hash": "842ed13e473454f7",
      "flags": 0,
      "text": "占卜師"
    },
    {
      "index": 70,
      "id": "TM_PLACE_COMMON_24",
      "hash": "842ecf3e47345191",
      "flags": 0,
      "text": "GO Park"
    },
    {
      "index": 71,
      "id": "TM_PLACE_COMMON_26",
      "hash": "842ecd3e47344e2b",
      "flags": 0,
      "text": "寶可夢屋"
    },
    {
      "index": 72,
      "id": "TM_PLACE_COMMON_27",
      "hash": "842ecc3e47344c78",
      "flags": 0,
      "text": "紅蓮研究所"
    },
    {
      "index": 73,
      "id": "TM_PLACE_COMMON_29",
      "hash": "842eca3e47344912",
      "flags": 0,
      "text": "西爾佛公司"
    },
    {
      "index": 74,
      "id": "TM_PLACE_COMMON_30",
      "hash": "842b4d3e47313ed4",
      "flags": 0,
      "text": "格鬥道場"
    },
    {
      "index": 75,
      "id": "TM_PLACE_COMMON_31",
      "hash": "842b4e3e47314087",
      "flags": 0,
      "text": "搭檔招式傳授處"
    },
    {
      "index": 76,
      "id": "TM_PLACE_COMMON_32",
