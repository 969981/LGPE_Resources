{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "pmgo_set_win_01",
      "hash": "50aeeea835eb51b0",
      "flags": 0,
      "text": "要進行配對\\n以連線到Pokémon GO嗎？"
    },
    {
      "index": 1,
      "id": "pmgo_set_win_02",
      "hash": "50aef1a835eb56c9",
      "flags": 0,
      "text": "正在搜尋Pokémon GO……"
    },
    {
      "index": 2,
      "id": "pmgo_set_win_03",
      "hash": "50aef0a835eb5516",
      "flags": 0,
      "text": "找到了[VAR PGOTRAINER(0000)]。\\n要進行配對嗎？"
    },
    {
      "index": 3,
      "id": "pmgo_set_win_04",
      "hash": "50aef3a835eb5a2f",
      "flags": 0,
      "text": "正在連線……\\n請勿關閉電源。"
    },
    {
      "index": 4,
      "id": "pmgo_set_win_05",
      "hash": "50aef2a835eb587c",
      "flags": 0,
      "text": "已成功與[VAR PGOTRAINER(0000)]的\\nPokémon GO配對！\\n\\n[VAR GENDBR(00FF,0101)]你妳可以在淺紅市的\\nGO Park傳送寶可夢。"
    },
    {
      "index": 5,
      "id": "pmgo_set_win_06",
      "hash": "50aef5a835eb5d95",
      "flags": 0,
      "text": "還可以帶[VAR NUM3(0000)]隻寶可夢\\n到[VAR GOPARKLOCAL(0001)]。"
    },
    {
      "index": 6,
      "id": "pmgo_set_win_07",
      "hash": "50aef4a835eb5be2",
      "flags": 0,
      "text": "由於傳送後寶可夢數量將超過50隻，\\n因此無法傳送至\\n[VAR GOPARKLOCAL(0000)]。\\n\\n請整理\\n[VAR GOPARKLOCAL(0000)]\\n裡的寶可夢，或選擇其他的GO Park。"
    },
    {
      "index": 7,
      "id": "pmgo_set_win_08",
      "hash": "50aef7a835eb60fb",
      "flags": 0,
      "text": "還未與Pokémon GO\\n進行配對。\\n\\n請到Ｘ選單的「設定」中\\n選擇「與Pokémon GO連線」進行配對。"
    },
    {
      "index": 8,
      "id": "pmgo_set_win_09",
      "hash": "50aef6a835eb5f48",
      "flags": 0,
      "text": "為進行復原，\\n正在與Pokémon GO連線……\\n請勿關閉電源，\\n稍候片刻。"
    },
    {
      "index": 9,
      "id": "pmgo_set_win_10",
      "hash": "50ab89a835e8703a",
      "flags": 0,
      "text": "想要傳送的寶可夢\\n可能會消失，\\n真的確定要退出嗎？"
    },
    {
      "index": 10,
      "id": "pmgo_set_win_11",
      "hash": "50ab8aa835e871ed",
      "flags": 0,
      "text": "Pokémon GO\\n還留有寶可夢。\\n\\n請重新再試一次。"
    },
    {
      "index": 11,
      "id": "pmgo_set_win_12",
      "hash": "50ab87a835e86cd4",
      "flags": 0,
      "text": "正在結束……\\n請稍候片刻。"
    },
    {
      "index": 12,
      "id": "pmgo_set_win_13",
      "hash": "50ab88a835e86e87",
      "flags": 0,
      "text": "有[VAR NUM4(0001,0000)]隻寶可夢\\n從[VAR PGOTRAINER(0000)]的Pokémon GO\\n傳送到了GO Park。\\n\\n去[VAR GOPARKLOCAL(0002)]\\n看一下吧！"
    },
    {
      "index": 13,
      "id": "pmgo_set_win_14",
      "hash": "50ab85a835e8696e",
      "flags": 0,
      "text": "[VAR PGOTRAINER(0000)]要傳送\\n[VAR NUM4(0001,0000)]隻寶可夢，\\n但[VAR GOPARKLOCAL(0003)]\\n只能再容納[VAR NUM3(0002)]隻寶可夢。"
    },
    {
      "index": 14,
      "id": "pmgo_set_win_15",
      "hash": "50ab86a835e86b21",
      "flags": 0,
      "text": "已找到[VAR PGOTRAINER(0000)]。\\n要接收寶可夢嗎？"
    },
    {
      "index": 15,
      "id": "pmgo_set_win_16",
      "hash": "50ab83a835e86608",
      "flags": 0,
      "text": "把『精靈寶可夢 Let's Go！皮卡丘／\\nLet's Go！伊布』\\n連接到『Pokémon GO』時，\\n[VAR GENDBR(00FF,0101)]你妳的遊戲識別用戶ID及\\n遊戲技術資訊將會被傳送至\\n『Pokémon GO』。\\n"
    },
    {
      "index": 16,
      "id": "pmgo_set_sel_01",
      "hash": "4950366029620392",
      "flags": 0,
      "text": "是"
    },
    {
      "index": 17,
      "id": "pmgo_set_sel_02",
      "hash": "49503560296201df",
      "flags": 0,
      "text": "否"
    },
    {
      "index": 18,
      "id": "pmgo_set_sel_03",
      "hash": "495034602962002c",
      "flags": 0,
      "text": "繼續"
    },
    {
      "index": 19,
      "id": "pmgo_set_sel_04",
      "hash": "495033602961fe79",
      "flags": 0,
      "text": "退出"
    },
    {
      "index": 20,
      "id": "pmgo_set_sel_05",
      "hash": "495032602961fcc6",
      "flags": 0,
      "text": "開始連線"
    },
    {
      "index": 21,
      "id": "pmgo_set_cap_01",
      "hash": "619e152042febb32",
      "flags": 0,
      "text": "開始"
    },
    {
      "index": 22,
      "id": "pmgo_set_cap_02",
      "hash": "619e142042feb97f",
      "flags": 0,
      "text": "退出"
    },
    {
      "index": 23,
      "id": "pmgo_set_cap_03",
      "hash": "619e132042feb7cc",
      "flags": 0,
      "text": "結束"
    },
    {
      "index": 24,
      "id": "pmgo_set_cap_04",
      "hash": "619e122042feb619",
      "flags": 0,
      "text": "[VAR NUM3(0000)]％"
    }
  ],
