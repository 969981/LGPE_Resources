{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "TOKUSEIINFO_000",
      "hash": "7ba40506d12f4b74",
      "flags": 0,
      "text": "―\\n―"
    },
    {
      "index": 1,
      "id": "TOKUSEIINFO_001",
      "hash": "7ba40606d12f4d27",
      "flags": 0,
      "text": "發出臭氣，\\n在攻擊的時候，\\n有時會使對手畏縮。"
    },
    {
      "index": 2,
      "id": "TOKUSEIINFO_002",
      "hash": "7ba40706d12f4eda",
      "flags": 0,
      "text": "出場時，\\n會將天氣變為下雨。"
    },
    {
      "index": 3,
      "id": "TOKUSEIINFO_003",
      "hash": "7ba40806d12f508d",
      "flags": 0,
      "text": "每一回合速度會變快。"
    },
    {
      "index": 4,
      "id": "TOKUSEIINFO_004",
      "hash": "7ba40106d12f44a8",
      "flags": 0,
      "text": "被堅硬的甲殼守護著，\\n不會被對手的攻擊擊中要害。"
    },
    {
      "index": 5,
      "id": "TOKUSEIINFO_005",
      "hash": "7ba40206d12f465b",
      "flags": 0,
      "text": "受到對手的招式攻擊時\\n不會被一擊打倒。\\n一擊必殺的招式也沒有效果。"
    },
    {
      "index": 6,
      "id": "TOKUSEIINFO_006",
      "hash": "7ba40306d12f480e",
      "flags": 0,
      "text": "透過把周圍都弄濕，\\n使誰都無法使用自爆等爆炸類的招式。"
    },
    {
      "index": 7,
      "id": "TOKUSEIINFO_007",
      "hash": "7ba40406d12f49c1",
      "flags": 0,
      "text": "因為身體柔軟，\\n不會陷入麻痺狀態。"
    },
    {
      "index": 8,
      "id": "TOKUSEIINFO_008",
      "hash": "7ba3fd06d12f3ddc",
      "flags": 0,
      "text": "在沙暴中\\n閃避率會提高。"
    },
    {
      "index": 9,
      "id": "TOKUSEIINFO_009",
      "hash": "7ba3fe06d12f3f8f",
      "flags": 0,
      "text": "身上帶有靜電，\\n有時會令接觸到的對手麻痺。"
    },
    {
      "index": 10,
      "id": "TOKUSEIINFO_010",
      "hash": "7ba70b06d1318b7d",
      "flags": 0,
      "text": "受到電屬性的招式攻擊時，\\n不會受到傷害，而是會回復。"
    },
    {
      "index": 11,
      "id": "TOKUSEIINFO_011",
      "hash": "7ba70a06d13189ca",
      "flags": 0,
      "text": "受到水屬性的招式攻擊時，\\n不會受到傷害，而是會回復。"
    },
    {
      "index": 12,
      "id": "TOKUSEIINFO_012",
      "hash": "7ba70906d1318817",
      "flags": 0,
      "text": "感覺遲鈍，\\n不會陷入著迷和被挑釁狀態。"
    },
    {
      "index": 13,
      "id": "TOKUSEIINFO_013",
      "hash": "7ba70806d1318664",
      "flags": 0,
      "text": "任何天氣的影響都會消失。"
    },
    {
      "index": 14,
      "id": "TOKUSEIINFO_014",
      "hash": "7ba70706d13184b1",
      "flags": 0,
      "text": "因為擁有複眼，\\n會提高招式的命中率。"
    },
    {
      "index": 15,
      "id": "TOKUSEIINFO_015",
      "hash": "7ba70606d13182fe",
      "flags": 0,
      "text": "因為擁有不會睡覺的體質，\\n所以不會陷入睡眠狀態。"
    },
    {
      "index": 16,
      "id": "TOKUSEIINFO_016",
      "hash": "7ba70506d131814b",
      "flags": 0,
      "text": "自己的屬性會變為\\n從對手所受招式的屬性。"
    },
    {
      "index": 17,
      "id": "TOKUSEIINFO_017",
      "hash": "7ba70406d1317f98",
      "flags": 0,
      "text": "因為體內擁有免疫能力，\\n不會陷入中毒狀態。"
    },
    {
      "index": 18,
      "id": "TOKUSEIINFO_018",
      "hash": "7ba70306d1317de5",
      "flags": 0,
      "text": "受到火屬性的招式攻擊時，\\n吸收火焰，讓自己使出的\\n火屬性招式變強。"
    },
    {
      "index": 19,
      "id": "TOKUSEIINFO_019",
      "hash": "7ba70206d1317c32",
      "flags": 0,
      "text": "被鱗粉守護著，\\n不會受到招式的追加效果影響。"
    },
    {
      "index": 20,
      "id": "TOKUSEIINFO_020",
      "hash": "7baa7106d1346ea6",
      "flags": 0,
      "text": "因為我行我素，\\n不會陷入混亂狀態。"
    },
    {
      "index": 21,
      "id": "TOKUSEIINFO_021",
      "hash": "7baa7206d1347059",
      "flags": 0,
      "text": "用吸盤將自己牢牢吸附在地面上，\\n讓替換寶可夢的招式和道具失效。"
    },
    {
      "index": 22,
      "id": "TOKUSEIINFO_022",
      "hash": "7baa6f06d1346b40",
      "flags": 0,
      "text": "出場時威嚇對手，\\n使其退縮，\\n從而降低對手的攻擊。"
    },
    {
      "index": 23,
      "id": "TOKUSEIINFO_023",
      "hash": "7baa7006d1346cf3",
      "flags": 0,
      "text": "踩住對手的影子\\n使其無法逃走或替換。"
    },
    {
      "index": 24,
      "id": "TOKUSEIINFO_024",
      "hash": "7baa7506d1347572",
      "flags": 0,
      "text": "受到攻擊時，\\n用粗糙的皮膚弄傷\\n接觸到自己的對手。"
    },
    {
      "index": 25,
      "id": "TOKUSEIINFO_025",
      "hash": "7baa7606d1347725",
      "flags": 0,
      "text": "不可思議的力量，\\n只有效果絕佳的招式才會擊中自己。"
    },
    {
      "index": 26,
      "id": "TOKUSEIINFO_026",
      "hash": "7baa7306d134720c",
      "flags": 0,
      "text": "從地面浮起，\\n從而不會受到地面屬性招式的攻擊。"
    },
    {
      "index": 27,
      "id": "TOKUSEIINFO_027",
      "hash": "7baa7406d13473bf",
      "flags": 0,
      "text": "透過攻擊有時會使接觸到自己的對手，\\n陷入中毒、麻痺或睡眠狀態。"
    },
    {
      "index": 28,
      "id": "TOKUSEIINFO_028",
      "hash": "7baa7906d1347c3e",
      "flags": 0,
      "text": "將自己的中毒、麻痺或\\n灼傷狀態傳染給對手。"
    },
    {
      "index": 29,
      "id": "TOKUSEIINFO_029",
      "hash": "7baa7a06d1347df1",
      "flags": 0,
      "text": "不會因對手的招式或特性\\n而被降低能力。"
    },
    {
      "index": 30,
      "id": "TOKUSEIINFO_030",
      "hash": "7badf706d137882f",
      "flags": 0,
      "text": "異常狀態會在\\n離場後治癒。"
    },
    {
      "index": 31,
      "id": "TOKUSEIINFO_031",
      "hash": "7badf606d137867c",
      "flags": 0,
      "text": "將電屬性的招式吸引到自己身上，\\n不但不會受到傷害，反而會提高特攻。"
    },
    {
      "index": 32,
      "id": "TOKUSEIINFO_032",
      "hash": "7badf906d1378b95",
      "flags": 0,
      "text": "受到上天保佑，\\n容易出現招式的追加效果。"
    },
    {
      "index": 33,
      "id": "TOKUSEIINFO_033",
      "hash": "7badf806d13789e2",
      "flags": 0,
      "text": "天氣為下雨時，\\n速度會提高。"
    },
    {
      "index": 34,
      "id": "TOKUSEIINFO_034",
      "hash": "7badf306d1378163",
      "flags": 0,
      "text": "天氣為晴朗時，\\n速度會提高。"
    },
    {
      "index": 35,
      "id": "TOKUSEIINFO_035",
      "hash": "7badf206d1377fb0",
      "flags": 0,
      "text": "透過讓周圍變亮，\\n變得容易遇見野生的寶可夢。"
    },
    {
      "index": 36,
      "id": "TOKUSEIINFO_036",
      "hash": "7badf506d13784c9",
      "flags": 0,
      "text": "出場時，複製對手的特性，\\n變為與之相同的特性。"
    },
    {
      "index": 37,
      "id": "TOKUSEIINFO_037",
      "hash": "7badf406d1378316",
      "flags": 0,
      "text": "物理攻擊的威力會變為２倍。"
    },
    {
      "index": 38,
      "id": "TOKUSEIINFO_038",
      "hash": "7badff06d13795c7",
      "flags": 0,
      "text": "有時會讓接觸到自己的\\n對手陷入中毒狀態。"
    },
    {
      "index": 39,
      "id": "TOKUSEIINFO_039",
      "hash": "7badfe06d1379414",
      "flags": 0,
      "text": "靠著經過鍛鍊精神，\\n不會因對手的攻擊而畏縮。"
    },
    {
      "index": 40,
      "id": "TOKUSEIINFO_040",
      "hash": "7b966d06d123bed0",
      "flags": 0,
      "text": "將熾熱的熔岩覆蓋在身上，\\n不會陷入冰凍狀態。"
    },
    {
      "index": 41,
      "id": "TOKUSEIINFO_041",
      "hash": "7b966e06d123c083",
      "flags": 0,
      "text": "將水幕裹在身上，\\n不會陷入灼傷狀態。"
    },
    {
      "index": 42,
      "id": "TOKUSEIINFO_042",
      "hash": "7b966f06d123c236",
      "flags": 0,
      "text": "用磁力吸住鋼屬性的寶可夢，\\n使其無法逃走。"
    },
    {
      "index": 43,
      "id": "TOKUSEIINFO_043",
      "hash": "7b967006d123c3e9",
      "flags": 0,
      "text": "透過遮蔽聲音，\\n不受到聲音招式的攻擊。"
    },
    {
      "index": 44,
      "id": "TOKUSEIINFO_044",
      "hash": "7b967106d123c59c",
      "flags": 0,
      "text": "天氣為下雨時，\\n會漸漸回復HP。"
    },
    {
      "index": 45,
      "id": "TOKUSEIINFO_045",
      "hash": "7b967206d123c74f",
      "flags": 0,
      "text": "出場時，\\n會把天氣變為沙暴。"
    },
    {
      "index": 46,
      "id": "TOKUSEIINFO_046",
      "hash": "7b967306d123c902",
      "flags": 0,
      "text": "給予對手壓迫感，\\n大量減少其使用招式的PP。"
    },
    {
      "index": 47,
      "id": "TOKUSEIINFO_047",
      "hash": "7b967406d123cab5",
      "flags": 0,
      "text": "被厚厚的脂肪保護著，\\n能夠讓火屬性和冰屬性\\n招式的傷害減半。"
    },
    {
      "index": 48,
      "id": "TOKUSEIINFO_048",
      "hash": "7b967506d123cc68",
      "flags": 0,
      "text": "即使陷入睡眠狀態，\\n也能以２倍的速度提早醒來。"
    },
    {
      "index": 49,
      "id": "TOKUSEIINFO_049",
      "hash": "7b967606d123ce1b",
      "flags": 0,
      "text": "有時會讓接觸到自己的\\n對手陷入灼傷狀態。"
    },
    {
      "index": 50,
      "id": "TOKUSEIINFO_050",
      "hash": "7b997306d125fed9",
      "flags": 0,
      "text": "一定能從野生寶可夢\\n那裡逃走。"
    },
    {
      "index": 51,
      "id": "TOKUSEIINFO_051",
      "hash": "7b997206d125fd26",
      "flags": 0,
      "text": "靠著銳利的目光，\\n命中率不會被降低。"
    },
    {
      "index": 52,
      "id": "TOKUSEIINFO_052",
      "hash": "7b997106d125fb73",
      "flags": 0,
      "text": "因為擁有以力量為傲的鉗子，\\n不會被對手降低攻擊。"
    },
    {
      "index": 53,
      "id": "TOKUSEIINFO_053",
      "hash": "7b997006d125f9c0",
      "flags": 0,
      "text": "有時會撿來對手用過的道具。\\n冒險過程中也會撿來。"
    },
    {
      "index": 54,
      "id": "TOKUSEIINFO_054",
      "hash": "7b997706d12605a5",
      "flags": 0,
      "text": "如果使出招式，\\n下一回合就需要休息。"
    },
    {
      "index": 55,
      "id": "TOKUSEIINFO_055",
      "hash": "7b997606d12603f2",
      "flags": 0,
      "text": "自己的攻擊雖會變高，\\n但命中率會降低。"
    },
    {
      "index": 56,
      "id": "TOKUSEIINFO_056",
      "hash": "7b997506d126023f",
      "flags": 0,
      "text": "有時會讓接觸到自己的對手\\n陷入著迷狀態。"
    },
    {
      "index": 57,
      "id": "TOKUSEIINFO_057",
      "hash": "7b997406d126008c",
      "flags": 0,
      "text": "場上的夥伴之中，\\n如果有正電或負電特性的寶可夢，\\n自己的特攻會提高。"
    },
    {
      "index": 58,
      "id": "TOKUSEIINFO_058",
      "hash": "7b997b06d1260c71",
      "flags": 0,
      "text": "場上的夥伴之中，\\n如果有正電或負電特性的寶可夢，\\n自己的特攻會提高。"
    },
    {
      "index": 59,
      "id": "TOKUSEIINFO_059",
      "hash": "7b997a06d1260abe",
      "flags": 0,
      "text": "在天氣的影響下，\\n會變成水屬性、火屬性\\n或冰屬性之中的一種。"
    },
    {
      "index": 60,
      "id": "TOKUSEIINFO_060",
      "hash": "7b9cf906d1291862",
      "flags": 0,
      "text": "道具會黏在\\n具有黏性的身體上，\\n不會被對手奪走。"
    },
    {
      "index": 61,
      "id": "TOKUSEIINFO_061",
      "hash": "7b9cfa06d1291a15",
      "flags": 0,
      "text": "透過蛻去身上的皮，\\n有時會治癒異常狀態。"
    },
    {
      "index": 62,
      "id": "TOKUSEIINFO_062",
      "hash": "7b9cf706d12914fc",
      "flags": 0,
      "text": "陷入異常狀態時，\\n會拿出毅力，\\n攻擊會提高。"
    },
    {
      "index": 63,
      "id": "TOKUSEIINFO_063",
      "hash": "7b9cf806d12916af",
      "flags": 0,
      "text": "陷入異常狀態時，\\n神奇鱗片會發生反應，\\n防禦會提高。"
    },
    {
      "index": 64,
      "id": "TOKUSEIINFO_064",
      "hash": "7b9cf506d1291196",
      "flags": 0,
      "text": "吸收了污泥漿的對手\\n會因為強烈的惡臭而\\n使得HP減少。"
    },
    {
      "index": 65,
      "id": "TOKUSEIINFO_065",
      "hash": "7b9cf606d1291349",
      "flags": 0,
      "text": "HP減少的時候，\\n草屬性的招式威力會提高。"
    },
    {
      "index": 66,
      "id": "TOKUSEIINFO_066",
      "hash": "7b9cf306d1290e30",
      "flags": 0,
      "text": "HP減少的時候，\\n火屬性的招式威力會提高。"
    },
    {
      "index": 67,
      "id": "TOKUSEIINFO_067",
      "hash": "7b9cf406d1290fe3",
      "flags": 0,
      "text": "HP減少的時候，\\n水屬性的招式威力會提高。"
    },
    {
      "index": 68,
      "id": "TOKUSEIINFO_068",
      "hash": "7b9d0106d12925fa",
      "flags": 0,
      "text": "HP減少的時候，\\n蟲屬性的招式威力會提高。"
    },
    {
      "index": 69,
      "id": "TOKUSEIINFO_069",
      "hash": "7b9d0206d12927ad",
      "flags": 0,
      "text": "即使使出會受反作用力傷害的招式，\\nHP也不會減少。"
    },
    {
      "index": 70,
      "id": "TOKUSEIINFO_070",
      "hash": "7ba07f06d12c31eb",
      "flags": 0,
      "text": "出場時，\\n會將天氣變為晴朗。"
    },
    {
      "index": 71,
      "id": "TOKUSEIINFO_071",
      "hash": "7ba07e06d12c3038",
      "flags": 0,
      "text": "在戰鬥中讓對手無法逃走。"
    },
    {
      "index": 72,
      "id": "TOKUSEIINFO_072",
      "hash": "7ba08106d12c3551",
      "flags": 0,
      "text": "透過激發出幹勁，\\n不會陷入睡眠狀態。"
    },
    {
      "index": 73,
      "id": "TOKUSEIINFO_073",
      "hash": "7ba08006d12c339e",
      "flags": 0,
      "text": "被白色煙霧保護著，\\n不會被對手降低能力。"
    },
    {
      "index": 74,
      "id": "TOKUSEIINFO_074",
      "hash": "7ba08306d12c38b7",
      "flags": 0,
      "text": "因瑜伽的力量，\\n物理攻擊的威力會變為２倍。"
    },
    {
      "index": 75,
      "id": "TOKUSEIINFO_075",
      "hash": "7ba08206d12c3704",
      "flags": 0,
      "text": "被堅硬的殼保護著，\\n對手的攻擊不會擊中要害。"
    },
    {
      "index": 76,
      "id": "TOKUSEIINFO_076",
      "hash": "7ba08506d12c3c1d",
      "flags": 0,
      "text": "所有天氣的影響都會消失。"
    },
    {
      "index": 77,
      "id": "TOKUSEIINFO_077",
      "hash": "7ba08406d12c3a6a",
      "flags": 0,
      "text": "陷入混亂狀態時，\\n閃避率會提高。"
    },
    {
      "index": 78,
      "id": "TOKUSEIINFO_078",
      "hash": "7ba07706d12c2453",
      "flags": 0,
      "text": "受到電屬性的招式攻擊時，\\n不但不會受到傷害，反而速度會提高。"
    },
    {
      "index": 79,
      "id": "TOKUSEIINFO_079",
      "hash": "7ba07606d12c22a0",
      "flags": 0,
      "text": "面對性別相同的對手，\\n會燃起鬥爭心，變得更強。\\n面對性別不同的對手時則會變弱。"
    },
    {
      "index": 80,
      "id": "TOKUSEIINFO_080",
      "hash": "7bbef506d145f7fc",
      "flags": 0,
      "text": "每次畏縮時，\\n不屈之心就會燃起，\\n速度也會提高。"
    },
    {
      "index": 81,
      "id": "TOKUSEIINFO_081",
      "hash": "7bbef606d145f9af",
      "flags": 0,
      "text": "天氣是冰雹時，\\n閃避率會提高。"
    },
    {
      "index": 82,
      "id": "TOKUSEIINFO_082",
      "hash": "7bbef706d145fb62",
      "flags": 0,
      "text": "原本HP變得很少時才會吃的樹果，\\n在HP還有一半時就會把它吃掉。"
    },
    {
      "index": 83,
      "id": "TOKUSEIINFO_083",
      "hash": "7bbef806d145fd15",
      "flags": 0,
      "text": "要害被擊中時會大發雷霆。\\n攻擊力會提高到最大。"
    },
    {
      "index": 84,
      "id": "TOKUSEIINFO_084",
      "hash": "7bbef106d145f130",
      "flags": 0,
      "text": "失去所持有的道具時，\\n速度會提高。"
    },
    {
      "index": 85,
      "id": "TOKUSEIINFO_085",
      "hash": "7bbef206d145f2e3",
      "flags": 0,
      "text": "靠著耐熱的體質，\\n讓火屬性的招式威力減半。"
    },
    {
      "index": 86,
      "id": "TOKUSEIINFO_086",
      "hash": "7bbef306d145f496",
      "flags": 0,
      "text": "能力變化會變為平時的２倍。"
    },
    {
      "index": 87,
      "id": "TOKUSEIINFO_087",
      "hash": "7bbef406d145f649",
      "flags": 0,
      "text": "下雨天氣時和受到水屬性的招式攻擊時，\\nHP會回復。晴朗天氣時和受到火屬性的\\n招式攻擊時，HP會減少。"
    },
    {
      "index": 88,
      "id": "TOKUSEIINFO_088",
      "hash": "7bbefd06d1460594",
      "flags": 0,
      "text": "比較對手的防禦和特防，\\n根據較低的那項能力\\n相應地提高自己的攻擊或特攻。"
    },
    {
      "index": 89,
      "id": "TOKUSEIINFO_089",
      "hash": "7bbefe06d1460747",
      "flags": 0,
      "text": "使用到拳頭的招式\\n威力會提高。"
    },
    {
      "index": 90,
      "id": "TOKUSEIINFO_090",
      "hash": "7bc27b06d1491185",
      "flags": 0,
      "text": "陷入中毒狀態時，\\nHP不會減少，反而會漸漸增加。"
    },
    {
      "index": 91,
      "id": "TOKUSEIINFO_091",
      "hash": "7bc27a06d1490fd2",
      "flags": 0,
      "text": "與自身同屬性的招式\\n威力會提高。"
    },
    {
      "index": 92,
      "id": "TOKUSEIINFO_092",
      "hash": "7bc27906d1490e1f",
      "flags": 0,
      "text": "若使用連續招式，\\n總是可使出最高次數。"
    },
    {
      "index": 93,
      "id": "TOKUSEIINFO_093",
      "hash": "7bc27806d1490c6c",
      "flags": 0,
      "text": "天氣為下雨時，\\n會治癒異常狀態。"
    },
    {
      "index": 94,
      "id": "TOKUSEIINFO_094",
      "hash": "7bc27706d1490ab9",
      "flags": 0,
      "text": "晴朗天氣時特攻會提高，\\n但每回合HP會減少。"
    },
    {
      "index": 95,
      "id": "TOKUSEIINFO_095",
      "hash": "7bc27606d1490906",
      "flags": 0,
      "text": "陷入異常狀態時，\\n速度會提高。"
    },
    {
      "index": 96,
      "id": "TOKUSEIINFO_096",
      "hash": "7bc27506d1490753",
      "flags": 0,
      "text": "無論是什麼屬性的招式，\\n全部都會變為一般屬性。\\n威力會少量提高。"
    },
    {
      "index": 97,
      "id": "TOKUSEIINFO_097",
      "hash": "7bc27406d14905a0",
      "flags": 0,
      "text": "擊中要害時，\\n威力會進一步提高。"
    },
    {
      "index": 98,
      "id": "TOKUSEIINFO_098",
      "hash": "7bc28306d1491f1d",
      "flags": 0,
      "text": "不會受到攻擊以外的傷害。"
    },
    {
      "index": 99,
      "id": "TOKUSEIINFO_099",
      "hash": "7bc28206d1491d6a",
      "flags": 0,
      "text": "由於無防守戰術，\\n雙方使出的招式都必定會擊中。"
    },
    {
      "index": 100,
      "id": "TOKUSEIINFO_100",
      "hash": "84ba2006d67378df",
      "flags": 0,
      "text": "使出招式的順序\\n必定會變為最後。"
    },
    {
      "index": 101,
      "id": "TOKUSEIINFO_101",
      "hash": "84ba1f06d673772c",
      "flags": 0,
      "text": "可讓威力低的招式\\n提高威力來進行攻擊。"
    },
    {
      "index": 102,
      "id": "TOKUSEIINFO_102",
      "hash": "84ba2206d6737c45",
      "flags": 0,
      "text": "天氣為晴朗時，\\n不會陷入異常狀態。"
    },
    {
      "index": 103,
      "id": "TOKUSEIINFO_103",
      "hash": "84ba2106d6737a92",
      "flags": 0,
      "text": "無法使用持有的道具。"
    },
    {
      "index": 104,
      "id": "TOKUSEIINFO_104",
      "hash": "84ba1c06d6737213",
      "flags": 0,
      "text": "可不受特性影響，\\n向對手使出招式。"
    },
    {
      "index": 105,
      "id": "TOKUSEIINFO_105",
      "hash": "84ba1b06d6737060",
      "flags": 0,
      "text": "因為非常幸運，\\n容易擊中對手的要害。"
    },
    {
      "index": 106,
      "id": "TOKUSEIINFO_106",
      "hash": "84ba1e06d6737579",
      "flags": 0,
      "text": "瀕死時，\\n會對接觸到自己的對手造成傷害。"
    },
    {
      "index": 107,
      "id": "TOKUSEIINFO_107",
      "hash": "84ba1d06d67373c6",
      "flags": 0,
      "text": "察覺對手持有的\\n危險招式。"
    },
    {
      "index": 108,
      "id": "TOKUSEIINFO_108",
      "hash": "84ba2806d6738677",
      "flags": 0,
      "text": "出場時，預見1個\\n對手持有的招式。"
    },
    {
      "index": 109,
      "id": "TOKUSEIINFO_109",
      "hash": "84ba2706d67384c4",
      "flags": 0,
      "text": "可無視對手能力的變化，\\n進行攻擊。"
    },
    {
      "index": 110,
      "id": "TOKUSEIINFO_110",
      "hash": "84b69a06d6705f56",
      "flags": 0,
      "text": "可將效果不好的招式\\n以正常的威力使出。"
    },
    {
      "index": 111,
      "id": "TOKUSEIINFO_111",
      "hash": "84b69b06d6706109",
      "flags": 0,
      "text": "受到效果絕佳的攻擊時，\\n可減弱其威力。"
    },
    {
      "index": 112,
      "id": "TOKUSEIINFO_112",
      "hash": "84b69806d6705bf0",
      "flags": 0,
      "text": "在５回合內，\\n攻擊和速度會減半。"
    },
    {
      "index": 113,
      "id": "TOKUSEIINFO_113",
      "hash": "84b69906d6705da3",
      "flags": 0,
      "text": "一般屬性和格鬥屬性的招式\\n可擊中幽靈屬性的寶可夢。"
    },
    {
      "index": 114,
      "id": "TOKUSEIINFO_114",
      "hash": "84b69e06d6706622",
      "flags": 0,
      "text": "將水屬性的招式引到自己身上，\\n不但不會受到傷害，\\n反而會提高特攻。"
    },
    {
      "index": 115,
      "id": "TOKUSEIINFO_115",
      "hash": "84b69f06d67067d5",
      "flags": 0,
      "text": "天氣為冰雹時，\\n會漸漸回復HP。"
    },
    {
      "index": 116,
      "id": "TOKUSEIINFO_116",
      "hash": "84b69c06d67062bc",
      "flags": 0,
      "text": "受到效果絕佳的攻擊時，\\n可減弱其威力。"
    },
    {
      "index": 117,
      "id": "TOKUSEIINFO_117",
      "hash": "84b69d06d670646f",
      "flags": 0,
      "text": "出場時，\\n會將天氣變為冰雹。"
    },
    {
      "index": 118,
      "id": "TOKUSEIINFO_118",
      "hash": "84b6a206d6706cee",
      "flags": 0,
      "text": "戰鬥結束時，\\n有時候會撿來甜甜蜜。"
    },
    {
      "index": 119,
      "id": "TOKUSEIINFO_119",
      "hash": "84b6a306d6706ea1",
      "flags": 0,
      "text": "出場時，\\n可以察覺對手的持有物。"
    },
    {
      "index": 120,
      "id": "TOKUSEIINFO_120",
      "hash": "84b33406d66d7c2d",
      "flags": 0,
      "text": "會讓自己因反作用力而受傷的招式\\n威力會提高。"
    },
    {
      "index": 121,
      "id": "TOKUSEIINFO_121",
      "hash": "84b33306d66d7a7a",
      "flags": 0,
      "text": "自己的屬性會依持有的石板\\n或Ｚ純晶的屬性而改變。"
    },
    {
      "index": 122,
      "id": "TOKUSEIINFO_122",
      "hash": "84b33206d66d78c7",
      "flags": 0,
      "text": "天氣為晴朗時，\\n自己和同伴的攻擊和\\n特防能力會提高。"
    },
    {
      "index": 123,
      "id": "TOKUSEIINFO_123",
      "hash": "84b33106d66d7714",
      "flags": 0,
      "text": "給予陷入睡眠狀態的對手傷害。"
    },
    {
      "index": 124,
      "id": "TOKUSEIINFO_124",
      "hash": "84b33006d66d7561",
      "flags": 0,
      "text": "盜取接觸到自己的\\n對手的道具。"
    },
    {
      "index": 125,
      "id": "TOKUSEIINFO_125",
      "hash": "84b32f06d66d73ae",
      "flags": 0,
      "text": "招式會失去追加效果，\\n但可以用更高的威力使出招式。"
    },
    {
      "index": 126,
      "id": "TOKUSEIINFO_126",
      "hash": "84b32e06d66d71fb",
      "flags": 0,
      "text": "能力的變化會逆轉，\\n原本提高時會降低，\\n原本降低時會提高。"
    },
    {
      "index": 127,
      "id": "TOKUSEIINFO_127",
      "hash": "84b32d06d66d7048",
      "flags": 0,
      "text": "讓對手感到緊張，\\n無法吃樹果。"
    },
    {
      "index": 128,
      "id": "TOKUSEIINFO_128",
      "hash": "84b32c06d66d6e95",
      "flags": 0,
      "text": "能力被降低時，\\n攻擊會大幅提高。"
    },
    {
      "index": 129,
      "id": "TOKUSEIINFO_129",
      "hash": "84b32b06d66d6ce2",
      "flags": 0,
      "text": "HP降到一半以下時，\\n會變得軟弱而使得\\n攻擊和特攻減半。"
    },
    {
      "index": 130,
      "id": "TOKUSEIINFO_130",
      "hash": "84afae06d66a62a4",
      "flags": 0,
      "text": "受到攻擊時，\\n有時會把對手的招式\\n變為定身法狀態。"
    },
    {
      "index": 131,
      "id": "TOKUSEIINFO_131",
      "hash": "84afaf06d66a6457",
      "flags": 0,
      "text": "有時會治癒同伴的異常狀態。"
    },
    {
      "index": 132,
      "id": "TOKUSEIINFO_132",
      "hash": "84afb006d66a660a",
      "flags": 0,
      "text": "可以減少我方受到的傷害。"
    },
    {
      "index": 133,
      "id": "TOKUSEIINFO_133",
      "hash": "84afb106d66a67bd",
      "flags": 0,
      "text": "因物理招式受到傷害時，\\n防禦會降低，\\n速度會大幅提高。"
    },
    {
      "index": 134,
      "id": "TOKUSEIINFO_134",
      "hash": "84afaa06d66a5bd8",
      "flags": 0,
      "text": "自己的重量會變為２倍。"
    },
    {
      "index": 135,
      "id": "TOKUSEIINFO_135",
      "hash": "84afab06d66a5d8b",
      "flags": 0,
      "text": "自己的重量會減半。"
    },
    {
      "index": 136,
      "id": "TOKUSEIINFO_136",
      "hash": "84afac06d66a5f3e",
      "flags": 0,
      "text": "HP全滿時，\\n受到的傷害會變少。"
    },
    {
      "index": 137,
      "id": "TOKUSEIINFO_137",
      "hash": "84afad06d66a60f1",
      "flags": 0,
      "text": "陷入中毒狀態時，\\n物理招式的威力會提高。"
    },
    {
      "index": 138,
      "id": "TOKUSEIINFO_138",
      "hash": "84afa606d66a550c",
      "flags": 0,
      "text": "陷入灼傷狀態時，\\n特殊招式的威力會提高。"
    },
    {
      "index": 139,
      "id": "TOKUSEIINFO_139",
      "hash": "84afa706d66a56bf",
      "flags": 0,
      "text": "可多次採收\\n已被使用過的樹果。"
    },
    {
      "index": 140,
      "id": "TOKUSEIINFO_140",
      "hash": "84aca806d668229b",
      "flags": 0,
      "text": "預測我方的攻擊，\\n並閃避其招式。"
    },
    {
      "index": 141,
      "id": "TOKUSEIINFO_141",
      "hash": "84aca706d66820e8",
      "flags": 0,
      "text": "每一回合，能力中的某項\\n會大幅提高，相對地某項會降低。"
    },
    {
      "index": 142,
      "id": "TOKUSEIINFO_142",
      "hash": "84acaa06d6682601",
      "flags": 0,
      "text": "不會受到沙暴或冰雹等的傷害。\\n不會受到粉末類招式的攻擊。"
    },
    {
      "index": 143,
      "id": "TOKUSEIINFO_143",
      "hash": "84aca906d668244e",
      "flags": 0,
      "text": "有時僅是接觸\\n就能讓對手中毒。"
    },
    {
      "index": 144,
      "id": "TOKUSEIINFO_144",
      "hash": "84acac06d6682967",
      "flags": 0,
      "text": "退回同行隊伍後，\\nHP會少量回復。"
    },
    {
      "index": 145,
      "id": "TOKUSEIINFO_145",
      "hash": "84acab06d66827b4",
      "flags": 0,
      "text": "不會受到降低防禦的效果影響。"
    },
    {
      "index": 146,
      "id": "TOKUSEIINFO_146",
      "hash": "84acae06d6682ccd",
      "flags": 0,
      "text": "天氣為沙暴時，\\n速度會提高。"
    },
    {
      "index": 147,
      "id": "TOKUSEIINFO_147",
      "hash": "84acad06d6682b1a",
      "flags": 0,
      "text": "不易受到變化類招式\\n攻擊的身體。"
    },
    {
      "index": 148,
      "id": "TOKUSEIINFO_148",
      "hash": "84aca006d6681503",
      "flags": 0,
      "text": "如果在最後使出招式，\\n招式就會變強。"
    },
    {
      "index": 149,
      "id": "TOKUSEIINFO_149",
      "hash": "84ac9f06d6681350",
      "flags": 0,
      "text": "假扮成同行隊伍中的\\n最後一個寶可夢出場，\\n迷惑對手。"
    },
    {
      "index": 150,
      "id": "TOKUSEIINFO_150",
      "hash": "84a92206d6650912",
      "flags": 0,
      "text": "變身為當前面對的寶可夢。"
    },
    {
      "index": 151,
      "id": "TOKUSEIINFO_151",
      "hash": "84a92306d6650ac5",
      "flags": 0,
      "text": "可穿透對手的屏障\\n或替身進行攻擊。"
    },
    {
      "index": 152,
      "id": "TOKUSEIINFO_152",
      "hash": "84a92006d66505ac",
      "flags": 0,
      "text": "被對手接觸到時，\\n會將對手變成木乃伊。"
    },
    {
      "index": 153,
      "id": "TOKUSEIINFO_153",
      "hash": "84a92106d665075f",
      "flags": 0,
      "text": "如果打倒對手，\\n會充滿自信並提高攻擊。"
    },
    {
      "index": 154,
      "id": "TOKUSEIINFO_154",
      "hash": "84a91e06d6650246",
      "flags": 0,
      "text": "受到惡屬性的招式攻擊時，\\n因為正義感，攻擊會提高。"
    },
    {
      "index": 155,
      "id": "TOKUSEIINFO_155",
      "hash": "84a91f06d66503f9",
      "flags": 0,
      "text": "受到惡屬性、幽靈屬性\\n和蟲屬性的招式攻擊時，\\n會因膽怯而使得速度提高。"
    },
    {
      "index": 156,
      "id": "TOKUSEIINFO_156",
      "hash": "84a91c06d664fee0",
      "flags": 0,
      "text": "可不受到由對手使出的\\n變化類招式所影響，並將其反彈。"
    },
    {
      "index": 157,
      "id": "TOKUSEIINFO_157",
      "hash": "84a91d06d6650093",
      "flags": 0,
      "text": "受到草屬性的招式攻擊時，\\n不但不會受到傷害，反而攻擊會提高。"
    },
    {
      "index": 158,
      "id": "TOKUSEIINFO_158",
      "hash": "84a92a06d66516aa",
      "flags": 0,
      "text": "可以搶先使出變化類招式。"
    },
    {
      "index": 159,
      "id": "TOKUSEIINFO_159",
      "hash": "84a92b06d665185d",
      "flags": 0,
      "text": "沙暴天氣時，\\n岩石屬性、地面屬性\\n和鋼屬性招式的威力會提高。"
    },
    {
      "index": 160,
      "id": "TOKUSEIINFO_160",
      "hash": "84a59c06d661ef89",
      "flags": 0,
      "text": "用鐵刺給予接觸到自己的\\n對手傷害。"
    },
    {
      "index": 161,
      "id": "TOKUSEIINFO_161",
      "hash": "84a59b06d661edd6",
      "flags": 0,
      "text": "HP變為一半以下時，\\n樣子會改變。"
    },
    {
      "index": 162,
      "id": "TOKUSEIINFO_162",
      "hash": "84a59a06d661ec23",
      "flags": 0,
      "text": "自己和同伴的命中率會提高。"
    },
    {
      "index": 163,
      "id": "TOKUSEIINFO_163",
      "hash": "84a59906d661ea70",
      "flags": 0,
      "text": "可以不受對手特性的干擾，\\n向對手使出招式。"
    },
    {
      "index": 164,
      "id": "TOKUSEIINFO_164",
      "hash": "84a5a006d661f655",
      "flags": 0,
      "text": "可以不受對手特性的干擾，\\n向對手使出招式。"
    },
    {
      "index": 165,
      "id": "TOKUSEIINFO_165",
      "hash": "84a59f06d661f4a2",
      "flags": 0,
      "text": "可防住向自己和同伴\\n發出的心靈攻擊。"
    },
    {
      "index": 166,
      "id": "TOKUSEIINFO_166",
      "hash": "84a59e06d661f2ef",
      "flags": 0,
      "text": "我方的草屬性寶可夢\\n能力不會降低。\\n也不會陷入異常狀態。"
    },
    {
      "index": 167,
      "id": "TOKUSEIINFO_167",
      "hash": "84a59d06d661f13c",
      "flags": 0,
      "text": "無論是哪種樹果，\\n吃下去後HP都會回復。"
    },
    {
      "index": 168,
      "id": "TOKUSEIINFO_168",
      "hash": "84a5a406d661fd21",
      "flags": 0,
      "text": "變為與自己使出的招式\\n相同的屬性。"
    },
    {
      "index": 169,
      "id": "TOKUSEIINFO_169",
      "hash": "84a5a306d661fb6e",
      "flags": 0,
      "text": "對手的物理招式造成的\\n傷害會減半。"
    },
    {
      "index": 170,
      "id": "TOKUSEIINFO_170",
      "hash": "84a21606d65ed600",
      "flags": 0,
      "text": "奪走被自己招式\\n擊中的對手的道具。"
    },
    {
      "index": 171,
      "id": "TOKUSEIINFO_171",
      "hash": "84a21706d65ed7b3",
      "flags": 0,
      "text": "可防住對手的\\n球和彈類的招式。"
    },
    {
      "index": 172,
      "id": "TOKUSEIINFO_172",
      "hash": "84a21806d65ed966",
      "flags": 0,
      "text": "能力被降低時，\\n特攻會大幅提高。"
    },
    {
      "index": 173,
      "id": "TOKUSEIINFO_173",
      "hash": "84a21906d65edb19",
      "flags": 0,
      "text": "顎部強壯，\\n會提高啃咬類招式的威力。"
    },
    {
      "index": 174,
      "id": "TOKUSEIINFO_174",
      "hash": "84a21a06d65edccc",
      "flags": 0,
      "text": "一般屬性的招式\\n會變為冰屬性。\\n威力會少量提高。"
    },
    {
      "index": 175,
      "id": "TOKUSEIINFO_175",
      "hash": "84a21b06d65ede7f",
      "flags": 0,
      "text": "我方的寶可夢\\n不會陷入睡眠狀態。"
    },
    {
      "index": 176,
      "id": "TOKUSEIINFO_176",
      "hash": "84a21c06d65ee032",
      "flags": 0,
      "text": "若使出攻擊招式，會變為刀劍形態，\\n若使出招式「王者盾牌」，\\n會變為盾牌形態。"
    },
    {
      "index": 177,
      "id": "TOKUSEIINFO_177",
      "hash": "84a21d06d65ee1e5",
      "flags": 0,
      "text": "HP全滿時，\\n可以搶先在對手之前\\n使出飛行屬性的招式。"
    },
    {
      "index": 178,
      "id": "TOKUSEIINFO_178",
      "hash": "84a21e06d65ee398",
      "flags": 0,
      "text": "波動和波導類招式的\\n威力會提高。"
    },
    {
      "index": 179,
      "id": "TOKUSEIINFO_179",
      "hash": "84a21f06d65ee54b",
      "flags": 0,
      "text": "在青草場地時，\\n防禦會提高。"
    },
    {
      "index": 180,
      "id": "TOKUSEIINFO_180",
      "hash": "84d53006d68a5bc7",
      "flags": 0,
      "text": "同伴使用道具時，\\n會把自己持有的道具交給同伴。"
    },
    {
      "index": 181,
      "id": "TOKUSEIINFO_181",
      "hash": "84d52f06d68a5a14",
      "flags": 0,
      "text": "接觸到對手的招式\\n威力會提高。"
    },
    {
      "index": 182,
      "id": "TOKUSEIINFO_182",
      "hash": "84d53206d68a5f2d",
      "flags": 0,
      "text": "一般屬性的招式\\n會變為妖精屬性。\\n威力會少量提高。"
    },
    {
      "index": 183,
      "id": "TOKUSEIINFO_183",
      "hash": "84d53106d68a5d7a",
      "flags": 0,
      "text": "對手用攻擊接觸到自己時，\\n降低此對手的速度。"
    },
    {
      "index": 184,
      "id": "TOKUSEIINFO_184",
      "hash": "84d52c06d68a54fb",
      "flags": 0,
      "text": "一般屬性的招式\\n會變為飛行屬性。\\n威力會少量提高。"
    },
    {
      "index": 185,
      "id": "TOKUSEIINFO_185",
      "hash": "84d52b06d68a5348",
      "flags": 0,
      "text": "親子倆可合計攻擊２次。"
    },
    {
      "index": 186,
      "id": "TOKUSEIINFO_186",
      "hash": "84d52e06d68a5861",
      "flags": 0,
      "text": "全體的惡屬性招式變強。"
    },
    {
      "index": 187,
      "id": "TOKUSEIINFO_187",
      "hash": "84d52d06d68a56ae",
      "flags": 0,
      "text": "全體的妖精屬性招式變強。"
    },
    {
      "index": 188,
      "id": "TOKUSEIINFO_188",
      "hash": "84d52806d68a4e2f",
      "flags": 0,
      "text": "讓氣場的效果逆轉，\\n並降低威力。"
    },
    {
      "index": 189,
      "id": "TOKUSEIINFO_189",
      "hash": "84d52706d68a4c7c",
      "flags": 0,
      "text": "變為讓火屬性攻擊\\n失效的天氣。"
    },
    {
      "index": 190,
      "id": "TOKUSEIINFO_190",
      "hash": "84d1aa06d687423e",
      "flags": 0,
      "text": "變為讓水屬性攻擊\\n失效的天氣。"
    },
    {
      "index": 191,
      "id": "TOKUSEIINFO_191",
      "hash": "84d1ab06d68743f1",
      "flags": 0,
      "text": "變為令飛行屬性的弱點\\n消失的天氣。"
    },
    {
      "index": 192,
      "id": "TOKUSEIINFO_192",
      "hash": "84d1a806d6873ed8",
      "flags": 0,
      "text": "受到攻擊時，\\n防禦會提高。"
    },
    {
      "index": 193,
      "id": "TOKUSEIINFO_193",
      "hash": "84d1a906d687408b",
      "flags": 0,
      "text": "HP變為一半時，\\n會慌慌張張逃走，\\n退回同行隊伍裡面。"
    },
    {
      "index": 194,
      "id": "TOKUSEIINFO_194",
      "hash": "84d1ae06d687490a",
      "flags": 0,
      "text": "HP減到一半時，\\n為了避開危險，\\n會退回同行隊伍裡面。"
    },
    {
      "index": 195,
      "id": "TOKUSEIINFO_195",
      "hash": "84d1af06d6874abd",
      "flags": 0,
      "text": "受到水屬性的招式攻擊時，\\n防禦會大幅提高。"
    },
    {
      "index": 196,
      "id": "TOKUSEIINFO_196",
      "hash": "84d1ac06d68745a4",
      "flags": 0,
      "text": "攻擊中毒狀態的對手時，\\n必定會擊中要害。"
    },
    {
      "index": 197,
      "id": "TOKUSEIINFO_197",
      "hash": "84d1ad06d6874757",
      "flags": 0,
      "text": "HP變為一半時，\\n殼會壞掉，變得更有攻擊性。"
    },
    {
      "index": 198,
      "id": "TOKUSEIINFO_198",
      "hash": "84d1a206d68734a6",
      "flags": 0,
      "text": "可以向替換出場的對手\\n以２倍的傷害進行攻擊。"
    },
    {
      "index": 199,
      "id": "TOKUSEIINFO_199",
      "hash": "84d1a306d6873659",
      "flags": 0,
      "text": "降低與自己相對的火屬性\\n招式的威力，不會灼傷。"
    },
    {
      "index": 200,
      "id": "TOKUSEIINFO_200",
      "hash": "8dd05b06dbb7dcaa",
      "flags": 0,
      "text": "鋼屬性的招式威力會提高。"
    },
    {
      "index": 201,
      "id": "TOKUSEIINFO_201",
      "hash": "8dd05c06dbb7de5d",
      "flags": 0,
      "text": "HP因對手的攻擊\\n降到一半時，\\n特攻會提高。"
    },
    {
      "index": 202,
      "id": "TOKUSEIINFO_202",
      "hash": "8dd05906dbb7d944",
      "flags": 0,
      "text": "天氣為冰雹時，\\n速度會提高。"
    },
    {
      "index": 203,
      "id": "TOKUSEIINFO_203",
      "hash": "8dd05a06dbb7daf7",
      "flags": 0,
      "text": "可以不接觸對手\\n就使出所有的招式。"
    },
    {
      "index": 204,
      "id": "TOKUSEIINFO_204",
      "hash": "8dd05706dbb7d5de",
      "flags": 0,
      "text": "所有的聲音招式\\n都變為水屬性。"
    },
    {
      "index": 205,
      "id": "TOKUSEIINFO_205",
      "hash": "8dd05806dbb7d791",
      "flags": 0,
      "text": "可以搶先使出回復招式。"
    },
    {
      "index": 206,
      "id": "TOKUSEIINFO_206",
      "hash": "8dd05506dbb7d278",
      "flags": 0,
      "text": "一般屬性的招式\\n會變為電屬性。\\n威力會少量提高。"
    },
    {
      "index": 207,
      "id": "TOKUSEIINFO_207",
      "hash": "8dd05606dbb7d42b",
      "flags": 0,
      "text": "電氣場地時，\\n速度會變為２倍。"
    },
    {
      "index": 208,
      "id": "TOKUSEIINFO_208",
      "hash": "8dd05306dbb7cf12",
      "flags": 0,
      "text": "HP多的時候會聚起來變強。\\nHP剩餘量變少時，\\n群體會分崩離析。"
    },
    {
      "index": 209,
      "id": "TOKUSEIINFO_209",
      "hash": "8dd05406dbb7d0c5",
      "flags": 0,
      "text": "用畫皮覆蓋住身體，\\n可防住１次攻擊。"
    },
    {
      "index": 210,
      "id": "TOKUSEIINFO_210",
      "hash": "8dd3c106dbbabfd3",
      "flags": 0,
      "text": "打倒對手時，與訓練家的牽絆會加深，\\n變化成小智版甲賀忍蛙。\\n飛水手裡劍的威力會增強。"
    },
    {
      "index": 211,
      "id": "TOKUSEIINFO_211",
      "hash": "8dd3c006dbbabe20",
      "flags": 0,
      "text": "HP變為一半時，\\n細胞們會趕來支援，\\n變為完全體形態。"
    },
    {
      "index": 212,
      "id": "TOKUSEIINFO_212",
      "hash": "8dd3c306dbbac339",
      "flags": 0,
      "text": "就算對方是鋼屬性或毒屬性寶可夢，\\n也可讓對方陷入中毒狀態。"
    },
    {
      "index": 213,
      "id": "TOKUSEIINFO_213",
      "hash": "8dd3c206dbbac186",
      "flags": 0,
      "text": "總是半夢半醒的狀態，\\n絕對不會醒來。\\n可在睡著的狀況下進行攻擊。"
    },
    {
      "index": 214,
      "id": "TOKUSEIINFO_214",
      "hash": "8dd3c506dbbac69f",
      "flags": 0,
      "text": "向對手施加威懾力，\\n使其無法對我方使出先制招式。"
    },
    {
      "index": 215,
      "id": "TOKUSEIINFO_215",
      "hash": "8dd3c406dbbac4ec",
      "flags": 0,
      "text": "被對手打倒的時候，\\n會給予對手相當於\\nHP剩餘量的傷害。"
    },
    {
      "index": 216,
      "id": "TOKUSEIINFO_216",
      "hash": "8dd3c706dbbaca05",
      "flags": 0,
      "text": "當有誰使出跳舞招式時，\\n自己也能接著使出跳舞招式。"
    },
    {
      "index": 217,
      "id": "TOKUSEIINFO_217",
      "hash": "8dd3c606dbbac852",
      "flags": 0,
      "text": "會提高我方的\\n特殊招式的威力。"
    },
    {
      "index": 218,
      "id": "TOKUSEIINFO_218",
      "hash": "8dd3c906dbbacd6b",
      "flags": 0,
      "text": "會將對手所給予的接觸類招式的傷害減半，\\n但火屬性招式的傷害會變為２倍。"
    },
    {
      "index": 219,
      "id": "TOKUSEIINFO_219",
      "hash": "8dd3c806dbbacbb8",
      "flags": 0,
      "text": "讓對手嚇一跳，\\n使其無法對我方使出先制招式。"
    },
    {
      "index": 220,
      "id": "TOKUSEIINFO_220",
      "hash": "8dc94f06dbb1a998",
      "flags": 0,
      "text": "每當場上有寶可夢\\n陷入瀕死狀態時，\\n特攻就會提高。"
    },
    {
      "index": 221,
      "id": "TOKUSEIINFO_221",
      "hash": "8dc95006dbb1ab4b",
      "flags": 0,
      "text": "對手用攻擊接觸到自己時，\\n降低此對手的速度。"
    },
    {
      "index": 222,
      "id": "TOKUSEIINFO_222",
      "hash": "8dc95106dbb1acfe",
      "flags": 0,
      "text": "繼承被打倒的同伴的特性，\\n變為相同的特性。"
    },
    {
      "index": 223,
      "id": "TOKUSEIINFO_223",
      "hash": "8dc95206dbb1aeb1",
      "flags": 0,
      "text": "繼承被打倒的同伴的特性，\\n變為相同的特性。"
    },
    {
      "index": 224,
      "id": "TOKUSEIINFO_224",
      "hash": "8dc95306dbb1b064",
      "flags": 0,
      "text": "打倒對手的時候，\\n會提高自己最高的那項能力。"
    },
    {
      "index": 225,
      "id": "TOKUSEIINFO_225",
      "hash": "8dc95406dbb1b217",
      "flags": 0,
      "text": "根據持有的記憶碟，\\n自己的屬性會改變。"
    },
    {
      "index": 226,
      "id": "TOKUSEIINFO_226",
      "hash": "8dc95506dbb1b3ca",
      "flags": 0,
      "text": "出場時，\\n會布下電氣場地。"
    },
    {
      "index": 227,
      "id": "TOKUSEIINFO_227",
      "hash": "8dc95606dbb1b57d",
      "flags": 0,
      "text": "出場時，\\n會布下精神場地。"
    },
    {
      "index": 228,
      "id": "TOKUSEIINFO_228",
      "hash": "8dc94706dbb19c00",
      "flags": 0,
      "text": "出場時，\\n會布下薄霧場地。"
    },
    {
      "index": 229,
      "id": "TOKUSEIINFO_229",
      "hash": "8dc94806dbb19db3",
      "flags": 0,
      "text": "出場時，\\n會布下青草場地。"
    },
    {
      "index": 230,
      "id": "TOKUSEIINFO_230",
      "hash": "8dccd506dbb4c321",
      "flags": 0,
      "text": "不會因對手的招式或特性\\n而被降低能力。"
    },
    {
      "index": 231,
      "id": "TOKUSEIINFO_231",
      "hash": "8dccd406dbb4c16e",
      "flags": 0,
      "text": "HP全滿時，\\n受到的傷害會變少。"
    },
    {
      "index": 232,
      "id": "TOKUSEIINFO_232",
      "hash": "8dccd306dbb4bfbb",
      "flags": 0,
      "text": "受到效果絕佳的攻擊時，\\n可減弱其威力。"
    },
    {
      "index": 233,
      "id": "TOKUSEIINFO_233",
      "hash": "8dccd206dbb4be08",
      "flags": 0,
      "text": "可進一步提升\\n效果絕佳招式的威力。"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_tokuseiinfo_max",
      "hash": "7c55fa6c8ed2c7fc"
    }
  ]
}
