      "hash": "8e3d22286f90f2f4",
      "flags": 0,
      "text": "有點容易得意忘形。"
    },
    {
      "index": 74,
      "id": "trmemo_03_04_04",
      "hash": "8e3d21286f90f141",
      "flags": 0,
      "text": "逃得快。"
    },
    {
      "index": 75,
      "id": "trmemo_03_05_00",
      "hash": "ba440f2ed0fad75c",
      "flags": 0,
      "text": "好奇心強。"
    },
    {
      "index": 76,
      "id": "trmemo_03_05_01",
      "hash": "ba44102ed0fad90f",
      "flags": 0,
      "text": "喜歡惡作劇。"
    },
    {
      "index": 77,
      "id": "trmemo_03_05_02",
      "hash": "ba44112ed0fadac2",
      "flags": 0,
      "text": "做事萬無一失。"
    },
    {
      "index": 78,
      "id": "trmemo_03_05_03",
      "hash": "ba44122ed0fadc75",
      "flags": 0,
      "text": "經常思考。"
    },
    {
      "index": 79,
      "id": "trmemo_03_05_04",
      "hash": "ba440b2ed0fad090",
      "flags": 0,
      "text": "一絲不苟。"
    },
    {
      "index": 80,
      "id": "trmemo_03_06_00",
      "hash": "64fa5938e0071b6b",
      "flags": 0,
      "text": "性格強勢。"
    },
    {
      "index": 81,
      "id": "trmemo_03_06_01",
      "hash": "64fa5838e00719b8",
      "flags": 0,
      "text": "有一點點愛慕虛榮。"
    },
    {
      "index": 82,
      "id": "trmemo_03_06_02",
      "hash": "64fa5b38e0071ed1",
      "flags": 0,
      "text": "爭強好勝。"
    },
    {
      "index": 83,
      "id": "trmemo_03_06_03",
      "hash": "64fa5a38e0071d1e",
      "flags": 0,
      "text": "不服輸。"
    },
    {
      "index": 84,
      "id": "trmemo_03_06_04",
      "hash": "64fa5d38e0072237",
      "flags": 0,
      "text": "有一點點固執。"
    },
    {
