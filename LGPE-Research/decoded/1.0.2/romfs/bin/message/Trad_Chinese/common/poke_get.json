      "text": ""
    },
    {
      "index": 40,
      "id": "poke_get_10_11",
      "hash": "fe27682622a50644",
      "flags": 0,
      "text": "成功捕獲"
    },
    {
      "index": 41,
      "id": "poke_get_10_12",
      "hash": "fe276b2622a50b5d",
      "flags": 0,
      "text": "尺寸獎勵"
    },
    {
      "index": 42,
      "id": "poke_get_10_13",
      "hash": "fe276a2622a509aa",
      "flags": 0,
      "text": "技術投擲"
    },
    {
      "index": 43,
      "id": "poke_get_10_14",
      "hash": "fe27652622a5012b",
      "flags": 0,
      "text": ""
    },
    {
