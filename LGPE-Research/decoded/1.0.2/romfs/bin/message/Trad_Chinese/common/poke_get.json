    },
    {
      "index": 35,
      "id": "poke_get_10_06",
      "hash": "fe23e52622a1f1d4",
      "flags": 0,
      "text": ""
    },
    {
      "index": 36,
      "id": "poke_get_10_07",
      "hash": "fe23e62622a1f387",
      "flags": 0,
      "text": "一擊中的"
    },
    {
      "index": 37,
      "id": "poke_get_10_08",
      "hash": "fe23db2622a1e0d6",
      "flags": 0,
      "text": "同步捕獲"
    },
    {
      "index": 38,
      "id": "poke_get_10_09",
      "hash": "fe23dc2622a1e289",
      "flags": 0,
