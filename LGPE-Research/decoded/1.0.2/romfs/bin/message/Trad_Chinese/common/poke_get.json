      "text": "獎勵倍率"
    },
    {
      "index": 31,
      "id": "poke_get_10_02",
      "hash": "fe23e12622a1eb08",
      "flags": 0,
      "text": "新寶可夢"
    },
    {
      "index": 32,
      "id": "poke_get_10_03",
