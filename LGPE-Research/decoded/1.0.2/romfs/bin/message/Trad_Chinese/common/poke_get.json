{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "poke_get_01_00",
      "hash": "3a06eefb470cba20",
      "flags": 0,
      "text": "是GO Park裡的[VAR POKNAME(0000)]！"
    },
    {
      "index": 1,
      "id": "poke_get_01_01",
      "hash": "3a06effb470cbbd3",
      "flags": 0,
      "text": "啊！野生的\\n[VAR POKNAME(0000)]跑出來了！"
    },
    {
      "index": 2,
      "id": "poke_get_01_02",
      "hash": "3a06f0fb470cbd86",
      "flags": 0,
      "text": "機會來了！\\n快捉住野生的[VAR POKNAME(0000)]！"
    },
    {
      "index": 3,
      "id": "poke_get_01_03",
      "hash": "3a06f1fb470cbf39",
      "flags": 0,
      "text": "機會來了！\\n快捉住[VAR POKNAME(0000)]！"
    },
    {
      "index": 4,
      "id": "poke_get_01_04",
      "hash": "3a06f2fb470cc0ec",
      "flags": 0,
      "text": "要放棄捕捉寶可夢嗎？"
    },
    {
      "index": 5,
      "id": "poke_get_01_05",
      "hash": "3a06f3fb470cc29f",
      "flags": 0,
      "text": "要退出投擲精靈球\\n的操作說明嗎？"
    },
    {
      "index": 6,
      "id": "poke_get_01_06",
      "hash": "3a06f4fb470cc452",
      "flags": 0,
      "text": "已經無法持有更多寶可夢了！\\n先暫時放棄吧！"
    },
    {
      "index": 7,
      "id": "poke_get_01_07",
      "hash": "3a06f5fb470cc605",
      "flags": 0,
      "text": "已經沒有精靈球了！\\n先暫時放棄吧！"
    },
    {
      "index": 8,
      "id": "poke_get_01_08",
      "hash": "3a06f6fb470cc7b8",
      "flags": 0,
      "text": "不行！寶可夢\\n從球裡跑出來了！"
    },
    {
      "index": 9,
      "id": "poke_get_01_09",
      "hash": "3a06f7fb470cc96b",
      "flags": 0,
      "text": "啊啊！\\n還以為捉到了！"
    },
    {
      "index": 10,
      "id": "poke_get_01_10",
      "hash": "3a0a74fb470fd3a9",
      "flags": 0,
      "text": "真遺憾！\\n差一點就捉到了！"
    },
    {
      "index": 11,
      "id": "poke_get_01_11",
      "hash": "3a0a73fb470fd1f6",
      "flags": 0,
      "text": "可惜啊！\\n就只差一點點了！"
    },
    {
      "index": 12,
      "id": "poke_get_01_12",
      "hash": "3a0a72fb470fd043",
      "flags": 0,
      "text": "太好了！\\n捉到[VAR POKNAME(0000)]了！"
    },
    {
      "index": 13,
      "id": "poke_get_01_13",
      "hash": "3a0a71fb470fce90",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]逃走了！"
    },
    {
      "index": 14,
      "id": "poke_get_01_14",
      "hash": "3a0a78fb470fda75",
      "flags": 0,
      "text": "順利逃走了！"
    },
    {
      "index": 15,
      "id": "poke_get_01_15",
      "hash": "3a0a77fb470fd8c2",
      "flags": 0,
      "text": "[VAR SUPPORT(0000)]不知從哪裡\\n趕過來幫忙了！"
    },
    {
      "index": 16,
      "id": "poke_get_02_01",
      "hash": "660df801a876ce1c",
      "flags": 0,
      "text": "是"
    },
    {
      "index": 17,
      "id": "poke_get_02_02",
      "hash": "660dfb01a876d335",
      "flags": 0,
      "text": "否"
    },
    {
      "index": 18,
      "id": "poke_get_03_01",
      "hash": "3b8f840cf1deb8b1",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]"
    },
    {
      "index": 19,
      "id": "poke_get_03_02",
      "hash": "3b8f810cf1deb398",
      "flags": 0,
      "text": "Lv.[VAR NUM3(0000)]"
    },
