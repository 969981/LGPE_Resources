      "flags": 0,
      "text": "……噗通！"
    },
    {
      "index": 11,
      "id": "msg_sub056_system_05",
      "hash": "72c7e60669721458",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]把₽[VAR NUM3(0001)]\\n扔進了噴水池！"
