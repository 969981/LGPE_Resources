{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub085_musasi_01",
      "hash": "5ea012df50658f55",
      "flags": 0,
      "text": "武藏「喂～\\n讓我們過去啦！"
    },
    {
      "index": 1,
      "id": "msg_sub085_rocketm_01",
      "hash": "776568bd7cee60a0",
      "flags": 0,
      "text": "不行！上面下了命令，\\n除了作戰人員之外一律不准過去。"
    },
    {
      "index": 2,
      "id": "msg_sub085_kojiro_01",
      "hash": "26e795e55c88e1ff",
      "flags": 0,
      "text": "小次郎「別那麼死板嘛！"
    },
    {
      "index": 3,
      "id": "msg_sub085_musasi_02",
      "hash": "5ea00fdf50658a3c",
      "flags": 0,
      "text": "武藏「真是的！\\n急死我了！"
    },
    {
      "index": 4,
      "id": "msg_sub085_musasi_03",
      "hash": "5ea010df50658bef",
      "flags": 0,
      "text": "廢　話　少　說\\n給　我　讓　開！！"
    },
    {
      "index": 5,
      "id": "msg_sub085_kojiro_02",
      "hash": "26e796e55c88e3b2",
      "flags": 0,
      "text": "小次郎「喂～\\n等等我啊～武藏～"
    },
    {
      "index": 6,
      "id": "msg_sub085_stop_01",
      "hash": "7a5645749be1654b",
      "flags": 0,
      "text": "我是警衛。\\n像[VAR GENDBR(00FF,0101)]你妳這種可疑的小孩……\\c\\n我是不會放[VAR GENDBR(00FF,0101)]你妳過去的。"
    },
    {
      "index": 7,
      "id": "msg_sub085_stop_02",
      "hash": "7a5646749be166fe",
      "flags": 0,
      "text": "嗚……"
    },
    {
      "index": 8,
      "id": "msg_sub085_stop_03",
      "hash": "7a5647749be168b1",
      "flags": 0,
      "text": "他好像昏過去了……"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_085_max",
