{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8100_ice_01",
      "hash": "9bd64f786c7760b5",
      "flags": 0,
      "text": "科拿「歡迎來到寶可夢聯盟！"
    },
    {
      "index": 1,
      "id": "msg_main8100_ice_09",
      "hash": "9bd657786c776e4d",
      "flags": 0,
      "text": "哎呀！[VAR GENDBR(00FF,0101)]你妳終於來了。\\n我等了[VAR GENDBR(00FF,0101)]你妳好久呢！"
    },
    {
      "index": 2,
      "id": "msg_main8100_ice_10",
      "hash": "9bd954786c799f0b",
      "flags": 0,
      "text": "……讓我重新自我介紹吧。\\n我是四天王之一的科拿！"
    },
    {
      "index": 3,
      "id": "msg_main8100_ice_05",
      "hash": "9bd64b786c7759e9",
      "flags": 0,
      "text": "只要讓我用上冰屬性寶可夢，\\n我敢說沒有人是我的對手！"
    },
    {
      "index": 4,
      "id": "msg_main8100_ice_06",
      "hash": "9bd648786c7754d0",
      "flags": 0,
      "text": "能凍住對手\\n可是很厲害的喔！"
    },
    {
      "index": 5,
      "id": "msg_main8100_ice_07",
      "hash": "9bd649786c775683",
      "flags": 0,
      "text": "畢竟要是被凍住了，\\n[VAR GENDBR(00FF,0101)]你妳的寶可夢就無法動彈了。"
    },
    {
      "index": 6,
      "id": "msg_main8100_ice_08",
      "hash": "9bd656786c776c9a",
      "flags": 0,
      "text": "……啊哈哈！\\n好了，[VAR GENDBR(00FF,0101)]你妳做好覺悟了嗎！"
    },
    {
      "index": 7,
      "id": "msg_kanna_01_p02_cave_d1401",
      "hash": "c7b6a229dc0321ce",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "msg_main8100_ice_02",
      "hash": "9bd64c786c775b9c",
      "flags": 0,
      "text": "科拿「原來[VAR GENDBR(00FF,0101)]你妳已經變得這麼強了！\\n好吧……！\\r\\n[VAR GENDBR(00FF,0101)]你妳可以前往下一個房間了！\\c\\n不過，\\n寶可夢聯盟真正的厲害之處\\r\\n還在後頭呢……！\\r\\n別以為這麼簡單就能結束喔！"
    },
    {
      "index": 9,
      "id": "msg_main8100_ice_03",
      "hash": "9bd64d786c775d4f",
      "flags": 0,
      "text": "科拿「歡迎來到寶可夢聯盟！\\c\\n[VAR GENDBR(00FF,0101)]你妳來得正好！\\n我正想著要和[VAR GENDBR(00FF,0101)]你妳來場對戰呢！\\c\\n好了，[VAR GENDBR(00FF,0101)]你妳做好覺悟了吧！"
    },
    {
      "index": 10,
      "id": "msg_main8100_ice_04",
      "hash": "9bd64a786c775836",
      "flags": 0,
      "text": "科拿「雖然我輸給了[VAR GENDBR(00FF,0101)]你妳，\\n但我是不會因此\\r\\n放棄冰屬性寶可夢的！\\c\\n[VAR GENDBR(00FF,0101)]你妳也要和[VAR GENDBR(00FF,0101)]你妳喜歡的寶可夢一起\\n一路贏到最後喔！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_8100_max",
      "hash": "c31c6096ed266540"
    }
  ]
}
