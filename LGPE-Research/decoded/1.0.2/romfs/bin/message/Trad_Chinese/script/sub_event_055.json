{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub055_rocket_F_01",
      "hash": "5498d5667fefd771",
      "flags": 0,
      "text": "噓！我是個\\n正在進行任務的美女間諜……"
    },
    {
      "index": 1,
      "id": "msg_sub055_rocket_F_02",
      "hash": "5498d2667fefd258",
      "flags": 0,
      "text": "像[VAR GENDBR(00FF,0101)]你妳這樣的孩子\\n為什麼會在這裡？"
    },
    {
      "index": 2,
      "id": "msg_sub055_select_01",
      "hash": "4a4a607772b44436",
      "flags": 0,
      "text": "為了打倒火箭隊"
    },
    {
      "index": 3,
      "id": "msg_sub055_select_02",
      "hash": "4a4a5f7772b44283",
      "flags": 0,
      "text": "不為什麼"
    },
    {
      "index": 4,
      "id": "msg_sub055_rocket_F_03",
      "hash": "5498d3667fefd40b",
      "flags": 0,
      "text": "……呵呵！真敢說！\\n我欣賞[VAR GENDBR(00FF,0101)]你妳！"
    },
    {
      "index": 5,
      "id": "msg_sub055_rocket_F_04",
      "hash": "5498d8667fefdc8a",
      "flags": 0,
      "text": "呵呵……\\n[VAR GENDBR(00FF,0101)]你妳真是個有趣的孩子！"
    },
    {
      "index": 6,
      "id": "msg_sub055_rocket_F_05",
      "hash": "5498d9667fefde3d",
      "flags": 0,
      "text": "為慶祝我們相識，\\n送[VAR GENDBR(00FF,0101)]你妳這個吧！"
    },
    {
      "index": 7,
      "id": "msg_sub055_system_01",
      "hash": "6f29e6463da93961",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]從美女間諜那裡\\n得到了[VAR COLOR(0006)]火箭隊套裝[VAR COLOR(0000)]！"
    },
    {
      "index": 8,
      "id": "msg_sub055_system_02",
      "hash": "6f29e3463da93448",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]把[VAR COLOR(0006)]火箭隊套裝[VAR COLOR(0000)]\\n放進了換裝箱！"
    },
    {
      "index": 9,
      "id": "msg_sub055_rocket_F_06",
      "hash": "5498d6667fefd924",
      "flags": 0,
      "text": "只要穿上這個，\\n感覺就像是成了火箭隊的成員呢！"
    },
    {
      "index": 10,
      "id": "msg_sub055_rocket_F_07",
      "hash": "5498d7667fefdad7",
      "flags": 0,
      "text": "……不過以[VAR GENDBR(00FF,0101)]你妳的身高，\\n誰都能一眼就看出\\r\\n[VAR GENDBR(00FF,0101)]你妳這是角色扮演吧。"
    },
    {
      "index": 11,
      "id": "msg_sub055_rocket_F_08",
      "hash": "5498cc667fefc826",
      "flags": 0,
      "text": "[VAR GENDBR(00FF,0101)]你妳要是把我的間諜身份說出去……\\n我可不會放過[VAR GENDBR(00FF,0101)]你妳喔！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_055_max",
      "hash": "eed5f39da5c02f50"
    }
  ]
}
