{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub003_childf_01",
      "hash": "c1626e54b51bb525",
      "flags": 0,
      "text": "嗚嗚……！人家想喝\\n自動販賣機的飲料啦！"
    },
    {
      "index": 1,
      "id": "msg_sub003_sys_00",
      "hash": "18b71d43373e409b",
      "flags": 0,
      "text": "要送她飲料嗎？"
    },
    {
      "index": 2,
      "id": "msg_sub003_childf_02",
      "hash": "c1626b54b51bb00c",
      "flags": 0,
      "text": "嗚嗚……！人家想喝\\n自動販賣機的飲料啦！"
    },
    {
      "index": 3,
      "id": "msg_sub003_sys_01",
      "hash": "18b71c43373e3ee8",
      "flags": 0,
      "text": "要送她哪種飲料？"
    },
    {
      "index": 4,
      "id": "msg_sub003_select_01",
      "hash": "4e165798afa8e5c1",
      "flags": 0,
      "text": "美味之水"
    },
    {
      "index": 5,
      "id": "msg_sub003_select_02",
      "hash": "4e165498afa8e0a8",
      "flags": 0,
      "text": "勁爽汽水"
    },
    {
      "index": 6,
      "id": "msg_sub003_select_03",
      "hash": "4e165598afa8e25b",
      "flags": 0,
      "text": "果汁牛奶"
    },
    {
      "index": 7,
      "id": "msg_sub003_select_04",
      "hash": "4e165a98afa8eada",
      "flags": 0,
      "text": "取消"
    },
    {
      "index": 8,
      "id": "msg_sub003_childf_03",
      "hash": "c1626c54b51bb1bf",
      "flags": 0,
      "text": "哇～！\\c\\n[VAR GENDBR(00FF,0101)]你妳要請我喝美味之水嗎？\\c\\n謝謝[VAR GENDBR(00FF,0101)]你妳！\\c\\n這是我的寶物，\\n送給[VAR GENDBR(00FF,0101)]你妳當作謝禮吧！"
    },
    {
      "index": 9,
      "id": "msg_sub003_sys_02",
      "hash": "18b71f43373e4401",
      "flags": 0,
      "text": "[~ 9]"
    },
    {
      "index": 10,
      "id": "msg_sub003_childf_04",
      "hash": "c1626954b51baca6",
      "flags": 0,
      "text": "招式學習器06\\n是「光牆」喔！\\c\\n它能減弱特殊攻擊\\n帶來的傷害。"
    },
    {
      "index": 11,
      "id": "msg_present_01_p05_t007_fs07",
      "hash": "8afe75b5dd6b6943",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_sub003_childf_05",
      "hash": "c1626a54b51bae59",
      "flags": 0,
      "text": "哇～！\\c\\n[VAR GENDBR(00FF,0101)]你妳要請我喝勁爽汽水嗎？\\c\\n謝謝[VAR GENDBR(00FF,0101)]你妳！\\c\\n這是我的寶物，\\n送給[VAR GENDBR(00FF,0101)]你妳當作謝禮吧！"
    },
    {
      "index": 13,
      "id": "msg_sub003_childf_06",
      "hash": "c1626754b51ba940",
      "flags": 0,
      "text": "招式學習器09\\n是「反射壁」喔！\\c\\n它能減弱物理攻擊\\n帶來的傷害。"
    },
    {
      "index": 14,
      "id": "msg_present_01_p07_t007_fs07",
      "hash": "4832b3661df744e1",
      "flags": 0,
      "text": "[~ 14]"
    },
    {
      "index": 15,
      "id": "msg_sub003_childf_07",
      "hash": "c1626854b51baaf3",
      "flags": 0,
      "text": "哇～！\\c\\n[VAR GENDBR(00FF,0101)]你妳要請我喝果汁牛奶嗎？\\c\\n謝謝[VAR GENDBR(00FF,0101)]你妳！\\c\\n這是我的寶物，\\n送給[VAR GENDBR(00FF,0101)]你妳當作謝禮吧！"
    },
    {
      "index": 16,
      "id": "msg_sub003_childf_08",
      "hash": "c1627554b51bc10a",
      "flags": 0,
      "text": "招式學習器07\\n是「守住」喔！\\c\\n它能擋住對手的招式。"
    },
    {
      "index": 17,
      "id": "msg_present_01_p09_t007_fs07",
      "hash": "92871b329adafcd7",
      "flags": 0,
      "text": "[~ 17]"
    },
    {
      "index": 18,
      "id": "msg_present_01_p10_t007_fs06",
      "hash": "3b08dc2eeb488f1e",
      "flags": 0,
      "text": "[~ 18]"
    },
    {
      "index": 19,
      "id": "msg_sub003_childf_09",
      "hash": "c1627654b51bc2bd",
      "flags": 0,
      "text": "嗯……！\\n我還是忍耐一下好了！"
    }
  ],
