{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main1510_doctor_01",
      "hash": "5757b24c2dfc5681",
      "flags": 0,
      "text": "大木博士「……嗯哼！\\n恭喜[VAR GENDBR(00FF,0101)]你妳！[VAR TRNAME(0000)]！"
    },
    {
      "index": 1,
      "id": "msg_main1510_doctor_02",
      "hash": "5757af4c2dfc5168",
      "flags": 0,
      "text": "歷代寶可夢聯盟中，\\n每一隻在訓練家身邊\\r\\n大展身手的寶可夢……\\c\\n都會被記錄在這個樓層，\\n作為永恆的表彰！"
    },
    {
      "index": 2,
      "id": "msg_main1510_doctor_03",
      "hash": "5757b04c2dfc531b",
      "flags": 0,
      "text": "寶可夢訓練家們將這樣的表彰\\n稱呼為「登入名人堂」，\\r\\n這是至高無上的喜悅！"
    },
    {
      "index": 3,
      "id": "msg_main1510_doctor_04",
      "hash": "5757b54c2dfc5b9a",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]！\\n[VAR GENDBR(00FF,0101)]你妳在經歷了激烈的對決後，\\r\\n成為了聯盟冠軍！"
    },
    {
      "index": 4,
      "id": "msg_main1510_doctor_05",
      "hash": "5757b64c2dfc5d4d",
      "flags": 0,
      "text": "現在我們就把[VAR TRNAME(0000)]和\\n寶可夢的名字記錄於此吧！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_1510_max",
      "hash": "884dc67791ee76d8"
    }
  ]
}
