{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main_0450_water_01",
      "hash": "7439386f7b29a278",
      "flags": 0,
      "text": "小霞「哎呀，是[VAR GENDBR(00FF,0101)]你妳！"
    },
    {
      "index": 1,
      "id": "msg_main_0450_water_02",
      "hash": "74393b6f7b29a791",
      "flags": 0,
      "text": "哦！[VAR GENDBR(00FF,0101)]你妳打贏了馬志士啊。\\n挺厲害的嘛！\\c\\n看來一切都很順利！\\n好了，辛苦[VAR GENDBR(00FF,0101)]你妳了！"
    },
    {
      "index": 2,
      "id": "msg_main_0450_sys_01",
      "hash": "b2b280679438be5e",
      "flags": 0,
      "text": "小霞幫寶可夢\\n恢復了活力！"
    },
    {
      "index": 3,
      "id": "msg_main_0450_sys_02",
      "hash": "b2b27f679438bcab",
      "flags": 0,
      "text": "小霞幫寶可夢們\\n恢復了活力！"
    },
    {
      "index": 4,
      "id": "msg_main_0450_water_03",
      "hash": "74393a6f7b29a5de",
      "flags": 0,
      "text": "小霞「……[VAR GENDBR(00FF,0101)]你妳說我嗎？\\n當然是去海邊玩囉。\\c\\n有時候我也會想\\n走出狹小的游泳池，\\r\\n到廣闊的大海去盡情游泳的！"
    },
    {
      "index": 5,
      "id": "msg_main_0450_water_04",
      "hash": "74393d6f7b29aaf7",
      "flags": 0,
      "text": "小霞「[VAR GENDBR(00FF,0101)]你妳接下來要去哪裡？\\c\\n[VAR GENDBR(00FF,0101)]你妳去過這附近\\n一個叫地鼠洞穴的地方嗎？\\c\\n還沒去過的話，\\n要不要我帶[VAR GENDBR(00FF,0101)]你妳過去？"
    },
    {
      "index": 6,
      "id": "msg_main_0450_water_05",
      "hash": "74393c6f7b29a944",
      "flags": 0,
      "text": "哎呀，[VAR GENDBR(00FF,0101)]你妳怎麼這樣，\\n居然拒絕人家的一番好意。"
    },
    {
      "index": 7,
      "id": "msg_main_0450_water_06",
      "hash": "74393f6f7b29ae5d",
      "flags": 0,
      "text": "好，那我們走吧！"
    },
    {
      "index": 8,
      "id": "msg_main_0450_water_07",
      "hash": "74393e6f7b29acaa",
      "flags": 0,
      "text": "小霞「這裡就是地鼠洞穴了！\\c\\n這個洞穴是地鼠\\n在地底下鑽出來的喔！\\c\\n那就再見啦！\\n要和更多寶可夢相遇喔！"
    },
    {
      "index": 9,
      "id": "msg_main_0450_water_08",
      "hash": "7439316f7b299693",
      "flags": 0,
      "text": "[~ 9]"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0450_max",
      "hash": "0b033ba488b61cca"
    }
  ]
}
