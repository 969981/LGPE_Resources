{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "fe_amai_msg00",
      "hash": "7a6591e7fa5270a7",
      "flags": 0,
      "text": "這裡看起來\\n什麼也沒有……"
    },
    {
      "index": 1,
      "id": "msg_kagu1_bg",
      "hash": "cdf3b18078b3f908",
      "flags": 0,
      "text": "裡面整齊地擺著\\n各種餐具！"
    },
    {
      "index": 2,
      "id": "msg_kagu2_bg",
      "hash": "a0b3a17a163fa0e3",
      "flags": 0,
      "text": "好香的味道！\\n好像才剛做過什麼料理！"
    },
    {
      "index": 3,
      "id": "msg_kagu3_bg",
      "hash": "c9eb816ecbc1f832",
      "flags": 0,
      "text": "漂亮的櫃子！\\n好像可以裝進不少東西！"
    },
    {
      "index": 4,
      "id": "msg_kagu4_bg",
      "hash": "730c41672ff1c605",
      "flags": 0,
      "text": "上面供奉著各種食物。"
    },
    {
      "index": 5,
      "id": "msg_kagu5_bg",
      "hash": "49245160d0548fe4",
      "flags": 0,
      "text": "一幅畫著寶可夢的美麗圖畫！\\n看起來十分賞心悅目！"
    },
    {
      "index": 6,
      "id": "msg_kagu6_bg",
      "hash": "9b158156be707c7f",
      "flags": 0,
      "text": "這是用來做什麼的機器呢！？\\n還是別隨便亂碰比較好！"
    },
    {
      "index": 7,
      "id": "msg_kagu7_bg",
      "hash": "712e91505ed4f95e",
      "flags": 0,
      "text": "是電話！\\n現在還是別打電話吧！"
    },
    {
      "index": 8,
      "id": "msg_kagu8_bg",
      "hash": "03f0b1cd88a71721",
      "flags": 0,
      "text": "上面寫著各種\\n商品的宣傳！"
    },
    {
      "index": 9,
      "id": "msg_kagu9_bg",
      "hash": "2d2881c23e295340",
      "flags": 0,
      "text": "好香的味道！\\n肚子餓得咕咕叫了！"
    },
    {
      "index": 10,
      "id": "msg_kagu10_bg",
      "hash": "2900f7fa1e970ca4",
      "flags": 0,
      "text": "裡面……\\c\\n什麼也沒有！"
    },
    {
      "index": 11,
      "id": "msg_kagu11_bg",
      "hash": "ffc8e805691463c5",
      "flags": 0,
      "text": "印著寶可夢標誌的杯子！"
    },
    {
      "index": 12,
      "id": "msg_kagu12_bg",
      "hash": "510b37e9ad17761e",
      "flags": 0,
      "text": "擦得非常乾淨的窗子！"
    },
    {
      "index": 13,
      "id": "msg_kagu13_bg",
      "hash": "27d327f4f794cd3f",
      "flags": 0,
      "text": "窗戶外面是……\\c\\n一面清澈漂亮的天空！"
    },
    {
      "index": 14,
      "id": "msg_kagu14_bg",
      "hash": "574a581eaef36dc8",
      "flags": 0,
      "text": "五顏六色的燈\\n在閃閃發亮！"
    },
    {
      "index": 15,
      "id": "msg_kagu15_bg",
      "hash": "59600823d6bb57e9",
      "flags": 0,
      "text": "陳列著各式各樣的道具！"
    },
    {
      "index": 16,
      "id": "msg_bouenkyou_01_p01_r011_r0102",
      "hash": "11249d7b557c7c93",
      "flags": 0,
      "text": "用望遠鏡看過去！\\c\\n有寶可夢在路上睡覺！"
    },
    {
      "index": 17,
      "id": "msg_bouenkyou_01_p02_r011_r0102",
      "hash": "d0e85fd19bb0169c",
      "flags": 0,
      "text": "用望遠鏡看過去！\\c\\n好美麗的風景！"
    },
    {
      "index": 18,
      "id": "msg_bouenkyou_02_p01_r011_r0102",
      "hash": "33193af75a560fb0",
      "flags": 0,
      "text": "用望遠鏡看過去！\\c\\n要去紫苑鎮的話……\\n好像從華藍市\\r\\n穿過岩山就可以了……"
    },
    {
      "index": 19,
      "id": "msg_bouenkyou_01_p01_r012_r0102",
      "hash": "2a2fd25bba926a22",
      "flags": 0,
      "text": "用望遠鏡看過去！\\c\\n有個大叔在釣魚！"
    },
    {
      "index": 20,
      "id": "msg_bouenkyou_02_p01_r012_r0102",
      "hash": "1447c575cf496bf5",
      "flags": 0,
      "text": "用望遠鏡看過去！\\c\\n可以看見寶可夢塔！"
    },
    {
      "index": 21,
      "id": "msg_bouenkyou_01_p01_r015_r0102",
      "hash": "d7f7e45d55f7429f",
      "flags": 0,
      "text": "用望遠鏡看過去！\\c\\n看見一隻大鳥閃閃發光，\\n朝著大海的方向飛去……"
    },
    {
      "index": 22,
      "id": "msg_bouenkyou_02_p01_r015_r0102",
      "hash": "98836cfee336ff7c",
      "flags": 0,
      "text": "用望遠鏡看過去！\\c\\n可以看見海的對面……\\n有一座小島！"
    },
    {
      "index": 23,
      "id": "msg_bouenkyou_01_p01_r016_r0202",
      "hash": "cea1afb32e7dc323",
      "flags": 0,
      "text": "用望遠鏡看過去！\\c\\n可以看見玉虹百貨公司！"
    },
    {
      "index": 24,
      "id": "msg_bouenkyou_02_p01_r016_r0202",
      "hash": "e85828a3f4702cc0",
      "flags": 0,
      "text": "用望遠鏡看過去！\\c\\n可以看見一條長長的\\n道路橫跨在海上！"
    },
    {
      "index": 25,
      "id": "msg_bouenkyou_01_p01_r018_r0102",
      "hash": "f4dd8c32d544ae70",
      "flags": 0,
      "text": "用望遠鏡看過去！\\c\\n可以看見西邊的真新鎮。"
    },
    {
      "index": 26,
      "id": "msg_bouenkyou_02_p01_r018_r0102",
      "hash": "4f604c3fda8dddd3",
      "flags": 0,
      "text": "用望遠鏡看過去！\\c\\n有人在游泳！"
    },
    {
      "index": 27,
      "id": "msg_sylph_door_01",
      "hash": "c36b343ea1a7c0f8",
      "flags": 0,
      "text": "……叮咚！\\n用鑰匙卡打開了門鎖！"
    },
    {
      "index": 28,
      "id": "msg_sylph_door_02",
      "hash": "c36b373ea1a7c611",
      "flags": 0,
      "text": "……不行！\\n沒有鑰匙卡打不開！"
    },
    {
      "index": 29,
      "id": "msg_book_01_bg",
      "hash": "7bb6486bae7c5172",
      "flags": 0,
      "text": "上面全是寶可夢的書！"
    },
    {
      "index": 30,
      "id": "msg_townmap_01_bg",
      "hash": "0de10cb9a0a3d80b",
      "flags": 0,
      "text": "是城鎮地圖！"
    },
    {
      "index": 31,
      "id": "msg_fsrack_01_bg",
      "hash": "6c92a1bfb5eb3e83",
      "flags": 0,
      "text": "哇啊！擺著好多\\n寶可夢相關商品！"
    },
    {
      "index": 32,
      "id": "msg_fs_01_bg",
      "hash": "1df07aa8257f8e68",
      "flags": 0,
      "text": "寶可夢相關商品應有盡有！\\n友好商店"
    },
    {
      "index": 33,
      "id": "msg_pc_01_bg",
      "hash": "dfee76fbce4be542",
      "flags": 0,
      "text": "為您的寶可夢回復體力！\\n寶可夢中心"
    },
    {
      "index": 34,
      "id": "msg_freeze_01_bg",
      "hash": "8e164c7fbea26a00",
      "flags": 0,
      "text": "裡面應該放滿了\\n美味的食物吧！"
    },
    {
      "index": 35,
      "id": "msg_sekkeizu_01_bg",
      "hash": "fa393e9b9200f706",
      "flags": 0,
      "text": "某種東西的設計圖！\\n上面是滿滿的各種文字和圖畫。"
    },
    {
      "index": 36,
      "id": "msg_pc_02_bg",
      "hash": "37629715141fdcf9",
      "flags": 0,
      "text": "上面全是複雜的文字和數字，\\n讓人看得一頭霧水！？"
    },
    {
      "index": 37,
      "id": "msg_masaki_01_bg",
      "hash": "93d2d7a15f3e81dd",
      "flags": 0,
      "text": "是一台看起來\\n很厲害的機器！"
    },
    {
      "index": 38,
      "id": "msg_game_01_bg",
      "hash": "5cb767c46e41f135",
      "flags": 0,
      "text": "最新款的遊戲機！\\n看起來很有趣！"
    },
    {
      "index": 39,
      "id": "msg_dorobou_01_bg",
      "hash": "a07f7a27a1a4b8e9",
      "flags": 0,
      "text": "這裡留下了被竊賊\\n翻動過的痕跡……"
    },
    {
      "index": 40,
      "id": "msg_tv_01_bg",
      "hash": "bb6a7c7d0b1fc1b5",
      "flags": 0,
      "text": "寶可夢出現在電視上！\\n牠看起來很開心！"
    },
    {
      "index": 41,
      "id": "msg_tv_02_bg",
      "hash": "8ca18c64fdd8eb8e",
      "flags": 0,
      "text": "電視螢幕上\\n映照出自己的模樣！"
    },
    {
      "index": 42,
      "id": "msg_t007r0805_elevator_01",
      "hash": "6b7cd65aaddff314",
      "flags": 0,
      "text": "看來需要鑰匙\\n才能啟動它。"
    },
    {
      "index": 43,
      "id": "msg_main_event_1100_switch_01",
      "hash": "ccd6e3039bca99fd",
      "flags": 0,
      "text": "按下秘密開關！\\n……我按！"
    },
    {
      "index": 44,
      "id": "msg_main_event_1100_switch_04",
      "hash": "ccd6de039bca917e",
      "flags": 0,
      "text": "……從某處傳來了\\n物體移動的聲音！"
    },
    {
      "index": 45,
      "id": "msg_main_event_1100_switch_02",
      "hash": "ccd6e0039bca94e4",
      "flags": 0,
      "text": "[~ 45]"
    },
    {
      "index": 46,
      "id": "msg_main_event_1100_switch_03",
      "hash": "ccd6e1039bca9697",
      "flags": 0,
      "text": "[~ 46]"
    },
    {
      "index": 47,
      "id": "msg_shop_bg_01",
      "hash": "3682ef731ccc848b",
      "flags": 0,
      "text": "上面陳列著\\n傷藥和除蟲噴霧！"
    },
    {
      "index": 48,
      "id": "msg_shop_bg_02",
      "hash": "3682f0731ccc863e",
      "flags": 0,
      "text": "架上陳列著許多商品！\\n去向店員購買吧！"
    },
    {
      "index": 49,
      "id": "msg_kanban_bg_01",
      "hash": "ff617b40a90b04f0",
      "flags": 0,
      "text": "從背面是看不見\\n告示牌上寫了什麼的！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_bg_event_max",
      "hash": "f825892cbb5f8bbe"
    }
  ]
}
