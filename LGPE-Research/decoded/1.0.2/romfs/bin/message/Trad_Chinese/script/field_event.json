{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_fld_hiden_01",
      "hash": "c3075734bbf2e150",
      "flags": 0,
      "text": "……這棵樹好像可以砍斷！\\n要使用秘術「袈裟斬」來砍斷它嗎？"
    },
    {
      "index": 1,
      "id": "msg_fld_hiden_02",
      "hash": "c3075a34bbf2e669",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]用「袈裟斬」一陣狂砍！"
    },
    {
      "index": 2,
      "id": "msg_fld_hiden_03",
      "hash": "c3075934bbf2e4b6",
      "flags": 0,
      "text": "這棵樹好像可以砍斷！"
    },
    {
      "index": 3,
      "id": "msg_fld_hiden_04",
      "hash": "c3075c34bbf2e9cf",
      "flags": 0,
      "text": "這裡沒有可以用\\n「袈裟斬」砍斷的東西！"
    },
    {
      "index": 4,
      "id": "msg_fld_hiden_05",
      "hash": "c3075b34bbf2e81c",
      "flags": 0,
      "text": "這個石塊看起來很重！\\n要使用秘術「推山掌」嗎？"
    },
    {
      "index": 5,
      "id": "msg_fld_hiden_06",
      "hash": "c3075e34bbf2ed35",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]使用了「推山掌」！\\n現在可以推動石塊了！"
    },
    {
      "index": 6,
      "id": "msg_fld_hiden_07",
      "hash": "c3075d34bbf2eb82",
      "flags": 0,
      "text": "這個石塊看起來很重……\\n不過用力推的話好像能推動。"
    },
    {
      "index": 7,
      "id": "msg_fld_hiden_08",
      "hash": "c3076034bbf2f09b",
      "flags": 0,
      "text": "使用「推山掌」之後，\\n可以推動石塊了！"
    },
    {
      "index": 8,
      "id": "msg_fld_hiden_19",
      "hash": "c303eb34bbeff3f5",
      "flags": 0,
      "text": "牆壁沒有了，\\n可以通過了！"
    },
    {
      "index": 9,
      "id": "msg_fld_hiden_20",
      "hash": "c3006c34bbece651",
      "flags": 0,
      "text": "喀嚓！"
    },
    {
      "index": 10,
      "id": "msg_fld_hiden_09",
      "hash": "c3075f34bbf2eee8",
      "flags": 0,
      "text": "水面靜靜地搖曳著……\\n要使用秘術「水上飄」嗎？"
    },
    {
      "index": 11,
      "id": "msg_fld_hiden_10",
      "hash": "c303f234bbefffda",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]使用了「水上飄」！"
    },
    {
      "index": 12,
      "id": "msg_fld_hiden_11",
      "hash": "c303f334bbf0018d",
      "flags": 0,
      "text": "在這裡無法使用「水上飄」……"
    },
    {
      "index": 13,
      "id": "msg_fld_hiden_12",
      "hash": "c303f034bbeffc74",
      "flags": 0,
      "text": "水面靜靜地搖曳著……"
    },
    {
      "index": 14,
      "id": "msg_fld_hiden_13",
      "hash": "c303f134bbeffe27",
      "flags": 0,
      "text": "周圍一片漆黑……\\n要使用秘術「炫光閃」嗎？"
    },
    {
      "index": 15,
      "id": "msg_fld_hiden_14",
      "hash": "c303ee34bbeff90e",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]使用了「炫光閃」！\\n周圍亮了起來，可以看清四周了！"
    },
    {
      "index": 16,
      "id": "msg_fld_hiden_17",
      "hash": "c303ed34bbeff75b",
      "flags": 0,
      "text": "周圍一片漆黑……\\n這樣恐怕很難繼續前進。"
    },
    {
      "index": 17,
      "id": "msg_fld_hiden_18",
      "hash": "c303ea34bbeff242",
      "flags": 0,
      "text": "現在使用是沒有效果的。"
    },
    {
      "index": 18,
      "id": "msg_fld_hiden_15",
      "hash": "c303ef34bbeffac1",
      "flags": 0,
      "text": "要使用秘術「凌空渡」\\n前往[VAR LOCATION(0000)]嗎？"
    },
    {
      "index": 19,
      "id": "msg_fld_hiden_16",
      "hash": "c303ec34bbeff5a8",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]用「凌空渡」飛了起來！"
    },
    {
      "index": 20,
      "id": "msg_fld_select_01",
      "hash": "4eb6529034653db6",
      "flags": 0,
      "text": "是"
    },
    {
      "index": 21,
      "id": "msg_fld_select_02",
      "hash": "4eb6519034653c03",
      "flags": 0,
      "text": "否"
    },
    {
      "index": 22,
      "id": "msg_fld_ev_spray_01",
      "hash": "5c28fa0044bd5c69",
      "flags": 0,
      "text": "噴霧的效果消失了！"
    },
    {
      "index": 23,
      "id": "msg_fld_ev_spray_02",
      "hash": "5c28f70044bd5750",
      "flags": 0,
      "text": "噴霧的效果消失了！\\n要繼續使用嗎？"
    },
    {
      "index": 24,
      "id": "msg_fld_ev_spray_03",
      "hash": "5c28f80044bd5903",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]\\n使用了[VAR ITEM2(0001)]！"
    },
    {
      "index": 25,
      "id": "msg_fld_ev_bookshelf_01",
      "hash": "d2e186b675233e1f",
      "flags": 0,
      "text": "整排都是寶可夢的書和寫真集！"
    },
    {
      "index": 26,
      "id": "msg_fld_ev_kowaserurock_01",
      "hash": "82155501d67638d0",
      "flags": 0,
      "text": "看起來很堅固的岩石……！\\n如果借用寶可夢的力量，或許能夠破壞它？"
    },
    {
      "index": 27,
      "id": "msg_fld_ev_tv_common_01",
      "hash": "5f755c2798a62f24",
      "flags": 0,
      "text": "大姐姐和寶可夢正在報導今天的新聞！"
    },
    {
      "index": 28,
      "id": "msg_fld_ev_oserurock_01",
      "hash": "2d2b876ebccb41e5",
      "flags": 0,
      "text": "看起來又大又重的岩石……！\\n如果借用寶可夢的力量，或許能夠推動它？"
    },
    {
      "index": 29,
      "id": "msg_egg_event_01",
      "hash": "cc883b93ea002f97",
      "flags": 0,
      "text": "……咦？"
    },
    {
      "index": 30,
      "id": "msg_ride_check_01",
      "hash": "6dc3493c009990b8",
      "flags": 0,
      "text": "要叫出肯泰羅嗎？"
    },
    {
      "index": 31,
      "id": "msg_ride_check_02",
      "hash": "6dc34c3c009995d1",
      "flags": 0,
      "text": "要叫出怪力嗎？"
    },
    {
      "index": 32,
      "id": "msg_ride_check_03",
      "hash": "6dc34b3c0099941e",
      "flags": 0,
      "text": "要叫出巨牙鯊嗎？"
    },
    {
      "index": 33,
      "id": "msg_ride_check_ng_01",
      "hash": "6d36fe6fcfb55062",
      "flags": 0,
      "text": "此處空間太過狹窄，\\n無法叫出坐騎寶可夢。"
    },
    {
      "index": 34,
      "id": "msg_fld_ev_colon_01",
      "hash": "205807eddd52f34f",
      "flags": 0,
      "text": "香水的效果消失了！"
    },
    {
      "index": 35,
      "id": "msg_fld_ev_colon_02",
      "hash": "205808eddd52f502",
      "flags": 0,
      "text": "香水的效果消失了！\\n要繼續使用嗎？"
    },
    {
      "index": 36,
      "id": "msg_fld_ev_boxfull_01",
      "hash": "9442742ebe9d881a",
      "flags": 0,
      "text": "由於寶可夢盒已滿，\\n因此無法和這個人對話！！\\r\\n……下次再來吧。"
    },
    {
      "index": 37,
      "id": "msg_fld_ev_no_push_01",
      "hash": "55f78515b56260be",
      "flags": 0,
      "text": "無法再往裡面推了！"
    },
    {
      "index": 38,
      "id": "msg_fld_ev_no_push_02",
      "hash": "55f78415b5625f0b",
      "flags": 0,
      "text": "無法從這個方向推動！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_field_event_max",
      "hash": "1d3b5de75cfe638b"
    }
  ]
