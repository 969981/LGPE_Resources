    {
      "index": 9,
      "id": "msg_sub017_system_04",
      "hash": "6b07f4203d3855fc",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]把[VAR ITEM2(0002)]給了\\n[VAR PKNICK(0003)]！"
