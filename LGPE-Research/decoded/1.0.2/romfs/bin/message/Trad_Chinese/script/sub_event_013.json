{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub013_sister_01",
      "hash": "26f68ca277e78a2c",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]！\\c\\n想知道你的寶可夢\\n喜不喜歡你嗎？"
    },
    {
      "index": 1,
      "id": "msg_sub013_sister_02",
      "hash": "26f68fa277e78f45",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]！\\c\\n想知道妳的寶可夢\\n喜不喜歡妳嗎？"
    },
    {
      "index": 2,
      "id": "msg_sub013_sister_03",
      "hash": "26f68ea277e78d92",
      "flags": 0,
      "text": "只要用心培育寶可夢，\\n牠們就會變得非常喜歡\\r\\n自己的訓練家喔！"
    },
    {
      "index": 3,
      "id": "msg_sub013_sister_04",
      "hash": "26f689a277e78513",
      "flags": 0,
      "text": "那就讓我來看看\\n[VAR PKNICK(0001)]的情況吧！"
    },
    {
      "index": 4,
      "id": "msg_sub013_sister_05",
      "hash": "26f688a277e78360",
      "flags": 0,
      "text": "[VAR PKNICK(0001)]真的\\n非常非常地喜歡[VAR GENDBR(00FF,0101)]你妳呢！\\c\\n看來你們互相信賴著對方！"
    },
    {
      "index": 5,
      "id": "msg_sub013_sister_06",
      "hash": "26f68ba277e78879",
      "flags": 0,
      "text": "[VAR PKNICK(0001)]牠\\n十分喜歡[VAR GENDBR(00FF,0101)]你妳呢！\\c\\n牠說想一直跟[VAR GENDBR(00FF,0101)]你妳在一起！"
    },
    {
      "index": 6,
      "id": "msg_sub013_sister_07",
      "hash": "26f68aa277e786c6",
      "flags": 0,
      "text": "[VAR PKNICK(0001)]似乎\\n挺喜歡[VAR GENDBR(00FF,0101)]你妳的呢！"
    },
    {
      "index": 7,
      "id": "msg_sub013_sister_08",
      "hash": "26f695a277e79977",
      "flags": 0,
      "text": "你們的感情不錯！\\n以後也要保持下去喔！"
    },
    {
      "index": 8,
      "id": "msg_sub013_sister_09",
      "hash": "26f694a277e797c4",
      "flags": 0,
      "text": "牠開始有點親近[VAR GENDBR(00FF,0101)]你妳了呢！\\n這樣發展下去應該不錯喔！？"
    },
    {
      "index": 9,
      "id": "msg_sub013_sister_10",
      "hash": "26f307a277e47256",
      "flags": 0,
      "text": "你們才剛認識嗎？\\n真期待你們今後的發展！"
    },
    {
      "index": 10,
      "id": "msg_sub013_sister_11",
      "hash": "26f308a277e47409",
      "flags": 0,
      "text": "[VAR GENDBR(00FF,0101)]你妳該不會常常讓牠\\n在寶可夢對戰裡被打倒吧？"
    },
    {
      "index": 11,
      "id": "msg_sub013_sister_12",
      "hash": "26f305a277e46ef0",
      "flags": 0,
      "text": "太可怕了！為什麼要對牠置之不理？\\n[VAR GENDBR(00FF,0101)]你妳應該馬上帶牠到寶可夢中心才對吧！"
    },
    {
      "index": 12,
      "id": "msg_woman1_01_p11_t001_r0201",
      "hash": "d543d023df5a8e8d",
      "flags": 0,
