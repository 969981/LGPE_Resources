  "lines": [
    {
      "index": 0,
      "id": "msg_road017_kanban_01",
      "hash": "a226f27247818ecb",
      "flags": 0,
      "text": "這裡貼著一張告示！\\c\\n……小心別人丟棄的道具！"
    },
    {
      "index": 1,
      "id": "msg_road017_kanban_02",
      "hash": "a226f3724781907e",
      "flags": 0,
      "text": "……有用的告示板！\\c\\n即使是種類和等級相同的寶可夢，\\n在每次捕捉時\\r\\n牠們的能力都會有些微差異……\\r\\n待寶可夢成長後，\\r\\n這些差異便會變得明顯！"
    },
    {
      "index": 2,
      "id": "msg_road017_kanban_03",
      "hash": "a226f47247819231",
      "flags": 0,
      "text": "[~ 2]"
    },
    {
      "index": 3,
      "id": "msg_road017_kanban_07",
      "hash": "a226f872478198fd",
      "flags": 0,
      "text": "……有用的告示板！\\c\\n在捕捉寶可夢的時候，\\n瞄準有顏色的圓圈，\\r\\n把球投進去吧！\\c\\n圓圈越小就越容易出現\\n「漂亮一投」或「精彩一投」，\\r\\n寶可夢也越容易捕捉。"
    },
    {
      "index": 4,
      "id": "msg_road017_kanban_04",
      "hash": "a226f572478193e4",
      "flags": 0,
      "text": "這裡是17號道路\\n玉虹市　……　淺紅市"
    },
    {
      "index": 5,
      "id": "msg_road017_kanban_05",
      "hash": "a226f67247819597",
      "flags": 0,
      "text": "這裡貼著一張告示！\\c\\n不要丟遊戲！\\n要丟就丟精靈球！"
    },
    {
      "index": 6,
      "id": "msg_road017_kanban_06",
      "hash": "a226f7724781974a",
      "flags": 0,
      "text": "人類和寶可夢\\n一同行走的道路"
    },
    {
      "index": 7,
      "id": "msg_road017_poke_01",
      "hash": "1b23d3da193d6069",
      "flags": 0,
      "text": "卡咪龜「咪吶～"
    },
    {
      "index": 8,
      "id": "msg_road017_poke_02",
      "hash": "1b23d0da193d5b50",
      "flags": 0,
      "text": "椰蛋樹「椰椰～！"
    },
    {
      "index": 9,
      "id": "msg_road017_poke_03",
      "hash": "1b23d1da193d5d03",
      "flags": 0,
      "text": "貓老大「咕嚕咕嚕～"
    },
    {
      "index": 10,
      "id": "msg_road017_poke_04",
      "hash": "1b23d6da193d6582",
      "flags": 0,
      "text": "水伊布「融～融～"
    },
    {
      "index": 11,
      "id": "msg_road017_poke_05",
      "hash": "1b23d7da193d6735",
      "flags": 0,
      "text": "口呆花「口呆！"
    },
    {
      "index": 12,
      "id": "msg_road017_poke_06",
