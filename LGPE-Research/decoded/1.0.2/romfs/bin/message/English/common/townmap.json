    },
    {
      "index": 12,
      "id": "TM_GUIDE_01",
      "hash": "de793f7747865099",
      "flags": 4,
      "text": "A calm country road full of greenery."
    },
    {
      "index": 13,
      "id": "TM_GUIDE_02",
      "hash": "de793c7747864b80",
      "flags": 4,
      "text": "A path that winds and bends around\\nViridian Forest."
    },
    {
      "index": 14,
      "id": "TM_GUIDE_03",
      "hash": "de793d7747864d33",
      "flags": 4,
      "text": "A grassy road near the mountainside with large\\nfallen rocks all about."
    },
    {
      "index": 15,
      "id": "TM_GUIDE_04",
      "hash": "de794277478655b2",
      "flags": 4,
      "text": "A one-way road down a hill from Mt. Moon that\\nleads to Cerulean City."
    },
    {
      "index": 16,
      "id": "TM_GUIDE_05",
      "hash": "de79437747865765",
      "flags": 4,
      "text": "A placid sloping road connecting to\\nthe Underground Path."
    },
    {
      "index": 17,
      "id": "TM_GUIDE_06",
      "hash": "de7940774786524c",
      "flags": 4,
      "text": "A road linking Saffron City and Vermilion City.\\nThere’s an entrance to the Underground Path."
    },
    {
      "index": 18,
      "id": "TM_GUIDE_07",
      "hash": "de794177478653ff",
      "flags": 4,
      "text": "A short path connecting Route 8 with\\nthe Underground Path."
    },
    {
      "index": 19,
      "id": "TM_GUIDE_08",
      "hash": "de79467747865c7e",
      "flags": 4,
      "text": "A short path connecting Route 7 with\\nthe Underground Path."
    },
    {
      "index": 20,
      "id": "TM_GUIDE_09",
      "hash": "de79477747865e31",
      "flags": 4,
      "text": "An uneven road where children often play."
    },
    {
      "index": 21,
      "id": "TM_GUIDE_10",
      "hash": "de7cc4774789686f",
      "flags": 0,
      "text": "The route runs along a canal and leads to\\nthe cavernous Rock Tunnel."
    },
    {
      "index": 22,
      "id": "TM_GUIDE_11",
      "hash": "de7cc377478966bc",
      "flags": 4,
      "text": "A meadow filled with Trainers. Diglett’s Cave is\\nfound here."
    },
    {
      "index": 23,
      "id": "TM_GUIDE_12",
      "hash": "de7cc67747896bd5",
      "flags": 4,
      "text": "A bridge where fishermen gather. It’s also called\\nSilence Bridge."
    },
    {
      "index": 24,
      "id": "TM_GUIDE_13",
      "hash": "de7cc57747896a22",
      "flags": 0,
      "text": "The mazelike path with a refreshing\\ncoastal view."
    },
    {
      "index": 25,
      "id": "TM_GUIDE_14",
      "hash": "de7cc077478961a3",
      "flags": 4,
      "text": "A pleasant coastal road where the salty breeze\\nblows past the trees."
    },
    {
      "index": 26,
      "id": "TM_GUIDE_15",
      "hash": "de7cbf7747895ff0",
      "flags": 4,
      "text": "A long, grassy path stretching east of\\nFuchsia City."
    },
    {
      "index": 27,
      "id": "TM_GUIDE_16",
      "hash": "de7cc27747896509",
      "flags": 0,
      "text": "Links to the north side of Pokémon Road.\\nA route that is always bustling."
    },
    {
      "index": 28,
      "id": "TM_GUIDE_17",
      "hash": "de7cc17747896356",
      "flags": 4,
      "text": "Also known as Pokémon Road. A place where\\nTrainers and Pokémon can walk together."
    },
    {
      "index": 29,
      "id": "TM_GUIDE_18",
      "hash": "de7ccc7747897607",
      "flags": 0,
      "text": "Links to the south side of Pokémon Road. A\\nplace where Trainers gather, looking to battle."
    },
    {
      "index": 30,
      "id": "TM_GUIDE_19",
      "hash": "de7ccb7747897454",
      "flags": 4,
      "text": "A popular spot for swimming and sunbathing."
    },
    {
      "index": 31,
      "id": "TM_GUIDE_20",
      "hash": "de72d27747812bb4",
      "flags": 4,
      "text": "An ocean route separated down the middle by\\nthe Seafoam Islands."
    },
    {
      "index": 32,
      "id": "TM_GUIDE_21",
      "hash": "de72d37747812d67",
      "flags": 4,
      "text": "A sea path warmed by the volcano on\\nthe horizon."
    },
    {
      "index": 33,
      "id": "TM_GUIDE_22",
      "hash": "de72d47747812f1a",
      "flags": 4,
      "text": "A paved road that leads straight to\\nthe Pokémon League."
    },
    {
      "index": 34,
      "id": "TM_GUIDE_23",
      "hash": "de72d577478130cd",
      "flags": 4,
      "text": "A mountain path where only the strongest\\nTrainers may pass."
    },
    {
      "index": 35,
      "id": "TM_GUIDE_24",
      "hash": "de72ce77478124e8",
      "flags": 0,
      "text": "Crosses the waterway via the famous\\nNugget Bridge, just north of Cerulean City."
    },
    {
      "index": 36,
      "id": "TM_GUIDE_25",
      "hash": "de72cf774781269b",
      "flags": 4,
      "text": "A maze of shrubs that leads to\\na place overlooking the cape."
    },
    {
      "index": 37,
      "id": "TM_GUIDE_26",
      "hash": "de72d0774781284e",
      "flags": 4,
      "text": "A small country town, home to Professor\\nOak’s lab."
    },
    {
      "index": 38,
      "id": "TM_GUIDE_27",
      "hash": "de72d17747812a01",
      "flags": 0,
      "text": "The nature-loving city where flowers bloom all\\nyear round."
    },
    {
      "index": 39,
      "id": "TM_GUIDE_28",
      "hash": "de72ca7747811e1c",
      "flags": 0,
      "text": "The stone city that rests at the foot of a great\\nrocky mountain."
    },
    {
      "index": 40,
      "id": "TM_GUIDE_29",
      "hash": "de72cb7747811fcf",
      "flags": 0,
      "text": "The town surrounded by waterways.\\nThe Water-type Gym is located here."
    },
    {
      "index": 41,
      "id": "TM_GUIDE_30",
      "hash": "de75d87747836bbd",
      "flags": 4,
      "text": "A solemn, quiet town. People come to visit their\\ndeparted Pokémon."
    },
    {
      "index": 42,
      "id": "TM_GUIDE_31",
      "hash": "de75d77747836a0a",
      "flags": 0,
      "text": "The international port town where magnificent\\nboats gather from across the world."
    },
    {
      "index": 43,
      "id": "TM_GUIDE_32",
      "hash": "de75d67747836857",
      "flags": 0,
      "text": "The city where people of many generations live\\ntogether. The department store is located here."
    },
    {
      "index": 44,
      "id": "TM_GUIDE_33",
      "hash": "de75d577478366a4",
      "flags": 4,
      "text": "A town where many people and Pokémon\\ngather. The Safari Zone is located here."
    },
    {
      "index": 45,
      "id": "TM_GUIDE_34",
      "hash": "de75d477478364f1",
      "flags": 0,
      "text": "The town at the foot of a volcano.\\nThe Pokémon Mansion is located here."
    },
    {
      "index": 46,
      "id": "TM_GUIDE_35",
      "hash": "de75d3774783633e",
      "flags": 4,
      "text": "A plateau where the Pokémon League stands\\ntowering above all else."
    },
    {
      "index": 47,
      "id": "TM_GUIDE_36",
      "hash": "de75d2774783618b",
      "flags": 0,
      "text": "Tall buildings tower overhead. It’s the most\\npopulous city in all of the Kanto region."
    },
    {
      "index": 48,
      "id": "TM_GUIDE_37",
      "hash": "de75d17747835fd8",
      "flags": 4,
      "text": "A deep, shady forest filled with nature and\\nBug-type Pokémon."
    },
    {
      "index": 49,
      "id": "TM_GUIDE_38",
      "hash": "de75d07747835e25",
      "flags": 4,
      "text": "A mountain where shooting stars are said\\nto fall. It is apparently abundant with fossils."
    },
    {
      "index": 50,
      "id": "TM_GUIDE_39",
      "hash": "de75cf7747835c72",
      "flags": 4,
      "text": "A large natural tunnel. It’s pitch black, so a\\nlight source is required."
    },
    {
      "index": 51,
      "id": "TM_GUIDE_40",
      "hash": "de6bc677477af8a2",
      "flags": 4,
      "text": "A technological complex where Electric-type\\nPokémon are commonly found."
    },
    {
      "index": 52,
      "id": "TM_GUIDE_41",
      "hash": "de6bc777477afa55",
      "flags": 4,
      "text": "A tunnel dug by Diglett connecting\\nVermilion City to Pewter City."
    },
    {
      "index": 53,
      "id": "TM_GUIDE_42",
      "hash": "de6bc477477af53c",
      "flags": 0,
      "text": "Two small islands lightly floating in the ocean.\\nA shocking cold fills the caverns inside."
    },
    {
      "index": 54,
      "id": "TM_GUIDE_43",
      "hash": "de6bc577477af6ef",
      "flags": 4,
      "text": "A cave that tests Trainers aiming to reach\\nthe Pokémon League at the summit."
    },
    {
