  "lines": [
    {
      "index": 0,
      "id": "poke_get_01_00",
      "hash": "3a06eefb470cba20",
      "flags": 0,
      "text": "[VAR POKNAME(0000)] has appeared in a GO Park!"
    },
    {
      "index": 1,
      "id": "poke_get_01_01",
      "hash": "3a06effb470cbbd3",
      "flags": 4,
      "text": "Oh!\\nYou encountered a wild [VAR POKNAME(0000)]!"
    },
    {
      "index": 2,
      "id": "poke_get_01_02",
      "hash": "3a06f0fb470cbd86",
      "flags": 0,
      "text": "Now’s your chance!\\nCatch the wild [VAR POKNAME(0000)]!"
    },
    {
      "index": 3,
      "id": "poke_get_01_03",
      "hash": "3a06f1fb470cbf39",
      "flags": 0,
      "text": "Now’s your chance!\\nCatch [VAR POKNAME(0000)]!"
    },
    {
      "index": 4,
      "id": "poke_get_01_04",
      "hash": "3a06f2fb470cc0ec",
      "flags": 0,
      "text": "Do you want to give up catching this Pokémon?"
    },
    {
      "index": 5,
      "id": "poke_get_01_05",
      "hash": "3a06f3fb470cc29f",
      "flags": 0,
      "text": "Do you want to exit the tutorial?"
    },
    {
      "index": 6,
      "id": "poke_get_01_06",
      "hash": "3a06f4fb470cc452",
      "flags": 0,
      "text": "You can’t carry any more Pokémon!\\nYou’ll have to withdraw for now..."
    },
    {
      "index": 7,
      "id": "poke_get_01_07",
      "hash": "3a06f5fb470cc605",
      "flags": 0,
      "text": "You don’t have a single Poké Ball left!\\nYou’ll have to withdraw for now..."
    },
    {
      "index": 8,
      "id": "poke_get_01_08",
      "hash": "3a06f6fb470cc7b8",
      "flags": 4,
      "text": "Ah, no!\\nThe Pokémon broke free from the Poké Ball!"
    },
    {
      "index": 9,
      "id": "poke_get_01_09",
      "hash": "3a06f7fb470cc96b",
      "flags": 4,
      "text": "Ahhh!\\nJust when it seemed like you had it!"
    },
    {
      "index": 10,
      "id": "poke_get_01_10",
      "hash": "3a0a74fb470fd3a9",
      "flags": 0,
      "text": "What a shame!\\nYou were so close to catching it, too!"
    },
    {
      "index": 11,
      "id": "poke_get_01_11",
      "hash": "3a0a73fb470fd1f6",
      "flags": 0,
      "text": "So close!\\nYou almost got it!"
    },
    {
      "index": 12,
      "id": "poke_get_01_12",
      "hash": "3a0a72fb470fd043",
      "flags": 4,
      "text": "All right!\\nYou caught [VAR INDEF_ART(0000)][VAR POKNAME(0000)]!"
    },
    {
      "index": 13,
      "id": "poke_get_01_13",
      "hash": "3a0a71fb470fce90",
      "flags": 0,
      "text": "[VAR POKNAME(0000)] ran away!"
    },
    {
      "index": 14,
      "id": "poke_get_01_14",
      "hash": "3a0a78fb470fda75",
      "flags": 0,
      "text": "You got away safely!"
    },
    {
      "index": 15,
      "id": "poke_get_01_15",
      "hash": "3a0a77fb470fd8c2",
      "flags": 4,
      "text": "A [VAR SUPPORT(0000)] came running\\nfrom somewhere to lend a hand!"
    },
    {
      "index": 16,
      "id": "poke_get_02_01",
      "hash": "660df801a876ce1c",
      "flags": 0,
      "text": "Yes"
    },
    {
      "index": 17,
      "id": "poke_get_02_02",
      "hash": "660dfb01a876d335",
      "flags": 0,
      "text": "No"
    },
    {
