    {
      "index": 179,
      "id": "kisekae_item_shop_02",
      "hash": "0762001f93abbc0e",
      "flags": 0,
      "text": "...Oh! It seems you’ve already bought everything\\nwe have, [VAR GENDBR(00FF,0503)]sirma’am!"
