    {
      "index": 180,
      "id": "kisekae_item_shop_03",
      "hash": "0762011f93abbdc1",
      "flags": 0,
      "text": "The [VAR STYLEITEM(0001)] will\\nbe ₽[VAR NUM6(0002,002C)]!"
