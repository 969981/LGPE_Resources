      "hash": "ca1cc2bee54179c3",
      "flags": 0,
      "text": "What?\\n[VAR PKNICK(0000)] is evolving!"
    },
    {
      "index": 1,
      "id": "msg_shinka_02_01",
      "hash": "a1514aca301af20c",
      "flags": 0,
      "text": "Huh?\\n[VAR PKNICK(0000)] stopped evolving!"
    },
    {
      "index": 2,
      "id": "msg_shinka_03_01",
      "hash": "f7b716d1cb84b5e1",
      "flags": 0,
      "text": "Congratulations! Your [VAR PKNICK(0000)] evolved\\ninto [VAR POKNAME(0001)]!"
    },
    {
      "index": 3,
      "id": "msg_shinka_04_01",
      "hash": "98e44e952c6493d2",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] learned [VAR MOVE(0001)]![VAR SFX(0004)][VAR SFX(0001)]"
    },
    {
      "index": 4,
      "id": "msg_shinka_05_01",
      "hash": "6fac5aa076e21a87",
      "flags": 4,
      "text": "One...[WAIT 20]two...[WAIT 20]and...[WAIT 20]ta-da![VAR SFX(0003)][VAR SFX(0000)]\\c\\n[VAR PKNICK(0000)] forgot [VAR MOVE(0001)]!\\c\\nAnd it learned [VAR MOVE(0002)] instead![VAR SFX(0004)][VAR SFX(0001)]"
    },
    {
      "index": 5,
      "id": "msg_shinka_06_01",
      "hash": "c61202a8124ba130",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] did not learn\\n[VAR MOVE(0001)]."
    },
    {
      "index": 6,
      "id": "msg_shinka_07_01",
      "hash": "f35f0eae74ca7ce5",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] wants to learn\\nthe move [VAR MOVE(0001)].\\c\\nShould an old move be forgotten and\\nreplaced with [VAR MOVE(0001)]?"
    },
    {
      "index": 7,
      "id": "msg_shinka_10_01",
      "hash": "3c11b2c38f68a511",
      "flags": 0,
      "text": "Forget an old move"
    },
    {
      "index": 8,
      "id": "msg_shinka_10_02",
      "hash": "3c11afc38f689ff8",
      "flags": 0,
      "text": "Keep old moves"
    }
