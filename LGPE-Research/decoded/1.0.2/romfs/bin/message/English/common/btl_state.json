{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "BTR_STATE_00_01",
      "hash": "4fb031d3b2084edc",
      "flags": 0,
      "text": "[~ 0]"
    },
    {
      "index": 1,
      "id": "BTR_STATE_00_02",
      "hash": "4fb034d3b20853f5",
      "flags": 0,
      "text": "[~ 1]"
    },
    {
      "index": 2,
      "id": "BTR_STATE_01_01",
      "hash": "7bb6bdda13718e71",
      "flags": 0,
      "text": "Harsh Sunlight"
    },
    {
      "index": 3,
      "id": "BTR_STATE_01_02",
      "hash": "7bb6bada13718958",
      "flags": 0,
      "text": "The harsh sunlight weather condition.\\nIt boosts the power of Fire-type moves and\\nlowers the power of Water-type moves."
    },
    {
      "index": 4,
      "id": "BTR_STATE_02_01",
      "hash": "773f7dc3401fbd7e",
      "flags": 0,
      "text": "Rain"
    },
    {
      "index": 5,
      "id": "BTR_STATE_02_02",
      "hash": "773f7cc3401fbbcb",
      "flags": 0,
      "text": "The rain weather condition.\\nIt boosts the power of Water-type moves and\\nlowers the power of Fire-type moves."
    },
    {
      "index": 6,
      "id": "BTR_STATE_03_01",
      "hash": "7a2e29c8689f9193",
      "flags": 0,
      "text": "Sandstorm"
    },
    {
      "index": 7,
      "id": "BTR_STATE_03_02",
      "hash": "7a2e2ac8689f9346",
      "flags": 0,
      "text": "The sandstorm weather condition.\\nAt the end of each turn, it damages all Pokémon\\nthat are not Rock, Ground, or Steel type.\\nIt boosts the Sp. Def of Rock-type Pokémon."
    },
    {
      "index": 8,
      "id": "BTR_STATE_04_01",
      "hash": "4a11a9b05a3879c0",
      "flags": 0,
      "text": "Hail"
    },
    {
      "index": 9,
      "id": "BTR_STATE_04_02",
      "hash": "4a11acb05a387ed9",
      "flags": 0,
      "text": "The hail weather condition.\\nAt the end of each turn, it damages all Pokémon\\nthat are not Ice type."
    },
    {
      "index": 10,
      "id": "BTR_STATE_05_01",
      "hash": "a1bdf5b7f6b7d9b5",
      "flags": 4,
      "text": "Electric Terrain"
    },
    {
      "index": 11,
      "id": "BTR_STATE_05_02",
      "hash": "a1bdf2b7f6b7d49c",
      "flags": 0,
      "text": "For five turns, Pokémon on the ground won’t\\nfall asleep.\\nThe power of Electric-type moves is boosted."
    },
    {
      "index": 12,
      "id": "BTR_STATE_06_01",
      "hash": "7354759fe9c25662",
      "flags": 0,
      "text": "Grassy Terrain"
    },
    {
      "index": 13,
      "id": "BTR_STATE_06_02",
      "hash": "7354749fe9c254af",
      "flags": 0,
      "text": "For five turns, Pokémon on the ground will have\\na little HP restored at the end of each turn.\\nThe power of Grass-type moves is boosted."
    },
    {
      "index": 14,
      "id": "BTR_STATE_07_01",
      "hash": "1e0ac1a9f8ce9dd7",
      "flags": 0,
      "text": "Misty Terrain"
    },
    {
      "index": 15,
      "id": "BTR_STATE_07_02",
      "hash": "1e0ac2a9f8ce9f8a",
      "flags": 0,
      "text": "For five turns, Pokémon on the ground won’t get\\nany status conditions.\\nDamage from Dragon-type moves is halved."
    },
    {
      "index": 16,
      "id": "BTR_STATE_08_01",
      "hash": "da8a0216b2928334",
      "flags": 0,
      "text": "Trick Room"
    },
    {
      "index": 17,
      "id": "BTR_STATE_08_02",
      "hash": "da8a0516b292884d",
      "flags": 0,
      "text": "Slower Pokémon get to move first for five turns."
    },
    {
      "index": 18,
      "id": "BTR_STATE_09_01",
      "hash": "dbc52e1bd99fe949",
      "flags": 0,
      "text": "Magic Room"
    },
    {
      "index": 19,
      "id": "BTR_STATE_09_02",
      "hash": "dbc52b1bd99fe430",
      "flags": 0,
      "text": "Pokémon can’t use their held items for five turns."
    },
    {
      "index": 20,
      "id": "BTR_STATE_10_01",
      "hash": "c03652089e1b28bf",
      "flags": 0,
      "text": "Wonder Room"
    },
    {
      "index": 21,
      "id": "BTR_STATE_10_02",
      "hash": "c03653089e1b2a72",
      "flags": 0,
      "text": "Pokémon’s Defense and Sp. Def are swapped for\\nfive turns."
    },
    {
      "index": 22,
      "id": "BTR_STATE_11_01",
      "hash": "136025fe8d40b14a",
      "flags": 0,
      "text": "Critical Hit Boost"
    },
    {
      "index": 23,
      "id": "BTR_STATE_11_02",
      "hash": "136024fe8d40af97",
      "flags": 0,
      "text": "The Pokémon is more likely to land critical hits."
    },
    {
      "index": 24,
      "id": "BTR_STATE_12_01",
      "hash": "c152661a48912d3d",
      "flags": 0,
      "text": "Confusion"
    },
    {
      "index": 25,
      "id": "BTR_STATE_12_02",
      "hash": "c152631a48912824",
      "flags": 0,
      "text": "The Pokémon may hurt itself in its confusion.\\nThe effect lasts for one to four turns."
    },
    {
      "index": 26,
      "id": "BTR_STATE_13_01",
      "hash": "ebd0da0eff2942a8",
      "flags": 4,
      "text": "Infatuation"
    },
    {
      "index": 27,
      "id": "BTR_STATE_13_02",
      "hash": "ebd0dd0eff2947c1",
      "flags": 0,
      "text": "The Pokémon is less likely to unleash an attack\\non Pokémon of the opposite gender."
    },
    {
      "index": 28,
      "id": "BTR_STATE_14_01",
      "hash": "45059a28467a691b",
      "flags": 0,
      "text": "Nightmare"
    },
    {
      "index": 29,
      "id": "BTR_STATE_14_02",
      "hash": "45059b28467a6ace",
      "flags": 0,
      "text": "The Pokémon will lose HP each turn as long as\\nit is sleeping."
    },
    {
      "index": 30,
      "id": "BTR_STATE_15_01",
      "hash": "18fe8e21e5105006",
      "flags": 0,
      "text": "Drowsy"
    },
    {
      "index": 31,
      "id": "BTR_STATE_15_02",
      "hash": "18fe8d21e5104e53",
      "flags": 0,
      "text": "The Pokémon will fall asleep at the end of the\\nturn if it remains on the battlefield."
    },
    {
      "index": 32,
      "id": "BTR_STATE_16_01",
      "hash": "1d75ce38b86220f9",
      "flags": 4,
      "text": "Encore"
    },
    {
      "index": 33,
      "id": "BTR_STATE_16_02",
      "hash": "1d75cb38b8621be0",
      "flags": 0,
      "text": "Due to Encore, the Pokémon can use only\\n[VAR MOVE(0000)] for three turns."
    },
    {
      "index": 34,
      "id": "BTR_STATE_17_01",
      "hash": "f028623255e2a224",
      "flags": 0,
      "text": "No Ability"
    },
    {
      "index": 35,
      "id": "BTR_STATE_17_02",
      "hash": "f028653255e2a73d",
      "flags": 0,
      "text": "The Pokémon’s Ability loses its effect."
    },
    {
      "index": 36,
      "id": "BTR_STATE_18_01",
      "hash": "5fbb61c6d790d587",
      "flags": 0,
      "text": "Torment"
    },
    {
      "index": 37,
      "id": "BTR_STATE_18_02",
      "hash": "5fbb62c6d790d73a",
      "flags": 0,
      "text": "The Pokémon can’t use the same move twice\\nin a row."
    },
    {
      "index": 38,
      "id": "BTR_STATE_19_01",
      "hash": "88f355bb8d134ed2",
      "flags": 0,
      "text": "Tailwind"
    },
    {
      "index": 39,
      "id": "BTR_STATE_19_02",
      "hash": "88f354bb8d134d1f",
      "flags": 0,
      "text": "The Speed stat of a Pokémon and its allies is\\ndoubled for four turns."
    },
    {
      "index": 40,
      "id": "BTR_STATE_20_01",
      "hash": "6f0ff569da3dc0c2",
      "flags": 0,
      "text": "Lucky Chant"
    },
    {
      "index": 41,
      "id": "BTR_STATE_20_02",
      "hash": "6f0ff469da3dbf0f",
      "flags": 0,
      "text": "The opponent’s moves won’t result in a\\ncritical hit."
    },
    {
      "index": 42,
      "id": "BTR_STATE_21_01",
      "hash": "c6bbc17176bc4737",
      "flags": 0,
      "text": "Grudge"
    },
    {
      "index": 43,
      "id": "BTR_STATE_21_02",
      "hash": "c6bbc27176bc48ea",
      "flags": 4,
      "text": "If the Pokémon faints by an opponent’s move,\\nthe PP of that move will be reduced to 0."
    },
    {
      "index": 44,
      "id": "BTR_STATE_22_01",
      "hash": "f2c2a977d8262320",
      "flags": 0,
      "text": "Heal Block"
    },
    {
      "index": 45,
      "id": "BTR_STATE_22_02",
      "hash": "f2c2ac77d8262839",
      "flags": 0,
      "text": "For five turns, the Pokémon is unable to recover\\nHP through its moves, Ability, or held item."
    },
    {
      "index": 46,
      "id": "BTR_STATE_23_01",
      "hash": "9d78f581e7326a95",
      "flags": 4,
      "text": "Identified"
    },
    {
      "index": 47,
      "id": "BTR_STATE_23_02",
      "hash": "9d78f281e732657c",
      "flags": 0,
      "text": "The Pokémon will be hit by certain moves\\nthat usually wouldn’t affect it.\\nIf the Pokémon’s evasion has been boosted,\\nthe benefits will be ignored when it is attacked."
    },
    {
      "index": 48,
      "id": "BTR_STATE_24_01",
      "hash": "cb32fd884a0e115e",
      "flags": 0,
      "text": "Disable"
    },
    {
      "index": 49,
      "id": "BTR_STATE_24_02",
      "hash": "cb32fc884a0e0fab",
      "flags": 0,
      "text": "For four turns, the Pokémon will be unable to\\nuse [VAR MOVE(0000)]."
    },
    {
      "index": 50,
      "id": "BTR_STATE_25_01",
      "hash": "212ba98fe51accf3",
      "flags": 0,
      "text": "Can’t Escape"
    },
    {
      "index": 51,
      "id": "BTR_STATE_25_02",
      "hash": "212baa8fe51acea6",
      "flags": 0,
      "text": "The Pokémon can’t flee or be switched out."
    },
    {
      "index": 52,
      "id": "BTR_STATE_26_01",
      "hash": "f6adb19b2e838a3c",
      "flags": 0,
      "text": "Lock-On"
    },
    {
      "index": 53,
      "id": "BTR_STATE_26_02",
      "hash": "f6adb49b2e838f55",
      "flags": 0,
      "text": "The next move used by the Pokémon will be sure\\nto hit the target."
    },
    {
      "index": 54,
      "id": "BTR_STATE_27_01",
      "hash": "2467bda1915f37d1",
      "flags": 4,
      "text": "Embargo"
    },
    {
      "index": 55,
      "id": "BTR_STATE_27_02",
      "hash": "2467baa1915f32b8",
      "flags": 0,
      "text": "For five turns, the Pokémon cannot use its held\\nitem and no items can be used on it."
    },
    {
      "index": 56,
      "id": "BTR_STATE_28_01",
      "hash": "cf1e05aba06b787a",
      "flags": 0,
      "text": "Charge"
    },
    {
      "index": 57,
      "id": "BTR_STATE_28_02",
      "hash": "cf1e04aba06b76c7",
      "flags": 0,
      "text": "The power of an Electric-type move will be\\ndoubled if used in the turn after charging."
    },
    {
      "index": 58,
      "id": "BTR_STATE_29_01",
      "hash": "fb24f1b201d55b2f",
      "flags": 0,
      "text": "Gravity"
    },
    {
      "index": 59,
      "id": "BTR_STATE_29_02",
      "hash": "fb24f2b201d55ce2",
      "flags": 0,
      "text": "Moves are more likely to hit for five turns.\\nGround-type moves will hit Flying-type\\nPokémon and Pokémon with the Levitate Ability.\\nMoves that require action midair can’t be used."
    },
    {
      "index": 60,
      "id": "BTR_STATE_30_01",
      "hash": "df29959ec5f4a245",
      "flags": 0,
      "text": "Mist"
    },
    {
      "index": 61,
      "id": "BTR_STATE_30_02",
      "hash": "df29929ec5f49d2c",
      "flags": 0,
      "text": "The Pokémon’s stats won’t be lowered for\\nfive turns."
    },
    {
      "index": 62,
      "id": "BTR_STATE_31_01",
      "hash": "0a1489937ce8b010",
      "flags": 0,
      "text": "Safeguard"
    },
    {
      "index": 63,
      "id": "BTR_STATE_31_02",
      "hash": "0a148c937ce8b529",
      "flags": 0,
      "text": "The Pokémon is protected from status conditions\\nfor five turns."
    },
    {
      "index": 64,
      "id": "BTR_STATE_32_01",
      "hash": "06b9618e540cea67",
      "flags": 0,
      "text": "Stealth Rock"
    },
    {
      "index": 65,
      "id": "BTR_STATE_32_02",
      "hash": "06b9628e540cec1a",
      "flags": 0,
      "text": "Pokémon that switch into battle will\\ntake damage."
    },
    {
      "index": 66,
      "id": "BTR_STATE_33_01",
      "hash": "31a3d5830b001eb2",
      "flags": 0,
      "text": "Stockpile"
    },
    {
      "index": 67,
      "id": "BTR_STATE_33_02",
      "hash": "31a3d4830b001cff",
      "flags": 0,
      "text": "The Pokémon’s Defense and Sp. Def stats\\ngo up while stockpiling."
    },
    {
      "index": 68,
      "id": "BTR_STATE_34_01",
      "hash": "3a069dbd34b03041",
      "flags": 0,
      "text": "Taunt"
    },
    {
      "index": 69,
      "id": "BTR_STATE_34_02",
      "hash": "3a069abd34b02b28",
      "flags": 0,
      "text": "The Pokémon can only use moves that\\ndeal damage."
    },
    {
      "index": 70,
      "id": "BTR_STATE_35_01",
      "hash": "385e51b80d45c1ec",
      "flags": 0,
      "text": "Telekinesis"
    },
    {
      "index": 71,
      "id": "BTR_STATE_35_02",
      "hash": "385e54b80d45c705",
      "flags": 0,
      "text": "For three turns, moves used against\\nthe Pokémon will hit without fail, except for\\none-hit KO moves.\\nAlso, Ground-type moves won’t hit\\nthe Pokémon."
    },
    {
      "index": 72,
      "id": "BTR_STATE_36_01",
      "hash": "62dc49acc3dd04a3",
      "flags": 0,
      "text": "Magnet Rise"
    },
    {
      "index": 73,
      "id": "BTR_STATE_36_02",
      "hash": "62dc4aacc3dd0656",
      "flags": 0,
      "text": "Ground-type moves won’t hit the Pokémon\\nfor five turns."
    },
    {
      "index": 74,
      "id": "BTR_STATE_37_01",
      "hash": "358f5da6615e5f4e",
      "flags": 0,
      "text": "Toxic Spikes"
    },
    {
      "index": 75,
      "id": "BTR_STATE_37_02",
      "hash": "358f5ca6615e5d9b",
      "flags": 0,
      "text": "Pokémon that switch into battle will\\nbe poisoned.\\nFlying-type Pokémon or Pokémon with\\nthe Levitate Ability will not be affected."
    },
    {
      "index": 76,
      "id": "BTR_STATE_38_01",
      "hash": "6a0365e1c67ed69d",
      "flags": 0,
      "text": "Mud Sport"
    },
    {
      "index": 77,
      "id": "BTR_STATE_38_02",
      "hash": "6a0362e1c67ed184",
      "flags": 0,
      "text": "The power of Electric-type moves will be\\nhalved for five turns."
    },
    {
      "index": 78,
      "id": "BTR_STATE_39_01",
      "hash": "948159d67d161288",
      "flags": 0,
      "text": "Wish"
    },
    {
      "index": 79,
      "id": "BTR_STATE_39_02",
      "hash": "94815cd67d1617a1",
      "flags": 0,
      "text": "The Pokémon’s HP will be restored on the\\nturn after it uses Wish."
    },
    {
      "index": 80,
      "id": "BTR_STATE_40_01",
      "hash": "e979a57045ab8090",
      "flags": 0,
      "text": "Sticky Web"
    },
    {
      "index": 81,
      "id": "BTR_STATE_40_02",
      "hash": "e979a87045ab85a9",
      "flags": 0,
      "text": "Pokémon that switch into battle will have their\\nSpeed lowered."
    },
    {
      "index": 82,
      "id": "BTR_STATE_41_01",
      "hash": "be8eb17b8eb772c5",
      "flags": 4,
      "text": "Ingrain"
    },
    {
      "index": 83,
      "id": "BTR_STATE_41_02",
      "hash": "be8eae7b8eb76dac",
      "flags": 0,
      "text": "The Pokémon regains some HP at the end of\\neach turn.\\nIngrained Pokémon can’t be switched out."
    },
    {
      "index": 84,
      "id": "BTR_STATE_42_01",
      "hash": "1108f15fd3c2ef32",
      "flags": 0,
      "text": "Curse"
    },
    {
      "index": 85,
      "id": "BTR_STATE_42_02",
      "hash": "1108f05fd3c2ed7f",
      "flags": 0,
      "text": "The Pokémon takes damage at the end\\nof each turn."
    },
    {
      "index": 86,
      "id": "BTR_STATE_43_01",
      "hash": "e61e7d6b1ccfbae7",
      "flags": 0,
      "text": "Trick-or-Treat"
    },
    {
      "index": 87,
      "id": "BTR_STATE_43_02",
      "hash": "e61e7e6b1ccfbc9a",
      "flags": 0,
      "text": "The Pokémon gains the Ghost type."
    },
    {
      "index": 88,
      "id": "BTR_STATE_44_01",
      "hash": "17c36d94d608926c",
      "flags": 0,
      "text": "Light Screen"
    },
    {
      "index": 89,
      "id": "BTR_STATE_44_02",
      "hash": "17c37094d6089785",
      "flags": 0,
      "text": "Damage from special moves is halved for\\nfive turns."
    },
    {
      "index": 90,
      "id": "BTR_STATE_45_01",
      "hash": "196bb999fd7300c1",
      "flags": 0,
      "text": "Reflect"
    },
    {
      "index": 91,
      "id": "BTR_STATE_45_02",
      "hash": "196bb699fd72fba8",
      "flags": 0,
      "text": "Damage from physical moves is halved for\\nfive turns."
    },
    {
      "index": 92,
      "id": "BTR_STATE_46_01",
      "hash": "14f479832a212fce",
      "flags": 4,
      "text": "Imprison"
    },
    {
      "index": 93,
      "id": "BTR_STATE_46_02",
      "hash": "14f478832a212e1b",
      "flags": 4,
      "text": "If the Pokémon affected by Imprison know any\\nmoves also known by the user of Imprison, they\\nare prevented from using those moves."
    },
    {
      "index": 94,
      "id": "BTR_STATE_47_01",
      "hash": "424165898c9fd523",
      "flags": 0,
      "text": "Perish Song"
    },
    {
      "index": 95,
      "id": "BTR_STATE_47_02",
      "hash": "424166898c9fd6d6",
      "flags": 4,
      "text": "All Pokémon that heard Perish Song will faint\\nafter three turns."
    },
    {
      "index": 96,
      "id": "BTR_STATE_48_01",
      "hash": "73e675b345d8e308",
      "flags": 0,
      "text": "Spikes"
    },
    {
      "index": 97,
      "id": "BTR_STATE_48_02",
      "hash": "73e678b345d8e821",
      "flags": 0,
      "text": "Pokémon that switch into battle will\\ntake damage.\\nFlying-type Pokémon or Pokémon with\\nthe Levitate Ability will not be affected."
    },
    {
      "index": 98,
      "id": "BTR_STATE_49_01",
      "hash": "496881be8f41a71d",
      "flags": 0,
      "text": "Water Sport"
    },
    {
      "index": 99,
      "id": "BTR_STATE_49_02",
      "hash": "49687ebe8f41a204",
      "flags": 0,
      "text": "The power of Fire-type moves will be\\nhalved for five turns."
    },
    {
      "index": 100,
      "id": "BTR_STATE_50_01",
      "hash": "599345a531626213",
      "flags": 0,
      "text": "Destiny Bond"
    },
    {
      "index": 101,
      "id": "BTR_STATE_50_02",
      "hash": "599346a5316263c6",
      "flags": 4,
      "text": "If the Pokémon is knocked out by an opponent,\\nthat opponent will also faint."
    },
    {
      "index": 102,
      "id": "BTR_STATE_51_01",
      "hash": "56a499a008e28dfe",
      "flags": 0,
      "text": "Forest’s Curse"
    },
    {
      "index": 103,
      "id": "BTR_STATE_51_02",
      "hash": "56a498a008e28c4b",
      "flags": 0,
      "text": "The Pokémon gains the Grass type."
    },
    {
      "index": 104,
      "id": "BTR_STATE_52_01",
      "hash": "5b1bd9b6dc345ef1",
      "flags": 0,
      "text": "Leech Seed"
    },
    {
      "index": 105,
      "id": "BTR_STATE_52_02",
      "hash": "5b1bd6b6dc3459d8",
      "flags": 0,
      "text": "Leech Seed steals some of the Pokémon’s HP\\nat the end of each turn and gives it to\\nthe opponent."
    },
    {
      "index": 106,
      "id": "BTR_STATE_53_01",
      "hash": "2f154db07acb1f5c",
      "flags": 0,
      "text": "Lock-On"
