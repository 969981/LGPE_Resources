    {
      "index": 123,
      "id": "BTR_STATE_61_02",
      "hash": "5f00f718d05dd5be",
      "flags": 0,
      "text": "The Pokémon attacks and causes an uproar for\\nthree turns. During this time, no Pokémon can\\nfall asleep."
