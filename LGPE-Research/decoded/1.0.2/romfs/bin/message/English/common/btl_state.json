    {
      "index": 136,
      "id": "BTR_STATE_68_01",
      "hash": "d2ebf9d0a8c6399e",
      "flags": 0,
      "text": "Sea of Fire"
    },
    {
      "index": 137,
      "id": "BTR_STATE_68_02",
      "hash": "d2ebf8d0a8c637eb",
      "flags": 0,
      "text": "Pokémon that are not Fire type will\\ntake damage every turn."
    },
    {
      "index": 138,
      "id": "BTR_STATE_69_01",
      "hash": "28e4a5d843d2f533",
      "flags": 4,
      "text": "Extremely Harsh Sunlight"
    },
    {
      "index": 139,
      "id": "BTR_STATE_69_02",
      "hash": "28e4a6d843d2f6e6",
      "flags": 0,
      "text": "The extremely harsh sunlight weather condition.\\nIt boosts the power of Fire-type moves and\\nprotects Pokémon from Water-type moves."
    },
    {
      "index": 140,
      "id": "BTR_STATE_70_01",
      "hash": "cc2c4a4893958499",
      "flags": 0,
      "text": "Heavy Rain"
    },
    {
      "index": 141,
      "id": "BTR_STATE_70_02",
      "hash": "cc2c474893957f80",
      "flags": 0,
      "text": "The heavy rain weather condition.\\nIt boosts the power of Water-type moves and\\nprotects Pokémon from Fire-type moves."
    },
    {
      "index": 142,
      "id": "BTR_STATE_71_01",
      "hash": "f7175e3d4a89c8c4",
      "flags": 0,
      "text": "Strong Winds"
    },
    {
      "index": 143,
      "id": "BTR_STATE_71_02",
      "hash": "f717613d4a89cddd",
      "flags": 0,
      "text": "The strong winds weather condition.\\nThe power of moves that are super effective\\nagainst Flying-type Pokémon is decreased."
    },
    {
      "index": 144,
      "id": "BTR_STATE_72_01",
      "hash": "a0b19635af200bbb",
      "flags": 0,
      "text": "Psychic Terrain"
    },
    {
      "index": 145,
      "id": "BTR_STATE_72_02",
      "hash": "a0b19735af200d6e",
      "flags": 0,
      "text": "For five turns, Pokémon on the ground won’t be\\nhit by priority moves.\\nThe power of Psychic-type moves is boosted."
    },
    {
      "index": 146,
      "id": "BTR_STATE_73_01",
      "hash": "72f78a2f4c445e26",
      "flags": 0,
      "text": "Throat Chop"
    },
    {
      "index": 147,
      "id": "BTR_STATE_73_02",
      "hash": "72f7892f4c445c73",
      "flags": 0,
      "text": "The Pokémon can’t use any sound-based moves\\nfor two turns."
    },
    {
      "index": 148,
      "id": "BTR_STATE_74_01",
      "hash": "c84162253d3853dd",
      "flags": 4,
      "text": "Aurora Veil"
    },
    {
      "index": 149,
      "id": "BTR_STATE_74_02",
      "hash": "c8415f253d384ec4",
      "flags": 0,
      "text": "For five turns, the power of special and physical\\nmoves will be halved."
    },
    {
      "index": 150,
      "id": "BTR_STATE_75_01",
      "hash": "9c3a561edbce3ac8",
      "flags": 0,
