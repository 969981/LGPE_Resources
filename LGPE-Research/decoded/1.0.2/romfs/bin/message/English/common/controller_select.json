{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "cnt_select_win_01",
      "hash": "209514ec56c75baa",
      "flags": 0,
      "text": "Press a button on the controller you want to use."
    },
    {
      "index": 1,
      "id": "cnt_select_win_02",
      "hash": "209513ec56c759f7",
      "flags": 0,
      "text": "Do you want to use this controller?"
    },
    {
      "index": 2,
      "id": "cnt_select_win_03",
      "hash": "209512ec56c75844",
      "flags": 0,
      "text": "Button assignments have been changed."
    },
    {
      "index": 3,
      "id": "cnt_select_win_04",
      "hash": "209511ec56c75691",
      "flags": 0,
      "text": "You can’t use your Poké Ball Plus unless\\nyou complete the setup process.\\nDo you want to cancel the setup process?"
    },
    {
      "index": 4,
      "id": "cnt_select_win_05",
      "hash": "209510ec56c754de",
      "flags": 0,
      "text": "The setup process has been completed."
    },
    {
      "index": 5,
      "id": "cnt_select_win_06",
      "hash": "20950fec56c7532b",
      "flags": 0,
      "text": "Preparing...\\nDon’t turn off the power."
    },
    {
      "index": 6,
      "id": "cnt_select_win_07",
      "hash": "20950eec56c75178",
      "flags": 4,
      "text": "An error occurred.\\n\\nPlease try again from the beginning."
    },
    {
      "index": 7,
      "id": "cnt_select_win_08",
      "hash": "20950dec56c74fc5",
      "flags": 4,
      "text": "A Pokémon is in your Poké Ball Plus.\\nIt’s a present for you!\\n\\nSelect Communicate from the main menu, and\\nthen select Mystery Gifts."
    },
    {
      "index": 8,
      "id": "cnt_select_win_09",
      "hash": "20950cec56c74e12",
      "flags": 0,
      "text": "Please select a controller for your second player."
    },
    {
      "index": 9,
      "id": "cnt_select_win_10",
      "hash": "20918fec56c443d4",
      "flags": 0,
      "text": "Do you want to switch the button assignments\\nof your Poké Ball Plus?"
    },
    {
      "index": 10,
      "id": "cnt_select_win_11",
      "hash": "209190ec56c44587",
      "flags": 0,
      "text": "Please select a controller for your first player."
    },
    {
      "index": 11,
      "id": "cnt_select_win_12",
      "hash": "209191ec56c4473a",
      "flags": 0,
      "text": "Communicating..."
    },
    {
      "index": 12,
      "id": "cnt_select_info_01",
      "hash": "b671815c01514bc8",
      "flags": 0,
      "text": "When playing the game with a Poké Ball Plus,\\npress the Top Button to open the main menu."
    },
    {
      "index": 13,
      "id": "cnt_select_info_02",
      "hash": "b671845c015150e1",
      "flags": 0,
      "text": "Shake your Poké Ball Plus twice in the main\\nmenu to open the setting screen."
    },
    {
      "index": 14,
      "id": "cnt_select_info_03",
      "hash": "b671835c01514f2e",
      "flags": 0,
      "text": "When playing the game with a right Joy-Con,\\npress the X Button to open the main menu."
    },
    {
      "index": 15,
      "id": "cnt_select_info_04",
      "hash": "b671865c01515447",
      "flags": 0,
      "text": "When using a right Joy-Con, press any one\\nof the following to confirm a selection:\\n\\n・ Right Stick\\n・ R Button\\n・ ZR Button"
    },
    {
      "index": 16,
      "id": "cnt_select_info_05",
      "hash": "b671855c01515294",
      "flags": 0,
      "text": "When playing the game with a left Joy-Con,\\npress the Up Button to open the main menu."
    },
    {
      "index": 17,
      "id": "cnt_select_info_06",
      "hash": "b671885c015157ad",
      "flags": 0,
      "text": "When using a left Joy-Con, press any one\\nof the following to confirm a selection:\\n\\n・ Left Stick\\n・ L Button\\n・ ZL Button"
    },
    {
      "index": 18,
      "id": "cnt_select_info_07",
      "hash": "b671875c015155fa",
      "flags": 0,
      "text": "When playing the game in handheld mode,\\npress the X Button to open the main menu."
    },
    {
      "index": 19,
      "id": "cnt_select_info_08",
      "hash": "b6717a5c01513fe3",
      "flags": 0,
      "text": "When playing in handheld mode, press\\nthe Right Stick to confirm a selection.\\n\\nFor some screens, you can tap the\\ntouch screen to confirm a selection."
    },
    {
      "index": 20,
      "id": "cnt_select_sel_01",
      "hash": "b34042664de9fcd8",
      "flags": 0,
      "text": "Confirm"
