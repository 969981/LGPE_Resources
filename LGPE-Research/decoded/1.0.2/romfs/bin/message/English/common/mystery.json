{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_b_mystery_win_01",
      "hash": "fc8b33e34c6df3fa",
      "flags": 0,
      "text": "Would you like to receive a Mystery Gift?"
    },
    {
      "index": 1,
      "id": "msg_b_mystery_win_02",
      "hash": "fc8b32e34c6df247",
      "flags": 0,
      "text": "There is no room for another Pokémon.\\nDo you still want to try to get a gift?"
    },
    {
      "index": 2,
      "id": "msg_b_mystery_win_03",
      "hash": "fc8b31e34c6df094",
      "flags": 4,
      "text": "Attention!\\nIf your battery runs out or you’re disconnected\\nwhile you’re receiving a gift with a code or\\npassword, you may no longer be able to receive\\nthe gift using the same code or password.\\nPlease check your system’s battery.\\nPlease also make sure there is no\\ncommunication issue."
    },
    {
      "index": 3,
      "id": "msg_b_mystery_win_03_p",
      "hash": "e39f95089bb4d333",
      "flags": 4,
      "text": "Attention!\\nIf your battery runs out or you’re disconnected\\nwhile you’re receiving a gift, you may no longer\\nbe able to receive the gift.\\nPlease check the battery of your\\nNintendo Switch and Poké Ball Plus.\\nPlease also make sure there is no\\ncommunication issue."
    },
    {
      "index": 4,
      "id": "msg_b_mystery_win_04",
      "hash": "fc8b30e34c6deee1",
      "flags": 4,
      "text": "Attention!\\nYou failed to enter the correct code or password\\nmultiple times, so you can’t try reentering\\nthe code for a while.\\nPlease try again later."
    },
    {
      "index": 5,
      "id": "msg_b_mystery_win_04_p",
      "hash": "d9c47e0895c964de",
      "flags": 4,
      "text": "Attention!\\nYou failed to enter the correct code or password\\nmultiple times, so you can’t receive a gift with\\na Poké Ball Plus.\\nPlease try again later."
    },
    {
      "index": 6,
      "id": "msg_b_mystery_win_05",
      "hash": "fc8b2fe34c6ded2e",
      "flags": 0,
      "text": "Verifying...\\nDon’t turn off the power."
    },
    {
      "index": 7,
      "id": "msg_b_mystery_win_05_p",
      "hash": "d27647089208f869",
      "flags": 0,
      "text": "Connecting...\\nDon’t turn off the power."
    },
    {
      "index": 8,
      "id": "msg_b_mystery_win_06",
      "hash": "fc8b2ee34c6deb7b",
      "flags": 0,
      "text": "Do you want to try entering the code or\\npassword again?"
    },
    {
      "index": 9,
      "id": "msg_b_mystery_win_07",
      "hash": "fc8b2de34c6de9c8",
      "flags": 0,
      "text": "Searching for gifts..."
    },
    {
      "index": 10,
      "id": "msg_b_mystery_win_08",
      "hash": "fc8b2ce34c6de815",
      "flags": 0,
      "text": "There was a problem with receiving the gift."
    },
    {
      "index": 11,
      "id": "msg_b_mystery_win_09",
      "hash": "fc8b2be34c6de662",
      "flags": 0,
      "text": "No gift was found."
    },
    {
      "index": 12,
      "id": "msg_b_mystery_win_10",
      "hash": "fc87aee34c6adc24",
      "flags": 4,
      "text": "Ending communication...\\nPlease wait."
    },
    {
      "index": 13,
      "id": "msg_b_mystery_win_11",
      "hash": "fc87afe34c6addd7",
      "flags": 0,
      "text": "Please choose the gift you want to receive."
    },
    {
      "index": 14,
      "id": "msg_b_mystery_win_12",
      "hash": "fc87b0e34c6adf8a",
      "flags": 0,
      "text": "Do you want to give up for now?"
    },
    {
      "index": 15,
      "id": "msg_b_mystery_win_13",
      "hash": "fc87b1e34c6ae13d",
      "flags": 4,
      "text": "As you have already received this gift, you\\ncannot get another one."
    },
    {
      "index": 16,
      "id": "msg_b_mystery_win_14",
      "hash": "fc87aae34c6ad558",
      "flags": 0,
      "text": "There is no room for another Pokémon.\\nMake room in your Pokémon Box, and try again."
    },
    {
      "index": 17,
      "id": "msg_b_mystery_win_15",
      "hash": "fc87abe34c6ad70b",
      "flags": 0,
      "text": "Receiving your gift...\\nDon’t turn off the power."
    },
    {
      "index": 18,
      "id": "msg_b_mystery_win_16",
      "hash": "fc87ace34c6ad8be",
      "flags": 4,
      "text": "A gift was found, but you can’t receive it with\\nyour current software."
    },
    {
      "index": 19,
      "id": "msg_b_mystery_win_17",
      "hash": "fc87ade34c6ada71",
      "flags": 0,
      "text": "You will now connect to the internet.\\nYour game will be saved. Is that OK?"
    },
    {
      "index": 20,
      "id": "msg_b_mystery_win_18",
      "hash": "fc87a6e34c6ace8c",
      "flags": 0,
      "text": "Connecting...\\nPlease stand by."
    },
    {
      "index": 21,
      "id": "msg_b_mystery_win_19",
      "hash": "fc87a7e34c6ad03f",
      "flags": 0,
      "text": "You are now connected to the internet."
    },
    {
      "index": 22,
      "id": "msg_b_mystery_win_20",
      "hash": "fc9220e34c73f25f",
      "flags": 0,
      "text": "Saving...\\nPlease wait."
    },
    {
      "index": 23,
      "id": "msg_b_mystery_win_21",
      "hash": "fc921fe34c73f0ac",
      "flags": 0,
      "text": "You will now connect to the internet.\\nYour game will be saved. Is that OK?"
    },
    {
      "index": 24,
      "id": "msg_b_mystery_win_22",
      "hash": "fc9222e34c73f5c5",
      "flags": 0,
      "text": "You are now connected to the internet."
    },
    {
      "index": 25,
      "id": "msg_b_mystery_win_23",
      "hash": "fc9221e34c73f412",
      "flags": 0,
      "text": "Saving...\\nPlease wait."
    },
    {
      "index": 26,
      "id": "msg_b_mystery_win_24",
      "hash": "fc921ce34c73eb93",
      "flags": 0,
      "text": "Connecting...\\nPlease stand by."
    },
    {
      "index": 27,
      "id": "msg_b_mystery_win_25",
      "hash": "fc921be34c73e9e0",
      "flags": 4,
      "text": "A Pokémon is in your Poké Ball Plus.\\nIt’s a present for you!\\r\\nWould you like to receive it?"
    },
    {
      "index": 28,
      "id": "msg_b_mystery_win_26",
      "hash": "fc921ee34c73eef9",
      "flags": 0,
      "text": "This Poké Ball Plus doesn’t contain any\\nPokémon presents.\\n\\nConnect a Poké Ball Plus that has a Pokémon\\nin it as the first controller for your game, and\\ntry again."
    },
    {
      "index": 29,
      "id": "msg_b_mystery_win_27",
      "hash": "fc921de34c73ed46",
      "flags": 0,
      "text": "Don’t end the connection to the Poké Ball Plus."
    },
    {
      "index": 30,
      "id": "msg_b_mystery_win_28",
      "hash": "fc9228e34c73fff7",
      "flags": 0,
      "text": "Communication with the Poké Ball Plus failed."
    },
    {
      "index": 31,
      "id": "msg_b_mystery_serial_error_11",
      "hash": "a116125931d33e8e",
      "flags": 0,
      "text": "The code or password is incorrect.\\nPlease check your code or password."
    },
    {
      "index": 32,
      "id": "msg_b_mystery_serial_error_11_p",
      "hash": "6afae11dc92ab409",
      "flags": 0,
      "text": "The code or password is incorrect.\\nPlease check your code or password."
    },
    {
      "index": 33,
      "id": "msg_b_mystery_serial_error_12",
      "hash": "a116115931d33cdb",
      "flags": 0,
      "text": "This code has been used in other save data."
    },
    {
      "index": 34,
      "id": "msg_b_mystery_serial_error_12_p",
      "hash": "6045ca1dc285a1f4",
      "flags": 0,
      "text": "This Poké Ball Plus is being used\\nfor other save data.\\nPlease try again later."
    },
    {
      "index": 35,
      "id": "msg_b_mystery_serial_error_13",
      "hash": "a116105931d33b28",
      "flags": 0,
      "text": "You cannot yet receive the gift provided by this\\ncode or password."
    },
    {
      "index": 36,
      "id": "msg_b_mystery_serial_error_13_p",
      "hash": "59d0931dbf7d263f",
      "flags": 0,
      "text": "You cannot receive Mew yet."
    },
    {
      "index": 37,
      "id": "msg_b_mystery_serial_error_14",
      "hash": "a116175931d3470d",
      "flags": 0,
      "text": "The code or password has expired.\\nYou cannot receive the gift."
    },
    {
      "index": 38,
      "id": "msg_b_mystery_serial_error_14_p",
      "hash": "9650b41de1b7d092",
      "flags": 0,
      "text": "The time period to receive Mew has expired."
    },
    {
      "index": 39,
      "id": "msg_b_mystery_serial_error_15",
      "hash": "a116165931d3455a",
      "flags": 0,
      "text": "Your game cannot receive the gift provided by\\nthis code or password."
    },
    {
      "index": 40,
      "id": "msg_b_mystery_serial_error_15_p",
      "hash": "8b9b9d1ddb12be7d",
      "flags": 0,
      "text": "Your game cannot receive the gift provided by\\nthis code or password."
    },
    {
      "index": 41,
      "id": "msg_b_mystery_serial_error_16",
      "hash": "a116155931d343a7",
      "flags": 0,
      "text": "The code/password update failed...\\nYou cannot receive the gift provided by this\\ncode or password."
    },
    {
      "index": 42,
      "id": "msg_b_mystery_serial_error_16_p",
      "hash": "8526661dd80a42c8",
      "flags": 0,
      "text": "The attempt to receive Mew was unsuccessful.\\nPlease try again."
    },
    {
      "index": 43,
      "id": "msg_b_mystery_serial_error_17",
      "hash": "a116145931d341f4",
      "flags": 0,
      "text": "You have already received the gift provided\\nby this code or password."
    },
    {
      "index": 44,
      "id": "msg_b_mystery_serial_error_17_p",
      "hash": "7a722f1dd166ad53",
      "flags": 0,
      "text": "You have already received Mew."
    },
    {
      "index": 45,
      "id": "msg_b_mystery_serial_error_18",
      "hash": "a1160b5931d332a9",
      "flags": 0,
      "text": "This code has already been used.\\nOnce a code is used, it cannot be used in\\nother save data."
    },
    {
      "index": 46,
      "id": "msg_b_mystery_serial_error_18_p",
      "hash": "2e7ac01da6f009b6",
      "flags": 0,
      "text": "Mew has already left this Poké Ball Plus."
    },
    {
      "index": 47,
      "id": "msg_b_mystery_serial_error_22",
      "hash": "a119175931d57ce4",
      "flags": 0,
      "text": "You failed to enter the correct code or password,\\nso you can’t connect to the server for a while.\\nPlease try again later."
    },
    {
      "index": 48,
      "id": "msg_b_mystery_serial_error_22_p",
      "hash": "c14eaa244240afc3",
      "flags": 0,
      "text": "You failed to enter the correct code or password,\\nso you can’t connect to the server for a while.\\nPlease try again later."
    },
    {
      "index": 49,
      "id": "msg_b_mystery_sel_01",
      "hash": "e4f01cbe3d22d768",
      "flags": 0,
      "text": "Yes"
    },
    {
      "index": 50,
      "id": "msg_b_mystery_sel_02",
      "hash": "e4f01fbe3d22dc81",
      "flags": 0,
      "text": "No"
    },
    {
      "index": 51,
      "id": "msg_b_mystery_sel_03",
      "hash": "e4f01ebe3d22dace",
      "flags": 0,
      "text": "Get via internet"
    },
    {
      "index": 52,
      "id": "msg_b_mystery_sel_04",
      "hash": "e4f021be3d22dfe7",
      "flags": 0,
      "text": "Get with code/password"
    },
    {
      "index": 53,
      "id": "msg_b_mystery_sel_05",
      "hash": "e4f020be3d22de34",
      "flags": 0,
      "text": "Check Mystery Gifts"
    },
    {
      "index": 54,
      "id": "msg_b_mystery_sel_06",
      "hash": "e4f023be3d22e34d",
      "flags": 0,
      "text": "Quit"
    },
    {
      "index": 55,
      "id": "msg_b_mystery_sel_07",
      "hash": "e4f022be3d22e19a",
      "flags": 0,
      "text": " Back"
    },
    {
      "index": 56,
      "id": "msg_b_mystery_sel_08",
      "hash": "e4f015be3d22cb83",
      "flags": 0,
      "text": "Get with a Poké Ball Plus"
