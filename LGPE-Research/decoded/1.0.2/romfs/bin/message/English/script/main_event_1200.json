{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main1200_rival_01",
      "hash": "723f186098a8ef50",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: ...Huh?\\nWhy’s the door locked?"
    },
    {
      "index": 1,
      "id": "msg_main1200_rival_02",
      "hash": "723f1b6098a8f469",
      "flags": 4,
      "text": "Open sesame!"
    },
    {
      "index": 2,
      "id": "msg_main1200_rival_03",
      "hash": "723f1a6098a8f2b6",
      "flags": 0,
      "text": "Huh. Yeah, I guess that isn’t gonna work..."
    },
    {
      "index": 3,
      "id": "msg_main1200_rival_04",
      "hash": "723f1d6098a8f7cf",
      "flags": 0,
      "text": "Man..."
    },
    {
      "index": 4,
      "id": "msg_main1200_rival_05",
      "hash": "723f1c6098a8f61c",
      "flags": 4,
      "text": "Oh! Hey, [VAR TRNAME(0000)]!\\nSheesh, say something if you’re standing there!\\r\\nWatching me act all embarrassing like that..."
    },
    {
      "index": 5,
      "id": "msg_main1200_rival_06",
      "hash": "723f1f6098a8fb35",
      "flags": 0,
      "text": "Well, never mind that!\\nSo, how many Gym Badges you got these days?"
    },
    {
      "index": 6,
      "id": "msg_main1200_rival_10",
      "hash": "723bb36098a60dda",
      "flags": 0,
      "text": "...S-seven?!\\nThen it looks like we’re even!\\c\\nAll that’s left now is the Viridian City Gym...\\nSame for you, right?\\r\\nBut this place is never open..."
    },
    {
      "index": 7,
      "id": "msg_main1200_rival_07",
      "hash": "723f1e6098a8f982",
      "flags": 4,
      "text": "I guess we’ve gotta tell someone that we haven’t\\nbeen able to get into the Gym...\\r\\nBut who should we talk to?"
    },
    {
      "index": 8,
      "id": "msg_main1200_select_01",
      "hash": "4847a94b196d6768",
      "flags": 0,
      "text": "Professor Oak"
    },
    {
      "index": 9,
      "id": "msg_main1200_select_02",
      "hash": "4847ac4b196d6c81",
      "flags": 0,
      "text": "[VAR POKNAME(0003)]"
    },
    {
      "index": 10,
      "id": "msg_main1200_select_03",
      "hash": "4847ab4b196d6ace",
      "flags": 0,
      "text": "That old man there"
    },
    {
      "index": 11,
      "id": "msg_main1200_oldman_01",
      "hash": "c70dc56b184a5299",
      "flags": 4,
      "text": "OLD MAN: What?! Me?!\\nI don’t know anything about a thing like that..."
    },
    {
      "index": 12,
      "id": "msg_main1200_rival_11",
      "hash": "723bb46098a60f8d",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: O-of course you wouldn’t!\\nSorry about that... We’ll think it over ourselves!"
    },
    {
      "index": 13,
      "id": "msg_main1200_rival_08",
      "hash": "723f216098a8fe9b",
      "flags": 0,
      "text": "Yeah, that’s what I was thinking, too.\\nLet’s go see if he knows anything!"
    },
    {
      "index": 14,
      "id": "msg_main1200_poke_01",
      "hash": "463c8e1cd61b3757",
      "flags": 0,
      "text": "Piiika! Pika pika!"
    },
    {
      "index": 15,
      "id": "msg_main1200_poke_02",
      "hash": "463c8f1cd61b390a",
      "flags": 0,
      "text": "Veeeeee! Eevee!"
    },
    {
      "index": 16,
      "id": "msg_main1200_rival_09",
      "hash": "723f206098a8fce8",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: Uh-huh... Uh-huh...\\nMakes sense...\\c\\nIf I could understand anything you said!\\nThis is getting us nowhere..."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_1200_max",
      "hash": "b01f702cfacb0504"
    }
  ]
}
