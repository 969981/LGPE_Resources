{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub024_researcher_01",
      "hash": "d427d40043ea8c98",
      "flags": 0,
      "text": "Hiya!\\c\\nI am an important doctor.\\nYes, very well known indeed.\\c\\nHere, I study rare Pokémon Fossils.\\c\\nHey!\\nDo you have a Fossil for me?"
    },
    {
      "index": 1,
      "id": "msg_sub024_select_01",
      "hash": "9c5bbb480ccf64a2",
      "flags": 0,
      "text": "Helix Fossil"
    },
    {
      "index": 2,
      "id": "msg_sub024_select_02",
      "hash": "9c5bba480ccf62ef",
      "flags": 0,
      "text": "Dome Fossil"
    },
    {
      "index": 3,
      "id": "msg_sub024_select_03",
      "hash": "9c5bb9480ccf613c",
      "flags": 4,
      "text": "Old Amber"
    },
    {
      "index": 4,
      "id": "msg_sub024_select_04",
      "hash": "9c5bb8480ccf5f89",
      "flags": 0,
      "text": "Quit"
    },
    {
      "index": 5,
      "id": "msg_sub024_researcher_02",
      "hash": "d427d70043ea91b1",
      "flags": 0,
      "text": "No!\\nToo bad!"
    },
    {
      "index": 6,
      "id": "msg_sub024_researcher_03",
      "hash": "d427d60043ea8ffe",
      "flags": 0,
      "text": "Success!\\c\\nThe Fossil was [VAR INDEF_ART(0004)][VAR POKNAME(0004)] as I thought!"
    },
    {
      "index": 7,
      "id": "msg_sub024_sys_01",
      "hash": "0fa5772ce07503fd",
      "flags": 0,
      "text": "You got [VAR INDEF_ART(0004)][VAR POKNAME(0004)] from the doctor!"
    },
    {
      "index": 8,
      "id": "msg_sub024_researcher_04",
      "hash": "d427d90043ea9517",
      "flags": 4,
      "text": "Oh!\\nThat is [VAR INDEF_ART(0002)][VAR ITEM2(0002)], it is!\\c\\nIt is a Fossil of [VAR POKNAME(0001)], a Pokémon\\nthat is already extinct!\\c\\nShall I use my Resurrection Machine to make\\nthat Pokémon live again?"
    },
    {
      "index": 9,
      "id": "msg_sub024_researcher_05",
      "hash": "d427d80043ea9364",
      "flags": 0,
      "text": "So!\\nGive it here!"
    },
    {
      "index": 10,
      "id": "msg_sub024_sys_02",
      "hash": "0fa5742ce074fee4",
      "flags": 0,
      "text": "You handed over the [VAR ITEM2(0002)]\\nto the odd doctor."
    },
    {
      "index": 11,
      "id": "msg_sub024_researcher_06",
      "hash": "d427db0043ea987d",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_sub024_researcher_07",
      "hash": "d427da0043ea96ca",
      "flags": 0,
      "text": "Well then!\\nCome back soon!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_024_max",
      "hash": "93371b7482b7e5d0"
    }
  ]
}
