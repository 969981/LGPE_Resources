{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8020_volt_01",
      "hash": "89318c21a2f32408",
      "flags": 0,
      "text": "Ten-hut!\\nWelcome to the Vermilion City Gym!"
    },
    {
      "index": 1,
      "id": "msg_main8020_volt_07",
      "hash": "89319221a2f32e3a",
      "flags": 0,
      "text": "Will you look at that—a pint-sized challenger!"
    },
    {
      "index": 2,
      "id": "msg_main8020_volt_08",
      "hash": "89318521a2f31823",
      "flags": 0,
      "text": "Hahaha! You’ve got big and brassy nerves to\\ntake me on with your puny power!"
    },
    {
      "index": 3,
      "id": "msg_main8020_volt_09",
      "hash": "89318421a2f31670",
      "flags": 4,
      "text": "A Pokémon battle is war!\\nI’ll show you, civilian!"
    },
    {
      "index": 4,
      "id": "msg_main8020_volt_10",
      "hash": "892e0721a2f00c32",
      "flags": 4,
      "text": "I’ll shock you into surrender!"
    },
    {
      "index": 5,
      "id": "msg_gymleader_03_07",
      "hash": "47fdc3356398ac8b",
      "flags": 0,
      "text": "[~ 5]"
    },
    {
      "index": 6,
      "id": "msg_main8020_volt_02",
      "hash": "89318f21a2f32921",
      "flags": 0,
      "text": "Fine! Then take a Thunder Badge!"
    },
    {
      "index": 7,
      "id": "msg_main8020_sys_01",
      "hash": "cbbdb782c305534c",
      "flags": 0,
      "text": "You got a [VAR COLOR(0006)]Thunder Badge[VAR COLOR(0000)] from Lt. Surge!"
    },
    {
      "index": 8,
      "id": "msg_main8020_volt_03",
      "hash": "89318e21a2f3276e",
      "flags": 4,
      "text": "And that’s not all!\\c\\nYou’re special, kid!\\nTake this!"
    },
    {
      "index": 9,
      "id": "msg_main8020_sys_02",
      "hash": "cbbdba82c3055865",
      "flags": 0,
      "text": "You got Lt. Surge’s [VAR COLOR(0006)]Autograph[VAR COLOR(0000)]."
    },
    {
      "index": 10,
      "id": "msg_main8020_volt_04",
      "hash": "89319121a2f32c87",
      "flags": 0,
      "text": "... ... ..."
    },
    {
      "index": 11,
      "id": "msg_main8020_volt_11",
      "hash": "892e0821a2f00de5",
      "flags": 0,
      "text": "Dahaha! Don’t worry!\\nThat’s not all I’m giving you!"
    },
    {
      "index": 12,
      "id": "msg_main8020_sys_03",
      "hash": "cbbdb982c30556b2",
      "flags": 0,
      "text": "You got [VAR ITEM2(0001)] [VAR COLOR(0006)][VAR MOVE(0002)][VAR COLOR(0000)] from Lt. Surge!"
    },
    {
      "index": 13,
      "id": "msg_main8020_volt_05",
      "hash": "89319021a2f32ad4",
      "flags": 0,
      "text": "TM36 contains the electrifying Thunderbolt!\\c\\nTeach it to an Electric-type Pokémon for some\\nextra shock value!"
    },
    {
      "index": 14,
      "id": "msg_main8020_volt_06",
      "hash": "89319321a2f32fed",
      "flags": 4,
      "text": "And a little word of advice, kid!\\c\\nElectric-type moves are sure powerful!\\c\\nBut remember that they’ll get sucked right up\\nby Ground-type Pokémon!\\r\\nThose moves are useless against them!"
    },
    {
      "index": 15,
      "id": "msg_gymleader_03_06",
      "hash": "47fdc2356398aad8",
      "flags": 0,
      "text": "[~ 15]"
    }
  ],
