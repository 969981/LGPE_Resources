  "lines": [
    {
      "index": 0,
      "id": "msg_main0100_clerkm_01",
      "hash": "cd2960b82837a7d8",
      "flags": 0,
      "text": "Hey!\\nYou came up from Pallet Town?"
    },
    {
      "index": 1,
      "id": "msg_main0100_clerkm_02",
      "hash": "cd2963b82837acf1",
      "flags": 0,
      "text": "You must know Professor Oak, right?\\c\\nI’ve got a delivery for him, but I really can’t\\nleave the Poké Mart unattended right now.\\c\\nCan I get you to take this to Professor Oak\\nfor me?"
    },
    {
      "index": 2,
      "id": "msg_main0100_sys_01",
      "hash": "273c0ce0fcfa18e3",
      "flags": 0,
      "text": "You took the [VAR COLOR(0006)]Parcel[VAR COLOR(0000)] from the Poké Mart clerk!"
    },
    {
      "index": 3,
      "id": "msg_main0100_clerkm_03",
      "hash": "cd2962b82837ab3e",
      "flags": 0,
      "text": "Thanks, kid!\\nSay hi to Professor Oak for me, too."
    },
    {
      "index": 4,
      "id": "msg_main0100_clerkm_04",
      "hash": "cd2965b82837b057",
      "flags": 0,
      "text": "[~ 4]"
    },
    {
      "index": 5,
      "id": "msg_main0100_sys_02",
      "hash": "273c0de0fcfa1a96",
      "flags": 0,
      "text": "Do you want to head straight back to the lab?"
    }
  ],
