{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_town004_kanban_01",
      "hash": "b51317a8f3060e71",
      "flags": 0,
      "text": "Cerulean City:\\nA Mysterious Blue Aura Surrounds It"
    },
    {
      "index": 1,
      "id": "msg_town004_kanban_02",
      "hash": "b51314a8f3060958",
      "flags": 0,
      "text": "Trainer Tips\\c\\nIf you press the B Button when a Pokémon is\\nin the middle of evolving, you can make it stop!"
    },
    {
      "index": 2,
      "id": "msg_town004_kanban_03",
      "hash": "b51315a8f3060b0b",
      "flags": 0,
      "text": "Home of the Bike Maniac"
    },
    {
      "index": 3,
      "id": "msg_town004_kanban_04",
      "hash": "b5131aa8f306138a",
      "flags": 0,
      "text": "Cerulean City Pokémon Gym\\nGym Leader: Misty\\r\\nThe Tomboyish Mermaid!"
    },
    {
      "index": 4,
      "id": "msg_town004_adultm_01",
      "hash": "974467edc6eb5151",
      "flags": 0,
      "text": "You’re a Trainer, too?\\c\\nCollecting Pokémon, battling with Pokémon...\\nIt’s a tough life, isn’t it?"
    },
    {
      "index": 5,
      "id": "msg_town004_youngm_01_01",
      "hash": "39c978ef1accc119",
      "flags": 0,
      "text": "There’s a tree growing in front of the Poké Mart.\\nIt’s blocking the way to the route to the south!\\c\\nI think there’s a long way around, though..."
    },
    {
      "index": 6,
      "id": "msg_boya1_01_p02_field_t004",
      "hash": "6dbca59f00f65f78",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_town004_middlem_01",
      "hash": "3a702dc61ba863a4",
      "flags": 0,
      "text": "You’re making some sort of encyclopedia of\\nPokémon? That sounds like a fun time!"
    },
    {
      "index": 8,
      "id": "msg_town004_policef_01",
      "hash": "eedfa2d161c67198",
      "flags": 0,
      "text": "What a shame...\\nThe people here were robbed!\\c\\nSomeone even saw the thieves escape, and they\\nsay it was none other than Team Rocket!\\c\\nTo protect the poor owners of this house from\\nfurther harm, I won’t be letting anyone in!\\r\\nNot even a little Rattata will sneak past me!"
    },
    {
      "index": 9,
      "id": "msg_town004_youngf_01_01",
      "hash": "89c3f2c67ed7bf0c",
      "flags": 4,
      "text": "OK, Electrode!\\nUse Sonic Boom!\\c\\nAwww, come on, Elec!\\nI wish you’d listen to my orders!"
    },
    {
      "index": 10,
      "id": "msg_town004_youngf_01_02",
      "hash": "89c3f5c67ed7c425",
      "flags": 4,
      "text": "Electrode! Use Tackle! Now!\\c\\nD’aww... Failed again?"
    },
    {
      "index": 11,
      "id": "msg_town004_youngf_01_03",
      "hash": "89c3f4c67ed7c272",
      "flags": 4,
      "text": "Electrode! Use Swift!\\c\\nNo, no, not that move!\\nOooh, Pokémon are so hard to control!\\c\\nThey say it’s up to your skill as a Trainer whether\\nyour Pokémon listen to you or not."
    },
    {
      "index": 12,
      "id": "msg_town004_poke_01_01",
      "hash": "bbf3f6e0c799a43b",
      "flags": 4,
      "text": "Electrode is taking a snooze..."
    },
    {
      "index": 13,
      "id": "msg_town004_poke_01_02",
      "hash": "bbf3f7e0c799a5ee",
      "flags": 4,
      "text": "Electrode is loafing around..."
    },
    {
      "index": 14,
      "id": "msg_town004_poke_01_03",
      "hash": "bbf3f8e0c799a7a1",
      "flags": 4,
      "text": "Electrode turned away!"
    },
    {
      "index": 15,
      "id": "msg_town004_poke_01_04",
      "hash": "bbf3f9e0c799a954",
      "flags": 4,
      "text": "Electrode is ignoring orders..."
    },
    {
      "index": 16,
      "id": "msg_town004_childf_01",
      "hash": "0333cfa13f0b2060",
      "flags": 0,
      "text": "You know the guy who lives in that house there?\\c\\nHe’s collected bikes from all over the world!"
    },
    {
      "index": 17,
      "id": "msg_trainerm1_01_p01_field_t004",
      "hash": "424b20fd31d344f4",
      "flags": 0,
      "text": "This is the Cerulean Cave.\\nFrightfully strong Pokémon live inside.\\c\\nYou’d have to be a very special Trainer to be\\nallowed in—a Champion recognized by\\r\\nthe Pokémon League, in fact!"
    },
    {
      "index": 18,
      "id": "msg_town004_fat_01",
      "hash": "9b47f4cb990902d1",
      "flags": 0,
      "text": "[~ 18]"
    },
    {
      "index": 19,
      "id": "msg_town004_poke_02_01",
      "hash": "1259bee863036144",
      "flags": 0,
      "text": "[~ 19]"
    },
