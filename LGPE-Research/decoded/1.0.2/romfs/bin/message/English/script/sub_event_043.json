{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub043_middle_01",
      "hash": "636a64446d37698e",
      "flags": 0,
      "text": "The Pewter City specialty—Pewter Crunchies!\\nThey’re ₽500!\\c\\nYou’re limited to one package per day, though."
    },
    {
      "index": 1,
      "id": "msg_sub043_select_01",
      "hash": "c08b22c858810d85",
      "flags": 4,
      "text": "I want some"
    },
    {
      "index": 2,
      "id": "msg_sub043_select_02",
      "hash": "c08b1fc85881086c",
      "flags": 4,
      "text": "I don’t want any"
    },
    {
      "index": 3,
      "id": "msg_sub043_middle_02",
      "hash": "636a63446d3767db",
      "flags": 0,
      "text": "Thanks!\\nThey are very hard, so be careful!"
    },
    {
      "index": 4,
      "id": "msg_sub043_system_01",
      "hash": "b51a3afa6e71ae92",
      "flags": 0,
      "text": "You got Pewter Crunchies from the man!"
    },
    {
      "index": 5,
      "id": "msg_sub043_middle_03",
      "hash": "636a62446d376628",
      "flags": 0,
      "text": "That’s too bad!\\nNext time!"
    },
    {
      "index": 6,
      "id": "msg_sub043_middle_04",
      "hash": "636a69446d37720d",
      "flags": 4,
      "text": "Oh, you don’t have enough money!\\nPlease come back again!"
    },
    {
      "index": 7,
      "id": "msg_sub043_middle_05",
      "hash": "636a68446d37705a",
      "flags": 0,
      "text": "You can’t carry any more Pewter Crunchies!\\nWhy do you have so many?\\c\\n...Please eat them!"
    },
    {
      "index": 8,
      "id": "msg_sub043_middle_06",
      "hash": "636a67446d376ea7",
      "flags": 0,
      "text": "You’re limited to one package per day.\\nPlease come back tomorrow."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_043_max",
      "hash": "e43f42cffdc6fe6f"
    }
  ]
