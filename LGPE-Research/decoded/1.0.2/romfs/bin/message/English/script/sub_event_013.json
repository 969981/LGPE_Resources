  "lines": [
    {
      "index": 0,
      "id": "msg_sub013_sister_01",
      "hash": "26f68ca277e78a2c",
      "flags": 0,
      "text": "Hey, [VAR TRNAME(0000)]!\\c\\nWould you like to know how much your\\nPokémon like you?"
    },
    {
      "index": 1,
      "id": "msg_sub013_sister_02",
      "hash": "26f68fa277e78f45",
      "flags": 0,
      "text": "Hey, [VAR TRNAME(0000)]!\\c\\nWould you like to know how much your\\nPokémon like you?"
    },
    {
      "index": 2,
      "id": "msg_sub013_sister_03",
      "hash": "26f68ea277e78d92",
      "flags": 0,
      "text": "Pokémon will grow to love their Trainer if they’re\\ntreated with love and care, you know!"
    },
    {
      "index": 3,
      "id": "msg_sub013_sister_04",
      "hash": "26f689a277e78513",
      "flags": 4,
      "text": "In that case, let me see how [VAR PKNICK(0001)]\\nis doing!"
    },
    {
      "index": 4,
      "id": "msg_sub013_sister_05",
      "hash": "26f688a277e78360",
      "flags": 0,
      "text": "[VAR PKNICK(0001)] really, really, really loves you!\\nI can tell you really trust each other!"
    },
    {
      "index": 5,
      "id": "msg_sub013_sister_06",
      "hash": "26f68ba277e78879",
      "flags": 4,
      "text": "I can tell [VAR PKNICK(0001)] really likes you.\\nIt’s saying it wants to always be with you!"
    },
    {
      "index": 6,
      "id": "msg_sub013_sister_07",
      "hash": "26f68aa277e786c6",
      "flags": 4,
      "text": "It seems like [VAR PKNICK(0001)] likes being\\nwith you!"
    },
    {
      "index": 7,
      "id": "msg_sub013_sister_08",
      "hash": "26f695a277e79977",
      "flags": 0,
      "text": "You’re really starting to get friendly!\\nI’m sure you’ll be best friends in no time."
    },
    {
      "index": 8,
      "id": "msg_sub013_sister_09",
      "hash": "26f694a277e797c4",
      "flags": 0,
      "text": "Seems like it’s starting to like you!\\nI’m excited to see how you two grow."
    },
    {
      "index": 9,
      "id": "msg_sub013_sister_10",
      "hash": "26f307a277e47256",
      "flags": 4,
      "text": "Oh, I guess you just met, huh?\\nWell, I’m looking forward to seeing you become\\r\\nfast friends!"
    },
    {
      "index": 10,
      "id": "msg_sub013_sister_11",
      "hash": "26f308a277e47409",
      "flags": 0,
      "text": "Maybe it gets KO’d a lot in battles...?"
    },
    {
      "index": 11,
      "id": "msg_sub013_sister_12",
      "hash": "26f305a277e46ef0",
      "flags": 4,
      "text": "Oh no! Why are you talking to me? You should\\ntake it to a Pokémon Center right away!"
    },
