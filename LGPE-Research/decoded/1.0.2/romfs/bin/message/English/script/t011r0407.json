  "lines": [
    {
      "index": 0,
      "id": "msg_t011r0407_staffm_01_01",
      "hash": "e697afe7de4cf5dc",
      "flags": 0,
      "text": "The president is still in the boardroom\\non the 11th floor!\\c\\nI’m so worried. I hope he’s safe..."
    },
    {
      "index": 1,
      "id": "msg_t011r0407_staffm_01_02",
      "hash": "e697b2e7de4cfaf5",
      "flags": 0,
      "text": "Thank you for rescuing the president!\\nI couldn’t thank you enough!"
    },
    {
      "index": 2,
      "id": "msg_t011r0407_staffm_02_01",
      "hash": "1115a7dc94e43893",
      "flags": 0,
      "text": "Team Rocket must be after the Master Ball,\\na Poké Ball that’s guaranteed to catch\\r\\nany Pokémon!\\c\\nI bet they’re going to make us make lots of\\nMaster Balls for them to use..."
    },
    {
      "index": 3,
      "id": "msg_t011r0407_staffm_02_02",
      "hash": "1115a8dc94e43a46",
      "flags": 0,
      "text": "We canceled the Master Ball project because of\\nTeam Rocket."
    },
    {
      "index": 4,
      "id": "msg_t011r0407_staffm_03_01",
      "hash": "0e26fbd76c64647e",
      "flags": 4,
      "text": "It’ll be bad if Team Rocket gets complete\\ncontrol of Silph and our Pokémon..."
    },
    {
      "index": 5,
      "id": "msg_t011r0407_staffm_03_02",
      "hash": "0e26fad76c6462cb",
      "flags": 0,
      "text": "Wow!\\c\\nYou chased off Team Rocket?"
    },
    {
      "index": 6,
      "id": "msg_t011r0407_stafff_01_01",
      "hash": "1df9a9528b42a8a9",
      "flags": 0,
      "text": "You!\\nIt’s really dangerous here!\\c\\nYou came to save me?\\nYou can’t!"
    },
    {
      "index": 7,
      "id": "msg_t011r0407_stafff_01_02",
      "hash": "1df9a6528b42a390",
      "flags": 0,
      "text": "Thank you so much!"
    },
    {
      "index": 8,
      "id": "msg_t011r0407_kanban_01",
      "hash": "cef63d77c514c564",
      "flags": 0,
      "text": "“Silph Co. Head Office\\n7F”"
    }
  ],
