  "lines": [
    {
      "index": 0,
      "id": "msg_town005_kanban_01",
      "hash": "e9b56ce052d8e502",
      "flags": 0,
      "text": "Lavender Town:\\nThe Noble Purple Town"
    },
    {
      "index": 1,
      "id": "msg_town005_kanban_02",
      "hash": "e9b56be052d8e34f",
      "flags": 0,
      "text": "Make the Invisible Plain to See!\\nGet the new Silph Scope!     — Silph Co."
    },
    {
      "index": 2,
      "id": "msg_town005_kanban_03",
      "hash": "e9b56ae052d8e19c",
      "flags": 0,
      "text": "Pokémon House:\\nWhere Love Is Volunteered Freely"
    },
    {
      "index": 3,
      "id": "msg_town005_kanban_04",
      "hash": "e9b569e052d8dfe9",
      "flags": 0,
      "text": "Pokémon Tower:\\nBecalm the Spirits of Pokémon"
    },
    {
      "index": 4,
      "id": "msg_town005_juveniles_01_01",
      "hash": "dd108a5f7ce63432",
      "flags": 0,
      "text": "Do you believe in ghosts?"
    },
    {
      "index": 5,
      "id": "msg_town005_juveniles_01_02",
      "hash": "dd10895f7ce6327f",
      "flags": 0,
      "text": "Really?\\nSo there are believers..."
    },
    {
      "index": 6,
      "id": "msg_town005_juveniles_01_03",
      "hash": "dd10885f7ce630cc",
      "flags": 0,
      "text": "Hahaha, I guess not.\\c\\nThat white hand on your shoulder...\\nI’m just imagining it."
    },
    {
      "index": 7,
      "id": "msg_town005_adultm_01",
      "hash": "85160d0b0641adba",
      "flags": 0,
      "text": "This town is famous for all of the graves made\\nhere for Pokémon...\\c\\nThey hold memorial services in the Pokémon\\nTower for Pokémon that have passed away."
    },
    {
      "index": 8,
      "id": "msg_town005_youngm_01",
      "hash": "992c8d4ceabdd3c2",
      "flags": 0,
      "text": "There’s talk about ghosts appearing lately in\\nthe Pokémon Tower.\\c\\nI think they’re the spirits of Pokémon kidnapped\\nby Team Rocket and never seen again..."
    },
    {
      "index": 9,
      "id": "msg_town005_oldf_01",
      "hash": "2d0312137a06f17c",
      "flags": 4,
      "text": "Ahhh...\\nThe smell of incense is so refreshing."
    },
    {
      "index": 10,
      "id": "msg_town005_poke_01",
      "hash": "575f74472b704770",
      "flags": 0,
      "text": "NIDORAN♀: Dorann."
    },
    {
      "index": 11,
      "id": "msg_town005_childf_01",
      "hash": "e3b08901e734d73f",
      "flags": 0,
      "text": "Don’t go disturbing things in the Pokémon Tower!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_town005_max",
