{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub006_oldm_01",
      "hash": "6b7f95cf983378ea",
      "flags": 4,
      "text": "Uh... I...I’m...\\nWho in the world am I...?\\c\\nBah, it’s no use. I can’t remember anything..."
    },
    {
      "index": 1,
      "id": "msg_sub006_oldm_02",
      "hash": "6b7f94cf98337737",
      "flags": 0,
      "text": "Hm? Do you think you could tell me who I\\nmight be?"
    },
    {
      "index": 2,
      "id": "msg_sub006_select_01",
      "hash": "e6cb1b343fe19c5a",
      "flags": 0,
      "text": "Move Deleter"
    },
    {
      "index": 3,
      "id": "msg_sub006_select_02",
      "hash": "e6cb1a343fe19aa7",
      "flags": 0,
      "text": "Mr. Dazzling"
    },
    {
      "index": 4,
      "id": "msg_sub006_select_03",
      "hash": "e6cb19343fe198f4",
      "flags": 4,
      "text": "I don’t know"
    },
    {
      "index": 5,
      "id": "msg_sub006_oldm_03",
      "hash": "6b7f93cf98337584",
      "flags": 4,
      "text": "I’m the Move Deleter...?\\c\\nCould that be...?\\nNo, no, it just doesn’t feel right..."
    },
    {
      "index": 6,
      "id": "msg_sub006_oldm_04",
      "hash": "6b7f92cf983373d1",
      "flags": 4,
      "text": "Ah, don’t mind me! Sorry to bother you with such\\nan odd question."
    },
    {
      "index": 7,
      "id": "msg_sub006_oldm_05",
      "hash": "6b7f91cf9833721e",
      "flags": 4,
      "text": "I’m Mr. Dazzling...?!\\c\\nThat has such a wonderful ring to it!\\nMr. Dazzling!\\c\\nYou must be right! I’m Mr. Dazzling!"
    },
    {
      "index": 8,
      "id": "msg_sub006_oldm_06",
      "hash": "6b7f90cf9833706b",
      "flags": 0,
      "text": "Well, you helped me remember, so...here!"
    },
    {
      "index": 9,
      "id": "msg_sub006_oldm_07",
      "hash": "6b7f8fcf98336eb8",
      "flags": 0,
      "text": "TM32 is for Dazzling Gleam! It’s a Fairy-type\\nmove—something that’s hard to find in Kanto!"
    },
    {
      "index": 10,
      "id": "msg_sub006_oldm_08_nouse",
      "hash": "e921fd87e71bdb7c",
      "flags": 0,
      "text": "[~ 10]"
