{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "fe_amai_msg00",
      "hash": "7a6591e7fa5270a7",
      "flags": 0,
      "text": "Looks like there’s nothing here..."
    },
    {
      "index": 1,
      "id": "msg_kagu1_bg",
      "hash": "cdf3b18078b3f908",
      "flags": 0,
      "text": "Dishes and plates are neatly lined up."
    },
    {
      "index": 2,
      "id": "msg_kagu2_bg",
      "hash": "a0b3a17a163fa0e3",
      "flags": 4,
      "text": "It smells delicious!\\nSomebody must have cooked here earlier."
    },
    {
      "index": 3,
      "id": "msg_kagu3_bg",
      "hash": "c9eb816ecbc1f832",
      "flags": 4,
      "text": "It’s a nicely made dresser.\\nIt will hold a lot of stuff."
    },
    {
      "index": 4,
      "id": "msg_kagu4_bg",
      "hash": "730c41672ff1c605",
      "flags": 0,
      "text": "There’s a pile of snacks here."
    },
    {
      "index": 5,
      "id": "msg_kagu5_bg",
      "hash": "49245160d0548fe4",
      "flags": 4,
      "text": "It’s a pretty picture of a Pokémon.\\nIt looks like it’s feeling good."
    },
    {
      "index": 6,
      "id": "msg_kagu6_bg",
      "hash": "9b158156be707c7f",
      "flags": 0,
      "text": "What could this machine be?\\nBetter not mess around with it!"
    },
    {
      "index": 7,
      "id": "msg_kagu7_bg",
      "hash": "712e91505ed4f95e",
      "flags": 4,
      "text": "It’s a telephone.\\nBetter not use it."
    },
    {
      "index": 8,
      "id": "msg_kagu8_bg",
      "hash": "03f0b1cd88a71721",
      "flags": 4,
      "text": "It’s an advertising poster about all kinds\\nof products."
    },
    {
      "index": 9,
      "id": "msg_kagu9_bg",
      "hash": "2d2881c23e295340",
      "flags": 4,
      "text": "Oh, that smells tasty!\\nIt might get the stomach growling!"
    },
    {
      "index": 10,
      "id": "msg_kagu10_bg",
      "hash": "2900f7fa1e970ca4",
      "flags": 4,
      "text": "Inside this...\\n...\\c\\nThere’s nothing inside!"
    },
    {
      "index": 11,
      "id": "msg_kagu11_bg",
      "hash": "ffc8e805691463c5",
      "flags": 4,
      "text": "It’s a cup with a Pokémon mark on it."
    },
    {
      "index": 12,
      "id": "msg_kagu12_bg",
      "hash": "510b37e9ad17761e",
      "flags": 0,
      "text": "The window is very well polished."
    },
    {
      "index": 13,
      "id": "msg_kagu13_bg",
      "hash": "27d327f4f794cd3f",
      "flags": 4,
      "text": "Outside the window...\\nthe sky looks fantastically beautiful."
    },
    {
      "index": 14,
      "id": "msg_kagu14_bg",
      "hash": "574a581eaef36dc8",
      "flags": 0,
      "text": "Lights of different colors are flashing on and off."
    },
    {
      "index": 15,
      "id": "msg_kagu15_bg",
      "hash": "59600823d6bb57e9",
      "flags": 4,
      "text": "All sorts of tools are lined up neatly."
    },
    {
      "index": 16,
      "id": "msg_bouenkyou_01_p01_r011_r0102",
      "hash": "11249d7b557c7c93",
      "flags": 0,
      "text": "Let’s see what the binoculars have to show...\\c\\nA big Pokémon is asleep on a road!"
    },
    {
      "index": 17,
      "id": "msg_bouenkyou_01_p02_r011_r0102",
      "hash": "d0e85fd19bb0169c",
      "flags": 0,
      "text": "Let’s see what the binoculars have to show...\\c\\nWhat a breathtaking view!"
    },
    {
      "index": 18,
      "id": "msg_bouenkyou_02_p01_r011_r0102",
      "hash": "33193af75a560fb0",
      "flags": 0,
      "text": "Let’s see what the binoculars have to show...\\c\\nTo get to Lavender Town...going through\\nthe Rock Tunnel from Cerulean City appears to\\r\\nbe a good route to take."
    },
    {
      "index": 19,
      "id": "msg_bouenkyou_01_p01_r012_r0102",
      "hash": "2a2fd25bba926a22",
      "flags": 0,
      "text": "Let’s see what the binoculars have to show...\\c\\nThere’s a man fishing!"
    },
    {
      "index": 20,
      "id": "msg_bouenkyou_02_p01_r012_r0102",
      "hash": "1447c575cf496bf5",
      "flags": 0,
      "text": "Let’s see what the binoculars have to show...\\c\\nIt’s the Pokémon Tower!"
    },
    {
      "index": 21,
      "id": "msg_bouenkyou_01_p01_r015_r0102",
      "hash": "d7f7e45d55f7429f",
      "flags": 0,
      "text": "Let’s see what the binoculars have to show...\\c\\nA large, shining bird is flying toward the sea."
    },
    {
      "index": 22,
      "id": "msg_bouenkyou_02_p01_r015_r0102",
      "hash": "98836cfee336ff7c",
      "flags": 0,
      "text": "Let’s see what the binoculars have to show...\\c\\nIt looks like there’s a small island on the horizon!"
    },
    {
      "index": 23,
      "id": "msg_bouenkyou_01_p01_r016_r0202",
      "hash": "cea1afb32e7dc323",
      "flags": 0,
      "text": "Let’s see what the binoculars have to show...\\c\\nThat’s the Celadon Department Store!"
    },
    {
      "index": 24,
      "id": "msg_bouenkyou_02_p01_r016_r0202",
      "hash": "e85828a3f4702cc0",
      "flags": 0,
      "text": "Let’s see what the binoculars have to show...\\c\\nThere’s a long path over water far away."
    },
    {
      "index": 25,
      "id": "msg_bouenkyou_01_p01_r018_r0102",
      "hash": "f4dd8c32d544ae70",
      "flags": 0,
      "text": "Let’s see what the binoculars have to show...\\c\\nPallet Town is to the west."
    },
    {
      "index": 26,
      "id": "msg_bouenkyou_02_p01_r018_r0102",
      "hash": "4f604c3fda8dddd3",
      "flags": 0,
      "text": "Let’s see what the binoculars have to show...\\c\\nThere are people swimming."
    },
    {
      "index": 27,
      "id": "msg_sylph_door_01",
      "hash": "c36b343ea1a7c0f8",
      "flags": 0,
      "text": "Bingo!\\nThe Card Key opened the door!"
    },
    {
      "index": 28,
      "id": "msg_sylph_door_02",
      "hash": "c36b373ea1a7c611",
      "flags": 0,
      "text": "No!\\nYou need a Card Key to open the door!"
    },
    {
      "index": 29,
      "id": "msg_book_01_bg",
      "hash": "7bb6486bae7c5172",
      "flags": 4,
      "text": "It’s crammed full of Pokémon books."
    },
    {
      "index": 30,
      "id": "msg_townmap_01_bg",
      "hash": "0de10cb9a0a3d80b",
      "flags": 4,
      "text": "It’s a Town Map."
    },
    {
      "index": 31,
      "id": "msg_fsrack_01_bg",
      "hash": "6c92a1bfb5eb3e83",
      "flags": 0,
      "text": "Wow!\\nThere are tons of Pokémon stuff!"
    },
    {
      "index": 32,
      "id": "msg_fs_01_bg",
      "hash": "1df07aa8257f8e68",
      "flags": 0,
      "text": "We fulfill all of your item needs!\\nPokémon Mart"
    },
    {
      "index": 33,
      "id": "msg_pc_01_bg",
      "hash": "dfee76fbce4be542",
      "flags": 0,
      "text": "Heal your Pokémon!\\nPokémon Center"
    },
    {
      "index": 34,
      "id": "msg_freeze_01_bg",
      "hash": "8e164c7fbea26a00",
      "flags": 4,
      "text": "It should be packed with all kinds of delicious\\nthings to eat."
    },
    {
      "index": 35,
      "id": "msg_sekkeizu_01_bg",
      "hash": "fa393e9b9200f706",
      "flags": 4,
      "text": "It’s a blueprint of some sort.\\nIt’s filled with diagrams and text."
    },
    {
      "index": 36,
      "id": "msg_pc_02_bg",
      "hash": "37629715141fdcf9",
      "flags": 4,
      "text": "It’s all complicated words and numbers that\\nmake no sense..."
    },
    {
      "index": 37,
      "id": "msg_masaki_01_bg",
      "hash": "93d2d7a15f3e81dd",
      "flags": 4,
      "text": "It’s a machine of some sort.\\nIt sure looks impressive."
    },
    {
      "index": 38,
      "id": "msg_game_01_bg",
      "hash": "5cb767c46e41f135",
      "flags": 4,
      "text": "It’s the latest video game console!\\nIt sure looks fun!"
    },
    {
      "index": 39,
      "id": "msg_dorobou_01_bg",
      "hash": "a07f7a27a1a4b8e9",
      "flags": 0,
      "text": "There are obvious signs of burglary here..."
    },
    {
      "index": 40,
      "id": "msg_tv_01_bg",
      "hash": "bb6a7c7d0b1fc1b5",
      "flags": 0,
      "text": "There’s a Pokémon on TV!\\nIt looks like it’s having fun."
    },
    {
      "index": 41,
      "id": "msg_tv_02_bg",
      "hash": "8ca18c64fdd8eb8e",
      "flags": 0,
      "text": "You can see your face reflected on\\nthe TV screen!"
    },
    {
      "index": 42,
      "id": "msg_t007r0805_elevator_01",
      "hash": "6b7cd65aaddff314",
      "flags": 4,
      "text": "It appears that you need a key."
    },
    {
      "index": 43,
      "id": "msg_main_event_1100_switch_01",
      "hash": "ccd6e3039bca99fd",
      "flags": 0,
      "text": "You pushed a secret switch!"
    },
    {
      "index": 44,
      "id": "msg_main_event_1100_switch_04",
      "hash": "ccd6de039bca917e",
      "flags": 0,
      "text": "...You heard the sound of something\\nmoving somewhere."
    },
    {
      "index": 45,
      "id": "msg_main_event_1100_switch_02",
      "hash": "ccd6e0039bca94e4",
      "flags": 0,
      "text": "[~ 45]"
    },
    {
      "index": 46,
      "id": "msg_main_event_1100_switch_03",
      "hash": "ccd6e1039bca9697",
      "flags": 0,
      "text": "[~ 46]"
    },
    {
      "index": 47,
      "id": "msg_shop_bg_01",
      "hash": "3682ef731ccc848b",
      "flags": 0,
      "text": "There are items such as Potions and Repels."
    },
    {
      "index": 48,
      "id": "msg_shop_bg_02",
      "hash": "3682f0731ccc863e",
      "flags": 4,
      "text": "It’s chock-full of products!\\nSpeak to the clerk to buy them!"
    },
    {
      "index": 49,
      "id": "msg_kanban_bg_01",
      "hash": "ff617b40a90b04f0",
      "flags": 0,
      "text": "You can’t read the sign from the back!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_bg_event_max",
      "hash": "f825892cbb5f8bbe"
    }
  ]
}
