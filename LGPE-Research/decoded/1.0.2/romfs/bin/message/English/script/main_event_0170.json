{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0170_green_01",
      "hash": "45c432aa3fa8d7dc",
      "flags": 0,
      "text": "???: Hey, you there! Newbie!"
    },
    {
      "index": 1,
      "id": "msg_main0170_green_02",
      "hash": "45c435aa3fa8dcf5",
      "flags": 0,
      "text": "???: Don’t tell me...\\nYou’ve gotta be [VAR TRNAME(0000)], right?"
    },
    {
      "index": 2,
      "id": "msg_main0170_select_01",
      "hash": "d0d9c0d403d03387",
      "flags": 4,
      "text": "I am! That’s amazing!"
    },
    {
      "index": 3,
      "id": "msg_main0170_select_02",
      "hash": "d0d9c1d403d0353a",
      "flags": 0,
      "text": "How did you know that?!"
    },
    {
      "index": 4,
      "id": "msg_main0170_green_03",
      "hash": "45c434aa3fa8db42",
      "flags": 0,
      "text": "Ha, I knew it!\\nI’m always right."
    },
    {
      "index": 5,
      "id": "msg_main0170_green_04",
      "hash": "45c42faa3fa8d2c3",
      "flags": 0,
      "text": "’Cause you look just like my gramps said."
    },
    {
      "index": 6,
      "id": "msg_main0170_green_05",
      "hash": "45c42eaa3fa8d110",
      "flags": 0,
      "text": "BLUE: I’m Blue!\\c\\nI heard from my gramps that two new kids set\\nout from Pallet Town to become Trainers,\\r\\njust like I did once.\\r\\nSo I came to check you out!"
    },
    {
      "index": 7,
      "id": "msg_main0170_green_06",
      "hash": "45c431aa3fa8d629",
      "flags": 4,
      "text": "I was thinking you might want some advice on\\nhow to beat the Gym from an expert Trainer like\\r\\nme, but looks like I showed up too late, huh?"
    },
    {
      "index": 8,
      "id": "msg_main0170_green_11",
      "hash": "45c0aeaa3fa5c1b9",
      "flags": 0,
      "text": "Seems you’re not too shabby yourself...\\nSo I guess you’ve earned a reward, newbie!"
    },
    {
      "index": 9,
      "id": "msg_main0170_red_01",
      "hash": "cfe03f2037f8e3dc",
      "flags": 0,
      "text": "[~ 9]"
    },
    {
      "index": 10,
      "id": "msg_main0170_green_07",
      "hash": "45c430aa3fa8d476",
      "flags": 0,
      "text": "[~ 10]"
    },
    {
      "index": 11,
      "id": "msg_main0170_red_02",
      "hash": "cfe0422037f8e8f5",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_main0170_dummy_01",
      "hash": "ad78127e34c878c1",
      "flags": 0,
      "text": "You got 5 [VAR COLOR(0006)]Great Balls [VAR COLOR(0000)]from Blue!"
    },
    {
      "index": 13,
      "id": "msg_main0170_green_08",
      "hash": "45c43baa3fa8e727",
      "flags": 0,
      "text": "BLUE: Those’ll be even better for catching\\nPokémon than plain old Poké Balls.\\c\\nAnd hey, that thing you’ve got there...\\nThat’s a Pokédex, right?\\r\\nSo Gramps finally went and made one!"
    },
    {
      "index": 14,
      "id": "msg_main0170_green_09",
      "hash": "45c43aaa3fa8e574",
      "flags": 0,
      "text": "He used to make me just scribble on a map with\\na pencil about where I encountered Pokémon..."
    },
    {
      "index": 15,
      "id": "msg_main0170_green_10",
      "hash": "45c0adaa3fa5c006",
      "flags": 0,
      "text": "You’d better do a good job helping him out!\\nHe may be Professor Oak to you, and sure,\\r\\nhe’s an old coot, but he’s still my gramps!\\c\\nSmell ya later, newbie!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0170_max",
      "hash": "b5a50e9c59dc4e9f"
    }
  ]
}
