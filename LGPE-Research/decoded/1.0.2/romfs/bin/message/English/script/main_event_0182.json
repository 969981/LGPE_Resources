  "lines": [
    {
      "index": 0,
      "id": "msg_main0182_system_01",
      "hash": "1ff41051aba24839",
      "flags": 4,
      "text": "It’s a sleeping Pokémon!\\c\\nIt doesn’t seem like a Poké Ball will do very much\\nwhile it’s in this state..."
    },
    {
      "index": 1,
      "id": "msg_main0182_musashi_01",
      "hash": "c76cda6867f9118e",
      "flags": 0,
      "text": "???: Looks like there’s nothing here..."
    },
    {
      "index": 2,
      "id": "msg_main0182_kojiro_01",
      "hash": "d11dc9207a414f92",
      "flags": 0,
      "text": "???: Then let’s just search farther in!"
    },
    {
      "index": 3,
      "id": "msg_main0182_musashi_02",
      "hash": "c76cd96867f90fdb",
      "flags": 0,
      "text": "???: You! You were eavesdropping on us just\\nnow, weren’t you!"
    },
    {
      "index": 4,
      "id": "msg_main0182_kojiro_02",
      "hash": "d11dc8207a414ddf",
      "flags": 0,
      "text": "???: Meowth! You were supposed to be\\nkeeping watch!"
    },
    {
      "index": 5,
      "id": "msg_main0182_nyasu_01",
      "hash": "b13408a97285ce1a",
      "flags": 0,
      "text": "MEOWTH: Mrawr!"
    },
    {
      "index": 6,
      "id": "msg_main0182_musashi_03",
      "hash": "c76cd86867f90e28",
      "flags": 0,
      "text": "???: We know there’re rare Fossils buried around\\nhere somewhere!\\c\\nIf you’ve got any, you’d better hand them over\\nto us, twerp!"
    },
    {
      "index": 7,
      "id": "msg_main0182_kojiro_03",
      "hash": "d11dc7207a414c2c",
      "flags": 0,
      "text": "???: That’s right! If anyone is going to profit off\\nthose rare Fossils, it’s going to be us!"
    },
    {
      "index": 8,
      "id": "msg_main0182_musashi_04",
      "hash": "c76cdf6867f91a0d",
      "flags": 0,
      "text": "???: Wahahaha!"
    }
  ],
