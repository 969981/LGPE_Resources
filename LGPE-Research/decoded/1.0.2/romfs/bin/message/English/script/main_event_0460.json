    {
      "index": 1,
      "id": "msg_main_0460_nresercher_02",
      "hash": "b935a6e59962c484",
      "flags": 0,
      "text": "Remember me?\\nI’m one of Professor Oak’s assistants."
    },
    {
      "index": 2,
      "id": "msg_main_0460_nresercher_03",
      "hash": "b935a7e59962c637",
      "flags": 4,
      "text": "I’m so glad I ran into you!\\nWhy don’t I show you a neat trick?"
    },
    {
      "index": 3,
      "id": "msg_main_0460_nresercher_04",
      "hash": "b935a4e59962c11e",
      "flags": 4,
      "text": "Actually, no...\\nIt’s a little too bright out here."
    },
    {
      "index": 4,
      "id": "msg_main_0460_nresercher_05",
      "hash": "b935a5e59962c2d1",
      "flags": 4,
      "text": "Inside! I’ll be waiting inside to show you.\\nWhenever you’re ready, [VAR TRNAME(0000)]!"
    }
  ],
