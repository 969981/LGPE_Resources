  "lines": [
    {
      "index": 0,
      "id": "msg_sub030_oldm_01",
      "hash": "9c1b0e88768a8763",
      "flags": 0,
      "text": "Hello there!\\c\\nI’ve been watching you walk right past me this\\nwhole time, and I was hoping you’d come to visit\\r\\nme someday.\\c\\nI was really lonely...\\c\\nWhy did I make a pond right in front of\\nmy house...?"
    },
    {
      "index": 1,
      "id": "msg_sub030_oldm_02",
      "hash": "9c1b0f88768a8916",
      "flags": 0,
      "text": "Just going for a walk is troublesome.\\c\\nI was so shortsighted when I was young.\\nI was so stupid, stupid, stupid!"
    },
    {
      "index": 2,
      "id": "msg_sub030_oldm_05",
      "hash": "9c1b1288768a8e2f",
      "flags": 4,
      "text": "I was such an idiot!"
    },
    {
      "index": 3,
      "id": "msg_sub030_oldm_03",
      "hash": "9c1b1088768a8ac9",
      "flags": 0,
      "text": "...Phew!\\nSorry for my toxic venting, but I feel better now.\\c\\nSo I’ll give you a TM!"
    },
    {
      "index": 4,
      "id": "msg_sub030_oldm_04",
      "hash": "9c1b1188768a8c7c",
      "flags": 0,
      "text": "TM26 contains Poison Jab, a scary toxic move!\\nIt’s more toxic than my venting.\\c\\nIt stabs the opponent with a poisonous arm and\\nmay poison the opponent!"
    },
    {
      "index": 5,
      "id": "msg_oldman2_01_p01_field_t007",
      "hash": "6065cfdb406f48f9",
      "flags": 0,
      "text": "[~ 5]"
    },
