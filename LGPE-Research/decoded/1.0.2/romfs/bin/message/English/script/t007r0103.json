{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t007r0103_scientist_01",
      "hash": "160a4eebc1bd9357",
      "flags": 0,
      "text": "Me?\\nI’m a programmer!"
    },
    {
      "index": 1,
      "id": "msg_t007r0103_scientist_02",
      "hash": "160a4febc1bd950a",
      "flags": 0,
      "text": "Did you complete your Pokédex?!\\nGreat! It was worth programming it!"
    },
    {
      "index": 2,
      "id": "msg_t007r0103_pokemaniac_01",
      "hash": "d0e147c02ee4a3e1",
      "flags": 4,
      "text": "I’m a graphic artist!\\nI’m the one who designed you!"
    },
    {
      "index": 3,
      "id": "msg_t007r0103_pokemaniac_02",
      "hash": "d0e144c02ee49ec8",
      "flags": 0,
      "text": "Congratulations on completing your Pokédex!\\nYou really look like you’ve grown and matured!\\c\\nActually your model hasn’t changed at all, has it?\\n...Er, never mind! Don’t mind me!"
    },
    {
      "index": 4,
      "id": "msg_t007r0103_fat_01",
      "hash": "cf07f2d5d4ec7ae4",
      "flags": 4,
      "text": "I wrote the story!\\nHey, tell me... Don’t you think Erika is cute?\\c\\nI like Misty a lot, too!\\nOh, and Sabrina! I like her, too!"
    },
    {
      "index": 5,
      "id": "msg_t007r0103_fat_02",
      "hash": "cf07f5d5d4ec7ffd",
      "flags": 0,
      "text": "You completed your Pokédex? Impressive!\\c\\nBut you still have a long way to go...\\c\\nJust kidding!"
    },
    {
      "index": 6,
      "id": "msg_t007r0103_pc_01",
      "hash": "63199b91d2e25468",
      "flags": 4,
      "text": "It’s the game code!\\nMessing with it could bug out the game!"
    },
    {
      "index": 7,
      "id": "msg_t007r0103_pc_02",
      "hash": "63199e91d2e25981",
      "flags": 0,
      "text": "Someone’s playing a game instead of working!"
    },
    {
      "index": 8,
      "id": "msg_t007r0103_pc_03",
      "hash": "63199d91d2e257ce",
      "flags": 4,
      "text": "It’s the script!\\nBetter not look at the ending!"
    },
    {
      "index": 9,
      "id": "msg_t007r0103_kanban_01",
      "hash": "9c6261ad153e9606",
      "flags": 0,
      "text": "GAME FREAK Development Office"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t007r0103_max",
      "hash": "ed0678f20184083b"
    }
  ]
}
