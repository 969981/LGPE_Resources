{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0730_rocketchief_01",
      "hash": "9e258dee4a30c3a0",
      "flags": 0,
      "text": "???: Just one look at this Silph Scope, and it’s\\nplain to see..."
    },
    {
      "index": 1,
      "id": "msg_main0730_rocketchief_02",
      "hash": "9e2590ee4a30c8b9",
      "flags": 0,
      "text": "Silph Co. definitely has the technology and\\nskill Team Rocket will need to make our wishes\\r\\ncome true."
    },
    {
      "index": 2,
      "id": "msg_main0730_rocketboss_01",
      "hash": "e707943c02420ee2",
      "flags": 0,
      "text": "???: Hmph...\\c\\nA machine that lets you see what otherwise\\ncannot be seen...\\c\\nIt’s nothing but a useless toy.\\c\\nStill..."
    },
    {
      "index": 3,
      "id": "msg_main0730_rocketboss_02",
      "hash": "e707933c02420d2f",
      "flags": 0,
      "text": "Yes, this could do.\\c\\nCarry on, Archer, with your plans to take over\\nSilph Co. for Team Rocket."
    },
    {
      "index": 4,
      "id": "msg_main0730_rocketchief_03",
      "hash": "9e258fee4a30c706",
      "flags": 0,
      "text": "???: Yes, sir!"
    },
    {
      "index": 5,
      "id": "msg_main0730_rocketchief_04",
      "hash": "9e2592ee4a30cc1f",
      "flags": 0,
      "text": "What is a child doing here?"
    },
    {
      "index": 6,
      "id": "msg_main0730_rocketchief_05",
      "hash": "9e2591ee4a30ca6c",
      "flags": 0,
      "text": "You listened in on our conversation without\\nsaying a word?\\r\\nI don’t much care for that."
    },
    {
      "index": 7,
      "id": "msg_main0730_rocketchief_06",
      "hash": "9e2594ee4a30cf85",
      "flags": 4,
      "text": "I am Archer, an Admin of Team Rocket.\\c\\nAnd I do not go easy even on children!"
    },
    {
      "index": 8,
      "id": "msg_main0730_dummy_01",
      "hash": "667ff12551a51f6b",
      "flags": 0,
      "text": "[~ 8]"
    },
    {
      "index": 9,
      "id": "msg_main0730_rocketchief_07",
      "hash": "9e2593ee4a30cdd2",
      "flags": 4,
      "text": "ARCHER: F-forgive me, Giovanni...\\c\\nFor me to be defeated by a simple child..."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0730_max",
