  "lines": [
    {
      "index": 0,
      "id": "msg_t005r0101_youngm_01",
      "hash": "5a81f7f43e3646ca",
      "flags": 0,
      "text": "That’s odd... Mr. Fuji isn’t here.\\nWhere’d he go?"
    },
    {
      "index": 1,
      "id": "msg_t005r0101_youngm_02",
      "hash": "5a81f6f43e364517",
      "flags": 0,
      "text": "Mr. Fuji went to try to bring some peace to the\\nghost of that Marowak."
    },
    {
      "index": 2,
      "id": "msg_t005r0101_juveniles_01",
      "hash": "b3092b7e97f4b1c8",
      "flags": 0,
      "text": "This place is actually Mr. Fuji’s home.\\nHe’s really kind.\\c\\nHe looks after Pokémon that’ve been abandoned\\nor orphaned."
    },
    {
      "index": 3,
      "id": "msg_t005r0101_juveniles_02",
      "hash": "b3092e7e97f4b6e1",
      "flags": 4,
      "text": "Ahhh, it’s so warm!\\nPokémon are so cuddly and nice to hug!"
    },
    {
      "index": 4,
      "id": "msg_t005r0101_poke_01",
      "hash": "0385607c405e4cb8",
      "flags": 0,
      "text": "NIDORINO: Gahohhh!"
    },
    {
      "index": 5,
      "id": "msg_t005r0101_poke_02",
      "hash": "0385637c405e51d1",
      "flags": 0,
      "text": "PSYDUCK: Gwack!"
    },
    {
      "index": 6,
      "id": "msg_book_01_p01_t005_r0101",
      "hash": "687235c0f3f98ae7",
      "flags": 0,
      "text": "You could win the Grand Prize Drawing given\\nout by the Pokémon Fan Magazine!\\c\\nThe application form is...\\c\\nGone! It’s already been clipped out."
    },
    {
      "index": 7,
      "id": "msg_book_02_p01_t005_r0101",
      "hash": "b162f14ffbd91cd8",
      "flags": 0,
      "text": "There are Pokémon magazines on the shelves.\\c\\nAnd Pokémon notebooks...\\c\\nAnd Pokémon graphs, too!"
    }
  ],
