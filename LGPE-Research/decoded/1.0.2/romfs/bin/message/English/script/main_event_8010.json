{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8010_water_01",
      "hash": "eb0270625db7e4cb",
      "flags": 0,
      "text": "MISTY: Hi! You’re a new face!"
    },
    {
      "index": 1,
      "id": "msg_main8010_water_05",
      "hash": "eb0274625db7eb97",
      "flags": 0,
      "text": "What’s your policy on Pokémon?\\nWhat’s your approach?"
    },
    {
      "index": 2,
      "id": "msg_main8010_water_06",
      "hash": "eb0275625db7ed4a",
      "flags": 0,
      "text": "My policy for battle is...\\c\\nan all-out offensive with Water-type Pokémon!"
    },
    {
      "index": 3,
      "id": "msg_main8010_water_07",
      "hash": "eb0276625db7eefd",
      "flags": 0,
      "text": "Misty, the world-famous beauty, is your host!"
    },
    {
      "index": 4,
      "id": "msg_main8010_water_08",
      "hash": "eb0267625db7d580",
      "flags": 0,
      "text": "My sweet Pokémon are ready!\\nAre you?"
    },
    {
      "index": 5,
      "id": "msg_gymleader_02_01",
      "hash": "727c3d2a1a30cc28",
      "flags": 0,
      "text": "[~ 5]"
    },
    {
      "index": 6,
      "id": "msg_gymleader_02_06",
      "hash": "727c442a1a30d80d",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main8010_water_02",
      "hash": "eb0271625db7e67e",
      "flags": 0,
      "text": "MISTY: All right, you can have a Cascade Badge\\nto show that you beat me."
    },
    {
      "index": 8,
      "id": "msg_main8010_sys_01",
      "hash": "fa93f3e6a1687f4d",
      "flags": 0,
      "text": "You got a [VAR COLOR(0006)]Cascade Badge[VAR COLOR(0000)] from Misty!"
    },
    {
      "index": 9,
      "id": "msg_main8010_water_03",
      "hash": "eb0272625db7e831",
      "flags": 0,
      "text": "MISTY: A Cascade Badge makes Pokémon\\nup to Lv. 30 from other Trainers listen to you.\\c\\nAnd you can also have my favorite TM!"
    },
    {
      "index": 10,
      "id": "msg_main8010_sys_02",
      "hash": "fa93f0e6a1687a34",
      "flags": 0,
      "text": "You got [VAR ITEM2(0001)] [VAR COLOR(0006)][VAR MOVE(0002)][VAR COLOR(0000)] from Misty!"
    },
    {
      "index": 11,
      "id": "msg_main8010_water_04",
      "hash": "eb0273625db7e9e4",
      "flags": 0,
      "text": "MISTY: TM29 teaches Pokémon the move Scald.\\nUse it on a Pokémon that lives in the water!"
    },
    {
      "index": 12,
      "id": "msg_gymleader_02_05",
      "hash": "727c412a1a30d2f4",
      "flags": 0,
      "text": "[~ 12]"
    },
    {
      "index": 13,
      "id": "msg_gymleader_02_02",
      "hash": "727c402a1a30d141",
      "flags": 0,
      "text": "[~ 13]"
    },
    {
      "index": 14,
      "id": "msg_gymleader_02_03",
      "hash": "727c3f2a1a30cf8e",
      "flags": 0,
      "text": "[~ 14]"
