{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main1300_rival_01",
      "hash": "76a38f0c21048f9d",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: [VAR TRNAME(0000)]!"
    },
    {
      "index": 1,
      "id": "msg_main1300_rival_02",
      "hash": "76a38c0c21048a84",
      "flags": 4,
      "text": "I finally caught up to you!\\c\\nI got an Earth Badge, too!\\c\\nThat means we can finally get into\\nthe Pokémon League!"
    },
    {
      "index": 2,
      "id": "msg_main1300_rival_03",
      "hash": "76a38d0c21048c37",
      "flags": 4,
      "text": "I heard the Elite Four are incredibly strong...\\nBut there’s no turning back now, right?"
    },
    {
      "index": 3,
      "id": "msg_main1300_rival_06",
      "hash": "76a3880c210483b8",
      "flags": 0,
      "text": "You think you’re ready, [VAR TRNAME(0000)]?\\c\\nShow me the Pokémon you’ve raised!"
    },
    {
      "index": 4,
      "id": "msg_main1300_rival_04",
      "hash": "76a38a0c2104871e",
      "flags": 0,
      "text": "You know, [VAR TRNAME(0000)]...\\nI’ve always felt like I needed to look after you,\\r\\never since we were young.\\c\\nBut I think... I think you’re the one who has\\nmore talent as a Trainer."
    },
    {
      "index": 5,
      "id": "msg_main1300_rival_05",
      "hash": "76a38b0c210488d1",
      "flags": 4,
      "text": "It’s...frustrating.\\nI’ve never felt this way before.\\c\\nIs this what makes it fun to raise Pokémon?"
    },
    {
      "index": 6,
      "id": "msg_main1300_rival_07",
      "hash": "76a3890c2104856b",
      "flags": 0,
      "text": "Whatever it is, I know I don’t want to lose again!"
    },
    {
      "index": 7,
      "id": "msg_main1300_rival_08",
      "hash": "76a3860c21048052",
      "flags": 4,
      "text": "It’s weird to even have to ask, but...\\nlet me go on ahead first!"
    },
    {
      "index": 8,
      "id": "msg_rival_01_p05_field_r022",
      "hash": "da4688279a72feb1",
      "flags": 0,
      "text": "[~ 8]"
    },
    {
