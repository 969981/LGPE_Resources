  "lines": [
    {
      "index": 0,
      "id": "msg_main0920_rocketchief_01",
      "hash": "9d82bf08a6225dfd",
      "flags": 4,
      "text": "ARCHER: That’s far enough!"
    },
    {
      "index": 1,
      "id": "msg_main0920_rival_01",
      "hash": "eea065068af47a9a",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: Wha—?! You again?!"
    },
    {
      "index": 2,
      "id": "msg_main0920_rocketchief_02",
      "hash": "9d82bc08a62258e4",
      "flags": 4,
      "text": "ARCHER: Me again. As many times as it takes.\\c\\nI will not let you reach the boss!"
    },
    {
      "index": 3,
      "id": "msg_main0920_rival_02",
      "hash": "eea064068af478e7",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: ...Huh?\\nWhat was that? Reach the boss?"
    },
    {
      "index": 4,
      "id": "msg_main0920_rival_03",
      "hash": "eea063068af47734",
      "flags": 0,
      "text": "[VAR TRNAME(0000)], d’you think—?!"
    },
    {
      "index": 5,
      "id": "msg_main0920_select_01",
      "hash": "a495754c28984226",
      "flags": 0,
      "text": "He’s right up ahead!"
    },
    {
      "index": 6,
      "id": "msg_main0920_select_02",
      "hash": "a495744c28984073",
      "flags": 0,
      "text": "Giovanni must be here!"
    },
    {
      "index": 7,
      "id": "msg_main0920_rival_04",
      "hash": "eea062068af47581",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: So the boss of Team Rocket\\nis right here in this building!\\c\\nThat makes things easier, then!"
    },
    {
      "index": 8,
      "id": "msg_main0920_rival_05",
      "hash": "eea061068af473ce",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: Go, [VAR TRNAME(0000)]!\\nThis is our best chance to beat their boss!"
    },
    {
      "index": 9,
      "id": "msg_main0920_rival_06",
      "hash": "eea060068af4721b",
      "flags": 4,
      "text": "Old man, you’ll be dealing with me!"
    },
    {
      "index": 10,
      "id": "msg_main0920_rocketchief_03",
      "hash": "9d82bd08a6225a97",
      "flags": 4,
      "text": "ARCHER: Ugh!\\nI don’t have time for this! I must warn the boss!"
    },
    {
      "index": 11,
      "id": "msg_main0920_rival_07",
      "hash": "eea05f068af47068",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: [VAR TRNAME(0000)], go!\\c\\nGo beat the Team Rocket boss once and for all!"
    },
    {
