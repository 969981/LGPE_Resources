    {
      "index": 2,
      "id": "msg_sub027_clerkm_02",
      "hash": "702f97ce8afd0e3a",
      "flags": 0,
      "text": "TM03 is Helping Hand!\\c\\nHelping Hand will boost the power of an ally’s\\nattacks during a battle."
