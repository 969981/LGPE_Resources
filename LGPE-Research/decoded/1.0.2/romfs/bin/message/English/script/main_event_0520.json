  "lines": [
    {
      "index": 0,
      "id": "msg_main0520_rival_01",
      "hash": "4e6d4b14c82cf186",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: Cubone! Cuuubone!\\nCome out...come out...wherever you are!"
    },
    {
      "index": 1,
      "id": "msg_main0520_rival_02",
      "hash": "4e6d4a14c82cefd3",
      "flags": 4,
      "text": "I don’t see any sign of it..."
    },
    {
      "index": 2,
      "id": "msg_main0520_rival_05",
      "hash": "4e6d4f14c82cf852",
      "flags": 0,
      "text": "...Huh?\\c\\nIs that...?"
    },
    {
      "index": 3,
      "id": "msg_main0520_rival_03",
      "hash": "4e6d4914c82cee20",
      "flags": 4,
      "text": "I-it’s a...\\c\\nIt’s a... It’s a...\\c\\nGh-gh-gh-gho..."
    },
    {
      "index": 4,
      "id": "msg_main0520_rival_04",
      "hash": "4e6d5014c82cfa05",
      "flags": 0,
      "text": "GHOOOOOOSSST!!!\\nYAAAAAARRRGGGHHHHHH!!!"
    },
    {
      "index": 5,
      "id": "msg_main0520_karakara_01",
      "hash": "17b6e360cc60349a",
      "flags": 0,
      "text": "CUBONE: Mee! Mee!"
    },
    {
      "index": 6,
      "id": "msg_main0520_karakara_02",
      "hash": "17b6e260cc6032e7",
      "flags": 0,
      "text": "CUBONE: Ma—!"
    },
    {
      "index": 7,
      "id": "msg_main0520_sys_02",
      "hash": "1d7d732f937b4c0c",
      "flags": 0,
      "text": "Cubone sadly trudged away down the stairs..."
    },
    {
      "index": 8,
      "id": "msg_main0520_ghost_01",
      "hash": "a2819e116675adf3",
      "flags": 0,
      "text": "GHOST: Get out...\\nBegone..."
    },
    {
      "index": 9,
      "id": "msg_main0520_sys_01",
      "hash": "1d7d762f937b5125",
      "flags": 0,
      "text": "You were sent back to 1F!"
    },
    {
      "index": 10,
      "id": "msg_main0520_garagara_01",
      "hash": "9389215f33b09c32",
      "flags": 0,
      "text": "Begone...\\nintruders..."
    },
    {
      "index": 11,
      "id": "msg_main0520_partner_a_01",
      "hash": "96b12953d45c8fd4",
      "flags": 0,
      "text": "Pi..."
    },
    {
      "index": 12,
      "id": "msg_main0520_partner_b_01",
      "hash": "c12f21488af3d28b",
      "flags": 0,
      "text": "Vee..."
    },
    {
      "index": 13,
      "id": "msg_main0520_system_01",
      "hash": "5a9ae2a108e3b4cd",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] is trembling in fear.\\nIt won’t let you take another step forward!"
    }
  ],
