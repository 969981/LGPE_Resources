{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub087_middle_f_01",
      "hash": "69183b2fbfcbb2c9",
      "flags": 4,
      "text": "Oh dear, what am I supposed to do\\nwith you, Slowpoke?"
    },
    {
      "index": 1,
      "id": "msg_sub087_middle_f_02",
      "hash": "6918382fbfcbadb0",
      "flags": 4,
      "text": "Oh, hello there.\\nDo you think you could do me a favor?"
    },
    {
      "index": 2,
      "id": "msg_sub087_middle_f_03",
      "hash": "6918392fbfcbaf63",
      "flags": 4,
      "text": "Oh, of course, you must be busy.\\nSorry to have bothered you."
    },
    {
      "index": 3,
      "id": "msg_sub087_middle_f_04",
      "hash": "69183e2fbfcbb7e2",
      "flags": 4,
      "text": "I want to go to the Pewter museum, but my\\ndear Slowpoke here is just refusing to budge!"
    },
    {
      "index": 4,
      "id": "msg_sub087_yadon_01",
      "hash": "f0f118be8033672a",
      "flags": 0,
      "text": "SLOWPOKE: Poooooke..."
    },
    {
      "index": 5,
      "id": "msg_sub087_middle_f_05",
      "hash": "69183f2fbfcbb995",
      "flags": 0,
      "text": "Do you think you could keep an eye on\\nmy dear Slowpoke for a little while?"
    },
    {
      "index": 6,
      "id": "msg_sub087_middle_f_09",
      "hash": "6918432fbfcbc061",
      "flags": 0,
      "text": "Why, hello! Do you think you could keep an eye\\non Slowpoke again?"
    },
    {
      "index": 7,
      "id": "msg_sub087_select_01",
      "hash": "087a940740025655",
      "flags": 0,
      "text": "Sure!"
    },
    {
      "index": 8,
      "id": "msg_sub087_select_02",
      "hash": "087a91074002513c",
      "flags": 0,
      "text": "Sorry, but..."
    },
    {
      "index": 9,
      "id": "msg_sub087_middle_f_06",
      "hash": "69183c2fbfcbb47c",
      "flags": 4,
      "text": "Oh, thank you very much!\\c\\nIn that case, please keep my dear Slowpoke\\ncompany for a little while."
    },
    {
      "index": 10,
      "id": "msg_sub087_yadon_02",
      "hash": "f0f117be80336577",
      "flags": 0,
      "text": "... ... ...\\n... ... ..."
    },
    {
      "index": 11,
      "id": "msg_sub087_system_01",
      "hash": "a2604769f3459b22",
      "flags": 0,
      "text": "Slowpoke is staring blankly ahead..."
    },
    {
      "index": 12,
      "id": "msg_sub087_system_02",
      "hash": "a2604669f345996f",
      "flags": 0,
      "text": "Slowpoke seems very good at doing nothing..."
    },
    {
      "index": 13,
      "id": "msg_sub087_system_03",
      "hash": "a2604569f34597bc",
      "flags": 0,
      "text": "Slowpoke is just contentedly sitting there..."
    },
    {
      "index": 14,
      "id": "msg_sub087_system_04",
      "hash": "a2604469f3459609",
      "flags": 0,
      "text": "Slowpoke looks like it’s thinking\\nabout something..."
    },
    {
      "index": 15,
      "id": "msg_sub087_system_05",
      "hash": "a2604369f3459456",
      "flags": 0,
      "text": "Slowpoke seems to have only just noticed you..."
    },
    {
      "index": 16,
      "id": "msg_sub087_system_06",
      "hash": "a2604269f34592a3",
      "flags": 0,
      "text": "Slowpoke is looking at you from the corner\\nof its eye..."
    },
    {
      "index": 17,
      "id": "msg_sub087_system_07",
      "hash": "a2604169f34590f0",
      "flags": 0,
      "text": "Slowpoke seems just a little wary of you..."
    },
    {
      "index": 18,
      "id": "msg_sub087_system_08",
      "hash": "a2605069f345aa6d",
      "flags": 0,
      "text": "Slowpoke seems to be getting used to you..."
    },
    {
      "index": 19,
      "id": "msg_sub087_system_09",
      "hash": "a2604f69f345a8ba",
      "flags": 0,
      "text": "Slowpoke seems a little happy..."
    },
    {
      "index": 20,
      "id": "msg_sub087_system_10",
      "hash": "a25cc269f342834c",
      "flags": 0,
      "text": "Slowpoke seems like it’s happy to spend\\ntime with you!"
    },
    {
      "index": 21,
      "id": "msg_sub087_system_11",
      "hash": "a25cc369f34284ff",
      "flags": 0,
      "text": "You spent a relaxing time with Slowpoke!"
    },
    {
      "index": 22,
      "id": "msg_sub087_middle_f_07",
      "hash": "69183d2fbfcbb62f",
      "flags": 0,
      "text": "Thank you for keeping an eye on dear Slowpoke!\\nHere, this is for your trouble."
    },
    {
      "index": 23,
      "id": "msg_sub087_system_12",
      "hash": "a25cc469f34286b2",
      "flags": 0,
      "text": "You got a [VAR ITEM2(0001)] from the lady!"
    },
    {
      "index": 24,
      "id": "msg_sub087_middle_f_08",
      "hash": "6918422fbfcbbeae",
      "flags": 4,
      "text": "I would love it if you could keep an eye on\\nSlowpoke again sometime."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_087_max",
      "hash": "48df59edae2527ff"
    }
  ]
}
