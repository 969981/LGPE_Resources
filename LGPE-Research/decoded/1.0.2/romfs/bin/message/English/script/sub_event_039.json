  "lines": [
    {
      "index": 0,
      "id": "msg_sub039_policef_01",
      "hash": "426534fabe078478",
      "flags": 4,
      "text": "I just caught a Squirtle that was always getting\\ninto mischief.\\c\\nI think it needs a good Trainer to set it straight."
    },
    {
      "index": 1,
      "id": "msg_sub039_policef_06",
      "hash": "42653bfabe07905d",
      "flags": 0,
      "text": "Wow, you’ve caught [VAR NUM9(0000,002C)] Pokémon!"
    },
    {
      "index": 2,
      "id": "msg_sub039_policef_02",
      "hash": "426537fabe078991",
      "flags": 0,
      "text": "You must be a great Trainer!\\c\\nI have a favor to ask you. Would you take care\\nof this troublesome Squirtle?"
    },
    {
      "index": 3,
      "id": "msg_sub039_policef_03",
      "hash": "426536fabe0787de",
      "flags": 4,
      "text": "OK! Please take good care of Squirtle!"
    },
    {
      "index": 4,
      "id": "msg_sub039_policef_07",
      "hash": "42653afabe078eaa",
      "flags": 0,
      "text": "How about I talk to you about it when you’ve\\ncaught at least [VAR NUM3(0000)] Pokémon..."
    },
    {
      "index": 5,
      "id": "msg_sub039_policef_04",
      "hash": "426539fabe078cf7",
      "flags": 4,
      "text": "Oh... What am I to do now?"
    },
    {
      "index": 6,
      "id": "msg_sub039_policef_05",
      "hash": "426538fabe078b44",
      "flags": 0,
      "text": "How is Squirtle doing?"
    },
    {
      "index": 7,
      "id": "msg_sub039_poke_01",
      "hash": "fe599006e0672827",
      "flags": 0,
      "text": "SQUIRTLE: Squirt."
    }
  ],
