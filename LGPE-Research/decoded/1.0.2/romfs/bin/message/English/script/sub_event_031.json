    {
      "index": 0,
      "id": "msg_sub031_bigman_01",
      "hash": "690f43ce056a08a6",
      "flags": 0,
      "text": "Hrmmm? Wha—?\\nI must have dozed off in the sun..."
    },
    {
      "index": 1,
      "id": "msg_sub031_bigman_02",
      "hash": "690f42ce056a06f3",
      "flags": 0,
      "text": "...I had this weird dream."
    },
    {
      "index": 2,
      "id": "msg_sub031_bigman_03",
      "hash": "690f41ce056a0540",
      "flags": 4,
      "text": "A lost spirit became a flame and was\\nfloating around.\\c\\nHuh? Seems I picked up this TM without\\nrealizing it."
    },
    {
      "index": 3,
      "id": "msg_sub031_bigman_04",
      "hash": "690f48ce056a1125",
      "flags": 4,
      "text": "Eeek! That’s creepy!\\nI’d better give it to you!"
    },
    {
      "index": 4,
      "id": "msg_sub031_bigman_05",
      "hash": "690f47ce056a0f72",
      "flags": 0,
      "text": "TM11 contains Will-O-Wisp...\\nBooo!"
