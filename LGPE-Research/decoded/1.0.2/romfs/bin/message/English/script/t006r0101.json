{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t006r0101_fat_01_01",
      "hash": "16a1c4266049649d",
      "flags": 0,
      "text": "Would you look at my Pikachu’s adorable tail?"
    },
    {
      "index": 1,
      "id": "msg_t006r0101_fat_01_02",
      "hash": "16a1c12660495f84",
      "flags": 0,
      "text": "Hmph!\\c\\nMy Pikachu is twice as cute as that one!"
    },
    {
      "index": 2,
      "id": "msg_t006r0101_youngf_01_01",
      "hash": "0ee506a6250d159c",
      "flags": 4,
      "text": "I just adore my Seel!\\nIt’s so lovable!\\c\\nIt squeals “Keeew!” when I hug it!"
    },
    {
      "index": 3,
      "id": "msg_t006r0101_youngf_01_02",
      "hash": "0ee509a6250d1ab5",
      "flags": 4,
      "text": "Oh dear!\\c\\nMy Seel is far more attractive.\\nEasily double, I would say."
    },
    {
      "index": 4,
      "id": "msg_t006r0101_poke_01",
      "hash": "92f57942219c9e77",
      "flags": 0,
      "text": "PIKACHU: Chu! Pikachu!"
    },
    {
      "index": 5,
      "id": "msg_t006r0101_poke_02",
      "hash": "92f57a42219ca02a",
      "flags": 0,
      "text": "SEEL: Keeew!"
    },
    {
      "index": 6,
      "id": "msg_t006r0101_stafff_01",
      "hash": "eeb3cbaafce30758",
      "flags": 4,
      "text": "Our chairman is very outspoken when it comes\\nto his opinions about Pokémon."
    },
    {
      "index": 7,
      "id": "msg_t006r0101_poster_01",
      "hash": "26d385ca9600a6a3",
      "flags": 0,
      "text": "“Listen politely to other Trainers when they’re\\nshowing off their adorable Pokémon!”"
    },
    {
      "index": 8,
      "id": "msg_t006r0101_poster_02",
      "hash": "26d386ca9600a856",
      "flags": 0,
      "text": "“If someone brags, brag right back...\\nAnd 10 times more than them!”"
    },
    {
      "index": 9,
      "id": "msg_t006r0101_poster_03",
      "hash": "26d387ca9600aa09",
      "flags": 4,
      "text": "It looks like it’s titled My Cute Rapidash."
    },
    {
      "index": 10,
      "id": "msg_t006r0101_poster_04",
      "hash": "26d388ca9600abbc",
      "flags": 0,
      "text": "There are words beneath: My Beloved Fearow."
    },
    {
      "index": 11,
      "id": "msg_t006r0101_poster_05",
      "hash": "26d389ca9600ad6f",
      "flags": 0,
      "text": "My Adorable Pokémon and Me... A title, maybe?"
    },
    {
      "index": 12,
      "id": "msg_t006r0101_poster_06",
      "hash": "26d38aca9600af22",
      "flags": 0,
      "text": "Hmm, Diary of My Beloved Pokémon and Me..."
    },
    {
      "index": 13,
      "id": "msg_workerw1_01_p02_t006_r0201",
      "hash": "5cc7fb3c2e424c3b",
      "flags": 0,
      "text": "[~ 13]"
    }
  ],
