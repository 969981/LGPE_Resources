      "flags": 0,
      "text": "Viridian City:\\nThe Eternally Green Paradise"
    },
    {
      "index": 1,
      "id": "msg_town002_kanban_02",
      "hash": "7637afc9d1a1bb02",
      "flags": 0,
      "text": "Viridian City Pokémon Gym"
    },
    {
      "index": 2,
      "id": "msg_town002_door_01",
      "hash": "b7246880b3c9c456",
      "flags": 0,
      "text": "The doors to the Viridian City Pokémon Gym\\nare locked tight!"
    },
    {
      "index": 3,
      "id": "msg_town002_kanban_03",
      "hash": "7637b0c9d1a1bcb5",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "msg_town002_kanban_04",
      "hash": "7637a9c9d1a1b0d0",
      "flags": 0,
      "text": "Trainer Tips\\c\\nIf you run out of Poké Balls, you can buy more\\nat a Poké Mart!"
    },
    {
      "index": 5,
      "id": "msg_town002_kanban_05",
      "hash": "7637aac9d1a1b283",
      "flags": 0,
      "text": "Trainers’ School:\\nGet Schooled in School!"
    },
    {
      "index": 6,
      "id": "msg_town002_childm_01_01",
      "hash": "514de6fb5176410d",
      "flags": 0,
      "text": "Those Poké Balls you’ve got!\\nYou have Pokémon, don’t you.\\c\\nIt’s great that you can carry and use your\\nPokémon anytime, anywhere."
    },
    {
      "index": 7,
      "id": "msg_town002_oldm_01_01",
      "hash": "75c5dea9e5248190",
      "flags": 0,
      "text": "This Pokémon Gym is always closed...\\c\\nI wonder who the Gym Leader is..."
    },
    {
      "index": 8,
      "id": "msg_town002_oldm_01_02",
      "hash": "75c5e1a9e52486a9",
      "flags": 0,
      "text": "The Viridian City Gym Leader has returned!"
    },
    {
      "index": 9,
      "id": "msg_town002_bugcatcher_01_01",
      "hash": "064dd86c3fe6a1d6",
      "flags": 0,
      "text": "Did you know there are actually two kinds of\\ncaterpillar Pokémon?"
    },
    {
      "index": 10,
      "id": "msg_town002_bugcatcher_01_02",
      "hash": "064dd76c3fe6a023",
      "flags": 0,
      "text": "Caterpie has no poison, but Weedle does.\\c\\nWatch that your Pokémon aren’t hit with\\nWeedle’s Poison Sting."
    },
    {
      "index": 11,
      "id": "msg_town002_bugcatcher_01_03",
      "hash": "064dd66c3fe69e70",
      "flags": 4,
      "text": "Oh, then good!"
    },
    {
      "index": 12,
      "id": "msg_town002_jevenile_f_01",
      "hash": "52931ec5d1be27bf",
      "flags": 0,
      "text": "[~ 12]"
