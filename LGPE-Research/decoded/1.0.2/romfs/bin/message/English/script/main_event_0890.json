  "lines": [
    {
      "index": 0,
      "id": "msg_main0890_musasi_01",
      "hash": "ef301e11683d2b10",
      "flags": 0,
      "text": "JESSIE: Just let us through already!"
    },
    {
      "index": 1,
      "id": "msg_main0890_rocketm_01",
      "hash": "9611c17128a694eb",
      "flags": 0,
      "text": "No way! Only authorized members are allowed.\\nI was told to let no one else in."
    },
    {
      "index": 2,
      "id": "msg_main0890_kojiro_01",
      "hash": "4e00beb778c8aafe",
      "flags": 0,
      "text": "JAMES: How can you say that when we’re on the\\nsame side?!"
    },
    {
      "index": 3,
      "id": "msg_main0890_musasi_02",
      "hash": "ef302111683d3029",
      "flags": 0,
      "text": "JESSIE: How rude! You’d deny a beautiful girl\\nwhat she wants?"
    },
    {
      "index": 4,
      "id": "msg_main0890_musasi_03",
      "hash": "ef302011683d2e76",
      "flags": 0,
      "text": "Move it already!"
    },
    {
      "index": 5,
      "id": "msg_main0890_kojiro_02",
      "hash": "4e00bdb778c8a94b",
      "flags": 0,
      "text": "JAMES: Hey! Jessie! Wait for me!"
    },
    {
      "index": 6,
      "id": "msg_main0890_stop_01",
      "hash": "58540270d3db1c1a",
      "flags": 4,
      "text": "I’m a security guard.\\nAnd I don’t let suspicious kids in!"
    },
    {
      "index": 7,
      "id": "msg_main0890_stop_02",
      "hash": "58540170d3db1a67",
      "flags": 0,
      "text": "Blurg..."
    },
    {
      "index": 8,
      "id": "msg_main0890_stop_03",
      "hash": "58540070d3db18b4",
      "flags": 0,
      "text": "Looks like he’s blacked out..."
    }
  ],
