  "lines": [
    {
      "index": 0,
      "id": "msg_main0310_rocketm_01",
      "hash": "d0bf455f5b512f68",
      "flags": 0,
      "text": "Congratulations!\\nYou beat our five Trainers!\\c\\nYou just earned a fabulous prize!"
    },
    {
      "index": 1,
      "id": "msg_main0310_sys_01",
      "hash": "fda0b6542407ea06",
      "flags": 0,
      "text": "You got a Nugget from the mysterious Trainer!"
    },
    {
      "index": 2,
      "id": "msg_main0310_rocketm_02",
      "hash": "d0bf485f5b513481",
      "flags": 0,
      "text": "By the way, kid, how would you like to join\\nTeam Rocket?"
    },
    {
      "index": 3,
      "id": "msg_main0310_rocketm_04",
      "hash": "d0bf4a5f5b5137e7",
      "flags": 0,
      "text": "That’s right!"
    },
    {
      "index": 4,
      "id": "msg_main0310_rocketm_05",
      "hash": "d0bf495f5b513634",
      "flags": 0,
      "text": "We’re a group dedicated to doing evil\\nusing Pokémon!"
    },
    {
      "index": 5,
      "id": "msg_main0310_rocketm_06",
      "hash": "d0bf4c5f5b513b4d",
      "flags": 0,
      "text": "Want to join?"
    },
    {
      "index": 6,
      "id": "msg_main0310_rocketm_07",
      "hash": "d0bf4b5f5b51399a",
      "flags": 4,
      "text": "Are you sure?"
    },
    {
      "index": 7,
      "id": "msg_main0310_rocketm_08",
      "hash": "d0bf3e5f5b512383",
      "flags": 0,
      "text": "Come on, join us!"
    },
    {
      "index": 8,
      "id": "msg_main0310_rocketm_09",
      "hash": "d0bf3d5f5b5121d0",
      "flags": 4,
      "text": "I’m telling you to join!"
    },
    {
      "index": 9,
      "id": "msg_main0310_rocketm_10",
      "hash": "d0bbc05f5b4e1792",
      "flags": 4,
      "text": "OK, you need convincing!"
    },
    {
      "index": 10,
      "id": "msg_main0310_rocketm_11",
      "hash": "d0bbc15f5b4e1945",
      "flags": 4,
      "text": "I’ll make you an offer you can’t refuse!"
    },
    {
      "index": 11,
      "id": "msg_main0150_dummy_01",
