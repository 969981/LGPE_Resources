  "lines": [
    {
      "index": 0,
      "id": "msg_t009r0104_bg_01",
      "hash": "1cb59dae8bf2d985",
      "flags": 0,
      "text": "This seems to be a machine that is cold on\\nthe inside!"
    },
    {
      "index": 1,
      "id": "msg_t009r0104_bg_02",
      "hash": "1cb59aae8bf2d46c",
      "flags": 0,
      "text": "The device is warm to the touch."
    },
    {
      "index": 2,
      "id": "msg_t009r0104_researcher_01",
      "hash": "56b24863e043fc4a",
      "flags": 4,
      "text": "All matter is made up of tiny molecules!\\nIt’s like how ₽100 is a collection of lots of ₽1."
    },
    {
      "index": 3,
      "id": "msg_t009r0104_researcher_02",
      "hash": "56b24763e043fa97",
      "flags": 0,
      "text": "Maybe when I become a fossil they’ll revive\\nme in the distant future."
    },
    {
      "index": 4,
      "id": "msg_t009r0104_researcher_03",
      "hash": "56b24663e043f8e4",
      "flags": 0,
      "text": "My eyes get so tired when I look at a computer\\nfor too long.\\c\\nResting your eyes is really important, you know!"
    },
    {
      "index": 5,
      "id": "test_00",
      "hash": "a806796e1aa98a3e",
      "flags": 0,
      "text": "[~ 5]"
    }
