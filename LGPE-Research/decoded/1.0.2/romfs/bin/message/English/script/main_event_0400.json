    },
    {
      "index": 1,
      "id": "msg_main0400_sailor_02",
      "hash": "4d9b65f4be6bb486",
      "flags": 0,
      "text": "Welcome to the S.S. Anne!\\c\\nBut not so fast!\\nDo you have a ticket, young [VAR GENDBR(00FF,0406)]fellowlady?"
    },
    {
      "index": 2,
      "id": "msg_main0400_sys_01",
      "hash": "0c44b0c349338b86",
      "flags": 0,
      "text": "You flashed your S.S. Ticket at the man!"
    },
    {
      "index": 3,
      "id": "msg_main0400_sailor_03",
      "hash": "4d9b66f4be6bb639",
      "flags": 0,
      "text": "Yup, that’ll do.\\nWelcome aboard the S.S. Anne!\\c\\nOh! And that’s not all!\\c\\nYou’re the 100th guest to join us aboard\\nthe S.S. Anne today...\\c\\nSo here you go!\\c\\nPlease enjoy this breezy outfit as you feel\\nthe salty air on your skin!"
    },
    {
      "index": 4,
      "id": "msg_main0400_sys_02",
      "hash": "0c44afc3493389d3",
      "flags": 0,
      "text": "You got a [VAR COLOR(0006)]Sailor Set [VAR COLOR(0000)]from the crew member!"
    },
    {
      "index": 5,
      "id": "msg_main0400_sys_04",
      "hash": "0c44b5c349339405",
      "flags": 0,
      "text": "You put the [VAR COLOR(0006)]Sailor Set[VAR COLOR(0000)] in your Clothing Trunk!"
    },
    {
      "index": 6,
      "id": "msg_main0400_sailor_04",
      "hash": "4d9b67f4be6bb7ec",
      "flags": 0,
      "text": "[~ 6]"
