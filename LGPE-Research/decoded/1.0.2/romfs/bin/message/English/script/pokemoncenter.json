{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_pokecen_kaifuku_01_01",
      "hash": "55c90a0357dbe99d",
      "flags": 0,
      "text": "Welcome to the Pokémon Center.\\nWould you like to rest your Pokémon?"
    },
    {
      "index": 1,
      "id": "msg_pokecen_kaifuku_01_01b",
      "hash": "a08602ae4aae9c4d",
      "flags": 0,
      "text": "Welcome to the Pokémon Center,\\n[VAR TRCLASS(0001)] [VAR TRNAME(0000)]!\\c\\nWould you like to rest your Pokémon?"
    },
    {
      "index": 2,
      "id": "msg_pokecen_kaifuku_01_02",
      "hash": "55c9070357dbe484",
      "flags": 0,
      "text": "[~ 2]"
    },
    {
      "index": 3,
      "id": "msg_pokecen_kaifuku_01_03",
      "hash": "55c9080357dbe637",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "msg_pokecen_kaifuku_02_02",
      "hash": "fc9448ea108ac177",
      "flags": 4,
      "text": "I’ll take your Pokémon for a few seconds, then."
    },
    {
      "index": 5,
      "id": "msg_pokecen_kaifuku_02_03",
      "hash": "fc9447ea108abfc4",
      "flags": 0,
      "text": "Thanks for waiting!\\nYour Pokémon should be all better now!"
    },
    {
      "index": 6,
      "id": "msg_pokecen_kaifuku_02_04",
      "hash": "fc9446ea108abe11",
      "flags": 0,
      "text": "We hope to see you again!"
    },
    {
      "index": 7,
      "id": "msg_pokecen_kaifuku_03_02",
      "hash": "52f9f6f1abf45252",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "msg_pokecen_kaifuku_05_01",
      "hash": "b038f221c63a6f59",
      "flags": 0,
      "text": "[~ 8]"
    },
    {
      "index": 9,
      "id": "msg_pokecen_birthday_01",
      "hash": "f3940894d61f8d0e",
      "flags": 0,
      "text": "[~ 9]"
    },
    {
      "index": 10,
      "id": "msg_pokecen_birthday_02",
      "hash": "f3940794d61f8b5b",
      "flags": 0,
      "text": "[~ 10]"
    },
    {
      "index": 11,
      "id": "msg_pokecen_birthday_03",
      "hash": "f3940694d61f89a8",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_common_gameover_pc_01",
      "hash": "73aec0e6e0518dc9",
      "flags": 0,
      "text": "First, let’s restore your Pokémon to full health."
    },
    {
      "index": 13,
      "id": "msg_common_gameover_pc_02_01",
      "hash": "a7c19f7f082a78f2",
      "flags": 0,
      "text": "Please visit a Pokémon Center whenever your\\nPokémon’s HP is getting low.\\c\\nAnd if you’re planning to go far off the beaten\\npath, you should probably remember to stock\\r\\nup on Potions from the Poké Mart, too.\\c\\nGood luck out there, Trainer!"
    },
    {
      "index": 14,
      "id": "msg_common_gameover_pc_02_01b",
      "hash": "387a94dae02adcb0",
      "flags": 4,
      "text": "If you have trouble winning against a strong\\nTrainer, train your Pokémon and try again!\\c\\nCatching wild Pokémon and battling Trainers\\nmake your party Pokémon stronger.\\c\\nGood luck out there, Trainer!"
    },
    {
      "index": 15,
      "id": "msg_common_gameover_pc_02_02",
      "hash": "a7c19e7f082a773f",
      "flags": 0,
      "text": "There! All happy and healthy!\\nGood luck and take care!"
    },
    {
      "index": 16,
      "id": "msg_pokecen_lucky_01_01",
      "hash": "a9b092f3f434c0b3",
      "flags": 0,
      "text": "CHANSEY: Chansey."
    },
    {
      "index": 17,
      "id": "msg_common_gameover_myhome_01",
      "hash": "8eb7ddf685cf7705",
      "flags": 0,
      "text": "MOM: Oh, goodness, [VAR TRNAME(0000)]!\\nYou and your Pokémon have been pushing\\r\\nyourselves a bit too hard, haven’t you?\\c\\nI think you could use a little rest."
    },
    {
      "index": 18,
      "id": "msg_common_gameover_myhome_02",
      "hash": "8eb7daf685cf71ec",
      "flags": 0,
      "text": "MOM: Much better!\\nYou and your Pokémon are looking great now!"
    }
  ],
