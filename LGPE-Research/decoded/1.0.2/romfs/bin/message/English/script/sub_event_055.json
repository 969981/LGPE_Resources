{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub055_rocket_F_01",
      "hash": "5498d5667fefd771",
      "flags": 0,
      "text": "Shh! I’m a beautiful spy...on an\\nundercover mission..."
    },
    {
      "index": 1,
      "id": "msg_sub055_rocket_F_02",
      "hash": "5498d2667fefd258",
      "flags": 0,
      "text": "...What’s a child like you doing here?"
    },
    {
      "index": 2,
      "id": "msg_sub055_select_01",
      "hash": "4a4a607772b44436",
      "flags": 4,
      "text": "I’m here to beat Team Rocket"
    },
    {
      "index": 3,
      "id": "msg_sub055_select_02",
      "hash": "4a4a5f7772b44283",
      "flags": 4,
      "text": "I’m just here for fun"
    },
    {
      "index": 4,
      "id": "msg_sub055_rocket_F_03",
      "hash": "5498d3667fefd40b",
      "flags": 0,
      "text": "Heh... You’ve got attitude!\\nI like that!"
    },
    {
      "index": 5,
      "id": "msg_sub055_rocket_F_04",
      "hash": "5498d8667fefdc8a",
      "flags": 0,
      "text": "Hee hee! You’re an interesting child,\\nthat’s for sure."
    },
    {
      "index": 6,
      "id": "msg_sub055_rocket_F_05",
      "hash": "5498d9667fefde3d",
      "flags": 0,
      "text": "Let me give you a present so you remember\\nour little encounter here!"
    },
    {
      "index": 7,
      "id": "msg_sub055_system_01",
      "hash": "6f29e6463da93961",
      "flags": 0,
      "text": "You got a [VAR COLOR(0006)]Team Rocket Set[VAR COLOR(0000)] from the\\nbeautiful spy!"
    },
    {
      "index": 8,
      "id": "msg_sub055_system_02",
      "hash": "6f29e3463da93448",
      "flags": 0,
      "text": "You put the [VAR COLOR(0006)]Team Rocket Set[VAR COLOR(0000)] in your\\nClothing Trunk!"
    },
    {
      "index": 9,
      "id": "msg_sub055_rocket_F_06",
      "hash": "5498d6667fefd924",
      "flags": 0,
      "text": "Just wear that set, and you’ll feel as if\\nyou’re a Team Rocket Grunt yourself!"
    },
    {
      "index": 10,
      "id": "msg_sub055_rocket_F_07",
      "hash": "5498d7667fefdad7",
      "flags": 0,
      "text": "...Although you’re too short to be\\na real Grunt. They’d figure out you were in\\r\\na disguise immediately."
    },
    {
      "index": 11,
      "id": "msg_sub055_rocket_F_08",
      "hash": "5498cc667fefc826",
      "flags": 0,
      "text": "Now, don’t go telling everyone I’m a spy, OK?\\nIf you do, I’ll have to give you a scolding!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_055_max",
      "hash": "eed5f39da5c02f50"
    }
  ]
}
