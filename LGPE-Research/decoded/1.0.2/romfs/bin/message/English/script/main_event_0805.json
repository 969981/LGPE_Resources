{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0805_poke_01_01",
      "hash": "67195e63266b521b",
      "flags": 0,
      "text": "GHOST: Begone..."
    },
    {
      "index": 1,
      "id": "msg_main0805_poke_01_02",
      "hash": "67195f63266b53ce",
      "flags": 0,
      "text": "Begone...\\nintruders..."
    },
    {
      "index": 2,
      "id": "msg_main0805_rival_01",
      "hash": "1fb7dc95783b3aa0",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: GAH!\\nThis one’s even bigger than the last one!"
    },
    {
      "index": 3,
      "id": "msg_main0805_rival_10",
      "hash": "1fb477957838592a",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]! Use the thing!\\nThe thing you used last time!"
    },
    {
      "index": 4,
      "id": "msg_main0805_sys_01",
      "hash": "98a1dd67f92a9f67",
      "flags": 0,
      "text": "The true form of the ghost was...\\nthe restless spirit of Cubone’s mother!"
    },
    {
      "index": 5,
      "id": "msg_main0805_sys_02",
      "hash": "98a1de67f92aa11a",
      "flags": 0,
      "text": "The mother’s spirit was calmed, returning to its\\nkind and gentle nature.\\c\\nIt departed to the afterlife...and disappeared."
    },
    {
      "index": 6,
      "id": "msg_main0805_rival_02",
      "hash": "1fb7df95783b3fb9",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: Cubone, you...\\c\\nYou just came here because you wanted to see\\nyour mom again, huh?"
    },
    {
      "index": 7,
      "id": "msg_main0805_poke_02_01",
      "hash": "123c266d35d38b24",
      "flags": 0,
      "text": "CUBONE: Kew..."
    },
    {
      "index": 8,
      "id": "msg_main0805_rival_03",
      "hash": "1fb7de95783b3e06",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: Sorry for thinking your mom\\nwas scary, Cubone."
    },
    {
      "index": 9,
      "id": "msg_main0805_rival_04",
      "hash": "1fb7e195783b431f",
      "flags": 0,
      "text": "[VAR TRNAME(0000)], I...\\nI don’t want to leave Cubone alone like this.\\r\\nI’m gonna go take it home.\\c\\nOh! If there’s someone named Fuji upstairs,\\ndo you think you could see him home, too?"
    },
    {
      "index": 10,
      "id": "msg_main0805_select_01",
      "hash": "db48292ea2290a98",
      "flags": 0,
      "text": "You sure you’re OK by yourself?"
    },
    {
      "index": 11,
      "id": "msg_main0805_select_02",
      "hash": "db482c2ea2290fb1",
      "flags": 4,
      "text": "I’ve got this!"
    },
    {
      "index": 12,
      "id": "msg_main0805_rival_05",
      "hash": "1fb7e095783b416c",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: I-I’ll be fine!\\nI’m with Cubone now, after all!\\c\\n...You’ve gotten pretty gutsy,\\nhaven’t you, [VAR TRNAME(0000)]?"
    },
    {
      "index": 13,
      "id": "msg_main0805_rival_06",
      "hash": "1fb7e395783b4685",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: Are you not scared\\nat all, [VAR TRNAME(0000)]?\\c\\nMan, you’re full of confidence, pal!\\nYou definitely seem dependable."
    },
    {
      "index": 14,
      "id": "msg_main0805_rival_07",
      "hash": "1fb7e295783b44d2",
      "flags": 0,
      "text": "What? You rescued Cubone from Team Rocket?!"
    },
    {
      "index": 15,
      "id": "msg_main0805_rival_11",
      "hash": "1fb4789578385add",
      "flags": 0,
      "text": "When did you go and get that strong...?"
    },
    {
      "index": 16,
      "id": "msg_main0805_rival_08",
      "hash": "1fb7e595783b49eb",
      "flags": 0,
      "text": "Right... Well then...\\nGuess I’ll leave this up to you, [VAR TRNAME(0000)]!"
    },
    {
      "index": 17,
      "id": "msg_main0805_rival_09",
      "hash": "1fb7e495783b4838",
      "flags": 0,
      "text": "Come on, Cubone!"
    },
    {
      "index": 18,
      "id": "msg_main0805_poke_02_02",
      "hash": "123c296d35d3903d",
      "flags": 0,
      "text": "CUBONE: Kew!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0805_max",
      "hash": "29a8cb780fbc5a6c"
    }
  ]
}
