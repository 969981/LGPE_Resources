{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main2000_rival_01",
      "hash": "4568f4f74cfce003",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: Anybody home?"
    },
    {
      "index": 1,
      "id": "msg_main2000_rival_02",
      "hash": "4568f5f74cfce1b6",
      "flags": 0,
      "text": "Hey, [VAR TRNAME(0000)]!\\nI’m coming up!"
    },
    {
      "index": 2,
      "id": "msg_main2000_rival_03",
      "hash": "4568f6f74cfce369",
      "flags": 0,
      "text": "[VAR RIVALNAME(0001)]: Morning, Kanto Champion!"
    },
    {
      "index": 3,
      "id": "msg_main2000_rival_09",
      "hash": "4568fcf74cfced9b",
      "flags": 0,
      "text": "But don’t get too comfortable with that title.\\nI plan on stealing it from you soon!"
    },
    {
      "index": 4,
      "id": "msg_main2000_rival_04",
      "hash": "4568f7f74cfce51c",
      "flags": 0,
      "text": "First, though... Did you hear the rumors?\\c\\nThere’s talk going around about some crazy\\nstrong-looking Pokémon being spotted..."
    },
    {
      "index": 5,
      "id": "msg_main2000_sel_01",
      "hash": "8b65dee0045ddfb3",
      "flags": 0,
      "text": "What kind of Pokémon?"
    },
    {
      "index": 6,
      "id": "msg_main2000_sel_02",
      "hash": "8b65dfe0045de166",
      "flags": 4,
      "text": "I want to catch it!"
    },
    {
      "index": 7,
      "id": "msg_main2000_rival_05",
      "hash": "4568f8f74cfce6cf",
      "flags": 4,
      "text": "I hear it looks super strong—and super cool!"
    },
    {
      "index": 8,
      "id": "msg_main2000_rival_06",
      "hash": "4568f9f74cfce882",
      "flags": 0,
      "text": "Ha! I knew you wouldn’t be able to resist a\\nrumor like that!"
    },
    {
      "index": 9,
      "id": "msg_main2000_rival_07",
      "hash": "4568faf74cfcea35",
      "flags": 0,
      "text": "The Pokémon was seen near [VAR COLOR(0006)]Cerulean City[VAR COLOR(0000)]!"
    },
    {
      "index": 10,
      "id": "msg_main2000_rival_10",
      "hash": "456bf9f74cff1e59",
      "flags": 4,
      "text": "And apparently it ran away into a cave\\nsomewhere there. That’s all I know."
    },
    {
      "index": 11,
      "id": "msg_main2000_rival_08",
      "hash": "4568fbf74cfcebe8",
      "flags": 0,
      "text": "So! I say we both go try to catch this Pokémon!"
    },
    {
      "index": 12,
      "id": "msg_main2000_rival_11",
      "hash": "456bf8f74cff1ca6",
      "flags": 0,
      "text": "Whoever catches it first is the winner!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_2000_max",
      "hash": "9104968fcbd7dad1"
    }
  ]
}
