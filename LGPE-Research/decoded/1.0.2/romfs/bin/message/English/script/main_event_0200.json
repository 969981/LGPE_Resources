  "lines": [
    {
      "index": 0,
      "id": "msg_main0200_scientist_01",
      "hash": "1997f465dac34205",
      "flags": 0,
      "text": "Hey, stop!"
    },
    {
      "index": 1,
      "id": "msg_main0200_scientist_05",
      "hash": "1997f065dac33b39",
      "flags": 4,
      "text": "I found these Fossils!"
    },
    {
      "index": 2,
      "id": "msg_main0200_scientist_06",
      "hash": "1997ed65dac33620",
      "flags": 0,
      "text": "They’re both mine!"
    },
    {
      "index": 3,
      "id": "msg_science_02_02",
      "hash": "3f4233734bcf5c9d",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "msg_main0200_scientist_02",
      "hash": "1997f165dac33cec",
      "flags": 0,
      "text": "Fine, we’ll each take a Fossil...\\nIt’s no good being greedy, right?"
    },
    {
      "index": 5,
      "id": "msg_main0200_sys_01",
      "hash": "4a818fc482d38e68",
      "flags": 0,
      "text": "Do you want to take the Dome Fossil?"
    },
    {
      "index": 6,
      "id": "msg_main0200_sys_02",
      "hash": "4a8192c482d39381",
      "flags": 0,
      "text": "Do you want to take the Helix Fossil?"
    },
    {
      "index": 7,
      "id": "msg_main0200_sys_03",
      "hash": "4a8191c482d391ce",
      "flags": 0,
      "text": "You got the Helix Fossil!"
    },
    {
      "index": 8,
      "id": "msg_main0200_sys_04",
      "hash": "4a8194c482d396e7",
      "flags": 0,
      "text": "You got the Dome Fossil!"
    },
    {
      "index": 9,
      "id": "msg_main0200_scientist_03",
      "hash": "1997f265dac33e9f",
      "flags": 4,
      "text": "All right, then the other Fossil is mine!"
    },
    {
      "index": 10,
      "id": "msg_main0200_scientist_04",
      "hash": "1997ef65dac33986",
      "flags": 4,
      "text": "It’s really far away from here, but apparently\\nthere’s a lab on Cinnabar Island where they’re\\r\\ndoing research on reviving Fossils."
    }
  ],
