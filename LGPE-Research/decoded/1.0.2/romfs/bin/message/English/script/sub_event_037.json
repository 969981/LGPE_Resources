  "lines": [
    {
      "index": 0,
      "id": "msg_sub037_adultf_01",
      "hash": "0754a41f7a189db8",
      "flags": 4,
      "text": "I’m taking care of injured Pokémon here."
    },
    {
      "index": 1,
      "id": "msg_sub037_adultf_02",
      "hash": "0754a71f7a18a2d1",
      "flags": 0,
      "text": "Bulbasaur is fully recovered, so I’d like to\\ngive this Pokémon to a Trainer who’s caught\\r\\na lot of Pokémon and I can trust."
    },
    {
      "index": 2,
      "id": "msg_sub037_adultf_08",
      "hash": "07549d1f7a1891d3",
      "flags": 0,
      "text": "The number of Pokémon you’ve caught so far\\nis [VAR NUM9(0000,002C)]?!"
    },
    {
      "index": 3,
      "id": "msg_sub037_adultf_03",
      "hash": "0754a61f7a18a11e",
      "flags": 4,
      "text": "Incredible!\\nWould you take care of this Bulbasaur?"
    },
    {
      "index": 4,
      "id": "msg_sub037_adultf_04",
      "hash": "0754a91f7a18a637",
      "flags": 0,
      "text": "Please take care of Bulbasaur!"
    },
    {
      "index": 5,
      "id": "msg_sub037_adultf_09",
      "hash": "07549c1f7a189020",
      "flags": 4,
      "text": "Ah... If you’ve caught at least [VAR NUM2(0000)] Pokémon,\\nwill you come back to get Bulbasaur?"
    },
    {
      "index": 6,
      "id": "msg_sub037_adultf_05",
      "hash": "0754a81f7a18a484",
      "flags": 4,
      "text": "Is Bulbasaur doing well?"
    },
    {
      "index": 7,
      "id": "msg_sub037_adultf_06",
      "hash": "0754ab1f7a18a99d",
      "flags": 4,
      "text": "Oh... That’s too bad..."
    },
    {
      "index": 8,
      "id": "msg_sub037_poke_01",
      "hash": "96bdf2947fd99335",
      "flags": 0,
      "text": "BULBASAUR: Bubba! Zoar!"
    }
  ],
