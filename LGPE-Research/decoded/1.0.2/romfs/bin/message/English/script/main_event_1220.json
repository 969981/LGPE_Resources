  "lines": [
    {
      "index": 0,
      "id": "msg_main1220_partner_a_01",
      "hash": "4efb61fc06ce0c44",
      "flags": 0,
      "text": "Pikaaachu!"
    },
    {
      "index": 1,
      "id": "msg_main1220_partner_b_01",
      "hash": "f89599f46b644f3b",
      "flags": 0,
      "text": "Vee! Eeeevee!"
    },
    {
      "index": 2,
      "id": "msg_main1220_young_f_01",
      "hash": "b718baf58baac5e5",
      "flags": 4,
      "text": "Oh! If it isn’t [VAR POKNAME(0002)]!"
    },
    {
      "index": 3,
      "id": "msg_main1220_young_f_02",
      "hash": "b718b7f58baac0cc",
      "flags": 0,
      "text": "You want to know what I’m doing?"
    },
    {
      "index": 4,
      "id": "msg_main1220_young_f_03",
      "hash": "b718b8f58baac27f",
      "flags": 4,
      "text": "I’m picking flowers!\\c\\nI’m going to make a bouquet for someone\\nvery important."
    },
    {
      "index": 5,
      "id": "msg_main1220_young_f_04",
      "hash": "b718b5f58baabd66",
      "flags": 0,
      "text": "But it’s a secret!\\nYou won’t tell anyone, right, [VAR TRNAME(0000)]?"
    },
    {
      "index": 6,
      "id": "msg_main1220_young_f_05",
      "hash": "b718b6f58baabf19",
      "flags": 4,
      "text": "Oh! That’s right!\\nUm...\\c\\nThe Viridian City Gym Leader came back to\\nthe Gym at last! That’s what people are saying.\\c\\nYou should head off to Viridian City!"
    },
    {
      "index": 7,
      "id": "msg_main1220_young_f_06",
      "hash": "b718b3f58baaba00",
      "flags": 0,
      "text": "You can’t tell [VAR TRNAME(0001)] that you saw me\\npicking flowers here, OK?\\r\\nIt’s our little secret!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_1220_max",
