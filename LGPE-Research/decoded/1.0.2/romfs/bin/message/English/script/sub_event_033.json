{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t003r0101_scientist_01_01",
      "hash": "40fdab8e6795129d",
      "flags": 0,
      "text": "Hello.\\nIt’s ₽50 for kids.\\c\\nWould you like to come in?"
    },
    {
      "index": 1,
      "id": "msg_t003r0101_scientist_01_02",
      "hash": "40fda88e67950d84",
      "flags": 0,
      "text": "Come again!"
    },
    {
      "index": 2,
      "id": "msg_t003r0101_scientist_01_03",
      "hash": "40fda98e67950f37",
      "flags": 0,
      "text": "Right, ₽50!\\nThank you!"
    },
    {
      "index": 3,
      "id": "msg_t003r0101_scientist_01_04",
      "hash": "40fda68e67950a1e",
      "flags": 0,
      "text": "You don’t have enough money."
    },
    {
      "index": 4,
      "id": "msg_t003r0101_scientist_01_05",
      "hash": "40fda78e67950bd1",
      "flags": 0,
      "text": "Please enjoy yourself."
    },
    {
      "index": 5,
      "id": "msg_t003r0101_scientist_01_06",
      "hash": "40fda48e679506b8",
      "flags": 0,
      "text": "You can’t sneak in the back way!\\nNice try, kid, but no.\\c\\nOh, whatever!\\nDo you know what amber is?"
    },
    {
      "index": 6,
      "id": "msg_t003r0101_scientist_01_07",
      "hash": "40fda58e6795086b",
      "flags": 0,
      "text": "There’s a lab somewhere trying to resurrect\\ncreatures from amber, which contains\\r\\nthe genetic material of ancient creatures."
    },
    {
      "index": 7,
      "id": "msg_t003r0101_scientist_01_08",
      "hash": "40fda28e67950352",
      "flags": 4,
      "text": "Amber is actually sap—that gooey stuff that\\noozes from trees.\\c\\nThe ancient sap fossilized over time to become\\nrock-hard amber."
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_033_max",
      "hash": "39c45feef4e720a4"
    }
  ]
}
