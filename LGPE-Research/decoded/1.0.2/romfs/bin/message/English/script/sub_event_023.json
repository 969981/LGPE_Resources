{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub023_karate_01_01",
      "hash": "eaf8a55e83471389",
      "flags": 0,
      "text": "KARATE MASTER: *grunt*\\c\\nI am the Karate Master!\\nI am the leader here!"
    },
    {
      "index": 1,
      "id": "msg_sub023_karate_01_09",
      "hash": "eaf8ad5e83472121",
      "flags": 0,
      "text": "You wish to challenge us?\\nExpect no mercy!"
    },
    {
      "index": 2,
      "id": "msg_sub023_karate_01_10",
      "hash": "eafc2a5e834a2b5f",
      "flags": 0,
      "text": "Fwaaa!"
    },
    {
      "index": 3,
      "id": "msg_sub023_karate_01_02",
      "hash": "eaf8a25e83470e70",
      "flags": 0,
      "text": "KARATE MASTER: Indeed, I have lost!"
    },
    {
      "index": 4,
      "id": "msg_sub023_karate_01_07",
      "hash": "eaf8a75e834716ef",
      "flags": 0,
      "text": "But I beseech you—do not take\\nour emblem as your trophy!"
    },
    {
      "index": 5,
      "id": "msg_sub023_karate_01_08",
      "hash": "eaf8ac5e83471f6e",
      "flags": 4,
      "text": "In return, I will give you a prized\\nFighting-type Pokémon!"
    },
    {
      "index": 6,
      "id": "msg_sub023_karate_01_06",
      "hash": "eaf8a65e8347153c",
      "flags": 0,
      "text": "Choose whichever one you like!"
    },
    {
      "index": 7,
      "id": "msg_sub023_karate_01_03",
      "hash": "eaf8a35e83471023",
      "flags": 0,
      "text": "KARATE MASTER: Hyah!\\nStay and train at karate with us!"
    },
    {
      "index": 8,
      "id": "msg_sub023_karate_01_04",
      "hash": "eaf8a85e834718a2",
      "flags": 0,
      "text": "KARATE MASTER: You want the hard-kicking\\nHitmonlee?"
    },
    {
      "index": 9,
      "id": "msg_sub023_sys_01_01",
      "hash": "384f6f255b68c6d4",
      "flags": 0,
      "text": "You got [VAR POKNAME(0004)] from the Karate Master!"
    },
    {
      "index": 10,
      "id": "msg_sub023_karate_01_05",
      "hash": "eaf8a95e83471a55",
      "flags": 0,
      "text": "KARATE MASTER: You want the piston-punching\\nHitmonchan?"
    },
    {
      "index": 11,
      "id": "msg_sub023_sys_01_02",
      "hash": "384f72255b68cbed",
      "flags": 0,
      "text": "You can only choose one."
    },
    {
      "index": 12,
      "id": "msg_sub023_poke_01_01",
      "hash": "1c43cc5dba1082f6",
      "flags": 0,
      "text": "HITMONLEE: Kikick!"
    },
    {
      "index": 13,
      "id": "msg_sub023_poke_02_01",
      "hash": "4b19cc75c761fea9",
      "flags": 0,
      "text": "HITMONCHAN: Knnnnuckle!"
    }
  ],
