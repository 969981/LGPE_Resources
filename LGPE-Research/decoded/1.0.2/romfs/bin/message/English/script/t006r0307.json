{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t006r0307_cook_01",
      "hash": "c97ffa1a1adc76f0",
      "flags": 0,
      "text": "You there, m[VAR GENDBR(00FF,0808)]on petita petite!\\nWe’re busy here!\\r\\nOut of the way! Shoo! Shoo!"
    },
    {
      "index": 1,
      "id": "msg_t006r0307_cook_02",
      "hash": "c97ffd1a1adc7c09",
      "flags": 0,
      "text": "Have you ever wondered about these silver\\ndomes we put on top of the food?\\c\\nThey’re called cloches!\\nThey keep hot dishes from cooling."
    },
    {
      "index": 2,
      "id": "msg_t006r0307_cook_03",
      "hash": "c97ffc1a1adc7a56",
      "flags": 4,
      "text": "I’m so busy, I’m getting dizzy!\\nYou have to give me room here!"
    },
    {
      "index": 3,
      "id": "msg_t006r0307_cook_04",
      "hash": "c97fff1a1adc7f6f",
      "flags": 0,
      "text": "Hum-de-hum-de-ho...\\c\\nI peel spuds every day!\\nHum-hum..."
    },
    {
      "index": 4,
      "id": "msg_t006r0307_cook_05",
      "hash": "c97ffe1a1adc7dbc",
      "flags": 0,
      "text": "Have you heard about Snorlax?\\nIt’s a real glutton.\\c\\nNo other Pokémon eats and sleeps the way\\nSnorlax can!"
    },
    {
      "index": 5,
      "id": "msg_t006r0307_cook_06",
      "hash": "c980011a1adc82d5",
      "flags": 0,
      "text": "*snivel...sniff*\\c\\nI only get to peel onions...\\n*snivel*"
    },
    {
      "index": 6,
      "id": "msg_t006r0307_cook_07_01",
      "hash": "6e19651585616b6c",
      "flags": 4,
      "text": "Er-hem!\\nIndeed I am le chef!\\c\\nLe main course today is..."
    },
    {
      "index": 7,
      "id": "msg_t006r0307_cook_07_02",
      "hash": "6e19681585617085",
      "flags": 0,
      "text": "my flavorful Whirlpool sushi!\\c\\nThough les guests may complain that it’s fish\\nyet again..."
    },
    {
      "index": 8,
      "id": "msg_t006r0307_cook_07_03",
      "hash": "6e19671585616ed2",
      "flags": 0,
      "text": "le Kantonian flavor of Pewter Crunchies!\\c\\nLes guests will mutiny, I fear."
    },
    {
      "index": 9,
      "id": "msg_t006r0307_cook_07_04",
      "hash": "6e19621585616653",
      "flags": 0,
      "text": "my juicy Take Down steak!\\c\\nBut have I enough pour les guests?"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t006r0307_max",
      "hash": "d197397409d6cf5c"
    }
  ]
}
