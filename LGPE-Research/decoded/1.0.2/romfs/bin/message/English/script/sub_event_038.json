{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub038_adultm_01",
      "hash": "f87cb4ed9d98299a",
      "flags": 4,
      "text": "I’m not good at raising Pokémon.\\c\\nI feel sorry for my Charmander because it’s not\\ngetting stronger.\\c\\nSo I want to give it to a better Trainer\\nthan me. Are you interested?"
    },
    {
      "index": 1,
      "id": "msg_sub038_adultm_05",
      "hash": "f87cb0ed9d9822ce",
      "flags": 0,
      "text": "The number of Pokémon you’ve caught\\nis [VAR NUM9(0000,002C)]!"
    },
    {
      "index": 2,
      "id": "msg_sub038_adultm_06",
      "hash": "f87cafed9d98211b",
      "flags": 0,
      "text": "Cool! I want you to have this Charmander.\\nWill you take it?"
    },
    {
      "index": 3,
      "id": "msg_sub038_adultm_02",
      "hash": "f87cb3ed9d9827e7",
      "flags": 0,
      "text": "Take good care of my Charmander!"
    },
    {
      "index": 4,
      "id": "msg_sub038_adultm_07",
      "hash": "f87caeed9d981f68",
      "flags": 4,
      "text": "I’ve caught [VAR NUM3(0000)] Pokémon.\\nYou should catch more than that!"
    },
    {
      "index": 5,
      "id": "msg_sub038_adultm_03",
      "hash": "f87cb2ed9d982634",
      "flags": 4,
      "text": "Oh... I’d better send it to the professor, then."
    },
    {
      "index": 6,
      "id": "msg_sub038_adultm_04",
      "hash": "f87cb1ed9d982481",
      "flags": 0,
      "text": "How’s Charmander doing?"
    },
    {
      "index": 7,
      "id": "msg_sub038_poke_01",
      "hash": "a722653a024051d0",
      "flags": 0,
      "text": "CHARMANDER: Chaaar!"
    }
  ],
