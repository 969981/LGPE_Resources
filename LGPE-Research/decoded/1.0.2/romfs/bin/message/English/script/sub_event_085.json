{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub085_musasi_01",
      "hash": "5ea012df50658f55",
      "flags": 0,
      "text": "JESSIE: Just let us through already!"
    },
    {
      "index": 1,
      "id": "msg_sub085_rocketm_01",
      "hash": "776568bd7cee60a0",
      "flags": 0,
      "text": "No way! Only authorized members are allowed.\\nI was told to let no one else in."
    },
    {
      "index": 2,
      "id": "msg_sub085_kojiro_01",
      "hash": "26e795e55c88e1ff",
      "flags": 0,
      "text": "JAMES: How can you say that when we’re on\\nthe same side?!"
    },
    {
      "index": 3,
      "id": "msg_sub085_musasi_02",
      "hash": "5ea00fdf50658a3c",
      "flags": 0,
      "text": "JESSIE: How rude! You’d deny a beautiful girl\\nwhat she wants?"
    },
    {
      "index": 4,
      "id": "msg_sub085_musasi_03",
      "hash": "5ea010df50658bef",
      "flags": 0,
      "text": "Move it, already!"
    },
    {
      "index": 5,
      "id": "msg_sub085_kojiro_02",
      "hash": "26e796e55c88e3b2",
      "flags": 0,
      "text": "JAMES: Hey! Jessie! Wait for me!"
    },
    {
      "index": 6,
      "id": "msg_sub085_stop_01",
      "hash": "7a5645749be1654b",
      "flags": 4,
      "text": "I’m a security guard.\\nAnd I don’t let suspicious kids in!"
    },
    {
      "index": 7,
      "id": "msg_sub085_stop_02",
      "hash": "7a5646749be166fe",
      "flags": 0,
      "text": "Blurg..."
    },
    {
      "index": 8,
      "id": "msg_sub085_stop_03",
      "hash": "7a5647749be168b1",
      "flags": 0,
      "text": "Looks like he blacked out..."
    }
  ],
