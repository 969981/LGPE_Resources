{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main_0480_rocket_m1_01",
      "hash": "6258d6e3740e5dd7",
      "flags": 0,
      "text": "Wha— Hey!\\c\\nYou’re the kid that’s been getting in our way\\nall the time!"
    },
    {
      "index": 1,
      "id": "msg_main_0480_rocket_m2_01",
      "hash": "8e5fbee9d57839c0",
      "flags": 4,
      "text": "It’s because of you that Team Rocket’s reputation\\nwas totally smashed!"
    },
    {
      "index": 2,
      "id": "msg_main_0480_rocket_m3_01",
      "hash": "e60c0af171f799b5",
      "flags": 0,
      "text": "We’ll never be able to face the boss at this rate!"
    },
    {
      "index": 3,
      "id": "msg_main_0480_rocket_f1_01",
      "hash": "8c0ba2ae99d8afd2",
      "flags": 0,
      "text": "...Which means we’ll have to take our revenge\\non you!"
    },
    {
      "index": 4,
      "id": "msg_main_0480_kanna_01",
      "hash": "a9a0a74348c0618b",
      "flags": 0,
      "text": "???: Hold it!"
    },
    {
      "index": 5,
      "id": "msg_main_0480_kanna_02",
      "hash": "a9a0a84348c0633e",
      "flags": 0,
      "text": "Ganging up on a child...\\nI absolutely can’t forgive that."
    },
    {
      "index": 6,
      "id": "msg_main_0480_rocket_m1_02",
      "hash": "6258d7e3740e5f8a",
      "flags": 0,
      "text": "Who’re you, lady? We’ll gang up and take you\\non, too!"
    },
    {
      "index": 7,
      "id": "msg_main_0480_kanna_03",
      "hash": "a9a0a94348c064f1",
      "flags": 0,
      "text": "???: I’ll handle these three."
    },
    {
      "index": 8,
      "id": "msg_main_0480_kanna_11",
      "hash": "a9a42b4348c377ae",
      "flags": 0,
      "text": "Could you take that other one for me?"
    },
    {
      "index": 9,
      "id": "msg_main_0480_select_01",
      "hash": "68ac863d3423b95a",
      "flags": 0,
      "text": "Leave it to me!"
    },
    {
      "index": 10,
      "id": "msg_main_0480_select_02",
      "hash": "68ac853d3423b7a7",
      "flags": 4,
      "text": "I don’t know..."
    },
    {
      "index": 11,
      "id": "msg_main_0480_kanna_04",
      "hash": "a9a0aa4348c066a4",
      "flags": 0,
      "text": "???: Good answer! Now then, let’s go!"
    },
    {
      "index": 12,
      "id": "msg_main_0480_kanna_05",
      "hash": "a9a0ab4348c06857",
      "flags": 0,
      "text": "???: There’s no use backing down now!\\nHere we go!"
    },
    {
      "index": 13,
      "id": "msg_main_0480_rocket_m1_03",
      "hash": "6258d8e3740e613d",
      "flags": 0,
      "text": "Jeez, kid, just how strong are you?!"
    },
    {
      "index": 14,
      "id": "msg_main_0480_rocket_f1_02",
      "hash": "8c0ba1ae99d8ae1f",
      "flags": 4,
      "text": "Even three of us rushing you wasn’t enough!"
    },
    {
      "index": 15,
      "id": "msg_main_0480_rocket_f1_03",
      "hash": "8c0ba0ae99d8ac6c",
      "flags": 0,
      "text": "Those incredibly powerful Ice-type Pokémon...\\c\\nWho are you?"
    },
    {
      "index": 16,
      "id": "msg_main_0480_kanna_06",
      "hash": "a9a0ac4348c06a0a",
      "flags": 0,
      "text": "LORELEI: I am Lorelei of the Pokémon League’s\\n[VAR COLOR(0006)]Elite Four[VAR COLOR(0000)]!"
    },
    {
      "index": 17,
      "id": "msg_main_0480_kanna_12",
      "hash": "a9a42a4348c375fb",
      "flags": 0,
      "text": "Shall I freeze you all solid, too?"
    },
    {
      "index": 18,
      "id": "msg_main_0480_rocket_m1_04",
      "hash": "6258d1e3740e5558",
      "flags": 4,
      "text": "E-Elite Four?!\\nWe surrender!"
    },
    {
      "index": 19,
      "id": "msg_main_0480_kanna_07",
      "hash": "a9a0ad4348c06bbd",
      "flags": 0,
      "text": "LORELEI: You’re a pretty talented Trainer. It was\\nplain to see during your battle."
    },
    {
      "index": 20,
      "id": "msg_main_0480_kanna_08",
      "hash": "a9a09e4348c05240",
      "flags": 4,
      "text": "I see. So you’re collecting Gym Badges."
    },
    {
      "index": 21,
      "id": "msg_main_0480_kanna_09",
      "hash": "a9a09f4348c053f3",
      "flags": 4,
      "text": "I look forward to when you come to challenge\\nthe Pokémon League."
    },
    {
      "index": 22,
      "id": "msg_main_0480_kanna_10",
      "hash": "a9a42c4348c37961",
      "flags": 4,
      "text": "Until then, see ya!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0480_max",
      "hash": "6dde8fb1b706475b"
    }
  ]
}
