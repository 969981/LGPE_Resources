{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "poke_waza_01_01",
      "hash": "29fdd1ac6c57525c",
      "flags": 4,
      "text": "Uh...\\nNow who was I again?\\c\\n... ... ...\\n... ... ...\\c\\nOh yes! I’m the Move Deleter!\\nI can make Pokémon forget their moves."
    },
    {
      "index": 1,
      "id": "poke_waza_01_02",
      "hash": "29fdd4ac6c575775",
      "flags": 0,
      "text": "You’re here so I can make your Pokémon forget\\na move, um-hmm?"
    },
    {
      "index": 2,
      "id": "poke_waza_01_03",
      "hash": "29fdd3ac6c5755c2",
      "flags": 0,
      "text": "Which Pokémon would that be?"
    },
    {
      "index": 3,
      "id": "poke_waza_01_04",
      "hash": "29fdceac6c574d43",
      "flags": 0,
      "text": "Just remember me when there’s something you\\nwant to forget!"
    },
    {
      "index": 4,
      "id": "poke_waza_01_05",
      "hash": "29fdcdac6c574b90",
      "flags": 0,
      "text": "What’s that, friend?\\nThat Pokémon only knows one move, you know?"
    },
    {
      "index": 5,
      "id": "poke_waza_01_06",
      "hash": "29fdd0ac6c5750a9",
      "flags": 0,
      "text": "What’s this, friend?\\nEggs don’t know any moves before they hatch."
    },
    {
      "index": 6,
      "id": "poke_waza_01_07",
      "hash": "29fdcfac6c574ef6",
      "flags": 0,
      "text": "Mm-hmm...\\nAnd which move should it forget?"
    },
    {
      "index": 7,
      "id": "poke_waza_01_08",
      "hash": "29fddaac6c5761a7",
      "flags": 4,
      "text": "It was a great success!\\c\\nYour Pokémon has forgotten that it ever even\\nknew [VAR MOVE(0000)]!"
    },
    {
      "index": 8,
      "id": "poke_waza_02_01",
      "hash": "547bc9a122ee9513",
      "flags": 4,
      "text": "Everyone calls me Madam Memorial.\\c\\nI know every move that a Pokémon learns as it\\ngrows, you see.\\c\\nI can also help your Pokémon remember any of\\nthose moves that it has let go in the past.\\c\\nI’ll help your Pokémon recover their lost moves\\nin exchange for Heart Scales, if you have any."
    },
    {
      "index": 9,
      "id": "poke_waza_02_02",
      "hash": "547bcaa122ee96c6",
      "flags": 0,
      "text": "Do you want to remind your Pokémon of a move\\nin exchange for [VAR INDEF_ART(0000)][VAR ITEM2(0000)]?"
    },
    {
      "index": 10,
      "id": "poke_waza_02_03",
      "hash": "547bcba122ee9879",
      "flags": 4,
      "text": "If there’s a move you want one of your Pokémon\\nto recall, bring me a [VAR ITEM2(0000)]!"
    },
    {
      "index": 11,
      "id": "poke_waza_02_04",
      "hash": "547bcca122ee9a2c",
      "flags": 0,
      "text": "Which Pokémon is it?"
    },
    {
      "index": 12,
      "id": "poke_waza_02_05",
      "hash": "547bcda122ee9bdf",
      "flags": 0,
      "text": "That is an Egg."
    },
    {
      "index": 13,
      "id": "poke_waza_02_06",
      "hash": "547bcea122ee9d92",
      "flags": 0,
      "text": "This Pokémon doesn’t yet have any moves to\\nbe recovered."
    },
    {
      "index": 14,
      "id": "poke_waza_02_07",
      "hash": "547bcfa122ee9f45",
      "flags": 0,
      "text": "Which move would you like it to remember?"
    },
    {
      "index": 15,
      "id": "poke_waza_02_13",
      "hash": "547f4ba122f1a7d0",
      "flags": 0,
      "text": "You gave a [VAR ITEM2(0000)] in thanks."
    },
    {
      "index": 16,
      "id": "poke_waza_02_14",
      "hash": "547f52a122f1b3b5",
      "flags": 0,
      "text": "Now it has remembered that move!\\nCome again if you need anything else!"
    },
    {
      "index": 17,
      "id": "poke_waza_02_15",
      "hash": "547f51a122f1b202",
      "flags": 4,
      "text": "One...[WAIT 20]two...[WAIT 20]and...[WAIT 20]ta-da![VAR SFX(0003)][VAR SFX(0000)]\\c\\n[VAR PKNICK(0000)] forgot [VAR MOVE(0001)]!\\c\\nAnd it remembered [VAR MOVE(0002)] instead![VAR SFX(0004)][VAR SFX(0001)]"
    },
    {
      "index": 18,
      "id": "poke_waza_02_16",
      "hash": "547f50a122f1b04f",
      "flags": 0,
      "text": "[VAR PKNICK(0000)] learned [VAR MOVE(0002)]![VAR SFX(0004)][VAR SFX(0001)]"
    },
    {
