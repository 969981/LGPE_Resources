    {
      "index": 15,
      "id": "msg_town008_fat_01",
      "hash": "1e2bdb6d43ba0e65",
      "flags": 4,
      "text": "ERIK: Where’s Sara?\\nI said I’d meet her here to catch Pokémon...\\r\\nBut all I’m catching are some weird looks!"
