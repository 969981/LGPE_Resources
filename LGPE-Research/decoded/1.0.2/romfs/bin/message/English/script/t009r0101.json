    {
      "index": 0,
      "id": "msg_t009r0101_researcher_01",
      "hash": "6c99d42dae79fe51",
      "flags": 0,
      "text": "We study Pokémon here, day in and day out.\\c\\nPeople even bring us rare Pokémon to examine."
    },
    {
      "index": 1,
      "id": "msg_t009r0101_researcher_02",
      "hash": "6c99d12dae79f938",
      "flags": 0,
      "text": "Did you come to have a look at our lab?\\nMost impressive! I like to see that kind of drive!"
    },
    {
      "index": 2,
      "id": "msg_t009r0101_researcher_03",
      "hash": "6c99d22dae79faeb",
      "flags": 0,
      "text": "HEY!\\nNo running in the hallways!\\c\\n...Boy, I’ve always wanted the chance to say\\nsomething like that!"
    },
    {
      "index": 3,
      "id": "msg_t009r0101_picture_01",
      "hash": "d27a50d1b0482927",
      "flags": 4,
      "text": "It’s a photo of the Cinnabar Lab’s\\nfounder—Dr. Fuji!"
    },
    {
      "index": 4,
      "id": "msg_t009r0101_kanban_01",
      "hash": "f31ef3f980dacb0e",
