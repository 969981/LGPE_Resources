    {
      "index": 7,
      "id": "msg_sub028_select_04",
      "hash": "99187d9606bfd29d",
      "flags": 0,
      "text": "Cancel"
    },
    {
      "index": 8,
      "id": "msg_sub017_system_03",
      "hash": "6b07f3203d385449",
      "flags": 0,
      "text": "You don’t have enough money!\\c\\n...What’s this? You found ₽500 in one of\\nyour pockets!"
    },
    {
      "index": 9,
      "id": "msg_sub017_system_04",
      "hash": "6b07f4203d3855fc",
      "flags": 0,
      "text": "You gave [VAR PKNICK(0003)]\\nthe [VAR ITEMBAG(0002)]."
    },
    {
      "index": 10,
      "id": "msg_sub017_partner_a_02",
      "hash": "93b1bd4a1a433a9b",
      "flags": 0,
      "text": "Pika! Pika pika!"
