    {
      "index": 11,
      "id": "msg_sub017_partner_b_02",
      "hash": "9828fb60ed950828",
      "flags": 4,
      "text": "Eev eev eveee!"
    },
    {
      "index": 12,
      "id": "msg_sub017_system_05",
      "hash": "6b07f5203d3857af",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] seems happy that it got to\\ndrink the Fresh Water."
    },
    {
      "index": 13,
      "id": "msg_sub017_system_06",
      "hash": "6b07f6203d385962",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] seems surprised by\\nthe Soda Pop’s fizz!"
    },
    {
      "index": 14,
      "id": "msg_sub017_system_07",
      "hash": "6b07f7203d385b15",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] seems enamored with\\nthe Lemonade’s smooth taste."
