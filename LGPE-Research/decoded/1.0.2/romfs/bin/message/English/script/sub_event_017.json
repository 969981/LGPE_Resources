      "text": "Eev? Evee evee?"
    },
    {
      "index": 2,
      "id": "msg_sub017_system_01",
      "hash": "6b07f1203d3850e3",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] seems to be curious about\\nthe vending machine."
    },
    {
      "index": 3,
      "id": "msg_sub017_system_02",
      "hash": "6b07f2203d385296",
      "flags": 0,
      "text": "Do you want to buy it a drink?"
    },
    {
      "index": 4,
      "id": "msg_sub017_select_01",
      "hash": "47853b7097ab1b90",
      "flags": 0,
      "text": "Fresh Water [VAR SYMBOL(0000)]₽[VAR NUM3(0001)]"
    },
    {
      "index": 5,
      "id": "msg_sub017_select_02",
      "hash": "47853e7097ab20a9",
      "flags": 0,
      "text": "Soda Pop [VAR SYMBOL(0000)]₽[VAR NUM3(0001)]"
    },
    {
      "index": 6,
      "id": "msg_sub028_select_03",
      "hash": "9918769606bfc6b8",
      "flags": 0,
      "text": "Lemonade [VAR SYMBOL(0000)]₽[VAR NUM3(0001)]"
