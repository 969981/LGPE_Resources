{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8110_combat_01",
      "hash": "2862f3f0a8471eb5",
      "flags": 0,
      "text": "BRUNO: I am Bruno of the Elite Four!"
    },
    {
      "index": 1,
      "id": "msg_main8110_combat_05",
      "hash": "2862eff0a84717e9",
      "flags": 0,
      "text": "Through rigorous training, people and Pokémon\\ncan become stronger—without limit."
    },
    {
      "index": 2,
      "id": "msg_main8110_combat_06",
      "hash": "2862ecf0a84712d0",
      "flags": 4,
      "text": "I’ve lived and trained with\\nmy Fighting-type Pokémon!\\r\\nAnd that will never change!"
    },
    {
      "index": 3,
      "id": "msg_main8110_combat_07",
      "hash": "2862edf0a8471483",
      "flags": 0,
      "text": "[VAR TRNAME(0000)], was it?"
    },
    {
      "index": 4,
      "id": "msg_main8110_combat_08",
      "hash": "2862faf0a8472a9a",
      "flags": 0,
      "text": "We will grind you down with our superior power!"
    },
    {
      "index": 5,
      "id": "msg_main8110_combat_09",
      "hash": "2862fbf0a8472c4d",
      "flags": 0,
      "text": "Hoo hah!"
    },
    {
      "index": 6,
      "id": "msg_shiba_01_p02_cave_d1402",
      "hash": "72418348ba117edb",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main8110_combat_02",
      "hash": "2862f0f0a847199c",
      "flags": 0,
      "text": "BRUNO: If you have defeated me, then my\\njob is done.\\c\\nUgh! I may not like it, but...go!\\nGo face your next challenge!"
    },
    {
      "index": 8,
      "id": "msg_main8110_combat_03",
      "hash": "2862f1f0a8471b4f",
      "flags": 0,
      "text": "BRUNO: I could feel the intensity of your battle\\nwith Lorelei, even from here!"
    },
    {
      "index": 9,
      "id": "msg_main8110_combat_10",
      "hash": "2865f8f0a8495d0b",
      "flags": 0,
      "text": "Now it’s time to show you the power of my\\nFighting-type Pokémon, who I’ve been training\\r\\njust as hard as you’ve trained your team, surely!"
    },
    {
      "index": 10,
      "id": "msg_main8110_combat_11",
      "hash": "2865f7f0a8495b58",
      "flags": 0,
      "text": "Hoo hah!\\nHoo! HAH!!!"
    },
    {
      "index": 11,
      "id": "msg_main8110_combat_04",
      "hash": "2862eef0a8471636",
      "flags": 4,
      "text": "Ugh! No!\\nSo my training is still lacking, is that it?\\c\\n...Go. Do not trouble yourself on my behalf.\\nContinue to move forward!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_8110_max",
      "hash": "ec1bedabba5a271d"
    }
  ]
}
