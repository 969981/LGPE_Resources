{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t007r0503_shortpants_01",
      "hash": "74b0ff4fa16bdce3",
      "flags": 0,
      "text": "[~ 0]"
    },
    {
      "index": 1,
      "id": "msg_t007r0503_jevenilem_01",
      "hash": "e4384f0ab442ee86",
      "flags": 0,
      "text": "Sweet! This kid says he’ll trade me a Kangaskhan\\nfor my Haunter!"
    },
    {
      "index": 2,
      "id": "msg_t007r0503_jevenilem_02",
      "hash": "e4384e0ab442ecd3",
      "flags": 0,
      "text": "Come to me, my new Haunter!\\c\\nI absolutely love Haunter! I collect them!\\c\\n...Huh?\\c\\nHaunter evolved into a different Pokémon while\\nit was being traded?!"
    },
    {
      "index": 3,
      "id": "msg_t007r0503_chilef_01",
      "hash": "97b8808b2d55e818",
      "flags": 0,
      "text": "You can tell which Pokémon you got from other\\npeople because their IDs are different."
    },
    {
      "index": 4,
      "id": "msg_t007r0503_game_01",
      "hash": "92d1753fbd58e1f1",
      "flags": 4,
      "text": "It’s a Nintendo Switch!"
    },
    {
      "index": 5,
      "id": "msg_t007r0503_game_02",
      "hash": "92d1723fbd58dcd8",
      "flags": 4,
      "text": "Oooh, it’s a role-playing game!\\n...Not that you’ve got any time for that!"
    },
    {
      "index": 6,
      "id": "msg_t007r0503_game_03",
      "hash": "92d1733fbd58de8b",
      "flags": 4,
      "text": "A sports game!\\nI bet Dad would like that!"
    },
    {
      "index": 7,
      "id": "msg_t007r0503_game_04",
      "hash": "92d1783fbd58e70a",
      "flags": 0,
      "text": "Look, a puzzle game!\\nSeems like the type that would be hard to quit."
    },
    {
      "index": 8,
      "id": "msg_t007r0503_game_05",
      "hash": "92d1793fbd58e8bd",
      "flags": 4,
      "text": "A fighting game!\\nIt looks pretty difficult!"
    },
    {
      "index": 9,
      "id": "msg_t007r0503_kanban_01",
      "hash": "fa4116cb02ff9bc2",
      "flags": 0,
      "text": "“3F: Video Game Shop”"
    },
    {
      "index": 10,
      "id": "msg_t007r0503_poster_01",
      "hash": "ae05700f9e7f81a4",
      "flags": 0,
      "text": "“You can choose either Pikachu or Eevee!\\nEither way, they’re both Pokémon!”"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t007r0503_max",
      "hash": "05def5c8f79e5187"
    }
  ]
}
