{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_fld_hiden_01",
      "hash": "c3075734bbf2e150",
      "flags": 4,
      "text": "It seems this tree can be chopped down! Do you\\nwant to use the Secret Technique Chop Down?"
    },
    {
      "index": 1,
      "id": "msg_fld_hiden_02",
      "hash": "c3075a34bbf2e669",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] used Chop Down!"
    },
    {
      "index": 2,
      "id": "msg_fld_hiden_03",
      "hash": "c3075934bbf2e4b6",
      "flags": 0,
      "text": "This tree looks like it can be chopped down!"
    },
    {
      "index": 3,
      "id": "msg_fld_hiden_04",
      "hash": "c3075c34bbf2e9cf",
      "flags": 0,
      "text": "There is nothing you can chop with\\nChop Down here!"
    },
    {
      "index": 4,
      "id": "msg_fld_hiden_05",
      "hash": "c3075b34bbf2e81c",
      "flags": 4,
      "text": "It’s a big block. Do you want to use the Secret\\nTechnique Strong Push?"
    },
    {
      "index": 5,
      "id": "msg_fld_hiden_06",
      "hash": "c3075e34bbf2ed35",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] used Strong Push!\\c\\n[VAR PKNICK(0003)]’s Strong Push made it possible\\nto move blocks around!"
    },
    {
      "index": 6,
      "id": "msg_fld_hiden_07",
      "hash": "c3075d34bbf2eb82",
      "flags": 4,
      "text": "It’s a heavy-looking block...\\nBut a strong push might be able to move it!"
    },
    {
      "index": 7,
      "id": "msg_fld_hiden_08",
      "hash": "c3076034bbf2f09b",
      "flags": 0,
      "text": "Strong Push made it possible to move\\nblocks around."
    },
    {
      "index": 8,
      "id": "msg_fld_hiden_19",
      "hash": "c303eb34bbeff3f5",
      "flags": 4,
      "text": "A wall that was blocking a path came down!"
    },
    {
      "index": 9,
      "id": "msg_fld_hiden_20",
      "hash": "c3006c34bbece651",
      "flags": 0,
      "text": "*click*"
    },
    {
      "index": 10,
      "id": "msg_fld_hiden_09",
      "hash": "c3075f34bbf2eee8",
      "flags": 0,
      "text": "The water is moving... Do you want to\\nuse the Secret Technique Sea Skim?"
    },
    {
      "index": 11,
      "id": "msg_fld_hiden_10",
      "hash": "c303f234bbefffda",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] used Sea Skim!"
    },
    {
      "index": 12,
      "id": "msg_fld_hiden_11",
      "hash": "c303f334bbf0018d",
      "flags": 4,
      "text": "It seems Sea Skim can’t be used here..."
    },
    {
      "index": 13,
      "id": "msg_fld_hiden_12",
      "hash": "c303f034bbeffc74",
      "flags": 0,
      "text": "The water is moving gently..."
    },
    {
      "index": 14,
      "id": "msg_fld_hiden_13",
      "hash": "c303f134bbeffe27",
      "flags": 4,
      "text": "It’s pitch black in here. Do you want to use\\nthe Secret Technique Light Up?"
    },
    {
      "index": 15,
      "id": "msg_fld_hiden_14",
      "hash": "c303ee34bbeff90e",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] used Light Up!\\nYou started seeing your surroundings!"
    },
    {
      "index": 16,
      "id": "msg_fld_hiden_17",
      "hash": "c303ed34bbeff75b",
      "flags": 4,
      "text": "It’s pitch black in here.\\nIt looks difficult to move forward..."
    },
    {
      "index": 17,
      "id": "msg_fld_hiden_18",
      "hash": "c303ea34bbeff242",
      "flags": 4,
      "text": "It won’t have any effect."
    },
    {
      "index": 18,
      "id": "msg_fld_hiden_15",
      "hash": "c303ef34bbeffac1",
      "flags": 0,
      "text": "Do you want to use the Secret Technique\\nSky Dash to fly to [VAR LOCATION(0000)]?"
    },
    {
      "index": 19,
      "id": "msg_fld_hiden_16",
      "hash": "c303ec34bbeff5a8",
      "flags": 0,
      "text": "[VAR PKNICK(0003)] used Sky Dash and soared\\ninto the sky!"
    },
    {
      "index": 20,
      "id": "msg_fld_select_01",
      "hash": "4eb6529034653db6",
      "flags": 0,
      "text": "Yes"
    },
    {
      "index": 21,
      "id": "msg_fld_select_02",
      "hash": "4eb6519034653c03",
      "flags": 0,
      "text": "No"
    },
    {
      "index": 22,
      "id": "msg_fld_ev_spray_01",
      "hash": "5c28fa0044bd5c69",
      "flags": 0,
      "text": "The repellent’s effect wore off!"
    },
    {
      "index": 23,
      "id": "msg_fld_ev_spray_02",
      "hash": "5c28f70044bd5750",
      "flags": 0,
      "text": "The repellent’s effect wore off!\\nWould you like to use another one?"
    },
    {
      "index": 24,
      "id": "msg_fld_ev_spray_03",
      "hash": "5c28f80044bd5903",
      "flags": 0,
      "text": "You used [VAR INDEF_ART(0001)][VAR ITEM2(0001)]."
    },
    {
      "index": 25,
      "id": "msg_fld_ev_bookshelf_01",
      "hash": "d2e186b675233e1f",
      "flags": 4,
      "text": "It’s chock-full of Pokémon books and photo\\ncollections."
    },
    {
      "index": 26,
      "id": "msg_fld_ev_kowaserurock_01",
      "hash": "82155501d67638d0",
      "flags": 4,
      "text": "It’s a sturdy-looking rock.\\nMaybe a powerful Pokémon could break it..."
    },
    {
      "index": 27,
      "id": "msg_fld_ev_tv_common_01",
      "hash": "5f755c2798a62f24",
      "flags": 4,
      "text": "A lady and her Pokémon are reporting on the\\nday’s latest news."
    },
    {
      "index": 28,
      "id": "msg_fld_ev_oserurock_01",
      "hash": "2d2b876ebccb41e5",
      "flags": 4,
      "text": "It’s a big heavy-looking boulder.\\nMaybe a powerful Pokémon could move it..."
    },
    {
      "index": 29,
      "id": "msg_egg_event_01",
      "hash": "cc883b93ea002f97",
      "flags": 0,
      "text": "...Oh?"
    },
    {
      "index": 30,
      "id": "msg_ride_check_01",
      "hash": "6dc3493c009990b8",
      "flags": 0,
      "text": "Do you want to call Tauros?"
    },
    {
      "index": 31,
      "id": "msg_ride_check_02",
      "hash": "6dc34c3c009995d1",
      "flags": 0,
      "text": "Do you want to call Machamp?"
    },
    {
      "index": 32,
      "id": "msg_ride_check_03",
      "hash": "6dc34b3c0099941e",
      "flags": 0,
      "text": "Do you want to call Sharpedo?"
    },
    {
      "index": 33,
      "id": "msg_ride_check_ng_01",
      "hash": "6d36fe6fcfb55062",
      "flags": 0,
      "text": "There is not enough space to call this\\nRide Pokémon here."
    },
    {
      "index": 34,
      "id": "msg_fld_ev_colon_01",
      "hash": "205807eddd52f34f",
      "flags": 0,
      "text": "The lure’s effect wore off!"
    },
    {
      "index": 35,
      "id": "msg_fld_ev_colon_02",
      "hash": "205808eddd52f502",
      "flags": 0,
      "text": "The lure’s effect wore off!\\nWould you like to use another one?"
    },
    {
      "index": 36,
      "id": "msg_fld_ev_boxfull_01",
      "hash": "9442742ebe9d881a",
      "flags": 0,
      "text": "Your Pokémon Box is full!\\n...Come back later."
    },
    {
      "index": 37,
      "id": "msg_fld_ev_no_push_01",
      "hash": "55f78515b56260be",
      "flags": 0,
      "text": "You can’t push it any farther!"
    },
    {
      "index": 38,
      "id": "msg_fld_ev_no_push_02",
      "hash": "55f78415b5625f0b",
      "flags": 0,
      "text": "You can’t push it from this direction!"
    }
  ],
