{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "pmgo_set_win_01",
      "hash": "50aeeea835eb51b0",
      "flags": 0,
      "text": "Pokémon GO와 통신할 수 있도록\\n페어링을 진행하겠습니까?"
    },
    {
      "index": 1,
      "id": "pmgo_set_win_02",
      "hash": "50aef1a835eb56c9",
      "flags": 0,
      "text": "Pokémon GO를 찾고 있습니다"
    },
    {
      "index": 2,
      "id": "pmgo_set_win_03",
      "hash": "50aef0a835eb5516",
      "flags": 0,
      "text": "[VAR PGOTRAINER(0000)]님을 찾았습니다\\n페어링하겠습니까?"
    },
    {
      "index": 3,
      "id": "pmgo_set_win_04",
      "hash": "50aef3a835eb5a2f",
      "flags": 0,
      "text": "통신하고 있습니다\\n전원을 끄지 않도록 해주십시오"
    },
    {
      "index": 4,
      "id": "pmgo_set_win_05",
      "hash": "50aef2a835eb587c",
      "flags": 0,
      "text": "[VAR PGOTRAINER(0000)]님의\\nPokémon GO와 페어링했습니다!\\n\\n연분홍시티에 있는\\nGO파크에서\\n포켓몬을 전송할 수 있습니다"
    },
    {
      "index": 5,
      "id": "pmgo_set_win_06",
      "hash": "50aef5a835eb5d95",
      "flags": 0,
      "text": "[VAR GOPARKLOCAL(0001)]에는\\n[VAR NUM3(0000)]마리 더 데려갈 수 있습니다"
    },
    {
      "index": 6,
      "id": "pmgo_set_win_07",
      "hash": "50aef4a835eb5be2",
      "flags": 0,
      "text": "포켓몬의 수가 50마리를 초과하여\\n[VAR GOPARKLOCAL(0000)]에\\n포켓몬을 전송할 수 없습니다\\n\\n[VAR GOPARKLOCAL(0000)]의\\n포켓몬을 정리하거나\\n다른 GO파크를 선택해 주십시오"
    },
    {
      "index": 7,
      "id": "pmgo_set_win_08",
      "hash": "50aef7a835eb60fb",
      "flags": 0,
      "text": "Pokémon GO와 페어링\\n되어 있지 않습니다\\n\\nX 메뉴의 “설정”에서\\n“Pokémon GO와 접속”을 선택해\\n페어링을 진행해 주십시오"
    },
    {
      "index": 8,
      "id": "pmgo_set_win_09",
      "hash": "50aef6a835eb5f48",
      "flags": 0,
      "text": "복구하기 위해\\nPokémon GO와 통신하고 있습니다\\n전원을 끄지 않고\\n그대로 기다려 주십시오"
    },
    {
      "index": 9,
      "id": "pmgo_set_win_10",
      "hash": "50ab89a835e8703a",
      "flags": 0,
      "text": "전송하려는 포켓몬이\\n사라질 수도 있습니다\\n정말 그만두겠습니까?"
    },
    {
      "index": 10,
      "id": "pmgo_set_win_11",
      "hash": "50ab8aa835e871ed",
      "flags": 0,
      "text": "Pokémon GO에 포켓몬이\\n남아 있습니다\\n\\n다시 한 번 처음부터\\n시도해 주십시오"
    },
    {
      "index": 11,
      "id": "pmgo_set_win_12",
      "hash": "50ab87a835e86cd4",
      "flags": 0,
      "text": "종료하고 있습니다\\n잠시 기다려 주십시오"
    },
    {
      "index": 12,
      "id": "pmgo_set_win_13",
      "hash": "50ab88a835e86e87",
      "flags": 0,
      "text": "[VAR PGOTRAINER(0000)]님의\\nPokémon GO에서\\n포켓몬이 [VAR NUM4(0001,0000)]마리\\n전송되었습니다\\n\\n[VAR GOPARKLOCAL(0002)][VAR VARKOR00(0002)]\\n확인해 주세요!"
    },
    {
      "index": 13,
      "id": "pmgo_set_win_14",
      "hash": "50ab85a835e8696e",
      "flags": 0,
      "text": "[VAR PGOTRAINER(0000)]님이 전송하는\\n포켓몬은 [VAR NUM4(0001,0000)]마리입니다만\\n[VAR GOPARKLOCAL(0003)]에는\\n[VAR NUM3(0002)]마리만 더 들어갈 수 있습니다"
    },
    {
      "index": 14,
      "id": "pmgo_set_win_15",
      "hash": "50ab86a835e86b21",
      "flags": 0,
      "text": "[VAR PGOTRAINER(0000)]님을 찾았습니다\\n포켓몬을 받겠습니까?"
    },
    {
      "index": 15,
      "id": "pmgo_set_win_16",
      "hash": "50ab83a835e86608",
      "flags": 0,
      "text": "“포켓몬스터 레츠고! 피카츄･\\n레츠고! 이브이”를\\n“Pokémon GO”에 접속할 때\\n게임 식별 유저 ID\\n게임의 기술 정보가\\n“Pokémon GO”에 송신됩니다"
    },
    {
      "index": 16,
      "id": "pmgo_set_sel_01",
      "hash": "4950366029620392",
      "flags": 0,
      "text": "예"
    },
    {
      "index": 17,
      "id": "pmgo_set_sel_02",
      "hash": "49503560296201df",
      "flags": 0,
      "text": "아니요"
    },
    {
      "index": 18,
      "id": "pmgo_set_sel_03",
      "hash": "495034602962002c",
      "flags": 0,
      "text": "계속한다"
    },
    {
      "index": 19,
      "id": "pmgo_set_sel_04",
      "hash": "495033602961fe79",
      "flags": 0,
      "text": "그만둔다"
    },
    {
      "index": 20,
      "id": "pmgo_set_sel_05",
      "hash": "495032602961fcc6",
      "flags": 0,
      "text": "통신을 시작한다"
    },
    {
      "index": 21,
      "id": "pmgo_set_cap_01",
      "hash": "619e152042febb32",
      "flags": 0,
      "text": "시작한다"
    },
    {
      "index": 22,
      "id": "pmgo_set_cap_02",
      "hash": "619e142042feb97f",
      "flags": 0,
      "text": "그만둔다"
    },
    {
      "index": 23,
      "id": "pmgo_set_cap_03",
      "hash": "619e132042feb7cc",
      "flags": 0,
      "text": "끝낸다"
    },
    {
      "index": 24,
      "id": "pmgo_set_cap_04",
      "hash": "619e122042feb619",
      "flags": 0,
      "text": "[VAR NUM3(0000)]%"
    }
  ],
