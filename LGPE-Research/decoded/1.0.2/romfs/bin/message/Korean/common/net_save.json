{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "net_save_win_01",
      "hash": "eeefe4d96acc1c25",
      "flags": 0,
      "text": "리포트를 작성하고 있습니다\\n잠시 기다려 주십시오"
    },
    {
      "index": 1,
      "id": "net_save_win_02",
      "hash": "eeefe1d96acc170c",
      "flags": 0,
      "text": "주의!\\n\\n교환을 하는 도중\\n통신 에러나 본체의\\n전원이 끊기면\\n한동안 포켓몬 교환을\\n할 수 없습니다"
    },
    {
      "index": 2,
      "id": "net_save_win_03",
      "hash": "eeefe2d96acc18bf",
      "flags": 0,
      "text": "통신 대기 중입니다\\n잠시 기다려 주십시오"
    },
    {
      "index": 3,
      "id": "net_save_win_04",
      "hash": "eeefdfd96acc13a6",
      "flags": 0,
      "text": "교환을\\n종료하겠습니까?"
    },
    {
      "index": 4,
      "id": "net_save_sel_01",
      "hash": "0bb15cc36812039f",
      "flags": 0,
      "text": "예"
    },
    {
      "index": 5,
      "id": "net_save_sel_02",
      "hash": "0bb15dc368120552",
      "flags": 0,
      "text": "아니요"
    },
    {
      "index": 6,
      "id": "net_save_sel_03",
      "hash": "0bb15ec368120705",
      "flags": 0,
      "text": "취소"
    },
    {
      "index": 7,
      "id": "net_save_win_05",
      "hash": "eeefe0d96acc1559",
      "flags": 0,
      "text": "종료가 선택되었습니다\\n교환을 종료합니다"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_net_save_max",
      "hash": "554f57b39e511787"
    }
  ]
}
