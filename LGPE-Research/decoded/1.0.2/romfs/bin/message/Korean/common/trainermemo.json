      "flags": 0,
      "text": "맷집이 강함."
    },
    {
      "index": 67,
      "id": "trmemo_03_03_02",
      "hash": "969f4962993ff2f0",
      "flags": 0,
      "text": "끈질김."
    },
    {
      "index": 68,
      "id": "trmemo_03_03_03",
      "hash": "969f4a62993ff4a3",
      "flags": 0,
      "text": "인내심이 강함."
    },
    {
      "index": 69,
      "id": "trmemo_03_03_04",
      "hash": "969f4f62993ffd22",
      "flags": 0,
      "text": "잘 참음."
    },
    {
      "index": 70,
      "id": "trmemo_03_04_00",
      "hash": "8e3d25286f90f80d",
      "flags": 0,
      "text": "달리기를 좋아함."
    },
    {
      "index": 71,
      "id": "trmemo_03_04_01",
      "hash": "8e3d24286f90f65a",
      "flags": 0,
      "text": "주위 소리에 민감함."
    },
    {
      "index": 72,
      "id": "trmemo_03_04_02",
      "hash": "8e3d23286f90f4a7",
      "flags": 0,
      "text": "촐랑대는 성격임."
    },
    {
      "index": 73,
      "id": "trmemo_03_04_03",
      "hash": "8e3d22286f90f2f4",
      "flags": 0,
      "text": "약간 우쭐쟁이임."
    },
    {
      "index": 74,
      "id": "trmemo_03_04_04",
      "hash": "8e3d21286f90f141",
      "flags": 0,
      "text": "도망에는 선수임."
    },
    {
      "index": 75,
      "id": "trmemo_03_05_00",
      "hash": "ba440f2ed0fad75c",
      "flags": 0,
      "text": "호기심이 강함."
    },
    {
      "index": 76,
      "id": "trmemo_03_05_01",
      "hash": "ba44102ed0fad90f",
      "flags": 0,
      "text": "장난을 좋아함."
    },
    {
      "index": 77,
      "id": "trmemo_03_05_02",
      "hash": "ba44112ed0fadac2",
      "flags": 0,
      "text": "빈틈이 없음."
    },
    {
      "index": 78,
      "id": "trmemo_03_05_03",
      "hash": "ba44122ed0fadc75",
      "flags": 0,
      "text": "걱정거리가 많음."
    },
    {
      "index": 79,
      "id": "trmemo_03_05_04",
      "hash": "ba440b2ed0fad090",
      "flags": 0,
      "text": "매우 꼼꼼함."
    },
    {
      "index": 80,
      "id": "trmemo_03_06_00",
      "hash": "64fa5938e0071b6b",
      "flags": 0,
      "text": "기가 센 성격임."
    },
    {
      "index": 81,
      "id": "trmemo_03_06_01",
      "hash": "64fa5838e00719b8",
      "flags": 0,
      "text": "조금 겉치레를 좋아함."
    },
    {
      "index": 82,
      "id": "trmemo_03_06_02",
      "hash": "64fa5b38e0071ed1",
      "flags": 0,
      "text": "오기가 센 성격임."
    },
    {
      "index": 83,
      "id": "trmemo_03_06_03",
      "hash": "64fa5a38e0071d1e",
      "flags": 0,
      "text": "지기 싫어함."
    },
    {
      "index": 84,
      "id": "trmemo_03_06_04",
      "hash": "64fa5d38e0072237",
      "flags": 0,
      "text": "조금 고집통이임."
    },
    {
      "index": 85,
      "id": "trmemo_01_T_01_01",
