{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "TOKUSEIINFO_000",
      "hash": "7ba40506d12f4b74",
      "flags": 0,
      "text": "-\\n-"
    },
    {
      "index": 1,
      "id": "TOKUSEIINFO_001",
      "hash": "7ba40606d12f4d27",
      "flags": 0,
      "text": "악취를 풍겨서\\n공격했을 때 상대가\\n풀죽을 때가 있다."
    },
    {
      "index": 2,
      "id": "TOKUSEIINFO_002",
      "hash": "7ba40706d12f4eda",
      "flags": 0,
      "text": "등장했을 때\\n날씨를 비로 만든다."
    },
    {
      "index": 3,
      "id": "TOKUSEIINFO_003",
      "hash": "7ba40806d12f508d",
      "flags": 0,
      "text": "매 턴 스피드가 올라간다."
    },
    {
      "index": 4,
      "id": "TOKUSEIINFO_004",
      "hash": "7ba40106d12f44a8",
      "flags": 0,
      "text": "단단한 껍질에 보호받아\\n상대의 공격이\\n급소에 맞지 않는다."
    },
    {
      "index": 5,
      "id": "TOKUSEIINFO_005",
      "hash": "7ba40206d12f465b",
      "flags": 0,
      "text": "상대 기술을 받아도\\n일격으로 쓰러지지 않는다.\\n일격필살 기술도 효과 없다."
    },
    {
      "index": 6,
      "id": "TOKUSEIINFO_006",
      "hash": "7ba40306d12f480e",
      "flags": 0,
      "text": "주변을 습하게 함으로써\\n자폭 등 폭발하는 기술을\\n아무도 못 쓰게 한다."
    },
    {
      "index": 7,
      "id": "TOKUSEIINFO_007",
      "hash": "7ba40406d12f49c1",
      "flags": 0,
      "text": "유연한 몸으로 인해\\n마비 상태가 되지 않는다."
    },
    {
      "index": 8,
      "id": "TOKUSEIINFO_008",
      "hash": "7ba3fd06d12f3ddc",
      "flags": 0,
      "text": "모래바람일 때\\n회피율이 올라간다."
    },
    {
      "index": 9,
      "id": "TOKUSEIINFO_009",
      "hash": "7ba3fe06d12f3f8f",
      "flags": 0,
      "text": "정전기를 몸에 둘러\\n접촉한 상대를\\n마비시킬 때가 있다."
    },
    {
      "index": 10,
      "id": "TOKUSEIINFO_010",
      "hash": "7ba70b06d1318b7d",
      "flags": 0,
      "text": "전기타입의 기술을 받으면\\n데미지를 받지 않고 회복한다."
    },
    {
      "index": 11,
      "id": "TOKUSEIINFO_011",
      "hash": "7ba70a06d13189ca",
      "flags": 0,
      "text": "물타입의 기술을 받으면\\n데미지를 받지 않고 회복한다."
    },
    {
      "index": 12,
      "id": "TOKUSEIINFO_012",
      "hash": "7ba70906d1318817",
      "flags": 0,
      "text": "둔감해서\\n헤롱헤롱이나 도발 상태가\\n되지 않는다."
    },
    {
      "index": 13,
      "id": "TOKUSEIINFO_013",
      "hash": "7ba70806d1318664",
      "flags": 0,
      "text": "모든 날씨의 영향이\\n없어진다."
    },
    {
      "index": 14,
      "id": "TOKUSEIINFO_014",
      "hash": "7ba70706d13184b1",
      "flags": 0,
      "text": "복안을 가지고 있어\\n기술의 명중률이 올라간다."
    },
    {
      "index": 15,
      "id": "TOKUSEIINFO_015",
      "hash": "7ba70606d13182fe",
      "flags": 0,
      "text": "잠들지 못하는 체질이라\\n잠듦 상태가 되지 않는다."
    },
    {
      "index": 16,
      "id": "TOKUSEIINFO_016",
      "hash": "7ba70506d131814b",
      "flags": 0,
      "text": "상대에게 받은 기술의 타입으로\\n자신의 타입이 변화한다."
    },
    {
      "index": 17,
      "id": "TOKUSEIINFO_017",
      "hash": "7ba70406d1317f98",
      "flags": 0,
      "text": "체내에 면역을 가지고 있어\\n독 상태가 되지 않는다."
    },
    {
      "index": 18,
      "id": "TOKUSEIINFO_018",
      "hash": "7ba70306d1317de5",
      "flags": 0,
      "text": "불꽃타입의 기술을 받으면\\n불꽃을 받아서 자신이 사용하는\\n불꽃타입의 기술이 강해진다."
    },
    {
      "index": 19,
      "id": "TOKUSEIINFO_019",
      "hash": "7ba70206d1317c32",
      "flags": 0,
      "text": "인분에 보호받아\\n기술의 추가 효과를 받지 않게 된다."
    },
    {
      "index": 20,
      "id": "TOKUSEIINFO_020",
      "hash": "7baa7106d1346ea6",
      "flags": 0,
      "text": "마이페이스라서\\n혼란 상태가 되지 않는다."
    },
    {
      "index": 21,
      "id": "TOKUSEIINFO_021",
      "hash": "7baa7206d1347059",
      "flags": 0,
      "text": "흡반으로 지면에 달라붙어\\n포켓몬을 교체시키는\\n기술이나 도구의 효과를 발휘하지 못하게 한다."
    },
    {
      "index": 22,
      "id": "TOKUSEIINFO_022",
      "hash": "7baa6f06d1346b40",
      "flags": 0,
      "text": "등장했을 때 위협해서\\n상대를 위축시켜\\n상대의 공격을 떨어뜨린다."
    },
    {
      "index": 23,
      "id": "TOKUSEIINFO_023",
      "hash": "7baa7006d1346cf3",
      "flags": 0,
      "text": "상대의 그림자를 밟아\\n도망치거나 교체할 수 없게 한다."
    },
    {
      "index": 24,
      "id": "TOKUSEIINFO_024",
      "hash": "7baa7506d1347572",
      "flags": 0,
      "text": "공격을 받았을 때\\n자신에게 접촉한 상대를\\n까칠까칠한 피부로 상처를 입힌다."
    },
    {
      "index": 25,
      "id": "TOKUSEIINFO_025",
      "hash": "7baa7606d1347725",
      "flags": 0,
      "text": "효과가 굉장한 기술만\\n맞는 불가사의한 힘."
    },
    {
      "index": 26,
      "id": "TOKUSEIINFO_026",
      "hash": "7baa7306d134720c",
      "flags": 0,
      "text": "땅에서 뜨는 것으로\\n땅타입의 기술을 받지 않는다."
    },
    {
      "index": 27,
      "id": "TOKUSEIINFO_027",
      "hash": "7baa7406d13473bf",
      "flags": 0,
      "text": "공격으로 자신에게 접촉한 상대를\\n독이나 마비, 잠듦 상태로\\n만들 때가 있다."
    },
    {
      "index": 28,
      "id": "TOKUSEIINFO_028",
      "hash": "7baa7906d1347c3e",
      "flags": 0,
      "text": "자신이 걸린\\n독이나 마비, 화상을\\n상대에게 옮긴다."
    },
    {
      "index": 29,
      "id": "TOKUSEIINFO_029",
      "hash": "7baa7a06d1347df1",
      "flags": 0,
      "text": "상대 기술이나 특성으로\\n능력을 떨어뜨릴 수 없다."
    },
    {
      "index": 30,
      "id": "TOKUSEIINFO_030",
      "hash": "7badf706d137882f",
      "flags": 0,
      "text": "지닌 포켓몬으로 돌아오면\\n상태 이상이 회복된다."
    },
    {
      "index": 31,
      "id": "TOKUSEIINFO_031",
      "hash": "7badf606d137867c",
      "flags": 0,
      "text": "전기타입의 기술을 자신에게\\n끌어모아 데미지를 받지 않고\\n특수공격을 올린다."
    },
    {
      "index": 32,
      "id": "TOKUSEIINFO_032",
      "hash": "7badf906d1378b95",
      "flags": 0,
      "text": "하늘의 은총 덕분에\\n기술의 추가 효과가 나오기 쉽다."
    },
    {
      "index": 33,
      "id": "TOKUSEIINFO_033",
      "hash": "7badf806d13789e2",
      "flags": 0,
      "text": "비가 오는 날씨일 때\\n스피드가 올라간다."
    },
    {
      "index": 34,
      "id": "TOKUSEIINFO_034",
      "hash": "7badf306d1378163",
      "flags": 0,
      "text": "날씨가 맑을 때\\n스피드가 올라간다."
    },
    {
      "index": 35,
      "id": "TOKUSEIINFO_035",
      "hash": "7badf206d1377fb0",
      "flags": 0,
      "text": "주변을 밝게 하는 것으로\\n야생 포켓몬과\\n만나기 쉬워진다."
    },
    {
      "index": 36,
      "id": "TOKUSEIINFO_036",
      "hash": "7badf506d13784c9",
      "flags": 0,
      "text": "등장했을 때\\n상대의 특성을 트레이스해서\\n같은 특성이 된다."
    },
    {
      "index": 37,
      "id": "TOKUSEIINFO_037",
      "hash": "7badf406d1378316",
      "flags": 0,
      "text": "물리공격의\\n위력이 2배가 된다."
    },
    {
      "index": 38,
      "id": "TOKUSEIINFO_038",
      "hash": "7badff06d13795c7",
      "flags": 0,
      "text": "자신과 접촉한 상대를\\n독 상태로 만들 때가 있다."
    },
    {
      "index": 39,
      "id": "TOKUSEIINFO_039",
      "hash": "7badfe06d1379414",
      "flags": 0,
      "text": "단련한 정신으로 인하여\\n상대의 공격에 풀죽지 않는다."
    },
    {
      "index": 40,
      "id": "TOKUSEIINFO_040",
      "hash": "7b966d06d123bed0",
      "flags": 0,
      "text": "뜨거운 마그마를 몸에 둘러서\\n얼음 상태가 되지 않는다."
    },
    {
      "index": 41,
      "id": "TOKUSEIINFO_041",
      "hash": "7b966e06d123c083",
      "flags": 0,
      "text": "물의 베일을 몸에 둘러서\\n화상 상태가 되지 않는다."
    },
    {
      "index": 42,
      "id": "TOKUSEIINFO_042",
      "hash": "7b966f06d123c236",
      "flags": 0,
      "text": "강철타입의 포켓몬을\\n자력으로 끌어모아\\n도망칠 수 없게 한다."
    },
    {
      "index": 43,
      "id": "TOKUSEIINFO_043",
      "hash": "7b967006d123c3e9",
      "flags": 0,
      "text": "소리를 차단하는 것으로\\n소리 공격을 받지 않는다."
    },
    {
      "index": 44,
      "id": "TOKUSEIINFO_044",
      "hash": "7b967106d123c59c",
      "flags": 0,
      "text": "비가 오는 날씨일 때\\n조금씩 HP를 회복한다."
    },
    {
      "index": 45,
      "id": "TOKUSEIINFO_045",
      "hash": "7b967206d123c74f",
      "flags": 0,
      "text": "등장했을 때\\n날씨를 모래바람으로 만든다."
    },
    {
      "index": 46,
      "id": "TOKUSEIINFO_046",
      "hash": "7b967306d123c902",
      "flags": 0,
      "text": "프레셔를 줘서\\n상대가 쓰는 기술의 PP를\\n많이 줄인다."
    },
    {
      "index": 47,
      "id": "TOKUSEIINFO_047",
      "hash": "7b967406d123cab5",
      "flags": 0,
      "text": "두꺼운 지방으로 보호되고 있어\\n불꽃타입과 얼음타입의\\n기술의 데미지를 반감시킨다."
    },
    {
      "index": 48,
      "id": "TOKUSEIINFO_048",
      "hash": "7b967506d123cc68",
      "flags": 0,
      "text": "잠듦 상태가 되어도\\n2배 스피드로\\n깨어날 수 있다."
    },
    {
      "index": 49,
      "id": "TOKUSEIINFO_049",
      "hash": "7b967606d123ce1b",
      "flags": 0,
      "text": "자신과 접촉한 상대를\\n화상 상태로 만들 때가 있다."
    },
    {
      "index": 50,
      "id": "TOKUSEIINFO_050",
      "hash": "7b997306d125fed9",
      "flags": 0,
      "text": "야생 포켓몬으로부터\\n반드시 도망칠 수 있다."
    },
    {
      "index": 51,
      "id": "TOKUSEIINFO_051",
      "hash": "7b997206d125fd26",
      "flags": 0,
      "text": "날카로운 눈 덕분에\\n명중률이 떨어지지 않는다."
    },
    {
      "index": 52,
      "id": "TOKUSEIINFO_052",
      "hash": "7b997106d125fb73",
      "flags": 0,
      "text": "힘이 자랑인 집게를 가지고 있어\\n상대가 공격을 떨어뜨리지 못한다."
    },
    {
      "index": 53,
      "id": "TOKUSEIINFO_053",
      "hash": "7b997006d125f9c0",
      "flags": 0,
      "text": "상대가 사용한 도구를\\n주워올 때가 있다.\\n모험 중에도 주워온다."
    },
    {
      "index": 54,
      "id": "TOKUSEIINFO_054",
      "hash": "7b997706d12605a5",
      "flags": 0,
      "text": "기술을 사용하면\\n다음 턴은 쉰다."
    },
    {
      "index": 55,
      "id": "TOKUSEIINFO_055",
      "hash": "7b997606d12603f2",
      "flags": 0,
      "text": "자신의 공격이 높아지지만\\n명중률이 떨어진다."
    },
    {
      "index": 56,
      "id": "TOKUSEIINFO_056",
      "hash": "7b997506d126023f",
      "flags": 0,
      "text": "자신과 접촉한 상대를\\n헤롱헤롱 상태로 만들 때가 있다."
    },
    {
      "index": 57,
      "id": "TOKUSEIINFO_057",
      "hash": "7b997406d126008c",
      "flags": 0,
      "text": "플러스나 마이너스의 특성을 가진\\n포켓몬이 동료에 있으면\\n자신의 특수공격이 올라간다."
    },
    {
      "index": 58,
      "id": "TOKUSEIINFO_058",
      "hash": "7b997b06d1260c71",
      "flags": 0,
      "text": "플러스나 마이너스의 특성을 가진\\n포켓몬이 동료에 있으면\\n자신의 특수공격이 올라간다."
    },
    {
      "index": 59,
      "id": "TOKUSEIINFO_059",
      "hash": "7b997a06d1260abe",
      "flags": 0,
      "text": "날씨의 영향을 받아\\n물타입, 불꽃타입, 얼음타입 중\\n하나로 변화한다."
    },
    {
      "index": 60,
      "id": "TOKUSEIINFO_060",
      "hash": "7b9cf906d1291862",
      "flags": 0,
      "text": "점착질의 몸에\\n도구가 달라붙어 있어\\n상대에게 도구를 뺏기지 않는다."
    },
    {
      "index": 61,
      "id": "TOKUSEIINFO_061",
      "hash": "7b9cfa06d1291a15",
      "flags": 0,
      "text": "몸의 껍질을 벗어 던져\\n상태 이상을\\n회복할 때가 있다."
    },
    {
      "index": 62,
      "id": "TOKUSEIINFO_062",
      "hash": "7b9cf706d12914fc",
      "flags": 0,
      "text": "상태 이상이 되면\\n근성을 보여서\\n공격이 올라간다."
    },
    {
      "index": 63,
      "id": "TOKUSEIINFO_063",
      "hash": "7b9cf806d12916af",
      "flags": 0,
      "text": "상태 이상이 되면\\n이상한 비늘이 반응해서\\n방어가 올라간다."
    },
    {
      "index": 64,
      "id": "TOKUSEIINFO_064",
      "hash": "7b9cf506d1291196",
      "flags": 0,
      "text": "해감액을 흡수한 상대는\\n강렬한 악취로\\n데미지를 받아 HP가 줄어든다."
    },
    {
      "index": 65,
      "id": "TOKUSEIINFO_065",
      "hash": "7b9cf606d1291349",
      "flags": 0,
      "text": "HP가 줄었을 때\\n풀타입 기술의\\n위력이 올라간다."
    },
    {
      "index": 66,
      "id": "TOKUSEIINFO_066",
      "hash": "7b9cf306d1290e30",
      "flags": 0,
      "text": "HP가 줄었을 때\\n불꽃타입 기술의\\n위력이 올라간다."
    },
    {
      "index": 67,
      "id": "TOKUSEIINFO_067",
      "hash": "7b9cf406d1290fe3",
      "flags": 0,
      "text": "HP가 줄었을 때\\n물타입 기술의\\n위력이 올라간다."
    },
    {
      "index": 68,
      "id": "TOKUSEIINFO_068",
      "hash": "7b9d0106d12925fa",
      "flags": 0,
      "text": "HP가 줄었을 때\\n벌레타입 기술의\\n위력이 올라간다."
    },
    {
      "index": 69,
      "id": "TOKUSEIINFO_069",
      "hash": "7b9d0206d12927ad",
      "flags": 0,
      "text": "반동을 받는 기술을 사용해도\\nHP가 줄지 않는다."
    },
    {
      "index": 70,
      "id": "TOKUSEIINFO_070",
      "hash": "7ba07f06d12c31eb",
      "flags": 0,
      "text": "등장했을 때\\n날씨를 맑음으로 만든다."
    },
    {
      "index": 71,
      "id": "TOKUSEIINFO_071",
      "hash": "7ba07e06d12c3038",
      "flags": 0,
      "text": "배틀에서 상대를\\n도망칠 수 없게 한다."
    },
    {
      "index": 72,
      "id": "TOKUSEIINFO_072",
      "hash": "7ba08106d12c3551",
      "flags": 0,
      "text": "의기양양해져서\\n잠듦 상태가 되지 않는다."
    },
    {
      "index": 73,
      "id": "TOKUSEIINFO_073",
      "hash": "7ba08006d12c339e",
      "flags": 0,
      "text": "하얀 연기의 보호를 받아\\n상대가 능력을 떨어뜨릴 수 없다."
    },
    {
      "index": 74,
      "id": "TOKUSEIINFO_074",
      "hash": "7ba08306d12c38b7",
      "flags": 0,
      "text": "요가의 힘으로\\n물리공격의 위력이\\n2배가 된다."
    },
    {
      "index": 75,
      "id": "TOKUSEIINFO_075",
      "hash": "7ba08206d12c3704",
      "flags": 0,
      "text": "단단한 껍질의 보호를 받아\\n상대의 공격이\\n급소에 맞지 않는다."
    },
    {
      "index": 76,
      "id": "TOKUSEIINFO_076",
      "hash": "7ba08506d12c3c1d",
      "flags": 0,
      "text": "모든 날씨의 영향이\\n없어진다."
    },
    {
      "index": 77,
      "id": "TOKUSEIINFO_077",
      "hash": "7ba08406d12c3a6a",
      "flags": 0,
      "text": "혼란 상태일 때는\\n회피율이 올라간다."
    },
    {
      "index": 78,
      "id": "TOKUSEIINFO_078",
      "hash": "7ba07706d12c2453",
      "flags": 0,
      "text": "전기타입의 기술을 받으면\\n데미지를 받지 않고\\n스피드가 올라간다."
    },
    {
      "index": 79,
      "id": "TOKUSEIINFO_079",
      "hash": "7ba07606d12c22a0",
      "flags": 0,
      "text": "성별이 같으면\\n투쟁심을 불태워 강해진다.\\n성별이 다르면 약해진다."
    },
    {
      "index": 80,
      "id": "TOKUSEIINFO_080",
      "hash": "7bbef506d145f7fc",
      "flags": 0,
      "text": "풀죽을 때마다\\n불굴의 마음을 불태워\\n스피드가 올라간다."
    },
    {
      "index": 81,
      "id": "TOKUSEIINFO_081",
      "hash": "7bbef606d145f9af",
      "flags": 0,
      "text": "날씨가 싸라기눈일 때\\n회피율이 올라간다."
    },
    {
      "index": 82,
      "id": "TOKUSEIINFO_082",
      "hash": "7bbef706d145fb62",
      "flags": 0,
      "text": "HP가 줄어들면 먹을\\n나무열매를 HP가\\n절반일 때 먹어버린다."
    },
    {
      "index": 83,
      "id": "TOKUSEIINFO_083",
      "hash": "7bbef806d145fd15",
      "flags": 0,
      "text": "급소에 공격이 맞으면\\n크게 분노해 공격력이\\n최대가 된다."
    },
    {
      "index": 84,
      "id": "TOKUSEIINFO_084",
      "hash": "7bbef106d145f130",
      "flags": 0,
      "text": "지니던 도구가 없어지면\\n스피드가 올라간다."
    },
    {
      "index": 85,
      "id": "TOKUSEIINFO_085",
      "hash": "7bbef206d145f2e3",
      "flags": 0,
      "text": "내열인 몸으로 인해\\n불꽃타입 공격의\\n데미지를 반감한다."
    },
    {
      "index": 86,
      "id": "TOKUSEIINFO_086",
      "hash": "7bbef306d145f496",
      "flags": 0,
      "text": "능력 변화가\\n평소의 2배가 된다."
    },
    {
      "index": 87,
      "id": "TOKUSEIINFO_087",
      "hash": "7bbef406d145f649",
      "flags": 0,
      "text": "비가 오는 날씨나 물타입의\\n기술로 HP가 회복되고\\n맑을 때나 불꽃타입의 기술로는 줄어든다."
    },
    {
      "index": 88,
      "id": "TOKUSEIINFO_088",
      "hash": "7bbefd06d1460594",
      "flags": 0,
      "text": "상대의 방어와 특수방어를 비교해서\\n낮은 쪽 능력에 맞춰서\\n자신의 공격이나 특수공격을 올린다."
    },
    {
      "index": 89,
      "id": "TOKUSEIINFO_089",
      "hash": "7bbefe06d1460747",
      "flags": 0,
      "text": "펀치를 사용하는 기술의\\n위력이 올라간다."
    },
    {
      "index": 90,
      "id": "TOKUSEIINFO_090",
      "hash": "7bc27b06d1491185",
      "flags": 0,
      "text": "독 상태가 되면\\nHP가 줄지 않고 증가한다."
    },
    {
      "index": 91,
      "id": "TOKUSEIINFO_091",
      "hash": "7bc27a06d1490fd2",
      "flags": 0,
      "text": "자신과 같은 타입의\\n기술 위력이 올라간다."
    },
    {
      "index": 92,
      "id": "TOKUSEIINFO_092",
      "hash": "7bc27906d1490e1f",
      "flags": 0,
      "text": "연속 기술을 사용하면 항상\\n최고 횟수를 사용할 수 있다."
    },
    {
      "index": 93,
      "id": "TOKUSEIINFO_093",
      "hash": "7bc27806d1490c6c",
      "flags": 0,
      "text": "비가 오는 날씨일 때\\n상태 이상이 회복된다."
    },
    {
      "index": 94,
      "id": "TOKUSEIINFO_094",
      "hash": "7bc27706d1490ab9",
      "flags": 0,
      "text": "날씨가 맑으면\\n특수공격이 올라가지만\\n매 턴 HP가 줄어든다."
    },
    {
      "index": 95,
      "id": "TOKUSEIINFO_095",
      "hash": "7bc27606d1490906",
      "flags": 0,
      "text": "상태 이상이 되면\\n스피드가 올라간다."
    },
    {
      "index": 96,
      "id": "TOKUSEIINFO_096",
      "hash": "7bc27506d1490753",
      "flags": 0,
      "text": "어떤 타입의 기술도\\n모두 노말타입이 된다.\\n위력이 조금 올라간다."
    },
    {
      "index": 97,
      "id": "TOKUSEIINFO_097",
      "hash": "7bc27406d14905a0",
      "flags": 0,
      "text": "공격을 급소에 맞혔을 때\\n위력이 더욱 올라간다."
    },
    {
      "index": 98,
      "id": "TOKUSEIINFO_098",
      "hash": "7bc28306d1491f1d",
      "flags": 0,
      "text": "공격 이외에는\\n데미지를 입지 않는다."
    },
    {
      "index": 99,
      "id": "TOKUSEIINFO_099",
      "hash": "7bc28206d1491d6a",
      "flags": 0,
      "text": "노가드전법에 따라\\n서로가 사용하는 기술이\\n반드시 맞게 된다."
    },
    {
      "index": 100,
      "id": "TOKUSEIINFO_100",
      "hash": "84ba2006d67378df",
      "flags": 0,
      "text": "기술을 사용하는 순서가\\n반드시 마지막이 된다."
    },
    {
      "index": 101,
      "id": "TOKUSEIINFO_101",
      "hash": "84ba1f06d673772c",
      "flags": 0,
      "text": "위력이 약한 기술의\\n위력을 올려서 공격할 수 있다."
    },
    {
      "index": 102,
      "id": "TOKUSEIINFO_102",
      "hash": "84ba2206d6737c45",
      "flags": 0,
      "text": "날씨가 맑을 때는\\n상태 이상이 되지 않는다."
    },
    {
      "index": 103,
      "id": "TOKUSEIINFO_103",
      "hash": "84ba2106d6737a92",
      "flags": 0,
      "text": "지니고 있는 도구를\\n쓸 수 없다."
    },
    {
      "index": 104,
      "id": "TOKUSEIINFO_104",
      "hash": "84ba1c06d6737213",
      "flags": 0,
      "text": "상대 특성에\\n방해받지 않고 상대에게\\n기술을 쓸 수 있다."
    },
    {
      "index": 105,
      "id": "TOKUSEIINFO_105",
      "hash": "84ba1b06d6737060",
      "flags": 0,
      "text": "대운을 가지고 있어\\n상대의 급소에\\n공격이 맞기 쉽다."
    },
    {
      "index": 106,
      "id": "TOKUSEIINFO_106",
      "hash": "84ba1e06d6737579",
      "flags": 0,
      "text": "기절했을 때\\n접촉한 상대에게\\n데미지를 준다."
    },
    {
      "index": 107,
      "id": "TOKUSEIINFO_107",
      "hash": "84ba1d06d67373c6",
      "flags": 0,
      "text": "상대가 지닌 위험한 기술을\\n감지할 수 있다."
    },
    {
      "index": 108,
      "id": "TOKUSEIINFO_108",
      "hash": "84ba2806d6738677",
      "flags": 0,
      "text": "등장했을 때\\n상대가 지닌 기술을\\n하나만 꿰뚫어본다."
    },
    {
      "index": 109,
      "id": "TOKUSEIINFO_109",
      "hash": "84ba2706d67384c4",
      "flags": 0,
      "text": "상대의 능력 변화를\\n무시하고 공격할 수 있다."
    },
    {
      "index": 110,
      "id": "TOKUSEIINFO_110",
      "hash": "84b69a06d6705f56",
      "flags": 0,
      "text": "효과가 별로인 기술을\\n통상의 위력으로\\n쓸 수 있다."
    },
    {
      "index": 111,
      "id": "TOKUSEIINFO_111",
      "hash": "84b69b06d6706109",
      "flags": 0,
      "text": "효과가 굉장한\\n공격의 위력을\\n약하게 만든다."
    },
    {
      "index": 112,
      "id": "TOKUSEIINFO_112",
      "hash": "84b69806d6705bf0",
      "flags": 0,
      "text": "5턴 동안\\n공격과 스피드가\\n절반이 된다."
    },
    {
      "index": 113,
      "id": "TOKUSEIINFO_113",
      "hash": "84b69906d6705da3",
      "flags": 0,
      "text": "고스트타입 포켓몬에게\\n노말타입과 격투타입의\\n기술을 맞게 한다."
    },
    {
      "index": 114,
      "id": "TOKUSEIINFO_114",
      "hash": "84b69e06d6706622",
      "flags": 0,
      "text": "물타입의 기술을 자신에게 끌어모아\\n데미지는 받지 않고 특수공격이 올라간다."
    },
    {
      "index": 115,
      "id": "TOKUSEIINFO_115",
      "hash": "84b69f06d67067d5",
      "flags": 0,
      "text": "날씨가 싸라기눈일 때 HP를\\n조금씩 회복한다."
    },
    {
      "index": 116,
      "id": "TOKUSEIINFO_116",
      "hash": "84b69c06d67062bc",
      "flags": 0,
      "text": "효과가 굉장한\\n공격의 위력을\\n약하게 만든다."
    },
    {
      "index": 117,
      "id": "TOKUSEIINFO_117",
      "hash": "84b69d06d670646f",
      "flags": 0,
      "text": "등장했을 때\\n날씨를 싸라기눈으로 만든다."
    },
    {
      "index": 118,
      "id": "TOKUSEIINFO_118",
      "hash": "84b6a206d6706cee",
      "flags": 0,
      "text": "배틀이 끝났을 때\\n달콤한꿀을 주울 때가 있다."
    },
    {
      "index": 119,
      "id": "TOKUSEIINFO_119",
      "hash": "84b6a306d6706ea1",
      "flags": 0,
      "text": "등장했을 때\\n상대의 지닌 물건을\\n통찰할 수 있다."
    },
    {
      "index": 120,
      "id": "TOKUSEIINFO_120",
      "hash": "84b33406d66d7c2d",
      "flags": 0,
      "text": "반동 데미지를\\n받는 기술의 위력이 올라간다."
    },
    {
      "index": 121,
      "id": "TOKUSEIINFO_121",
      "hash": "84b33306d66d7a7a",
      "flags": 0,
      "text": "지니고 있는 플레이트나\\nZ크리스탈 타입에 따라\\n자신의 타입이 바뀐다."
    },
    {
      "index": 122,
      "id": "TOKUSEIINFO_122",
      "hash": "84b33206d66d78c7",
      "flags": 0,
      "text": "날씨가 맑을 때\\n자신과 같은 편의 공격과\\n특수방어의 능력이 올라간다."
    },
    {
      "index": 123,
      "id": "TOKUSEIINFO_123",
      "hash": "84b33106d66d7714",
      "flags": 0,
      "text": "잠듦 상태의 상대에게\\n데미지를 준다."
    },
    {
      "index": 124,
      "id": "TOKUSEIINFO_124",
      "hash": "84b33006d66d7561",
      "flags": 0,
      "text": "접촉한 상대의 도구를\\n훔친다."
    },
    {
      "index": 125,
      "id": "TOKUSEIINFO_125",
      "hash": "84b32f06d66d73ae",
      "flags": 0,
      "text": "기술의 추가 효과가 없어지지만\\n그만큼 높은 위력으로\\n기술을 사용할 수 있다."
    },
    {
      "index": 126,
      "id": "TOKUSEIINFO_126",
      "hash": "84b32e06d66d71fb",
      "flags": 0,
      "text": "능력의 변화가 역전해서\\n올라갈 때 떨어지고\\n떨어질 때 올라간다."
    },
    {
      "index": 127,
      "id": "TOKUSEIINFO_127",
      "hash": "84b32d06d66d7048",
      "flags": 0,
      "text": "상대를 긴장시켜 나무열매를\\n먹지 못하게 한다."
    },
    {
      "index": 128,
      "id": "TOKUSEIINFO_128",
      "hash": "84b32c06d66d6e95",
      "flags": 0,
      "text": "능력이 떨어지면\\n공격이 크게 올라간다."
    },
    {
      "index": 129,
      "id": "TOKUSEIINFO_129",
      "hash": "84b32b06d66d6ce2",
      "flags": 0,
      "text": "HP가 절반이 되면\\n무기력해져서 공격과\\n특수공격이 반감된다."
    },
    {
      "index": 130,
      "id": "TOKUSEIINFO_130",
      "hash": "84afae06d66a62a4",
      "flags": 0,
      "text": "공격을 받으면 상대의 기술을\\n사슬묶기 상태로\\n만들 때가 있다."
    },
    {
      "index": 131,
      "id": "TOKUSEIINFO_131",
      "hash": "84afaf06d66a6457",
      "flags": 0,
      "text": "같은 편의 상태 이상을\\n가끔 회복시킨다."
    },
    {
      "index": 132,
      "id": "TOKUSEIINFO_132",
      "hash": "84afb006d66a660a",
      "flags": 0,
      "text": "같은 편의 데미지를\\n줄일 수 있다."
    },
    {
      "index": 133,
      "id": "TOKUSEIINFO_133",
      "hash": "84afb106d66a67bd",
      "flags": 0,
      "text": "물리 기술로 데미지를 받으면\\n방어가 떨어지고\\n스피드가 크게 올라간다."
    },
    {
      "index": 134,
      "id": "TOKUSEIINFO_134",
      "hash": "84afaa06d66a5bd8",
      "flags": 0,
      "text": "자신의 무게가\\n2배가 된다."
    },
    {
      "index": 135,
      "id": "TOKUSEIINFO_135",
      "hash": "84afab06d66a5d8b",
      "flags": 0,
      "text": "자신의 무게가\\n절반이 된다."
    },
    {
      "index": 136,
      "id": "TOKUSEIINFO_136",
      "hash": "84afac06d66a5f3e",
      "flags": 0,
      "text": "HP가 꽉 찼을 때\\n받는 데미지가 줄어든다."
    },
    {
      "index": 137,
      "id": "TOKUSEIINFO_137",
      "hash": "84afad06d66a60f1",
      "flags": 0,
      "text": "독 상태가 되었을 때\\n물리 기술의 위력이 올라간다."
    },
    {
      "index": 138,
      "id": "TOKUSEIINFO_138",
      "hash": "84afa606d66a550c",
      "flags": 0,
      "text": "화상 상태가 되었을 때\\n특수 기술의 위력이 올라간다."
    },
    {
      "index": 139,
      "id": "TOKUSEIINFO_139",
      "hash": "84afa706d66a56bf",
      "flags": 0,
      "text": "사용한 나무열매를\\n몇 번이고 만들어 낸다."
    },
    {
      "index": 140,
      "id": "TOKUSEIINFO_140",
      "hash": "84aca806d668229b",
      "flags": 0,
      "text": "같은 편의 공격의 낌새를 읽고\\n기술을 회피한다."
    },
    {
      "index": 141,
      "id": "TOKUSEIINFO_141",
      "hash": "84aca706d66820e8",
      "flags": 0,
      "text": "매 턴 능력 중 하나가\\n크게 오르고 하나가 떨어진다."
    },
    {
      "index": 142,
      "id": "TOKUSEIINFO_142",
      "hash": "84acaa06d6682601",
      "flags": 0,
      "text": "모래바람이나 싸라기눈 등의\\n데미지를 입지 않는다.\\n가루의 기술을 받지 않는다."
    },
    {
      "index": 143,
      "id": "TOKUSEIINFO_143",
      "hash": "84aca906d668244e",
      "flags": 0,
      "text": "접촉하기만 해도 상대를\\n독 상태로 만들 때가 있다."
    },
    {
      "index": 144,
      "id": "TOKUSEIINFO_144",
      "hash": "84acac06d6682967",
      "flags": 0,
      "text": "지닌 포켓몬으로 돌아오면\\nHP를 조금 회복한다."
    },
    {
      "index": 145,
      "id": "TOKUSEIINFO_145",
      "hash": "84acab06d66827b4",
      "flags": 0,
      "text": "방어를 떨어뜨리는\\n효과를 받지 않는다."
    },
    {
      "index": 146,
      "id": "TOKUSEIINFO_146",
      "hash": "84acae06d6682ccd",
      "flags": 0,
      "text": "날씨가 모래바람일 때\\n스피드가 올라간다."
    },
    {
      "index": 147,
      "id": "TOKUSEIINFO_147",
      "hash": "84acad06d6682b1a",
      "flags": 0,
      "text": "변화 기술을 받기 어려운\\n몸으로 되어 있다."
    },
    {
      "index": 148,
      "id": "TOKUSEIINFO_148",
      "hash": "84aca006d6681503",
      "flags": 0,
      "text": "제일 마지막에 기술을 쓰면\\n기술의 위력이 올라간다."
    },
    {
      "index": 149,
      "id": "TOKUSEIINFO_149",
      "hash": "84ac9f06d6681350",
      "flags": 0,
      "text": "지닌 포켓몬 중 제일 뒤에 있는\\n포켓몬으로 둔갑하여 나와서\\n상대를 속인다."
    },
    {
      "index": 150,
      "id": "TOKUSEIINFO_150",
      "hash": "84a92206d6650912",
      "flags": 0,
      "text": "눈앞의 포켓몬으로\\n변신해버린다."
    },
    {
      "index": 151,
      "id": "TOKUSEIINFO_151",
      "hash": "84a92306d6650ac5",
      "flags": 0,
      "text": "상대의 벽이나 대타출동을\\n뚫고 공격할 수 있다."
    },
    {
      "index": 152,
      "id": "TOKUSEIINFO_152",
      "hash": "84a92006d66505ac",
      "flags": 0,
      "text": "상대가 접촉하면\\n상대를 미라로 만들어버린다."
    },
    {
      "index": 153,
      "id": "TOKUSEIINFO_153",
      "hash": "84a92106d665075f",
      "flags": 0,
      "text": "상대를 쓰러뜨리면\\n자신감이 붙어서\\n공격이 올라간다."
    },
    {
      "index": 154,
      "id": "TOKUSEIINFO_154",
      "hash": "84a91e06d6650246",
      "flags": 0,
      "text": "악타입 공격을 받으면\\n정의감으로 공격이 올라간다."
    },
    {
      "index": 155,
      "id": "TOKUSEIINFO_155",
      "hash": "84a91f06d66503f9",
      "flags": 0,
      "text": "악타입과 고스트타입과\\n벌레타입의 기술을 받으면\\n주눅이 들어 스피드가 올라간다."
    },
    {
      "index": 156,
      "id": "TOKUSEIINFO_156",
      "hash": "84a91c06d664fee0",
      "flags": 0,
      "text": "상대가 쓴 변화 기술을 받지 않고\\n그대로 되받아칠 수 있다."
    },
    {
      "index": 157,
      "id": "TOKUSEIINFO_157",
      "hash": "84a91d06d6650093",
      "flags": 0,
      "text": "풀타입 기술을 받으면\\n데미지를 입지 않고\\n공격이 올라간다."
    },
    {
      "index": 158,
      "id": "TOKUSEIINFO_158",
      "hash": "84a92a06d66516aa",
      "flags": 0,
      "text": "변화 기술을 먼저\\n쓸 수 있다."
    },
    {
      "index": 159,
      "id": "TOKUSEIINFO_159",
      "hash": "84a92b06d665185d",
      "flags": 0,
      "text": "날씨가 모래바람일 때\\n바위타입과 땅타입과\\n강철타입의 위력이 올라간다."
    },
    {
      "index": 160,
      "id": "TOKUSEIINFO_160",
      "hash": "84a59c06d661ef89",
      "flags": 0,
      "text": "자신과 접촉한 상대에게\\n철가시로 데미지를 준다."
    },
    {
      "index": 161,
      "id": "TOKUSEIINFO_161",
      "hash": "84a59b06d661edd6",
      "flags": 0,
      "text": "HP가 절반 이하가 되면\\n모습이 변화한다."
    },
    {
      "index": 162,
      "id": "TOKUSEIINFO_162",
      "hash": "84a59a06d661ec23",
      "flags": 0,
      "text": "자신과 같은 편의\\n명중률이 올라간다."
    },
    {
      "index": 163,
      "id": "TOKUSEIINFO_163",
      "hash": "84a59906d661ea70",
      "flags": 0,
      "text": "상대 특성에 방해받지 않고\\n상대에게 기술을 쓸 수 있다."
    },
    {
      "index": 164,
      "id": "TOKUSEIINFO_164",
      "hash": "84a5a006d661f655",
      "flags": 0,
      "text": "상대 특성에 방해받지 않고\\n상대에게 기술을 쓸 수 있다."
    },
    {
      "index": 165,
      "id": "TOKUSEIINFO_165",
      "hash": "84a59f06d661f4a2",
      "flags": 0,
      "text": "자신과 같은 편으로 향하는\\n멘탈 공격을 막을 수 있다."
    },
    {
      "index": 166,
      "id": "TOKUSEIINFO_166",
      "hash": "84a59e06d661f2ef",
      "flags": 0,
      "text": "같은 편의 풀타입 포켓몬은\\n능력이 떨어지지 않고\\n상태 이상도 되지 않는다."
    },
    {
      "index": 167,
      "id": "TOKUSEIINFO_167",
      "hash": "84a59d06d661f13c",
      "flags": 0,
      "text": "어떤 나무열매라도\\n먹으면 HP도 회복한다."
    },
    {
      "index": 168,
      "id": "TOKUSEIINFO_168",
      "hash": "84a5a406d661fd21",
      "flags": 0,
      "text": "자신이 사용한 기술과\\n같은 타입으로 변화한다."
    },
    {
      "index": 169,
      "id": "TOKUSEIINFO_169",
      "hash": "84a5a306d661fb6e",
      "flags": 0,
      "text": "상대로부터 받는 물리 기술의\\n데미지가 절반이 된다."
    },
    {
      "index": 170,
      "id": "TOKUSEIINFO_170",
      "hash": "84a21606d65ed600",
      "flags": 0,
      "text": "기술을 맞은 상대의\\n도구를 빼앗아 버린다."
    },
    {
      "index": 171,
      "id": "TOKUSEIINFO_171",
      "hash": "84a21706d65ed7b3",
      "flags": 0,
      "text": "상대 구슬이나 폭탄 등\\n기술을 막을 수 있다."
    },
    {
      "index": 172,
      "id": "TOKUSEIINFO_172",
      "hash": "84a21806d65ed966",
      "flags": 0,
      "text": "능력이 떨어지면\\n특수공격이 크게 올라간다."
    },
    {
      "index": 173,
      "id": "TOKUSEIINFO_173",
      "hash": "84a21906d65edb19",
      "flags": 0,
      "text": "턱이 튼튼하여\\n무는 기술의 위력이\\n올라간다."
    },
    {
      "index": 174,
      "id": "TOKUSEIINFO_174",
      "hash": "84a21a06d65edccc",
      "flags": 0,
      "text": "노말타입의 기술이\\n얼음타입이 된다.\\n위력이 조금 올라간다."
    },
    {
      "index": 175,
      "id": "TOKUSEIINFO_175",
      "hash": "84a21b06d65ede7f",
      "flags": 0,
      "text": "같은 편의 포켓몬이\\n잠들지 않게 된다."
    },
    {
      "index": 176,
      "id": "TOKUSEIINFO_176",
      "hash": "84a21c06d65ee032",
      "flags": 0,
      "text": "공격 기술을 쓰면 블레이드폼으로\\n기술 킹실드를 쓰면\\n실드폼으로 변한다."
    },
    {
      "index": 177,
      "id": "TOKUSEIINFO_177",
      "hash": "84a21d06d65ee1e5",
      "flags": 0,
      "text": "HP가 꽉 찼을 때\\n비행타입의 기술을\\n먼저 쓸 수 있다."
    },
    {
      "index": 178,
      "id": "TOKUSEIINFO_178",
      "hash": "84a21e06d65ee398",
      "flags": 0,
      "text": "파동 기술의\\n위력이 올라간다."
    },
    {
      "index": 179,
      "id": "TOKUSEIINFO_179",
      "hash": "84a21f06d65ee54b",
      "flags": 0,
      "text": "그래스필드일 때\\n방어가 올라간다."
    },
    {
      "index": 180,
      "id": "TOKUSEIINFO_180",
      "hash": "84d53006d68a5bc7",
      "flags": 0,
      "text": "같은 편이 도구를 쓰면\\n자신이 지니고 있는 도구를\\n같은 편에게 건넨다."
    },
    {
      "index": 181,
      "id": "TOKUSEIINFO_181",
      "hash": "84d52f06d68a5a14",
      "flags": 0,
      "text": "상대에게 접촉하는 기술의\\n위력이 올라간다."
    },
    {
      "index": 182,
      "id": "TOKUSEIINFO_182",
      "hash": "84d53206d68a5f2d",
      "flags": 0,
      "text": "노말타입의 기술이\\n페어리타입이 된다.\\n위력이 조금 올라간다."
    },
    {
      "index": 183,
      "id": "TOKUSEIINFO_183",
      "hash": "84d53106d68a5d7a",
      "flags": 0,
      "text": "공격으로 자신과 접촉한 상대의\\n스피드를 떨어뜨린다."
    },
    {
      "index": 184,
      "id": "TOKUSEIINFO_184",
      "hash": "84d52c06d68a54fb",
      "flags": 0,
      "text": "노말타입의 기술이\\n비행타입이 된다.\\n위력이 조금 올라간다."
    },
    {
      "index": 185,
      "id": "TOKUSEIINFO_185",
      "hash": "84d52b06d68a5348",
      "flags": 0,
      "text": "부모와 자식 2마리로 2번\\n공격할 수 있다."
    },
    {
      "index": 186,
      "id": "TOKUSEIINFO_186",
      "hash": "84d52e06d68a5861",
      "flags": 0,
      "text": "전원의 악타입\\n기술이 강해진다."
    },
    {
      "index": 187,
      "id": "TOKUSEIINFO_187",
      "hash": "84d52d06d68a56ae",
      "flags": 0,
      "text": "전원의 페어리타입\\n기술이 강해진다."
    },
    {
      "index": 188,
      "id": "TOKUSEIINFO_188",
      "hash": "84d52806d68a4e2f",
      "flags": 0,
      "text": "오라의 효과를 역전시켜\\n위력을 떨어뜨린다."
    },
    {
      "index": 189,
      "id": "TOKUSEIINFO_189",
      "hash": "84d52706d68a4c7c",
      "flags": 0,
      "text": "불꽃타입의 공격을\\n받지 않는 날씨로 만든다."
    },
    {
      "index": 190,
      "id": "TOKUSEIINFO_190",
      "hash": "84d1aa06d687423e",
      "flags": 0,
      "text": "물타입의 공격을\\n받지 않는 날씨로 만든다."
    },
    {
      "index": 191,
      "id": "TOKUSEIINFO_191",
      "hash": "84d1ab06d68743f1",
      "flags": 0,
      "text": "비행타입의 약점이\\n없어지는 날씨로 만든다."
    },
    {
      "index": 192,
      "id": "TOKUSEIINFO_192",
      "hash": "84d1a806d6873ed8",
      "flags": 0,
      "text": "공격을 받으면\\n방어가 올라간다."
    },
    {
      "index": 193,
      "id": "TOKUSEIINFO_193",
      "hash": "84d1a906d687408b",
      "flags": 0,
      "text": "HP가 절반이 되면\\n황급히 도망쳐서\\n지닌 포켓몬으로 돌아간다."
    },
    {
      "index": 194,
      "id": "TOKUSEIINFO_194",
      "hash": "84d1ae06d687490a",
      "flags": 0,
      "text": "HP가 절반이 되면\\n위험을 회피하기 위해\\n지닌 포켓몬으로 돌아간다."
    },
    {
      "index": 195,
      "id": "TOKUSEIINFO_195",
      "hash": "84d1af06d6874abd",
      "flags": 0,
      "text": "물타입의 기술을 받으면\\n방어가 크게 올라간다."
    },
    {
      "index": 196,
      "id": "TOKUSEIINFO_196",
      "hash": "84d1ac06d68745a4",
      "flags": 0,
      "text": "독 상태의\\n상대를 공격하면\\n반드시 급소에 맞는다."
    },
    {
      "index": 197,
      "id": "TOKUSEIINFO_197",
      "hash": "84d1ad06d6874757",
      "flags": 0,
      "text": "HP가 절반이 되면\\n껍질이 깨져\\n공격적으로 된다."
    },
    {
      "index": 198,
      "id": "TOKUSEIINFO_198",
      "hash": "84d1a206d68734a6",
      "flags": 0,
      "text": "교체로 나온 상대에게\\n2배 데미지로 공격할 수 있다."
    },
    {
      "index": 199,
      "id": "TOKUSEIINFO_199",
      "hash": "84d1a306d6873659",
      "flags": 0,
      "text": "자신을 향하는 불꽃타입\\n기술의 위력을 떨어뜨린다.\\n화상을 입지 않는다."
    },
    {
      "index": 200,
      "id": "TOKUSEIINFO_200",
      "hash": "8dd05b06dbb7dcaa",
      "flags": 0,
      "text": "강철타입 기술의\\n위력이 올라간다."
    },
    {
      "index": 201,
      "id": "TOKUSEIINFO_201",
      "hash": "8dd05c06dbb7de5d",
      "flags": 0,
      "text": "상대의 공격으로\\nHP가 절반이 되면\\n특수공격이 올라간다."
    },
    {
      "index": 202,
      "id": "TOKUSEIINFO_202",
      "hash": "8dd05906dbb7d944",
      "flags": 0,
      "text": "날씨가 싸라기눈일 때\\n스피드가 올라간다."
    },
    {
      "index": 203,
      "id": "TOKUSEIINFO_203",
      "hash": "8dd05a06dbb7daf7",
      "flags": 0,
      "text": "모든 기술을\\n상대에게 접촉하지 않고\\n사용할 수 있다."
    },
    {
      "index": 204,
      "id": "TOKUSEIINFO_204",
      "hash": "8dd05706dbb7d5de",
      "flags": 0,
      "text": "모든 소리 기술이\\n물타입이 된다."
    },
    {
      "index": 205,
      "id": "TOKUSEIINFO_205",
      "hash": "8dd05806dbb7d791",
      "flags": 0,
      "text": "회복 기술을 먼저\\n사용할 수 있다."
    },
    {
      "index": 206,
      "id": "TOKUSEIINFO_206",
      "hash": "8dd05506dbb7d278",
      "flags": 0,
      "text": "노말타입 기술이\\n전기타입이 된다.\\n위력이 조금 올라간다."
    },
    {
      "index": 207,
      "id": "TOKUSEIINFO_207",
      "hash": "8dd05606dbb7d42b",
      "flags": 0,
      "text": "일렉트릭필드일 때\\n스피드가 2배가 된다."
    },
    {
      "index": 208,
      "id": "TOKUSEIINFO_208",
      "hash": "8dd05306dbb7cf12",
      "flags": 0,
      "text": "HP가 많을 때 무리지어 강해진다.\\nHP가 얼마 남지 않으면\\n무리는 뿔뿔이 흩어진다."
    },
    {
      "index": 209,
      "id": "TOKUSEIINFO_209",
      "hash": "8dd05406dbb7d0c5",
      "flags": 0,
      "text": "몸을 덮는 탈로\\n1번 공격을 막을 수 있다."
    },
    {
      "index": 210,
      "id": "TOKUSEIINFO_210",
      "hash": "8dd3c106dbbabfd3",
      "flags": 0,
      "text": "상대를 쓰러뜨리면 트레이너와의\\n유대감이 깊어져서 지우개굴닌자로\\n변한다. 물수리검이 강해진다."
    },
    {
      "index": 211,
      "id": "TOKUSEIINFO_211",
      "hash": "8dd3c006dbbabe20",
      "flags": 0,
      "text": "HP가 절반이 되면\\n셀들이 응원하러 달려와\\n퍼펙트폼으로 모습이 변한다."
    },
    {
      "index": 212,
      "id": "TOKUSEIINFO_212",
      "hash": "8dd3c306dbbac339",
      "flags": 0,
      "text": "강철타입이나 독타입도\\n독 상태로 만들 수 있다."
    },
    {
      "index": 213,
      "id": "TOKUSEIINFO_213",
      "hash": "8dd3c206dbbac186",
      "flags": 0,
      "text": "항상 비몽사몽 상태로\\n절대 깨지 않는다.\\n잠든 상태로 공격할 수 있다."
    },
    {
      "index": 214,
      "id": "TOKUSEIINFO_214",
      "hash": "8dd3c506dbbac69f",
      "flags": 0,
      "text": "상대에게 위압감을 줘서\\n이쪽을 향한 선제 기술을\\n사용할 수 없게 한다."
    },
    {
      "index": 215,
      "id": "TOKUSEIINFO_215",
      "hash": "8dd3c406dbbac4ec",
      "flags": 0,
      "text": "상대가 쓰러뜨렸을 때\\nHP의 남은 양만큼\\n상대에게 데미지를 준다."
    },
    {
      "index": 216,
      "id": "TOKUSEIINFO_216",
      "hash": "8dd3c706dbbaca05",
      "flags": 0,
      "text": "누군가 춤 기술을 쓰면\\n자신도 이어서\\n춤 기술을 쓸 수 있다."
    },
    {
      "index": 217,
      "id": "TOKUSEIINFO_217",
      "hash": "8dd3c606dbbac852",
      "flags": 0,
      "text": "같은 편 특수 기술의\\n위력을 올린다."
    },
    {
      "index": 218,
      "id": "TOKUSEIINFO_218",
      "hash": "8dd3c906dbbacd6b",
      "flags": 0,
      "text": "상대로부터 받은 접촉하는 기술의\\n데미지를 반감시키지만 불꽃타입\\n기술의 데미지는 2배가 된다."
    },
    {
      "index": 219,
      "id": "TOKUSEIINFO_219",
      "hash": "8dd3c806dbbacbb8",
      "flags": 0,
      "text": "상대를 놀라게 해서\\n이쪽을 향한 선제 기술을\\n사용할 수 없게 한다."
    },
    {
      "index": 220,
      "id": "TOKUSEIINFO_220",
      "hash": "8dc94f06dbb1a998",
      "flags": 0,
      "text": "포켓몬이 기절할 때마다\\n특수공격이 올라간다."
    },
    {
      "index": 221,
      "id": "TOKUSEIINFO_221",
      "hash": "8dc95006dbb1ab4b",
      "flags": 0,
      "text": "공격으로 자신과 접촉한 상대의\\n스피드를 떨어뜨린다."
    },
    {
      "index": 222,
      "id": "TOKUSEIINFO_222",
      "hash": "8dc95106dbb1acfe",
      "flags": 0,
      "text": "쓰러진 같은 편의 특성을\\n이어받아 같은 특성이 된다."
    },
    {
      "index": 223,
      "id": "TOKUSEIINFO_223",
      "hash": "8dc95206dbb1aeb1",
      "flags": 0,
      "text": "쓰러진 같은 편의 특성을\\n이어받아 같은 특성으로 바뀐다."
    },
    {
      "index": 224,
      "id": "TOKUSEIINFO_224",
      "hash": "8dc95306dbb1b064",
      "flags": 0,
      "text": "상대를 기절시켰을 때\\n자신의 가장 높은\\n능력이 올라간다."
    },
    {
      "index": 225,
      "id": "TOKUSEIINFO_225",
      "hash": "8dc95406dbb1b217",
      "flags": 0,
      "text": "지니고 있는 메모리로\\n자신의 타입이 변한다."
    },
    {
      "index": 226,
      "id": "TOKUSEIINFO_226",
      "hash": "8dc95506dbb1b3ca",
      "flags": 0,
      "text": "등장했을 때\\n일렉트릭필드를 사용한다."
    },
    {
      "index": 227,
      "id": "TOKUSEIINFO_227",
      "hash": "8dc95606dbb1b57d",
      "flags": 0,
      "text": "등장했을 때\\n사이코필드를 사용한다."
    },
    {
      "index": 228,
      "id": "TOKUSEIINFO_228",
      "hash": "8dc94706dbb19c00",
      "flags": 0,
      "text": "등장했을 때\\n미스트필드를 사용한다."
    },
    {
      "index": 229,
      "id": "TOKUSEIINFO_229",
      "hash": "8dc94806dbb19db3",
      "flags": 0,
      "text": "등장했을 때\\n그래스필드를 사용한다."
    },
    {
      "index": 230,
      "id": "TOKUSEIINFO_230",
      "hash": "8dccd506dbb4c321",
      "flags": 0,
      "text": "상대 기술이나 특성으로\\n능력을 떨어뜨릴 수 없다."
    },
    {
      "index": 231,
      "id": "TOKUSEIINFO_231",
      "hash": "8dccd406dbb4c16e",
      "flags": 0,
      "text": "HP가 꽉 찼을 때\\n받는 데미지가 줄어든다."
    },
    {
      "index": 232,
      "id": "TOKUSEIINFO_232",
      "hash": "8dccd306dbb4bfbb",
      "flags": 0,
      "text": "효과가 굉장한\\n공격의 위력을\\n약하게 만든다."
    },
    {
      "index": 233,
      "id": "TOKUSEIINFO_233",
      "hash": "8dccd206dbb4be08",
      "flags": 0,
      "text": "효과가 굉장한 공격의\\n위력이 더욱 올라간다."
    }
  ],
