  "lines": [
    {
      "index": 0,
      "id": "msg_sub056_partner_a_01",
      "hash": "efa39c4895ade53f",
      "flags": 0,
      "text": "피!?"
    },
    {
      "index": 1,
      "id": "msg_sub015_partner_b_01",
      "hash": "a95d54c4875f7a5b",
      "flags": 0,
      "text": "브이!?"
    },
    {
      "index": 2,
      "id": "msg_sub056_partner_a_02",
      "hash": "efa39d4895ade6f2",
      "flags": 0,
      "text": "피카! 피~카!"
    },
    {
      "index": 3,
      "id": "msg_sub015_partner_b_02",
      "hash": "a95d55c4875f7c0e",
      "flags": 0,
      "text": "이브이! 브~이!"
    },
    {
      "index": 4,
      "id": "msg_sub056_system_01",
      "hash": "72c7ea0669721b24",
      "flags": 0,
      "text": "분수가 물을\\n기운차게 뿜어내고 있다!"
    },
    {
      "index": 5,
      "id": "msg_sub056_system_02",
      "hash": "72c7ed066972203d",
      "flags": 0,
      "text": "돈을 던져 볼까?"
    },
    {
      "index": 6,
      "id": "msg_sub056_select_01",
      "hash": "774706d385c90187",
      "flags": 0,
      "text": "500원을 던진다"
    },
    {
      "index": 7,
      "id": "msg_sub056_select_02",
      "hash": "774707d385c9033a",
      "flags": 0,
      "text": "50원을 던진다"
    },
    {
      "index": 8,
      "id": "msg_sub056_select_03",
      "hash": "774708d385c904ed",
      "flags": 0,
      "text": "던지지 않는다"
    },
    {
      "index": 9,
      "id": "msg_sub056_system_03",
      "hash": "72c7ec0669721e8a",
      "flags": 0,
      "text": "...퐁당 퐁당 퐁당!!"
    },
    {
      "index": 10,
      "id": "msg_sub056_system_04",
      "hash": "72c7e7066972160b",
      "flags": 0,
      "text": "...퐁당!"
    },
    {
      "index": 11,
      "id": "msg_sub056_system_05",
      "hash": "72c7e60669721458",
      "flags": 0,
      "text": "[VAR TRNAME(0000)][VAR VARKOR00(0001)]\\n[VAR NUM3(0001)]원을 던져 넣었다!"
    },
    {
      "index": 12,
      "id": "msg_sub056_partner_a_03",
      "hash": "efa39e4895ade8a5",
      "flags": 0,
      "text": "피카! 피카피~!"
    },
    {
      "index": 13,
      "id": "msg_sub015_partner_b_03",
      "hash": "a95d56c4875f7dc1",
      "flags": 0,
      "text": "브이브이! 브~이!"
    },
    {
      "index": 14,
      "id": "msg_sub056_system_06",
      "hash": "72c7e90669721971",
      "flags": 0,
      "text": "[VAR PKNICK(0003)][VAR VARKOR00(0001)]\\n왠지 기뻐 보인다!"
    },
    {
      "index": 15,
      "id": "msg_sub056_system_07",
      "hash": "72c7e806697217be",
      "flags": 0,
      "text": "...돈이 부족하다"
    },
    {
      "index": 16,
      "id": "msg_sub056_miniskirt_01",
      "hash": "3f506ddc38bcd6e3",
      "flags": 0,
      "text": "블루시티의 분수에 내려오는\\n전설을 알고 있니?\\c\\n포켓몬과 함께\\n돈을 던져 넣으면\\c\\n엄청나게 사이가\\n좋아진대!"
    },
    {
      "index": 17,
      "id": "msg_sub056_poke_01",
      "hash": "6732d6f3bfcdb8f4",
      "flags": 0,
      "text": "뚜벅쵸: 뚜벅~"
    },
    {
      "index": 18,
      "id": "msg_sub056_muscle_01",
      "hash": "40b7f6510fa95462",
      "flags": 0,
      "text": "[~ 18]"
