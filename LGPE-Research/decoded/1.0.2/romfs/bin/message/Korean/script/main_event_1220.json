  "lines": [
    {
      "index": 0,
      "id": "msg_main1220_partner_a_01",
      "hash": "4efb61fc06ce0c44",
      "flags": 0,
      "text": "피카~치!"
    },
    {
      "index": 1,
      "id": "msg_main1220_partner_b_01",
      "hash": "f89599f46b644f3b",
      "flags": 0,
      "text": "브이 브~이!"
    },
    {
      "index": 2,
      "id": "msg_main1220_young_f_01",
      "hash": "b718baf58baac5e5",
      "flags": 0,
      "text": "어머 [VAR POKNAME(0002)]!"
    },
    {
      "index": 3,
      "id": "msg_main1220_young_f_02",
      "hash": "b718b7f58baac0cc",
      "flags": 0,
      "text": "뭐 하고 있냐고?"
    },
    {
      "index": 4,
      "id": "msg_main1220_young_f_03",
      "hash": "b718b8f58baac27f",
      "flags": 0,
      "text": "꽃을 따고 있어\\c\\n꽃다발을 만들어서\\n소중한 사람에게 줄 거야"
    },
    {
      "index": 5,
      "id": "msg_main1220_young_f_04",
      "hash": "b718b5f58baabd66",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]\\n...지금 이건 비밀이야!"
    },
    {
      "index": 6,
      "id": "msg_main1220_young_f_05",
      "hash": "b718b6f58baabf19",
      "flags": 0,
      "text": "...그 그러고 보니\\c\\n상록시티의 체육관 관장이\\n돌아왔대!\\c\\n자 자!\\n상록시티로 고고~!"
    },
    {
      "index": 7,
      "id": "msg_main1220_young_f_06",
      "hash": "b718b3f58baaba00",
      "flags": 0,
      "text": "꽃을 따고 있던 거\\n[VAR TRNAME(0001)]에게는\\r\\n절대로 말하면 안 돼!"
    }
  ],
  "unpaired_labels": [
