{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub024_researcher_01",
      "hash": "d427d40043ea8c98",
      "flags": 0,
      "text": "안녕~!\\c\\n나는 중요~한 박사란다\\c\\n언제나 희귀한 화석을\\n연구하고 있지!\\c\\n너!\\n좋은 화석을 가지고 있니?"
    },
    {
      "index": 1,
      "id": "msg_sub024_select_01",
      "hash": "9c5bbb480ccf64a2",
      "flags": 0,
      "text": "조개화석"
    },
    {
      "index": 2,
      "id": "msg_sub024_select_02",
      "hash": "9c5bba480ccf62ef",
      "flags": 0,
      "text": "껍질화석"
    },
    {
      "index": 3,
      "id": "msg_sub024_select_03",
      "hash": "9c5bb9480ccf613c",
      "flags": 0,
      "text": "비밀의호박"
    },
    {
      "index": 4,
      "id": "msg_sub024_select_04",
      "hash": "9c5bb8480ccf5f89",
      "flags": 0,
      "text": "그만둔다"
    },
    {
      "index": 5,
      "id": "msg_sub024_researcher_02",
      "hash": "d427d70043ea91b1",
      "flags": 0,
      "text": "가지고 있지 않네..."
    },
    {
      "index": 6,
      "id": "msg_sub024_researcher_03",
      "hash": "d427d60043ea8ffe",
      "flags": 0,
      "text": "성공했다!\\c\\n역시 화석은\\n[VAR POKNAME(0004)]의 화석이었군!"
    },
    {
      "index": 7,
      "id": "msg_sub024_sys_01",
      "hash": "0fa5772ce07503fd",
      "flags": 0,
      "text": "[VAR TRNAME(0000)][VAR VARKOR00(0001)] 박사로부터\\n[VAR POKNAME(0004)][VAR VARKOR00(0002)] 받았다!"
    },
    {
      "index": 8,
      "id": "msg_sub024_researcher_04",
      "hash": "d427d90043ea9517",
      "flags": 0,
      "text": "오오!\\n그것은 [VAR ITEM2(0002)]!\\c\\n먼 옛날의 포켓몬\\n[VAR POKNAME(0001)]의 화석이군!\\c\\n내가 만든\\n화석재생머신으로\\c\\n짜잔!\\n하고 부활시켜 주지!"
    },
    {
      "index": 9,
      "id": "msg_sub024_researcher_05",
      "hash": "d427d80043ea9364",
      "flags": 0,
      "text": "좋아! 그럼\\n빨리 나한테 줘봐!"
    },
    {
      "index": 10,
      "id": "msg_sub024_sys_02",
      "hash": "0fa5742ce074fee4",
      "flags": 0,
      "text": "[VAR TRNAME(0000)][VAR VARKOR00(0001)] 이상한 박사에게\\n[VAR ITEM2(0002)][VAR VARKOR00(0002)] 맡겼다!"
    },
    {
      "index": 11,
      "id": "msg_sub024_researcher_06",
      "hash": "d427db0043ea987d",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_sub024_researcher_07",
      "hash": "d427da0043ea96ca",
      "flags": 0,
      "text": "그래! 다음에 또 오렴!"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_024_max",
      "hash": "93371b7482b7e5d0"
    }
  ]
}
