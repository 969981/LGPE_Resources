{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "TOKUSEIINFO_000",
      "hash": "7ba40506d12f4b74",
      "flags": 0,
      "text": "―\\n―"
    },
    {
      "index": 1,
      "id": "TOKUSEIINFO_001",
      "hash": "7ba40606d12f4d27",
      "flags": 0,
      "text": "くさい　においを　はなつことによって\\nこうげきした　ときに　あいてを\\nひるませることが　ある。"
    },
    {
      "index": 2,
      "id": "TOKUSEIINFO_002",
      "hash": "7ba40706d12f4eda",
      "flags": 0,
      "text": "とうじょう　したときに\\nてんきを　あめに　する。"
    },
    {
      "index": 3,
      "id": "TOKUSEIINFO_003",
      "hash": "7ba40806d12f508d",
      "flags": 0,
      "text": "まいターン　すばやさが　あがる。"
    },
    {
      "index": 4,
      "id": "TOKUSEIINFO_004",
      "hash": "7ba40106d12f44a8",
      "flags": 0,
      "text": "かたい　こうらに　まもられて\\nあいての　こうげきが\\nきゅうしょに　あたらない。"
    },
    {
      "index": 5,
      "id": "TOKUSEIINFO_005",
      "hash": "7ba40206d12f465b",
      "flags": 0,
      "text": "あいての　わざを　うけても\\nいちげきで　たおされることが　ない。\\nいちげきひっさつわざも　きかない。"
    },
    {
      "index": 6,
      "id": "TOKUSEIINFO_006",
      "hash": "7ba40306d12f480e",
      "flags": 0,
      "text": "あたりを　しめらせることに　よって\\nじばく　などの　ばくはつする　わざを\\nだれも　つかえなくなる。"
    },
    {
      "index": 7,
      "id": "TOKUSEIINFO_007",
      "hash": "7ba40406d12f49c1",
      "flags": 0,
      "text": "じゅうなんな　からだによって\\nまひ　じょうたいに　ならない。"
    },
    {
      "index": 8,
      "id": "TOKUSEIINFO_008",
      "hash": "7ba3fd06d12f3ddc",
      "flags": 0,
      "text": "すなあらしの　とき\\nかいひりつが　あがる。"
    },
    {
      "index": 9,
      "id": "TOKUSEIINFO_009",
      "hash": "7ba3fe06d12f3f8f",
      "flags": 0,
      "text": "せいでんきを　からだに　まとい\\nさわった　あいてを\\nまひさせる　ことがある。"
    },
    {
      "index": 10,
      "id": "TOKUSEIINFO_010",
      "hash": "7ba70b06d1318b7d",
      "flags": 0,
      "text": "でんきタイプの　わざを　うけると\\nダメージを　うけずに　かいふくする。"
    },
    {
      "index": 11,
      "id": "TOKUSEIINFO_011",
      "hash": "7ba70a06d13189ca",
      "flags": 0,
      "text": "みずタイプの　わざを　うけると\\nダメージを　うけずに　かいふくする。"
    },
    {
      "index": 12,
      "id": "TOKUSEIINFO_012",
      "hash": "7ba70906d1318817",
      "flags": 0,
      "text": "どんかん　なので\\nメロメロや　ちょうはつ　じょうたいに\\nならない。"
    },
    {
      "index": 13,
      "id": "TOKUSEIINFO_013",
      "hash": "7ba70806d1318664",
      "flags": 0,
      "text": "あらゆる　てんきの　えいきょうが\\nなくなって　しまう。"
    },
    {
      "index": 14,
      "id": "TOKUSEIINFO_014",
      "hash": "7ba70706d13184b1",
      "flags": 0,
      "text": "ふくがんを　もっているため\\nわざの　めいちゅうりつが　あがる。"
    },
    {
      "index": 15,
      "id": "TOKUSEIINFO_015",
      "hash": "7ba70606d13182fe",
      "flags": 0,
      "text": "ねむれない　たいしつ　なので\\nねむり　じょうたいに　ならない。"
    },
    {
      "index": 16,
      "id": "TOKUSEIINFO_016",
      "hash": "7ba70506d131814b",
      "flags": 0,
      "text": "あいてから　うけた　わざの　タイプに\\nじぶんの　タイプが　へんか　する。"
    },
    {
      "index": 17,
      "id": "TOKUSEIINFO_017",
      "hash": "7ba70406d1317f98",
      "flags": 0,
      "text": "たいないに　めんえきを　もっているため\\nどく　じょうたいに　ならない。"
    },
    {
      "index": 18,
      "id": "TOKUSEIINFO_018",
      "hash": "7ba70306d1317de5",
      "flags": 0,
      "text": "ほのおタイプの　わざを　うけると\\nほのおを　もらい　じぶんが　だす\\nほのおタイプの　わざが　つよくなる。"
    },
    {
      "index": 19,
      "id": "TOKUSEIINFO_019",
      "hash": "7ba70206d1317c32",
      "flags": 0,
      "text": "りんぷんに　まもられて\\nわざの　ついかこうかを　うけなくなる。"
    },
    {
      "index": 20,
      "id": "TOKUSEIINFO_020",
      "hash": "7baa7106d1346ea6",
      "flags": 0,
      "text": "マイペースなので\\nこんらん　じょうたいに　ならない。"
    },
    {
      "index": 21,
      "id": "TOKUSEIINFO_021",
      "hash": "7baa7206d1347059",
      "flags": 0,
      "text": "きゅうばんで　じめんに　はりつき\\nポケモンを　いれかえさせる\\nわざや　どうぐが　きかなくなる。"
    },
    {
      "index": 22,
      "id": "TOKUSEIINFO_022",
      "hash": "7baa6f06d1346b40",
      "flags": 0,
      "text": "とうじょう　したとき　いかくして\\nあいてを　いしゅくさせ\\nあいての　こうげきを　さげて　しまう。"
    },
    {
      "index": 23,
      "id": "TOKUSEIINFO_023",
      "hash": "7baa7006d1346cf3",
      "flags": 0,
      "text": "あいての　かげを　ふみ\\nにげたり　こうたい　できなくする。"
    },
    {
      "index": 24,
      "id": "TOKUSEIINFO_024",
      "hash": "7baa7506d1347572",
      "flags": 0,
      "text": "こうげきを　うけたとき\\nじぶんに　ふれた　あいてを\\nざらざらの　はだで　キズつける。"
    },
    {
      "index": 25,
      "id": "TOKUSEIINFO_025",
      "hash": "7baa7606d1347725",
      "flags": 0,
      "text": "こうかばつぐんの　わざしか\\nあたらない　ふしぎな　ちから。"
    },
    {
      "index": 26,
      "id": "TOKUSEIINFO_026",
      "hash": "7baa7306d134720c",
      "flags": 0,
      "text": "じめんから　うくことによって\\nじめんタイプの　わざを　うけない。"
    },
    {
      "index": 27,
      "id": "TOKUSEIINFO_027",
      "hash": "7baa7406d13473bf",
      "flags": 0,
      "text": "こうげきで　じぶんに　ふれた　あいてを\\nどくや　まひや　ねむり　じょうたいに\\nする　ことがある。　"
    },
    {
      "index": 28,
      "id": "TOKUSEIINFO_028",
      "hash": "7baa7906d1347c3e",
      "flags": 0,
      "text": "じぶんが　なってしまった\\nどくや　まひや　やけどを\\nあいてに　うつす。"
    },
    {
      "index": 29,
      "id": "TOKUSEIINFO_029",
      "hash": "7baa7a06d1347df1",
      "flags": 0,
      "text": "あいての　わざや　とくせいで\\nのうりょくを　さげられない。"
    },
    {
      "index": 30,
      "id": "TOKUSEIINFO_030",
      "hash": "7badf706d137882f",
      "flags": 0,
      "text": "てもちに　ひっこむと\\nじょうたい　いじょうが　なおる。"
    },
    {
      "index": 31,
      "id": "TOKUSEIINFO_031",
      "hash": "7badf606d137867c",
      "flags": 0,
      "text": "でんきタイプの　わざを　じぶんに\\nよせつけ　ダメージを　うけずに\\nとくこうが　あがる。"
    },
    {
      "index": 32,
      "id": "TOKUSEIINFO_032",
      "hash": "7badf906d1378b95",
      "flags": 0,
      "text": "てんのめぐみの　おかげで\\nわざの　ついかこうかが　でやすい。"
    },
    {
      "index": 33,
      "id": "TOKUSEIINFO_033",
      "hash": "7badf806d13789e2",
      "flags": 0,
      "text": "てんきが　あめのとき\\nすばやさが　あがる。"
    },
    {
      "index": 34,
      "id": "TOKUSEIINFO_034",
      "hash": "7badf306d1378163",
      "flags": 0,
      "text": "てんきが　はれのとき\\nすばやさが　あがる。"
    },
    {
      "index": 35,
      "id": "TOKUSEIINFO_035",
      "hash": "7badf206d1377fb0",
      "flags": 0,
      "text": "あたりを　あかるくする　ことで\\nやせいの　ポケモンに\\nそうぐう　しやすくなる。"
    },
    {
      "index": 36,
      "id": "TOKUSEIINFO_036",
      "hash": "7badf506d13784c9",
      "flags": 0,
      "text": "とうじょう　したとき\\nあいての　とくせいを　トレースして\\nおなじ　とくせいに　なる。"
    },
    {
      "index": 37,
      "id": "TOKUSEIINFO_037",
      "hash": "7badf406d1378316",
      "flags": 0,
      "text": "ぶつり　こうげきの\\nいりょくが　２ばいに　なる。"
    },
    {
      "index": 38,
      "id": "TOKUSEIINFO_038",
      "hash": "7badff06d13795c7",
      "flags": 0,
      "text": "じぶんに　さわった　あいてを\\nどく　じょうたいに　する　ことがある。"
    },
    {
      "index": 39,
      "id": "TOKUSEIINFO_039",
      "hash": "7badfe06d1379414",
      "flags": 0,
      "text": "きたえられた　せいしんに　よって\\nあいての　こうげきに　ひるまない。"
    },
    {
      "index": 40,
      "id": "TOKUSEIINFO_040",
      "hash": "7b966d06d123bed0",
      "flags": 0,
      "text": "あつい　マグマを　みにまとい\\nこおり　じょうたいに　ならない。"
    },
    {
      "index": 41,
      "id": "TOKUSEIINFO_041",
      "hash": "7b966e06d123c083",
      "flags": 0,
      "text": "みずのベールを　みにまとい\\nやけど　じょうたいに　ならない。"
    },
    {
      "index": 42,
      "id": "TOKUSEIINFO_042",
      "hash": "7b966f06d123c236",
      "flags": 0,
      "text": "はがねタイプの　ポケモンを\\nじりょくで　ひきつけて\\nにげられなくする。"
    },
    {
      "index": 43,
      "id": "TOKUSEIINFO_043",
      "hash": "7b967006d123c3e9",
      "flags": 0,
      "text": "おとを　しゃだん　することに　よって\\nおとの　こうげきを　うけない。"
    },
    {
      "index": 44,
      "id": "TOKUSEIINFO_044",
      "hash": "7b967106d123c59c",
      "flags": 0,
      "text": "てんきが　あめのとき\\nすこしずつ　ＨＰを　かいふくする。"
    },
    {
      "index": 45,
      "id": "TOKUSEIINFO_045",
      "hash": "7b967206d123c74f",
      "flags": 0,
      "text": "とうじょう　したとき\\nてんきを　すなあらしに　する。"
    },
    {
      "index": 46,
      "id": "TOKUSEIINFO_046",
      "hash": "7b967306d123c902",
      "flags": 0,
      "text": "プレッシャーを　あたえて\\nあいての　つかう　わざの　ＰＰを\\nおおく　へらす。"
    },
    {
      "index": 47,
      "id": "TOKUSEIINFO_047",
      "hash": "7b967406d123cab5",
      "flags": 0,
      "text": "あつい　しぼうで　まもられているので\\nほのおタイプと　こおりタイプの\\nわざの　ダメージを　はんげんさせる。"
    },
    {
      "index": 48,
      "id": "TOKUSEIINFO_048",
      "hash": "7b967506d123cc68",
      "flags": 0,
      "text": "ねむり　じょうたいに　なっても\\n２ばいの　はやさで\\nめざめる　ことが　できる。"
    },
    {
      "index": 49,
      "id": "TOKUSEIINFO_049",
      "hash": "7b967606d123ce1b",
      "flags": 0,
      "text": "じぶんに　さわった　あいてを\\nやけど　じょうたいに　する　ことがある。"
    },
    {
      "index": 50,
      "id": "TOKUSEIINFO_050",
      "hash": "7b997306d125fed9",
      "flags": 0,
      "text": "やせいの　ポケモンから\\nかならず　にげられる。"
    },
    {
      "index": 51,
      "id": "TOKUSEIINFO_051",
      "hash": "7b997206d125fd26",
      "flags": 0,
      "text": "するどい　めの　おかげで\\nめいちゅうりつを　さげられない。"
    },
    {
      "index": 52,
      "id": "TOKUSEIINFO_052",
      "hash": "7b997106d125fb73",
      "flags": 0,
      "text": "ちからじまんの　ハサミを　もっているので\\nあいてに　こうげきを　さげられない。"
    },
    {
      "index": 53,
      "id": "TOKUSEIINFO_053",
      "hash": "7b997006d125f9c0",
      "flags": 0,
      "text": "あいての　つかった　どうぐを\\nひろってくることが　ある。\\nぼうけんちゅうも　ひろってくる。"
    },
    {
      "index": 54,
      "id": "TOKUSEIINFO_054",
      "hash": "7b997706d12605a5",
      "flags": 0,
      "text": "わざを　だすと\\nつぎの　ターンは　やすんでしまう。"
    },
    {
      "index": 55,
      "id": "TOKUSEIINFO_055",
      "hash": "7b997606d12603f2",
      "flags": 0,
      "text": "じぶんの　こうげきが　たかくなるが\\nめいちゅうりつが　さがる。　"
    },
    {
      "index": 56,
      "id": "TOKUSEIINFO_056",
      "hash": "7b997506d126023f",
      "flags": 0,
      "text": "じぶんに　さわった　あいてを\\nメロメロに　することが　ある。"
    },
    {
      "index": 57,
      "id": "TOKUSEIINFO_057",
      "hash": "7b997406d126008c",
      "flags": 0,
      "text": "プラスか　マイナスの　とくせいを　もつ\\nポケモンが　なかまに　いると\\nじぶんの　とくこうが　あがる。"
    },
    {
      "index": 58,
      "id": "TOKUSEIINFO_058",
      "hash": "7b997b06d1260c71",
      "flags": 0,
      "text": "プラスか　マイナスの　とくせいを　もつ\\nポケモンが　なかまに　いると\\nじぶんの　とくこうが　あがる。"
    },
    {
      "index": 59,
      "id": "TOKUSEIINFO_059",
      "hash": "7b997a06d1260abe",
      "flags": 0,
      "text": "てんきの　えいきょうを　うけて\\nみずタイプ　ほのおタイプ　こおりタイプの\\nどれかに　へんかする。"
    },
    {
      "index": 60,
      "id": "TOKUSEIINFO_060",
      "hash": "7b9cf906d1291862",
      "flags": 0,
      "text": "ねんちゃくしつの　からだに\\nどうぐが　くっついているため\\nあいてに　どうぐを　うばわれない。"
    },
    {
      "index": 61,
      "id": "TOKUSEIINFO_061",
      "hash": "7b9cfa06d1291a15",
      "flags": 0,
      "text": "からだの　かわを　ぬぎすてることで\\nじょうたい　いじょうを\\nなおすことが　ある。"
    },
    {
      "index": 62,
      "id": "TOKUSEIINFO_062",
      "hash": "7b9cf706d12914fc",
      "flags": 0,
      "text": "じょうたい　いじょうに　なると\\nこんじょうを　だして\\nこうげきが　あがる。"
    },
    {
      "index": 63,
      "id": "TOKUSEIINFO_063",
      "hash": "7b9cf806d12916af",
      "flags": 0,
      "text": "じょうたい　いじょうに　なると\\nふしぎなうろこが　はんのうして\\nぼうぎょが　あがる。"
    },
    {
      "index": 64,
      "id": "TOKUSEIINFO_064",
      "hash": "7b9cf506d1291196",
      "flags": 0,
      "text": "ヘドロえきを　すいとった　あいては\\nきょうれつな　あくしゅうで\\nダメージを　うけて　ＨＰを　へらす。"
    },
    {
      "index": 65,
      "id": "TOKUSEIINFO_065",
      "hash": "7b9cf606d1291349",
      "flags": 0,
      "text": "ＨＰが　へったとき\\nくさタイプの　わざの\\nいりょくが　あがる。"
    },
    {
      "index": 66,
      "id": "TOKUSEIINFO_066",
      "hash": "7b9cf306d1290e30",
      "flags": 0,
      "text": "ＨＰが　へったとき\\nほのおタイプの　わざの\\nいりょくが　あがる。"
    },
    {
      "index": 67,
      "id": "TOKUSEIINFO_067",
      "hash": "7b9cf406d1290fe3",
      "flags": 0,
      "text": "ＨＰが　へったとき\\nみずタイプの　わざの\\nいりょくが　あがる。"
    },
    {
      "index": 68,
      "id": "TOKUSEIINFO_068",
      "hash": "7b9d0106d12925fa",
      "flags": 0,
      "text": "ＨＰが　へったとき\\nむしタイプの　わざの\\nいりょくが　あがる。"
    },
    {
      "index": 69,
      "id": "TOKUSEIINFO_069",
      "hash": "7b9d0206d12927ad",
      "flags": 0,
      "text": "はんどうを　うける　わざを　だしても\\nＨＰが　へらない。"
    },
    {
      "index": 70,
      "id": "TOKUSEIINFO_070",
      "hash": "7ba07f06d12c31eb",
      "flags": 0,
      "text": "とうじょう　したときに\\nてんきを　はれに　する。"
    },
    {
      "index": 71,
      "id": "TOKUSEIINFO_071",
      "hash": "7ba07e06d12c3038",
      "flags": 0,
      "text": "せんとうで　あいてを\\nにげられなくする。"
    },
    {
      "index": 72,
      "id": "TOKUSEIINFO_072",
      "hash": "7ba08106d12c3551",
      "flags": 0,
      "text": "やるきを　だすことに　よって\\nねむり　じょうたいに　ならない。"
    },
    {
      "index": 73,
      "id": "TOKUSEIINFO_073",
      "hash": "7ba08006d12c339e",
      "flags": 0,
      "text": "しろいけむりに　まもられて\\nあいてに　のうりょくを　さげられない。"
    },
    {
      "index": 74,
      "id": "TOKUSEIINFO_074",
      "hash": "7ba08306d12c38b7",
      "flags": 0,
      "text": "ヨガの　ちからで\\nぶつり　こうげきの　いりょくが\\n２ばいに　なる。"
    },
    {
      "index": 75,
      "id": "TOKUSEIINFO_075",
      "hash": "7ba08206d12c3704",
      "flags": 0,
      "text": "かたい　からに　まもられ\\nあいての　こうげきが\\nきゅうしょに　あたらない。"
    },
    {
      "index": 76,
      "id": "TOKUSEIINFO_076",
      "hash": "7ba08506d12c3c1d",
      "flags": 0,
      "text": "あらゆる　てんきの　えいきょうが\\nきえて　しまう。"
    },
    {
      "index": 77,
      "id": "TOKUSEIINFO_077",
      "hash": "7ba08406d12c3a6a",
      "flags": 0,
      "text": "こんらん　じょうたいの　ときは\\nかいひりつが　アップする。　"
    },
    {
      "index": 78,
      "id": "TOKUSEIINFO_078",
      "hash": "7ba07706d12c2453",
      "flags": 0,
      "text": "でんきタイプの　わざを　うけると\\nダメージを　うけずに　\\nすばやさが　あがる。"
    },
    {
      "index": 79,
      "id": "TOKUSEIINFO_079",
      "hash": "7ba07606d12c22a0",
      "flags": 0,
      "text": "せいべつが　おなじだと\\nとうそうしんを　もやして　つよくなる\\nせいべつが　ちがうと　よわくなる"
    },
    {
      "index": 80,
      "id": "TOKUSEIINFO_080",
      "hash": "7bbef506d145f7fc",
      "flags": 0,
      "text": "ひるむ　たびに\\nふくつのこころを　もやして\\nすばやさが　あがる。"
    },
    {
      "index": 81,
      "id": "TOKUSEIINFO_081",
      "hash": "7bbef606d145f9af",
      "flags": 0,
      "text": "てんきが　あられのとき\\nかいひりつが　あがる。"
    },
    {
      "index": 82,
      "id": "TOKUSEIINFO_082",
      "hash": "7bbef706d145fb62",
      "flags": 0,
      "text": "ＨＰが　すくなくなったら　たべる\\nきのみを　ＨＰ　はんぶんの\\nときに　たべてしまう。"
    },
    {
      "index": 83,
      "id": "TOKUSEIINFO_083",
      "hash": "7bbef806d145fd15",
      "flags": 0,
      "text": "きゅうしょに　こうげきが　あたると\\nいかりくるって　こうげきりょくが\\nさいだいに　なる。"
    },
    {
      "index": 84,
      "id": "TOKUSEIINFO_084",
      "hash": "7bbef106d145f130",
      "flags": 0,
      "text": "もっていた　どうぐが　なくなると\\nすばやさが　あがる。"
    },
    {
      "index": 85,
      "id": "TOKUSEIINFO_085",
      "hash": "7bbef206d145f2e3",
      "flags": 0,
      "text": "たいねつの　からだに　よって\\nほのおタイプの　わざの\\nダメージを　はんげんさせる"
    },
    {
      "index": 86,
      "id": "TOKUSEIINFO_086",
      "hash": "7bbef306d145f496",
      "flags": 0,
      "text": "のうりょく　へんかが\\nいつもの　２ばいに　なる。"
    },
    {
      "index": 87,
      "id": "TOKUSEIINFO_087",
      "hash": "7bbef406d145f649",
      "flags": 0,
      "text": "てんきが　あめのときや　みずタイプの\\nわざで　ＨＰが　かいふくし　はれのときや\\nほのおタイプの　わざで　へってしまう。"
    },
    {
      "index": 88,
      "id": "TOKUSEIINFO_088",
      "hash": "7bbefd06d1460594",
      "flags": 0,
      "text": "あいての　ぼうぎょと　とくぼうを　くらべて\\nひくい　ほうの　のうりょくに　あわせて\\nじぶんの　こうげきか　とくこうを　あげる。"
    },
    {
      "index": 89,
      "id": "TOKUSEIINFO_089",
      "hash": "7bbefe06d1460747",
      "flags": 0,
      "text": "パンチを　つかう　わざの\\nいりょくが　あがる。"
    },
    {
      "index": 90,
      "id": "TOKUSEIINFO_090",
      "hash": "7bc27b06d1491185",
      "flags": 0,
      "text": "どくじょうたいに　なると\\nＨＰが　へらずに　ふえていく。"
    },
    {
      "index": 91,
      "id": "TOKUSEIINFO_091",
      "hash": "7bc27a06d1490fd2",
      "flags": 0,
      "text": "じぶんと　おなじ　タイプの\\nわざの　いりょくが　あがる。"
    },
    {
      "index": 92,
      "id": "TOKUSEIINFO_092",
      "hash": "7bc27906d1490e1f",
      "flags": 0,
      "text": "れんぞくわざを　つかうと　いつも\\nさいこう　かいすう　だすことが　できる。"
    },
    {
      "index": 93,
      "id": "TOKUSEIINFO_093",
      "hash": "7bc27806d1490c6c",
      "flags": 0,
      "text": "てんきが　あめのとき\\nじょうたい　いじょうが　なおる。"
    },
    {
      "index": 94,
      "id": "TOKUSEIINFO_094",
      "hash": "7bc27706d1490ab9",
      "flags": 0,
      "text": "てんきが　はれると\\nとくこうが　あがるが\\nまいターン　ＨＰが　へる。"
    },
    {
      "index": 95,
      "id": "TOKUSEIINFO_095",
      "hash": "7bc27606d1490906",
      "flags": 0,
      "text": "じょうたい　いじょうに　なると\\nすばやさが　あがる。"
    },
    {
      "index": 96,
      "id": "TOKUSEIINFO_096",
      "hash": "7bc27506d1490753",
      "flags": 0,
      "text": "どんな　タイプの　わざでも\\nすべて　ノーマルタイプに　なる。\\nいりょくが　すこし　あがる。"
    },
    {
      "index": 97,
      "id": "TOKUSEIINFO_097",
      "hash": "7bc27406d14905a0",
      "flags": 0,
      "text": "こうげきを　きゅうしょに　あてると\\nいりょくが　さらに　あがる。"
    },
    {
      "index": 98,
      "id": "TOKUSEIINFO_098",
      "hash": "7bc28306d1491f1d",
      "flags": 0,
      "text": "こうげき　いがいでは\\nダメージを　うけない。"
    },
    {
      "index": 99,
      "id": "TOKUSEIINFO_099",
      "hash": "7bc28206d1491d6a",
      "flags": 0,
      "text": "ノーガード　せんぽうに　よって\\nおたがいの　だす　わざが\\nかならず　あたる　ようになる。"
    },
    {
      "index": 100,
      "id": "TOKUSEIINFO_100",
      "hash": "84ba2006d67378df",
      "flags": 0,
      "text": "わざを　だす　じゅんばんが\\nかならず　さいごに　なる。"
    },
    {
      "index": 101,
      "id": "TOKUSEIINFO_101",
      "hash": "84ba1f06d673772c",
      "flags": 0,
      "text": "いりょくが　ひくい　わざの\\nいりょくを　たかくして　こうげきできる。"
    },
    {
      "index": 102,
      "id": "TOKUSEIINFO_102",
      "hash": "84ba2206d6737c45",
      "flags": 0,
      "text": "てんきが　はれのときは\\nじょうたい　いじょうに　ならない。"
    },
    {
      "index": 103,
      "id": "TOKUSEIINFO_103",
      "hash": "84ba2106d6737a92",
      "flags": 0,
      "text": "もっている　どうぐを\\nつかうことが　できない。"
    },
    {
      "index": 104,
      "id": "TOKUSEIINFO_104",
      "hash": "84ba1c06d6737213",
      "flags": 0,
      "text": "あいての　とくせいに\\nじゃまされる　ことなく　あいてに\\nわざを　だすことが　できる。"
    },
    {
      "index": 105,
      "id": "TOKUSEIINFO_105",
      "hash": "84ba1b06d6737060",
      "flags": 0,
      "text": "きょううんを　もっているため\\nあいての　きゅうしょに\\nこうげきが　あたりやすい。"
    },
    {
      "index": 106,
      "id": "TOKUSEIINFO_106",
      "hash": "84ba1e06d6737579",
      "flags": 0,
      "text": "ひんしに　なったとき\\nさわった　あいてに\\nダメージを　あたえる。"
    },
    {
      "index": 107,
      "id": "TOKUSEIINFO_107",
      "hash": "84ba1d06d67373c6",
      "flags": 0,
      "text": "あいての　もつ　きけんな　わざを\\nさっちする　ことができる。"
    },
    {
      "index": 108,
      "id": "TOKUSEIINFO_108",
      "hash": "84ba2806d6738677",
      "flags": 0,
      "text": "とうじょう　したとき\\nあいての　もつ　わざを\\nひとつだけ　よみとる。"
    },
    {
      "index": 109,
      "id": "TOKUSEIINFO_109",
      "hash": "84ba2706d67384c4",
      "flags": 0,
      "text": "あいての　のうりょくの　へんかを\\nむしして　こうげきが　できる。"
    },
    {
      "index": 110,
      "id": "TOKUSEIINFO_110",
      "hash": "84b69a06d6705f56",
      "flags": 0,
      "text": "こうかが　いまひとつの　わざを\\nつうじょうの　いりょくで\\nだすことが　できる。"
    },
    {
      "index": 111,
      "id": "TOKUSEIINFO_111",
      "hash": "84b69b06d6706109",
      "flags": 0,
      "text": "こうかばつぐんに　なってしまう\\nこうげきの　いりょくを\\nよわめる　ことが　できる。"
    },
    {
      "index": 112,
      "id": "TOKUSEIINFO_112",
      "hash": "84b69806d6705bf0",
      "flags": 0,
      "text": "５ターンの　あいだ\\nこうげきと　すばやさが\\nはんぶんに　なる。"
    },
    {
      "index": 113,
      "id": "TOKUSEIINFO_113",
      "hash": "84b69906d6705da3",
      "flags": 0,
      "text": "ゴーストタイプの　ポケモンに\\nノーマルタイプと　かくとうタイプの\\nわざを　あてることが　できる。"
    },
    {
      "index": 114,
      "id": "TOKUSEIINFO_114",
      "hash": "84b69e06d6706622",
      "flags": 0,
      "text": "みずタイプの　わざを　じぶんに　よせつけ\\nダメージは　うけずに　とくこうが　あがる。"
    },
    {
      "index": 115,
      "id": "TOKUSEIINFO_115",
      "hash": "84b69f06d67067d5",
      "flags": 0,
      "text": "てんきが　あられのとき　ＨＰを\\nすこしずつ　かいふく　する。"
    },
    {
      "index": 116,
      "id": "TOKUSEIINFO_116",
      "hash": "84b69c06d67062bc",
      "flags": 0,
      "text": "こうかばつぐんに　なってしまう\\nこうげきの　いりょくを\\nよわめる　ことが　できる。"
    },
    {
      "index": 117,
      "id": "TOKUSEIINFO_117",
      "hash": "84b69d06d670646f",
      "flags": 0,
      "text": "とうじょう　したときに\\nてんきを　あられに　する。"
    },
    {
      "index": 118,
      "id": "TOKUSEIINFO_118",
      "hash": "84b6a206d6706cee",
      "flags": 0,
      "text": "せんとうが　おわったとき\\nあまいミツを　ひろうことが　ある。"
    },
    {
      "index": 119,
      "id": "TOKUSEIINFO_119",
      "hash": "84b6a306d6706ea1",
      "flags": 0,
      "text": "とうじょう　したとき\\nあいての　もちものを\\nみとおすことが　できる。"
    },
    {
      "index": 120,
      "id": "TOKUSEIINFO_120",
      "hash": "84b33406d66d7c2d",
      "flags": 0,
      "text": "はんどうで　ダメージを\\nうける　わざの　いりょくが　あがる。"
    },
    {
      "index": 121,
      "id": "TOKUSEIINFO_121",
      "hash": "84b33306d66d7a7a",
      "flags": 0,
      "text": "もっている　プレートや\\nＺクリスタルの　タイプによって\\nじぶんの　タイプが　かわる。"
    },
    {
      "index": 122,
      "id": "TOKUSEIINFO_122",
      "hash": "84b33206d66d78c7",
      "flags": 0,
      "text": "てんきが　はれのとき\\nじぶんと　みかたの　こうげきと\\nとくぼうの　のうりょくが　あがる。"
    },
    {
      "index": 123,
      "id": "TOKUSEIINFO_123",
      "hash": "84b33106d66d7714",
      "flags": 0,
      "text": "ねむり　じょうたいの　あいてに\\nダメージを　あたえる。"
    },
    {
      "index": 124,
      "id": "TOKUSEIINFO_124",
      "hash": "84b33006d66d7561",
      "flags": 0,
      "text": "さわられた　あいての　どうぐを\\nぬすんで　しまう。"
    },
    {
      "index": 125,
      "id": "TOKUSEIINFO_125",
      "hash": "84b32f06d66d73ae",
      "flags": 0,
      "text": "わざの　ついか　こうかは　なくなるが\\nそのぶん　たかい　いりょくで\\nわざを　だすことが　できる。"
    },
    {
      "index": 126,
      "id": "TOKUSEIINFO_126",
      "hash": "84b32e06d66d71fb",
      "flags": 0,
      "text": "のうりょくの　へんかが　ぎゃくてんして\\nあがるときに　さがり\\nさがるときに　あがる。"
    },
    {
      "index": 127,
      "id": "TOKUSEIINFO_127",
      "hash": "84b32d06d66d7048",
      "flags": 0,
      "text": "あいてを　きんちょうさせて\\nきのみを　たべられなく　させる。"
    },
    {
      "index": 128,
      "id": "TOKUSEIINFO_128",
      "hash": "84b32c06d66d6e95",
      "flags": 0,
      "text": "のうりょくを　さげられると\\nこうげきが　ぐーんと　あがる。"
    },
    {
      "index": 129,
      "id": "TOKUSEIINFO_129",
      "hash": "84b32b06d66d6ce2",
      "flags": 0,
      "text": "ＨＰが　はんぶんに　なると\\nよわきに　なって　こうげきと\\nとくこうが　はんげんする。"
    },
    {
      "index": 130,
      "id": "TOKUSEIINFO_130",
      "hash": "84afae06d66a62a4",
      "flags": 0,
      "text": "こうげきを　うけると　あいての　わざを\\nかなしばり　じょうたいに\\nすることが　ある。"
    },
    {
      "index": 131,
      "id": "TOKUSEIINFO_131",
      "hash": "84afaf06d66a6457",
      "flags": 0,
      "text": "じょうたい　いじょうの　みかたを\\nたまに　なおしてあげる。"
    },
    {
      "index": 132,
      "id": "TOKUSEIINFO_132",
      "hash": "84afb006d66a660a",
      "flags": 0,
      "text": "みかたの　ダメージを\\nへらすことが　できる。"
    },
    {
      "index": 133,
      "id": "TOKUSEIINFO_133",
      "hash": "84afb106d66a67bd",
      "flags": 0,
      "text": "ぶつりわざで　ダメージを　うけると\\nぼうぎょが　さがり\\nすばやさが　ぐーんと　あがる。"
    },
    {
      "index": 134,
      "id": "TOKUSEIINFO_134",
      "hash": "84afaa06d66a5bd8",
      "flags": 0,
      "text": "じぶんの　おもさが\\n２ばいに　なる。"
    },
    {
      "index": 135,
      "id": "TOKUSEIINFO_135",
      "hash": "84afab06d66a5d8b",
      "flags": 0,
      "text": "じぶんの　おもさが\\nはんぶんに　なる。"
    },
    {
      "index": 136,
      "id": "TOKUSEIINFO_136",
      "hash": "84afac06d66a5f3e",
      "flags": 0,
      "text": "ＨＰが　まんたんの　ときに\\nうける　ダメージが　すくなくなる。"
    },
    {
      "index": 137,
      "id": "TOKUSEIINFO_137",
      "hash": "84afad06d66a60f1",
      "flags": 0,
      "text": "どく　じょうたいに　なったとき\\nぶつりわざの　いりょくが　あがる。"
    },
    {
      "index": 138,
      "id": "TOKUSEIINFO_138",
      "hash": "84afa606d66a550c",
      "flags": 0,
      "text": "やけど　じょうたいに　なったとき\\nとくしゅわざの　いりょくが　あがる。"
    },
    {
      "index": 139,
      "id": "TOKUSEIINFO_139",
      "hash": "84afa706d66a56bf",
      "flags": 0,
      "text": "つかった　きのみを\\nなんかいも　つくりだす。"
    },
    {
      "index": 140,
      "id": "TOKUSEIINFO_140",
      "hash": "84aca806d668229b",
      "flags": 0,
      "text": "みかたの　こうげきを　よみとって\\nわざを　かいひする。"
    },
    {
      "index": 141,
      "id": "TOKUSEIINFO_141",
      "hash": "84aca706d66820e8",
      "flags": 0,
      "text": "まいターン　のうりょくの　どれかが\\nぐーんと　あがって　どれかが　さがる。"
    },
    {
      "index": 142,
      "id": "TOKUSEIINFO_142",
      "hash": "84acaa06d6682601",
      "flags": 0,
      "text": "すなあらしや　あられなどの\\nダメージを　うけない。\\nこなの　わざを　うけない。"
    },
    {
      "index": 143,
      "id": "TOKUSEIINFO_143",
      "hash": "84aca906d668244e",
      "flags": 0,
      "text": "さわる　だけで　あいてを\\nどく　じょうたいに　することがある。"
    },
    {
      "index": 144,
      "id": "TOKUSEIINFO_144",
      "hash": "84acac06d6682967",
      "flags": 0,
      "text": "てもちに　ひっこむと\\nＨＰが　すこし　かいふくする。"
    },
    {
      "index": 145,
      "id": "TOKUSEIINFO_145",
      "hash": "84acab06d66827b4",
      "flags": 0,
      "text": "ぼうぎょを　さげる\\nこうかを　うけない。"
    },
    {
      "index": 146,
      "id": "TOKUSEIINFO_146",
      "hash": "84acae06d6682ccd",
      "flags": 0,
      "text": "てんきが　すなあらし　のとき\\nすばやさが　あがる。"
    },
    {
      "index": 147,
      "id": "TOKUSEIINFO_147",
      "hash": "84acad06d6682b1a",
      "flags": 0,
      "text": "へんかわざを　うけにくい\\nからだに　なっている。"
    },
    {
      "index": 148,
      "id": "TOKUSEIINFO_148",
      "hash": "84aca006d6681503",
      "flags": 0,
      "text": "いちばん　さいごに　わざを　だすと\\nわざの　いりょくが　あがる。"
    },
    {
      "index": 149,
      "id": "TOKUSEIINFO_149",
      "hash": "84ac9f06d6681350",
      "flags": 0,
      "text": "てもちの　いちばん　うしろに　いる\\nポケモンに　なりきって　とうじょうして\\nあいてを　ばかす。"
    },
    {
      "index": 150,
      "id": "TOKUSEIINFO_150",
      "hash": "84a92206d6650912",
      "flags": 0,
      "text": "めのまえの　ポケモンに\\nへんしん　してしまう。"
    },
    {
      "index": 151,
      "id": "TOKUSEIINFO_151",
      "hash": "84a92306d6650ac5",
      "flags": 0,
      "text": "あいての　かべや　みがわりを\\nすりぬけて　こうげき　できる"
    },
    {
      "index": 152,
      "id": "TOKUSEIINFO_152",
      "hash": "84a92006d66505ac",
      "flags": 0,
      "text": "あいてに　さわられると\\nあいてを　ミイラに　してしまう。"
    },
    {
      "index": 153,
      "id": "TOKUSEIINFO_153",
      "hash": "84a92106d665075f",
      "flags": 0,
      "text": "あいてを　たおすと\\nじしんが　ついて\\nこうげきが　あがる。"
    },
    {
      "index": 154,
      "id": "TOKUSEIINFO_154",
      "hash": "84a91e06d6650246",
      "flags": 0,
      "text": "あくタイプの　こうげきを　うけると\\nせいぎかんで　こうげきが　あがる。"
    },
    {
      "index": 155,
      "id": "TOKUSEIINFO_155",
      "hash": "84a91f06d66503f9",
      "flags": 0,
      "text": "あくタイプと　ゴーストタイプと\\nむしタイプの　わざを　うけると\\nびびって　すばやさが　あがる。"
    },
    {
      "index": 156,
      "id": "TOKUSEIINFO_156",
      "hash": "84a91c06d664fee0",
      "flags": 0,
      "text": "あいてに　だされた　へんかわざを　うけずに\\nそのまま　かえす　ことが　できる。"
    },
    {
      "index": 157,
      "id": "TOKUSEIINFO_157",
      "hash": "84a91d06d6650093",
      "flags": 0,
      "text": "くさタイプの　わざを　うけると\\nダメージを　うけずに\\nこうげきが　あがる。"
    },
    {
      "index": 158,
      "id": "TOKUSEIINFO_158",
      "hash": "84a92a06d66516aa",
      "flags": 0,
      "text": "へんかわざを　せんせいで\\nだすことが　できる。"
    },
    {
      "index": 159,
      "id": "TOKUSEIINFO_159",
      "hash": "84a92b06d665185d",
      "flags": 0,
      "text": "てんきが　すなあらしの　とき\\nいわタイプと　じめんタイプと\\nはがねタイプの　いりょくが　あがる。"
    },
    {
      "index": 160,
      "id": "TOKUSEIINFO_160",
      "hash": "84a59c06d661ef89",
      "flags": 0,
      "text": "じぶんに　さわった　あいてに\\nてつのトゲで　ダメージを　あたえる。"
    },
    {
      "index": 161,
      "id": "TOKUSEIINFO_161",
      "hash": "84a59b06d661edd6",
      "flags": 0,
      "text": "ＨＰが　はんぶん　いかに　なると\\nすがたが　へんかする。"
    },
    {
      "index": 162,
      "id": "TOKUSEIINFO_162",
      "hash": "84a59a06d661ec23",
      "flags": 0,
      "text": "じぶんや　みかたの\\nめいちゅうりつが　あがる。"
    },
    {
      "index": 163,
      "id": "TOKUSEIINFO_163",
      "hash": "84a59906d661ea70",
      "flags": 0,
      "text": "あいての　とくせいに　じゃまされず\\nあいてに　わざを　だすことが　できる。"
    },
    {
      "index": 164,
      "id": "TOKUSEIINFO_164",
      "hash": "84a5a006d661f655",
      "flags": 0,
      "text": "あいての　とくせいに　じゃまされず\\nあいてに　わざを　だすことが　できる。"
    },
    {
      "index": 165,
      "id": "TOKUSEIINFO_165",
      "hash": "84a59f06d661f4a2",
      "flags": 0,
      "text": "じぶんと　みかたへの　メンタル\\nこうげきを　ふせぐことが　できる。"
    },
    {
      "index": 166,
      "id": "TOKUSEIINFO_166",
      "hash": "84a59e06d661f2ef",
      "flags": 0,
      "text": "みかたの　くさポケモンは\\nのうりょくが　さがらず\\nじょうたい　いじょうにも　ならない。"
    },
    {
      "index": 167,
      "id": "TOKUSEIINFO_167",
      "hash": "84a59d06d661f13c",
      "flags": 0,
      "text": "どんな　きのみでも\\nたべると　ＨＰも　かいふくする。"
    },
    {
      "index": 168,
      "id": "TOKUSEIINFO_168",
      "hash": "84a5a406d661fd21",
      "flags": 0,
      "text": "じぶんが　だす　わざと\\nおなじ　タイプに　へんかする。"
    },
    {
      "index": 169,
      "id": "TOKUSEIINFO_169",
      "hash": "84a5a306d661fb6e",
      "flags": 0,
      "text": "あいてから　うける　ぶつりわざの\\nダメージが　はんぶんに　なる。"
    },
    {
      "index": 170,
      "id": "TOKUSEIINFO_170",
      "hash": "84a21606d65ed600",
      "flags": 0,
      "text": "わざを　あてた　あいての\\nどうぐを　うばってしまう。"
    },
    {
      "index": 171,
      "id": "TOKUSEIINFO_171",
      "hash": "84a21706d65ed7b3",
      "flags": 0,
      "text": "あいての　たまや　ばくだんなどの\\nわざを　ふせぐことが　できる。"
    },
    {
      "index": 172,
      "id": "TOKUSEIINFO_172",
      "hash": "84a21806d65ed966",
      "flags": 0,
      "text": "のうりょくを　さげられると\\nとくこうが　ぐーんと　あがる。"
    },
    {
      "index": 173,
      "id": "TOKUSEIINFO_173",
      "hash": "84a21906d65edb19",
      "flags": 0,
      "text": "あごが　がんじょうで\\nかむ　わざの　いりょくが\\nたかくなる。"
    },
    {
      "index": 174,
      "id": "TOKUSEIINFO_174",
      "hash": "84a21a06d65edccc",
      "flags": 0,
      "text": "ノーマルタイプの　わざが\\nこおりタイプになる。\\nいりょくが　すこし　あがる。"
    },
    {
      "index": 175,
      "id": "TOKUSEIINFO_175",
      "hash": "84a21b06d65ede7f",
      "flags": 0,
      "text": "みかたの　ポケモンは\\nねむらなくなる。"
    },
    {
      "index": 176,
      "id": "TOKUSEIINFO_176",
      "hash": "84a21c06d65ee032",
      "flags": 0,
      "text": "こうげきわざを　だすと　ブレードフォルムに\\nわざ　キングシールドを　だすと\\nシールドフォルムに　へんかする。"
    },
    {
      "index": 177,
      "id": "TOKUSEIINFO_177",
      "hash": "84a21d06d65ee1e5",
      "flags": 0,
      "text": "ＨＰが　まんたん　だと\\nひこうタイプの　わざを\\nせんせいで　だすことが　できる。"
    },
    {
      "index": 178,
      "id": "TOKUSEIINFO_178",
      "hash": "84a21e06d65ee398",
      "flags": 0,
      "text": "はどうの　わざの\\nいりょくが　たかくなる。"
    },
    {
      "index": 179,
      "id": "TOKUSEIINFO_179",
      "hash": "84a21f06d65ee54b",
      "flags": 0,
      "text": "グラスフィールドのとき\\nぼうぎょが　あがる。"
    },
    {
      "index": 180,
      "id": "TOKUSEIINFO_180",
      "hash": "84d53006d68a5bc7",
      "flags": 0,
      "text": "みかたが　どうぐを　つかうと\\nじぶんの　もっている　どうぐを\\nみかたに　わたす。"
    },
    {
      "index": 181,
      "id": "TOKUSEIINFO_181",
      "hash": "84d52f06d68a5a14",
      "flags": 0,
      "text": "あいてに　せっしょくする　わざの\\nいりょくが　たかくなる。"
    },
    {
      "index": 182,
      "id": "TOKUSEIINFO_182",
      "hash": "84d53206d68a5f2d",
      "flags": 0,
      "text": "ノーマルタイプの　わざが\\nフェアリータイプになる。\\nいりょくが　すこし　あがる。"
    },
    {
      "index": 183,
      "id": "TOKUSEIINFO_183",
      "hash": "84d53106d68a5d7a",
      "flags": 0,
      "text": "こうげきで　じぶんに　ふれた　あいての\\nすばやさを　さげる。"
    },
    {
      "index": 184,
      "id": "TOKUSEIINFO_184",
      "hash": "84d52c06d68a54fb",
      "flags": 0,
      "text": "ノーマルタイプの　わざが\\nひこうタイプになる。\\nいりょくが　すこし　あがる。"
    },
    {
      "index": 185,
      "id": "TOKUSEIINFO_185",
      "hash": "84d52b06d68a5348",
      "flags": 0,
      "text": "おやこ　２ひきで　２かい\\nこうげきする　ことが　できる。"
    },
    {
      "index": 186,
      "id": "TOKUSEIINFO_186",
      "hash": "84d52e06d68a5861",
      "flags": 0,
      "text": "ぜんいんの　あくタイプの\\nわざが　つよくなる。"
    },
    {
      "index": 187,
      "id": "TOKUSEIINFO_187",
      "hash": "84d52d06d68a56ae",
      "flags": 0,
      "text": "ぜんいんの　フェアリータイプの\\nわざが　つよくなる。"
    },
    {
      "index": 188,
      "id": "TOKUSEIINFO_188",
      "hash": "84d52806d68a4e2f",
      "flags": 0,
      "text": "オーラの　こうかを　ぎゃくてんさせて\\nいりょくを　さげる。"
    },
    {
      "index": 189,
      "id": "TOKUSEIINFO_189",
      "hash": "84d52706d68a4c7c",
      "flags": 0,
      "text": "ほのおタイプの　こうげきを\\nうけない　てんきにする。"
    },
    {
      "index": 190,
      "id": "TOKUSEIINFO_190",
      "hash": "84d1aa06d687423e",
      "flags": 0,
      "text": "みずタイプの　こうげきを\\nうけない　てんきにする。"
    },
    {
      "index": 191,
      "id": "TOKUSEIINFO_191",
      "hash": "84d1ab06d68743f1",
      "flags": 0,
      "text": "ひこうタイプの　じゃくてんが\\nなくなる　てんきにする。"
    },
    {
      "index": 192,
      "id": "TOKUSEIINFO_192",
      "hash": "84d1a806d6873ed8",
      "flags": 0,
      "text": "こうげきを　うけると\\nぼうぎょが　あがる。"
    },
    {
      "index": 193,
      "id": "TOKUSEIINFO_193",
      "hash": "84d1a906d687408b",
      "flags": 0,
      "text": "ＨＰが　はんぶんに　なると\\nあわてて　にげだして\\nてもちに　ひっこんで　しまう。"
    },
    {
      "index": 194,
      "id": "TOKUSEIINFO_194",
      "hash": "84d1ae06d687490a",
      "flags": 0,
      "text": "ＨＰが　はんぶんに　なると\\nきけんを　かいひするため\\nてもちに　ひっこんで　しまう。"
    },
    {
      "index": 195,
      "id": "TOKUSEIINFO_195",
      "hash": "84d1af06d6874abd",
      "flags": 0,
      "text": "みずタイプの　わざを　うけると\\nぼうぎょが　ぐーんと　あがる。"
    },
    {
      "index": 196,
      "id": "TOKUSEIINFO_196",
      "hash": "84d1ac06d68745a4",
      "flags": 0,
      "text": "どく　じょうたいの\\nあいてを　こうげきすると\\nかならず　きゅうしょに　あたる。"
    },
    {
      "index": 197,
      "id": "TOKUSEIINFO_197",
      "hash": "84d1ad06d6874757",
      "flags": 0,
      "text": "ＨＰが　はんぶんに　なると\\nからが　こわれて\\nこうげきてきに　なる。"
    },
    {
      "index": 198,
      "id": "TOKUSEIINFO_198",
      "hash": "84d1a206d68734a6",
      "flags": 0,
      "text": "こうたいで　でてきた　あいてに\\n２ばいの　ダメージで　こうげき　できる。"
    },
    {
      "index": 199,
      "id": "TOKUSEIINFO_199",
      "hash": "84d1a306d6873659",
      "flags": 0,
      "text": "じぶんに　たいする　ほのおタイプの\\nわざの　いりょくを　さげる。\\nやけど　しない。"
    },
    {
      "index": 200,
      "id": "TOKUSEIINFO_200",
      "hash": "8dd05b06dbb7dcaa",
      "flags": 0,
      "text": "はがねタイプの　わざの\\nいりょくが　あがる。"
    },
    {
      "index": 201,
      "id": "TOKUSEIINFO_201",
      "hash": "8dd05c06dbb7de5d",
      "flags": 0,
      "text": "あいての　こうげきで\\nＨＰが　はんぶんに　なると\\nとくこうが　あがる。"
    },
    {
      "index": 202,
      "id": "TOKUSEIINFO_202",
      "hash": "8dd05906dbb7d944",
      "flags": 0,
      "text": "てんきが　あられ　のとき\\nすばやさが　あがる。"
    },
    {
      "index": 203,
      "id": "TOKUSEIINFO_203",
      "hash": "8dd05a06dbb7daf7",
      "flags": 0,
      "text": "すべての　わざを\\nあいてに　せっしょく　しないで\\nだすことが　できる。"
    },
    {
      "index": 204,
      "id": "TOKUSEIINFO_204",
      "hash": "8dd05706dbb7d5de",
      "flags": 0,
      "text": "すべての　おとわざが\\nみずタイプに　なる。"
    },
    {
      "index": 205,
      "id": "TOKUSEIINFO_205",
      "hash": "8dd05806dbb7d791",
      "flags": 0,
      "text": "かいふくわざを　せんせいで\\nだすことが　できる。"
    },
    {
      "index": 206,
      "id": "TOKUSEIINFO_206",
      "hash": "8dd05506dbb7d278",
      "flags": 0,
      "text": "ノーマルタイプの　わざが\\nでんきタイプになる。\\nいりょくが　すこし　あがる。"
    },
    {
      "index": 207,
      "id": "TOKUSEIINFO_207",
      "hash": "8dd05606dbb7d42b",
      "flags": 0,
      "text": "エレキフィールド　のとき\\nすばやさが　２ばいに　なる。"
    },
    {
      "index": 208,
      "id": "TOKUSEIINFO_208",
      "hash": "8dd05306dbb7cf12",
      "flags": 0,
      "text": "ＨＰが　おおいときは　むれて　つよくなる。\\nＨＰの　のこりが　すくなくなると\\nむれは　ちりぢりに　なってしまう。"
    },
    {
      "index": 209,
      "id": "TOKUSEIINFO_209",
      "hash": "8dd05406dbb7d0c5",
      "flags": 0,
      "text": "からだを　おおう　ばけのかわで　\\n１かい　こうげきを　ふせぐことが　できる。"
    },
    {
      "index": 210,
      "id": "TOKUSEIINFO_210",
      "hash": "8dd3c106dbbabfd3",
      "flags": 0,
      "text": "あいてを　たおすと　トレーナーとの\\nきずなが　ふかまり　サトシゲッコウガに\\nへんげする。みずしゅりけんが　つよくなる。"
    },
    {
      "index": 211,
      "id": "TOKUSEIINFO_211",
      "hash": "8dd3c006dbbabe20",
      "flags": 0,
      "text": "ＨＰが　はんぶんに　なると\\nセルたちが　おうえんに　かけつけ\\nパーフェクトフォルムに　すがたを　かえる。"
    },
    {
      "index": 212,
      "id": "TOKUSEIINFO_212",
      "hash": "8dd3c306dbbac339",
      "flags": 0,
      "text": "はがねタイプや　どくタイプも\\nどく　じょうたいに　することが　できる。"
    },
    {
      "index": 213,
      "id": "TOKUSEIINFO_213",
      "hash": "8dd3c206dbbac186",
      "flags": 0,
      "text": "つねに　ゆめうつつの　じょうたいで\\nぜったいに　めざめない。\\nねむったまま　こうげきが　できる。"
    },
    {
      "index": 214,
      "id": "TOKUSEIINFO_214",
      "hash": "8dd3c506dbbac69f",
      "flags": 0,
      "text": "あいてに　いあつかんを　あたえ\\nこちらに　むかって　せんせいわざを\\nだせない　ようにする。"
    },
    {
      "index": 215,
      "id": "TOKUSEIINFO_215",
      "hash": "8dd3c406dbbac4ec",
      "flags": 0,
      "text": "あいてに　たおされたとき\\nＨＰの　のこりの　ぶんだけ\\nあいてに　ダメージを　あたえる。"
    },
    {
      "index": 216,
      "id": "TOKUSEIINFO_216",
      "hash": "8dd3c706dbbaca05",
      "flags": 0,
      "text": "だれかが　おどりわざを　つかうと\\nじぶんも　それに　つづいて\\nおどりわざを　だすことが　できる。"
    },
    {
      "index": 217,
      "id": "TOKUSEIINFO_217",
      "hash": "8dd3c606dbbac852",
      "flags": 0,
      "text": "みかたの　とくしゅわざの\\nいりょくを　あげる。"
    },
    {
      "index": 218,
      "id": "TOKUSEIINFO_218",
      "hash": "8dd3c906dbbacd6b",
      "flags": 0,
      "text": "あいてから　うけた　せっしょくする　わざの\\nダメージを　はんげんするが　ほのおタイプの\\nわざの　ダメージは　２ばいになる。"
    },
    {
      "index": 219,
      "id": "TOKUSEIINFO_219",
      "hash": "8dd3c806dbbacbb8",
      "flags": 0,
      "text": "あいてを　びっくり　させて\\nこちらに　むかって　せんせいわざを\\nだせない　ようにする。"
    },
    {
      "index": 220,
      "id": "TOKUSEIINFO_220",
      "hash": "8dc94f06dbb1a998",
      "flags": 0,
      "text": "ポケモンが　ひんしに　なるたびに\\nとくこうが　あがる。"
    },
    {
      "index": 221,
      "id": "TOKUSEIINFO_221",
      "hash": "8dc95006dbb1ab4b",
      "flags": 0,
      "text": "こうげきで　じぶんに　ふれた　あいての\\nすばやさを　さげる。"
    },
    {
      "index": 222,
      "id": "TOKUSEIINFO_222",
      "hash": "8dc95106dbb1acfe",
      "flags": 0,
      "text": "たおされた　みかたの　とくせいを\\nうけついで　おなじ　とくせいに　なる。"
    },
    {
      "index": 223,
      "id": "TOKUSEIINFO_223",
      "hash": "8dc95206dbb1aeb1",
      "flags": 0,
      "text": "たおされた　みかたの　とくせいを　うけつぎ\\nおなじ　とくせいに　かわる。"
    },
    {
      "index": 224,
      "id": "TOKUSEIINFO_224",
      "hash": "8dc95306dbb1b064",
      "flags": 0,
      "text": "あいてを　たおしたとき\\nじぶんの　いちばん　たかい\\nのうりょくが　あがる。　"
    },
    {
      "index": 225,
      "id": "TOKUSEIINFO_225",
      "hash": "8dc95406dbb1b217",
      "flags": 0,
      "text": "もっている　メモリで\\nじぶんの　タイプが　かわる。"
    },
    {
      "index": 226,
      "id": "TOKUSEIINFO_226",
      "hash": "8dc95506dbb1b3ca",
      "flags": 0,
      "text": "とうじょう　したときに\\nエレキフィールドを　はりめぐらせる。"
    },
    {
      "index": 227,
      "id": "TOKUSEIINFO_227",
      "hash": "8dc95606dbb1b57d",
      "flags": 0,
      "text": "とうじょう　したときに\\nサイコフィールドを　はりめぐらせる。"
    },
    {
      "index": 228,
      "id": "TOKUSEIINFO_228",
      "hash": "8dc94706dbb19c00",
      "flags": 0,
      "text": "とうじょう　したときに\\nミストフィールドを　はりめぐらせる。"
    },
    {
      "index": 229,
      "id": "TOKUSEIINFO_229",
      "hash": "8dc94806dbb19db3",
      "flags": 0,
      "text": "とうじょう　したときに\\nグラスフィールドを　はりめぐらせる。"
    },
    {
      "index": 230,
      "id": "TOKUSEIINFO_230",
      "hash": "8dccd506dbb4c321",
      "flags": 0,
      "text": "あいての　わざや　とくせいで\\nのうりょくを　さげられない。"
    },
    {
      "index": 231,
      "id": "TOKUSEIINFO_231",
      "hash": "8dccd406dbb4c16e",
      "flags": 0,
      "text": "ＨＰが　まんたんの　ときに\\nうける　ダメージが　すくなくなる。"
    },
    {
      "index": 232,
      "id": "TOKUSEIINFO_232",
      "hash": "8dccd306dbb4bfbb",
      "flags": 0,
      "text": "こうかばつぐんに　なってしまう\\nこうげきの　いりょくを\\nよわめる　ことが　できる。"
    },
    {
      "index": 233,
      "id": "TOKUSEIINFO_233",
      "hash": "8dccd206dbb4be08",
      "flags": 0,
      "text": "こうかばつぐんの　こうげきで\\nいりょくが　さらに　あがる。"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_tokuseiinfo_max",
      "hash": "7c55fa6c8ed2c7fc"
    }
  ]
}
