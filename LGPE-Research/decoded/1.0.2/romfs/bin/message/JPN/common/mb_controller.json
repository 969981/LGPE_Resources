{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "mb_ctr_win_01",
      "hash": "554d391f561df61b",
      "flags": 0,
      "text": "モンスターボール Plusで\\nおでかけちゅうの　ポケモンが\\nそだてやさんに　あずけられているため\\nもどることが　できません\\n\\nあずけた　ポケモンを　ひきとってから\\nもういちど　おためしください"
    },
    {
      "index": 1,
      "id": "mb_ctr_win_02",
      "hash": "554d3a1f561df7ce",
      "flags": 0,
      "text": "つうしん　しています……\\nでんげんを　きらないでください"
    },
    {
      "index": 2,
      "id": "mb_ctr_win_03",
      "hash": "554d3b1f561df981",
      "flags": 0,
      "text": "モンスターボール Plusに\\nポケモンを　いれて　おでかけしましょう！\\n\\nいっしょに　あるいて　あそんで　あげると\\nポケモンが　すくすく　そだちます\\n\\nたくさん　あるいて　あそんでいると\\nすてきな　ごほうびも　てに　はいります"
    },
    {
      "index": 3,
      "id": "mb_ctr_win_04",
      "hash": "554d3c1f561dfb34",
      "flags": 0,
      "text": "モンスターボール Plusに　プレゼントの\\nポケモンが　はいって　います！\\n\\nコントローラーとして　つなげて\\n「ふしぎなおくりもの」に　いってみましょう！\\n\\nプレゼントの　ポケモンを　うけとるまで\\nおでかけは　できません"
    },
    {
      "index": 4,
      "id": "mb_ctr_win_05",
      "hash": "554d3d1f561dfce7",
      "flags": 0,
      "text": "[~ 4]"
    },
    {
      "index": 5,
      "id": "mb_ctr_win_06",
      "hash": "554d3e1f561dfe9a",
      "flags": 0,
      "text": "じゅんび　しています……\\nでんげんを　きらないで　ください"
    },
    {
      "index": 6,
      "id": "mb_ctr_win_07",
      "hash": "554d3f1f561e004d",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]　と　おでかけしましょう！\\n\\nゲームを　あそんでいないとき\\nモンスターボール Plusの\\n[VAR COLOR(0006)]スティックボタンを　ながおし[VAR COLOR(0000)]　すると\\n[VAR PKNICK(0000)]　と　あそべます\\n\\nおでかけから　もどりたいときは\\n「ポケモンと　おでかけ　する」を\\nもういちど　えらんでください"
    },
    {
      "index": 7,
      "id": "mb_ctr_win_08",
      "hash": "554d301f561de6d0",
      "flags": 0,
      "text": "モンスターボール Plusの　ボタンを　おして\\nつなげてください\\n\\nモンスターボール Plusが　つながったら\\nスティックボタンを　おしてください"
    },
    {
      "index": 8,
      "id": "mb_ctr_win_09",
      "hash": "554d311f561de883",
      "flags": 0,
      "text": "おでかけちゅうの　ポケモンが　います\\nもどしますか？"
    },
    {
      "index": 9,
      "id": "mb_ctr_win_10",
      "hash": "55503e1f56203471",
      "flags": 0,
      "text": "おでかけする　ポケモンを\\nえらんでください"
    },
    {
      "index": 10,
      "id": "mb_ctr_win_11",
      "hash": "55503d1f562032be",
      "flags": 0,
      "text": "ほかの　プレイヤーの\\nおでかけちゅうの　きろくが　あります\\c\\nこのまま　おでかけすると\\nきえてしまいますが　よろしいですか？"
    },
    {
      "index": 11,
      "id": "mb_ctr_win_12",
      "hash": "55503c1f5620310b",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "mb_ctr_win_13",
      "hash": "55503b1f56202f58",
      "flags": 0,
      "text": "おでかけちゅうの　ポケモンが　います\\nもどしますか？"
    },
    {
      "index": 13,
      "id": "mb_ctr_win_14",
      "hash": "5550421f56203b3d",
      "flags": 0,
      "text": "おでかけを　やめますか？"
    },
    {
      "index": 14,
      "id": "mb_ctr_win_15",
      "hash": "5550411f5620398a",
      "flags": 0,
      "text": "つうしん　しています……"
    },
    {
      "index": 15,
      "id": "mb_ctr_win_16",
      "hash": "5550401f562037d7",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]と\\nさいこうに　たのしく　おでかけした！"
    },
    {
      "index": 16,
      "id": "mb_ctr_win_17",
      "hash": "55503f1f56203624",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]と\\nとっても　たのしく　おでかけした！"
    },
    {
      "index": 17,
      "id": "mb_ctr_win_18",
      "hash": "5550361f562026d9",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]と\\nたのしく　おでかけした！"
    },
    {
      "index": 18,
      "id": "mb_ctr_win_19",
      "hash": "5550351f56202526",
      "flags": 0,
      "text": "[VAR PKNICK(0000)]と\\nおでかけした！"
    },
    {
      "index": 19,
      "id": "mb_ctr_win_20",
      "hash": "5553c41f56234dfa",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は\\nおでかけの　ごほうびを　てにいれた！"
    },
    {
      "index": 20,
      "id": "mb_ctr_win_20_s",
      "hash": "736f69acb4ca67c4",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は\\nおでかけの　ごほうびを　てにいれた！"
    },
    {
      "index": 21,
      "id": "mb_ctr_win_21",
      "hash": "5553c51f56234fad",
      "flags": 0,
      "text": "かんりょう　しないと　つかえません\\nじゅんびを　ちゅうし　しますか？"
    },
    {
      "index": 22,
      "id": "mb_ctr_win_22",
      "hash": "5553c21f56234a94",
      "flags": 0,
      "text": "これまでの　おでかけきろく　を\\nこうしん　した！"
    },
    {
      "index": 23,
      "id": "mb_ctr_win_23",
      "hash": "5553c31f56234c47",
      "flags": 0,
      "text": "モンスターボール Plusでは　ない\\nコントローラーが　つながりました\\c\\nおでかけを　やめますか？"
    },
    {
      "index": 24,
      "id": "mb_ctr_win_24",
      "hash": "5553c01f5623472e",
      "flags": 0,
      "text": "じゅんびが　できました！"
    },
    {
      "index": 25,
      "id": "mb_ctr_win_25",
      "hash": "5553c11f562348e1",
      "flags": 0,
      "text": "えらんだポケモンは\\nべつの　モンスターボール Plusで\\r\\nすでに　おでかけ　しています\\c\\nこのまま　おでかけすると\\nべつの　モンスターボール Plusの　きろくは\\r\\nはんえい　されなく　なりますが\\r\\nよろしいですか？"
    },
    {
      "index": 26,
      "id": "mb_ctr_win_26",
      "hash": "5553be1f562343c8",
      "flags": 0,
      "text": "[VAR COLOR(0002)]いっしょに　あるいた[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　たっせい　した！"
    },
    {
      "index": 27,
      "id": "mb_ctr_win_27",
      "hash": "5553bf1f5623457b",
      "flags": 0,
      "text": "[VAR COLOR(0002)]あそんだ[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　たっせい　した！"
    },
    {
      "index": 28,
      "id": "mb_ctr_win_28",
      "hash": "5553bc1f56234062",
      "flags": 0,
      "text": "[VAR COLOR(0002)]たのしく　あそんだ[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　たっせい　した！"
    },
    {
      "index": 29,
      "id": "mb_ctr_win_29",
      "hash": "5553bd1f56234215",
      "flags": 0,
      "text": "[VAR COLOR(0002)]とっても　たのしく　あそんだ[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　たっせい　した！"
    },
    {
      "index": 30,
      "id": "mb_ctr_win_30",
      "hash": "55572a1f56263123",
      "flags": 0,
      "text": "[VAR COLOR(0002)][VAR TRNAME(0001)]に　よびかけた　[VAR COLOR(0000)]を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　たっせい　した！"
    },
    {
      "index": 31,
      "id": "mb_ctr_win_31",
      "hash": "5557291f56262f70",
      "flags": 0,
      "text": "[VAR COLOR(0002)]よびかけに　こたえた[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　たっせい　した！"
    },
    {
      "index": 32,
      "id": "mb_ctr_win_32",
      "hash": "55572c1f56263489",
      "flags": 0,
      "text": "[VAR COLOR(0002)]Pokémon GO　がんばった[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　たっせい　した！"
    },
    {
      "index": 33,
      "id": "mb_ctr_win_33",
      "hash": "55572b1f562632d6",
      "flags": 0,
      "text": "[VAR COLOR(0002)]Pokémon GO　たすけた[VAR COLOR(0000)]　を\\n[VAR COLOR(0002)][VAR NUM9(0000,0000)][VAR COLOR(0000)]　たっせい　した！"
    },
    {
      "index": 34,
      "id": "mb_ctr_win_34",
      "hash": "55572e1f562637ef",
      "flags": 0,
      "text": "レポートを　かいています\\nでんげんを　きらないでください"
    },
    {
      "index": 35,
      "id": "mb_ctr_cap_01",
      "hash": "8040b256847fd729",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 36,
      "id": "mb_ctr_cap_02",
      "hash": "8040af56847fd210",
      "flags": 0,
      "text": "【こんかいの　おでかけきろく】"
    },
    {
      "index": 37,
      "id": "mb_ctr_cap_03",
      "hash": "8040b056847fd3c3",
      "flags": 0,
      "text": "・いっしょに　あるいた"
    },
    {
      "index": 38,
      "id": "mb_ctr_cap_04",
      "hash": "8040b556847fdc42",
      "flags": 0,
      "text": "・あそんだ"
    },
    {
      "index": 39,
      "id": "mb_ctr_cap_05",
      "hash": "8040b656847fddf5",
      "flags": 0,
      "text": "・たのしく　あそんだ"
    },
    {
      "index": 40,
      "id": "mb_ctr_cap_06",
      "hash": "8040b356847fd8dc",
      "flags": 0,
      "text": "・とっても　たのしく　あそんだ"
    },
    {
      "index": 41,
