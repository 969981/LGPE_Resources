    },
    {
      "index": 51,
      "id": "poke_get_25_01",
      "hash": "a28cf059acb43a29",
      "flags": 0,
      "text": "れんぞくゲット　[VAR NUM3(0000)]"
    },
    {
      "index": 52,
      "id": "poke_get_40_01",
      "hash": "f3d3d054a2eb0b0a",
      "flags": 0,
      "text": "オーキド『こんな　ところ　まで\\n[VAR POKNAME(0000)]が　くる　とは\\r\\nめずらしい！\\c\\nせっかく　だから……\\n[VAR COLOR(0006)]ポケモンを　つかまえる[VAR COLOR(0000)]\\r\\nれんしゅうを　して　みよう！\\c\\n[VAR COLOR(0006)]モンスターボール[VAR COLOR(0000)]を　なげて\\nポケモンに　あてて\\r\\nつかまえるんじゃ！"
    },
    {
      "index": 53,
      "id": "poke_get_40_02",
      "hash": "f3d3cf54a2eb0957",
      "flags": 0,
      "text": "オーキド『なかなか\\nむずかしい　ようじゃな！\\c\\nボールを　もっと　あげるから\\nもういちど　がんばって　みるんじゃ！"
    },
    {
      "index": 54,
      "id": "poke_get_50_01",
      "hash": "67046c5e742075ed",
      "flags": 0,
      "text": "Joy-Conを　がめんの　ボールに\\nむけて　まっすぐ　もってください"
    },
    {
      "index": 55,
      "id": "poke_get_50_02",
      "hash": "6704695e742070d4",
      "flags": 0,
      "text": "まっすぐ　もったら\\n「かまえる」　で　Ａボタン！"
    },
    {
      "index": 56,
      "id": "poke_get_50_03",
      "hash": "67046a5e74207287",
      "flags": 0,
      "text": "Joy-Conを　ふって\\nボールを　なげます"
    },
    {
      "index": 57,
      "id": "poke_get_50_04",
      "hash": "6704675e74206d6e",
      "flags": 0,
      "text": "リングを　ねらって　なげましょう！"
    },
    {
      "index": 58,
      "id": "poke_get_50_05",
      "hash": "6704685e74206f21",
      "flags": 0,
      "text": "まわりに　きをつけて\\nふりすぎに　ちゅうい！"
    },
    {
      "index": 59,
      "id": "poke_get_60_01",
      "hash": "d78b089360342284",
      "flags": 0,
      "text": "りょうてで　しっかり　もって\\n「かまえる」　で　Ａボタン！"
    },
    {
      "index": 60,
      "id": "poke_get_60_02",
      "hash": "d78b0b936034279d",
      "flags": 0,
      "text": "かまえている　あいだ　ほんたいを\\nうごかして　まわりを　みわたせます"
    },
    {
      "index": 61,
      "id": "poke_get_60_03",
      "hash": "d78b0a93603425ea",
      "flags": 0,
      "text": "Ａボタンで　がめんの　まんなかに\\nボールを　なげます"
    },
    {
      "index": 62,
      "id": "poke_get_60_04",
      "hash": "d78b059360341d6b",
      "flags": 0,
      "text": "リングを　ねらって　なげましょう！"
    },
    {
      "index": 63,
      "id": "poke_get_60_05",
      "hash": "d78b049360341bb8",
      "flags": 0,
      "text": "みづらかったり　うごかしづらいときは\\nBボタンで　もどってください"
    },
    {
      "index": 64,
      "id": "poke_get_70_01",
      "hash": "1d1727bc4a7b69a7",
      "flags": 0,
      "text": "そうさの　ほうほうが　かわりました\\nさいしょから　やりなおします"
    },
    {
      "index": 65,
      "id": "poke_get_80_01",
      "hash": "b4ecb8880ddd1d76",
      "flags": 0,
      "text": "そうさが　かわりました\\nせつめいを　みますか？"
    },
    {
      "index": 66,
      "id": "poke_get_80_02",
      "hash": "b4ecb7880ddd1bc3",
      "flags": 0,
      "text": "ボールを　なげる　そうさの\\nせつめいを　みますか？"
    },
    {
      "index": 67,
      "id": "poke_get_80_03",
      "hash": "b4ecb6880ddd1a10",
      "flags": 0,
      "text": "きのみは　「バッグ」　から\\nえらんで　つかいます！"
    },
    {
      "index": 68,
      "id": "poke_get_80_04",
      "hash": "b4ecbd880ddd25f5",
      "flags": 0,
      "text": "うごく　リングの　なかに　あてると\\nナイスな　スローに　なる　チャンス！"
    },
    {
      "index": 69,
      "id": "poke_get_80_05",
      "hash": "b4ecbc880ddd2442",
      "flags": 0,
      "text": "リングが　ちいさく　なっているほど\\nいい　スローを　ねらえる　チャンス！"
    }
  ],
