  "lines": [
    {
      "index": 0,
      "id": "poke_get_01_00",
      "hash": "3a06eefb470cba20",
      "flags": 0,
      "text": "ＧＯパークの　[VAR POKNAME(0000)]だ！"
    },
    {
      "index": 1,
      "id": "poke_get_01_01",
      "hash": "3a06effb470cbbd3",
      "flags": 0,
      "text": "あっ！　やせいの\\n[VAR POKNAME(0000)]が　とびだしてきた！"
    },
    {
      "index": 2,
      "id": "poke_get_01_02",
      "hash": "3a06f0fb470cbd86",
      "flags": 0,
      "text": "やせいの　[VAR POKNAME(0000)]を\\nつかまえる　チャンス！"
    },
    {
      "index": 3,
      "id": "poke_get_01_03",
      "hash": "3a06f1fb470cbf39",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]を\\nつかまえる　チャンス！"
    },
    {
      "index": 4,
      "id": "poke_get_01_04",
      "hash": "3a06f2fb470cc0ec",
      "flags": 0,
      "text": "ポケモンを\\nつかまえるのを　あきらめますか？"
    },
    {
      "index": 5,
      "id": "poke_get_01_05",
      "hash": "3a06f3fb470cc29f",
      "flags": 0,
      "text": "ボールを　なげる　そうさの\\nせつめいを　やめますか？"
    },
    {
      "index": 6,
      "id": "poke_get_01_06",
      "hash": "3a06f4fb470cc452",
      "flags": 0,
      "text": "これいじょう　ポケモンを　もてない！\\nいったん　ひきかえそう！"
    },
    {
      "index": 7,
      "id": "poke_get_01_07",
      "hash": "3a06f5fb470cc605",
      "flags": 0,
      "text": "ボールを　ひとつも　もってない！\\nいったん　ひきかえそう！"
    },
    {
      "index": 8,
      "id": "poke_get_01_08",
      "hash": "3a06f6fb470cc7b8",
      "flags": 0,
      "text": "だめだ！　ポケモンが\\nボールから　でてしまった！"
    },
    {
      "index": 9,
      "id": "poke_get_01_09",
      "hash": "3a06f7fb470cc96b",
      "flags": 0,
      "text": "ああ！\\nつかまえたと　おもったのに！"
    },
    {
      "index": 10,
      "id": "poke_get_01_10",
      "hash": "3a0a74fb470fd3a9",
      "flags": 0,
      "text": "ざんねん！\\nもうすこしで　つかまえられたのに！"
    },
    {
      "index": 11,
      "id": "poke_get_01_11",
      "hash": "3a0a73fb470fd1f6",
      "flags": 0,
      "text": "おしい！\\nあと　ちょっとの　ところだったのに！"
    },
    {
      "index": 12,
      "id": "poke_get_01_12",
      "hash": "3a0a72fb470fd043",
      "flags": 0,
      "text": "やったー！\\n[VAR POKNAME(0000)]を　つかまえた！"
    },
    {
      "index": 13,
      "id": "poke_get_01_13",
      "hash": "3a0a71fb470fce90",
      "flags": 0,
      "text": "[VAR POKNAME(0000)]は　にげだした！"
    },
    {
      "index": 14,
      "id": "poke_get_01_14",
      "hash": "3a0a78fb470fda75",
      "flags": 0,
      "text": "うまく　にげきれた！"
    },
    {
      "index": 15,
      "id": "poke_get_01_15",
      "hash": "3a0a77fb470fd8c2",
      "flags": 0,
      "text": "どこから　ともなく\\n[VAR SUPPORT(0000)]が　かけつけた！"
    },
    {
