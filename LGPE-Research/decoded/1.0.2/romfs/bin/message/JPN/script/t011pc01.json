{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t011pc01_woman_01",
      "hash": "52c0f0cdc20ee38c",
      "flags": 0,
      "text": "ポケモンは　しゅるいに　よって\\nせいちょうする　テンポが\\r\\nちがう　らしいわ"
    },
    {
      "index": 1,
      "id": "msg_t011pc01_gentleman_01",
      "hash": "a8510610e35a4373",
      "flags": 0,
      "text": "だれもが　みんな　しってる\\nシルフカンパニー　だが\\c\\nゆうめい　だと　それだけ\\nねらわれる　きけんも　あるのだ"
    },
    {
      "index": 2,
      "id": "msg_t011pc01_chilem_01_01",
      "hash": "ea1d64be063f2a88",
      "flags": 0,
      "text": "あーあ……\\nポケモン　してんのうが　きて\\r\\nロケットだんを　やっつけて\\r\\nくれると　いいな"
    },
    {
      "index": 3,
      "id": "msg_t011pc01_chilem_01_02",
      "hash": "ea1d67be063f2fa1",
      "flags": 0,
      "text": "ロケットだん　にげてったね！\\nこれからは　そと　あるいても\\r\\nちっとも　こわくない！\\r\\nよかったね！"
    },
    {
      "index": 4,
      "id": "msg_t011pc01_book_01",
      "hash": "18e82d1f9496b7c1",
      "flags": 0,
      "text": "『ポケモンジャーナル　インタビュー』\\nと　かかれた　ほんが　ある……"
    },
    {
      "index": 5,
      "id": "msg_t011pc01_select_01",
      "hash": "a278475c44657e9a",
      "flags": 0,
      "text": "よみますか？"
    },
    {
      "index": 6,
      "id": "msg_t011pc01_book_02",
      "hash": "18e82a1f9496b2a8",
      "flags": 0,
      "text": "ヤマブキシティの　かお！\\nからてだいおう　に　みっちゃく！\\r\\nズバリ　つよさの　ひけつは？\\c\\n『オスッ！　かくとうどうじょうを\\nせつりつ　してから　と　いうもの\\c\\nまいにち　かかさず\\nポケモンと　きんにく　トレーニング！\\c\\nみよ！　きたえ　ぬかれた\\nこの　にくたい！　この　ポケモン！\\c\\nらいげつ　ヤマブキジムの\\nとういつ　じあいが　ひらかれるが\\c\\nどんな　ヤツらが　あいて　でも\\nわしの　コブシで　ひとひねり　よ！』"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t011pc01_max",
      "hash": "83c0174e9945a1be"
    }
  ]
}
