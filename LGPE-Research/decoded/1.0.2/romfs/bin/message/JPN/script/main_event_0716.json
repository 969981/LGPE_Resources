{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0716_system_01",
      "hash": "9a38104f995eae02",
      "flags": 0,
      "text": "たかくて\\nとどきそうに　ない！"
    },
    {
      "index": 1,
      "id": "msg_main0716_partner_a_01",
      "hash": "de5283e3612bc8f9",
      "flags": 0,
      "text": "ピ？"
    },
    {
      "index": 2,
      "id": "msg_main0716_partner_b_01",
      "hash": "d9db43cc8dd9f806",
      "flags": 0,
      "text": "ブイ？"
    },
    {
      "index": 3,
      "id": "msg_main0716_system_02",
      "hash": "9a380f4f995eac4f",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]　なら\\nどこかから　うえに　いけるかも……？"
    },
    {
      "index": 4,
      "id": "msg_main0716_system_03",
      "hash": "9a380e4f995eaa9c",
      "flags": 0,
      "text": "ふみだいが　あれば\\nここから　うえに　いけそうだ！"
    },
    {
      "index": 5,
      "id": "msg_main0716_system_14",
      "hash": "9a34874f995b8f60",
      "flags": 0,
      "text": "……まわりを　みわたして\\nのれそうな　ものを　さがそう！"
    },
    {
      "index": 6,
      "id": "msg_main0716_system_04",
      "hash": "9a380d4f995ea8e9",
      "flags": 0,
      "text": "この　イス　なら\\nふみだいに　つかえそう！"
    },
    {
      "index": 7,
      "id": "msg_main0716_system_05",
      "hash": "9a380c4f995ea736",
      "flags": 0,
      "text": "よいしょの……　しょ！"
    },
    {
      "index": 8,
      "id": "msg_main0716_partner_a_02",
      "hash": "de5280e3612bc3e0",
      "flags": 0,
      "text": "ピッカ！"
    },
    {
      "index": 9,
      "id": "msg_main0716_partner_b_02",
      "hash": "d9db42cc8dd9f653",
      "flags": 0,
      "text": "ブイブイッ！"
    },
    {
      "index": 10,
      "id": "msg_main0716_system_06",
      "hash": "9a380b4f995ea583",
      "flags": 0,
      "text": "あいぼうの　ちからを　かりて\\nしたっぱが　なげた　カギを\\r\\nとりにいこう！"
    },
    {
      "index": 11,
      "id": "msg_main0716_system_07",
      "hash": "9a380a4f995ea3d0",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　[VAR PKNICK(0003)]を\\nしんらいの　めで　みつめてる！"
    },
    {
      "index": 12,
      "id": "msg_main0716_system_08",
      "hash": "9a38194f995ebd4d",
      "flags": 0,
      "text": "カベの　なかを　とおって\\nむこうの　パイプを　めざそう！"
    },
    {
      "index": 13,
      "id": "msg_main0716_aporo_03",
      "hash": "70ecc882cf30c026",
      "flags": 0,
      "text": "？？？『ボス　その　カラカラ\\nどう　されたのです？"
    },
    {
      "index": 14,
      "id": "msg_main0716_karakara_01",
      "hash": "afa68ce57bd40ba5",
      "flags": 0,
      "text": "カラカラ『マァ……"
    },
    {
      "index": 15,
      "id": "msg_main0716_sakaki_01",
      "hash": "8705e2c44b7a8fc1",
      "flags": 0,
      "text": "？？？『ぶか　が\\nかってに　つれてきた　のだ"
    },
    {
      "index": 16,
      "id": "msg_main0716_aporo_01",
      "hash": "70ecc682cf30bcc0",
      "flags": 0,
      "text": "？？？『あたまの　ホネが\\nとても　きれいな　カラカラだ……\\c\\nガラガラに　そだてば\\nたかく　うれそう　ですね"
    },
    {
      "index": 17,
      "id": "msg_main0716_aporo_02",
      "hash": "70ecc982cf30c1d9",
      "flags": 0,
      "text": "？？？『……　……　……"
    },
    {
      "index": 18,
      "id": "msg_main0716_system_09",
      "hash": "9a38184f995ebb9a",
      "flags": 0,
      "text": "むずかしい　はなしを\\nしている　みたい"
    },
    {
      "index": 19,
      "id": "msg_main0716_partner_a_03",
      "hash": "de5281e3612bc593",
      "flags": 0,
      "text": "……ピガッ！"
    },
    {
      "index": 20,
      "id": "msg_main0716_partner_b_03",
      "hash": "d9db41cc8dd9f4a0",
      "flags": 0,
      "text": "……ブイヤァ！"
    },
    {
      "index": 21,
      "id": "msg_main0716_system_10",
      "hash": "9a348b4f995b962c",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]は\\n[VAR COLOR(0006)]エレベータのカギ[VAR COLOR(0000)]を　てにいれた！"
    },
    {
      "index": 22,
      "id": "msg_main0716_musashi_01",
      "hash": "9282ba81ee37a857",
      "flags": 0,
      "text": "ムサシ『なんか　へんな\\nものおと　しなかった？"
    },
    {
      "index": 23,
      "id": "msg_main0716_kojiro_01",
      "hash": "3c3113220278a5a5",
      "flags": 0,
      "text": "コジロウ『たしかに　おれも　きいた！\\nもしや……　しんにゅうしゃ　か！？"
    },
    {
      "index": 24,
      "id": "msg_main0716_partner_a_04",
      "hash": "de5286e3612bce12",
      "flags": 0,
      "text": "ピ……"
    },
    {
      "index": 25,
      "id": "msg_main0716_partner_b_04",
      "hash": "d9db48cc8dda0085",
      "flags": 0,
      "text": "イヴ……"
    },
    {
      "index": 26,
      "id": "msg_main0716_nyasu_01",
      "hash": "d5d98422263741ff",
      "flags": 0,
      "text": "ニャース『ぐ～～～！！"
    },
    {
      "index": 27,
      "id": "msg_main0716_kojiro_02",
      "hash": "3c3110220278a08c",
      "flags": 0,
      "text": "コジロウ『……なんだ\\nニャースの　はらの　おと　か"
    },
    {
      "index": 28,
      "id": "msg_main0716_musashi_02",
      "hash": "9282bb81ee37aa0a",
      "flags": 0,
      "text": "ムサシ『まぎらわしい　っての！"
    },
    {
      "index": 29,
      "id": "msg_main0716_musashi_03",
      "hash": "9282bc81ee37abbd",
      "flags": 0,
      "text": "サカキさまの　ペルシアン\\nかっこいい　わよねぇ"
    },
    {
      "index": 30,
      "id": "msg_main0716_kojiro_03",
      "hash": "3c3111220278a23f",
      "flags": 0,
      "text": "かならず　あいてを　ひるませる\\nねこだまし　って　わざが\\r\\nこれまた　つよいん　だよな"
    },
    {
      "index": 31,
      "id": "msg_main0716_musashi_04",
      "hash": "9282b581ee379fd8",
      "flags": 0,
      "text": "ねぇ　きいてよ！\\nわたしの　アーボ！\\r\\n……しんか　したのよ！"
    },
    {
      "index": 32,
      "id": "msg_main0716_kojiro_04",
      "hash": "3c310e2202789d26",
      "flags": 0,
      "text": "おぉ　おめでとう！\\nおれの　ドガースも\\r\\nマタドガスに　なったぞ！"
    },
    {
      "index": 33,
      "id": "msg_main0716_musashi_05",
      "hash": "9282b681ee37a18b",
      "flags": 0,
      "text": "かんぶに　アポロって　やつ\\nいるじゃない？\\c\\nあいつの　ゴルバット　このまえ\\nろうかで　すれちがった　とき\\c\\n……めっちゃ\\nカンジ　わるかったわ！"
    },
    {
      "index": 34,
      "id": "msg_main0716_kojiro_05",
      "hash": "3c310f2202789ed9",
      "flags": 0,
      "text": "アポロの　やつ\\nマタドガスも　もってるし\\c\\nおれと　ほうこうせいが\\nかぶってんだよなぁ……"
    },
    {
      "index": 35,
      "id": "msg_main0716_musashi_06",
      "hash": "9282b781ee37a33e",
      "flags": 0,
      "text": "みはり　ヒマ　ね……"
    },
    {
      "index": 36,
      "id": "msg_main0716_kojiro_06",
      "hash": "3c310c22027899c0",
      "flags": 0,
      "text": "あぁ　ヒマ　だな……"
    },
    {
      "index": 37,
      "id": "msg_main0716_bg_01",
      "hash": "633d1e3b1cd26624",
      "flags": 0,
      "text": "しょうかきが\\nはいっている　はこだ……\\c\\nおもくて　はこべそうに　ない！"
    },
    {
      "index": 38,
      "id": "msg_main0716_bg_02",
      "hash": "633d213b1cd26b3d",
      "flags": 0,
      "text": "ロケットだん　サイキョーさくせん\\n……と　かかれた　しりょう　だ！"
    },
    {
      "index": 39,
      "id": "msg_main0716_bg_03",
      "hash": "633d203b1cd2698a",
      "flags": 0,
      "text": "この　イスは　ガタガタ　してて\\nうごかせそうに　ない"
    },
    {
      "index": 40,
      "id": "msg_main0716_bg_04",
      "hash": "633d1b3b1cd2610b",
      "flags": 0,
      "text": "[~ 40]"
    },
    {
      "index": 41,
      "id": "msg_main0716_bg_05",
      "hash": "633d1a3b1cd25f58",
      "flags": 0,
      "text": "カントーちほうの　ちずだ……\\nわるだくみの　メモが　かいてある！"
    },
    {
      "index": 42,
      "id": "msg_main0716_bg_06",
      "hash": "633d1d3b1cd26471",
      "flags": 0,
      "text": "ダンボールは　おもくて\\nもちあげられない！"
    },
    {
      "index": 43,
      "id": "msg_main0716_bg_07",
      "hash": "633d1c3b1cd262be",
      "flags": 0,
      "text": "なぐりがきの　ちゅういがきだ！\\c\\n『かんきする　あなに\\nポケモンを　いれないで　ください！\\c\\nポケモンが　カベの　うえに\\nのぼって　しまいますよ！』"
    },
    {
      "index": 44,
      "id": "msg_main0716_bg_08",
      "hash": "633d173b1cd25a3f",
      "flags": 0,
      "text": "[~ 44]"
    },
    {
      "index": 45,
      "id": "msg_main0716_bg_09",
      "hash": "633d163b1cd2588c",
      "flags": 0,
      "text": "モニターつきの\\nでんわが　ある……\\c\\nどこに　つながるか　わからない\\nさわらないで　おこう！"
    },
    {
      "index": 46,
      "id": "msg_main0716_bg_10",
      "hash": "633a193b1cd027ce",
      "flags": 0,
      "text": "[~ 46]"
    },
    {
      "index": 47,
      "id": "msg_main0716_bg_11",
      "hash": "633a1a3b1cd02981",
      "flags": 0,
      "text": "『だれでも　なれる\\nあくの　カリスマ！』\\c\\n……と　かかれた　ほんだ！"
    },
    {
      "index": 48,
      "id": "msg_main0716_system_11",
      "hash": "9a348c4f995b97df",
      "flags": 0,
      "text": "[VAR PKNICK(0003)]は　ふたたび\\n[VAR TRNAME(0000)]の　もとに　もどった！"
    },
    {
      "index": 49,
      "id": "msg_main0716_system_12",
      "hash": "9a348d4f995b9992",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　[VAR PKNICK(0003)]から\\n[VAR COLOR(0006)]エレベータのカギ[VAR COLOR(0000)]を　うけとった！"
    },
    {
      "index": 50,
      "id": "msg_main0716_system_13",
      "hash": "9a348e4f995b9b45",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]が　むかえに　きてる！\\nおもいきって　とびつこう！"
    }
  ],
  "unpaired_labels": [
    {
