{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_r003pc01_childm_01",
      "hash": "fa79e8e27f416200",
      "flags": 0,
      "text": "ボールを　ベルトに　セット\\n１　２　３　４　５　６……　と！\\c\\nボックスに　なんびき　いようと\\nしょうぶに　だせる\\r\\nポケモンは　６ひき　までだ"
    },
    {
      "index": 1,
      "id": "msg_r003pc01_gentleman_01",
      "hash": "3e2da3c35bb20158",
      "flags": 0,
      "text": "ハナダシティの　みんか\\nおそわれる……　か！\\c\\nしんぶんに　ロケットだんの\\nじけんが　のらない　ひは　ないな"
    },
    {
      "index": 2,
      "id": "msg_r003pc01_jevenilem_01",
      "hash": "3b11d2702b71f856",
      "flags": 0,
      "text": "ポケモンを　たくさん　つかまえて\\nもちきれなく　なっても\\r\\nバッグの　ボックスに　はいるから\\r\\nべんり　だよな\\c\\nボックスが　ポケモンで　いっぱいでも\\nけんさくも　できるから　あんしんだ"
    },
    {
      "index": 3,
      "id": "msg_r003pc01_girlscout_01",
      "hash": "9ae07f2587837219",
      "flags": 0,
      "text": "ポケモン　つかまえる　ときー\\nみどりの　わっかが　でるとー\\r\\nつかまえやすい　ポケモンでー\\c\\nきいろは　まあまあ　でー\\nあかい　わっかは　むずかしいの！"
    },
    {
      "index": 4,
      "id": "msg_r003pc01_paper_01",
      "hash": "c2daadb183bb777f",
      "flags": 0,
      "text": "しんぶんだ！"
    },
    {
      "index": 5,
      "id": "msg_r003pc01_book_01",
      "hash": "2947e3eb19355224",
      "flags": 0,
      "text": "『ピッピと　おつきさま』\\nと　かかれた　えほん　がある……"
    },
    {
      "index": 6,
      "id": "msg_r003pc01_select_01",
      "hash": "4a46a0a4277d8d43",
      "flags": 0,
      "text": "よみますか？"
    },
    {
      "index": 7,
      "id": "msg_r003pc01_book_02",
      "hash": "2947e6eb1935573d",
      "flags": 0,
      "text": "ピッピは　まんまる\\nまんまる　ピッピ\\c\\nおつきみやまに\\nのぼって　は\\c\\nつきを　みあげて\\nぴっ　ぴっ　ぴっ！\\c\\nたのしく　みんなで\\nまわりだす\\c\\nまんまる　えがおで\\nぴっ　ぴっ　ぴっ！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_r003pc01_max",
