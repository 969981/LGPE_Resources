  "lines": [
    {
      "index": 0,
      "id": "msg_t005r0301_stafff_01",
      "hash": "a8cdebfc51e7fa45",
      "flags": 0,
      "text": "ポケモンタワーは\\nしんだ　ポケモンを　なぐさめるため\\r\\nたてられた　とう　です"
    },
    {
      "index": 1,
      "id": "msg_t005r0301_middlef_01",
      "hash": "5f634170199b91b0",
      "flags": 0,
      "text": "あなたも\\nおはか　まいりに　きたの？\\r\\nポケモン　おもいの　おとこのこ　ね"
    },
    {
      "index": 2,
      "id": "msg_t005r0301_middlef_02",
      "hash": "5f634470199b96c9",
      "flags": 0,
      "text": "あなたも\\nおはか　まいりに　きたの？\\r\\nポケモン　おもいの　おんなのこ　ね"
    },
    {
      "index": 3,
      "id": "msg_t005r0301_middlem_01",
      "hash": "697889aa44bc5e3f",
      "flags": 0,
      "text": "しんだ　ピッピの　コトが\\nわすれられん……！\\c\\n……イカン！\\nなみだが　でて　きおった……"
    },
    {
      "index": 4,
      "id": "msg_t005r0301_youngf_01",
      "hash": "92bb0cde9fc5d2ff",
      "flags": 0,
      "text": "ああ　わたしの　ガーディ……\\nどうして　しんで　しまったの……"
    },
    {
      "index": 5,
      "id": "msg_t005r0301_shaman_01",
      "hash": "48e10c4c2057648f",
      "flags": 0,
      "text": "わたしは　きとうし！\\nどうも　うえの　かいに\\r\\nまよえる　たましいを　かんじる"
    },
    {
      "index": 6,
      "id": "msg_t005r0301_shaman_02",
      "hash": "48e10d4c20576642",
      "flags": 0,
      "text": "うえの　かいに　かんじた\\nまよえる　たましいの　けはいが\\r\\nきえうせた　ようじゃ……！"
    }
  ],
