{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t009pc01_woman_01",
      "hash": "ef9b16f2d5825d07",
      "flags": 0,
      "text": "グレンジムに　きたのに\\nとびらが　あかなくて　はいれないの\\r\\nきっと　どこかに　カギが\\r\\nある　はずよね\\c\\nジムリーダーの　ともだちが\\nむかし　すんでたって　いう\\r\\nあの　やしきかしら……？"
    },
    {
      "index": 1,
      "id": "msg_t009pc01_gentlem_01",
      "hash": "71667a3c008a7ed5",
      "flags": 0,
      "text": "きみには　ともだちは　いるかな？\\c\\nともだちと　こうかんして\\nもらった　ポケモンは\\r\\nとても　はやく　そだつと　いう\\c\\nためして　みる　かちは\\nあると　おもうがね"
    },
    {
      "index": 2,
      "id": "msg_t009pc01_bugcatcher_01",
      "hash": "c6a1ae6b679f8cd1",
      "flags": 0,
      "text": "しんかキャンセル　した　あとも\\nポケモンは　わざを　おぼえるよ\\c\\nわざを　おぼえさせて　いってから\\nしんか　させるのも　コツさ"
    },
    {
      "index": 3,
      "id": "msg_t009pc01_book_01",
      "hash": "57e569499ccb85f0",
      "flags": 0,
      "text": "『ポケモンセンターの　こえ』\\nと　かかれた　ほんが　ある……"
    },
    {
      "index": 4,
      "id": "msg_t009pc01_select_01",
      "hash": "d466e53dfe741bcf",
      "flags": 0,
      "text": "よみますか？"
    },
    {
      "index": 5,
      "id": "msg_t009pc01_book_02",
      "hash": "57e56c499ccb8b09",
      "flags": 0,
      "text": "さいきん　グレンじまの　かざんが\\nかっぱつに　かつどう　して　います\\c\\nだいきぼな　ふんかが　あった　さいは\\nすみやかに　しまの　そとへ！\\c\\nかのうな　かぎり　ポケモンセンターも\\nかいほう　しています\\c\\nかざんばいを　はらって　から\\nおきがるに　おはいり　ください"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t009pc01_max",
      "hash": "b87022a3b7a8a403"
    }
  ]
}
