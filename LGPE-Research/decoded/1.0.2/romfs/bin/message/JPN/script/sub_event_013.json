  "lines": [
    {
      "index": 0,
      "id": "msg_sub013_sister_01",
      "hash": "26f68ca277e78a2c",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]くん！\\c\\nじぶんの　ポケモンに\\nすかれてるか　どうか　しりたい？"
    },
    {
      "index": 1,
      "id": "msg_sub013_sister_02",
      "hash": "26f68fa277e78f45",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]ちゃん！\\c\\nじぶんの　ポケモンに\\nすかれてるか　どうか　しりたい？"
    },
    {
      "index": 2,
      "id": "msg_sub013_sister_03",
      "hash": "26f68ea277e78d92",
      "flags": 0,
      "text": "ポケモンを　だいじに　そだてると\\nトレーナーの　ことを\\r\\nだいすきに　なって　くれるのよ！"
    },
    {
      "index": 3,
      "id": "msg_sub013_sister_04",
      "hash": "26f689a277e78513",
      "flags": 0,
      "text": "それなら　[VAR PKNICK(0001)]の　ようすを\\nちょっと　みてみるわね！"
    },
    {
      "index": 4,
      "id": "msg_sub013_sister_05",
      "hash": "26f688a277e78360",
      "flags": 0,
      "text": "[VAR PKNICK(0001)]は　あなたの　こと\\nだい・だい・だいすき　みたい！\\c\\nおたがいを　しんらい　しあってるのね"
    },
    {
      "index": 5,
      "id": "msg_sub013_sister_06",
      "hash": "26f68ba277e78879",
      "flags": 0,
      "text": "[VAR PKNICK(0001)]は　あなたの　こと\\nだいすき　なのね！\\c\\nいつも　いっしょに　いたいって！"
    },
    {
      "index": 6,
      "id": "msg_sub013_sister_07",
      "hash": "26f68aa277e786c6",
      "flags": 0,
      "text": "[VAR PKNICK(0001)]は　あなたの　こと\\nきに　いってる　みたいよ！"
    },
    {
      "index": 7,
      "id": "msg_sub013_sister_08",
      "hash": "26f695a277e79977",
      "flags": 0,
      "text": "じゅんちょうに　なかよく　なってる！\\nこの　ちょうしで　いきましょう！"
    },
    {
      "index": 8,
      "id": "msg_sub013_sister_09",
      "hash": "26f694a277e797c4",
      "flags": 0,
      "text": "ちょっぴり　なついているわね！\\nいい　せん　いくかもよ！？"
    },
    {
      "index": 9,
      "id": "msg_sub013_sister_10",
      "hash": "26f307a277e47256",
      "flags": 0,
      "text": "まだ　しりあったばかり　なの？\\nこれからに　きたい　よね！"
    },
    {
      "index": 10,
      "id": "msg_sub013_sister_11",
      "hash": "26f308a277e47409",
      "flags": 0,
      "text": "ひょっとして　ポケモンしょうぶで\\nきぜつ　させて　ばかり　なの……？"
    },
    {
      "index": 11,
      "id": "msg_sub013_sister_12",
      "hash": "26f305a277e46ef0",
      "flags": 0,
      "text": "たいへん！　どうして　ほっとくの？\\nすぐに　ポケモンセンター　でしょ！"
    },
    {
      "index": 12,
      "id": "msg_woman1_01_p11_t001_r0201",
      "hash": "d543d023df5a8e8d",
      "flags": 0,
      "text": "[~ 12]"
    },
