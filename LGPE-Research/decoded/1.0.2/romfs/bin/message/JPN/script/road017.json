  "lines": [
    {
      "index": 0,
      "id": "msg_road017_kanban_01",
      "hash": "a226f27247818ecb",
      "flags": 0,
      "text": "チラシが　はってある！\\c\\n……どうぐ　なげすて　ちゅうい！"
    },
    {
      "index": 1,
      "id": "msg_road017_kanban_02",
      "hash": "a226f3724781907e",
      "flags": 0,
      "text": "……おとくな　けいじばん！\\c\\nおなじ　ポケモン　おなじ　レベルでも\\nとるたびに　のうりょくが　すこし\\r\\nちがってて……　そだつと\\r\\nちがいが　おおきく　なる！"
    },
    {
      "index": 2,
      "id": "msg_road017_kanban_03",
      "hash": "a226f47247819231",
      "flags": 0,
      "text": "[~ 2]"
    },
    {
      "index": 3,
      "id": "msg_road017_kanban_07",
      "hash": "a226f872478198fd",
      "flags": 0,
      "text": "……おとくな　けいじばん！\\c\\nポケモンを　つかまえる　ときは\\nいろの　ついた　リングの\\r\\nなかに　ボールを　あてよう！\\c\\nリングが　ちいさい　ときほど\\nナイススロー　グレートスローが\\r\\nでて　つかまえ　やすくなる"
    },
    {
      "index": 4,
      "id": "msg_road017_kanban_04",
      "hash": "a226f572478193e4",
      "flags": 0,
      "text": "ここは　１７ばんどうろ\\nタマムシシティ　……　セキチクシティ"
    },
    {
      "index": 5,
      "id": "msg_road017_kanban_05",
      "hash": "a226f67247819597",
      "flags": 0,
      "text": "チラシが　はってある！\\c\\nゲームを　なげるな！\\nモンスターボールを　なげろ！"
    },
    {
      "index": 6,
      "id": "msg_road017_kanban_06",
      "hash": "a226f7724781974a",
      "flags": 0,
      "text": "ひとと　ポケモン\\nともに　あるく　みち"
    },
    {
      "index": 7,
      "id": "msg_road017_poke_01",
      "hash": "1b23d3da193d6069",
