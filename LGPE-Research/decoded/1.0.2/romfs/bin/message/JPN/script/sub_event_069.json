{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub069_doctor_01",
      "hash": "1e93a31dc54be178",
      "flags": 0,
      "text": "オーキド『よく　きた！\\nポケモンずかんの\\r\\nちょうしは　どうかな？\\nどれ……　ちょっと\\nみて　あげようか！"
    },
    {
      "index": 1,
      "id": "msg_sub069_doctor_02",
      "hash": "1e93a61dc54be691",
      "flags": 0,
      "text": "…………ポケモンずかんの\\nげんざいの　かんせいど　は……\\c\\nみつけた　ポケモン　[VAR NUM3(0004)]！\\nつかまえた　ポケモン　[VAR NUM3(0005)]！\\c\\nオーキドはかせの　ひょうか……"
    },
    {
      "index": 2,
      "id": "msg_sub069_doctor_03",
      "hash": "1e93a51dc54be4de",
      "flags": 0,
      "text": "まだまだ……　これからだ\\nあちこちの　くさむらに　はいって\\r\\nポケモンを　つかまえるのじゃ！"
    },
    {
      "index": 3,
      "id": "msg_sub069_doctor_04",
      "hash": "1e93a81dc54be9f7",
      "flags": 0,
      "text": "どうにか　ちょうしが　でてきたな！\\nボールを　なげる　すがたも\\r\\nイタに　ついて　きた　じゃろう！"
    },
    {
      "index": 4,
      "id": "msg_sub069_doctor_05",
      "hash": "1e93a71dc54be844",
      "flags": 0,
      "text": "ポケモンずかんと　いう　には\\nもっと　ないようが　ほしい　のう！\\r\\nいろんな　ばしょを　あるきまわれい！"
    },
    {
      "index": 5,
      "id": "msg_sub069_doctor_06",
      "hash": "1e93aa1dc54bed5d",
      "flags": 0,
      "text": "ふむ……　がんばってるな！\\n１１ばんどうろ　ゲートに　いる\\c\\nじょしゅに　ジャッジきのうを\\nもたせたぞ！　もらって　くれい！"
    },
    {
      "index": 6,
      "id": "msg_sub069_doctor_07",
      "hash": "1e93a91dc54bebaa",
      "flags": 0,
      "text": "いい　できばえ　じゃないか！\\n１６ばんどうろ　ゲートに　いる\\c\\nじょしゅに　ボールセットを\\nもたせたぞ！　もらって　くれい！"
    },
    {
      "index": 7,
      "id": "msg_sub069_doctor_08",
      "hash": "1e939c1dc54bd593",
      "flags": 0,
      "text": "ついに　５０しゅるいを　こえたか！\\n１５ばんどうろ　ゲートに　いる\\c\\nじょしゅに　すんばらしい　どうぐを\\nもたせたぞ！　もらって　くれい！"
    },
    {
      "index": 8,
      "id": "msg_sub069_doctor_09",
      "hash": "1e939b1dc54bd3e0",
      "flags": 0,
      "text": "ほっほう！　……こりゃ　いい\\nポケモンずかんに　なって　きとる！"
    },
    {
      "index": 9,
      "id": "msg_sub069_doctor_10",
      "hash": "1e901e1dc548c9a2",
      "flags": 0,
      "text": "ぜっこうちょう！　うみや　かわには\\nみずポケモンが　おるからな！\\r\\nつかまえるには　ミズバシリ　じゃ！"
    },
    {
      "index": 10,
      "id": "msg_sub069_doctor_11",
      "hash": "1e901f1dc548cb55",
      "flags": 0,
      "text": "ワンダフル！　もしかして　きみは\\nなにかを　あつめるの　すきなのか！？"
    },
    {
      "index": 11,
      "id": "msg_sub069_doctor_12",
      "hash": "1e901c1dc548c63c",
      "flags": 0,
      "text": "いやはや……　こりゃ　すごい！\\nあつめるのは　たいへん　だったろ！"
    },
    {
      "index": 12,
      "id": "msg_sub069_doctor_13",
      "hash": "1e901d1dc548c7ef",
      "flags": 0,
      "text": "とうとう　１００しゅるい　こえたか！\\n……しんじられない　うでまえじゃ！"
    },
    {
      "index": 13,
      "id": "msg_sub069_doctor_14",
      "hash": "1e901a1dc548c2d6",
      "flags": 0,
      "text": "ポケモンの　しんか　けいたいも\\nはいって　きとる……　すばらしい！"
    },
    {
      "index": 14,
      "id": "msg_sub069_doctor_15",
      "hash": "1e901b1dc548c489",
      "flags": 0,
      "text": "エクセレント！　ともだちと　こうかん\\nすると　もっと　あつまる　かもしれん"
    },
    {
      "index": 15,
      "id": "msg_sub069_doctor_16",
      "hash": "1e90181dc548bf70",
      "flags": 0,
      "text": "ここまで　ずかんが　できたら\\nもはや　プロフェッショナル　じゃ！"
    },
    {
      "index": 16,
      "id": "msg_sub069_doctor_17",
      "hash": "1e90191dc548c123",
      "flags": 0,
      "text": "わしゃ　もう　いうことは　ない！\\nきみが　ポケモンはかせ　じゃ！"
    },
    {
      "index": 17,
      "id": "msg_sub069_doctor_18",
      "hash": "1e90261dc548d73a",
      "flags": 0,
      "text": "ついに　パーフェクトな　ずかんの\\nかんせいじゃ！　……おめでとう！"
    },
    {
      "index": 18,
      "id": "msg_ookido_01_p18_zukan",
      "hash": "f8903db79b5f3656",
      "flags": 0,
      "text": "[~ 18]"
    },
    {
      "index": 19,
      "id": "msg_ookido_01_p19_zukan",
      "hash": "0197460e650a9831",
      "flags": 0,
      "text": "[~ 19]"
    },
    {
      "index": 20,
      "id": "msg_sub069_doctor_19",
      "hash": "1e90271dc548d8ed",
      "flags": 0,
      "text": "ついに……\\nほんとうに　ほんとうに\\r\\nものすごくて　すてきで\\nかんぺきな　ポケモンずかんを\\nかんせい　させたの　じゃな……！"
    },
    {
      "index": 21,
      "id": "msg_sub069_doctor_20",
      "hash": "1e8c981dc545b019",
      "flags": 0,
      "text": "おおおおおーッ！"
    },
    {
      "index": 22,
      "id": "msg_sub069_doctor_21",
      "hash": "1e8c971dc545ae66",
      "flags": 0,
      "text": "ありがとう　[VAR TRNAME(0000)]\\nほんとうに　ありがとう！\\r\\nわしの　ゆめが　かなった！"
    },
    {
      "index": 23,
      "id": "msg_sub069_doctor_22",
      "hash": "1e8c961dc545acb3",
      "flags": 0,
      "text": "オーキド『よく　きた！\\nポケモンずかんの\\r\\nちょうしは　どうかな？\\c\\nわはは……！　ほんとうは\\nもう　わかって　おるのじゃが\\r\\nなんどでも　たしかめたいんじゃ！\\c\\nどれどれ……"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_069_max",
