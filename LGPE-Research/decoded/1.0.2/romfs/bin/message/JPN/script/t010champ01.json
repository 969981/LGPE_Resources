{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t010champ01_gym_01",
      "hash": "1cac950403c4635c",
      "flags": 0,
      "text": "おーす！\\nみらいの　チャンピオン！\\c\\nポケモンリーグ　してんのうは\\n４にん　つづけて\\r\\nしょうぶ　する　ルールだ！\\c\\nまけたら　ひとりめ　から\\nやりなおしに　なるぞ！\\r\\nこれが　さいごだ！　がんばれよ！"
    },
    {
      "index": 1,
      "id": "msg_t010champ01_gym_02",
      "hash": "1cac980403c46875",
      "flags": 0,
      "text": "きょうも　すごい　しあいを\\nみせて　くれよ！\\r\\nきたい　してるぜ！"
    },
    {
      "index": 2,
      "id": "msg_t010champ01_elitef_01_01",
      "hash": "93faddf58bbf00c8",
      "flags": 0,
      "text": "このさきは　してんのうと\\nひとりずつ　たたかうの！\\c\\nもし　かてたら　ドアが　ひらいて\\nおくの　へやに　すすめるわ！\\r\\nがんばって！"
    },
    {
      "index": 3,
      "id": "msg_t010champ01_elitem_01_01",
      "hash": "b3a5cd70f1e89af5",
      "flags": 0,
      "text": "かいものは　すんだ？\\nかいふくは　ＯＫ？\\c\\nさいごの　ふんばりどころ　だもん\\nばんぜんの　じょうたいで\\r\\nいどまなきゃね"
    },
    {
      "index": 4,
      "id": "msg_t010champ01_juggler_01_01",
      "hash": "f0d0ba5524d4176f",
      "flags": 0,
      "text": "ひとりめの　してんのう　に\\nかつことさえ　できない\\c\\nこれが　ポケモンリーグ……\\nさいこうレベルの　たたかいか……"
    },
    {
      "index": 5,
      "id": "msg_t010champ01_kanban_01",
      "hash": "aaa65d42a2c0489a",
      "flags": 0,
      "text": "ここは　セキエイこうげん\\c\\nポケモン　さいこう　きかん\\nポケモンリーグ　ほんぶ"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t010champ01_max",
