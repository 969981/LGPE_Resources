{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_town003_kanban_01",
      "hash": "2bbe41186cad3f48",
      "flags": 0,
      "text": "ここは　ニビシティ\\nニビは　はいいろ　いしの　いろ"
    },
    {
      "index": 1,
      "id": "msg_town003_kanban_02",
      "hash": "2bbe44186cad4461",
      "flags": 0,
      "text": "ニビ　かがくはくぶつかん"
    },
    {
      "index": 2,
      "id": "msg_town003_kanban_03",
      "hash": "2bbe43186cad42ae",
      "flags": 0,
      "text": "ニビシティ　ポケモンジム\\nリーダー　タケシ\\r\\nつよくて　かたい　いしの　おとこ"
    },
    {
      "index": 3,
      "id": "msg_town003_kanban_04",
      "hash": "2bbe46186cad47c7",
      "flags": 0,
      "text": "……おとくな　けいじばん！\\c\\nてもちの　ポケモンは\\nたたかわ　なくても\\r\\nけいけんちが　もらえる！\\c\\nしょうぶに　ちょっとだけ　でも\\nかおを　だせば\\r\\nおおめに　けいけんちが　もらえる！"
    },
    {
      "index": 4,
      "id": "msg_town003_kanban_05",
      "hash": "2bbe45186cad4614",
      "flags": 0,
      "text": "……チラシが　はって　ある！\\c\\nさいきん　オツキミやまで\\nきちょうな　ポケモンの\\r\\nカセキを　ぬすみ　まくる\\r\\nあくとうが　います！\\r\\nあやしい　ひとを　みたら……！\\r\\n……ニビ　けいさつ　まで"
    },
    {
      "index": 5,
      "id": "msg_town003_youngf_01",
      "hash": "90a189b82a33e733",
      "flags": 0,
      "text": "ピッピって　つきから　きたって\\nウワサ　しってる？\\c\\nオツキミやまに\\nつきのいしが　おちてから\\r\\nみかける　ように　なったの"
    },
    {
      "index": 6,
      "id": "msg_town003_youngm_01_01",
      "hash": "981eaa86b8cb8766",
      "flags": 0,
      "text": "ニビシティは\\nむしとりしょうねん　みたいに\\r\\nただの　しゅみで　ポケモン\\r\\nやってる　やつ　ばかり！\\c\\nしかし　ニビ　ポケモンジムの\\nタケシは　ちがうぜ"
    },
    {
      "index": 7,
      "id": "msg_town003_youngm_02_01",
      "hash": "f1536aa0001cadd9",
      "flags": 0,
      "text": "きみは　もう\\nはくぶつかん　けんがくした？"
    },
    {
      "index": 8,
      "id": "msg_town003_youngm_02_02",
      "hash": "f15367a0001ca8c0",
      "flags": 0,
      "text": "オツキミやまで　みつかった\\nカセキの　てんじ　すごかった！"
    },
    {
      "index": 9,
      "id": "msg_town003_youngm_02_03",
      "hash": "f15368a0001caa73",
      "flags": 0,
      "text": "え……！\\nそりゃ　ぜったい\\r\\nいった　ほうが　いい！"
    },
    {
      "index": 10,
      "id": "msg_town003_youngm_02_04",
      "hash": "f1536da0001cb2f2",
      "flags": 0,
      "text": "[~ 10]"
    },
    {
      "index": 11,
      "id": "msg_town003_clerkm_01",
      "hash": "52b2a5aed164d899",
      "flags": 0,
      "text": "シュー……！\\nぼくが\\r\\nなに　やってるか　わかる？"
    },
    {
      "index": 12,
      "id": "msg_town003_clerkm_02",
      "hash": "52b2a2aed164d380",
      "flags": 0,
      "text": "そう……　それ！\\nけっこう　ほねが　おれるよ"
    },
    {
      "index": 13,
      "id": "msg_town003_clerkm_03",
      "hash": "52b2a3aed164d533",
      "flags": 0,
      "text": "かだんに　やせいの　ポケモンが\\nはいらない　ように\\r\\nむしよけスプレー　まいてるのさ"
    },
    {
      "index": 14,
      "id": "msg_town003_clerkf_01",
      "hash": "1a53b55015e7308e",
      "flags": 0,
      "text": "シュー……！\\nわたしが\\r\\nなに　やってるか　わかる？"
    },
    {
      "index": 15,
      "id": "msg_town003_clerkf_02",
      "hash": "1a53b45015e72edb",
      "flags": 0,
      "text": "そう……　そうなの！\\nけっこう　ほねが　おれるわ"
    },
    {
      "index": 16,
      "id": "msg_town003_clerkf_03",
      "hash": "1a53b35015e72d28",
      "flags": 0,
      "text": "かだんに　やせいの　ポケモンが\\nきてくれる　ように\\r\\nむしよせコロン　まいてるのよ"
    },
    {
      "index": 17,
      "id": "msg_town003_poke_02",
      "hash": "811d3b41f5a144bb",
      "flags": 0,
      "text": "キャタピー『ぴた"
    },
    {
      "index": 18,
      "id": "msg_town003_childf_01",
      "hash": "575e6ce7733024fd",
      "flags": 0,
      "text": "わたしの　フリちゃん！\\c\\nいっしょに　あるいてると　たまに\\nどうぐ　みつけて　くれるの！"
    },
    {
      "index": 19,
      "id": "msg_town003_poke_01",
      "hash": "811d3c41f5a1466e",
      "flags": 0,
      "text": "フリちゃん『タリー"
    },
    {
      "index": 20,
      "id": "msg_town003_fat_01",
      "hash": "314115bad6fa6d26",
      "flags": 0,
      "text": "あー　すずしー\\c\\nニビシティは　いわやまの　ふもと\\nだから　ヒンヤリ　してるんだ"
    },
    {
      "index": 21,
      "id": "msg_town003_poke_03",
      "hash": "811d3a41f5a14308",
      "flags": 0,
      "text": "イシツブテ『ゴロゴロ……"
    },
    {
      "index": 22,
      "id": "msg_town003_middlef_01",
      "hash": "3c094088a2ecfe84",
      "flags": 0,
      "text": "おこづかいは\\nたいせつに　つかうのよ\\c\\nでも　ときどき\\nモンスターボールを　イッキがい\\r\\nするのも　たのしいわよ"
    },
    {
      "index": 23,
      "id": "msg_town003_childm_01",
      "hash": "c87a5c8d9fb0f192",
      "flags": 0,
      "text": "わあ……　いいなあ！\\nポケモンが　のっかってる！"
    },
    {
      "index": 24,
      "id": "msg_town003_shortpants_01",
      "hash": "7cb050fa1f22742d",
      "flags": 0,
      "text": "[~ 24]"
    },
    {
      "index": 25,
      "id": "msg_town003_shortpants_02",
      "hash": "7cb04dfa1f226f14",
      "flags": 0,
      "text": "[~ 25]"
    }
  ],
