  "lines": [
    {
      "index": 0,
      "id": "msg_town009_kanban_01",
      "hash": "fb2eb207c83c71be",
      "flags": 0,
      "text": "ここは　グレンタウン\\nグレンの　あかは　じょうねつの　いろ"
    },
    {
      "index": 1,
      "id": "msg_town009_kanban_02",
      "hash": "fb2eb107c83c700b",
      "flags": 0,
      "text": "ここは　グレン　ラボラトリー\\nポケモン　けんきゅう　しせつ"
    },
    {
      "index": 2,
      "id": "msg_town009_kanban_03",
      "hash": "fb2eb007c83c6e58",
      "flags": 0,
      "text": "グレンじま　ポケモンジム\\nリーダー　カツラ\\r\\nねっけつ　クイズおやじ"
    },
    {
      "index": 3,
      "id": "msg_town009_door_01",
      "hash": "7c8fc01f8569409f",
      "flags": 0,
      "text": "ドアに　ちいさな　もじで\\nなにか　かいてある……！\\c\\n「もんだい！　この　ジムの\\n　カギは　どこに　あるでしょう？\\c\\n　ヒント！　くさが　からみついた\\n　たてものの　どこかに……？」"
    },
    {
      "index": 4,
      "id": "msg_town009_youngf_01_01",
      "hash": "a8d70bfaf363b6cd",
      "flags": 0,
      "text": "グレンジムの　カツラは\\nラボが　できる　まえから\\r\\nすんでて　へんじん　なんだって"
    },
    {
      "index": 5,
      "id": "msg_town009_oldm_01_01",
      "hash": "8b31d9faa53907bb",
      "flags": 0,
      "text": "ポケモンやしきは\\nけんきゅうの　ため　かがくしゃが\\r\\nたまに　でいり　しとる　ようだ"
    },
    {
      "index": 6,
      "id": "msg_town009_poke_01",
      "hash": "e5ebf5a8a6bca1dc",
      "flags": 0,
      "text": "ブーバー『ぶっふふーぃ！"
    },
    {
      "index": 7,
      "id": "msg_town009_poke_02",
      "hash": "e5ebf8a8a6bca6f5",
      "flags": 0,
      "text": "ヒトデマン『シュルー"
    },
