{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main2010_system_01",
      "hash": "79db968c6abc4acb",
      "flags": 0,
      "text": "チャンピオンに　なって\\nじぶんの　せかいが　ひろがった……！"
    },
    {
      "index": 1,
      "id": "msg_main2010_system_02",
      "hash": "79db978c6abc4c7e",
      "flags": 0,
      "text": "どこ　でも\\n[VAR COLOR(0006)]リザードン　プテラ　カイリュー[VAR COLOR(0000)]と\\r\\nそら　たかく　とべるように　なった！"
    },
    {
      "index": 2,
      "id": "msg_main2010_shortpants_01",
      "hash": "3809042d727f52d8",
      "flags": 0,
      "text": "せかいが　ひろがってる　とこ\\nちょっと　いいかな！？"
    },
    {
      "index": 3,
      "id": "msg_main2010_shortpants_02",
      "hash": "3809072d727f57f1",
      "flags": 0,
      "text": "ぼくの　こと　おぼえてる？\\n１ばんどうろの　タイチさ！"
    },
    {
      "index": 4,
      "id": "msg_main2010_shortpants_03",
      "hash": "3809062d727f563e",
      "flags": 0,
      "text": "めでたく　チャンピオンに　なった\\nきみに　おしらせが　あるんだ"
    },
    {
      "index": 5,
      "id": "msg_main2010_shortpants_04",
      "hash": "3809092d727f5b57",
      "flags": 0,
      "text": "ひとつの　ポケモンを\\nきわめた　そんざい……\\c\\n[VAR COLOR(0006)]マスタートレーナーズ[VAR COLOR(0000)]が\\nカントーかくちに　あらわれたよ"
    },
    {
      "index": 6,
      "id": "msg_main2010_shortpants_11",
      "hash": "3806002d727d1635",
      "flags": 0,
      "text": "まずは　ピカチュウマスターに\\nちょうせん　するのが　オススメ！\\r\\nヤツなら　トキワのもりに　いるぜ！"
    },
    {
      "index": 7,
      "id": "msg_main2010_shortpants_12",
      "hash": "3805fd2d727d111c",
      "flags": 0,
      "text": "まずは　イーブイマスターに\\nちょうせん　するのが　オススメ！\\r\\nヤツなら　ポケモンロードに　いるぜ！"
    },
    {
      "index": 8,
      "id": "msg_main2010_shortpants_05",
      "hash": "3809082d727f59a4",
      "flags": 0,
      "text": "くわしい　こと　ききたい　なら\\nまた　ぼくに　はなしかけてね"
    },
    {
      "index": 9,
      "id": "msg_main2010_shortpants_06",
      "hash": "38090b2d727f5ebd",
      "flags": 0,
      "text": "マスタートレーナーズに　ついて\\nどんなことが　しりたい？"
    },
    {
      "index": 10,
      "id": "msg_main2010_select_01",
      "hash": "40ba21cc7b2222c8",
      "flags": 0,
      "text": "どんな　ひとたち？"
    },
    {
      "index": 11,
      "id": "msg_main2010_select_02",
      "hash": "40ba24cc7b2227e1",
      "flags": 0,
      "text": "たたかう　には？"
    },
    {
      "index": 12,
      "id": "msg_main2010_select_03",
      "hash": "40ba23cc7b22262e",
      "flags": 0,
      "text": "とおりな　に　ついて"
    },
    {
      "index": 13,
      "id": "msg_main2010_select_04",
      "hash": "40ba26cc7b222b47",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 14,
      "id": "msg_main2010_shortpants_07",
      "hash": "38090a2d727f5d0a",
      "flags": 0,
      "text": "マスタートレーナーズは\\nひとつの　ポケモンを　きわめた\\r\\nトレーナーたち　だよ\\c\\nきわめた　ポケモンの　ことを\\nいつも　かんがえてる　から\\r\\nみかけたら　すぐ　わかるはずさ！"
    },
    {
      "index": 15,
      "id": "msg_main2010_shortpants_08",
      "hash": "3808fd2d727f46f3",
      "flags": 0,
      "text": "かれらが　きわめた　ポケモンと\\nおなじ　ポケモンを　もってれば\\r\\n１たい１　で　たたかえるよ\\c\\nおたがい　どうぐを　つかえない\\nじつりょく　のみ　の　しょうぶ！\\c\\nかてば　とおりなが　もらえて\\nきみも　なのる　ことが　できるよ！"
    },
    {
      "index": 16,
      "id": "msg_main2010_shortpants_09",
      "hash": "3808fc2d727f4540",
      "flags": 0,
      "text": "てにいれた　とおりな　は\\nタマムシシティの　ゲームがいしゃで\\r\\nきりかえる　ことが　できる！\\c\\nつうしんたいせんで\\nあいてに　さを　つけちゃおう！"
    },
    {
      "index": 17,
      "id": "msg_main2010_shortpants_10",
      "hash": "3805ff2d727d1482",
      "flags": 0,
      "text": "がんばってね！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_2010_max",
      "hash": "4f6ff97a5ec1a284"
    }
  ]
}
