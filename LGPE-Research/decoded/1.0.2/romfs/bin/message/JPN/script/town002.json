{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_town002_kanban_01",
      "hash": "7637aec9d1a1b94f",
      "flags": 0,
      "text": "ここは　トキワシティ\\nトキワは　みどり　えいえんのいろ"
    },
    {
      "index": 1,
      "id": "msg_town002_kanban_02",
      "hash": "7637afc9d1a1bb02",
      "flags": 0,
      "text": "トキワ　ポケモンジム"
    },
    {
      "index": 2,
      "id": "msg_town002_door_01",
      "hash": "b7246880b3c9c456",
      "flags": 0,
      "text": "トキワジムの　ドアには\\nカギが　かかって　いた……！"
    },
    {
      "index": 3,
      "id": "msg_town002_kanban_03",
      "hash": "7637b0c9d1a1bcb5",
      "flags": 0,
      "text": "[~ 3]"
    },
    {
      "index": 4,
      "id": "msg_town002_kanban_04",
      "hash": "7637a9c9d1a1b0d0",
      "flags": 0,
      "text": "……おとくな　けいじばん！\\c\\nモンスターボールが　なくなったら\\nフレンドリィショップで　かおう！"
    },
    {
      "index": 5,
      "id": "msg_town002_kanban_05",
      "hash": "7637aac9d1a1b283",
      "flags": 0,
      "text": "ここは　トレーナーズスクール\\nまなびや　で　まなべや！"
    },
    {
      "index": 6,
      "id": "msg_town002_childm_01_01",
      "hash": "514de6fb5176410d",
      "flags": 0,
      "text": "きみが　つれて　いるのは……！\\nまさしく　ポケモンだね！\\c\\nすきな　ポケモンと\\nいっしょに　あるける　なんて\\r\\nすてきな　よのなかだね"
    },
    {
      "index": 7,
      "id": "msg_town002_oldm_01_01",
      "hash": "75c5dea9e5248190",
      "flags": 0,
      "text": "いつ　きても\\nこの　ポケモンジムは　しまっとる\\c\\nいったい　どんな　ヤツが\\nリーダーを　しとるんじゃろか？"
    },
    {
      "index": 8,
      "id": "msg_town002_oldm_01_02",
      "hash": "75c5e1a9e52486a9",
      "flags": 0,
      "text": "トキワジムの　リーダーが\\nかえって　きたぞ！"
    },
    {
      "index": 9,
      "id": "msg_town002_bugcatcher_01_01",
      "hash": "064dd86c3fe6a1d6",
      "flags": 0,
      "text": "いもむしポケモンには\\n２しゅるい　いるって　しらない？"
    },
    {
      "index": 10,
      "id": "msg_town002_bugcatcher_01_02",
      "hash": "064dd76c3fe6a023",
      "flags": 0,
      "text": "それなら　いいんだ！"
    },
    {
      "index": 11,
      "id": "msg_town002_bugcatcher_01_03",
      "hash": "064dd66c3fe69e70",
      "flags": 0,
      "text": "キャタピーは　どくが　ないけど\\nビードルには　どくが　あるよ\\c\\nポケモンが　さされないように\\nきを　つけようね"
    },
    {
      "index": 12,
      "id": "msg_town002_jevenile_f_01",
      "hash": "52931ec5d1be27bf",
      "flags": 0,
      "text": "[~ 12]"
    },
    {
      "index": 13,
      "id": "msg_town002_poke_01",
      "hash": "1102f61156ce1dad",
      "flags": 0,
      "text": "ナゾノクサ『つれぃ！"
    },
    {
      "index": 14,
      "id": "msg_town002_middlem_01",
      "hash": "01f9b8b8687961de",
      "flags": 0,
      "text": "よう　こんちは　マサラっこ！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_town002_max",
      "hash": "10b6dd555c3b853a"
    }
  ]
}
