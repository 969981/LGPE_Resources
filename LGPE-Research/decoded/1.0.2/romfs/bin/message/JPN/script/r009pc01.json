{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_r009pc01_gentleman_01",
      "hash": "582c787900d9dfda",
      "flags": 0,
      "text": "ポケモンは　タイプに　よって\\nゆうりに　たたかえる　あいてと\\r\\nにがてな　あいてが　いるのだ"
    },
    {
      "index": 1,
      "id": "msg_r009pc01_fat_01",
      "hash": "7e6564dde175f462",
      "flags": 0,
      "text": "つかいみち　ないから　きんのたまを\\nうったら　５０００円で　うれた！"
    },
    {
      "index": 2,
      "id": "msg_r009pc01_childm_01",
      "hash": "ec880381b106270e",
      "flags": 0,
      "text": "シオンタウンで\\nゆうれいが　でるって\\r\\nみんな　さわいでるよ"
    },
    {
      "index": 3,
      "id": "msg_r009pc01_elitef_01",
      "hash": "a3ee6c8328c006ec",
      "flags": 0,
      "text": "わたしは　エリートトレーナー！\\c\\nふつうの　トレーナー　より\\nかなり　てごわいの！\\c\\nわたしたちを　みかけたら\\nかくごして　たたかう　のね！"
    },
    {
      "index": 4,
      "id": "msg_r009pc01_book_01",
      "hash": "057a0acf832ac39e",
      "flags": 0,
      "text": "『げっかんマユツバ』\\nと　かかれた　ざっしが　ある……"
    },
    {
      "index": 5,
      "id": "msg_r009pc01_select_01",
      "hash": "351badf47f4eca4d",
      "flags": 0,
      "text": "よみますか？"
    },
    {
      "index": 6,
      "id": "msg_r009pc01_book_02",
      "hash": "057a09cf832ac1eb",
      "flags": 0,
      "text": "ペンネーム\\nとくめいきぼう　さん　より\\c\\n『わたしが　ポケモンタワーに\\nいった　ときの　こと　です\\c\\nおはかまいりを　おえて\\nいざ　かえろうと　すると\\c\\nえたいの　しれない\\nくろい　ものが　おいかけて　きて……\\c\\nひっしに　にげたんです　けど\\nおいつかれて　わたし……\\c\\nきづいたら　いりぐちで\\nたおれてたんです\\c\\nアレは　いったい\\nなんだったの　かしら……？"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_r009pc01_max",
      "hash": "10713a3027e4893d"
    }
  ]
}
