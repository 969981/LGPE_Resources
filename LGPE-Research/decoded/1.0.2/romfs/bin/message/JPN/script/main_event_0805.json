{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0805_poke_01_01",
      "hash": "67195e63266b521b",
      "flags": 0,
      "text": "ゆうれい『……タチサレ"
    },
    {
      "index": 1,
      "id": "msg_main0805_poke_01_02",
      "hash": "67195f63266b53ce",
      "flags": 0,
      "text": "ココカラ……　タチサレ……！"
    },
    {
      "index": 2,
      "id": "msg_main0805_rival_01",
      "hash": "1fb7dc95783b3aa0",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『げッ！\\nひときわ　でかいのが　まだ……！"
    },
    {
      "index": 3,
      "id": "msg_main0805_rival_10",
      "hash": "1fb477957838592a",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]　アレ！\\nさっきの　アレ　やって！"
    },
    {
      "index": 4,
      "id": "msg_main0805_sys_01",
      "hash": "98a1dd67f92a9f67",
      "flags": 0,
      "text": "ゆうれいの　しょうたいは……\\c\\nカラカラの　おかあさんの\\nまよえる　たましい　だった！"
    },
    {
      "index": 5,
      "id": "msg_main0805_sys_02",
      "hash": "98a1de67f92aa11a",
      "flags": 0,
      "text": "やさしい　カラカラの　おかあさんに\\nもどった　たましいは\\c\\nぶじ　てんに　のぼって……\\n……きえて　いきました"
    },
    {
      "index": 6,
      "id": "msg_main0805_rival_02",
      "hash": "1fb7df95783b3fb9",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『……カラカラ　おまえ\\nおかあさんに　あいたくて\\r\\nここに　きてたん　だな……"
    },
    {
      "index": 7,
      "id": "msg_main0805_poke_02_01",
      "hash": "123c266d35d38b24",
      "flags": 0,
      "text": "カラカラ『きゃう……"
    },
    {
      "index": 8,
      "id": "msg_main0805_rival_03",
      "hash": "1fb7de95783b3e06",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『おかあさんの　こと\\nこわがったり　して　ごめんな"
    },
    {
      "index": 9,
      "id": "msg_main0805_rival_04",
      "hash": "1fb7e195783b431f",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]　オレ……\\nカラカラを　ひとりに　したくないから\\r\\nいえ　まで　おくる\\c\\nそうだ！　うえの　かいに\\nフジって　ひとが　いたら\\r\\nつれて　かえって　くれるか？"
    },
    {
      "index": 10,
      "id": "msg_main0805_select_01",
      "hash": "db48292ea2290a98",
      "flags": 0,
      "text": "ひとりで　かえれる？"
    },
    {
      "index": 11,
      "id": "msg_main0805_select_02",
      "hash": "db482c2ea2290fb1",
      "flags": 0,
      "text": "まかせてよ！"
    },
    {
      "index": 12,
      "id": "msg_main0805_rival_05",
      "hash": "1fb7e095783b416c",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『へ　へいきだよ！\\nカラカラと　いっしょ　だし\\c\\n……[VAR TRNAME(0000)]\\nなんか　たのもしく　なったなあ"
    },
    {
      "index": 13,
      "id": "msg_main0805_rival_06",
      "hash": "1fb7e395783b4685",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『[VAR TRNAME(0000)]\\nぜんぜん　こわく　ないんだ？\\c\\nなんか　じしん　たっぷりで\\nたのもしい　よなあ"
    },
    {
      "index": 14,
      "id": "msg_main0805_rival_07",
      "hash": "1fb7e295783b44d2",
      "flags": 0,
      "text": "え！？　ロケットだん　から\\nカラカラを　たすけた！？"
    },
    {
      "index": 15,
      "id": "msg_main0805_rival_11",
      "hash": "1fb4789578385add",
      "flags": 0,
      "text": "いつの　まに\\nそんなに　つよく　なったんだよ……"
    },
    {
      "index": 16,
      "id": "msg_main0805_rival_08",
      "hash": "1fb7e595783b49eb",
      "flags": 0,
      "text": "……いや　それなら\\n[VAR TRNAME(0000)]に　まかせるよ！"
    },
    {
      "index": 17,
      "id": "msg_main0805_rival_09",
      "hash": "1fb7e495783b4838",
      "flags": 0,
      "text": "よし　いこう　カラカラ！"
    },
    {
      "index": 18,
      "id": "msg_main0805_poke_02_02",
      "hash": "123c296d35d3903d",
      "flags": 0,
      "text": "カラカラ『きゃうっ！"
    }
  ],
