  "lines": [
    {
      "index": 0,
      "id": "msg_sub043_middle_01",
      "hash": "636a64446d37698e",
      "flags": 0,
      "text": "おひとりさま\\nいちにち　ひとつ　げんてい！\\c\\nニビシティ　めいぶつ！\\nニビあられ　５００円だよ！"
    },
    {
      "index": 1,
      "id": "msg_sub043_select_01",
      "hash": "c08b22c858810d85",
      "flags": 0,
      "text": "ほしいです"
    },
    {
      "index": 2,
      "id": "msg_sub043_select_02",
      "hash": "c08b1fc85881086c",
      "flags": 0,
      "text": "いりません"
    },
    {
      "index": 3,
      "id": "msg_sub043_middle_02",
      "hash": "636a63446d3767db",
      "flags": 0,
      "text": "まいどあり！\\c\\nものすごーく　かたい　から\\nきを　つけて　たべてね！"
    },
    {
      "index": 4,
      "id": "msg_sub043_system_01",
      "hash": "b51a3afa6e71ae92",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　おじさんから\\nニビあられを　もらった！"
    },
    {
      "index": 5,
      "id": "msg_sub043_middle_03",
      "hash": "636a62446d376628",
      "flags": 0,
      "text": "うーん！　ざんねん！\\nまた　の　きかいに　ぜひ！"
    },
    {
      "index": 6,
      "id": "msg_sub043_middle_04",
      "hash": "636a69446d37720d",
      "flags": 0,
      "text": "ありゃ　おかねが　たりないよ！\\nまた　きてね！"
    },
    {
      "index": 7,
      "id": "msg_sub043_middle_05",
      "hash": "636a68446d37705a",
      "flags": 0,
      "text": "もう　ニビあられ　もてないよ！？\\nなんで　そんなに　もってるの！？\\c\\n……ちゃんと　たべて！？"
    },
    {
      "index": 8,
      "id": "msg_sub043_middle_06",
      "hash": "636a67446d376ea7",
      "flags": 0,
      "text": "いちにち　ひとつ　げんてい　だよ！\\nまた　あした　かいに　きてね！"
    }
  ],
