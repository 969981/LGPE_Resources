{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0610_guard_01",
      "hash": "acbacb1c0639952b",
      "flags": 0,
      "text": "わたし　まじめな　けいびいん\\nはー……　のどが　かわいた！\\r\\n[VAR COLOR(0006)]おちゃ[VAR COLOR(0000)]　が　のみたいなぁ"
    },
    {
      "index": 1,
      "id": "msg_main0610_guard_05",
      "hash": "acbacf1c06399bf7",
      "flags": 0,
      "text": "おっと　そっちは\\nいま　つうこう　きんしだよ"
    },
    {
      "index": 2,
      "id": "msg_main0610_guard_02",
      "hash": "acbacc1c063996de",
      "flags": 0,
      "text": "あ　それは\\nおいしそうな　おちゃ……"
    },
    {
      "index": 3,
      "id": "msg_main0610_guard_03",
      "hash": "acbacd1c06399891",
      "flags": 0,
      "text": "え？　ぼくに　くれる？\\n…………サンキュー！"
    },
    {
      "index": 4,
      "id": "msg_main0610_guard_06",
      "hash": "acbad01c06399daa",
      "flags": 0,
      "text": "ゴクゴク……\\nゴクゴク……\\c\\nヤマブキシティに　ゴクゴク……\\nいく　なら　ゴクゴク……\\r\\nとおって　いいよ……"
    },
    {
      "index": 5,
      "id": "msg_main0610_guard_07",
      "hash": "acbad11c06399f5d",
      "flags": 0,
      "text": "むこうの　ゲートの　けいびいんにも\\nおちゃ　おすそわけ　してくるよ"
    },
    {
      "index": 6,
      "id": "msg_main0610_guard_04",
      "hash": "acbace1c06399a44",
      "flags": 0,
      "text": "あ……\\nこの　あいだは　どーも！"
    },
    {
      "index": 7,
      "id": "msg_main0610_middlef_01",
      "hash": "57fbeefe05e4976b",
      "flags": 0,
      "text": "けいびいん　さんに\\nニビあられを\\r\\nさしいれ　しすぎ　ちゃったわ\\c\\nやっぱり　おちゃが　ないと\\nたべにくかった　かしらね"
    },
    {
      "index": 8,
      "id": "msg_main0610_middlef_02",
      "hash": "57fbeffe05e4991e",
      "flags": 0,
      "text": "やっぱり　ニビあられには\\nあつい　おちゃ　よねえ！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0610_max",
      "hash": "69281b43b007f0a4"
    }
  ]
}
