{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t002r0101_juveniles_01_01",
      "hash": "d6c2ca6b127c5915",
      "flags": 0,
      "text": "ふー\\nノートの　なかの　こと\\r\\nわたし　ぜんぶ　おぼえるの"
    },
    {
      "index": 1,
      "id": "msg_t002r0101_adultf_01_01",
      "hash": "01ab83dcfae78f64",
      "flags": 0,
      "text": "はい　みなさん！\\c\\nトレーナーの　やくに　たつ\\nじょうほうが　よめるのは？\\c\\n……そう！　この　きょうしつでは\\nこくばんや　ほん　ですね！\\c\\nまちや　みちの　けいじばんも\\nよんで　おきましょうね！"
    },
    {
      "index": 2,
      "id": "msg_t002r0101_childf_01_01",
      "hash": "a4c38ea539edef66",
      "flags": 0,
      "text": "ポケモンって　たたかわせたり\\nいっしょに　あるいたり　してると\\c\\nトレーナーの　こと　だいすきに\\nなって　くれるんだって"
    },
    {
      "index": 3,
      "id": "msg_t002r0101_childm_01_01",
      "hash": "2c279575b469d9b7",
      "flags": 0,
      "text": "ポケモンの　タイプに　ついて\\nべんきょう　してるのだ"
    },
    {
      "index": 4,
      "id": "msg_t002r0101_childm_01_02",
      "hash": "2c279675b469db6a",
      "flags": 0,
      "text": "ピカチュウの　でんきタイプは……\\c\\nみずタイプや\\nひこうタイプに　つよいん　だって！"
    },
    {
      "index": 5,
      "id": "msg_t002r0101_childm_01_03",
      "hash": "2c279775b469dd1d",
      "flags": 0,
      "text": "イーブイの　ノーマルタイプは……\\c\\nあまり　じゃくてんが　ない　けど\\nかくとうタイプには　よわい　って！"
    },
    {
      "index": 6,
      "id": "msg_t002r0101_note_01_01",
      "hash": "6c950f937187182a",
      "flags": 0,
      "text": "ノートを　のぞいた！\\c\\n１ページめ……\\c\\nポケモンは\\nモンスターボールで　つかまえて\\r\\nもち　あるける\\c\\nポケモンを　そだてて　たたかわせる\\nひとを　ポケモントレーナーという"
    },
    {
      "index": 7,
      "id": "msg_t002r0101_note_01_02",
      "hash": "6c950e9371871677",
      "flags": 0,
      "text": "２ページめ……\\c\\nポケモンを　つかまえる　ときは\\nしろい　わっかの　なかを\\r\\nめがけて　ボールを　なげよう！\\c\\nポケモンが　うごいて　いると\\nうまく　とれないかも"
    },
    {
      "index": 8,
      "id": "msg_t002r0101_note_01_03",
      "hash": "6c950d93718714c4",
      "flags": 0,
      "text": "３ページめ……\\c\\nポケモンどうしを　たたかわせ\\nかつことは　トレーナーに　とって\\r\\nさいこうの　よろこび　である！\\c\\nかくちの　ポケモンジムでは\\nいつも　はげしい\\r\\nたたかいが　くりひろげられてる！"
    },
    {
      "index": 9,
      "id": "msg_t002r0101_note_01_04",
      "hash": "6c950c9371871311",
      "flags": 0,
      "text": "４ページめ……\\c\\nポケモントレーナーの　もくひょうは\\nかくちの　ジムに　いる\\c\\nつよい　トレーナー\\n８にんしゅうを　たおすこと！\\c\\nさらに　ポケモンリーグ　ほんぶには\\n……もうれつに　つよい！\\c\\nしてんのうが　くんりん　してる！"
    },
    {
      "index": 10,
      "id": "msg_t002r0101_note_01_05",
      "hash": "6c950b937187115e",
      "flags": 0,
      "text": "つぎのページ　あけちゃおうか？"
    },
    {
      "index": 11,
      "id": "msg_t002r0101_juveniles_01_02",
      "hash": "d6c2c76b127c53fc",
      "flags": 0,
      "text": "おんなのこ『あー！\\nノート　みちゃ　だめ！"
    },
    {
      "index": 12,
      "id": "msg_t002r0101_board_01_01",
      "hash": "e120602d2b9b0a7e",
      "flags": 0,
      "text": "こくばんに\\nポケモンが　たたかってる　とき\\r\\nおこる　じょうたいの\\r\\nへんかに　ついて　かかれてる"
    },
    {
      "index": 13,
      "id": "msg_t002r0101_board_01_02",
      "hash": "e1205f2d2b9b08cb",
      "flags": 0,
      "text": "どの　こうもくを　みますか？"
    },
    {
      "index": 14,
      "id": "msg_t002r0101_select_01_01",
      "hash": "2295593a926da2f6",
      "flags": 0,
      "text": "ねむり"
    },
    {
      "index": 15,
      "id": "msg_t002r0101_select_01_02",
      "hash": "2295583a926da143",
      "flags": 0,
      "text": "やけど"
    },
    {
      "index": 16,
      "id": "msg_t002r0101_select_01_03",
      "hash": "2295573a926d9f90",
      "flags": 0,
      "text": "どく"
    },
    {
      "index": 17,
      "id": "msg_t002r0101_select_01_04",
      "hash": "22955e3a926dab75",
      "flags": 0,
      "text": "こおり"
    },
    {
      "index": 18,
      "id": "msg_t002r0101_select_01_05",
      "hash": "22955d3a926da9c2",
      "flags": 0,
      "text": "まひ"
    },
    {
      "index": 19,
      "id": "msg_t002r0101_select_01_06",
      "hash": "22955c3a926da80f",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 20,
      "id": "msg_t002r0101_board_01_03",
      "hash": "e1205e2d2b9b0718",
      "flags": 0,
      "text": "ねてしまうと　その　あいだは\\nこうげき　できません！\\c\\nたたかい　おわっても　ねたまま\\nねむけざましで　めが　さめます"
    },
    {
      "index": 21,
      "id": "msg_t002r0101_board_01_04",
      "hash": "e120652d2b9b12fd",
      "flags": 0,
      "text": "やけどは　たいりょくが　へって\\nこうげきりょくが\\r\\nさがって　しまいます！\\c\\nたたかい　おわっても\\nやけどは　のこります\\r\\nまた　やけどなおしで　なおります"
    },
    {
      "index": 22,
      "id": "msg_t002r0101_board_01_05",
      "hash": "e120642d2b9b114a",
      "flags": 0,
      "text": "どくを　くらうと\\nたいりょくが　へって　いきます\\c\\nたたかい　おわっても\\nどくは　のこりますが\\r\\nどくけしで　きえます！"
    },
    {
      "index": 23,
      "id": "msg_t002r0101_board_01_06",
      "hash": "e120632d2b9b0f97",
      "flags": 0,
      "text": "こおって　しまうと\\nまったく　うごけなく　なります！\\c\\nたたかい　おわっても　こおってます\\nこおりなおしで　とかさないと\\r\\nポケモンが　かわいそう"
    },
    {
      "index": 24,
      "id": "msg_t002r0101_board_01_07",
      "hash": "e120622d2b9b0de4",
      "flags": 0,
      "text": "まひすると　わざが\\nときどき　でなく　なり\\r\\nすばやさも　さがって　しまいます！\\c\\nたたかい　おわっても\\nまひは　のこります\\r\\nまた　まひなおしで　なおります"
    },
    {
      "index": 25,
      "id": "msg_t002r0101_book_01",
      "hash": "d60e248c05d6da7b",
      "flags": 0,
      "text": "メモが　かかれてる！\\c\\n『[VAR COLOR(0006)]すばやさ[VAR COLOR(0000)]が　たかい　ポケモンが\\nさきに　うごける！』"
    },
    {
      "index": 26,
      "id": "msg_t002r0101_book_02",
      "hash": "d60e258c05d6dc2e",
      "flags": 0,
      "text": "メモが　かかれてる！\\c\\n『ぶつり　わざは　[VAR COLOR(0006)]こうげき[VAR COLOR(0000)]！\\nとくしゅ　わざは　[VAR COLOR(0006)]とくこう[VAR COLOR(0000)]！\\c\\nすうちが　たかい　ほど\\nいりょくが　あがるぞ』"
    },
    {
      "index": 27,
      "id": "msg_t002r0101_book_03",
      "hash": "d60e268c05d6dde1",
      "flags": 0,
      "text": "ポケモンには　たいりょくの　ほか\\nわざを　くりだす　げんきの　もと\\r\\nパワーポイント……　ＰＰが　ある\\c\\nＰＰが　へったら\\nポケモンセンターで　やすませよう！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t002r0101_max",
      "hash": "edeeb16221abef84"
    }
  ]
}
