  "lines": [
    {
      "index": 0,
      "id": "msg_t006r0201_shortpants_01",
      "hash": "4551df01c18d9d31",
      "flags": 0,
      "text": "わっかが　ちいさい　ときに\\nちゅうしん　ねらう　べし……\\c\\nモンスターボール\\nなげる　コツ　なんだって！"
    },
    {
      "index": 1,
      "id": "msg_t006r0201_miniskirt_01",
      "hash": "7d01caae73653c4d",
      "flags": 0,
      "text": "わっかの　いろが　みどり　だと\\nポケモン　つかまえやすい　よね？\\c\\nきいろは　ちょっと　つかまえにくくて\\nあか　だと　チョー　むずい　カンジ！"
    },
    {
      "index": 2,
      "id": "msg_t006r0201_miniskirt_02",
      "hash": "7d01c7ae73653734",
      "flags": 0,
      "text": "やせいの　ポケモンに\\nナナのみ　たべさせたら\\r\\nおとなしく　なっちゃった！\\c\\nうごかない　から\\nボール　あてまくり　だったの！"
    },
    {
      "index": 3,
      "id": "msg_t006r0201_miniskirt_03",
      "hash": "7d01c8ae736538e7",
      "flags": 0,
      "text": "モンスターボール　より\\nスーパーボールの　ほうが\\r\\nポケモン　つかまえ　やすいよ\\c\\nそれでも　かくじつに\\nつかまる　わけじゃ　ないけどね"
    }
  ],
