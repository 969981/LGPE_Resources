{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0055_doctor_01",
      "hash": "fb78b3614c0b64b8",
      "flags": 0,
      "text": "オーキド『おーい！\\nちょっと　まってくれい！"
    },
    {
      "index": 1,
      "id": "msg_main0055_doctor_02",
      "hash": "fb78b6614c0b69d1",
      "flags": 0,
      "text": "トレーナーに　なった　おまえたちに\\nひとつ　たのみが　あるんじゃ！\\c\\nこいつを　もって　いってくれ！"
    },
    {
      "index": 2,
      "id": "msg_main0055_rival_01",
      "hash": "aa237b074d6e99c3",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『はかせ！\\nなんですか　ソレ？"
    },
    {
      "index": 3,
      "id": "msg_main0055_doctor_03",
      "hash": "fb78b5614c0b681e",
      "flags": 0,
      "text": "わしが　せっけい　した\\nポケモンずかん　じゃ！\\c\\nみつけた　ポケモンの　データが\\nじどうてきに　かきこまれて\\r\\nページが　ふえて　いく　という\\r\\nたいへん　ハイテクな\\r\\nどうぐ　なのじゃ！"
    },
    {
      "index": 4,
      "id": "msg_main0055_doctor_04",
      "hash": "fb78b8614c0b6d37",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]　[VAR TRNAME(0001)]！\\nこれを　おまえたちに　あずける！"
    },
    {
      "index": 5,
      "id": "msg_main0055_sys_01",
      "hash": "c36468d85d2c4674",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　オーキドから\\n[VAR COLOR(0006)]ポケモンずかん[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 6,
      "id": "msg_main0055_doctor_05",
      "hash": "fb78b7614c0b6b84",
      "flags": 0,
      "text": "オーキド『ポケモンを\\nただ　みつけただけ　では\\r\\nくわしい　データを\\r\\nてに　いれる　ことは　できん！\\c\\nかならず\\nつかまえなければ　ならんのだ！"
    },
    {
      "index": 7,
      "id": "msg_main0055_doctor_06",
      "hash": "fb78ba614c0b709d",
      "flags": 0,
      "text": "この　せかい　すべての\\nポケモンを　きろくした\\r\\nかんぺきな　ずかんを　つくること！\\c\\nそれが　わしの　ゆめ　だった！"
    },
    {
      "index": 8,
      "id": "msg_main0055_doctor_09",
      "hash": "fb78ab614c0b5720",
      "flags": 0,
      "text": "しかし　わしも　もう　ジジイ！\\nそこまで　ムリは　できん！"
    },
    {
      "index": 9,
      "id": "msg_main0055_doctor_10",
      "hash": "fb752e614c084ce2",
      "flags": 0,
      "text": "そこで　おまえ　たちには\\nわしの　かわりに\\r\\nゆめを　はたして　ほしいのじゃ！"
    },
    {
      "index": 10,
      "id": "msg_main0055_doctor_07",
      "hash": "fb78b9614c0b6eea",
      "flags": 0,
      "text": "さあ　ふたりとも\\nさっそく　しゅっぱつ　してくれい！\\c\\nこれは　ポケモンの　れきしに　のこる\\nいだいな　しごとじゃー！"
    },
    {
      "index": 11,
      "id": "msg_main0055_rival_02",
      "hash": "aa237c074d6e9b76",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『ポケモンずかん　かあ！\\c\\nこれから　たくさんの\\nポケモンと　であえるんだ……\\r\\nたのしみ　だなあ！"
    },
    {
      "index": 12,
      "id": "msg_main0055_rival_03",
      "hash": "aa237d074d6e9d29",
      "flags": 0,
      "text": "オレ　すぐ　いきます！\\n[VAR TRNAME(0000)]も　じぶんの　ペースで\\r\\nあせらず　こいよ！"
    },
    {
      "index": 13,
      "id": "msg_main0055_doctor_08",
      "hash": "fb78ac614c0b58d3",
      "flags": 0,
      "text": "せかい　じゅうに　すんでいる\\nポケモンたちが\\r\\n[VAR TRNAME(0000)]を　まって　おるぞー！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0055_max",
      "hash": "b54f894b19c7c6c1"
    }
  ]
}
