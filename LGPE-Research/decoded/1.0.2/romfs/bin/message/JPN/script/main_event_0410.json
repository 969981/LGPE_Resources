  "lines": [
    {
      "index": 0,
      "id": "msg_main0410_rival_01",
      "hash": "f39570eca3c31d1a",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『きたきた　[VAR TRNAME(0000)]！"
    },
    {
      "index": 1,
      "id": "msg_main0410_rival_02",
      "hash": "f3956feca3c31b67",
      "flags": 0,
      "text": "チケット　ありがとな！\\nふねの　なか　ひろくて\\r\\nトレーナーも　いっぱいで……"
    },
    {
      "index": 2,
      "id": "msg_main0410_green_01",
      "hash": "1b1bfc19f9bb010b",
      "flags": 0,
      "text": "グリーン『ボン　ジュール！\\n[VAR TRNAME(0000)]に　[VAR TRNAME(0001)]！\\r\\nこんな　ところで　あうとはな！"
    },
    {
      "index": 3,
      "id": "msg_main0410_rival_03",
      "hash": "f3956eeca3c319b4",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『グリーンさん！"
    },
    {
      "index": 4,
      "id": "msg_main0410_rival_04",
      "hash": "f3956deca3c31801",
      "flags": 0,
      "text": "ふなたび　ですか？"
    },
    {
      "index": 5,
      "id": "msg_main0410_green_02",
      "hash": "1b1bfd19f9bb02be",
      "flags": 0,
      "text": "グリーン『いや　いや\\c\\nおれは　せんじょう　パーティに\\nしょうたい　されててさ\\r\\nでも　もう　かえる　とこ！\\c\\nおみやげも　いっぱい　でさあ！\\nよかったら　ひとつ　やるぜ"
    },
    {
      "index": 6,
      "id": "msg_main0410_system_01",
      "hash": "e66cedb289b19491",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　グリーンから\\n[VAR COLOR(0006)]シャラサブレ[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 7,
      "id": "msg_main0410_green_03",
      "hash": "1b1bfe19f9bb0471",
      "flags": 0,
      "text": "グリーン『それより……\\nパーティで　きいた　はなし　だが\\c\\nおまえら　ロケットだん　って\\nしってるか？"
    },
    {
      "index": 8,
      "id": "msg_main0410_select_01",
      "hash": "df9b2d484fb661a6",
      "flags": 0,
      "text": "わるい　やつらです！"
    },
    {
      "index": 9,
      "id": "msg_main0410_select_02",
      "hash": "df9b2c484fb65ff3",
      "flags": 0,
      "text": "このまえ　しょうぶを……"
    },
    {
      "index": 10,
      "id": "msg_main0410_green_04",
      "hash": "1b1bff19f9bb0624",
      "flags": 0,
      "text": "グリーン『ああ\\nうわさが　ひろまってるな"
    },
    {
      "index": 11,
      "id": "msg_main0410_green_05",
      "hash": "1b1c0019f9bb07d7",
      "flags": 0,
      "text": "グリーン『マジかよ\\nこわいもの　しらず　だな"
    },
    {
      "index": 12,
      "id": "msg_main0410_green_06",
      "hash": "1b1c0119f9bb098a",
      "flags": 0,
      "text": "とにかく！　ロケットだんは\\nポケモンを　かねもうけに　つかう\\r\\nきけんな　そしき　だとよ\\c\\nちょっと　しらべて　みるか\\n……おまえらも　きを　つけろよ！"
    },
    {
      "index": 13,
      "id": "msg_main0410_rival_05",
      "hash": "f3956ceca3c3164e",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『ロケットだんか……\\c\\n[VAR TRNAME(0000)]　こんど　そんなのに\\nからまれたら　オレを　よんでくれよ！"
    },
    {
      "index": 14,
      "id": "msg_main0410_rival_06",
      "hash": "f3956beca3c3149b",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『グリーンさん\\nめちゃめちゃ　つよいん　だぜ！\\c\\nなんねんも　まえに\\nポケモンリーグの　してんのうに\\r\\nかった　こと　あるんだって！\\c\\nでも　グリーンさんを　まかした\\nライバルが　いるん　だって！\\r\\nスゴすぎて　そうぞう　できねー！"
    },
    {
