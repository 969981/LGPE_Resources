{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_town005_kanban_01",
      "hash": "e9b56ce052d8e502",
      "flags": 0,
      "text": "ここは　シオンタウン\\nシオンは　むらさき　とうとい　いろ"
    },
    {
      "index": 1,
      "id": "msg_town005_kanban_02",
      "hash": "e9b56be052d8e34f",
      "flags": 0,
      "text": "みえない　ポケモンも　よくみえる？\\nしんせいひん！　シルフスコープ！\\c\\n……シルフカンパニー"
    },
    {
      "index": 2,
      "id": "msg_town005_kanban_03",
      "hash": "e9b56ae052d8e19c",
      "flags": 0,
      "text": "ここは　あいの　ボランティア\\nポケモンハウス"
    },
    {
      "index": 3,
      "id": "msg_town005_kanban_04",
      "hash": "e9b569e052d8dfe9",
      "flags": 0,
      "text": "ここは　ポケモンの　れいはい　とう\\nポケモンタワー"
    },
    {
      "index": 4,
      "id": "msg_town005_juveniles_01_01",
      "hash": "dd108a5f7ce63432",
      "flags": 0,
      "text": "あなた\\nゆうれいは　いると　おもう？"
    },
    {
      "index": 5,
      "id": "msg_town005_juveniles_01_02",
      "hash": "dd10895f7ce6327f",
      "flags": 0,
      "text": "……ふーん\\nしんじてる　ひとって　いるんだ"
    },
    {
      "index": 6,
      "id": "msg_town005_juveniles_01_03",
      "hash": "dd10885f7ce630cc",
      "flags": 0,
      "text": "あはは　そうよね！\\c\\nあなたの　みぎかたに\\nしろい　てが　おかれてる　なんて\\r\\n……あたしの　みまちがいよね"
    },
    {
      "index": 7,
      "id": "msg_town005_adultm_01",
      "hash": "85160d0b0641adba",
      "flags": 0,
      "text": "ここは　ポケモンの　おはかで\\nゆうめいな　タウンだ……\\c\\nかっていた　ポケモンが　しんだとき\\nポケモンタワーに　もっていって\\r\\nめいふくを　いのるのさ……"
    },
    {
      "index": 8,
      "id": "msg_town005_youngm_01",
      "hash": "992c8d4ceabdd3c2",
      "flags": 0,
      "text": "さいきん　ポケモンタワーに\\nゆうれいが　でる　らしいんだ……\\c\\nどうも　ロケットだんに　さらわれて\\nゆくえが　わからなかった\\r\\nポケモンの　ゆうれい　らしい……"
    },
    {
      "index": 9,
      "id": "msg_town005_oldf_01",
      "hash": "2d0312137a06f17c",
      "flags": 0,
      "text": "はあ～……\\nおこうの　かおりに　いやされる"
    },
    {
      "index": 10,
      "id": "msg_town005_poke_01",
      "hash": "575f74472b704770",
      "flags": 0,
      "text": "ニドラン♀『ポテ"
    },
    {
      "index": 11,
      "id": "msg_town005_childf_01",
      "hash": "e3b08901e734d73f",
      "flags": 0,
      "text": "ポケモンタワー　では\\nさわいじゃ　ダメなんだって！"
    }
  ],
  "unpaired_labels": [
