{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main1300_rival_01",
      "hash": "76a38f0c21048f9d",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『[VAR TRNAME(0000)]！"
    },
    {
      "index": 1,
      "id": "msg_main1300_rival_02",
      "hash": "76a38c0c21048a84",
      "flags": 0,
      "text": "おいついた……！\\c\\nオレも！　グリーンバッジ\\nてに　いれた！\\c\\nこれで　ポケモンリーグに　いける！"
    },
    {
      "index": 2,
      "id": "msg_main1300_rival_03",
      "hash": "76a38d0c21048c37",
      "flags": 0,
      "text": "してんのうは　もの　すごく\\nつよいって　きいた……\\c\\nでも　いくしか　ないよな！"
    },
    {
      "index": 3,
      "id": "msg_main1300_rival_06",
      "hash": "76a3880c210483b8",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は\\nどの　くらいの　かくご　なんだ？\\c\\nそだてた　ポケモンで\\nみせて　くれ！"
    },
    {
      "index": 4,
      "id": "msg_main1300_rival_04",
      "hash": "76a38a0c2104871e",
      "flags": 0,
      "text": "……オレは　[VAR TRNAME(0000)]の　こと\\nひっぱって　やらなきゃ　って\\r\\nちいさい　ときから　おもってた\\c\\nでも　トレーナーの　さいのうは\\n[VAR TRNAME(0000)]の　ほうが\\r\\nずっと　あると　おもう……"
    },
    {
      "index": 5,
      "id": "msg_main1300_rival_05",
      "hash": "76a38b0c210488d1",
      "flags": 0,
      "text": "くやしい　って　きもち\\nはじめて　なんだ\\c\\nそれだけ　ポケモンが\\nたのしい　って　ことかなあ？"
    },
    {
      "index": 6,
      "id": "msg_main1300_rival_07",
      "hash": "76a3890c2104856b",
      "flags": 0,
      "text": "どうしても　まだ\\nまけを　みとめたく　ないんだ！"
    },
    {
      "index": 7,
      "id": "msg_main1300_rival_08",
      "hash": "76a3860c21048052",
      "flags": 0,
      "text": "……ばか　みたい　だけど\\nここは　さきに　いかせて　くれ！"
    },
    {
      "index": 8,
      "id": "msg_rival_01_p05_field_r022",
      "hash": "da4688279a72feb1",
      "flags": 0,
      "text": "[~ 8]"
    },
    {
