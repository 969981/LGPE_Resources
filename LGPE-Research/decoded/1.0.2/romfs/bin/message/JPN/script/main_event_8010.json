{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8010_water_01",
      "hash": "eb0270625db7e4cb",
      "flags": 0,
      "text": "きみ！"
    },
    {
      "index": 1,
      "id": "msg_main8010_water_05",
      "hash": "eb0274625db7eb97",
      "flags": 0,
      "text": "きみは　ポケモン　そだてる　とき\\nなにか　ポリシーが　ある？"
    },
    {
      "index": 2,
      "id": "msg_main8010_water_06",
      "hash": "eb0275625db7ed4a",
      "flags": 0,
      "text": "わたしの　ポリシーはね……\\nみずタイプ　ポケモンで　せめて\\r\\nせめて　……せめまくる　ことよ！"
    },
    {
      "index": 3,
      "id": "msg_main8010_water_07",
      "hash": "eb0276625db7eefd",
      "flags": 0,
      "text": "さあ！　せかいの　びしょうじょ\\nカスミさまが　あいてに　なるわ！"
    },
    {
      "index": 4,
      "id": "msg_main8010_water_08",
      "hash": "eb0267625db7d580",
      "flags": 0,
      "text": "いくわよ！\\nマーイ　ステディ！"
    },
    {
      "index": 5,
      "id": "msg_gymleader_02_01",
      "hash": "727c3d2a1a30cc28",
      "flags": 0,
      "text": "[~ 5]"
    },
    {
      "index": 6,
      "id": "msg_gymleader_02_06",
      "hash": "727c442a1a30d80d",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main8010_water_02",
      "hash": "eb0271625db7e67e",
      "flags": 0,
      "text": "しょうが　ない！\\c\\nわたしに　かった　しょうこに\\nブルーバッジを　あげる！"
    },
    {
      "index": 8,
      "id": "msg_main8010_sys_01",
      "hash": "fa93f3e6a1687f4d",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　カスミから\\n[VAR COLOR(0006)]ブルーバッジ[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 9,
      "id": "msg_main8010_water_03",
      "hash": "eb0272625db7e831",
      "flags": 0,
      "text": "ブルーバッジが　あれば\\nひとから　もらった　ポケモンでも\\r\\nレベル３０　までなら\\r\\nおとなしく　いうこと　きくわ！\\c\\n……あと　これは　わたしの\\nじまんの　わざマシンよ！"
    },
    {
      "index": 10,
      "id": "msg_main8010_sys_02",
      "hash": "fa93f0e6a1687a34",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　カスミから\\n[VAR ITEM2(0001)]\\r\\n「[VAR COLOR(0006)][VAR MOVE(0002)][VAR COLOR(0000)]」を　もらった！"
    },
    {
      "index": 11,
      "id": "msg_main8010_water_04",
      "hash": "eb0273625db7e9e4",
      "flags": 0,
      "text": "わざマシン２９は　ねっとうを\\nポケモンに　おしえるの\\c\\nみずに　すむ　ポケモンに\\nつかって　あげて！"
    },
    {
      "index": 12,
      "id": "msg_gymleader_02_05",
      "hash": "727c412a1a30d2f4",
      "flags": 0,
      "text": "[~ 12]"
    },
    {
      "index": 13,
      "id": "msg_gymleader_02_02",
      "hash": "727c402a1a30d141",
      "flags": 0,
      "text": "[~ 13]"
