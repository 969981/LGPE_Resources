{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t007r0103_scientist_01",
      "hash": "160a4eebc1bd9357",
      "flags": 0,
      "text": "おれ？　プログラマー　だよ！"
    },
    {
      "index": 1,
      "id": "msg_t007r0103_scientist_02",
      "hash": "160a4febc1bd950a",
      "flags": 0,
      "text": "ポケモンずかん\\nかんせい　したんだ！？\\c\\nプログラム　くんだ\\nかいが　あったよ！"
    },
    {
      "index": 2,
      "id": "msg_t007r0103_pokemaniac_01",
      "hash": "d0e147c02ee4a3e1",
      "flags": 0,
      "text": "おれ　グラフィッカー！\\nきみを　モデリング　したの　おれさ！"
    },
    {
      "index": 3,
      "id": "msg_t007r0103_pokemaniac_02",
      "hash": "d0e144c02ee49ec8",
      "flags": 0,
      "text": "ずかん　かんせい\\nおめでとう！\\c\\nひとまわり　せいちょう　した\\nかおに　なったね！\\c\\nいや　モデルは　かわってないか\\n……こっちの　はなし　さ！"
    },
    {
      "index": 4,
      "id": "msg_t007r0103_fat_01",
      "hash": "cf07f2d5d4ec7ae4",
      "flags": 0,
      "text": "ぼく　シナリオ　かいた！\\nあの……　エリカ　かわいい　でしょ\\c\\nカスミも　いいよね！\\c\\nナツメも　いいよね！"
    },
    {
      "index": 5,
      "id": "msg_t007r0103_fat_02",
      "hash": "cf07f5d5d4ec7ffd",
      "flags": 0,
      "text": "ずかん　できたの？\\nすごい　じゃんー！\\c\\nでも　きみの　ぼうけんは\\nまだまだ　これからだ！\\r\\nなんちって　ね！"
    },
    {
      "index": 6,
      "id": "msg_t007r0103_pc_01",
      "hash": "63199b91d2e25468",
      "flags": 0,
      "text": "ゲームの　プログラムだ！\\nこれ　かえたら　バグる　かも"
    },
    {
      "index": 7,
      "id": "msg_t007r0103_pc_02",
      "hash": "63199e91d2e25981",
      "flags": 0,
      "text": "パソコンで　しごと　ちゅう……\\nと　おもったら　ゲーム　だった！"
    },
    {
      "index": 8,
      "id": "msg_t007r0103_pc_03",
      "hash": "63199d91d2e257ce",
      "flags": 0,
      "text": "……ポケモンの　シナリオだ！\\nこれは　エンディングだ！\\r\\nいまは　みないで　おこう……！"
    },
    {
      "index": 9,
      "id": "msg_t007r0103_kanban_01",
      "hash": "9c6261ad153e9606",
      "flags": 0,
      "text": "ゲームフリーク　かいはつ　しつ"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t007r0103_max",
      "hash": "ed0678f20184083b"
    }
  ]
}
