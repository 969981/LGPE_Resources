      "flags": 0,
      "text": "アツコ『ポケモンとりに　いこうって\\nいったのに……　コージ　どこなのよ！"
    },
    {
      "index": 1,
      "id": "msg_s001r0101_miniskirt_01",
      "hash": "e4be0bc5834e1abc",
      "flags": 0,
      "text": "わたしの　つかまえた\\nガルーラと　ポニータと　ミニリュウ\\r\\nあげる！"
    },
    {
      "index": 2,
      "id": "msg_s001r0101_childm_01",
      "hash": "7dce70172545f1f5",
      "flags": 0,
      "text": "わーい！\\nおねえちゃんが　ぼくの　スイッチに\\r\\nポケモン　おくって　くれた！"
    },
    {
      "index": 3,
      "id": "msg_s001r0101_jeveniles_01",
      "hash": "2004766406f5a463",
      "flags": 0,
      "text": "おとうさんと　ここで　まちあわせ！\\c\\nつかまえた　ポケモン　もらうの！\\nはやく　かえって　こないかな"
    },
    {
      "index": 4,
      "id": "msg_s001r0101_bg_01",
      "hash": "ef7d72c4d1c4136f",
      "flags": 0,
      "text": "Pokémon GOから\\nつれてきた　ポケモンたちが\\r\\nGOパークで　たのしそうに　してる！"
    },
    {
      "index": 5,
      "id": "msg_s001r0101_bg_02",
      "hash": "ef7d73c4d1c41522",
      "flags": 0,
      "text": "Pokémon GOから\\nつれてきた　ポケモンたちを\\r\\nいっぱい　つれて　あるいてる！"
    }
  ],
