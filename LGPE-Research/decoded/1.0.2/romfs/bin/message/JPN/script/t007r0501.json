  "lines": [
    {
      "index": 0,
      "id": "msg_t007r0501_stafff_01",
      "hash": "6271286d67cc858d",
      "flags": 0,
      "text": "いらっしゃいませ！\\nタマムシ　デパートに　ようこそ！\\c\\nかく　フロアの　あんないは\\nおくの　ボードを　ごらん　ください"
    },
    {
      "index": 1,
      "id": "msg_t007r0501_kanban_01",
      "hash": "45ae0e4cd6dbedb4",
      "flags": 0,
      "text": "１かい……　サービス・カウンター\\n２かい……　トレーナーズ・マーケット\\c\\n３かい……　テレビ　ゲーム　ショップ\\n４かい……　ワイズマン・ギフト\\c\\n５かい……　アクセサリー　マーケット\\nおくじょう……　じどう　はんばいき"
    },
    {
      "index": 2,
      "id": "msg_t007r0501_kanban_02",
      "hash": "45ae114cd6dbf2cd",
      "flags": 0,
      "text": "[~ 2]"
    },
    {
      "index": 3,
      "id": "msg_t007r0501_poster_01",
      "hash": "2ab24a8c016ec932",
      "flags": 0,
      "text": "タマムシジムの\\nジムリーダーの　インタビュー！\\c\\n『ちょうせんしゃと\\n　かほうは　ねて　まて　ですの』"
    },
    {
      "index": 4,
      "id": "msg_t007r0501_adultm_01",
      "hash": "a283866ac6a35e84",
      "flags": 0,
      "text": "ふぃー！　デパートの\\nイスの　ありがたさ！\\c\\n……きみも\\nおとなに　なれば　わかるよ"
    },
    {
      "index": 5,
      "id": "msg_t007r0501_oldf_01",
      "hash": "bba12a981d93f1de",
      "flags": 0,
      "text": "ようは　ないんだけどねぇ\\c\\nここに　くれば\\nおともだちに　あえるのよ"
    },
    {
      "index": 6,
      "id": "msg_t007r0501_youngf_01",
      "hash": "7c2ac910457384d7",
      "flags": 0,
      "text": "ポケモンの　アクセサリー\\nかって　ほしいなー！"
    },
    {
      "index": 7,
      "id": "msg_t007r0501_youngm_01",
      "hash": "084041586d0bf1f8",
      "flags": 0,
      "text": "……５かい　まで　いくの\\nたいへんだし　かえらない？"
    }
  ],
