{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t011r0407_staffm_01_01",
      "hash": "e697afe7de4cf5dc",
      "flags": 0,
      "text": "ああ　１１かいの\\nしゃちょうは　ぶじ　かなあ\\r\\n……しんぱいだ！"
    },
    {
      "index": 1,
      "id": "msg_t011r0407_staffm_01_02",
      "hash": "e697b2e7de4cfaf5",
      "flags": 0,
      "text": "しゃちょうを　たすけてくれて\\nほんとうに　ありがとう\\r\\nかんしゃ　しても　しきれないよ"
    },
    {
      "index": 2,
      "id": "msg_t011r0407_staffm_02_01",
      "hash": "1115a7dc94e43893",
      "flags": 0,
      "text": "ロケットだんの　ねらいは\\nポケモンが　かならず　とれる\\r\\nモンスターボール！\\c\\n……マスターボールを\\nたくさん　つくらせる　ことだろう"
    },
    {
      "index": 3,
      "id": "msg_t011r0407_staffm_02_02",
      "hash": "1115a8dc94e43a46",
      "flags": 0,
      "text": "じけんの　せいで……\\nマスターボールは\\r\\nはつばい　ちゅうしに　なったよ"
    },
    {
      "index": 4,
      "id": "msg_t011r0407_staffm_03_01",
      "hash": "0e26fbd76c64647e",
      "flags": 0,
      "text": "シルフも　ポケモンも……\\nロケットだんの　いいなりに\\r\\nなったら　やだなあ"
    },
    {
      "index": 5,
      "id": "msg_t011r0407_staffm_03_02",
      "hash": "0e26fad76c6462cb",
      "flags": 0,
      "text": "すごいなあ！\\nロケットだんの　れんちゅうを\\r\\nおっぱらったんだって？"
    },
    {
      "index": 6,
      "id": "msg_t011r0407_stafff_01_01",
      "hash": "1df9a9528b42a8a9",
      "flags": 0,
      "text": "あなた……！\\nここは　あぶないわよ！\\r\\nたすけに　きた？\\r\\n……だめよ"
    },
    {
      "index": 7,
      "id": "msg_t011r0407_stafff_01_02",
      "hash": "1df9a6528b42a390",
      "flags": 0,
      "text": "たすかったわ　ありがと！"
    },
    {
      "index": 8,
      "id": "msg_t011r0407_kanban_01",
      "hash": "cef63d77c514c564",
      "flags": 0,
      "text": "シルフカンパニー　ほんしゃ\\n７かい"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t011r0407_max",
