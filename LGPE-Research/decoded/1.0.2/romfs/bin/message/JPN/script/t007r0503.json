{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t007r0503_shortpants_01",
      "hash": "74b0ff4fa16bdce3",
      "flags": 0,
      "text": "[~ 0]"
    },
    {
      "index": 1,
      "id": "msg_t007r0503_jevenilem_01",
      "hash": "e4384f0ab442ee86",
      "flags": 0,
      "text": "やったー！\\c\\nとなりのこが　ゴーストと　ガルーラ\\nこうかん　してくれるって！"
    },
    {
      "index": 2,
      "id": "msg_t007r0503_jevenilem_02",
      "hash": "e4384e0ab442ecd3",
      "flags": 0,
      "text": "はやく　きて！\\nゴースト　ちゃーん！\\c\\nぼくは\\nゴースト　マニア　なのね！\\c\\n……あー？\\c\\nてんそう　されて　きた　ゴーストが\\nべつの　ポケモンに！？"
    },
    {
      "index": 3,
      "id": "msg_t007r0503_chilef_01",
      "hash": "97b8808b2d55e818",
      "flags": 0,
      "text": "ひとから　もらった　ポケモンは\\nＩＤが　ちがうから　わかるよ"
    },
    {
      "index": 4,
      "id": "msg_t007r0503_game_01",
      "hash": "92d1753fbd58e1f1",
      "flags": 0,
      "text": "ニンテンドースイッチ　だ！"
    },
    {
      "index": 5,
      "id": "msg_t007r0503_game_02",
      "hash": "92d1723fbd58dcd8",
      "flags": 0,
      "text": "ロールプレイング　ゲームだ！\\n……あそんでく　ひまが　ない"
    },
    {
      "index": 6,
      "id": "msg_t007r0503_game_03",
      "hash": "92d1733fbd58de8b",
      "flags": 0,
      "text": "これは　スポーツ　ゲームだ！\\n……おとうさんが　すきそう！"
    },
    {
      "index": 7,
      "id": "msg_t007r0503_game_04",
      "hash": "92d1783fbd58e70a",
      "flags": 0,
      "text": "パズル　ゲームだ……！\\n……はじめたら　やめられない"
    },
    {
      "index": 8,
      "id": "msg_t007r0503_game_05",
      "hash": "92d1793fbd58e8bd",
      "flags": 0,
      "text": "たいせん　アクションゲームだ！\\n……ちょっと　むずかしそう！"
    },
    {
      "index": 9,
      "id": "msg_t007r0503_kanban_01",
      "hash": "fa4116cb02ff9bc2",
      "flags": 0,
      "text": "３かい……　テレビ　ゲーム　ショップ"
    },
    {
      "index": 10,
      "id": "msg_t007r0503_poster_01",
      "hash": "ae05700f9e7f81a4",
      "flags": 0,
      "text": "ピカチュウと　イーブイ！\\nどっちも　ポケットモンスター！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t007r0503_max",
