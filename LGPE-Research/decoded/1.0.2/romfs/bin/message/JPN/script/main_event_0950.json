{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0950_president_01",
      "hash": "43e9080775e6fb2f",
      "flags": 0,
      "text": "しゃちょう『おお　しょうねんよ！\\nきみの　おかげで　たすかった！"
    },
    {
      "index": 1,
      "id": "msg_main0950_president_02",
      "hash": "43e9090775e6fce2",
      "flags": 0,
      "text": "しゃちょう『おお　しょうじょよ！\\nきみの　おかげで　たすかった！"
    },
    {
      "index": 2,
      "id": "msg_main0950_partner_a_01",
      "hash": "c9f6ab0c5f166b39",
      "flags": 0,
      "text": "ピカピカ！"
    },
    {
      "index": 3,
      "id": "msg_main0950_partner_b_01",
      "hash": "1c046af0a3c5ef46",
      "flags": 0,
      "text": "ブイブイ！"
    },
    {
      "index": 4,
      "id": "msg_main0950_president_08",
      "hash": "43e90f0775e70714",
      "flags": 0,
      "text": "……ワッハッハ！　きみ　でなく\\nきみたち　じゃったな！"
    },
    {
      "index": 5,
      "id": "msg_main0950_president_05",
      "hash": "43e9040775e6f463",
      "flags": 0,
      "text": "ピンチを　すくって　くれた\\nきみたちの　ことを　このさき\\r\\nわたしは　けして　わすれんとも！"
    },
    {
      "index": 6,
      "id": "msg_main0950_president_06",
      "hash": "43e9050775e6f616",
      "flags": 0,
      "text": "おお！　そうだ\\nおれいを　さしあげなくては！\\c\\nわたしは\\nふとっぱらで　ある　からして\\c\\nほれ\\nこーんな　ものでは　いかがかな？"
    },
    {
      "index": 7,
      "id": "msg_main0950_sys_01",
      "hash": "f506055ea4260db4",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　しゃちょう　から\\n[VAR COLOR(0006)]マスターボール[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 8,
      "id": "msg_main0950_president_03",
      "hash": "43e90a0775e6fe95",
      "flags": 0,
      "text": "しゃちょう『どこにも　うってない\\nひみつの　しさくひん\\r\\nマスターボール！"
    },
    {
      "index": 9,
      "id": "msg_main0950_president_07",
      "hash": "43e9060775e6f7c9",
      "flags": 0,
      "text": "なげれば　かならず\\nポケモンを　つかまえられる！\\c\\n……じつは　ひとつ　だけ\\nかんせい　して　いたのだよ"
    },
    {
      "index": 10,
      "id": "msg_main0950_president_09",
      "hash": "43e9100775e708c7",
      "flags": 0,
      "text": "こっそりと……\\nつかって　みて　くれたまえ"
    },
    {
      "index": 11,
      "id": "msg_main0950_president_04",
      "hash": "43e9030775e6f2b0",
      "flags": 0,
      "text": "しゃちょう『おお！\\nピンチの　おんじん！\\r\\nあのときは　ありがとう！"
    },
    {
      "index": 12,
      "id": "msg_main0950_president_10",
      "hash": "43ec8d0775ea1305",
      "flags": 0,
      "text": "しゃちょう『おお！\\nきみ　まってくれ！\\r\\nおれいを　させてくれ！"
    },
    {
      "index": 13,
      "id": "msg_workerm1_01_p04_cave_d1011",
      "hash": "d2eb872ba95fcdcc",
      "flags": 0,
      "text": "[~ 13]"
    },
    {
      "index": 14,
      "id": "msg_main0950_stafff_01",
      "hash": "079f21ac444df12d",
      "flags": 0,
      "text": "ひしょ『このたびは　たすけて\\nいただいて　ありがとう　ございます\\c\\nしゃちょう　ともども\\nかんしゃの　きもちで　いっぱいです"
    },
    {
      "index": 15,
      "id": "msg_main0950_stafff_02",
      "hash": "079f1eac444dec14",
      "flags": 0,
      "text": "ひしょ『かならず　つかまえられる\\nボール　なんて……\\c\\nよほどの　トレーナー　でないと\\nもつ　べきでは　ありませんわ\\c\\nしゃちょうは　あなたに　だから\\nマスターボールを　あげたのですわ"
    }
  ],
