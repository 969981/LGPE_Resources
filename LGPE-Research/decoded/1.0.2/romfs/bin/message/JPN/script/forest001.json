{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_forest001_bugcatcher_01",
      "hash": "42b8c530b5989886",
      "flags": 0,
      "text": "ともだちと　むしポケモン\\nとりに　きてるんだ！\\c\\nポケモン　しょうぶ　したくて\\nみんな　ウズウズ　してるよ！"
    },
    {
      "index": 1,
      "id": "msg_forest001_shortpants_01",
      "hash": "896a584b4d86cbe4",
      "flags": 0,
      "text": "ポケモン　とろうとして\\nモンスターボール　なげてたら\\r\\nすぐ　なくなっちゃった\\c\\nきみも　おおめに\\nかって　おくと　いいよ"
    },
    {
      "index": 2,
      "id": "msg_forest001_kanban_01",
      "hash": "a573a2375b89557d",
      "flags": 0,
      "text": "……おとくな　けいじばん！\\c\\nとりはずした　Joy-Conを　ふれば\\nあいぼう　ポケモンと　あそべる！"
    },
    {
      "index": 3,
      "id": "msg_forest001_kanban_02",
      "hash": "a5739f375b895064",
      "flags": 0,
      "text": "どくを　くらったら　どくけし！\\nまひに　されたら　まひなおし！\\c\\nフレンドリィショップで！"
    },
    {
      "index": 4,
      "id": "msg_forest001_kanban_03",
      "hash": "a573a0375b895217",
      "flags": 0,
      "text": "……おとくな　けいじばん！\\c\\nポケモンずかんは　けんきゅうじょで\\nオーキドはかせに　みてもらえる！"
    },
    {
      "index": 5,
      "id": "msg_forest001_kanban_04",
      "hash": "a5739d375b894cfe",
      "flags": 0,
      "text": "……おとくな　けいじばん！\\c\\nポケモンを　つかまえると\\nてもちの　ポケモンは\\r\\nけいけんちを　もらえます！\\c\\nおおきい　ポケモンを　つかまえれば\\nけいけんちも　たくさん！\\c\\n……ちいさくても　たくさん！"
    },
    {
      "index": 6,
      "id": "msg_forest001_kanban_05",
      "hash": "a5739e375b894eb1",
      "flags": 0,
      "text": "……おとくな　けいじばん！\\c\\nポケモンの　つかまえかたは\\nコントローラーに　よって　ちがう！\\c\\nコントローラーを　かえたら\\nポケモンを　つかまえる　がめんで\\r\\nヘルプを　みてみよう！"
    },
    {
      "index": 7,
      "id": "msg_forest001_kanban_06",
      "hash": "a5739b375b894998",
      "flags": 0,
      "text": "トキワのもり　……　でぐち\\nこのさき　ニビシティ"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_forest001_max",
      "hash": "ef0de44a4bec1284"
    }
  ]
}
