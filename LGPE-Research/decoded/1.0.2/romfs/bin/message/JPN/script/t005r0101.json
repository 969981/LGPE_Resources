  "lines": [
    {
      "index": 0,
      "id": "msg_t005r0101_youngm_01",
      "hash": "5a81f7f43e3646ca",
      "flags": 0,
      "text": "おっかしいなー！\\nフジろうじんが　いないぞ！\\r\\nどこに　いったのかな？"
    },
    {
      "index": 1,
      "id": "msg_t005r0101_youngm_02",
      "hash": "5a81f6f43e364517",
      "flags": 0,
      "text": "フジろうじん　ガラガラの　れいを\\nなぐさめに　いってたんだね"
    },
    {
      "index": 2,
      "id": "msg_t005r0101_juveniles_01",
      "hash": "b3092b7e97f4b1c8",
      "flags": 0,
      "text": "ここは　もともと\\nフジじいちゃんの　おうち　なの\\c\\nじいちゃん　やさしいのよ！\\c\\nすてられたり　かえなくなった\\nポケモンを　あずかって\\r\\nせわ　してるの"
    },
    {
      "index": 3,
      "id": "msg_t005r0101_juveniles_02",
      "hash": "b3092e7e97f4b6e1",
      "flags": 0,
      "text": "はあ　あったかい……！\\nポケモンって　だっこ　すると\\r\\nあったかいんだよねー！"
    },
    {
      "index": 4,
      "id": "msg_t005r0101_poke_01",
      "hash": "0385607c405e4cb8",
      "flags": 0,
      "text": "ニドリーノ『がぉーっ！"
    },
    {
      "index": 5,
      "id": "msg_t005r0101_poke_02",
      "hash": "0385637c405e51d1",
      "flags": 0,
      "text": "コダック『ぐわっぱ！"
    },
    {
      "index": 6,
      "id": "msg_book_01_p01_t005_r0101",
      "hash": "687235c0f3f98ae7",
      "flags": 0,
      "text": "ごうか　しょうひんが　あたる！\\nげっかん　ポケモンの　とも\\r\\nビッグ・プレゼント！\\c\\n……おうぼ　ほうほうは\\c\\n……あら　きりとって　ある！"
    },
    {
      "index": 7,
      "id": "msg_book_02_p01_t005_r0101",
      "hash": "b162f14ffbd91cd8",
      "flags": 0,
      "text": "ポケモンざっしが　ならんでる！\\c\\n……ポケモンてちょう\\c\\n……ポケモングラフ"
    }
  ],
