{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t006r0307_cook_01",
      "hash": "c97ffa1a1adc76f0",
      "flags": 0,
      "text": "ほら！\\nそこの　きみ　じゃまだよ！\\r\\nどいた　どいた！"
    },
    {
      "index": 1,
      "id": "msg_t006r0307_cook_02",
      "hash": "c97ffd1a1adc7c09",
      "flags": 0,
      "text": "りょうりに　かぶせる\\nぎんの　ドーム……！\\c\\nクロッシュ　という　もの　で\\nりょうりを　さめにくく　するよ"
    },
    {
      "index": 2,
      "id": "msg_t006r0307_cook_03",
      "hash": "c97ffc1a1adc7a56",
      "flags": 0,
      "text": "いそがしくって　めが　まわる！\\nたのむ　から　あっち　いってくれ！"
    },
    {
      "index": 3,
      "id": "msg_t006r0307_cook_04",
      "hash": "c97fff1a1adc7f6f",
      "flags": 0,
      "text": "せっせ　せっせ……\\c\\nおれは　まいにち\\nイモの　かわむきだ！\\r\\nせっせ　せっせ……"
    },
    {
      "index": 4,
      "id": "msg_t006r0307_cook_05",
      "hash": "c97ffe1a1adc7dbc",
      "flags": 0,
      "text": "そういえば　くいしんぼうの\\nカビゴン　しってる？\\c\\nあんなに　よく　たべて　よく　ねる\\nポケモンは　ほかに　いないよ！"
    },
    {
      "index": 5,
      "id": "msg_t006r0307_cook_06",
      "hash": "c980011a1adc82d5",
      "flags": 0,
      "text": "しくしく　しくしく……\\c\\nおれは　まいにち\\nタマネギの　かわむきだー\\r\\nしくしく　しくしく……"
    },
    {
      "index": 6,
      "id": "msg_t006r0307_cook_07_01",
      "hash": "6e19651585616b6c",
      "flags": 0,
      "text": "おっほん！\\nわたしが　ここの　シェフです！\\c\\nきょうの　メイン　ディッシュは"
    },
    {
      "index": 7,
      "id": "msg_t006r0307_cook_07_02",
      "hash": "6e19681585617085",
      "flags": 0,
      "text": "とれたて　ピチピチ　うずしおスシ！\\c\\nしかし　おきゃくさんに\\nまた　さかな？　と　いわれそうだ"
    },
    {
      "index": 8,
      "id": "msg_t006r0307_cook_07_03",
      "hash": "6e19671585616ed2",
      "flags": 0,
      "text": "カントーの　あじ！　ニビあられ！\\c\\n……じゃ　おきゃく　さんに\\nおこられるか？"
    },
    {
      "index": 9,
      "id": "msg_t006r0307_cook_07_04",
      "hash": "6e19621585616653",
      "flags": 0,
      "text": "ジューシーな　とっしんステーキ！\\c\\nでも　ざいりょう\\nにんずう　ぶん　あったかな？"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t006r0307_max",
      "hash": "d197397409d6cf5c"
    }
  ]
}
