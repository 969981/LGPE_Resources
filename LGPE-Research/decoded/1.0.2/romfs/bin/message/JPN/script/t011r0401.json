  "lines": [
    {
      "index": 0,
      "id": "msg_t011r0401_stafff_01",
      "hash": "7b367eeccace56bf",
      "flags": 0,
      "text": "うけつけ『……あら！\\nいらっしゃいませ！\\c\\nしゃちょう　ですか？\\nただいま　１１かい\\r\\nしゃちょうしつで　ございます！"
    },
    {
      "index": 1,
      "id": "msg_t011r0401_kanban_01",
      "hash": "dbbd819015027d96",
      "flags": 0,
      "text": "シルフカンパニー　ほんしゃ\\n１かい"
    },
    {
      "index": 2,
      "id": "msg_t011r0401_staffm_01",
      "hash": "712136b29fad8a30",
      "flags": 0,
      "text": "ロケットだん　やっつけたの　って\\nこども　らしいぞ！\\c\\nもしかして　きみ……？\\nいや　まさかね"
    },
    {
      "index": 3,
      "id": "msg_t011r0401_staffm_02",
      "hash": "712139b29fad8f49",
      "flags": 0,
      "text": "あらゆる　どうぐは\\nつかう　ひとに　よって\\r\\nくすりにも　どくにも　なります\\c\\nロケットだんが　シルフの　ぎじゅつを\\nあくよう　したらと　おもうと\\r\\nぞっとしますよ"
    },
    {
      "index": 4,
      "id": "msg_t011r0401_staffm_03",
      "hash": "712138b29fad8d96",
      "flags": 0,
      "text": "かいしゃ　サボってたら\\nのっとられてん　だもん\\r\\nビックリしたよ"
    },
    {
      "index": 5,
      "id": "msg_t011r0401_stafff_02",
      "hash": "7b367feccace5872",
      "flags": 0,
      "text": "いままで　おしごと\\nストップ　してた　ぶん\\r\\nバリバリ　はたらく　わよー！"
    },
    {
      "index": 6,
      "id": "msg_t011r0401_stafff_03",
      "hash": "7b3680eccace5a25",
      "flags": 0,
      "text": "ロケットだんに\\nつかまってたんだけど\\r\\nろうさい　おりるのかしら"
    }
  ],
  "unpaired_labels": [
