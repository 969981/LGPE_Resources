{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0690_musashi_01",
      "hash": "d74771d1dcdd62f4",
      "flags": 0,
      "text": "ムサシ『サカキさまの　ために\\nシオンタウンまで　きたけど……"
    },
    {
      "index": 1,
      "id": "msg_main0690_musashi_02",
      "hash": "d74774d1dcdd680d",
      "flags": 0,
      "text": "フジって　じいさん\\nどこにも　いないじゃない！"
    },
    {
      "index": 2,
      "id": "msg_main0690_kojiro_01",
      "hash": "c6bc31c54cc29f90",
      "flags": 0,
      "text": "コジロウ『あと　さがして　ないのは\\nポケモンタワーの　てっぺん　とか？"
    },
    {
      "index": 3,
      "id": "msg_main0690_musashi_03",
      "hash": "d74773d1dcdd665a",
      "flags": 0,
      "text": "ムサシ『へんな　[VAR COLOR(0006)]ゆうれい[VAR COLOR(0000)]が　ジャマで\\n[VAR COLOR(0006)]うえまで　いけない[VAR COLOR(0000)]の　よねー"
    },
    {
      "index": 4,
      "id": "msg_main0690_kojiro_02",
      "hash": "c6bc34c54cc2a4a9",
      "flags": 0,
      "text": "コジロウ『じいさんは\\nみつけられ　なかったが\\c\\nこの　カラカラ　だけでも\\nアジトまで　さらっていこうぜ！"
    },
    {
      "index": 5,
      "id": "msg_main0690_musashi_04",
      "hash": "d7476ed1dcdd5ddb",
      "flags": 0,
      "text": "ムサシ『そうね！　[VAR COLOR(0006)]タマムシシティ[VAR COLOR(0000)]の\\n[VAR COLOR(0006)]ロケットゲームコーナー[VAR COLOR(0000)]に　いきましょ"
    },
    {
      "index": 6,
      "id": "msg_main0690_karakara_01",
      "hash": "8ac4c1eac38e8eb8",
      "flags": 0,
      "text": "カラカラ『マァー？"
    },
    {
      "index": 7,
      "id": "msg_main0690_musashi_08",
      "hash": "d7476ad1dcdd570f",
      "flags": 0,
      "text": "ムサシ『ハイハイ　あんたの　ママは\\nタマムシシティに　いまちゅよー\\r\\nいっしょに　いきましょねー"
    },
    {
      "index": 8,
      "id": "msg_main0690_karakara_02",
      "hash": "8ac4c4eac38e93d1",
      "flags": 0,
      "text": "カラカラ『マァ　マァ！"
    },
    {
      "index": 9,
      "id": "msg_main0690_all_01",
      "hash": "afaa9eb286d542b1",
      "flags": 0,
      "text": "そうと　きまれば\\nそれ　いそげー！"
    },
    {
      "index": 10,
      "id": "msg_main0690_young_m_01",
      "hash": "9bacda0fa316a5ac",
      "flags": 0,
      "text": "た　たいへんな　ものを\\nみてしまった……"
    },
    {
      "index": 11,
      "id": "msg_main0690_young_m_02",
      "hash": "9bacdd0fa316aac5",
      "flags": 0,
      "text": "きみ　みた！？\\nロケットだんが　カラカラを\\r\\nつれてっちゃった！"
    },
    {
      "index": 12,
      "id": "msg_main0690_young_m_03",
      "hash": "9bacdc0fa316a912",
      "flags": 0,
      "text": "[VAR COLOR(0006)]タマムシシティ[VAR COLOR(0000)]に\\nむかった　らしいけど……"
    },
    {
      "index": 13,
      "id": "msg_main0690_young_m_04",
      "hash": "9bacd70fa316a093",
      "flags": 0,
      "text": "ホネを　とって　たかく\\nうる　つもり　なのかも……！"
    },
    {
      "index": 14,
      "id": "msg_main0690_young_m_05",
      "hash": "9bacd60fa3169ee0",
      "flags": 0,
      "text": "ロケットだん　から\\nカラカラを　たすけたの！？\\r\\nきみ　すごいな！"
    },
    {
      "index": 15,
      "id": "msg_main0690_young_m_06",
      "hash": "9bacd90fa316a3f9",
      "flags": 0,
      "text": "これ　ありがとうの\\nきもち　だよ！"
    },
    {
      "index": 16,
      "id": "msg_main0690_system_01",
      "hash": "097ca861ce11115b",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は\\nスーパーボールを　２０こ　もらった！"
    },
    {
      "index": 17,
      "id": "msg_main0690_young_m_07",
      "hash": "9bacd80fa316a246",
      "flags": 0,
      "text": "きみ　みたいに\\nゆうきが　あれば\\c\\nポケモンタワーも　へいきで\\nのぼれるん　だろうね"
    },
    {
      "index": 18,
      "id": "msg_main0690_musashi_05",
      "hash": "d7476dd1dcdd5c28",
      "flags": 0,
      "text": "ムサシ『いけ！　そこよ！\\nあーん！　もう　ちょっと　なのに！"
    },
    {
      "index": 19,
      "id": "msg_main0690_kojiro_03",
      "hash": "c6bc33c54cc2a2f6",
      "flags": 0,
      "text": "コジロウ『なぁ　ムサシー\\c\\nそろそろ　アジトに　もどらないか？"
    },
    {
      "index": 20,
      "id": "msg_main0690_musashi_06",
      "hash": "d74770d1dcdd6141",
      "flags": 0,
      "text": "ムサシ『えー　いいじゃなーい！\\c\\n[VAR COLOR(0006)]カラカラ[VAR COLOR(0000)]は　みはりに　とどけたし\\nきゅうけいよ　きゅうけい！\\c\\nってか　[VAR COLOR(0006)]アジトの　かくしとびら[VAR COLOR(0000)]\\nどうやって　あけるん　だっけ？"
    },
    {
      "index": 21,
      "id": "msg_main0690_kojiro_04",
      "hash": "c6bc36c54cc2a80f",
      "flags": 0,
      "text": "コジロウ『[VAR COLOR(0006)]のりもの[VAR COLOR(0000)]の　[VAR COLOR(0006)]ポスター[VAR COLOR(0000)]\\nしらべるん　だよ！\\c\\n[VAR COLOR(0006)]オレたち　らしい　[VAR COLOR(0000)]サイコーな\\n[VAR COLOR(0006)]のりもの[VAR COLOR(0000)]の　ポスターをさ！"
    },
    {
      "index": 22,
      "id": "msg_main0690_musashi_07",
      "hash": "d7476fd1dcdd5f8e",
      "flags": 0,
      "text": "ムサシ『あたしたち　らしい\\nのりものって　なによ？"
    },
    {
      "index": 23,
      "id": "msg_main0690_kojiro_05",
      "hash": "c6bc35c54cc2a65c",
      "flags": 0,
      "text": "コジロウ『あれに　きまってるだろ？\\n[VAR COLOR(0006)]うちゅうを　かける……[VAR COLOR(0000)]　さ！"
    },
    {
      "index": 24,
      "id": "msg_main0690_nyasu_01",
      "hash": "299ff18c5c968898",
      "flags": 0,
      "text": "ニャース『ふにーん"
    }
  ],
