{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t003r0101_scientist_01_01",
      "hash": "40fdab8e6795129d",
      "flags": 0,
      "text": "はいはい　こどもは\\nけんがくりょう　５０円　です\\r\\nけんがく　しますか？"
    },
    {
      "index": 1,
      "id": "msg_t003r0101_scientist_01_02",
      "hash": "40fda88e67950d84",
      "flags": 0,
      "text": "また　きてね"
    },
    {
      "index": 2,
      "id": "msg_t003r0101_scientist_01_03",
      "hash": "40fda98e67950f37",
      "flags": 0,
      "text": "はい　たしかに\\n５０円　いただき　ました！"
    },
    {
      "index": 3,
      "id": "msg_t003r0101_scientist_01_04",
      "hash": "40fda68e67950a1e",
      "flags": 0,
      "text": "……あら\\nおかねが　ないよ"
    },
    {
      "index": 4,
      "id": "msg_t003r0101_scientist_01_05",
      "hash": "40fda78e67950bd1",
      "flags": 0,
      "text": "ごゆっくり　どうぞ！"
    },
    {
      "index": 5,
      "id": "msg_t003r0101_scientist_01_06",
      "hash": "40fda48e679506b8",
      "flags": 0,
      "text": "うらぐちから　タダで\\nはいろうなんて\\r\\nちゃっかりもの　だね\\c\\nそれより　きみ\\nコハクって　しってる？"
    },
    {
      "index": 6,
      "id": "msg_t003r0101_scientist_01_07",
      "hash": "40fda58e6795086b",
      "flags": 0,
      "text": "コハクに　まじった\\nむかしのいきものを　よみがえらせる\\c\\nそうだいな　じっけんを　どこかの\\nけんきゅうじょが　してるんだって"
    },
    {
      "index": 7,
      "id": "msg_t003r0101_scientist_01_08",
      "hash": "40fda28e67950352",
      "flags": 0,
      "text": "おおむかし　きから　でた　しるが\\nカセキのように　かたまった　ものを\\c\\nコハクと　いうんだよ"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_033_max",
