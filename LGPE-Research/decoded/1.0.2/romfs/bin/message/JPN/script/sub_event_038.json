  "lines": [
    {
      "index": 0,
      "id": "msg_sub038_adultm_01",
      "hash": "f87cb4ed9d98299a",
      "flags": 0,
      "text": "おれ……\\nポケモン　そだてるの　へた　なんだ\\c\\nこの　ヒトカゲも　よわいままで\\nかわいそう　だから\\c\\nおれより　すごい\\nトレーナーに　あげたいんだ"
    },
    {
      "index": 1,
      "id": "msg_sub038_adultm_05",
      "hash": "f87cb0ed9d9822ce",
      "flags": 0,
      "text": "キミが　ポケモンを\\nつかまえた　かずは\\r\\n[VAR NUM9(0000,0000)]か……！"
    },
    {
      "index": 2,
      "id": "msg_sub038_adultm_06",
      "hash": "f87cafed9d98211b",
      "flags": 0,
      "text": "すげー！　キミに　この　ヒトカゲ\\nもらってほしいや！　どうかな？"
    },
    {
      "index": 3,
      "id": "msg_sub038_adultm_02",
      "hash": "f87cb3ed9d9827e7",
      "flags": 0,
      "text": "それじゃ　おねがい　するよ！"
    },
    {
      "index": 4,
      "id": "msg_sub038_adultm_07",
      "hash": "f87caeed9d981f68",
      "flags": 0,
      "text": "おれの　つかまえた　かずは　[VAR NUM3(0000)]\\nこれ　より　おおく　なくちゃ……！"
    },
    {
      "index": 5,
      "id": "msg_sub038_adultm_03",
      "hash": "f87cb2ed9d982634",
      "flags": 0,
      "text": "そうか……\\nはかせに　おくろう　かな……"
    },
    {
      "index": 6,
      "id": "msg_sub038_adultm_04",
      "hash": "f87cb1ed9d982481",
      "flags": 0,
      "text": "あのときの　ヒトカゲ　そだってる？"
    },
    {
      "index": 7,
      "id": "msg_sub038_poke_01",
      "hash": "a722653a024051d0",
      "flags": 0,
      "text": "ヒトカゲ『カゲゲ！"
    }
  ],
