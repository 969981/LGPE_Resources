    {
      "index": 14,
      "id": "msg_main0910_rival_05",
      "hash": "b87f40ae2454355b",
      "flags": 0,
      "text": "あ！　あの　したっぱ\\nこんなの　おとしたぜ！"
    },
    {
      "index": 15,
      "id": "msg_main0910_sys_01",
      "hash": "7e91e0790e71c998",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　[VAR TRNAME(0001)]から\\n[VAR COLOR(0006)]カードキー[VAR COLOR(0000)]を　うけとった！"
