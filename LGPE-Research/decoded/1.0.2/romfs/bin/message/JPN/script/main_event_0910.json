    },
    {
      "index": 2,
      "id": "msg_main0910_rival_01",
      "hash": "b87f44ae24543c27",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『[VAR TRNAME(0000)]\\nだれなんだ？　そのひと？"
