{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0900_stafff_01",
      "hash": "eaf7003cf3e9b4e4",
      "flags": 0,
      "text": "うけつけ『キミ！"
    },
    {
      "index": 1,
      "id": "msg_main0900_stafff_04",
      "hash": "eaf6fd3cf3e9afcb",
      "flags": 0,
      "text": "いま　この　かいしゃは\\nちょっと　たいへん　なの\\c\\n……あぶない　から\\nこどもは　はいっちゃ　ダメよ！"
    },
    {
      "index": 2,
      "id": "msg_main0900_green_01",
      "hash": "26e576e0f08c51d1",
      "flags": 0,
      "text": "グリーン『そう　いわずに\\nけんがく　させて　くれませんか？"
    },
    {
      "index": 3,
      "id": "msg_main0900_stafff_02",
      "hash": "eaf7033cf3e9b9fd",
      "flags": 0,
      "text": "うけつけ『あら　グリーンくん！"
    },
    {
      "index": 4,
      "id": "msg_main0900_rival_01",
      "hash": "4c13e9c3c6b311d4",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『[VAR TRNAME(0000)]！\\nさがしたん　だぞ！"
    },
    {
      "index": 5,
      "id": "msg_main0900_rival_07",
      "hash": "4c13e7c3c6b30e6e",
      "flags": 0,
      "text": "なんで　この　ビルに？"
    },
    {
      "index": 6,
      "id": "msg_main0900_select_01",
      "hash": "994bb0148a000904",
      "flags": 0,
      "text": "ロケットだんが……"
    },
    {
      "index": 7,
      "id": "msg_main0900_select_02",
      "hash": "994bb3148a000e1d",
      "flags": 0,
      "text": "のっとり　だって……"
    },
    {
      "index": 8,
      "id": "msg_main0900_rival_02",
      "hash": "4c13ecc3c6b316ed",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『やっぱり！\\nロケットだんの　やつら\\r\\nあちこちで　わるさ　してるんだ"
    },
    {
      "index": 9,
      "id": "msg_main0900_green_02",
      "hash": "26e573e0f08c4cb8",
      "flags": 0,
      "text": "グリーン『[VAR TRNAME(0001)]の\\nいう　とおり　だな！\\c\\nもう　これ　いじょう\\nロケットだんの　すること\\r\\nほって　おけねー！"
    },
    {
      "index": 10,
      "id": "msg_main0900_select_03",
      "hash": "994bb2148a000c6a",
      "flags": 0,
      "text": "じぶんも　です！"
    },
    {
      "index": 11,
      "id": "msg_main0900_select_04",
      "hash": "994bad148a0003eb",
      "flags": 0,
      "text": "どうすれば？"
    },
    {
      "index": 12,
      "id": "msg_main0900_green_03",
      "hash": "26e574e0f08c4e6b",
      "flags": 0,
      "text": "グリーン『よし\\nさっそく　さくせん　かいぎだ！"
    },
    {
      "index": 13,
      "id": "msg_main0900_green_04",
      "hash": "26e579e0f08c56ea",
      "flags": 0,
      "text": "グリーン『おれたちに\\nできる　ことを　するんだ！"
    },
    {
      "index": 14,
      "id": "msg_main0900_green_05",
      "hash": "26e57ae0f08c589d",
      "flags": 0,
      "text": "……て　ことで\\c\\n[VAR TRNAME(0000)]は　よてい　どおり\\nシルフカンパニーに　いる\\r\\nロケットだんを　おいはらう\\c\\nひとりは　あぶねー　から\\n[VAR TRNAME(0001)]も　いっしょな！"
    },
    {
      "index": 15,
      "id": "msg_main0900_rival_03",
      "hash": "4c13ebc3c6b3153a",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『はい！"
    },
    {
      "index": 16,
      "id": "msg_main0900_green_06",
      "hash": "26e577e0f08c5384",
      "flags": 0,
      "text": "グリーン『おれは\\nカントー　じゅうを　まわる！\\c\\nロケットだんの　やつらを\\nかたっぱし　から　つぶして\\r\\nなんとか　ボスの　いばしょを\\r\\nさぐってみる"
    },
    {
      "index": 17,
      "id": "msg_main0900_green_11",
      "hash": "26e8fae0f08f67f4",
      "flags": 0,
      "text": "それから　ポケモンリーグ　にも\\nいって　じけんを　しらせる"
    },
    {
      "index": 18,
      "id": "msg_main0900_rival_04",
      "hash": "4c13e6c3c6b30cbb",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『すげー！\\nもしかして　してんのうが\\r\\nみかたに　なって　くれるかも……！？"
    },
    {
      "index": 19,
      "id": "msg_main0900_green_07",
      "hash": "26e578e0f08c5537",
      "flags": 0,
      "text": "グリーン『それじゃ　ふたてに\\nわかれて　さくせん　かいし　だ！"
    },
    {
      "index": 20,
      "id": "msg_main0900_green_08",
      "hash": "26e56de0f08c4286",
      "flags": 0,
      "text": "……と　いいたい　けど\\nそのまえに"
    },
    {
      "index": 21,
      "id": "msg_main0900_green_12",
      "hash": "26e8fde0f08f6d0d",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]　[VAR TRNAME(0001)]！\\c\\nふたりが　どれくらい　つよいか\\nおれは　しらない\\c\\nあんしん　して　まかせて　いーのか\\nじつりょくを　みせて　もらうぜ！"
    },
    {
      "index": 22,
      "id": "msg_main0900_rival_05",
      "hash": "4c13e5c3c6b30b08",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『えッ！"
    },
    {
      "index": 23,
      "id": "msg_main0900_green_09",
      "hash": "26e56ee0f08c4439",
      "flags": 0,
      "text": "グリーン『どっち　からでも　いいぜ\\nかかって　こいよ！"
    },
    {
      "index": 24,
      "id": "msg_main0900_green_10",
      "hash": "26e8fbe0f08f69a7",
      "flags": 0,
      "text": "グリーン『おい　おい！\\nおれは　ここ　だぜ？"
    },
    {
      "index": 25,
      "id": "msg_main0900_stafff_03",
      "hash": "eaf7023cf3e9b84a",
      "flags": 0,
      "text": "うけつけ『シルフカンパニーを\\nたすけに　きて　くれたの？\\c\\nグリーンくんの　しりあい　なら\\nたよりに　できそう！"
    },
    {
      "index": 26,
      "id": "msg_main0900_rival_06",
      "hash": "4c13e8c3c6b31021",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『もし　かてたら\\nガラガラの　かたきを　うつ\\r\\nじしんが　もてるかも……！\\c\\n[VAR TRNAME(0000)]　さきに　いくか？"
    }
  ],
