{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8000_rock_01",
      "hash": "cdc216030adc7af4",
      "flags": 0,
      "text": "きたな！\\nおれは　ニビ　ポケモンジム\\r\\nリーダーの　タケシ！"
    },
    {
      "index": 1,
      "id": "msg_main8000_rock_06",
      "hash": "cdc215030adc7941",
      "flags": 0,
      "text": "おれの　かたい　いしは\\nおれの　ポケモンにも　あらわれる！\\r\\nかたくて　がまん　づよい！"
    },
    {
      "index": 2,
      "id": "msg_main8000_rock_07",
      "hash": "cdc214030adc778e",
      "flags": 0,
      "text": "そう！　つかうのは\\nいわタイプ　ばっかりだ！"
    },
    {
      "index": 3,
      "id": "msg_main8000_rock_08",
      "hash": "cdc20f030adc6f0f",
      "flags": 0,
      "text": "ふはは！\\nまけると　わかってて　たたかうか！\\r\\nポケモン　トレーナーの　さがだな"
    },
    {
      "index": 4,
      "id": "msg_main8000_rock_09",
      "hash": "cdc20e030adc6d5c",
      "flags": 0,
      "text": "いいだろう！\\nかかって　こい！"
    },
    {
      "index": 5,
      "id": "msg_main8000_rock_02",
      "hash": "cdc219030adc800d",
      "flags": 0,
      "text": "おれに　かった　あかしに\\nポケモンリーグ　こうにん\\r\\nグレーバッジ　を　さずけよう！"
    },
    {
      "index": 6,
      "id": "msg_main8000_sys_01",
      "hash": "6a98f2c3653ad72a",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　タケシから\\n[VAR COLOR(0006)]グレーバッジ[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 7,
      "id": "msg_main8000_rock_03",
      "hash": "cdc218030adc7e5a",
      "flags": 0,
      "text": "グレーバッジが　あれば\\nひとから　もらった　ポケモンでも\\r\\nレベル２０まで　なら\\r\\nいうことを　きいて　くれるぞ！\\c\\nあと……　そうだ！\\nこれを　きみに　あげよう！"
    },
    {
      "index": 8,
      "id": "msg_main8000_sys_02",
      "hash": "6a98f1c3653ad577",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　タケシから\\n[VAR ITEM2(0001)]\\r\\n「[VAR COLOR(0006)][VAR MOVE(0002)][VAR COLOR(0000)]」を　もらった！"
    },
    {
      "index": 9,
      "id": "msg_main8000_rock_04",
      "hash": "cdc213030adc75db",
      "flags": 0,
      "text": "わざマシンを　つかうと　ポケモンは\\nすぐ　その　わざを　おぼえる！\\r\\nそれに　つかっても　なくならないぞ！\\c\\nところで……\\nわざマシン０１には\\r\\nずつき　が　はいっている！\\c\\nいわのように　かたい　あたまで\\nあいてに　ダメージを\\r\\nあたえる　わざだ！"
    },
    {
      "index": 10,
      "id": "msg_main8000_rock_05",
      "hash": "cdc212030adc7428",
      "flags": 0,
      "text": "この　ひろい　せかいには\\nいろんな　やつが　いる！\\r\\nポケモンを\\r\\nたたかわせたり　そだてたり……\\c\\nおれは　ここで\\nポケモンを　そだてる　ブリーダーの\\r\\nしゅぎょうを　しているんだ！\\c\\nきみは　つよさを　めざすのか？\\nなら　ほかの　ジムにも　いくといい！"
    },
    {
      "index": 11,
      "id": "msg_main8000_shortpants_01",
      "hash": "f371c7fe6a94e317",
      "flags": 0,
      "text": "おまえ…！\\nポケモン　トレーナー　だろ？\\r\\nタケシが　あいてを　さがしてる\\c\\n……こっちに　こい！"
    },
    {
      "index": 12,
      "id": "msg_main8000_shortpants_02",
      "hash": "f371c8fe6a94e4ca",
      "flags": 0,
      "text": "かてる　じしんが　あるなら\\nタケシと　たたかって　みなよ！"
    },
    {
      "index": 13,
      "id": "msg_main8000_shortpants_03",
      "hash": "f371c9fe6a94e67d",
      "flags": 0,
      "text": "お　それは　グレーバッジ！\\nタケシに　もらったんだな\\c\\nもってる　バッジの　かずが　ふえると\\nショップで　かえるもの　ふえるぜ！"
    },
    {
      "index": 14,
      "id": "msg_main8000_shortpants_04",
      "hash": "f371c2fe6a94da98",
      "flags": 0,
      "text": "ちなみに　ショップは\\nあの　あお～い　たてもの！"
    },
    {
      "index": 15,
      "id": "msg_main8000_shortpants_05",
      "hash": "f371c3fe6a94dc4b",
      "flags": 0,
      "text": "いろんな　まちに　あるから\\nもう　しってる　よな！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_8000_max",
      "hash": "830692b4aa69baa7"
    }
  ]
}
