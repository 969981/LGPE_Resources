  "lines": [
    {
      "index": 0,
      "id": "msg_main0170_green_01",
      "hash": "45c432aa3fa8d7dc",
      "flags": 0,
      "text": "？？？『なー　そこの　やつ！"
    },
    {
      "index": 1,
      "id": "msg_main0170_green_02",
      "hash": "45c435aa3fa8dcf5",
      "flags": 0,
      "text": "？？？『おまえってさ　もしかして\\n[VAR TRNAME(0000)]　って　やつだろ！"
    },
    {
      "index": 2,
      "id": "msg_main0170_select_01",
      "hash": "d0d9c0d403d03387",
      "flags": 0,
      "text": "すごい！　そうです"
    },
    {
      "index": 3,
      "id": "msg_main0170_select_02",
      "hash": "d0d9c1d403d0353a",
      "flags": 0,
      "text": "えっ　どうして！？"
    },
    {
      "index": 4,
      "id": "msg_main0170_green_03",
      "hash": "45c434aa3fa8db42",
      "flags": 0,
      "text": "やっぱりな！\\nさすが　おれさま！"
    },
    {
      "index": 5,
      "id": "msg_main0170_green_04",
      "hash": "45c42faa3fa8d2c3",
      "flags": 0,
      "text": "じいさんが　いってた　とくちょう\\nピッタシ　だったからな！"
    },
    {
      "index": 6,
      "id": "msg_main0170_green_05",
      "hash": "45c42eaa3fa8d110",
      "flags": 0,
      "text": "グリーン『おれは　グリーン！\\c\\nおれと　おなじ　マサラタウンから\\nトレーナーが　たびだった　って\\r\\nオーキドの　じいさんに　きいてさ\\c\\nさっそく　みに　きたって　わけ！"
    },
    {
      "index": 7,
      "id": "msg_main0170_green_06",
      "hash": "45c431aa3fa8d629",
      "flags": 0,
      "text": "しっかし　さいきょうの　おれが\\nアドバイスを　やろーと　おもったのに\\r\\nもう　おわっちまって　いたとはな"
    },
    {
      "index": 8,
      "id": "msg_main0170_green_11",
      "hash": "45c0aeaa3fa5c1b9",
      "flags": 0,
      "text": "なかなか　みどころ　あるじゃん！\\nこれ　ごほうび　だぜ！"
    },
    {
      "index": 9,
      "id": "msg_main0170_red_01",
      "hash": "cfe03f2037f8e3dc",
      "flags": 0,
      "text": "[~ 9]"
    },
    {
      "index": 10,
      "id": "msg_main0170_green_07",
      "hash": "45c430aa3fa8d476",
      "flags": 0,
      "text": "[~ 10]"
    },
    {
      "index": 11,
      "id": "msg_main0170_red_02",
      "hash": "cfe0422037f8e8f5",
      "flags": 0,
      "text": "[~ 11]"
    },
    {
      "index": 12,
      "id": "msg_main0170_dummy_01",
      "hash": "ad78127e34c878c1",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　グリーン　から\\n[VAR COLOR(0006)]スーパーボール[VAR COLOR(0000)]を　５こ　もらった！"
    },
    {
      "index": 13,
      "id": "msg_main0170_green_08",
      "hash": "45c43baa3fa8e727",
      "flags": 0,
      "text": "グリーン『モンスターボール　より\\nつかまえやすい　ボール　だぜ！\\c\\n……なー　ところで　それ\\nポケモンずかん　だろ？\\r\\nじいさん　ついに　つくったんだな！"
    },
    {
      "index": 14,
      "id": "msg_main0170_green_09",
      "hash": "45c43aaa3fa8e574",
      "flags": 0,
      "text": "おれのときは　ちずに　えんぴつで\\nぶんぷ　かきこんでた　からな……"
    },
    {
      "index": 15,
      "id": "msg_main0170_green_10",
      "hash": "45c0adaa3fa5c006",
      "flags": 0,
      "text": "せいぜい　オーキドの　じいさんに\\nきょうりょく　して　やってくれい！\\r\\nそいじゃー　またな！"
    }
  ],
