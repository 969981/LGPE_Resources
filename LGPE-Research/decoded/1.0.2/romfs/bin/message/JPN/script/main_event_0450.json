{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main_0450_water_01",
      "hash": "7439386f7b29a278",
      "flags": 0,
      "text": "カスミ『あら　きみ！"
    },
    {
      "index": 1,
      "id": "msg_main_0450_water_02",
      "hash": "74393b6f7b29a791",
      "flags": 0,
      "text": "へー！　マチスさんに\\nかっちゃう　なんて　すごいね！\\c\\nじゅんちょう　じゅんちょう！\\nはーい　おつかれ！"
    },
    {
      "index": 2,
      "id": "msg_main_0450_sys_01",
      "hash": "b2b280679438be5e",
      "flags": 0,
      "text": "カスミが　ポケモンを\\nげんきに　して　くれた！"
    },
    {
      "index": 3,
      "id": "msg_main_0450_sys_02",
      "hash": "b2b27f679438bcab",
      "flags": 0,
      "text": "カスミが　ポケモンたちを\\nげんきに　して　くれた！"
    },
    {
      "index": 4,
      "id": "msg_main_0450_water_03",
      "hash": "74393a6f7b29a5de",
      "flags": 0,
      "text": "カスミ『……え　わたし？\\nかいすいよく　よ\\c\\nせまい　プールから　とびだして\\nひろーい　うみで\\r\\nおよぎたい　ときも　あるの！"
    },
    {
      "index": 5,
      "id": "msg_main_0450_water_04",
      "hash": "74393d6f7b29aaf7",
      "flags": 0,
      "text": "カスミ『これから　どこ　いくの？\\c\\nこの　ちかくの\\nディグダのあな　って　いった？\\c\\nまだ　だったら\\nつれてって　あげようか？"
    },
    {
      "index": 6,
      "id": "msg_main_0450_water_05",
      "hash": "74393c6f7b29a944",
      "flags": 0,
      "text": "あら　せっかくの\\nさそいを　ことわる　なんて"
    },
    {
      "index": 7,
      "id": "msg_main_0450_water_06",
      "hash": "74393f6f7b29ae5d",
      "flags": 0,
      "text": "いいわよ　いきましょ！"
    },
    {
      "index": 8,
      "id": "msg_main_0450_water_07",
      "hash": "74393e6f7b29acaa",
      "flags": 0,
      "text": "カスミ『ここが\\nディグダのあな　よ！\\c\\nディグダが　ほりすすんで\\nできた　あななの！\\c\\nじゃあね！\\nいろんな　ポケモンと　であってね"
    },
    {
      "index": 9,
      "id": "msg_main_0450_water_08",
      "hash": "7439316f7b299693",
      "flags": 0,
      "text": "[~ 9]"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0450_max",
