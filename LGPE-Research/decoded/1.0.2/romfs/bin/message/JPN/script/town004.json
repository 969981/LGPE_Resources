{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_town004_kanban_01",
      "hash": "b51317a8f3060e71",
      "flags": 0,
      "text": "ここは　ハナダシティ\\nハナダは　みずいろ　しんぴのいろ"
    },
    {
      "index": 1,
      "id": "msg_town004_kanban_02",
      "hash": "b51314a8f3060958",
      "flags": 0,
      "text": "……おとくな　けいじばん！\\c\\nしんかの　さいちゅうに\\nＢボタンを　おすと\\r\\nしんかは　とまって　しまいます"
    },
    {
      "index": 2,
      "id": "msg_town004_kanban_03",
      "hash": "b51315a8f3060b0b",
      "flags": 0,
      "text": "じてんしゃマニアの　いえ"
    },
    {
      "index": 3,
      "id": "msg_town004_kanban_04",
      "hash": "b5131aa8f306138a",
      "flags": 0,
      "text": "ハナダシティ　ポケモンジム\\nリーダー　カスミ\\r\\nおてんば　にんぎょ"
    },
    {
      "index": 4,
      "id": "msg_town004_adultm_01",
      "hash": "974467edc6eb5151",
      "flags": 0,
      "text": "きみも　ポケモン　やってるか！\\nあつめたり　たたかったり\\r\\nいろいろ　たいへん　だな！"
    },
    {
      "index": 5,
      "id": "msg_town004_youngm_01_01",
      "hash": "39c978ef1accc119",
      "flags": 0,
      "text": "ショップの　まえに　きが　はえてて\\nむこうへ　いけないんだ\\c\\nでも　どこか　まわりみち　すると\\nいける　らしい　けど……"
    },
    {
      "index": 6,
      "id": "msg_boya1_01_p02_field_t004",
      "hash": "6dbca59f00f65f78",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_town004_middlem_01",
      "hash": "3a702dc61ba863a4",
      "flags": 0,
      "text": "ほほう……！\\nポケモンの　ずかんを　つくってる？\\r\\nそれは　たのしそう　だなあ！"
    },
    {
      "index": 8,
      "id": "msg_town004_policef_01",
      "hash": "eedfa2d161c67198",
      "flags": 0,
      "text": "この　いえは\\nドロボーに　はいられたの！\\c\\nもくげきしゃに　よると\\nはんにんは……　ロケットだん！\\c\\nひがいしゃを　まもるため\\nしばらく　この　いえ　には\\r\\nコラッタ　１ぴき　はいらせません！"
    },
    {
      "index": 9,
      "id": "msg_town004_youngf_01_01",
      "hash": "89c3f2c67ed7bf0c",
      "flags": 0,
      "text": "さあ　マルマイン！\\nソニックブーム　よ！\\c\\n……まる　ってば\\nわたしの　いうこと　きいて！"
    },
    {
      "index": 10,
      "id": "msg_town004_youngf_01_02",
      "hash": "89c3f5c67ed7c425",
      "flags": 0,
      "text": "マルマイン！　そこで　たいあたりっ！\\n……がっくし　また　ダメ！"
    },
    {
      "index": 11,
      "id": "msg_town004_youngf_01_03",
      "hash": "89c3f4c67ed7c272",
      "flags": 0,
      "text": "マルマイン！　スピードスター！\\nあん　……ちがーう！\\r\\nポケモンって　むずかしいわ！\\c\\nポケモンが\\nいうこと　きくか　どうかは\\r\\nひとの　うでまえ　しだい　なんだもの"
    },
    {
      "index": 12,
      "id": "msg_town004_poke_01_01",
      "hash": "bbf3f6e0c799a43b",
      "flags": 0,
      "text": "マルマインは　ひるね　してる……"
    },
    {
      "index": 13,
      "id": "msg_town004_poke_01_02",
      "hash": "bbf3f7e0c799a5ee",
      "flags": 0,
      "text": "マルマインは　なまけてる……"
    },
    {
      "index": 14,
      "id": "msg_town004_poke_01_03",
      "hash": "bbf3f8e0c799a7a1",
      "flags": 0,
      "text": "マルマインは　そっぽを　むいた！"
    },
    {
      "index": 15,
      "id": "msg_town004_poke_01_04",
      "hash": "bbf3f9e0c799a954",
      "flags": 0,
      "text": "マルマインは　しらんぷり　した……"
    },
    {
      "index": 16,
      "id": "msg_town004_childf_01",
      "hash": "0333cfa13f0b2060",
      "flags": 0,
      "text": "そこの　いえの　おにいちゃん\\c\\nせかい　じゅうの\\nじてんしゃを　あつめてる　って！"
    },
    {
      "index": 17,
      "id": "msg_trainerm1_01_p01_field_t004",
      "hash": "424b20fd31d344f4",
      "flags": 0,
      "text": "ここは……　ハナダのどうくつ！\\nこわい　ほど　つよい　ポケモンが\\r\\nせいそく　してるぞ！\\c\\nポケモンリーグ　にんてい\\nチャンピオン　しか　はいれないのだ！"
    },
    {
      "index": 18,
      "id": "msg_town004_fat_01",
      "hash": "9b47f4cb990902d1",
      "flags": 0,
      "text": "[~ 18]"
    },
    {
      "index": 19,
      "id": "msg_town004_poke_02_01",
      "hash": "1259bee863036144",
      "flags": 0,
      "text": "[~ 19]"
    },
    {
      "index": 20,
      "id": "msg_town004_miniskirt_01",
      "hash": "a554ab1074d15de6",
      "flags": 0,
      "text": "[~ 20]"
    },
