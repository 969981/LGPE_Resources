      "hash": "8c41b02e955db9a0",
      "flags": 0,
      "text": "……　……　……"
    },
    {
      "index": 78,
      "id": "msg_m_red_13",
      "hash": "8c41b12e955dbb53",
      "flags": 0,
      "text": "レッドは　さって　いった"
    },
    {
      "index": 79,
      "id": "msg_m_gf_01",
      "hash": "042959ce26c8a428",
      "flags": 0,
      "text": "よく　きたね！\\nポケモントレーナー！\\c\\nまだ　わからないと　おもうけど\\nとおりなを　てにいれたら\\r\\nまたおいで"
    },
    {
      "index": 80,
      "id": "msg_m_gf_02",
      "hash": "04295cce26c8a941",
      "flags": 0,
      "text": "よく　きたね！\\n[VAR TRCLASS(0002)]！\\c\\nそれとも　ちがう　とおりなで\\nよんで　ほしい？"
    },
    {
      "index": 81,
      "id": "msg_m_gf_03",
      "hash": "04295bce26c8a78e",
      "flags": 0,
      "text": "……まってたよ！\\n[VAR TRCLASS(0002)]！\\c\\nあなたの　つよさは\\nとんでもない　みたいね！\\c\\nいま　あなたの　つよさを\\nあらわす　ことばは\\r\\nポケモンの　かずほど　あるからね！\\c\\nこれからは　あなたを\\nグランドマスターと　よびましょう！"
    },
    {
      "index": 82,
      "id": "msg_m_gf_04",
      "hash": "04295ece26c8aca7",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は\\n[VAR COLOR(0006)]グランドマスター[VAR COLOR(0000)]と　みとめられた！"
    },
    {
      "index": 83,
      "id": "msg_m_gf_05",
      "hash": "04295dce26c8aaf4",
      "flags": 0,
      "text": "よっ　[VAR TRCLASS(0002)]！\\nあなたに　ふさわしいね！"
    },
    {
      "index": 84,
      "id": "msg_select_01",
      "hash": "bc5f57e86a2ac0fb",
      "flags": 0,
      "text": "[VAR TRCLASS(0002)]"
    },
    {
      "index": 85,
      "id": "msg_select_02",
      "hash": "bc5f58e86a2ac2ae",
      "flags": 0,
      "text": "どの　とおりなで　よばれたい？"
    },
    {
      "index": 86,
      "id": "msg_select_03",
      "hash": "bc5f59e86a2ac461",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 87,
      "id": "msg_m_gf_06",
      "hash": "042960ce26c8b00d",
      "flags": 0,
      "text": "やめるの？　いまの　とおりな\\nきに　いってるんだね！"
    }
  ],
