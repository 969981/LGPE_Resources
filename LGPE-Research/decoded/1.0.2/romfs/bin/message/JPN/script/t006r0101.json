    {
      "index": 0,
      "id": "msg_t006r0101_fat_01_01",
      "hash": "16a1c4266049649d",
      "flags": 0,
      "text": "みてよ！　うちの　ピカチュウ\\nなんて　かわいい　しっぽ！"
    },
    {
      "index": 1,
      "id": "msg_t006r0101_fat_01_02",
      "hash": "16a1c12660495f84",
      "flags": 0,
      "text": "なにを！\\c\\nうちの　ピカチュウの　ほうが\\nその　ばいは　かわいい　わい！"
    },
    {
      "index": 2,
      "id": "msg_t006r0101_youngf_01_01",
      "hash": "0ee506a6250d159c",
      "flags": 0,
      "text": "あたしの　いとしい　パウワウ！\\c\\nだきしめると\\nきゅー！　って　なくのよ！"
    },
    {
      "index": 3,
      "id": "msg_t006r0101_youngf_01_02",
      "hash": "0ee509a6250d1ab5",
      "flags": 0,
      "text": "おほほ！\\c\\nあたしの　パウワウの　ほうが\\nその　ばいは　かわいいわよ！"
    },
    {
      "index": 4,
      "id": "msg_t006r0101_poke_01",
      "hash": "92f57942219c9e77",
      "flags": 0,
      "text": "ピカチュウ『ちゅー　ぴかちゅ"
    },
    {
      "index": 5,
      "id": "msg_t006r0101_poke_02",
      "hash": "92f57a42219ca02a",
      "flags": 0,
      "text": "パウワウ『きゅー"
    },
    {
      "index": 6,
      "id": "msg_t006r0101_stafff_01",
      "hash": "eeb3cbaafce30758",
      "flags": 0,
      "text": "うちの　かいちょうは\\nホント　ポケモンに　うるさいの！"
    },
    {
      "index": 7,
      "id": "msg_t006r0101_poster_01",
      "hash": "26d385ca9600a6a3",
      "flags": 0,
      "text": "かいぬしの　じまん　ばなしには\\nしずかに　みみを　かたむけよう！"
    },
    {
      "index": 8,
      "id": "msg_t006r0101_poster_02",
      "hash": "26d386ca9600a856",
      "flags": 0,
      "text": "ひとの　じまん　ばなしは\\n１０ばい　にして　かえそう！"
    },
    {
      "index": 9,
      "id": "msg_t006r0101_poster_03",
      "hash": "26d387ca9600aa09",
      "flags": 0,
      "text": "わしの　かわいい　ギャロップ"
    },
    {
      "index": 10,
      "id": "msg_t006r0101_poster_04",
      "hash": "26d388ca9600abbc",
      "flags": 0,
      "text": "わしの　いとしい　オニドリル"
    },
    {
      "index": 11,
      "id": "msg_t006r0101_poster_05",
      "hash": "26d389ca9600ad6f",
      "flags": 0,
      "text": "かわいい　ポケモンたちと　わし"
