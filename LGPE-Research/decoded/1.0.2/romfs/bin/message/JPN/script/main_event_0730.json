{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0730_rocketchief_01",
      "hash": "9e258dee4a30c3a0",
      "flags": 0,
      "text": "？？？『……この　シルフスコープ\\nひとつを　みても……"
    },
    {
      "index": 1,
      "id": "msg_main0730_rocketchief_02",
      "hash": "9e2590ee4a30c8b9",
      "flags": 0,
      "text": "シルフカンパニー　には\\nわれわれ　ロケットだんの\\r\\nきぼうを　かなえるに　ふさわしい\\r\\nかいはつ　りょくが　あると　いえます"
    },
    {
      "index": 2,
      "id": "msg_main0730_rocketboss_01",
      "hash": "e707943c02420ee2",
      "flags": 0,
      "text": "？？？『ふん……！\\nみえぬものを　みせる　キカイか\\c\\nくだらん　おもちゃ　だな\\nだが……"
    },
    {
      "index": 3,
      "id": "msg_main0730_rocketboss_02",
      "hash": "e707933c02420d2f",
      "flags": 0,
      "text": "いいだろう\\c\\nシルフカンパニー　のっとりを\\nこのまま　すすめろ　アポロ"
    },
    {
      "index": 4,
      "id": "msg_main0730_rocketchief_03",
      "hash": "9e258fee4a30c706",
      "flags": 0,
      "text": "？？？『はっ……！"
    },
    {
      "index": 5,
      "id": "msg_main0730_rocketchief_04",
      "hash": "9e2592ee4a30cc1f",
      "flags": 0,
      "text": "なぜ　こんな　ところに\\nこどもが　いるのですか？"
    },
    {
      "index": 6,
      "id": "msg_main0730_rocketchief_05",
      "hash": "9e2591ee4a30ca6c",
      "flags": 0,
      "text": "いまの　はなしを\\nだまって　きいて　いたとは\\r\\nきに　いりませんね"
    },
    {
      "index": 7,
      "id": "msg_main0730_rocketchief_06",
      "hash": "9e2594ee4a30cf85",
      "flags": 0,
      "text": "……わたしは　ロケットだん\\nかんぶの　アポロ\\c\\nわたしは　こども　でも\\nてかげん　しませんよ！"
    },
    {
      "index": 8,
      "id": "msg_main0730_dummy_01",
      "hash": "667ff12551a51f6b",
      "flags": 0,
      "text": "[~ 8]"
    },
    {
      "index": 9,
      "id": "msg_main0730_rocketchief_07",
      "hash": "9e2593ee4a30cdd2",
      "flags": 0,
      "text": "アポロ『さ　サカキさま\\nおゆるしください\\r\\nわたしとも　あろう　ものが……"
    }
  ],
