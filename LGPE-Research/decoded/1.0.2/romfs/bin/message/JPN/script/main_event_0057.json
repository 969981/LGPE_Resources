  "lines": [
    {
      "index": 0,
      "id": "msg_main0057_mother_01",
      "hash": "9afa4a3aa9c825e6",
      "flags": 0,
      "text": "おかあさん『わあ　かわいい！\\nはかせに　いただいたのね！"
    },
    {
      "index": 1,
      "id": "msg_main0057_mother_02",
      "hash": "9afa493aa9c82433",
      "flags": 0,
      "text": "……えーっ！\\nじぶんで　つかまえたの？\\c\\nすごい　じゃない！\\nなんて　よべば　いいの？\\c\\n……そう！\\n[VAR PKNICK(0003)]　ちゃん　ね！"
    },
    {
      "index": 2,
      "id": "msg_main0057_poke_01",
      "hash": "57ee1af82b92f090",
      "flags": 0,
      "text": "ピッカチュウ～！"
    },
    {
      "index": 3,
      "id": "msg_main0057_poke_02",
      "hash": "57ee1df82b92f5a9",
      "flags": 0,
      "text": "イーブイ～！"
    },
    {
      "index": 4,
      "id": "msg_main0057_mother_03",
      "hash": "9afa483aa9c82280",
      "flags": 0,
      "text": "おかあさん『わあ　すっごく　げんき！"
    },
    {
      "index": 5,
      "id": "msg_main0057_mother_05",
      "hash": "9afa4e3aa9c82cb2",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]たち　これから\\nぼうけんに　でかけるのよね\\c\\nこんな　ひが　くると　おもって\\nようい　して　おいたの"
    },
    {
      "index": 6,
      "id": "msg_main0057_sys_01",
      "hash": "f7649187e2f0b6be",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　おかあさん　から\\n[VAR COLOR(0006)]タウンマップ[VAR COLOR(0000)]を　もらった！"
    },
    {
      "index": 7,
      "id": "msg_main0057_sys_02",
      "hash": "f7649087e2f0b50b",
      "flags": 0,
      "text": "[~ 7]"
    },
    {
      "index": 8,
      "id": "msg_main0057_mother_04",
      "hash": "9afa4f3aa9c82e65",
      "flags": 0,
      "text": "バッグの　タウンマップを　みれば\\nじぶんの　いるばしょが　わかるからね\\c\\nそれじゃあ　いってらっしゃい！\\n[VAR TRNAME(0000)]！　[VAR PKNICK(0003)]ちゃん！"
    }
  ],
