{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t006gym01_gym_01",
      "hash": "2e794eb10bfeff6b",
      "flags": 0,
      "text": "まってたぜ\\nみらいの　チャンピオン！\\c\\nジムリーダー　マチスしょうさは\\nでんきタイプの　ポケモンを\\r\\nつかいこなす　タフガイだ！\\c\\nひこうタイプ　みずタイプは\\nあいしょうが　わるいぜ！\\c\\nマヒ　させられないよう\\nきを　つけな！\\c\\nそれと　マチスは　ようじんぶかい！\\nかんたんには　ちかづけ　ないぜ！"
    },
    {
      "index": 1,
      "id": "msg_t006gym01_gym_02",
      "hash": "2e794fb10bff011e",
      "flags": 0,
      "text": "ふー！\\c\\nめも　くらむ　ような\\nマブシイ　たたかい　だったぜ！"
    },
    {
      "index": 2,
      "id": "msg_t006gym01_statue_01",
      "hash": "dd9408e725ee8ef6",
      "flags": 0,
      "text": "クチバ　ポケモンジム\\nマチス　にんてい　トレーナー！\\r\\n[VAR TRNAME(0001)]"
    },
    {
      "index": 3,
      "id": "msg_t006gym01_statue_02",
      "hash": "dd9407e725ee8d43",
      "flags": 0,
      "text": "クチバ　ポケモンジム\\nマチス　にんてい　トレーナー！\\r\\n[VAR TRNAME(0001)]　[VAR TRNAME(0000)]"
    },
    {
      "index": 4,
      "id": "msg_t006gym01_gomi_01",
      "hash": "c6622a2b2c72f4ce",
      "flags": 0,
      "text": "ガサゴソ……！\\nなかは　ゴミ　ばっかり！"
    },
    {
      "index": 5,
      "id": "msg_t006gym01_gomi_02",
      "hash": "c662292b2c72f31b",
      "flags": 0,
      "text": "ガサゴソ……！\\nおっと！　ゴミばこの　そこに\\r\\nスイッチが　あった！\\c\\nおして　みよう！　……ポチッとな"
    },
    {
      "index": 6,
      "id": "msg_t006gym01_gomi_05",
      "hash": "c6622e2b2c72fb9a",
      "flags": 0,
      "text": "でんげきバリアの\\nだい１　ロックが　はずれた！"
    },
    {
      "index": 7,
      "id": "msg_t006gym01_gomi_03",
      "hash": "c662282b2c72f168",
      "flags": 0,
      "text": "でんげきバリアの\\nだい２　ロックが　はずれた！\\c\\nでんげきバリアが\\nかんぜんに　かいじょ　された！"
    },
    {
      "index": 8,
      "id": "msg_t006gym01_gomi_04",
      "hash": "c6622f2b2c72fd4d",
      "flags": 0,
      "text": "あッ！　でんげきバリアの\\nロックが　もどって　しまった！"
    },
    {
      "index": 9,
      "id": "msg_t006gym01_gomi_06",
      "hash": "c6622d2b2c72f9e7",
      "flags": 0,
      "text": "あかい　ゴミばこ　だ！"
    },
    {
      "index": 10,
      "id": "msg_t006gym01_gomi_07",
      "hash": "c6622c2b2c72f834",
      "flags": 0,
      "text": "あおい　ゴミばこ　だ！"
    },
    {
      "index": 11,
      "id": "msg_t006gym01_gomi_08",
      "hash": "c662232b2c72e8e9",
      "flags": 0,
      "text": "この　ゴミばこの　スイッチは\\nすでに　おしてある"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t006gym01_max",
      "hash": "570f91d7e55a12b2"
