  "lines": [
    {
      "index": 0,
      "id": "msg_sub037_adultf_01",
      "hash": "0754a41f7a189db8",
      "flags": 0,
      "text": "わたしは　ここで　きずついた\\nポケモンたちの　せわを　しています"
    },
    {
      "index": 1,
      "id": "msg_sub037_adultf_02",
      "hash": "0754a71f7a18a2d1",
      "flags": 0,
      "text": "フシギダネも　すっかり\\nげんきに　なったし\\c\\nポケモンを　いっぱい　つかまえてる\\nたよれる　トレーナーさんに\\r\\nこの　こ　を　あずけたいのだけど……"
    },
    {
      "index": 2,
      "id": "msg_sub037_adultf_08",
      "hash": "07549d1f7a1891d3",
      "flags": 0,
      "text": "いままで　あなたが　ポケモンを\\nつかまえた　かずは\\r\\n[VAR NUM9(0000,0000)]……！？"
    },
    {
      "index": 3,
      "id": "msg_sub037_adultf_03",
      "hash": "0754a61f7a18a11e",
      "flags": 0,
      "text": "すごいわ！　あなた　フシギダネの\\nめんどうを　みてくださらない？"
    },
    {
      "index": 4,
      "id": "msg_sub037_adultf_04",
      "hash": "0754a91f7a18a637",
      "flags": 0,
      "text": "それじゃ　おねがいします！"
    },
    {
      "index": 5,
      "id": "msg_sub037_adultf_09",
      "hash": "07549c1f7a189020",
      "flags": 0,
      "text": "うーん　[VAR NUM2(0000)]ひき　くらい\\nポケモン　つかまえたら\\r\\nまた　来てくださる？"
    },
    {
      "index": 6,
      "id": "msg_sub037_adultf_05",
      "hash": "0754a81f7a18a484",
      "flags": 0,
      "text": "フシギダネ　がんばってます？"
    },
    {
      "index": 7,
      "id": "msg_sub037_adultf_06",
      "hash": "0754ab1f7a18a99d",
      "flags": 0,
      "text": "そう……\\nざんねん　です……"
    },
    {
