{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_town007_kanban_01",
      "hash": "9a3ecb01b0f56af4",
      "flags": 0,
      "text": "ここは　タマムシシティ\\nタマムシ　にじいろ　ゆめの　いろ"
    },
    {
      "index": 1,
      "id": "msg_town007_kanban_02",
      "hash": "9a3ece01b0f5700d",
      "flags": 0,
      "text": "タマムシシティ　ポケモンジム\\nリーダー　エリカ\\r\\nしぜんを　あいする　おじょうさま！"
    },
    {
      "index": 2,
      "id": "msg_town007_kanban_03",
      "hash": "9a3ecd01b0f56e5a",
      "flags": 0,
      "text": "タマムシ　マンション"
    },
    {
      "index": 3,
      "id": "msg_town007_kanban_04",
      "hash": "9a3ec801b0f565db",
      "flags": 0,
      "text": "ほしいもの　きっと　みつかる！\\nタマムシデパート"
    },
    {
      "index": 4,
      "id": "msg_town007_kanban_05",
      "hash": "9a3ec701b0f56428",
      "flags": 0,
      "text": "……おとくな　けいじばん！\\c\\nヨクアタールは　わざの\\nめいちゅうりつを　あげる！\\c\\nクリティカットは　わざが\\nきゅうしょに　あたりやすく　なる！\\c\\nどうぐの　おかいもとめは\\nタマムシデパートで　どうぞ！"
    },
    {
      "index": 5,
      "id": "msg_town007_kanban_06",
      "hash": "9a3eca01b0f56941",
      "flags": 0,
      "text": "……おとくな　けいじばん！\\c\\nエフェクトガードは\\nせんとうちゅうに　つかうと\\r\\nみかたの　ポケモンの　のうりょくを\\r\\nさげられずに　すみます！\\c\\nどうぐの　おかいもとめは\\nタマムシデパートで　どうぞ！"
    },
    {
      "index": 6,
      "id": "msg_town007_kanban_07",
      "hash": "9a3ec901b0f5678e",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_town007_kanban_08",
      "hash": "9a3ec401b0f55f0f",
      "flags": 0,
      "text": "おとなと　こどもの　あそびば！\\n……ロケット　ゲームコーナー"
    },
    {
      "index": 8,
      "id": "msg_town007_juveniles_01_01",
      "hash": "38764195c5a0f2f0",
      "flags": 0,
      "text": "わたしの　ドガース！\\nさいこうな　あいぼう　なの！\\r\\nおこると　どくガス　はくけど……\\c\\nふだんは　いいこ　なのよ"
    },
    {
      "index": 9,
      "id": "msg_town007_oldm_01_01",
      "hash": "5cc71374ccf832e5",
      "flags": 0,
      "text": "にひひ！　この　ジムは　ええ！\\nおんなのこ　ばっかし　じゃ！"
    },
    {
      "index": 10,
      "id": "msg_town007_middlef_01_01",
      "hash": "271ec648f1319b5a",
      "flags": 0,
      "text": "きれいな　まちづくりが\\nじまんの　タマムシ　だけど\\c\\nゲームコーナーの　あたりは\\nちょっと　こわいわ"
    },
    {
      "index": 11,
      "id": "msg_town007_middlem_01_01",
      "hash": "c8ff84a05cffb7cb",
      "flags": 0,
      "text": "トホホ……！\\nゲームコーナーで　また　まけた！\\c\\nつよい　ひとは　ぼく　いじょうに\\nどりょく　してるん　だろうなぁ"
    },
    {
      "index": 12,
      "id": "msg_town007_fat_01_01",
      "hash": "441e03c296223074",
      "flags": 0,
      "text": "こいつ　おれの　あいかた！\\nニョロボン！\\c\\nみずのいしを　あてたら\\nニョロゾが　しんか　したよ"
    },
    {
      "index": 13,
      "id": "msg_town007_poke_01_01",
      "hash": "92ff2c901b51d914",
      "flags": 0,
      "text": "ニョロボン『ゲロゲーロ！"
    },
    {
      "index": 14,
      "id": "msg_town007_rocketm_01_01",
      "hash": "8ee9697af7b49d18",
      "flags": 0,
      "text": "なんだ　ジロジロ　みやがって！\\nあっち　いかねえと　ぶんなぐるぞ！"
    },
    {
      "index": 15,
      "id": "msg_town007_rocketm_02_01",
      "hash": "373da1735b361d6f",
      "flags": 0,
      "text": "めの　まえを　チョロチョロうるせえ！\\nロケットだんを　なめるなよ！"
    },
    {
      "index": 16,
      "id": "msg_town007_miniskirt_01",
      "hash": "3d1e117b1597db85",
      "flags": 0,
      "text": "うちの　プリンの\\nせいかくは　いじっぱり！\\c\\nこうげきが　そだち　やすくて\\nとくこうが　あがり　にくいの！\\r\\nおうふくビンタ　じゃ　まけないわ"
    },
    {
      "index": 17,
      "id": "msg_town007_poke_02_01",
      "hash": "66f82489b9e7c6cb",
      "flags": 0,
      "text": "プリン『ぷん　ぷん！"
    },
    {
      "index": 18,
      "id": "msg_town007_poke_03_01",
      "hash": "bbd5587faa7f86f6",
      "flags": 0,
      "text": "ドガース『モックリ……"
    },
    {
      "index": 19,
      "id": "msg_town007_sora_01",
      "hash": "819a71319573b638",
      "flags": 0,
      "text": "ふうせんが　いっぱい　ついた\\nフシギな　のりものだ！"
    },
    {
      "index": 20,
      "id": "msg_town007_oldf_01",
      "hash": "4a69bfd7bf5f181e",
      "flags": 0,
      "text": "さあさあ\\nしょくどうに　いきましょう　ねえ"
    },
    {
      "index": 21,
      "id": "msg_town007_youngm_01",
      "hash": "50cc5272810a9538",
      "flags": 0,
      "text": "おばーちゃん\\nおなか　すいたー！"
    },
    {
      "index": 22,
      "id": "msg_town007_girlscout_01",
      "hash": "3493796577e5bef3",
      "flags": 0,
      "text": "あら？　こっからは\\nジムに　いけない？"
    },
    {
      "index": 23,
      "id": "msg_town007_poke_04",
      "hash": "516892e0e49ec8b1",
      "flags": 0,
      "text": "コラッタ『ガジガジ！"
    },
    {
      "index": 24,
      "id": "msg_town007_poke_05",
      "hash": "516891e0e49ec6fe",
      "flags": 0,
      "text": "クサイハナ『だらり……"
    },
    {
      "index": 25,
      "id": "msg_town007_adultf_01",
      "hash": "07a90a3e580f25e3",
      "flags": 0,
      "text": "ポケモンの　アクセサリー\\nつくって　うってるの！\\c\\nデパートの　５かい　よ！\\nよかったら　よってってネ！"
    },
    {
      "index": 26,
      "id": "msg_boy2_01_p01_field_t007",
      "hash": "f454b87ff0024614",
      "flags": 0,
      "text": "[~ 26]"
    },
