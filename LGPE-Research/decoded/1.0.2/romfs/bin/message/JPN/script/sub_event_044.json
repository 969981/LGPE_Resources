{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub044_rocketchief_01",
      "hash": "97d6c0218d7a5e3f",
      "flags": 0,
      "text": "アポロ『おまえは……"
    },
    {
      "index": 1,
      "id": "msg_sub044_rocketchief_02",
      "hash": "97d6c1218d7a5ff2",
      "flags": 0,
      "text": "いまさら\\nこんな　ところ　まで\\r\\nなにを　しに　きたのですか\\c\\nおまえの　せいで\\nロケットだんは……\\r\\nかいさん　したのですよ"
    },
    {
      "index": 2,
      "id": "msg_sub044_rocketchief_03",
      "hash": "97d6c2218d7a61a5",
      "flags": 0,
      "text": "かんじょう　てきな　ふるまいは\\nわたしに　ふさわしく　ないが\\c\\nすこしは　きもちを\\nうけとめて　いただき　ましょうか！"
    },
    {
      "index": 3,
      "id": "msg_sub044_rocketchief_04",
      "hash": "97d6bb218d7a55c0",
      "flags": 0,
      "text": "……　……　……\\c\\nまあ　いい"
    },
    {
      "index": 4,
      "id": "msg_sub044_rocketchief_05",
      "hash": "97d6bc218d7a5773",
      "flags": 0,
      "text": "ほんとうは……\\c\\nなんとなく　おまえが　ここに\\nくるのでは　ないかと　おもい……\\c\\nちょうど　おきてがみを\\nかいて　いたのです"
    },
    {
      "index": 5,
      "id": "msg_sub044_rocketchief_09",
      "hash": "97d6c8218d7a6bd7",
      "flags": 0,
      "text": "よみましょう"
    },
    {
      "index": 6,
      "id": "msg_sub044_rocketchief_06",
      "hash": "97d6bd218d7a5926",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]　さん\\c\\nこのたびは　ポケモンリーグ\\nせいは　おめでとう　ございます\\c\\nロケットだんへの　しうちを\\nうらんでは　おりません\\c\\nむしろ　これを　ばねに\\nわたしは　さらに　つよい\\r\\nロケットだんを　つくり\\r\\nいつか　ぜんこくに　むけて\\r\\nふっかつ　せんげんを　します\\c\\nわたしは　カントーちほうを\\nはなれますが\\r\\nあなたは　いつまでも\\r\\nここで　ごかつやく　ください\\c\\nさらばです\\n　　　　　　　　　　アポロ"
    },
    {
      "index": 7,
      "id": "msg_sub044_rocketchief_07",
      "hash": "97d6be218d7a5ad9",
      "flags": 0,
      "text": "アポロ『こんな　ものを　かいて\\nおまえに　どう　おもって\\r\\nもらいたかった　のか……\\r\\nフフ……"
    },
    {
      "index": 8,
      "id": "msg_sub044_system_01",
      "hash": "9119a07e78e55947",
      "flags": 0,
      "text": "アポロは　おきてがみを\\nやぶいて　しまった"
    },
    {
      "index": 9,
      "id": "msg_sub044_rocketchief_08",
      "hash": "97d6c7218d7a6a24",
      "flags": 0,
      "text": "……おげんきで"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_044_max",
      "hash": "cc9ba4ed5e08b8e2"
    }
  ]
}
