{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub020_sys_01",
      "hash": "61867d565a832009",
      "flags": 0,
      "text": "ポケモンが　とても\\nきもち　よさそうに　ねています"
    },
    {
      "index": 1,
      "id": "msg_sub020_sys_02",
      "hash": "61867a565a831af0",
      "flags": 0,
      "text": "ポケモンのふえを　つかいますか？"
    },
    {
      "index": 2,
      "id": "msg_sub020_sys_03",
      "hash": "61867b565a831ca3",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は\\nポケモンのふえを　つかった！"
    },
    {
      "index": 3,
      "id": "msg_sub020_sys_04",
      "hash": "618680565a832522",
      "flags": 0,
      "text": "カビゴンが　めを　さました！"
    },
    {
      "index": 4,
      "id": "msg_sub020_sys_07",
      "hash": "61867f565a83236f",
      "flags": 0,
      "text": "カビゴンは　[VAR TRNAME(0000)]を　みて\\n……ヨダレを　たらしている！！"
    },
    {
      "index": 5,
      "id": "msg_sub020_fuji_01",
      "hash": "dd4ceab8a4c8f45a",
      "flags": 0,
      "text": "？？？『[VAR TRNAME(0000)]さーん！"
    },
    {
      "index": 6,
      "id": "msg_sub020_fuji_02",
      "hash": "dd4ce9b8a4c8f2a7",
      "flags": 0,
      "text": "フジ『ポケモンのふえを\\nさしあげた　とき\\r\\nいいわすれて　いたことが……"
    },
    {
      "index": 7,
      "id": "msg_sub020_fuji_03",
      "hash": "dd4ce8b8a4c8f0f4",
      "flags": 0,
      "text": "……って　おや　まぁ\\nいい　タイミング　ですね"
    },
    {
      "index": 8,
      "id": "msg_sub020_fuji_05",
      "hash": "dd4ce6b8a4c8ed8e",
      "flags": 0,
      "text": "この　カビゴン　という　ポケモン\\c\\nめざめた　とき　はじめて　みたものを\\nたべものと　かんちがい　して\\r\\nおそってくる　ことが　あるのです"
    },
    {
      "index": 9,
      "id": "msg_sub020_fuji_06",
      "hash": "dd4ce5b8a4c8ebdb",
      "flags": 0,
      "text": "そうなったら　あぶないので\\nたたかって　おとなしく\\r\\nさせて　あげて　ください"
    },
    {
      "index": 10,
      "id": "msg_sub020_fuji_07",
      "hash": "dd4ce4b8a4c8ea28",
      "flags": 0,
      "text": "たおすと　おとなしくなって\\nいつものように　ほかく　できますよ"
    },
    {
      "index": 11,
      "id": "msg_sub020_sys_06",
      "hash": "61867e565a8321bc",
      "flags": 0,
      "text": "カビゴンは\\nねぼけて　おそってきた！"
    },
    {
      "index": 12,
      "id": "msg_sub020_sys_05",
      "hash": "618681565a8326d5",
      "flags": 0,
      "text": "カビゴンは　おとなしく　なった\\nおおきな　あくびを　すると……\\r\\nやまおくへ　さって　いった！"
    },
    {
      "index": 13,
      "id": "msg_sub020_fuji_08",
      "hash": "dd4ce3b8a4c8e875",
      "flags": 0,
      "text": "フジ『なんと　[VAR TRNAME(0000)]さん！\\nみごと　ですね"
    },
    {
      "index": 14,
      "id": "msg_sub020_fuji_09",
      "hash": "dd4ce2b8a4c8e6c2",
      "flags": 0,
      "text": "フジ『おや　[VAR TRNAME(0000)]さん\\nざんねん　でしたね……"
    },
    {
      "index": 15,
      "id": "msg_sub020_fuji_10",
      "hash": "dd4965b8a4c5dc84",
      "flags": 0,
      "text": "いまの　カビゴンの　ように\\nたまに　トレーナーを　おそってくる\\r\\nポケモンが　います\\c\\nそういった　ポケモンは\\nたおして　ほかく　するのですよ\\c\\nいいですか？\\nたおして　ほかく　ですからね！"
    },
    {
      "index": 16,
      "id": "msg_sub020_fuji_11",
      "hash": "dd4966b8a4c5de37",
      "flags": 0,
      "text": "それではー！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_020_max",
      "hash": "af6dc9a4f7b39c54"
    }
  ]
}
