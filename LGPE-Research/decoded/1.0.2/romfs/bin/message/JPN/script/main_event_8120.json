{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main8120_ghost_01",
      "hash": "272f16ab9316fbdf",
      "flags": 0,
      "text": "キクコ『あたしは\\nしてんのうの　キクコ！"
    },
    {
      "index": 1,
      "id": "msg_main8120_ghost_05",
      "hash": "272f12ab9316f513",
      "flags": 0,
      "text": "あんた　オーキドの　ジジイに\\nかわいがられてんだって！"
    },
    {
      "index": 2,
      "id": "msg_main8120_ghost_06",
      "hash": "272f13ab9316f6c6",
      "flags": 0,
      "text": "ジジイ　むかしは　つよくて\\nいい　おとこ　だった！\\r\\nいまじゃ　みる　かげも　ないがね！"
    },
    {
      "index": 3,
      "id": "msg_main8120_ghost_07",
      "hash": "272f14ab9316f879",
      "flags": 0,
      "text": "ポケモンずかん\\nつくってる　ようじゃ　だめだ！"
    },
    {
      "index": 4,
      "id": "msg_main8120_ghost_08",
      "hash": "272f1dab931707c4",
      "flags": 0,
      "text": "ポケモンは　たたかわせる　ものさ"
    },
    {
      "index": 5,
      "id": "msg_main8120_ghost_09",
      "hash": "272f1eab93170977",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]……！　あんたにも\\nホントの　たたかいって　ものを\\r\\nおしえて　やる！"
    },
    {
      "index": 6,
      "id": "msg_kikuko_01_p02_cave_d1403",
      "hash": "530a6af515faf3f3",
      "flags": 0,
      "text": "[~ 6]"
    },
    {
      "index": 7,
      "id": "msg_main8120_ghost_02",
      "hash": "272f17ab9316fd92",
      "flags": 0,
      "text": "キクコ『あんたの　かち　だ！\\nジジイが　めを　つける　だけの\\r\\nことは　ある！"
    },
    {
      "index": 8,
      "id": "msg_main8120_ghost_10",
      "hash": "27329bab931a13b5",
      "flags": 0,
      "text": "もう　これ　いじょう\\nあたしが　いう　ことは　ない！\\r\\nつぎの　へやに　すすみな！"
    },
    {
      "index": 9,
      "id": "msg_main8120_ghost_03",
      "hash": "272f18ab9316ff45",
      "flags": 0,
      "text": "キクコ『きたね！\\c\\nそう　なんども　やられる\\nあたし　じゃ　ないはず　だよ\\c\\nかかって　きな！"
    },
    {
      "index": 10,
      "id": "msg_main8120_ghost_04",
      "hash": "272f11ab9316f360",
      "flags": 0,
      "text": "キクコ『さすが　オーキドの　ジジイが\\nみこんだ　こどもだよ"
    },
    {
      "index": 11,
      "id": "msg_main8120_ghost_11",
      "hash": "27329aab931a1202",
      "flags": 0,
      "text": "むかしの　あたしら　みたいに\\nあんたと　[VAR TRNAME(0001)]\\r\\nいい　ライバル　じゃないか！"
    },
    {
      "index": 12,
      "id": "msg_main8120_ghost_12",
      "hash": "273299ab931a104f",
      "flags": 0,
      "text": "さあ！　さっさと\\nつぎの　へやに　すすみな！"
    }
  ],
  "unpaired_labels": [
