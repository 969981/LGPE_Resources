{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub058_fat_01",
      "hash": "28b90d9a860da042",
      "flags": 0,
      "text": "ぼくの　じてんしゃ　コレクション\\nすごいでしょー！\\c\\nのせたり　うったり　しない　けど\\nすきな　だけ　みてって　いいよ！"
    },
    {
      "index": 1,
      "id": "msg_sub058_bike_01",
      "hash": "ff6f7e16f6c5ba06",
      "flags": 0,
      "text": "ピッカピカの　じてんしゃ！\\nとても　たかそう！"
    },
    {
      "index": 2,
      "id": "msg_sub058_fat_03",
      "hash": "28b90b9a860d9cdc",
      "flags": 0,
      "text": "その　じてんしゃ　きになる！？"
    },
    {
      "index": 3,
      "id": "msg_sub058_fat_02",
      "hash": "28b90c9a860d9e8f",
      "flags": 0,
      "text": "シンプルな　じてんしゃ　って\\nいいよねー！　ちょっと　まえに\\r\\nはやった　げんてい　モデルさ"
    },
    {
      "index": 4,
      "id": "msg_sub0658_fat_03",
      "hash": "4d9896799193ed70",
      "flags": 0,
      "text": "フレームの　サワヤカな　いろあいが\\nだいしぜんと　サイコーに　マッチ！"
    },
    {
      "index": 5,
      "id": "msg_sub058_fat_04",
      "hash": "28b90a9a860d9b29",
      "flags": 0,
      "text": "なんと　おねだん　１００００００円！\\nマニアなかせの　スーパー　レアもの！"
    },
    {
      "index": 6,
      "id": "msg_sub058_fat_05",
      "hash": "28b9099a860d9976",
      "flags": 0,
      "text": "せいのうは　へいきんてき　だけど\\nのりやすさは　ダントツ　で"
    },
    {
      "index": 7,
      "id": "msg_sub058_fat_06",
      "hash": "28b9089a860d97c3",
      "flags": 0,
      "text": "じてんしゃ　しょしんしゃ　でも\\nカンタンに　のりこなせちゃう　のだ！"
    },
    {
      "index": 8,
      "id": "msg_sub058_bike_04",
      "hash": "ff6f8316f6c5c285",
      "flags": 0,
      "text": "そっかー……"
    },
    {
      "index": 9,
      "id": "msg_sub058_bike_02",
      "hash": "ff6f7d16f6c5b853",
      "flags": 0,
      "text": "ピッカピカの　じてんしゃだ！\\nとても　はやそう！"
    },
    {
      "index": 10,
      "id": "msg_sub058_fat_20",
      "hash": "28bf9a9a8612fb87",
      "flags": 0,
      "text": "マッハじてんしゃ　きに　なる！？"
    },
    {
      "index": 11,
      "id": "msg_sub058_fat_07",
      "hash": "28b9079a860d9610",
      "flags": 0,
      "text": "マッハじてんしゃ　は\\nその　な　の　とおり　マッハな\\r\\nはやさが　とくちょうな　じてんしゃさ"
    },
    {
      "index": 12,
      "id": "msg_sub058_fat_08",
      "hash": "28b9169a860daf8d",
      "flags": 0,
      "text": "かるさを　ついきゅう　した　フレーム！\\nきゅうきょくの　くうき　ていこう！"
    },
    {
      "index": 13,
      "id": "msg_sub058_fat_09",
      "hash": "28b9159a860dadda",
      "flags": 0,
      "text": "カーボンの　ハンドルへ　たいじゅうを\\nかければ　すぐさま　トップスピード！"
    },
    {
      "index": 14,
      "id": "msg_sub058_fat_10",
      "hash": "28b5889a860a886c",
      "flags": 0,
      "text": "その　いきおいで　どんな　さか　でも\\nラクラク　こえて　いけるんだ！"
    },
    {
      "index": 15,
      "id": "msg_sub058_fat_11",
      "hash": "28b5899a860a8a1f",
      "flags": 0,
      "text": "そうじゅうの　むずかしさ　も\\nごあいきょうな　いっぴん　さ！"
    },
    {
      "index": 16,
      "id": "msg_sub058_bike_03",
      "hash": "ff6f7c16f6c5b6a0",
      "flags": 0,
      "text": "ピッカピカの　じてんしゃだ！\\nとても　すごそう！"
    },
    {
      "index": 17,
      "id": "msg_sub058_fat_21",
      "hash": "28bf999a8612f9d4",
      "flags": 0,
      "text": "ダートじてんしゃ　きに　なる！？"
    },
    {
      "index": 18,
      "id": "msg_sub058_fat_12",
      "hash": "28b58a9a860a8bd2",
      "flags": 0,
      "text": "じてんしゃ　かいわいの　なかでも\\nとびぬけて　ワイルドな　いたんじ！\\r\\nそれが　ダートじてんしゃ　さ！"
    },
    {
      "index": 19,
      "id": "msg_sub058_fat_13",
      "hash": "28b58b9a860a8d85",
      "flags": 0,
      "text": "ジャンプや　ウィリーなど　たさいな\\nアクションが　かのうな　しろもの！"
    },
    {
      "index": 20,
      "id": "msg_sub058_fat_14",
      "hash": "28b5849a860a81a0",
      "flags": 0,
      "text": "いっぽんばし　も　なんのその！\\nみち　なき　みちも　つきすすむぞ！"
    },
    {
      "index": 21,
      "id": "msg_sub058_fat_15",
      "hash": "28b5859a860a8353",
      "flags": 0,
      "text": "だーっと　はしる　から　ダート……\\nって　いうのは　じょうだん　だけど！"
    },
    {
      "index": 22,
      "id": "msg_sub058_fat_16",
      "hash": "28b5869a860a8506",
      "flags": 0,
      "text": "テクニック　じゅうしな　キミに\\nオススメ　したい　じてんしゃ　さ！"
    },
    {
      "index": 23,
      "id": "msg_sub058_fat_17",
      "hash": "28b5879a860a86b9",
      "flags": 0,
      "text": "ぼくの　ウンチク　ぜんぶ\\nきいて　くれたの　キミが　はじめて"
    },
    {
      "index": 24,
      "id": "msg_sub058_fat_18",
      "hash": "28b5909a860a9604",
      "flags": 0,
      "text": "キミも　そうとうな　マニアだね！\\nおちかづきの　しるしを　どうぞ！"
    },
    {
      "index": 25,
      "id": "msg_sub058_fat_19",
      "hash": "28b5919a860a97b7",
      "flags": 0,
      "text": "ぼくの　じてんしゃ　コレクション\\n……って　なんだ　キミ　か！\\c\\nキミ　なら　いつまでも\\nすきな　だけ　みてって　いいよ！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_058_max",
      "hash": "955df17cb3de289b"
    }
  ]
}
