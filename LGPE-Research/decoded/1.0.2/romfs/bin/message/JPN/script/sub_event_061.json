{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub061_fairy_01",
      "hash": "c0acad6e104def2c",
      "flags": 0,
      "text": "？？？『あーあ"
    },
    {
      "index": 1,
      "id": "msg_sub061_fairy_02",
      "hash": "c0acb06e104df445",
      "flags": 0,
      "text": "うみを　むちゅうで\\nスケッチ　してたら\\c\\nふねが　しゅっこう\\nしちゃったの　ですよねー"
    },
    {
      "index": 2,
      "id": "msg_sub061_select_01",
      "hash": "ba9e74d1ec76efcd",
      "flags": 0,
      "text": "たいへん！"
    },
    {
      "index": 3,
      "id": "msg_sub061_select_02",
      "hash": "ba9e71d1ec76eab4",
      "flags": 0,
      "text": "どう　するの？"
    },
    {
      "index": 4,
      "id": "msg_sub061_fairy_03",
      "hash": "c0acaf6e104df292",
      "flags": 0,
      "text": "そうだねー\\c\\nマツリカ　しばらく\\nここにいる　ことに　します\\c\\nカントーの　うみの　いろ\\nきに　いったの　ですよ！"
    },
    {
      "index": 5,
      "id": "msg_sub061_fairy_04",
      "hash": "c0acaa6e104dea13",
      "flags": 0,
      "text": "マツリカ『カントーの\\nトレーナーさん！\\c\\nマツリカの　フェアリーポケモンと\\nしょうぶ　して　みませんか？"
    },
    {
      "index": 6,
      "id": "msg_sub061_fairy_05",
      "hash": "c0aca96e104de860",
      "flags": 0,
      "text": "それなら　いっしょに\\nうみを　みようよ！"
    },
    {
      "index": 7,
      "id": "msg_sub061_fairy_06",
      "hash": "c0acac6e104ded79",
      "flags": 0,
      "text": "ふふふ\\c\\nでは　いきますよ！\\nフェアリータイプの　よさを\\r\\nしって　ほしいな！"
    },
    {
      "index": 8,
      "id": "msg_sub061_fairy_07",
      "hash": "c0acab6e104debc6",
      "flags": 0,
      "text": "おー！　なんとも　すてきだね\\nきみと　きみの　ポケモン！\\c\\nじつに　ナイスモチーフ！\\nえに　かいて　みたいな"
    },
    {
      "index": 9,
      "id": "msg_sub061_fairy_08",
      "hash": "c0acb66e104dfe77",
      "flags": 0,
      "text": "マツリカ『きみに　かつまでは\\nアローラに　かえれないのです\\c\\nなんてねー\\c\\nでも　また\\nしょうぶ　しようよ！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_061_max",
      "hash": "f1956e3fcb7adec7"
    }
  ]
}
