{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_main0320_masaki_01",
      "hash": "4ad2d407a339c616",
      "flags": 0,
      "text": "こんちわ！\\nぼく　ポケモン……！\\r\\n……ちゃうわい！"
    },
    {
      "index": 1,
      "id": "msg_main0320_masaki_06",
      "hash": "4ad2d707a339cb2f",
      "flags": 0,
      "text": "わいは　マサキ！\\nひと　よんで　ポケモンマニアや！"
    },
    {
      "index": 2,
      "id": "msg_main0320_masaki_07",
      "hash": "4ad2d607a339c97c",
      "flags": 0,
      "text": "あッ　なんや　そのめは？\\nあんさん　しんよう　してへんな\\c\\nホンマやで！\\nじっけんに　しっぱい　して\\r\\nポケモンと　くっついて　もうたんや\\c\\nなッ！\\nたすけて　くれへん？"
    },
    {
      "index": 3,
      "id": "msg_main0320_masaki_02",
      "hash": "4ad2d307a339c463",
      "flags": 0,
      "text": "あッ　なんや　そのめは？\\nねえさん　しんよう　してへんな\\c\\nホンマやで！\\nじっけんに　しっぱい　して\\r\\nポケモンと　くっついて　もうたんや\\c\\nなッ！\\nたすけて　くれへん？"
    },
    {
      "index": 4,
      "id": "msg_main0320_masaki_03",
      "hash": "4ad2d207a339c2b0",
      "flags": 0,
      "text": "わいが\\nてんそう　マシンに　はいるさかい\\r\\nぶんり　プログラムを　たのむで！"
    },
    {
      "index": 5,
      "id": "msg_main0320_masaki_08",
      "hash": "4ad2dd07a339d561",
      "flags": 0,
      "text": "そうや　そこの　パソコンや！\\nまちがえんと　うごかしてや！"
    },
    {
      "index": 6,
      "id": "msg_main0320_masaki_04",
      "hash": "4ad2d907a339ce95",
      "flags": 0,
      "text": "そんなあ……\\nつめたい　こと　いわんといて\\c\\nよッ……　いろおとこ！\\nにくいねーッ！　だいとうりょう！\\c\\nほな！　オッケー　やな！\\nきまりや！"
    },
    {
      "index": 7,
      "id": "msg_main0320_masaki_05",
      "hash": "4ad2d807a339cce2",
      "flags": 0,
      "text": "そんなあ……\\nつめたい　こと　いわんといて\\c\\nよッ……　いいおんな！\\nにくいねーッ！　だいとうりょう！\\c\\nほな！　オッケー　やな！\\nきまりや！"
    },
    {
      "index": 8,
      "id": "msg_main0320_pc_01",
      "hash": "5935ee73f823b3e3",
      "flags": 0,
      "text": "[~ 8]"
    },
    {
      "index": 9,
      "id": "msg_main0320_masaki_09",
      "hash": "4ad2dc07a339d3ae",
      "flags": 0,
      "text": "ほな　よろしくー！"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_main_event_0320_max",
