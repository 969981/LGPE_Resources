{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub046_adult_M_01",
      "hash": "55b114efac6d35c6",
      "flags": 0,
      "text": "ぼくは　ゲーム　ディレクター\\c\\nこのゲームを　あそんで　もらえて\\nとっても　うれしいです！\\c\\nポケモンずかん　がんばってね！\\c\\nもし　ぜんぶ　あつめたら\\nおしえてね！"
    },
    {
      "index": 1,
      "id": "msg_sub046_adult_M_02",
      "hash": "55b113efac6d3413",
      "flags": 0,
      "text": "おー！　すごい！\\nついに　ポケモンずかんが\\r\\nかんせい　したんだね！\\c\\nいやー　すばらしい！\\c\\nずかん　かんせい　おめでとう！\\nひょうしょう　させて　ください！"
    },
    {
      "index": 2,
      "id": "msg_sub046_adult_M_06",
      "hash": "55b117efac6d3adf",
      "flags": 0,
      "text": "おいわいに　ぼくから\\nとっておきの　プレゼントです！"
    },
    {
      "index": 3,
      "id": "msg_sub046_adult_M_07",
      "hash": "55b116efac6d392c",
      "flags": 0,
      "text": "[VAR TRNAME(0000)]は　ディレクター　から\\n[VAR COLOR(0006)]ひかるおまもり[VAR COLOR(0000)]　を　もらった！"
    },
    {
      "index": 4,
      "id": "msg_sub046_adult_M_03",
      "hash": "55b112efac6d3260",
      "flags": 0,
      "text": "かいはつの　みんなにも\\nずかん　みせて　あげてよ！"
    },
    {
      "index": 5,
      "id": "msg_sub046_adult_M_04",
      "hash": "55b119efac6d3e45",
      "flags": 0,
      "text": "ぼくは　ゲーム　ディレクター\\c\\nポケモンずかん　また\\nみせに　きて　くれたの？\\c\\nじゃあ　もういちど\\nひょうしょう　しちゃいましょう！\\r\\nずかん　かんせい　おめでとう！"
    },
    {
      "index": 6,
      "id": "msg_sub046_adult_M_05",
      "hash": "55b118efac6d3c92",
      "flags": 0,
      "text": "きみが　ポケモンの　せかいで\\nたくさん　あそんで　くれて\\r\\nほんとうに　うれしいです！"
    }
  ],
  "unpaired_labels": [
