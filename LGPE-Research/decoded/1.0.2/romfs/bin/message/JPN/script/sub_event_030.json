  "lines": [
    {
      "index": 0,
      "id": "msg_sub030_oldm_01",
      "hash": "9c1b0e88768a8763",
      "flags": 0,
      "text": "やあ　やあ！\\c\\nわたしは　いつも　きみが\\nそこを　とおるのを　みてた……\\c\\nいつ　きて　くれるかな　って\\nもう　ほんと　さみしく　みてた\\c\\nどうして　こんな　いえの　まえに\\nいけを　つくって　しまったのか……"
    },
    {
      "index": 1,
      "id": "msg_sub030_oldm_02",
      "hash": "9c1b0f88768a8916",
      "flags": 0,
      "text": "おさんぽ　いく　のも　ひとくろう！\\c\\nわかかった　ころの　わたし\\nバカ　バカ！　あんぽんたん！"
    },
    {
      "index": 2,
      "id": "msg_sub030_oldm_05",
      "hash": "9c1b1288768a8e2f",
      "flags": 0,
      "text": "わたし　なんて……\\nとんだ　おたんこなす　だー！！"
    },
    {
      "index": 3,
      "id": "msg_sub030_oldm_03",
      "hash": "9c1b1088768a8ac9",
      "flags": 0,
      "text": "…………ふぅ！\\nスッキリ　した！\\c\\nスッキリ　ついでに\\nわざマシンを　あげよう！"
    },
    {
      "index": 4,
      "id": "msg_sub030_oldm_04",
      "hash": "9c1b1188768a8c7c",
      "flags": 0,
      "text": "わざマシン２６の　どくづき　は\\nわるくちを　いう　わざ……\\r\\nでは　なく\\c\\nどくの　て　で　あいてを\\nつきさす　おそろしい　わざ　だ！\\c\\nたまに　あいてを\\nどく　じょうたいに　するよ！"
    },
    {
      "index": 5,
      "id": "msg_oldman2_01_p01_field_t007",
      "hash": "6065cfdb406f48f9",
      "flags": 0,
      "text": "[~ 5]"
