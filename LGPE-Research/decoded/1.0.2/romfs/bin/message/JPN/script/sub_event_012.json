{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_sub012_middlem_01",
      "hash": "fd4e2c5c5d64792d",
      "flags": 0,
      "text": "うでが　あがった\\nポケモントレーナー　だけが　もらえる\\r\\nリーグバッジ！\\c\\nあなたも　いくつか　もってますね\\c\\nでは　バッジについて　わたしの\\nウンチク　かたっても　よいですか？"
    },
    {
      "index": 1,
      "id": "msg_sub012_middlem_02",
      "hash": "fd4e295c5d647414",
      "flags": 0,
      "text": "では……\\c\\nリーグバッジ　８つの　うち\\nどれに　ついて　はなしましょう？"
    },
    {
      "index": 2,
      "id": "msg_t004r0201_select_01",
      "hash": "b81e9c77d8638393",
      "flags": 0,
      "text": "グレーバッジ"
    },
    {
      "index": 3,
      "id": "msg_t004r0201_select_02",
      "hash": "b81e9d77d8638546",
      "flags": 0,
      "text": "ブルーバッジ"
    },
    {
      "index": 4,
      "id": "msg_t004r0201_select_03",
      "hash": "b81e9e77d86386f9",
      "flags": 0,
      "text": "オレンジバッジ"
    },
    {
      "index": 5,
      "id": "msg_t004r0201_select_04",
      "hash": "b81e9f77d86388ac",
      "flags": 0,
      "text": "レインボーバッジ"
    },
    {
      "index": 6,
      "id": "msg_t004r0201_select_05",
      "hash": "b81ea077d8638a5f",
      "flags": 0,
      "text": "ピンクバッジ"
    },
    {
      "index": 7,
      "id": "msg_t004r0201_select_06",
      "hash": "b81ea177d8638c12",
      "flags": 0,
      "text": "ゴールドバッジ"
    },
    {
      "index": 8,
      "id": "msg_t004r0201_select_07",
      "hash": "b81ea277d8638dc5",
      "flags": 0,
      "text": "クリムゾンバッジ"
    },
    {
      "index": 9,
      "id": "msg_t004r0201_select_08",
      "hash": "b81ea377d8638f78",
      "flags": 0,
      "text": "グリーンバッジ"
    },
    {
      "index": 10,
      "id": "msg_t004r0201_select_09",
      "hash": "b81ea477d863912b",
      "flags": 0,
      "text": "バッジのかず"
    },
    {
      "index": 11,
      "id": "msg_t004r0201_select_10",
      "hash": "b8222177d8669b69",
      "flags": 0,
      "text": "やめる"
    },
    {
      "index": 12,
      "id": "msg_sub012_middlem_03",
      "hash": "fd4e2a5c5d6475c7",
      "flags": 0,
      "text": "はなしを　ききたく　なったら\\nまた　いらっしゃい"
    },
    {
      "index": 13,
      "id": "msg_sub012_middlem_04",
      "hash": "fd4e275c5d6470ae",
      "flags": 0,
      "text": "ニビジムの　ジムリーダーに\\nしょうり　した　あかし　です\\c\\nいわタイプ　らしく　かたくて\\nざらざら　した　てざわりに\\c\\nぶこつな　しょくにんの\\nこだわりを　かんじる　バッジです"
    },
    {
      "index": 14,
      "id": "msg_sub012_middlem_05",
      "hash": "fd4e285c5d647261",
      "flags": 0,
      "text": "ハナダジムの　ジムリーダーに\\nしょうり　した　あかし　です\\c\\nすいてきを　モチーフに　した\\nこだわりの　フォルム……\\c\\nさきっちょが　ささると\\nちょっと　いたいですよ"
    },
    {
      "index": 15,
      "id": "msg_sub012_middlem_06",
      "hash": "fd4e255c5d646d48",
      "flags": 0,
      "text": "クチバジムの　ジムリーダーに\\nしょうり　した　あかし　です\\c\\nききなれない　かも　ですが\\nくすんだ　あかみ　がかった　きいろを\\r\\nくちばいろ　と　いいます\\c\\nバッジの　いろも\\nそんな　かんじ　ですよね"
    },
    {
      "index": 16,
      "id": "msg_sub012_middlem_07",
      "hash": "fd4e265c5d646efb",
      "flags": 0,
      "text": "タマムシジムの　ジムリーダーに\\nしょうり　した　あかし　です\\c\\nカントーバッジの　なかで\\nいちばん　カラフルな　バッジなので\\r\\nいちばん　せいさくひも　たかいです\\c\\nじめんに　おいて　まわすと\\nいろ　あざやかで　きれいですよ"
    },
    {
      "index": 17,
      "id": "msg_sub012_middlem_08",
      "hash": "fd4e235c5d6469e2",
      "flags": 0,
      "text": "セキチクジムの　ジムリーダーに\\nしょうり　した　あかし　です\\c\\nいろが　かわいい　ピンク　なのと\\nハートの　かたちに　にてるので\\c\\nプロポーズで　あげたい　ジムバッジ\\n２ねん　れんぞく　ナンバーワン　です"
    },
    {
      "index": 18,
      "id": "msg_sub012_middlem_09",
      "hash": "fd4e245c5d646b95",
      "flags": 0,
      "text": "ヤマブキジムの　ジムリーダーに\\nしょうり　した　あかし　です\\c\\nそざいが　ほんとうに\\nきん　なのか　どうかは\\c\\nいまだに　トレーナーの　あいだで\\nいけんが　われています"
    },
    {
      "index": 19,
      "id": "msg_sub012_middlem_10",
      "hash": "fd51915c5d675aa3",
      "flags": 0,
      "text": "グレンジムの　ジムリーダーに\\nしょうり　した　あかし　です\\c\\nじつは　バッジの　そざいには\\nジムリーダーの　こだわりが　あって\\c\\nグレンかざんの　マグマから　できた\\nかせいがんが　つかわれてますよ"
    },
    {
      "index": 20,
      "id": "msg_sub012_middlem_11",
      "hash": "fd51905c5d6758f0",
      "flags": 0,
      "text": "トキワジムの　ジムリーダーに\\nしょうり　した　あかし　です\\c\\n８つの　バッジの　なかで\\nもっとも　てに　いれるのが\\r\\nむずかしい　と　いわれてます"
    },
    {
      "index": 21,
      "id": "msg_sub012_middlem_12",
      "hash": "fd51935c5d675e09",
      "flags": 0,
      "text": "バッジを　もってる\\nかずが　おおい　ほど\\c\\nひとから　もらった　ポケモンが\\nつよくても　いうことを　ききます\\c\\n１つ　もってると　レベル２０まで\\n２つ　もってると　レベル３０まで　と\\r\\n１０ずつ　レベルが　ふえていきます\\c\\nぜんぶの　バッジが　あれば　すべての\\nポケモンが　いうことを　ききます"
    },
    {
      "index": 22,
      "id": "msg_t004r0201_select_11",
      "hash": "b8222077d86699b6",
      "flags": 0,
      "text": "リーグバッジに　ついて"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_sub_event_012_max",
      "hash": "017caaa2ab670f4d"
    }
  ]
}
