  "lines": [
    {
      "index": 0,
      "id": "msg_main1500_rival_01",
      "hash": "557f619c8abb9067",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『あーあ！\\nみじかい　てんか　だったぜ！"
    },
    {
      "index": 1,
      "id": "msg_main1500_rival_04",
      "hash": "557f5c9c8abb87e8",
      "flags": 0,
      "text": "これからは　[VAR TRNAME(0000)]が\\nしん　チャンピオン　だな！\\c\\nオレの　あたらしい\\nもくひょうが　できた！"
    },
    {
      "index": 2,
      "id": "msg_main1500_doctor_01",
      "hash": "b00cec58886a7564",
      "flags": 0,
      "text": "オーキド『[VAR TRNAME(0000)]！"
    },
    {
      "index": 3,
      "id": "msg_main1500_doctor_02",
      "hash": "b00cef58886a7a7d",
      "flags": 0,
      "text": "オーキド『とうとう　やったな！\\nポケモンリーグ　せいは！\\r\\nこころ　から　おめでとう！"
    },
    {
      "index": 4,
      "id": "msg_main1500_doctor_08",
      "hash": "b00ce558886a697f",
      "flags": 0,
      "text": "はじめて　[VAR POKNAME(0002)]を　つかまえて\\nポケモン　ずかん　あつめに\\r\\nでかけた　ころと　くらべると\\r\\nたくましく　なったな！"
    },
    {
      "index": 5,
      "id": "msg_main1500_doctor_09",
      "hash": "b00ce458886a67cc",
      "flags": 0,
      "text": "……いやいや！\\n[VAR TRNAME(0000)]は　おとなに　なった！"
    },
    {
      "index": 6,
      "id": "msg_main1500_doctor_03",
      "hash": "b00cee58886a78ca",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]！\\nさいごまで　あきらめず\\r\\nよく　やった！"
    },
    {
      "index": 7,
      "id": "msg_main1500_doctor_10",
      "hash": "b009e7588868370e",
      "flags": 0,
      "text": "おまえの　たたかい　かた……\\nポケモンや　[VAR TRNAME(0000)]への\\r\\nやさしい　きもちが　ありすぎて\\c\\nその　ちょっとの　すきで\\nまけたの　かも　しれんな"
    },
    {
      "index": 8,
      "id": "msg_main1500_doctor_04",
      "hash": "b00ce958886a704b",
      "flags": 0,
      "text": "ふたり　とも\\nすばらしい　しょうぶ　じゃった！"
    },
    {
      "index": 9,
      "id": "msg_main1500_rival_02",
      "hash": "557f629c8abb921a",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『……はいッ！"
    },
    {
      "index": 10,
      "id": "msg_main1500_doctor_05",
      "hash": "b00ce858886a6e98",
      "flags": 0,
      "text": "オーキド『[VAR TRNAME(0000)]！\\c\\nポケモンリーグを　せいは　したのは\\nひとりの　ちから　では　ないことを\\r\\n……おまえは　わかっとるな！\\c\\n[VAR TRNAME(0000)]と　ポケモンの\\nぜつみょうな　コンビネーション！\\r\\nみごと　だったぞ！\\c\\nそれでは……　[VAR TRNAME(0000)]！\\nわしに　ついて　きなさい！"
    },
    {
      "index": 11,
      "id": "msg_main1500_rival_03",
      "hash": "557f639c8abb93cd",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『あーあ！\\nやっぱ　つえーな！\\c\\nけど　あきらめ　ないぜ！\\nなんどでも　チャンピオンに\\r\\nちょうせん　する　からな！"
    },
    {
      "index": 12,
      "id": "msg_main1500_doctor_06",
      "hash": "b00ceb58886a73b1",
      "flags": 0,
      "text": "オーキド『[VAR TRNAME(0000)]！"
    },
    {
      "index": 13,
      "id": "msg_main1500_doctor_07",
      "hash": "b00cea58886a71fe",
      "flags": 0,
      "text": "ポケモンリーグ　せいは　おめでとう！\\c\\nいちど　てにいれた\\nチャンピオンの　ざを\\r\\nまもる　のは\\r\\nなみたいていの　どりょく　では\\r\\nできない　ことじゃ！\\c\\nその　けんとうを　たたえよう\\nわしに　ついて　きなさい！"
    },
    {
