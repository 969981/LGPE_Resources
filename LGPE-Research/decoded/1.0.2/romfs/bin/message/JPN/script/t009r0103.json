  "lines": [
    {
      "index": 0,
      "id": "msg_t009r0103_researcher_01",
      "hash": "48298d444a19f347",
      "flags": 0,
      "text": "そう！　イーブイは\\nなんとおりかの　しんかを　する\\r\\nかのうせいが　ある！"
    },
    {
      "index": 1,
      "id": "msg_t009r0103_partner_b_01",
      "hash": "6ff940a617d7929a",
      "flags": 0,
      "text": "ブブー"
    },
    {
      "index": 2,
      "id": "msg_t009r0103_researcher_02",
      "hash": "48298e444a19f4fa",
      "flags": 0,
      "text": "……だが　きみの　イーブイは\\nしんか　したく　なさそうだ"
    },
    {
      "index": 3,
      "id": "msg_t009r0103_researcher_03",
      "hash": "48298f444a19f6ad",
      "flags": 0,
      "text": "この　きかい　せんたくきに\\nみえるでしょ？　でも　ちがうよ！"
    },
    {
      "index": 4,
      "id": "msg_t009r0103_researcher_04",
      "hash": "482988444a19eac8",
      "flags": 0,
      "text": "あわわ　まちがえて\\nゆせいペンで　メモしちゃった！\\c\\n……うらがえして\\nかくそうか？"
    },
    {
      "index": 5,
      "id": "msg_t009r0103_researcher_05",
      "hash": "482989444a19ec7b",
      "flags": 0,
      "text": "はー　いそがし　いそがし！\\nせっせっせ！"
    },
    {
      "index": 6,
      "id": "msg_t009r0103_pc_01",
      "hash": "90a8a4ab33efc0ae",
      "flags": 0,
      "text": "パソコンに\\nメールが　とどいてる！\\c\\nファイヤー　サンダー　フリーザーは\\nでんせつの　とりポケモンです\\c\\nしかし　どこに　いるのか\\nまだ　わかって　ません\\c\\nこんど　ハナダのどうくつに\\nちょうさに　いきます\\c\\nまずは　ほうこく　まで\\n……ポケモン　ちょうさ　たい"
    },
    {
      "index": 7,
      "id": "msg_t009r0103_pipe_01",
      "hash": "f18ffb7a42368d7d",
      "flags": 0,
      "text": "コハクの　パイプが　ある！"
    }
  ],
