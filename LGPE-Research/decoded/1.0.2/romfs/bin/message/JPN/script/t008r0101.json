  "lines": [
    {
      "index": 0,
      "id": "msg_t008r0101_muscle_01",
      "hash": "d5e42d2ee3c00e3f",
      "flags": 0,
      "text": "ウチの　えんちょう\\nあだな　ヤドンって　いうんです\\c\\nほら！　ポケモンの　ヤドンって\\nとぼけた　かんじ　でしょ！"
    },
    {
      "index": 1,
      "id": "msg_t008r0101_engineer_01",
      "hash": "a74a52337d0c8eb5",
      "flags": 0,
      "text": "ヤドンさんって\\nすごい　ポケモン　くわしいんだ！\\c\\nみた　ことも　ない\\nポケモンの　カセキとか　もってるし"
    },
    {
      "index": 2,
      "id": "msg_t008r0101_muscle_02",
      "hash": "d5e42e2ee3c00ff2",
      "flags": 0,
      "text": "ヤドン　えんちょう……\\c\\nこないだ　つりに\\nでかけて　からと　いうもの\\r\\nなにやら　ずっと\\r\\nふにゃふにゃ　いってんだ\\c\\nボケた　のか？"
    },
    {
      "index": 3,
      "id": "msg_t008r0101_engineer_02",
      "hash": "a74a4f337d0c899c",
      "flags": 0,
      "text": "１９ばんすいどう　ほうめんで\\nきんいろに　ひかる\\r\\nなにかを　みたぞ\\c\\nすごい　おたから　かも！"
    },
    {
      "index": 4,
      "id": "msg_t008r0101_poster_01",
      "hash": "4dc32babf18f14b5",
      "flags": 0,
      "text": "サファリゾーン\\nこんしゅうの　もくひょう！\\c\\nがんばって　ポケモンより　はやおき！"
    }
  ],
