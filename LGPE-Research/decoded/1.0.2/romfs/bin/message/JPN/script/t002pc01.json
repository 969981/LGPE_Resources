{
  "schema": "lgpe-gamedata-v1",
  "format": "LGPE-message",
  "lines": [
    {
      "index": 0,
      "id": "msg_t002pc01_gentleman_01",
      "hash": "850a0b093207abf7",
      "flags": 0,
      "text": "すみに　ある　マガジンラックの\\nほんは　ごじゆうに　およみください！\\c\\n……と　うけつけの　ねーちゃんが\\nいっとった　しんせつやのう"
    },
    {
      "index": 1,
      "id": "msg_t002pc01_youngm_01",
      "hash": "311a5fc73c27a637",
      "flags": 0,
      "text": "ポケモンセンターは　このさき\\nどこの　まちに　いっても　ある！\\c\\nなんびき　あずけても　ただ　だし\\nこまめに　つかうと　いいよ！"
    },
    {
      "index": 2,
      "id": "msg_t002pc01_childm_01",
      "hash": "b0660545b66d4ef1",
      "flags": 0,
      "text": "たくさん　つかまえた　ポケモンは\\nボックスに　おくられるよ！\\c\\nきみの　バッグの　なかにも\\nボックスが　あるでしょ？"
    },
    {
      "index": 3,
      "id": "msg_t002pc01_childf_01",
      "hash": "e19e756f6f4a2e16",
      "flags": 0,
      "text": "トレーナーと　たたかった\\nこと　ある？\\c\\nすばやさが　たかければ\\nあいての　ポケモン　より\\r\\nさきに　こうげき　できるよ！"
    },
    {
      "index": 4,
      "id": "msg_t002pc01_book_01",
      "hash": "468b8c6d5dbaeead",
      "flags": 0,
      "text": "『ポケモンジャーナル』\\nと　かかれた　ほんが　ある……"
    },
    {
      "index": 5,
      "id": "msg_t002pc01_select_01",
      "hash": "5d497dde6c88ca56",
      "flags": 0,
      "text": "うらびょうしに　はでな\\nこうこくが　ある！　よみますか？"
    },
    {
      "index": 6,
      "id": "msg_t002pc01_book_02",
      "hash": "468b896d5dbae994",
      "flags": 0,
      "text": "ヒジュツと　よばれる\\nわざを　つかえば\\c\\nきを　きって　みちを　つくったり\\nくらい　ばしょも　あかるく　みえたり\\r\\nべんりなこと　だらけ！\\c\\nあなたも　ヒジュツ\\nまなんで　みませんか？\\c\\n\\n……カントー　ヒジュツ　きょうかい"
    },
    {
      "index": 7,
      "id": "msg_t002pc01_pc_01",
      "hash": "120b53a3d4e3dc71",
      "flags": 0,
      "text": "ただいま　マシンの\\nメンテナンスちゅう　です\\c\\nすみませんが　また\\nのちほど　おこしください"
    }
  ],
  "unpaired_labels": [
    {
      "id": "msg_t002pc01_max",
      "hash": "110581e27b58f9da"
    }
  ]
}
