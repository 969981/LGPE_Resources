    {
      "index": 6,
      "id": "msg_main0920_select_02",
      "hash": "a495744c28984073",
      "flags": 0,
      "text": "サカキは　ここに！"
    },
    {
      "index": 7,
      "id": "msg_main0920_rival_04",
      "hash": "eea062068af47581",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『ロケットだんの　ボスは\\nこの　ビルに　いたのか……！\\c\\nよし　それなら！"
    },
    {
      "index": 8,
      "id": "msg_main0920_rival_05",
      "hash": "eea061068af473ce",
      "flags": 0,
      "text": "[VAR TRNAME(0001)]『[VAR TRNAME(0000)]　いけ！\\nボスを　たおす　チャンスだ！"
