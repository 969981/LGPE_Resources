    </animTag>
    <animTag name="pattern_version" startFrame="0" endFrame="1" animLoop="OneTime" fileName="pattern_version" outputPaneSRT="false" outputVisibility="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" outputMaskTextureSRT="false" descendingBind="false">
      <comment>ピカブイ切り替え用アニメ
0F: ピカ
1F: ブイ</comment>
      <userData />
      <group name="G_keep_00" />
    </animTag>
    <animTag name="pattern_map" startFrame="0" endFrame="42" animLoop="OneTime" fileName="pattern_map" outputPaneSRT="false" outputVisibility="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" outputMaskTextureSRT="false" descendingBind="false">
      <comment>以下の順でアニメを入れてあります、フレームを切り替えて絵を変えてください。（town_mapと同じ並びです）

マサラ
トキワ
ニビ
ハナダ
シオン
クチバ
タマムシ
セキチク
グレン
セキエイ高原
ヤマブキ
1番道路
⇓
25番道路
トキワの森
おつきみやま
イワヤマトンネル
発電所
ディグダのあな
ふたごじま
チャンピオンロード</comment>
      <userData />
      <group name="G_map_00" />
    </animTag>
    <lan animType="PaneSRT" startFrame="0" endFrame="3000" convertStartFrame="0" convertEndFrame="30">
      <animContent name="inout_00">
        <animPaneSRTTarget target="TranslateX">
          <key frame="0" value="0" slopeType="Flat" />
          <key frame="3" value="40" slope="13.333333" slopeType="Linear" />
          <key frame="3" value="40" slope="-13.333333" slopeType="Linear" />
          <key frame="6" value="0" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="inout_01">
        <animPaneSRTTarget target="TranslateY">
          <key frame="0" value="0" slopeType="Flat" />
