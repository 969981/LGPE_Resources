        </animPaneSRTTarget>
        <animPaneSRTTarget target="RotateZ">
          <key frame="0" value="0" slopeType="Flat" />
          <key frame="703" value="3" slopeType="Flat" />
          <key frame="2239" value="-3" slopeType="Flat" />
          <key frame="3000" value="0" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="P_BG_00">
