<?xml version="1.0" encoding="utf-8"?>
<nw4f_layout xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.5.2" xmlns="http://www.nintendo.co.jp/NW4F/LayoutEditor">
  <head>
    <create user="ariga_mitsuhiro" host="W00668" date="2017-11-04T18:43:47.6211511+09:00" source="" />
    <title />
    <comment />
    <generator name="" version="1.0.0" />
  </head>
  <body>
    <animTag name="on" startFrame="0" endFrame="0" animLoop="Wait" fileName="on" outputPaneSRT="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>アイコン表示</comment>
      <userData />
      <group name="G_in_out_00" />
    </animTag>
    <animTag name="off" startFrame="1" endFrame="1" animLoop="Wait" fileName="off" outputPaneSRT="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>アイコン非表示</comment>
      <userData />
      <group name="G_in_out_00" />
    </animTag>
    <animTag name="keep" startFrame="0" endFrame="60" fileName="keep" outputPaneSRT="false" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>明滅ループアニメ_常に流しておいてください。</comment>
      <userData />
      <group name="G_keep_00" />
    </animTag>
    <lan animType="VertexColor" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="P_icon_00">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="255" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="30" value="100" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="60" value="255" slopeType="Flat" />
        </animVertexColorTarget>
      </animContent>
    </lan>
    <lan animType="Visibility" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="N_visible_00">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="0" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
    </lan>
  </body>
</nw4f_layout>