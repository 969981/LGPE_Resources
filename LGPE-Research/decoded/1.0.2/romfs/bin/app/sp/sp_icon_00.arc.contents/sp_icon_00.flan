<?xml version="1.0" encoding="utf-8"?>
<nw4f_layout xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.5.2" xmlns="http://www.nintendo.co.jp/NW4F/LayoutEditor">
  <head>
    <create user="kuga_erika" host="W00740" date="2017-10-23T18:50:14.8023874+09:00" source="" />
    <title />
    <comment />
    <generator name="" version="1.0.0" />
  </head>
  <body>
    <animTag name="in" startFrame="0" endFrame="4" animLoop="OneTime" fileName="in" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment />
      <userData />
      <group name="G_inout_00" />
    </animTag>
    <animTag name="patern_pos_00" startFrame="0" endFrame="2" animLoop="OneTime" fileName="patern_pos_00" outputVisibility="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>0F：バトル
1F：フィールド
2F：捕獲</comment>
      <userData />
      <group name="G_patern_00" />
    </animTag>
    <animTag name="keep" startFrame="0" endFrame="150" fileName="keep" outputVisibility="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" outputMaskTextureSRT="false" descendingBind="false">
      <comment />
      <userData />
      <group name="G_keep_00" />
    </animTag>
    <animTag name="patern_icon" startFrame="0" endFrame="1" animLoop="OneTime" fileName="patern_icon" outputPaneSRT="false" outputMaterialColor="false" outputTextureSRT="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>0F：通信できる時
1F：コントローラー未接続時</comment>
      <userData />
      <group name="G_icon_00" />
    </animTag>
    <animTag name="out" startFrame="4" endFrame="8" animLoop="OneTime" fileName="out" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment />
      <userData />
      <group name="G_inout_00" />
    </animTag>
    <lan animType="PaneSRT" startFrame="0" endFrame="600" convertStartFrame="0" convertEndFrame="50">
      <animContent name="N_inout_01">
        <animPaneSRTTarget target="TranslateX">
          <key frame="0" value="10" slopeType="Flat" />
          <key frame="4" value="-34" slopeType="Flat" />
          <key frame="8" value="10" slopeType="Step" />
          <key frame="8" value="10" slopeType="Step" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="N_patern_00">
        <animPaneSRTTarget target="TranslateY">
          <key frame="0" value="0" slopeType="Step" />
          <key frame="1" value="0" slopeType="Step" />
          <key frame="1" value="-332" slopeType="Step" />
          <key frame="2" value="-332" slopeType="Step" />
          <key frame="2" value="0" slopeType="Step" />
          <key frame="2" value="0" slopeType="Step" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="P_effect_00">
        <animPaneSRTTarget target="RotateZ">
          <key frame="0" value="0" slopeType="Flat" />
          <key frame="2" value="-16" slope="4.07410669" />
          <key frame="8" value="20" slope="2.35952544" />
          <key frame="14" value="-20" slope="4.76075363" />
          <key frame="20" value="18" slope="3.88875" />
          <key frame="25" value="-9" slope="4.76075363" />
          <key frame="31" value="0" slope="-0.508518934" />
        </animPaneSRTTarget>
      </animContent>
    </lan>
    <lan animType="VertexColor" startFrame="0" endFrame="600" convertStartFrame="0" convertEndFrame="50">
      <animContent name="N_inout_01">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="0" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="2" value="255" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="6" value="255" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="8" value="0" slopeType="Flat" />
        </animVertexColorTarget>
      </animContent>
      <animContent name="N_keep_00">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="40" value="0" slopeType="Flat" />
        </animVertexColorTarget>
      </animContent>
      <animContent name="P_effect_01">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="10" value="0" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="32" value="0" slopeType="Flat" />
        </animVertexColorTarget>
      </animContent>
    </lan>
    <lan animType="TexturePattern" startFrame="0" endFrame="600" convertStartFrame="0" convertEndFrame="50">
      <animContent name="P_icon_01">
        <animTexPatternTarget target="Image">
          <refRes name="sp_icon_01" />
          <refRes name="sp_icon_02" />
          <key xsi:type="StepU16" frame="0" value="0" slopeType="Step" />
          <key xsi:type="StepU16" frame="1" value="1" slopeType="Step" />
        </animTexPatternTarget>
      </animContent>
    </lan>
    <lan animType="Visibility" startFrame="0" endFrame="600" convertStartFrame="0" convertEndFrame="50">
      <animContent name="N_patern_01">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="0" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
    </lan>
  </body>
</nw4f_layout>