<?xml version="1.0" encoding="utf-8"?>
<nw4f_layout xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.5.2" xmlns="http://www.nintendo.co.jp/NW4F/LayoutEditor">
  <head>
    <create user="ariga_mitsuhiro__adjust_textbox" host="W00668" date="2018-05-14T11:58:34.98229+09:00" source="" />
    <title />
    <comment />
    <generator name="" version="1.0.0" />
  </head>
  <body>
    <animTag name="fade_in" startFrame="45" endFrame="85" animLoop="OneTime" fileName="fade_in" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>起動演出と尺を合わせています。</comment>
      <userData />
      <group name="G_fade_00" />
    </animTag>
    <animTag name="fade_out" startFrame="10" endFrame="13" animLoop="OneTime" fileName="fade_out" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment />
      <userData />
      <group name="G_fade_00" />
    </animTag>
    <animTag name="in" startFrame="4" endFrame="8" animLoop="OneTime" fileName="in" outputPaneSRT="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>画面内遷移</comment>
      <userData />
      <group name="G_inout_00" />
    </animTag>
    <animTag name="out" startFrame="0" endFrame="3" animLoop="OneTime" fileName="out" outputPaneSRT="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>画面内遷移</comment>
      <userData />
      <group name="G_inout_00" />
    </animTag>
    <animTag name="text_switching" startFrame="0" endFrame="1" animLoop="OneTime" fileName="text_switching" outputPaneSRT="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>テキスト表示切り替え
0F　つかまえた、みつけたかず
1F　検索項目</comment>
      <userData />
      <group name="G_visible_00" />
    </animTag>
    <lan animType="PaneSRT" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="N_fade_00">
        <animPaneSRTTarget target="TranslateY">
          <key frame="0" value="0" slopeType="Smooth" />
          <key frame="45" value="0" slopeType="Step" />
          <key frame="70" value="0" slopeType="Step" />
          <key frame="70" value="0" slopeType="Flat" />
          <key frame="85" value="0" slopeType="Flat" />
        </animPaneSRTTarget>
        <animPaneSRTTarget target="ScaleX">
          <key frame="0" value="1" slopeType="Flat" />
          <key frame="10" value="1" slopeType="Flat" />
          <key frame="30" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
        <animPaneSRTTarget target="ScaleY">
          <key frame="0" value="1" slopeType="Flat" />
          <key frame="10" value="1" slopeType="Flat" />
          <key frame="30" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
    </lan>
    <lan animType="VertexColor" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="N_inout_00">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="255" slope="-85" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="3" value="0" slope="-85" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="3" value="0" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="4" value="0" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="4" value="0" slope="63.75" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="8" value="255" slope="63.75" slopeType="Linear" />
        </animVertexColorTarget>
      </animContent>
      <animContent name="N_fade_00">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="255" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="10" value="255" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="10" value="255" slope="-85" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="13" value="0" slope="-85" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="13" value="0" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="20" value="0" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="20" value="0" slope="25.5" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="30" value="255" slope="25.5" slopeType="Linear" />
        </animVertexColorTarget>
      </animContent>
    </lan>
    <lan animType="Visibility" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="N_icon_poke_00">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="0" slopeType="Step" />
          <key xsi:type="StepBool" frame="8" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="11" value="0" slopeType="Step" />
          <key xsi:type="StepBool" frame="30" value="1" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
      <animContent name="N_visible_00">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="0" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
      <animContent name="N_visible_01">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="0" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="1" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
      <animContent name="N_inout00">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="0" slopeType="Step" />
          <key xsi:type="StepBool" frame="8" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="11" value="0" slopeType="Step" />
          <key xsi:type="StepBool" frame="30" value="1" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
    </lan>
  </body>
</nw4f_layout>