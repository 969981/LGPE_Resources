  <body>
    <animTag name="in" startFrame="4" endFrame="8" animLoop="OneTime" fileName="in" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment />
      <userData />
      <group name="G_inout_00" />
    </animTag>
    <animTag name="out" startFrame="0" endFrame="3" animLoop="OneTime" fileName="out" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment />
      <userData />
      <group name="G_inout_00" />
    </animTag>
    <animTag name="info_switch" startFrame="0" endFrame="2" animLoop="OneTime" fileName="info_switch" outputPaneSRT="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>0F 図鑑登録
1F データ：捕まえた用
2F データ：見ただけ用</comment>
      <userData />
      <group name="G_switch_00" />
    </animTag>
    <lan animType="PaneSRT" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="N_poke_info_00">
        <animPaneSRTTarget target="TranslateY">
          <key frame="0" value="0" slopeType="Flat" />
          <key frame="3" value="-16" slopeType="Flat" />
          <key frame="4" value="-16" slopeType="Flat" />
          <key frame="8" value="0" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="N_info_L_00">
        <animPaneSRTTarget target="TranslateY">
          <key frame="0" value="0" slopeType="Flat" />
          <key frame="3" value="-16" slopeType="Flat" />
          <key frame="4" value="-16" slopeType="Flat" />
          <key frame="8" value="0" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="N_info_R_00">
        <animPaneSRTTarget target="TranslateY">
          <key frame="0" value="0" slopeType="Flat" />
          <key frame="3" value="-16" slopeType="Flat" />
          <key frame="4" value="-16" slopeType="Flat" />
          <key frame="8" value="0" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="N_form_00">
        <animPaneSRTTarget target="TranslateY">
          <key frame="0" value="0" slopeType="Flat" />
          <key frame="3" value="-16" slopeType="Flat" />
          <key frame="4" value="-16" slopeType="Flat" />
          <key frame="8" value="0" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
    </lan>
    <lan animType="VertexColor" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="N_inout_00">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="255" slope="-85" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="3" value="0" slope="-85" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="3" value="0" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="4" value="0" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="4" value="0" slope="63.75" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="8" value="255" slope="63.75" slopeType="Linear" />
        </animVertexColorTarget>
      </animContent>
    </lan>
    <lan animType="Visibility" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="N_info_R_00">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="2" value="0" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
      <animContent name="N_form_00">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="0" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="2" value="0" slopeType="Step" />
        </animVisibilityTarget>
