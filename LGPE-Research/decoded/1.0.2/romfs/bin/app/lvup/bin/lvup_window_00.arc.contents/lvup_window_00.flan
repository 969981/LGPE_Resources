    <animTag name="add_in" startFrame="0" endFrame="4" animLoop="OneTime" fileName="add_in" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" outputMaskTextureSRT="false" descendingBind="false">
      <comment>数値出現アニメ。
