    <animTag name="cp_add" startFrame="40" endFrame="52" animLoop="OneTime" fileName="cp_add" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" outputMaskTextureSRT="false" descendingBind="false">
      <comment>CPの加算演出　add_outと同時に再生してください。</comment>
      <userData />
      <group name="G_cp_00" />
