    <animTag name="add_out" startFrame="30" endFrame="34" animLoop="OneTime" fileName="add_out" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" outputMaskTextureSRT="false" descendingBind="false">
      <comment>数値加算アニメ</comment>
      <userData />
      <group name="G_add_out" />
