          <key xsi:type="HermiteU8" frame="4" value="255" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="30" value="255" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="34" value="0" slope="-63.75" slopeType="Linear" />
