    <animTag name="change" startFrame="0" endFrame="2" animLoop="OneTime" fileName="change" outputPaneSRT="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" outputMaskTextureSRT="false" descendingBind="false">
      <comment>覚醒表示切り替え
0F　覚醒なし
1F　覚醒あり
2F  覚醒のみ</comment>
      <userData />
      <group name="G_change_00" />
    </animTag>
    <animTag name="reset" startFrame="0" endFrame="0" animLoop="Wait" fileName="reset" outputPaneSRT="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" outputMaskTextureSRT="false" descendingBind="false">
      <comment>ウィンドウサイズリセット</comment>
      <userData />
      <group name="G_reset_00" />
