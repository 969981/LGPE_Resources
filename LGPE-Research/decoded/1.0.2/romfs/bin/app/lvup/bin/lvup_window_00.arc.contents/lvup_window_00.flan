    <animTag name="pos" startFrame="0" endFrame="1" animLoop="OneTime" fileName="pos" outputVisibility="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" outputMaskTextureSRT="false" descendingBind="false">
      <comment>0　戦闘
1　バッグ</comment>
      <userData />
      <group name="G_pos_00" />
