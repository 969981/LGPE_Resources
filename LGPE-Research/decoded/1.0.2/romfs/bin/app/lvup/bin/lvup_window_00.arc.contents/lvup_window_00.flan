          <key frame="4" value="0" slope="0.333333343" slopeType="Smooth" />
          <key frame="30" value="0" slopeType="Smooth" />
          <key frame="34" value="0" slopeType="Step" />
          <key frame="34" value="0" slopeType="Step" />
