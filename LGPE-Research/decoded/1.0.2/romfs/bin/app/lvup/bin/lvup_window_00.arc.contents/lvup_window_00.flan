      </animContent>
      <animContent name="N_pos_00">
        <animPaneSRTTarget target="TranslateX">
          <key frame="0" value="330" slopeType="Step" />
          <key frame="1" value="330" slopeType="Step" />
          <key frame="1" value="0" slopeType="Step" />
          <key frame="1" value="0" slopeType="Step" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="N_ParamAdd_01">
        <animPaneSRTTarget target="TranslateX">
          <key frame="0" value="0" slopeType="Flat" />
          <key frame="4" value="0" slopeType="Flat" />
          <key frame="30" value="0" slopeType="Flat" />
          <key frame="34" value="-120" slopeType="Step" />
          <key frame="34" value="-120" slopeType="Step" />
        </animPaneSRTTarget>
        <animPaneSRTTarget target="TranslateY">
          <key frame="0" value="-10" slope="2.5" slopeType="Smooth" />
