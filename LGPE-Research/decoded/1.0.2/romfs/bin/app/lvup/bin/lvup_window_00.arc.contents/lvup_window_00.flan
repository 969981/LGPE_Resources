          <key frame="34" value="0" slopeType="Step" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="N_cp_00">
        <animPaneSRTTarget target="TranslateY">
          <key frame="0" value="182" slopeType="Linear" />
          <key frame="40" value="182" slopeType="Linear" />
          <key frame="44" value="182" slopeType="Linear" />
          <key frame="44" value="182" slope="8" slopeType="Linear" />
          <key frame="46" value="198" slope="-0.8333333" slopeType="Smooth" />
          <key frame="50" value="177" slope="-5.25" slopeType="Linear" />
          <key frame="50" value="177" slope="2.5" slopeType="Linear" />
          <key frame="52" value="182" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
