    <animTag name="out" startFrame="0" endFrame="3" animLoop="OneTime" fileName="out" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" outputMaskTextureSRT="false" descendingBind="false">
      <comment />
      <userData />
