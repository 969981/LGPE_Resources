<?xml version="1.0" encoding="utf-8"?>
<nw4f_layout xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.5.2" xmlns="http://www.nintendo.co.jp/NW4F/LayoutEditor">
  <head>
    <create user="ariga_mitsuhiro" host="W00668" date="2017-09-23T16:24:21.2382898+09:00" source="" />
    <title />
    <comment />
    <generator name="" version="1.0.0" />
  </head>
  <body>
    <animTag name="color" startFrame="0" endFrame="2" animLoop="OneTime" fileName="color" outputPaneSRT="false" outputVisibility="false" outputVertexColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>パラメータの色変え</comment>
      <userData />
      <group name="G_color_00" />
    </animTag>
    <animTag name="count" startFrame="0" endFrame="0" animLoop="Wait" fileName="count" outputPaneSRT="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>数値表示</comment>
      <userData />
      <group name="G_c_e_00" />
    </animTag>
    <animTag name="eval" startFrame="1" endFrame="6" animLoop="OneTime" fileName="eval" outputPaneSRT="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>評価表示</comment>
      <userData />
      <group name="G_c_e_00" />
    </animTag>
    <lan animType="MaterialColor" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="P_param_00">
        <animMaterialColorTarget target="WhiteColor_r">
          <key xsi:type="HermiteU8" frame="0" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="100" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="100" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="255" slopeType="Step" />
        </animMaterialColorTarget>
        <animMaterialColorTarget target="WhiteColor_g">
          <key xsi:type="HermiteU8" frame="0" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="235" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="235" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="100" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="100" slopeType="Step" />
        </animMaterialColorTarget>
        <animMaterialColorTarget target="WhiteColor_b">
          <key xsi:type="HermiteU8" frame="0" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="250" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="250" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="140" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="140" slopeType="Step" />
        </animMaterialColorTarget>
      </animContent>
    </lan>
    <lan animType="TexturePattern" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="P_eval_00">
        <animTexPatternTarget target="Image">
          <refRes name="status_eval_text_a_00" />
          <refRes name="status_eval_text_b_00" />
          <refRes name="status_eval_text_c_00" />
          <refRes name="status_eval_text_d_00" />
          <refRes name="status_eval_text_e_00" />
          <refRes name="status_eval_text_f_00" />
          <key xsi:type="StepU16" frame="1" value="0" slopeType="Step" />
          <key xsi:type="StepU16" frame="2" value="1" slopeType="Step" />
          <key xsi:type="StepU16" frame="3" value="2" slopeType="Step" />
          <key xsi:type="StepU16" frame="4" value="3" slopeType="Step" />
          <key xsi:type="StepU16" frame="5" value="4" slopeType="Step" />
          <key xsi:type="StepU16" frame="6" value="5" slopeType="Step" />
          <key xsi:type="StepU16" frame="22" value="21" slopeType="Step" />
        </animTexPatternTarget>
      </animContent>
    </lan>
    <lan animType="Visibility" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="L_number_00">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="0" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
      <animContent name="L_number_01">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="0" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
      <animContent name="L_number_02">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="0" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
      <animContent name="P_slash_00">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="0" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
      <animContent name="L_number_03">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="0" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
      <animContent name="L_number_04">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="0" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
      <animContent name="L_number_05">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="0" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
      <animContent name="P_eval_00">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="0" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="1" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
    </lan>
  </body>
