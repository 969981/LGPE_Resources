  <body>
    <animTag name="monbo_ptn" startFrame="0" endFrame="2" animLoop="OneTime" fileName="monbo_ptn" outputPaneSRT="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>0F　通常
1F　瀕死
2F　非表示</comment>
      <userData />
      <group name="G_ptn_00" />
    </animTag>
    <lan animType="TexturePattern" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="P_monbo_00">
        <animTexPatternTarget target="Image">
          <refRes name="vs_demo_monbo_00" />
          <refRes name="vs_demo_monbo_01" />
          <key xsi:type="StepU16" frame="0" value="0" slopeType="Step" />
          <key xsi:type="StepU16" frame="1" value="1" slopeType="Step" />
          <key xsi:type="StepU16" frame="2" value="1" slopeType="Step" />
        </animTexPatternTarget>
      </animContent>
    </lan>
    <lan animType="Visibility" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="P_monbo_00">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="1" slopeType="Step" />
          <key xsi:type="StepBool" frame="2" value="0" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
    </lan>
  </body>
