          <key xsi:type="HermiteU8" frame="0" value="160" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="160" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="136" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="3" value="136" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="3" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="4" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="4" value="136" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="4" value="136" slopeType="Step" />
        </animMaterialColorTarget>
        <animMaterialColorTarget target="BlackColor_g">
          <key xsi:type="HermiteU8" frame="0" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="101" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="101" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="86" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="3" value="86" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="3" value="57" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="4" value="57" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="4" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="4" value="0" slopeType="Step" />
        </animMaterialColorTarget>
        <animMaterialColorTarget target="BlackColor_b">
          <key xsi:type="HermiteU8" frame="0" value="72" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="72" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="18" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="18" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="2" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="3" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="3" value="216" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="4" value="216" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="4" value="167" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="4" value="167" slopeType="Step" />
        </animMaterialColorTarget>
      </animContent>
    </lan>
    <lan animType="VertexColor" startFrame="0" endFrame="1000" convertStartFrame="0" convertEndFrame="30">
      <animContent name="N_unselect">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="255" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="2" value="0" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="4" value="255" slopeType="Flat" />
        </animVertexColorTarget>
      </animContent>
      <animContent name="N_keep_00">
        <animVertexColorTarget target="PaneAlpha" postInfinityType="Cycle">
          <key xsi:type="HermiteU8" frame="60" value="255" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="80" value="80" slope="-8.75" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="80" value="80" slope="8.75" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="100" value="255" slopeType="Flat" />
        </animVertexColorTarget>
      </animContent>
      <animContent name="N_passiveActive_00">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="100" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="100" slopeType="Step" />
        </animVertexColorTarget>
      </animContent>
      <animContent name="P_buttonBG_02">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="60" value="200" slopeType="Smooth" />
          <key xsi:type="HermiteU8" frame="510" value="160" slopeType="Smooth" />
          <key xsi:type="HermiteU8" frame="960" value="200" slopeType="Smooth" />
        </animVertexColorTarget>
      </animContent>
    </lan>
    <lan animType="TextureSRT" startFrame="0" endFrame="1000" convertStartFrame="0" convertEndFrame="30">
      <animContent name="P_buttonBG_01">
        <animTexSRTTarget id="1" target="Rotate">
          <key frame="60" value="-60" slopeType="Flat" />
          <key frame="510" value="20" slopeType="Flat" />
          <key frame="960" value="-60" slopeType="Flat" />
        </animTexSRTTarget>
      </animContent>
      <animContent name="P_buttonBG_02">
        <animTexSRTTarget id="1" target="TranslateS">
          <key frame="60" value="0.5" slopeType="Smooth" />
          <key frame="960" value="1.5" slopeType="Smooth" />
        </animTexSRTTarget>
        <animTexSRTTarget id="1" target="TranslateT">
          <key frame="60" value="0" slopeType="Smooth" />
          <key frame="960" value="-1" slopeType="Smooth" />
        </animTexSRTTarget>
        <animTexSRTTarget id="2" target="TranslateS">
          <key frame="60" value="0" slopeType="Linear" />
          <key frame="60" value="0" slope="-0.00111111114" slopeType="Linear" />
          <key frame="960" value="-1" slope="-0.00111111114" slopeType="Linear" />
        </animTexSRTTarget>
        <animTexSRTTarget id="2" target="TranslateT">
          <key frame="60" value="0" slopeType="Linear" />
          <key frame="60" value="0" slope="0.00111111114" slopeType="Linear" />
          <key frame="960" value="1" slope="0.00111111114" slopeType="Linear" />
          <key frame="960" value="1" slopeType="Linear" />
        </animTexSRTTarget>
        <animTexSRTTarget id="2" target="Rotate">
          <key frame="60" value="0" slopeType="Flat" />
          <key frame="960" value="-360" slopeType="Flat" />
        </animTexSRTTarget>
      </animContent>
      <animContent name="P_buttonBG_03">
        <animTexSRTTarget id="1" target="Rotate">
          <key frame="60" value="-60" slopeType="Flat" />
          <key frame="510" value="0" slopeType="Flat" />
          <key frame="960" value="-60" slopeType="Flat" />
        </animTexSRTTarget>
      </animContent>
    </lan>
    <lan animType="TexturePattern" startFrame="0" endFrame="1000" convertStartFrame="0" convertEndFrame="30">
      <animContent name="P_button_00">
        <animTexPatternTarget target="Image">
          <refRes name="battle_command_battle_off_00" />
          <refRes name="battle_command_poke_off_00" />
          <refRes name="battle_command_bag_off_00" />
          <refRes name="battle_command_run_off_00" />
          <refRes name="battle_command_back_off_00" />
          <key xsi:type="StepU16" frame="0" value="0" slopeType="Step" />
          <key xsi:type="StepU16" frame="1" value="1" slopeType="Step" />
          <key xsi:type="StepU16" frame="2" value="2" slopeType="Step" />
          <key xsi:type="StepU16" frame="3" value="3" slopeType="Step" />
          <key xsi:type="StepU16" frame="4" value="4" slopeType="Step" />
        </animTexPatternTarget>
      </animContent>
      <animContent name="N_glare_00">
        <animTexPatternTarget target="Image">
          <refRes name="battle_command_glare_00" />
        </animTexPatternTarget>
      </animContent>
      <animContent name="P_buttonBG_06">
        <animTexPatternTarget id="1" target="Image">
          <refRes name="battle_button_command_icon_00" />
          <refRes name="battle_button_command_icon_02" />
          <refRes name="battle_button_command_icon_04" />
          <refRes name="battle_button_command_icon_06" />
          <refRes name="battle_button_command_icon_08" />
          <key xsi:type="StepU16" frame="0" value="0" slopeType="Step" />
          <key xsi:type="StepU16" frame="1" value="1" slopeType="Step" />
          <key xsi:type="StepU16" frame="2" value="2" slopeType="Step" />
          <key xsi:type="StepU16" frame="3" value="3" slopeType="Step" />
          <key xsi:type="StepU16" frame="4" value="4" slopeType="Step" />
        </animTexPatternTarget>
      </animContent>
      <animContent name="P_grptext_00">
        <animTexPatternTarget target="Image">
          <refRes name="grpfont_battle_battleButton_text_00" />
          <refRes name="grpfont_battle_pokeButton_text_00" />
          <refRes name="grpfont_battle_bagButton_text_00" />
          <refRes name="grpfont_battle_runButton_text_00" />
          <refRes name="grpfont_battle_backButton_text_00" />
          <key xsi:type="StepU16" frame="0" value="0" slopeType="Step" />
          <key xsi:type="StepU16" frame="1" value="1" slopeType="Step" />
          <key xsi:type="StepU16" frame="2" value="2" slopeType="Step" />
          <key xsi:type="StepU16" frame="3" value="3" slopeType="Step" />
          <key xsi:type="StepU16" frame="4" value="4" slopeType="Step" />
        </animTexPatternTarget>
      </animContent>
      <animContent name="P_grptext_01">
        <animTexPatternTarget target="Image">
          <refRes name="grpfont_battle_battleButton_text_01" />
          <refRes name="grpfont_battle_pokeButton_text_01" />
          <refRes name="grpfont_battle_bagButton_text_01" />
          <refRes name="grpfont_battle_runButton_text_01" />
          <refRes name="grpfont_battle_backButton_text_01" />
          <key xsi:type="StepU16" frame="0" value="0" slopeType="Step" />
          <key xsi:type="StepU16" frame="1" value="1" slopeType="Step" />
          <key xsi:type="StepU16" frame="2" value="2" slopeType="Step" />
          <key xsi:type="StepU16" frame="3" value="3" slopeType="Step" />
          <key xsi:type="StepU16" frame="4" value="4" slopeType="Step" />
        </animTexPatternTarget>
      </animContent>
    </lan>
  </body>
</nw4f_layout>