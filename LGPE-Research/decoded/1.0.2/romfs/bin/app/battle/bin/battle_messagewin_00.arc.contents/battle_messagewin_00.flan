    <lan animType="PaneSRT" startFrame="0" endFrame="30" convertStartFrame="0" convertEndFrame="30">
      <animContent name="N_scalel_00">
        <animPaneSRTTarget target="ScaleX">
          <key frame="0" value="1" slopeType="Flat" />
