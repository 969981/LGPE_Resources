          <key frame="6" value="0.8" slopeType="Flat" />
          <key frame="8" value="1" slopeType="Flat" />
          <key frame="10" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="N_null_00">
        <animPaneSRTTarget target="TranslateX">
          <key frame="0" value="-179" slopeType="Flat" />
          <key frame="3" value="-229" slopeType="Flat" />
          <key frame="6" value="-229" slopeType="Flat" />
