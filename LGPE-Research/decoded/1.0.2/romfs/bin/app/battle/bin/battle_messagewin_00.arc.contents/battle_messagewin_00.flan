          <key xsi:type="HermiteU8" frame="6" value="255" slopeType="Step" />
        </animVertexColorTarget>
      </animContent>
      <animContent name="N_scalel_00">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="255" slope="-85" slopeType="Smooth" />
          <key xsi:type="HermiteU8" frame="1" value="255" slope="-127.5" slopeType="Linear" />
