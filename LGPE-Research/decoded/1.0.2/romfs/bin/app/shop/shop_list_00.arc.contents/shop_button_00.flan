    <lan animType="TexturePattern" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="30">
      <animContent name="P_button_00">
        <animTexPatternTarget target="Image">
          <refRes name="shop_button_monbo_00" />
          <refRes name="shop_button_kusuri_00" />
          <refRes name="shop_button_others_00" />
          <key xsi:type="StepU16" frame="0" value="0" slopeType="Step" />
