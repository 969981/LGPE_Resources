    <lan animType="PaneSRT" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="30">
      <animContent name="N_touch_00">
        <animPaneSRTTarget target="ScaleX">
          <key frame="0" value="1" slopeType="Flat" />
          <key frame="2" value="0.9" slopeType="Flat" />
          <key frame="4" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
        <animPaneSRTTarget target="ScaleY">
          <key frame="0" value="1" slopeType="Flat" />
          <key frame="2" value="0.9" slopeType="Flat" />
          <key frame="4" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
