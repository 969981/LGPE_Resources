          <key xsi:type="HermiteU8" frame="1" value="100" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="100" slopeType="Step" />
        </animVertexColorTarget>
      </animContent>
    </lan>
  </body>
</nw4f_layout>