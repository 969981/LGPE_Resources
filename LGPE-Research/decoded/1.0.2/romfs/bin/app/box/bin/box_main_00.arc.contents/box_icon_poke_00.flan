    <title />
    <comment />
    <generator name="" version="1.0.0" />
  </head>
  <body>
    <animTag name="touch_release" startFrame="0" endFrame="4" animLoop="OneTime" fileName="touch_release" outputVisibility="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment />
      <userData />
      <group name="G_touch_00" />
    </animTag>
    <animTag name="passive" startFrame="1" endFrame="1" animLoop="Wait" fileName="passive" outputPaneSRT="false" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment />
      <userData />
      <group name="G_touch_00" />
    </animTag>
    <animTag name="active" startFrame="0" endFrame="0" animLoop="Wait" fileName="active" outputPaneSRT="false" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment />
      <userData />
      <group name="G_touch_00" />
    </animTag>
    <animTag name="select" startFrame="1" endFrame="61" fileName="select" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>カーソル選択中</comment>
      <userData />
      <group name="G_select_00" />
    </animTag>
    <animTag name="unselect" startFrame="0" endFrame="0" animLoop="Wait" fileName="unselect" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>カーソル非選択</comment>
      <userData />
      <group name="G_select_00" />
    </animTag>
    <animTag name="number" startFrame="0" endFrame="6" animLoop="OneTime" fileName="number" outputPaneSRT="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>手持ちの順番表記切り替えアニメ
0F　1匹目
1F　2匹目
2F　3匹目
3F  4匹目
4F  5匹目
5F  6匹目</comment>
      <userData />
      <group name="G_number_00" />
    </animTag>
    <lan animType="PaneSRT" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="N_touchreleasel_00">
        <animPaneSRTTarget target="ScaleX">
          <key frame="0" value="1" slopeType="Flat" />
          <key frame="2" value="0.9" slopeType="Flat" />
          <key frame="4" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
        <animPaneSRTTarget target="ScaleY">
          <key frame="0" value="1" slopeType="Flat" />
          <key frame="2" value="0.9" slopeType="Flat" />
          <key frame="4" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="N_select_00">
        <animPaneSRTTarget target="TranslateY">
          <key frame="0" value="0" slopeType="Flat" />
          <key frame="1" value="0" slopeType="Flat" />
          <key frame="19" value="0" slopeType="Flat" />
          <key frame="21" value="0" slopeType="Flat" />
          <key frame="39" value="0" slopeType="Flat" />
          <key frame="41" value="0" slopeType="Flat" />
          <key frame="59" value="0" slopeType="Flat" />
          <key frame="61" value="0" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
    </lan>
    <lan animType="MaterialColor" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="P_icon_poke_00">
        <animMaterialColorTarget target="BlackColor_r">
          <key xsi:type="HermiteU8" frame="0" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="30" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="23" value="30" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="23" value="30" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="23" value="30" slopeType="Step" />
        </animMaterialColorTarget>
        <animMaterialColorTarget target="BlackColor_g">
          <key xsi:type="HermiteU8" frame="0" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="30" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="23" value="30" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="23" value="30" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="23" value="30" slopeType="Step" />
        </animMaterialColorTarget>
        <animMaterialColorTarget target="BlackColor_b">
          <key xsi:type="HermiteU8" frame="0" value="0" slopeType="Smooth" />
          <key xsi:type="HermiteU8" frame="1" value="0" slopeType="Smooth" />
          <key xsi:type="HermiteU8" frame="23" value="0" slopeType="Smooth" />
        </animMaterialColorTarget>
      </animContent>
    </lan>
    <lan animType="VertexColor" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="N_touchreleasel_00">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="100" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="1" value="100" slopeType="Step" />
        </animVertexColorTarget>
      </animContent>
      <animContent name="P_select_00">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="255" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="30" value="120" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="60" value="255" slopeType="Flat" />
        </animVertexColorTarget>
      </animContent>
    </lan>
    <lan animType="TexturePattern" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="P_number_00">
        <animTexPatternTarget target="Image">
          <refRes name="box_list_number_00" />
          <refRes name="box_list_number_01" />
          <refRes name="box_list_number_02" />
          <refRes name="box_list_number_03" />
          <refRes name="box_list_number_04" />
          <refRes name="box_list_number_05" />
          <key xsi:type="StepU16" frame="0" value="0" slopeType="Step" />
          <key xsi:type="StepU16" frame="1" value="1" slopeType="Step" />
          <key xsi:type="StepU16" frame="2" value="2" slopeType="Step" />
          <key xsi:type="StepU16" frame="3" value="3" slopeType="Step" />
          <key xsi:type="StepU16" frame="4" value="4" slopeType="Step" />
          <key xsi:type="StepU16" frame="5" value="5" slopeType="Step" />
        </animTexPatternTarget>
      </animContent>
    </lan>
    <lan animType="Visibility" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="100">
      <animContent name="P_select_00">
        <animVisibilityTarget target="Visibility">
          <key xsi:type="StepBool" frame="0" value="0" slopeType="Step" />
          <key xsi:type="StepBool" frame="1" value="1" slopeType="Step" />
        </animVisibilityTarget>
      </animContent>
    </lan>
  </body>
</nw4f_layout>