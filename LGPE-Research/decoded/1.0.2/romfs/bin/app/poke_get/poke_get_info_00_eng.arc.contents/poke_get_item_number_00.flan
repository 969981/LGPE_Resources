    <animTag name="ptn" startFrame="0" endFrame="9" animLoop="OneTime" fileName="ptn" outputPaneSRT="false" outputVisibility="false" outputVertexColor="false" outputMaterialColor="false" outputTextureSRT="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>数字切り替えパターンアニメ
