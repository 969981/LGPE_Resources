<?xml version="1.0" encoding="utf-8"?>
<nw4f_layout xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.5.2" xmlns="http://www.nintendo.co.jp/NW4F/LayoutEditor">
  <head>
    <create user="takasu_momoka" host="W00725" date="2017-06-27T16:33:26.4101823+09:00" source="" />
    <title />
    <comment />
    <generator name="" version="1.0.0" />
  </head>
  <body>
    <animTag name="in" startFrame="10" endFrame="13" animLoop="OneTime" fileName="in" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>アプリ内のin</comment>
      <userData />
      <group name="inout" />
    </animTag>
    <animTag name="out" startFrame="0" endFrame="3" animLoop="OneTime" fileName="out" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>アプリ内のout</comment>
      <userData />
      <group name="inout" />
    </animTag>
    <animTag name="fade_in" startFrame="30" endFrame="34" animLoop="OneTime" fileName="fade_in" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>他アプリからマッチング画面へ</comment>
      <userData />
      <group name="fade_inout" />
    </animTag>
    <animTag name="fade_out" startFrame="20" endFrame="25" animLoop="OneTime" fileName="fade_out" outputVisibility="false" outputMaterialColor="false" outputTextureSRT="false" outputTexturePattern="false" outputIndTextureSRT="false" outputAlphaTest="false" outputPerCharacterTransform="false" outputWindow="false" outputExtUserData="false" descendingBind="false">
      <comment>マッチング画面から他アプリへ</comment>
      <userData />
      <group name="inout" />
    </animTag>
    <lan animType="PaneSRT" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="60">
      <animContent name="button">
        <animPaneSRTTarget target="ScaleX">
          <key frame="0" value="1" slopeType="Linear" />
          <key frame="0" value="1" slope="-0.166666672" slopeType="Linear" />
          <key frame="3" value="0.5" slope="-0.166666672" slopeType="Linear" />
          <key frame="3" value="0.5" slopeType="Linear" />
          <key frame="10" value="0.5" slopeType="Linear" />
          <key frame="10" value="0.5" slope="0.166666672" slopeType="Linear" />
          <key frame="13" value="1" slope="0.166666672" slopeType="Linear" />
          <key frame="13" value="1" slopeType="Linear" />
          <key frame="20" value="1" slopeType="Flat" />
          <key frame="25" value="0.5" slopeType="Step" />
          <key frame="30" value="0.5" slopeType="Step" />
          <key frame="30" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
        <animPaneSRTTarget target="ScaleY">
          <key frame="0" value="1" slopeType="Linear" />
          <key frame="0" value="1" slope="-0.166666672" slopeType="Linear" />
          <key frame="3" value="0.5" slope="-0.166666672" slopeType="Linear" />
          <key frame="3" value="0.5" slopeType="Linear" />
          <key frame="10" value="0.5" slopeType="Linear" />
          <key frame="10" value="0.5" slope="0.166666672" slopeType="Linear" />
          <key frame="13" value="1" slope="0.166666672" slopeType="Linear" />
          <key frame="13" value="1" slopeType="Linear" />
          <key frame="20" value="1" slopeType="Flat" />
          <key frame="25" value="0.5" slopeType="Step" />
          <key frame="30" value="0.5" slopeType="Step" />
          <key frame="30" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="L_button_00">
        <animPaneSRTTarget target="TranslateY">
          <key frame="0" value="50" slopeType="Step" />
          <key frame="30" value="50" slopeType="Step" />
          <key frame="30" value="-10" slopeType="Flat" />
          <key frame="32" value="50" slopeType="Flat" />
        </animPaneSRTTarget>
        <animPaneSRTTarget target="ScaleX">
          <key frame="0" value="1" slopeType="Step" />
          <key frame="30" value="1" slopeType="Step" />
          <key frame="30" value="0.8" slopeType="Flat" />
          <key frame="32" value="1.1" slopeType="Flat" />
          <key frame="33" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
        <animPaneSRTTarget target="ScaleY">
          <key frame="0" value="1" slopeType="Step" />
          <key frame="30" value="1" slopeType="Step" />
          <key frame="30" value="0.8" slopeType="Flat" />
          <key frame="32" value="1.1" slopeType="Flat" />
          <key frame="33" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
      <animContent name="L_button_01">
        <animPaneSRTTarget target="TranslateY">
          <key frame="0" value="-110" slopeType="Step" />
          <key frame="31" value="-110" slopeType="Step" />
          <key frame="31" value="-170" slopeType="Flat" />
          <key frame="33" value="-110" slopeType="Flat" />
        </animPaneSRTTarget>
        <animPaneSRTTarget target="ScaleX">
          <key frame="0" value="1" slopeType="Step" />
          <key frame="31" value="1" slopeType="Step" />
          <key frame="31" value="0.8" slopeType="Flat" />
          <key frame="33" value="1.1" slopeType="Flat" />
          <key frame="34" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
        <animPaneSRTTarget target="ScaleY">
          <key frame="0" value="1" slopeType="Step" />
          <key frame="31" value="1" slopeType="Step" />
          <key frame="31" value="0.8" slopeType="Flat" />
          <key frame="33" value="1.1" slopeType="Flat" />
          <key frame="34" value="1" slopeType="Flat" />
        </animPaneSRTTarget>
      </animContent>
    </lan>
    <lan animType="VertexColor" startFrame="0" endFrame="100" convertStartFrame="0" convertEndFrame="60">
      <animContent name="button">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="255" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="0" value="255" slope="-85" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="3" value="0" slope="-85" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="3" value="0" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="10" value="0" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="10" value="0" slope="85" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="13" value="255" slope="85" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="13" value="255" slopeType="Linear" />
          <key xsi:type="HermiteU8" frame="20" value="255" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="25" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="30" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="30" value="255" slope="51" slopeType="Smooth" />
        </animVertexColorTarget>
      </animContent>
      <animContent name="L_button_00">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="30" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="30" value="0" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="33" value="255" slopeType="Flat" />
        </animVertexColorTarget>
      </animContent>
      <animContent name="L_button_01">
        <animVertexColorTarget target="PaneAlpha">
          <key xsi:type="HermiteU8" frame="0" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="30" value="255" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="30" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="31" value="0" slopeType="Step" />
          <key xsi:type="HermiteU8" frame="31" value="0" slopeType="Flat" />
          <key xsi:type="HermiteU8" frame="34" value="255" slopeType="Flat" />
        </animVertexColorTarget>
      </animContent>
    </lan>
